        <Item class="ModuleScript" referent="201">
          <Properties>
            <string name="Name">StorageRack</string>
            <string name="Source"><![CDATA[-- Galvanised shelving for a base's storage room. Local +Z is the open front; the
-- floor is y=0. Each stored fish shows as an iced crate on a shelf.
local Props = require(script.Parent.Props)

local StorageRack = {}
local rgb = Color3.fromRGB
local M = Enum.Material
local STEEL = rgb(118, 128, 132)
local DARK_STEEL = rgb(64, 72, 76)
local BOARD = rgb(150, 112, 74)
local CRATE = rgb(212, 226, 230)
local ICE = rgb(226, 244, 248)

-- Fills one 4.5-stud grid cell across, so neighbouring racks meet in a run.
StorageRack.WIDTH = 4.4
StorageRack.DEPTH = 2.2
StorageRack.HEIGHT = 6.6
local SHELVES = { 0.35, 2.4, 4.45 }
-- Crate spots: four along each shelf.
local CRATE_SPOTS = {}
for _, y in SHELVES do
	for index = 0, 3 do
		table.insert(CRATE_SPOTS, Vector3.new(-1.5 + index * 1.0, y, 0.05))
	end
end

function StorageRack.build(parent: Instance, frame: CFrame): Model
	local rack = Instance.new("Model")
	rack.Name = "StorageRack"
	local function piece(name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material): Part
		local result = Props.part(rack, size, frame * offset, color, material)
		result.Name = name
		return result
	end
	local halfW, halfD = StorageRack.WIDTH / 2, StorageRack.DEPTH / 2
	for _, x in { -halfW + 0.12, halfW - 0.12 } do
		for _, z in { -halfD + 0.12, halfD - 0.12 } do
			piece("Upright", Vector3.new(0.22, StorageRack.HEIGHT, 0.22), CFrame.new(x, StorageRack.HEIGHT / 2, z), STEEL, M.Metal)
		end
		-- Diagonal bracing on each end frame.
		local brace = piece(
			"EndBrace",
			Vector3.new(0.1, math.sqrt(StorageRack.DEPTH ^ 2 + 4), 0.1),
			CFrame.new(x, 3.4, 0) * CFrame.Angles(math.atan2(StorageRack.DEPTH - 0.24, 2), 0, 0),
			DARK_STEEL,
			M.Metal
		)
		brace.CanCollide = false
	end
	for _, y in SHELVES do
		piece("Shelf", Vector3.new(StorageRack.WIDTH - 0.1, 0.14, StorageRack.DEPTH - 0.1), CFrame.new(0, y + 0.07, 0), BOARD, M.WoodPlanks)
		for _, z in { -halfD + 0.12, halfD - 0.12 } do
			piece("ShelfBeam", Vector3.new(StorageRack.WIDTH, 0.26, 0.12), CFrame.new(0, y, z), rgb(214, 104, 52), M.Metal)
		end
	end
	piece("TopShelfCap", Vector3.new(StorageRack.WIDTH, 0.12, StorageRack.DEPTH), CFrame.new(0, StorageRack.HEIGHT, 0), DARK_STEEL, M.Metal)
	-- A wire mesh back keeps crates off the wall, and each upright stands on a foot plate.
	local mesh = piece("BackMesh", Vector3.new(StorageRack.WIDTH - 0.3, StorageRack.HEIGHT - 0.4, 0.04), CFrame.new(0, StorageRack.HEIGHT / 2, -halfD + 0.06), DARK_STEEL, M.DiamondPlate)
	mesh.Transparency, mesh.CanCollide = 0.35, false
	for _, x in { -halfW + 0.12, halfW - 0.12 } do
		for _, z in { -halfD + 0.12, halfD - 0.12 } do
			piece("FootPlate", Vector3.new(0.3, 0.05, 0.3), CFrame.new(x, 0.025, z), DARK_STEEL, M.Metal).CanCollide = false
		end
	end
	-- A label holder on each shelf beam.
	for _, y in SHELVES do
		piece("ShelfLabel", Vector3.new(0.6, 0.18, 0.02), CFrame.new(-halfW + 0.7, y, halfD - 0.05), rgb(240, 236, 220), M.SmoothPlastic).CanCollide = false
	end
	return rack
end

-- Shows `count` crates on the rack, rebuilding only when the count changes.
function StorageRack.fill(rack: Model, frame: CFrame, count: number)
	count = math.clamp(count, 0, #CRATE_SPOTS)
	local existing = rack:FindFirstChild("Crates")
	if existing and existing:GetAttribute("Count") == count then
		return
	end
	if existing then
		existing:Destroy()
	end
	local crates = Instance.new("Model")
	crates.Name = "Crates"
	crates:SetAttribute("Count", count)
	for index = 1, count do
		local spot = CRATE_SPOTS[index]
		local base = frame * CFrame.new(spot.X, spot.Y + 0.14, spot.Z)
		local box = Props.part(crates, Vector3.new(0.8, 0.7, 1.5), base * CFrame.new(0, 0.35, 0), CRATE, M.SmoothPlastic)
		box.Name = "FishCrate"
		box.CanCollide = false
		local ice = Props.part(crates, Vector3.new(0.65, 0.12, 1.3), base * CFrame.new(0, 0.66, 0), ICE, M.Ice)
		ice.Name = "CrushedIce"
		ice.CanCollide = false
	end
	crates.Parent = rack
end

StorageRack.CRATES = #CRATE_SPOTS
return StorageRack
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="202">
          <Properties>
            <string name="Name">WeatherRadar</string>
            <string name="Source"><![CDATA[-- The weather radar: a round radar table on a pedestal, bought at the furniture
-- shop and placed in the yard behind a base house. The server only builds the
-- table; each client draws the live picture onto the tagged screen itself
-- (src/client/WeatherRadar.luau), from the same deterministic forecast that
-- drives its own sky, so nothing about the weather is replicated.
local CollectionService = game:GetService("CollectionService")

local Props = require(script.Parent.Props)

local WeatherRadar = {}
local rgb = Color3.fromRGB
local M = Enum.Material
local IRON = rgb(46, 52, 56)
local PAINT = rgb(222, 226, 222)
local BEZEL = rgb(32, 36, 40)
local GLASS = rgb(12, 22, 30)

WeatherRadar.SCREEN_TAG = "WeatherRadarScreen"
WeatherRadar.DIAMETER = 3.6
-- The console leans toward the reader standing at the item's +Z side.
WeatherRadar.TILT = math.rad(22)
WeatherRadar.HEIGHT = 4.4

local function decorative(piece: BasePart): BasePart
	piece.CanCollide, piece.CanQuery = false, false
	return piece
end

local function disc(parent: Instance, frame: CFrame, thickness: number, diameter: number, color: Color3, material): Part
	-- Cylinders run along their X axis; turn it upright in the console's frame.
	local piece = Props.part(
		parent,
		Vector3.new(thickness, diameter, diameter),
		frame * CFrame.Angles(0, 0, math.pi / 2),
		color,
		material
	)
	piece.Shape = Enum.PartType.Cylinder
	return piece
end

function WeatherRadar.build(parent: Instance, frame: CFrame): Model
	local model = Instance.new("Model")
	model.Name = "WeatherRadar"
	model.Parent = parent
	disc(model, frame * CFrame.new(0, 0.15, 0), 0.3, 2.6, IRON, M.Metal)
	local column = disc(model, frame * CFrame.new(0, 1.45, 0), 2.3, 0.9, PAINT, M.Metal)
	column.Name = "RadarColumn"
	local console = frame * CFrame.new(0, 2.85, 0) * CFrame.Angles(WeatherRadar.TILT, 0, 0)
	local bezel = disc(model, console, 0.4, WeatherRadar.DIAMETER + 0.5, BEZEL, M.Metal)
	bezel.Name = "RadarBezel"
	decorative(disc(model, console * CFrame.new(0, 0.2, 0), 0.04, WeatherRadar.DIAMETER, GLASS, M.Glass))
	-- An invisible square over the glass carries the client's SurfaceGui on its
	-- top face; the client only paints the round area inside the bezel.
	local screen = decorative(
		Props.part(
			model,
			Vector3.new(WeatherRadar.DIAMETER, 0.02, WeatherRadar.DIAMETER),
			console * CFrame.new(0, 0.23, 0),
			GLASS,
			M.SmoothPlastic
		)
	)
	screen.Name = "RadarScreen"
	screen.Transparency = 1
	screen.CastShadow = false
	screen:SetAttribute("Diameter", WeatherRadar.DIAMETER)
	CollectionService:AddTag(screen, WeatherRadar.SCREEN_TAG)
	-- A small dish on a mast behind the table, with a red beacon on top.
	decorative(Props.part(model, Vector3.new(0.18, 2.4, 0.18), frame * CFrame.new(0, 3.2, -1.75), IRON, M.Metal))
	decorative(
		disc(
			model,
			frame * CFrame.new(0, 4.15, -1.62) * CFrame.Angles(math.rad(-35), 0, 0),
			0.12,
			1.3,
			PAINT,
			M.SmoothPlastic
		)
	)
	decorative(
		Props.part(model, Vector3.new(0.22, 0.22, 0.22), frame * CFrame.new(0, 4.5, -1.75), rgb(220, 50, 40), M.Neon)
	)
	return model
end

return WeatherRadar
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="203">
        <Properties>
          <string name="Name">MetroService</string>
          <string name="Source"><![CDATA[-- The server owns boarding, riders and transfers. Train visuals use the same
-- absolute clock on each client; hundreds of decorative parts never move over the network.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Schedule = require(ReplicatedStorage.Shared.MetroSchedule)
local Train = require(ReplicatedStorage.Shared.MetroTrain)
local Service = {}
local started = false
local stops, rides, cooldown, pins = {}, {}, {}, {}
local transit, remote

local function ready(stop)
	return stop and stop:IsDescendantOf(workspace) and stop:FindFirstChild("Arrival")
		and stop:FindFirstChild("Boarding") and stop:FindFirstChild("TrainDock")
end

local function running()
	return ready(stops.Harbour and stops.Harbour.model) and ready(stops.City and stops.City.model)
end

local function body(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if character and character.Parent and humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
		return character, humanoid, root
	end
end

local function releasePin(player, stop)
	if stop and stop.Parent then stop:RemovePersistentPlayer(player) end
end

local function finish(player, ride, destination, cancelled)
	if rides[player] ~= ride then return end
	rides[player] = nil
	local character, _, root = body(player)
	-- Only touch the captured avatar, never a replacement spawned during a yield.
	if root == ride.root then
		if ready(destination) then character:PivotTo(destination.Arrival.CFrame) end
		root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
	end
	if ride.root.Parent then ride.root.Anchored = ride.anchored end
	if ride.humanoid.Parent then ride.humanoid.AutoRotate = ride.autoRotate end
	if ride.character.Parent then ride.character:SetAttribute("MetroRiding", nil) end
	player:SetAttribute("MetroRiding", nil)
	if ride.pinned and destination ~= ride.destination then releasePin(player, ride.destination) end
	if destination == ride.destination and ride.pinned then
		if pins[player] ~= destination then releasePin(player, pins[player]) end
		pins[player] = destination
	end
	if player.Parent then remote:FireClient(player, if cancelled then "Cancel" else "Arrive") end
end

local function beginRide(player, source, state)
	local character, humanoid, root = body(player)
	local id = source:GetAttribute("MetroStopId")
	local destination = stops[Schedule.OTHER[id]]
	if rides[player] or not character or humanoid.SeatPart or root.Anchored or not destination then return end
	local offset = source.TrainDock.CFrame:ToObjectSpace(root.CFrame)
	if not Schedule.inside(offset.Position) then return end
	local ride = {
		character = character, humanoid = humanoid, root = root, offset = offset,
		source = source, destination = destination.model, current = source,
		cycle = state.cycle, anchored = root.Anchored, autoRotate = humanoid.AutoRotate,
		transferred = false, pinned = false,
	}
	rides[player] = ride
	root.Anchored, humanoid.AutoRotate = true, false
	character:SetAttribute("MetroRiding", true)
	player:SetAttribute("MetroRiding", true)
	remote:FireClient(player, "Depart", {
		origin = Schedule.NAMES[id], destination = Schedule.NAMES[Schedule.OTHER[id]],
		dock = source.TrainDock.CFrame, departure = state.cycle * 60 + Schedule.CLOSE,
		arrival = (state.cycle + 1) * 60 + Schedule.OPEN,
	})
	-- Preload during the actual journey, with a separate task per passenger.
	task.spawn(function()
		local ok = pcall(function()
			ride.destination:AddPersistentPlayer(player)
			ride.pinned = true
			player:RequestStreamAroundAsync(ride.destination.Arrival.Position, 8)
		end)
		if rides[player] ~= ride then
			if ride.destination ~= pins[player] then releasePin(player, ride.destination) end
			return
		end
		ride.streamed = ok
		if ride.recovering then
			finish(player, ride, if ready(ride.destination) then ride.destination else nil, true)
		end
	end)
end

local function board(player, stop)
	local state = Schedule.state(workspace:GetServerTimeNow())
	local character, humanoid, root = body(player)
	if not running() or not state.boarding or rides[player] or not character
		or humanoid.SeatPart or root.Anchored or os.clock() - (cooldown[player] or -math.huge) < 2
		or (root.Position - stop.Boarding.Position).Magnitude > 12 then return end
	local id = stop:GetAttribute("MetroStopId")
	if not stops[id] or stops[id].model ~= stop then return end
	cooldown[player] = os.clock()
	-- This only enters the open carriage. Walking through any door also works.
	character:PivotTo(stop.TrainDock.CFrame * CFrame.new(-11, 3.5, -2.5))
	root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
end

local function setCollision(stop, enabled)
	if stop.collisionEnabled == enabled then return end
	stop.collisionEnabled = enabled
	for _, p in stop.hull:GetDescendants() do
		if p:IsA("BasePart") then
			p.CanCollide = enabled and p.Name ~= "SlidingDoor"
		end
	end
end

function Service.start()
	if started then return end
	started = true
	transit = Instance.new("Folder")
	transit.Name = "MetroTransit"
	transit:SetAttribute("Ready", false)
	remote = Instance.new("RemoteEvent")
	remote.Name, remote.Parent = "Ride", transit
	transit.Parent = ReplicatedStorage
	local function added(model)
		local id = model:GetAttribute("MetroStopId")
		if not Schedule.OTHER[id] or not ready(model) or (stops[id] and stops[id].model == model) then return end
		local hull = Train.build(model, model.TrainDock.CFrame, true)
		local stop = { model = model, hull = hull, collisionEnabled = nil }
		stops[id] = stop
		setCollision(stop, false)
		stop.connection = model.Boarding.MetroBoardPrompt.Triggered:Connect(function(player) board(player, model) end)
	end
	CollectionService:GetInstanceAddedSignal("MetroStop"):Connect(added)
	CollectionService:GetInstanceRemovedSignal("MetroStop"):Connect(function(model)
		local id = model:GetAttribute("MetroStopId")
		local stop = stops[id]
		if stop and stop.model == model then
			stop.connection:Disconnect()
			stops[id] = nil
		end
		for player, ride in rides do
			if ride.source == model or ride.destination == model then
				if not ready(ride.source) and ready(ride.destination) and ride.streamed == nil then
					-- Keep the avatar anchored until the already-running preload returns.
					ride.recovering = true
				else
					local other = if ready(ride.source) then ride.source else ride.destination
					finish(player, ride, other, true)
				end
			end
		end
	end)
	for _, model in CollectionService:GetTagged("MetroStop") do added(model) end
	Players.PlayerRemoving:Connect(function(player)
		local ride = rides[player]
		if ride then finish(player, ride, nil, true) end
		releasePin(player, pins[player])
		pins[player], cooldown[player] = nil, nil
	end)
	local elapsed, lastBoarding, lastCycle = 0, false, nil
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.05 then return end
		elapsed = 0
		local now = workspace:GetServerTimeNow()
		local state, active = Schedule.state(now), running() and true or false
		transit:SetAttribute("Ready", active)
		-- Snapshot passengers before disabling the walkable hull at door closure.
		if active and lastBoarding and (not state.boarding or state.cycle ~= lastCycle) then
			for _, stop in stops do
				for _, player in Players:GetPlayers() do beginRide(player, stop.model, state) end
			end
		end
		for _, stop in stops do
			stop.model.Boarding.MetroBoardPrompt.Enabled = active and state.boarding
			setCollision(stop, active and state.boarding)
		end
		lastBoarding, lastCycle = active and state.boarding, state.cycle
		for player, ride in rides do
			local character, _, root = body(player)
			if character ~= ride.character or root ~= ride.root then
				finish(player, ride, ride.source, true)
				continue
			end
			if ride.recovering then continue end
			if not active or not ready(ride.current) then
				finish(player, ride, ride.source, true)
				continue
			end
			if now >= ride.cycle * 60 + Schedule.TRANSFER and not ride.transferred and ride.streamed then
				ride.current, ride.transferred = ride.destination, true
				remote:FireClient(player, "Transfer", { dock = ride.destination.TrainDock.CFrame })
			end
			if now >= (ride.cycle + 1) * 60 + Schedule.OPEN then
				finish(player, ride, if ride.transferred then ride.destination else ride.source, not ride.transferred)
			else
				ride.character:PivotTo(Schedule.frame(ride.current.TrainDock.CFrame, now) * ride.offset)
				root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
			end
		end
		-- A missed train cannot strand someone in the track bed beneath the platform.
		for _, player in Players:GetPlayers() do
			if rides[player] then continue end
			local character, _, root = body(player)
			if not character then continue end
			for _, stop in stops do
				local q = stop.model.TrainDock.CFrame:PointToObjectSpace(root.Position)
				if math.abs(q.X) < 95 and math.abs(q.Z) < 8 and q.Y < -0.5 and q.Y > -15 then
					character:PivotTo(stop.model.Arrival.CFrame)
					root.AssemblyLinearVelocity = Vector3.zero
				end
			end
		end
	end)
end

return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="204">
        <Properties>
          <string name="Name">MscPreziosa</string>
          <string name="Source"><![CDATA[-- A 1:1 model of the cruise ship MSC Preziosa (Fantasia class, STX France, 2013): 333.3 m long,
-- 37.9 m beam and 8.65 m draught, at the game's scale of 0.28 m per stud.
--
-- The deck outlines were traced from MSC's published plans of decks 4-18. Each plan was lined up
-- with the others by its lift shafts, which run straight through the ship: lined up that way every
-- deck ends within 2 m of the 333 m stern. Decks 13-18 are drawn at about 0.88x the scale of the
-- lower plans (their cabins are narrower on paper), which is corrected here. Deck heights, the stem
-- rake, the funnel, mast and lifeboats were measured from broadside and stern-quarter photographs,
-- and the livery (striped balcony decks, slanted blue glazing over the bridge, the slatted funnel
-- with its compass emblem, the hull logos) from bow, broadside and aerial photographs.
--
-- The open top decks follow the same photographs: the Yacht Club forward with its glass-fronted
-- Top Sail Lounge and The One Pool, the magrodome over La Playa Preziosa, the round Galaxy/Sky &
-- Stars pavilion, the horizontally louvered funnel over the Top 18 solarium, and the Garden pool
-- terrace at the stern.
--
-- Ship coordinates are metres: x aft from the tip of the bow, y to starboard of the centre line and
-- z up from the waterline. The model's origin is the waterline amidships, with the bow towards -X.
-- Vector3s passed to strut() and tube() hold ship coordinates (x, y, z) in metres.
local MscPreziosa = {}

MscPreziosa.LENGTH = 333.3
MscPreziosa.BEAM = 37.9
MscPreziosa.DRAUGHT = 8.65
MscPreziosa.STUDS = 1 / 0.28 -- studs per metre

local STUDS = MscPreziosa.STUDS
local MID = MscPreziosa.LENGTH / 2
local KEEL = -MscPreziosa.DRAUGHT

local rgb = Color3.fromRGB
local M = Enum.Material
local WHITE = rgb(244, 245, 247)
local ANTIFOULING = rgb(122, 38, 40)
local GLASS = rgb(34, 47, 74)
local RAIL = rgb(150, 182, 205)
local TEAK = rgb(170, 124, 82)
local MOORING = rgb(108, 122, 112)
local FUNNEL = rgb(24, 34, 64)
local STEEL = rgb(150, 156, 162)
local BRONZE = rgb(176, 132, 70)
local ORANGE = rgb(238, 112, 34)
local POOL = rgb(64, 172, 214)
local NAVY = rgb(20, 30, 70)
local CABIN_DARK = rgb(42, 52, 72) -- the shaded cabin wall behind a balcony
local TINTED = rgb(40, 60, 98) -- the blue-tinted balcony glass
local SLANT = rgb(38, 68, 128) -- the glazing over the bridge
local HELM = rgb(206, 64, 36)
local SOOT = rgb(58, 58, 62)

-- Floor of each deck above the waterline (there is no deck 17 on MSC ships)
local FLOOR = {
	[4] = 6.1,
	[5] = 9.0,
	[6] = 12.0,
	[7] = 15.1,
	[8] = 18.2,
	[9] = 21.15,
	[10] = 24.1,
	[11] = 27.05,
	[12] = 30.0,
	[13] = 33.0,
	[14] = 35.95,
	[15] = 39.3,
	[16] = 42.3,
	[18] = 45.3,
}
local ROOF = FLOOR[18]

-- Half-breadth of each deck's outer wall (balcony fronts where there are balconies) as
-- { x, half } points. Decks with an open gap between blocks list one outline per block.
-- Decks 8-13 step in over the lifeboats (x 116-283) and deck 14 cantilevers out above them.
-- stylua: ignore
local PLAN = {
	[4] = { { { 17, 1.3 }, { 20, 1.8 }, { 33, 6.85 }, { 43, 10.18 }, { 55, 13.41 }, { 62, 14.93 }, { 76, 17.45 }, { 95, 18.83 }, { 327, 18.88 }, { 331, 18.5 } } },
	[5] = { { { 17, 1.43 }, { 20, 1.81 }, { 25, 3.9 }, { 34, 7.23 }, { 42, 9.84 }, { 54, 13.27 }, { 64, 15.5 }, { 71, 16.69 }, { 79, 17.74 }, { 89, 18.59 }, { 97, 18.93 }, { 328, 18.97 }, { 332, 18.59 } } },
	[8] = { { { 0, 2.2 }, { 3, 3.66 }, { 7, 6.51 }, { 13, 10.13 }, { 19, 13.08 }, { 23, 14.69 }, { 31, 17.17 }, { 34, 17.78 }, { 37, 18.31 }, { 45, 18.88 }, { 113, 18.97 }, { 114, 17.31 }, { 117, 12.89 }, { 201, 12.89 }, { 202, 14.6 }, { 260, 14.6 }, { 261, 13.03 }, { 277, 12.98 }, { 282, 16.69 }, { 283, 18.78 }, { 329, 18.83 }, { 333, 18.31 } } },
	[9] = { { { 29, 11.08 }, { 30, 11.08 }, { 31, 12.6 }, { 32, 12.6 }, { 34, 14.88 }, { 36, 16.36 }, { 38, 17.45 }, { 40, 18.21 }, { 41, 18.93 }, { 113, 18.93 }, { 114, 17.17 }, { 118, 13.55 }, { 119, 12.84 }, { 201, 12.84 }, { 202, 16.07 }, { 261, 16.07 }, { 262, 12.89 }, { 277, 12.84 }, { 278, 13.22 }, { 282, 16.88 }, { 283, 18.88 }, { 329, 18.88 }, { 333, 18.31 } } },
	[10] = { { { 34, 10.79 }, { 35, 10.79 }, { 36, 12.41 }, { 37, 12.41 }, { 38, 13.74 }, { 39, 14.74 }, { 40, 15.64 }, { 42, 16.98 }, { 46, 18.45 }, { 50, 18.93 }, { 113, 18.93 }, { 114, 17.36 }, { 118, 13.69 }, { 119, 12.84 }, { 201, 12.84 }, { 202, 16.02 }, { 260, 16.02 }, { 261, 12.84 }, { 277, 12.79 }, { 278, 13.41 }, { 282, 17.02 }, { 283, 18.88 }, { 328, 18.88 }, { 332, 18.4 } } },
	[11] = { { { 39, 10.79 }, { 40, 10.79 }, { 41, 12.51 }, { 42, 12.51 }, { 44, 14.84 }, { 47, 16.98 }, { 50, 18.21 }, { 52, 18.69 }, { 55, 18.93 }, { 114, 18.93 }, { 115, 16.69 }, { 119, 13.08 }, { 120, 12.79 }, { 201, 12.84 }, { 202, 15.93 }, { 203, 16.02 }, { 261, 16.02 }, { 262, 12.84 }, { 277, 12.84 }, { 278, 13.27 }, { 282, 16.88 }, { 283, 18.88 }, { 329, 18.88 }, { 331, 18.59 } } },
	[12] = { { { 43, 10.03 }, { 44, 10.03 }, { 45, 11.94 }, { 46, 11.94 }, { 48, 14.46 }, { 49, 15.36 }, { 52, 17.31 }, { 56, 18.59 }, { 59, 18.93 }, { 113, 18.93 }, { 114, 17.4 }, { 119, 12.89 }, { 123, 12.79 }, { 201, 12.84 }, { 202, 16.02 }, { 260, 16.02 }, { 261, 12.89 }, { 276, 12.79 }, { 278, 13.41 }, { 282, 17.02 }, { 283, 18.88 }, { 326, 18.88 }, { 330, 18.5 } } },
	-- The bridge, with its wings reaching 4.7 m past the hull
	[13] = { { { 45, 15.66 }, { 46, 15.66 }, { 47, 20.12 }, { 48, 20.12 }, { 49, 23.17 }, { 50, 23.59 }, { 53, 23.59 }, { 55, 20.18 }, { 56, 18.97 }, { 113, 18.93 }, { 114, 17.4 }, { 118, 13.74 }, { 119, 12.89 }, { 201, 12.84 }, { 202, 15.34 }, { 203, 16.02 }, { 260, 16.02 }, { 261, 12.89 }, { 276, 12.79 }, { 278, 13.41 }, { 282, 17.02 }, { 283, 18.88 }, { 325, 18.88 }, { 327, 18.5 }, { 328, 17.92 }, { 330, 16.39 }, { 331, 16.39 } } },
	[14] = { { { 46, 18.24 }, { 48, 22.05 }, { 50, 23.59 }, { 53, 23.59 }, { 54, 23.14 }, { 56, 19 }, { 57, 18.95 }, { 114, 18.95 }, { 116, 17.8 }, { 283, 17.8 }, { 286, 18.89 }, { 325, 18.95 }, { 327, 18.78 }, { 328, 18.29 }, { 329, 17.2 }, { 330, 17.2 }, { 331, 14.65 }, { 332, 14.65 } } },
	-- The open pool deck's rails
	[15] = { { { 51, 10.07 }, { 53, 11.92 }, { 54, 11.92 }, { 56, 14.48 }, { 57, 15.41 }, { 59, 16.82 }, { 61, 17.86 }, { 63, 18.51 }, { 66, 18.95 }, { 114, 18.95 }, { 116, 17.8 }, { 282, 17.75 }, { 284, 18.95 }, { 325, 18.95 }, { 327, 18.62 }, { 329, 17.37 }, { 330, 15.79 }, { 331, 12.2 }, { 333, 7.73 }, { 334, 7.73 } } },
	-- The MSC Yacht Club forward, the sports and funnel block aft
	[16] = {
		{ { 58, 10.83 }, { 59, 10.83 }, { 60, 12.47 }, { 61, 12.47 }, { 63, 14.86 }, { 64, 15.73 }, { 67, 17.59 }, { 70, 18.62 }, { 73, 19 }, { 116, 19 }, { 117, 18.57 }, { 118, 17.8 }, { 144, 17.8 }, { 145, 9.64 }, { 146, 6.81 } },
		{ { 202, 9.09 }, { 204, 12.03 }, { 205, 13.12 }, { 208, 15.52 }, { 210, 16.71 }, { 212, 17.59 }, { 216, 18.51 }, { 220, 18.57 }, { 225, 17.42 }, { 229, 15.35 }, { 232, 14.21 }, { 236, 14.21 }, { 237, 13.01 }, { 240, 13.01 }, { 242, 11.38 }, { 246, 11.11 }, { 247, 11.43 }, { 249, 14.48 }, { 252, 14.48 }, { 256, 13.67 }, { 269, 13.67 }, { 271, 13.99 }, { 275, 15.79 }, { 277, 16.28 }, { 280, 16.28 }, { 284, 15.14 }, { 286, 14.26 }, { 289, 14.26 }, { 296, 15.3 }, { 300, 15.52 }, { 305, 15.35 }, { 309, 14.21 }, { 311, 13.12 }, { 314, 10.56 }, { 316, 7.95 }, { 319, 6.04 } },
	},
	-- The Top Sail Lounge forward, the solarium and funnel base aft
	[18] = {
		{ { 69, 10.89 }, { 70, 10.89 }, { 71, 12.63 }, { 72, 12.63 }, { 74, 14.81 }, { 77, 16.99 }, { 79, 17.97 }, { 81, 18.62 }, { 83, 18.84 }, { 134, 18.95 }, { 136, 17.86 }, { 148, 17.86 } },
		-- Aft of the funnel casing deck 18 is the open deck round the kids' aqua park
		{ { 207, 8.28 }, { 209, 11.54 }, { 210, 12.74 }, { 212, 14.59 }, { 214, 16.01 }, { 216, 17.1 }, { 220, 18.4 }, { 222, 18.67 }, { 225, 18.67 }, { 228, 18.29 }, { 232, 16.88 }, { 234, 15.79 }, { 237, 13.34 }, { 243, 13.23 }, { 252, 13.5 }, { 260, 12.5 }, { 261, 10.07 }, { 266, 10.07 }, { 267, 7.08 }, { 284, 7.08 } },
	},
}
MscPreziosa.PLAN = PLAN
MscPreziosa.FLOOR = FLOOR

-- How each deck's sides look along its length: a white wall with a ribbon of windows (taller on
-- the bridge and the solarium), recessed balconies behind blue-tinted glass, a plain white stair
-- tower, a full-height glass band, glazing that leans back over the bridge, or a wall with long
-- separate windows. The balcony decks over the lifeboats are framed by white stair towers.
local function recessed(head)
	local style = table.clone(head)
	for _, range in
		{
			{ 112, 118, "wall" },
			{ 118, 199, "balcony" },
			{ 199, 203, "wall" },
			{ 203, 259, "balcony" },
			{ 259, 263, "wall" },
			{ 263, 276, "balcony" },
			{ 276, 280, "wall" },
			{ 283, 999, "balcony" },
		}
	do
		table.insert(style, range)
	end
	return style
end
local STYLE = {
	-- Deck 8's hull plating forward of x 31 belongs to the hull
	[8] = recessed({ { 31, 112, "windows" } }),
	[9] = recessed({ { 0, 112, "windows" } }),
	[10] = recessed({ { 0, 98, "windows" }, { 98, 112, "balcony" } }),
	[11] = recessed({ { 0, 103, "windows" }, { 103, 112, "balcony" } }),
	[12] = recessed({ { 0, 107, "windows" }, { 107, 112, "balcony" } }),
	[13] = recessed({ { 0, 62, "bridge" }, { 62, 112, "windows" } }),
	[14] = { { 0, 57, "slant" }, { 57, 999, "panels" } },
	[15] = { { 0, 66, "strip" }, { 66, 117, "balcony" }, { 200, 999, "few" } },
	[16] = { { 0, 73, "windows" }, { 73, 150, "balcony" }, { 200, 999, "few" } },
	[18] = { { 0, 80, "slant" }, { 80, 200, "band" }, { 200, 264, "tall" }, { 264, 999, "wall" } },
}
-- Balcony width: the partitions between balconies sit on one grid through every deck
local BAY = 3.6

local function sample(poly, x: number): number
	if x < poly[1][1] or x > poly[#poly][1] then
		return 0
	end
	for i = 1, #poly - 1 do
		local a, b = poly[i], poly[i + 1]
		if x <= b[1] then
			local span = b[1] - a[1]
			return if span <= 0 then b[2] else a[2] + (b[2] - a[2]) * (x - a[1]) / span
		end
	end
	return poly[#poly][2]
end
MscPreziosa.sample = sample

-- The part of an outline between two stations
local function clip(poly, a: number, b: number)
	a, b = math.max(a, poly[1][1]), math.min(b, poly[#poly][1])
	local out = {}
	if b - a < 0.01 then
		return out
	end
	table.insert(out, { a, sample(poly, a) })
	for _, p in poly do
		if p[1] > a and p[1] < b then
			table.insert(out, p)
		end
	end
	table.insert(out, { b, sample(poly, b) })
	return out
end

-- Replaces an outline's front, up to station xe, with a quarter ellipse running from a flat face
-- `face` half-breadth wide at x0 round to the deck's breadth at xe. The plans draw the fronts as
-- little steps; photographs show them as smooth curves.
local function rounded(poly, x0: number, face: number, xe: number)
	local full = sample(poly, xe)
	local out = {}
	for i = 0, 12 do
		local t = i / 12 * math.pi / 2
		table.insert(out, { xe - (xe - x0) * math.cos(t), face + (full - face) * math.sin(t) })
	end
	for _, p in poly do
		if p[1] > xe + 0.01 then
			table.insert(out, p)
		end
	end
	return out
end
-- { deck, piece, front, face half-breadth, station where it reaches full breadth }
for _, front in
	{
		{ 9, 1, 29, 11.08, 41 },
		{ 10, 1, 34, 10.79, 50 },
		{ 11, 1, 39, 10.79, 55 },
		{ 12, 1, 43, 10.03, 59 },
		-- The bridge front curves in one sweep out to the wing ends
		{ 13, 1, 44.5, 6, 50 },
		{ 15, 1, 51, 10.07, 66 },
		{ 16, 1, 58, 10.83, 73 },
		{ 18, 1, 69, 10.89, 83 },
	}
do
	PLAN[front[1]][front[2]] = rounded(PLAN[front[1]][front[2]], front[3], front[4], front[5])
end

-- Rounds an outline's after end over its last `length` metres, from its breadth there to a stern
-- face `face` half-breadth wide: the stern's corners curve round in plan, tier on tier
local function roundedEnd(poly, length: number, face: number)
	local xs = poly[#poly][1] - length
	local full = sample(poly, xs)
	local out = {}
	for _, p in poly do
		if p[1] < xs - 0.01 then
			table.insert(out, p)
		end
	end
	for i = 0, 12 do
		local t = i / 12 * math.pi / 2
		table.insert(out, { xs + length * math.sin(t), full - (full - face) * (1 - math.cos(t)) })
	end
	return out
end
-- { deck, piece, length of the curve, stern face half-breadth }
for _, stern in
	{
		{ 4, 1, 14, 9.5 },
		{ 5, 1, 14, 9.5 },
		{ 8, 1, 20, 9.5 },
		{ 9, 1, 20, 9.5 },
		{ 10, 1, 20, 9.5 },
		{ 11, 1, 20, 9.5 },
		{ 12, 1, 20, 9.5 },
		{ 13, 1, 18, 9 },
		{ 14, 1, 18, 9 },
		{ 15, 1, 16, 7.7 },
	}
do
	PLAN[stern[1]][stern[2]] = roundedEnd(PLAN[stern[1]][stern[2]], stern[3], stern[4])
end

-- The wings on deck 14 are only the bridge roof; the enclosed deck starts behind it, its front
-- curving like the bridge's
local DECK14 = {}
for _, p in clip(PLAN[14][1], 46.6, PLAN[14][1][#PLAN[14][1]][1]) do
	table.insert(DECK14, { p[1], math.min(p[2], 18.95) })
end
DECK14 = rounded(DECK14, 46.6, 9, 52.5)

local function widen(poly, by: number)
	local out = {}
	for _, p in poly do
		table.insert(out, { p[1], math.max(p[2] + by, 0) })
	end
	return out
end

-- Holds an outline to `limit` between two stations
local function capped(poly, a: number, b: number, limit: number)
	local out = clip(poly, poly[1][1], a)
	table.insert(out, { a + 0.6, math.min(limit, sample(poly, a + 0.6)) })
	for _, p in poly do
		if p[1] > a + 0.6 and p[1] < b - 0.6 then
			table.insert(out, { p[1], math.min(limit, p[2]) })
		end
	end
	table.insert(out, { b - 0.6, math.min(limit, sample(poly, b - 0.6)) })
	for i, p in clip(poly, b, poly[#poly][1]) do
		if i > 1 or p[1] > b - 0.6 then
			table.insert(out, p)
		end
	end
	return out
end

-- The highest deck under a point of the open top decks, if any
local function floorAt(x: number, y: number): number?
	local off = math.abs(y)
	if off < 12.5 and x > 238 and x < 292 then
		return ROOF
	elseif off < sample(PLAN[16][2], x) and x > 202 and x < 316 then
		return FLOOR[16]
	elseif off < sample(PLAN[16][1], x) then
		return FLOOR[18]
	elseif off < sample(PLAN[15][1], x) then
		return FLOOR[15]
	end
	return nil
end

-- The hull plating below deck 9. The stem rakes 1.25 m forward for every metre of height (deck 4's
-- point is 17 m behind the tip of the bow and deck 8's is at it); the bow flares from deck 5's fine
-- entry to deck 8's full one, the bilges round in below 3 m and the stern cuts up under water.
local STEM_RAKE = 1.25
local function stemAt(z: number): number
	return math.max(0, 17 + (6.1 - z) * STEM_RAKE)
end
local function hullPlan(z: number)
	local tip = stemAt(z)
	local stern = if z >= 1 then 331.5 else 331.5 - (1 - z) * 3
	local flare = math.clamp((z - 9) / 9.2, 0, 1)
	local bilge = if z >= -3 then 1 else 1 - 0.2 * ((-3 - z) / 5.65) ^ 2
	local fine, full = PLAN[5][1], PLAN[8][1]
	local out = {}
	for _, u in { 0, 1, 2, 3, 5, 7, 10, 13, 16, 20, 25, 30, 36, 43, 50, 58, 67, 77, 88, 100 } do
		local entry = if 17 + u > 97 then 18.93 else sample(fine, 17 + u)
		local half = entry + (sample(full, math.min(u, 100)) - entry) * flare
		table.insert(out, { tip + u, half * bilge })
	end
	-- The stern's corners curve round in plan to a broad, gently rounded transom
	for i = 0, 10 do
		local t = i / 10 * math.pi / 2
		table.insert(out, { stern - 18 + 18 * math.sin(t), (18.93 - 8.4 * (1 - math.cos(t))) * bilge })
	end
	return out
end
MscPreziosa.hullPlan = hullPlan

local origin = Vector3.zero
local built = 0
-- Building thousands of parts in one go trips the script timeout, so part() hands the frame back
-- whenever a stretch of work runs past BUDGET seconds
local BUDGET = 1 / 60
local pause: () -> () = function() end
local resumed = 0

local function at(x: number, y: number, z: number): Vector3
	return origin + Vector3.new((x - MID) * STUDS, z * STUDS, y * STUDS)
end

local function part(
	parent: Instance,
	name: string,
	size: Vector3,
	frame: CFrame,
	color: Color3,
	material: Enum.Material,
	kind: string?
): BasePart
	local p = Instance.new(kind or "Part") :: BasePart
	p.Name = name
	p.Size = size
	p.CFrame = frame
	p.Anchored = true
	p.CanTouch = false
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	built += 1
	if os.clock() - resumed > BUDGET then
		pause()
		resumed = os.clock()
	end
	return p
end

-- A box between ship coordinates, in metres
local function box(
	parent: Instance,
	name: string,
	x0: number,
	x1: number,
	y0: number,
	y1: number,
	z0: number,
	z1: number,
	color: Color3,
	material: Enum.Material?
): BasePart
	return part(
		parent,
		name,
		Vector3.new(x1 - x0, z1 - z0, y1 - y0) * STUDS,
		CFrame.new(at((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2)),
		color,
		material or M.SmoothPlastic
	)
end

-- A box from a to b on one side of the ship, whichever way round they are
local function sideBox(
	parent: Instance,
	name: string,
	x0: number,
	x1: number,
	a: number,
	b: number,
	z0: number,
	z1: number,
	color: Color3,
	material: Enum.Material?
): BasePart
	return box(parent, name, x0, x1, math.min(a, b), math.max(a, b), z0, z1, color, material)
end

-- A beam from a to b, `width` across and `depth` along `normal` (a world direction; any if nil)
local function strut(
	parent: Instance,
	name: string,
	a: Vector3,
	b: Vector3,
	width: number,
	depth: number,
	color: Color3,
	material: Enum.Material?,
	normal: Vector3?
): BasePart?
	local p, q = at(a.X, a.Y, a.Z), at(b.X, b.Y, b.Z)
	local length = (q - p).Magnitude
	if length < 0.05 then
		return nil
	end
	local zAxis = (q - p) / length
	local hint = normal or (if math.abs(zAxis.Y) < 0.95 then Vector3.yAxis else Vector3.xAxis)
	local yAxis = (hint - zAxis * hint:Dot(zAxis)).Unit
	return part(
		parent,
		name,
		Vector3.new(width * STUDS, depth * STUDS, length),
		CFrame.fromMatrix((p + q) / 2, yAxis:Cross(zAxis), yAxis, zAxis),
		color,
		material or M.SmoothPlastic
	)
end

-- A cylinder from a to b, run on a little at each end so a chain of them has no gaps
local function tube(
	parent: Instance,
	name: string,
	a: Vector3,
	b: Vector3,
	diameter: number,
	color: Color3,
	material: Enum.Material?
): BasePart?
	local p, q = at(a.X, a.Y, a.Z), at(b.X, b.Y, b.Z)
	local length = (q - p).Magnitude
	if length < 0.05 then
		return nil
	end
	local xAxis = (q - p) / length
	local zAxis = xAxis:Cross(if math.abs(xAxis.Y) < 0.95 then Vector3.yAxis else Vector3.zAxis).Unit
	local pipe = part(
		parent,
		name,
		Vector3.new(length + diameter * 0.3 * STUDS, diameter * STUDS, diameter * STUDS),
		CFrame.fromMatrix((p + q) / 2, xAxis, zAxis:Cross(xAxis), zAxis),
		color,
		material or M.SmoothPlastic
	)
	pipe.Shape = Enum.PartType.Cylinder
	return pipe
end

-- A right-angled triangle extruded `thickness` studs: r is the right-angle corner, p and q end its
-- two legs (world positions).
local function wedge(
	parent: Instance,
	name: string,
	r: Vector3,
	p: Vector3,
	q: Vector3,
	thickness: number,
	color: Color3,
	material: Enum.Material?
): BasePart
	local up, back = q - r, r - p
	local yAxis, zAxis = up.Unit, back.Unit
	return part(
		parent,
		name,
		Vector3.new(thickness, up.Magnitude, back.Magnitude),
		CFrame.fromMatrix((p + q) / 2, yAxis:Cross(zAxis), yAxis, zAxis),
		color,
		material or M.SmoothPlastic,
		"WedgePart"
	)
end

-- Extrudes an outline (mirrored either side of y = centre, the centre line by default) between two
-- heights. Each stretch is a box as wide as its narrower end, with wedges filling out the taper on
-- either side.
local function slab(
	parent: Instance,
	name: string,
	poly,
	z0: number,
	z1: number,
	color: Color3,
	material: Enum.Material?,
	centre: number?
): { BasePart }
	local made = {}
	local zm = (z0 + z1) / 2
	local yc = centre or 0
	for i = 1, #poly - 1 do
		local a, b = poly[i], poly[i + 1]
		local length = b[1] - a[1]
		local lo, hi = math.min(a[2], b[2]), math.max(a[2], b[2])
		if length < 0.01 or hi < 0.05 then
			continue
		end
		if lo > 0.05 then
			table.insert(made, box(parent, name, a[1], b[1], yc - lo, yc + lo, z0, z1, color, material))
		end
		if hi - lo > 0.05 then
			local wide, narrow = if a[2] > b[2] then a[1] else b[1], if a[2] > b[2] then b[1] else a[1]
			for _, side in { -1, 1 } do
				table.insert(
					made,
					wedge(
						parent,
						name,
						at(wide, yc + side * lo, zm),
						at(narrow, yc + side * lo, zm),
						at(wide, yc + side * hi, zm),
						(z1 - z0) * STUDS,
						color,
						material
					)
				)
			end
		end
	end
	return made
end

-- A thin wall standing on each edge of an outline (rails, bulwarks)
local function edges(
	parent: Instance,
	name: string,
	poly,
	z0: number,
	height: number,
	color: Color3,
	material: Enum.Material,
	transparency: number
)
	for i = 1, #poly - 1 do
		local a, b = poly[i], poly[i + 1]
		if math.min(a[2], b[2]) < 0.3 or b[1] - a[1] < 0.01 then
			continue
		end
		for _, side in { -1, 1 } do
			local p, q = at(a[1], side * a[2], z0 + height / 2), at(b[1], side * b[2], z0 + height / 2)
			local along = (q - p).Unit
			local wall = part(
				parent,
				name,
				Vector3.new(0.12 * STUDS, height * STUDS, (q - p).Magnitude),
				CFrame.fromMatrix((p + q) / 2, Vector3.yAxis:Cross(-along), Vector3.yAxis, -along),
				color,
				material
			)
			wall.Transparency = transparency
			wall.CastShadow = false
		end
	end
end

-- Calls visit(x, half, nx, ny) every `spacing` metres along one side of an outline, with (nx, ny)
-- the outward normal in plan
local function walk(poly, spacing: number, visit: (number, number, number, number) -> ())
	local carry = spacing / 2
	for i = 1, #poly - 1 do
		local a, b = poly[i], poly[i + 1]
		local dx, dy = b[1] - a[1], b[2] - a[2]
		local length = math.sqrt(dx * dx + dy * dy)
		if length < 0.01 then
			continue
		end
		local s = carry
		while s < length do
			local t = s / length
			if a[2] + dy * t > 0.3 then
				visit(a[1] + dx * t, a[2] + dy * t, -dy / length, dx / length)
			end
			s += spacing
		end
		carry = s - length
	end
end

-- Positions spaced `spacing` apart across a front face of half-breadth `half`
local function across(half: number, spacing: number): { number }
	local count = math.floor(2 * half / spacing)
	local out = {}
	for i = 0, count do
		table.insert(out, (i - count / 2) * spacing)
	end
	return out
end

-- White frames between the panes of a window ribbon, round the sides and across the front face
local function mullions(parent: Instance, poly, z0: number, z1: number, spacing: number, front: boolean, width: number?)
	local w = (width or 0.24) / 2
	for _, side in { -1, 1 } do
		walk(poly, spacing, function(x, half)
			box(parent, "Mullion", x - w, x + w, side * half - 0.15, side * half + 0.15, z0, z1, WHITE)
		end)
	end
	if front and poly[1][2] > 1 then
		for _, y in across(poly[1][2] - 0.4, spacing) do
			box(parent, "Mullion", poly[1][1] - 0.15, poly[1][1] + 0.15, y - w, y + w, z0, z1, WHITE)
		end
	end
end

local function ribbon(parent: Instance, poly, z0: number, z1: number, front: boolean)
	-- Kept clear of the ends so it never shares a face with the wall
	local x0, x1 = poly[1][1] + 0.1, poly[#poly][1] - 0.1
	slab(parent, "Windows", widen(clip(poly, x0, x1), 0.06), z0, z1, GLASS)
	if front and poly[1][2] > 1 then
		box(
			parent,
			"Windows",
			poly[1][1] - 0.06,
			poly[1][1] + 0.2,
			-(poly[1][2] - 0.4),
			poly[1][2] - 0.4,
			z0,
			z1,
			GLASS
		)
	end
end

-- A band of panoramic glass on a white block: proud of its sides, and a pane across its flat front
-- face so the glass never shares that face with the wall
local function glazing(parent: Instance, name: string, poly, z0: number, z1: number): { BasePart }
	local x0, half = poly[1][1], poly[1][2]
	local made = slab(parent, name, widen(clip(poly, x0 + 0.1, poly[#poly][1]), 0.08), z0, z1, GLASS, M.Glass)
	if half > 0.5 then
		table.insert(made, box(parent, name, x0 - 0.08, x0 + 0.1, -half, half, z0, z1, GLASS, M.Glass))
	end
	for _, glass in made do
		glass.Transparency = 0.12
		glass.CastShadow = false
	end
	return made
end

local function deckLayer(
	parent: Instance,
	poly,
	z0: number,
	z1: number,
	style: string,
	front: boolean,
	back: boolean,
	stern: boolean?
)
	if style == "wall" then
		slab(parent, "Wall", poly, z0, z1, WHITE)
		-- a narrow ribbon of stair-tower windows keeps the white structural bays from reading blank
		for _, side in { -1, 1 } do
			walk(poly, 3, function(x, half)
				sideBox(
					parent,
					"StairGlass",
					x - 0.55,
					x + 0.55,
					side * (half - 0.04),
					side * half,
					z0 + 1.05,
					z0 + 2.05,
					GLASS
				)
			end)
		end
	elseif style == "windows" or style == "tall" or style == "bridge" then
		slab(parent, "Wall", poly, z0, z1, WHITE)
		local bottom, top, spacing = z0 + 0.8, z1 - 0.45, 2.4
		if style == "tall" then
			bottom, top = z0 + 0.8, z1 - 0.6
		elseif style == "bridge" then
			bottom, top, spacing = z0 + 0.9, z1 - 0.45, 1.5
		end
		ribbon(parent, poly, bottom, top, front)
		mullions(parent, poly, bottom, top, spacing, front)
	elseif style == "few" then
		-- Separate square windows along a white wall
		slab(parent, "Wall", poly, z0, z1, WHITE)
		ribbon(parent, poly, z0 + 1.1, z0 + 2.1, front)
		mullions(parent, poly, z0 + 1.1, z0 + 2.1, 2.6, front, 1.6)
	elseif style == "strip" then
		slab(parent, "Wall", poly, z0, z1, WHITE)
		ribbon(parent, poly, z0 + 0.9, z1 - 0.8, front)
	elseif style == "balcony" then
		-- Real balcony decks read as a thick white fascia at each floor with a continuous band of
		-- dark glass above it, divided only by slim white partitions
		local fascia = 0.95
		slab(parent, "Balconies", poly, z0, z0 + fascia, WHITE)
		local inner = widen(poly, -1.55)
		inner = clip(inner, inner[1][1] + (if front then 1.55 else 0), inner[#inner][1] - (if back then 1.55 else 0))
		if #inner > 1 then
			slab(parent, "Cabins", inner, z0 + fascia, z1, CABIN_DARK)
			-- White partitions between neighbouring balconies, spaced along the hull so they stay
			-- evenly spread round the curved stern instead of bunching up on the x grid
			for _, side in { -1, 1 } do
				walk(poly, BAY, function(x, half, nx, ny)
					if half > 2 then
						local ox, oy = x, side * half
						local ix, iy = x - nx * 1.05, oy - side * ny * 1.05
						local mid = at((ix + ox) / 2, (iy + oy) / 2, (z0 + z1) / 2)
						local tangent = Vector3.new(side * ny, 0, -nx).Unit
						local outward = Vector3.new(nx, 0, side * ny).Unit
						part(
							parent,
							"Partition",
							Vector3.new(0.1 * STUDS, (z1 - z0) * STUDS, 1.05 * STUDS),
							CFrame.fromMatrix(mid, tangent, Vector3.yAxis, outward),
							rgb(228, 230, 233),
							M.SmoothPlastic
						)
					end
				end)
			end
		end
		for _, rail in slab(parent, "BalconyGlass", poly, z0 + fascia, z1 - 0.08, TINTED, M.Glass) do
			rail.Transparency = 0.08
			rail.CastShadow = false
		end
		-- A slim white handrail capping the glass
		for _, cap in slab(parent, "BalconyRail", widen(poly, 0.02), z1 - 0.12, z1 - 0.02, WHITE) do
			cap.CastShadow = false
		end
	elseif style == "band" then
		slab(parent, "Wall", poly, z0, z0 + 0.4, WHITE)
		slab(parent, "Windows", widen(poly, -0.3), z0 + 0.4, z1 - 0.4, GLASS)
		slab(parent, "Wall", poly, z1 - 0.4, z1, WHITE)
		mullions(parent, widen(poly, -0.3), z0 + 0.4, z1 - 0.4, 1.8, front)
	elseif style == "panels" then
		-- Long windows with white piers between them
		slab(parent, "Wall", poly, z0, z1, WHITE)
		local x0, x1 = poly[1][1] + 0.1, poly[#poly][1] - 0.1
		for a = x0, x1 - 2, 13.5 do
			local pane = clip(poly, a + 0.75, math.min(a + 12.75, x1))
			if #pane > 1 then
				slab(parent, "Windows", widen(pane, 0.06), z0 + 0.9, z1 - 0.7, GLASS)
			end
		end
	elseif style == "slant" then
		-- Blue glazing that leans back 1 m from a white sill, in three steps, with raked mullions
		local sill, head = z0 + 0.5, z1 - 0.4
		slab(parent, "Wall", poly, z0, sill, WHITE)
		local x0, x1 = poly[1][1], poly[#poly][1]
		for k = 0, 2 do
			local inset = 0.25 + k * 0.35
			local pane = clip(widen(poly, -inset), x0 + inset, x1 - (if back then inset else 0))
			for _, glass in
				slab(
					parent,
					"Glazing",
					pane,
					sill + k * (head - sill) / 3,
					sill + (k + 1) * (head - sill) / 3,
					SLANT,
					M.Glass
				)
			do
				glass.Transparency = 0.1
			end
		end
		slab(parent, "Wall", clip(widen(poly, -1.2), x0 + 1.2, x1), head, z1, WHITE)
		for _, side in { -1, 1 } do
			walk(poly, 1.6, function(x, half, nx, ny)
				strut(
					parent,
					"Mullion",
					Vector3.new(x - nx * 0.2, side * (half - ny * 0.2), sill),
					Vector3.new(x - nx * 1.2, side * (half - ny * 1.2), head),
					0.14,
					0.14,
					WHITE
				)
			end)
		end
		if front then
			for _, y in across(poly[1][2] - 0.6, 1.6) do
				strut(
					parent,
					"Mullion",
					Vector3.new(x0 + 0.2, y, sill),
					Vector3.new(x0 + 1.2, y, head),
					0.14,
					0.14,
					WHITE
				)
			end
		end
	end
	-- The plans list the stern as an open end; close it with a proper transom so the balconies and
	-- windows continue across the flat after face
	if stern then
		local endp = poly[#poly]
		local x, half = endp[1], endp[2]
		if half > 0.5 then
			-- Sit the detail a few centimetres proud of the plating so nothing z-fights
			local back0, back1 = x - 0.32, x - 0.05
			local face0, face1 = x - 0.025, x + 0.025
			box(parent, "SternBulkhead", back0, back1, -half, half, z0, z1, WHITE)
			if style == "balcony" then
				box(parent, "Balconies", face0, face1, -half, half, z0, z0 + 0.95, WHITE)
				local glass = box(
					parent,
					"BalconyGlass",
					face0,
					face1,
					-half + 0.12,
					half - 0.12,
					z0 + 0.95,
					z1 - 0.1,
					TINTED,
					M.Glass
				)
				glass.Transparency = 0.2
				glass.CastShadow = false
				for y = -half + 1.55, half - 1.55, BAY do
					box(parent, "Partition", face0 - 0.02, face1 + 0.02, y - 0.07, y + 0.07, z0 + 0.95, z1, WHITE)
				end
				box(parent, "BalconyRail", face0 - 0.02, face1 + 0.02, -half, half, z1 - 0.12, z1 - 0.02, WHITE)
			elseif style ~= "wall" then
				local bottom, top = z0 + 1, z0 + 2.1
				if style == "tall" then
					bottom, top = z0 + 0.8, z1 - 0.6
				elseif style == "bridge" then
					bottom, top = z0 + 0.9, z1 - 0.45
				elseif style == "strip" or style == "band" then
					bottom, top = z0 + 0.7, z1 - 0.5
				elseif style == "panels" then
					bottom, top = z0 + 0.9, z1 - 0.7
				end
				box(parent, "SternWindows", face0, face1, -half + 1.2, half - 1.2, bottom, top, GLASS)
				if style ~= "few" and style ~= "panels" then
					for y = -half + 1.2, half - 1.2, 2.6 do
						box(parent, "Mullion", face0 - 0.02, face1 + 0.02, y - 0.06, y + 0.06, bottom, top, WHITE)
					end
				end
			end
		end
	end
end

local function buildDeck(parent: Instance, deck: number, top: number, pieces)
	local folder = Instance.new("Model")
	folder.Name = "Deck " .. deck
	folder.Parent = parent
	for _, piece in pieces do
		for _, range in STYLE[deck] do
			local sub = clip(piece, range[1], range[2])
			if #sub > 1 then
				local stern = piece[#piece][1] > 320 and range[2] >= piece[#piece][1]
				deckLayer(
					folder,
					sub,
					FLOOR[deck],
					top,
					range[3],
					range[1] <= piece[1][1],
					range[2] >= piece[#piece][1],
					stern
				)
			end
		end
	end
	return folder
end

-- Forward of BOW_END the hull is a smooth skin; aft of it the hull is parallel-sided and thick
-- layers do.
local BOW_END = 100
-- Where each contour is sampled, as a fraction of the way from the stem to the end of the skin
local STATIONS = { 0, 0.015, 0.035, 0.06, 0.09, 0.13, 0.18, 0.25, 0.33, 0.43, 0.55, 0.7, 0.85, 1 }

-- A flat triangle on a, b, c (world positions) `thickness` metres thick, sunk inside its outer face
-- (the side facing `outward`): two right-angled wedges split at the apex's foot on the longest edge
local function triangle(
	parent: Instance,
	name: string,
	a: Vector3,
	b: Vector3,
	c: Vector3,
	outward: Vector3,
	thickness: number,
	color: Color3
)
	local ab, bc, ca = (b - a).Magnitude, (c - b).Magnitude, (a - c).Magnitude
	if bc >= ab and bc >= ca then
		a, b, c = b, c, a
	elseif ca >= ab and ca >= bc then
		a, b, c = c, a, b
	end
	local edge = b - a
	local length = edge.Magnitude
	if length < 0.02 then
		return
	end
	local foot = a + edge * ((c - a):Dot(edge) / (length * length))
	if (c - foot).Magnitude < 0.02 then
		return
	end
	local n = edge:Cross(c - a).Unit
	if n:Dot(outward) < 0 then
		n = -n
	end
	local sink = n * (-thickness * STUDS / 2)
	for _, corner in { a, b } do
		if (foot - corner).Magnitude > 0.02 then
			wedge(parent, name, foot + sink, corner + sink, c + sink, thickness * STUDS, color)
		end
	end
end

-- Skins the bow between hull contours at the given heights, from the stem aft to station xEnd
local function bowSkin(parent: Instance, levels: { number }, xEnd: number)
	local function contour(z: number)
		local plan = hullPlan(z)
		local tip = plan[1][1]
		local out = {}
		for _, s in STATIONS do
			local x = tip + s * (xEnd - tip)
			table.insert(out, { x, sample(plan, x) })
		end
		return out
	end
	for k = 1, #levels - 1 do
		local za, zb = levels[k], levels[k + 1]
		local lower, upper = contour(za), contour(zb)
		local color = if zb <= 0 then ANTIFOULING else WHITE
		for _, side in { -1, 1 } do
			local outward = Vector3.new(0, 0, side)
			for i = 1, #STATIONS - 1 do
				local p1 = at(lower[i][1], side * lower[i][2], za)
				local p2 = at(lower[i + 1][1], side * lower[i + 1][2], za)
				local q1 = at(upper[i][1], side * upper[i][2], zb)
				local q2 = at(upper[i + 1][1], side * upper[i + 1][2], zb)
				triangle(parent, "Hull", p1, p2, q1, outward, 0.3, color)
				triangle(parent, "Hull", p2, q2, q1, outward, 0.3, color)
			end
		end
		-- Across the blunt face of the stem
		local p1, p2 = at(lower[1][1], -lower[1][2], za), at(lower[1][1], lower[1][2], za)
		local q1, q2 = at(upper[1][1], -upper[1][2], zb), at(upper[1][1], upper[1][2], zb)
		triangle(parent, "Hull", p1, p2, q1, -Vector3.xAxis, 0.3, color)
		triangle(parent, "Hull", p2, q2, q1, -Vector3.xAxis, 0.3, color)
	end
end

local function buildHull(parent: Instance)
	local hull = Instance.new("Model")
	hull.Name = "Hull"
	hull.Parent = parent
	local function colour(z1: number): Color3
		return if z1 <= 0 then ANTIFOULING else WHITE
	end
	-- A flat plate closing the open after end of each hull layer, so the transom is watertight
	local function transom(outline, z0: number, z1: number, color: Color3)
		local last = outline[#outline]
		if last[2] > 0.5 then
			box(hull, "Transom", last[1] - 0.4, last[1], -last[2], last[2], z0, z1, color)
		end
	end
	-- Antifouling up to the waterline, white plating above it
	for _, layer in { { KEEL, -7 }, { -7, -5 }, { -5, -3 } } do
		local z0, z1 = layer[1], layer[2]
		local plan = hullPlan((z0 + z1) / 2)
		slab(hull, "Hull", plan, z0, z1, colour(z1))
		transom(plan, z0, z1, colour(z1))
	end
	-- A thin dark boot-top at the waterline
	slab(hull, "BootTop", hullPlan(0.5), 0.3, 0.62, rgb(26, 38, 66))
	local aft = {
		{ -3, -1, hullPlan(-2) },
		{ -1, 0, hullPlan(-0.5) },
		{ 0, 3, hullPlan(1.5) },
		{ 3, FLOOR[4], hullPlan(4.5) },
		{ FLOOR[4], FLOOR[5], PLAN[4][1] },
		{ FLOOR[5], FLOOR[6], PLAN[5][1] },
		{ FLOOR[6], FLOOR[7], hullPlan(13.5) },
		-- Deck 7 is a promenade recessed behind the lifeboats
		{ FLOOR[7], FLOOR[8], capped(hullPlan(16.6), 117, 282, 16) },
	}
	for _, layer in aft do
		local outline = layer[3]
		slab(hull, "Hull", clip(outline, BOW_END, outline[#outline][1]), layer[1], layer[2], colour(layer[2]))
		transom(outline, layer[1], layer[2], colour(layer[2]))
	end
	-- The bow up to deck 9 (above deck 8 only the plating forward of deck 8's windows) is a skin of
	-- triangles between hull contours, so the flare and the raked stem read as one smooth surface
	bowSkin(
		hull,
		{ -3, -1.5, 0, 1.5, 3, 4.5, FLOOR[4], 7.5, FLOOR[5], 10.5, FLOOR[6], 13.5, FLOOR[7], 16.6, FLOOR[8] },
		BOW_END
	)
	bowSkin(hull, { FLOOR[8], 19.2, 20.2, FLOOR[9] }, 31)

	-- Bulbous bow
	local bulb = part(
		hull,
		"BulbousBow",
		Vector3.new(14, 5.4, 5.4) * STUDS,
		CFrame.new(at(31, 0, -4.6)),
		ANTIFOULING,
		M.SmoothPlastic
	)
	bulb.Shape = Enum.PartType.Cylinder
	part(hull, "BulbousBow", Vector3.one * 5.4 * STUDS, CFrame.new(at(24, 0, -4.6)), ANTIFOULING, M.SmoothPlastic).Shape =
		Enum.PartType.Ball

	-- Twin shafts, propellers and rudders under the stern
	for _, side in { -1, 1 } do
		local y = side * 6.5
		local shaft = part(hull, "Shaft", Vector3.new(24, 0.8, 0.8) * STUDS, CFrame.new(at(306, y, -5)), STEEL, M.Metal)
		shaft.Shape = Enum.PartType.Cylinder
		local hub =
			part(hull, "Propeller", Vector3.new(1.6, 1.6, 1.6) * STUDS, CFrame.new(at(318.5, y, -5)), BRONZE, M.Metal)
		hub.Shape = Enum.PartType.Ball
		for blade = 0, 3 do
			local spin = CFrame.Angles(blade * math.pi / 2 + 0.4, 0, 0)
			part(
				hull,
				"Propeller",
				Vector3.new(0.3, 2.6, 1.3) * STUDS,
				CFrame.new(at(318.5, y, -5)) * spin * CFrame.new(0, 1.8 * STUDS, 0) * CFrame.Angles(0, 0.35, 0),
				BRONZE,
				M.Metal
			)
		end
		box(hull, "Rudder", 321.5, 326.5, y - 0.35, y + 0.35, -7.8, -0.8, ANTIFOULING)
	end

	-- Rows of round portholes along decks 4 and 5, stopping short of the logo near the stern
	for _, z in { 7.6, 10.6 } do
		local row = hullPlan(z)
		for x = 64, 262, 3.1 do
			local half = sample(row, x)
			for _, side in { -1, 1 } do
				tube(
					hull,
					"Porthole",
					Vector3.new(x, side * (half - 0.1), z),
					Vector3.new(x, side * (half + 0.05), z),
					0.9,
					GLASS
				)
			end
		end
	end
	-- The anchor pockets low on the bow
	for _, side in { -1, 1 } do
		local row = hullPlan(9.4)
		for _, x in { 24.5, 25.5, 26.5 } do
			local half = sample(row, x)
			sideBox(hull, "AnchorPocket", x - 0.5, x + 0.5, side * (half - 0.2), side * (half + 0.06), 8.6, 10.2, GLASS)
		end
		local half = sample(row, 25.5)
		sideBox(hull, "Anchor", 24.9, 26.1, side * (half - 0.1), side * (half + 0.12), 8.9, 9.9, SOOT, M.Metal)
	end
	-- Two long bands of restaurant and lounge windows across the stern, wrapping round the rounded
	-- transom, with white piers between the panes
	for _, band in { { 13.2, 14.85 }, { 16.7, 17.95 } } do
		-- Proud of the plating round the corners and stopped inside the transom plate, so the glass
		-- never shares a face with the hull
		local wrap = widen(clip(hullPlan((band[1] + band[2]) / 2), 320, 331.3), 0.06)
		for _, glass in slab(hull, "SternWindows", wrap, band[1], band[2], GLASS) do
			glass.Transparency = 0.1
			glass.CastShadow = false
		end
		box(hull, "SternWindows", 331.4, 331.62, -10.3, 10.3, band[1], band[2], GLASS)
		for y = -9.6, 9.6, 2.4 do
			box(hull, "SternMullion", 331.35, 331.7, y - 0.08, y + 0.08, band[1], band[2], WHITE)
		end
	end
	-- A line of portholes on the transom below the name
	for y = -8.4, 8.4, 2.4 do
		tube(hull, "Porthole", Vector3.new(331.42, y, 10.35), Vector3.new(331.66, y, 10.35), 0.8, GLASS)
	end
	return hull
end

-- An invisible plate carrying a SurfaceGui on its front face, `width` by `height` metres
local function sign(parent: Instance, frame: CFrame, width: number, height: number): SurfaceGui
	local plate = part(parent, "Lettering", Vector3.new(width, height, 0.05) * STUDS, frame, WHITE, M.SmoothPlastic)
	plate.Transparency = 1
	plate.CanCollide = false
	plate.CanQuery = false
	plate.CastShadow = false
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 12
	gui.LightInfluence = 1
	gui.Parent = plate
	return gui
end

local function words(
	gui: Instance,
	text: string,
	x: number,
	y: number,
	width: number,
	height: number,
	color: Color3,
	font: Enum.Font
)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromScale(x, y)
	label.Size = UDim2.fromScale(width, height)
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.Font = font
	label.Parent = gui
end

-- The MSC emblem: a solid eight-point compass star (four long cardinal points, four shorter
-- diagonal ones) round a thick ring studded with eight dots, and inside it a disc lettered "msc"
-- with a wave between the "m" and the "sc". Built from parts in the plane through `centre`
-- facing `normal` (world vectors).
local function star(
	parent: Instance,
	centre: Vector3,
	normal: Vector3,
	up: Vector3,
	radius: number,
	ink: Color3,
	disc: Color3,
	letters: Color3
)
	local right = up:Cross(normal)
	local r = radius * STUDS
	local function point(angle: number, distance: number): Vector3
		return centre + (right * math.sin(angle) + up * math.cos(angle)) * distance
	end
	for i = 0, 7 do
		local angle = i * math.pi / 4
		local long = i % 2 == 0
		local tip = point(angle, if long then r else r * 0.68)
		local base = point(angle, r * 0.4)
		local spread = (right * math.cos(angle) - up * math.sin(angle)) * r * (if long then 0.17 else 0.13)
		wedge(parent, "Emblem", base, base + spread, tip, 0.06 * STUDS, ink)
		wedge(parent, "Emblem", base, base - spread, tip, 0.06 * STUDS, ink)
	end
	for _, ring in { { 0.47, ink, 0.07 }, { 0.36, disc, 0.09 } } do
		local d = part(
			parent,
			"Emblem",
			Vector3.new(ring[3] * STUDS, 2 * r * ring[1], 2 * r * ring[1]),
			CFrame.fromMatrix(centre + normal * ring[3] * STUDS / 2, normal, up),
			ring[2],
			M.SmoothPlastic
		)
		d.Shape = Enum.PartType.Cylinder
	end
	-- The dots on the ring sit between the points; on a star the colour of its disc they take the
	-- lettering's colour so they still show
	local dots = if ink == disc then letters else disc
	for i = 0, 7 do
		local d = part(
			parent,
			"Emblem",
			Vector3.new(0.09 * STUDS, 2 * r * 0.03, 2 * r * 0.03),
			CFrame.fromMatrix(point((i + 0.5) * math.pi / 4, r * 0.415) + normal * 0.045 * STUDS, normal, up),
			dots,
			M.SmoothPlastic
		)
		d.Shape = Enum.PartType.Cylinder
	end
	local back = -normal
	local gui = sign(
		parent,
		CFrame.fromMatrix(centre + normal * 0.12 * STUDS, up:Cross(back), up, back),
		radius * 0.6,
		radius * 0.6
	)
	words(gui, "m", 0.12, 0.06, 0.76, 0.42, letters, Enum.Font.GothamBlack)
	words(gui, "sc", 0.18, 0.54, 0.64, 0.38, letters, Enum.Font.GothamBlack)
	-- The wave: short dashes following one period of a sine across the middle
	local steps = 14
	for k = 0, steps - 1 do
		local function wave(t: number): (number, number)
			return 0.1 + 0.8 * t, 0.5 - 0.035 * math.sin(t * 2 * math.pi)
		end
		local ax, ay = wave(k / steps)
		local bx, by = wave((k + 1) / steps)
		local dash = Instance.new("Frame")
		dash.BorderSizePixel = 0
		dash.BackgroundColor3 = letters
		dash.AnchorPoint = Vector2.new(0.5, 0.5)
		dash.Position = UDim2.fromScale((ax + bx) / 2, (ay + by) / 2)
		dash.Size = UDim2.fromScale(math.sqrt((bx - ax) ^ 2 + (by - ay) ^ 2) * 1.15, 0.035)
		dash.Rotation = math.deg(math.atan2(by - ay, bx - ax))
		dash.Parent = gui
	end
end

-- The outward normal of the hull plating at station x and height z on one side
local function hullNormal(x: number, z: number, side: number): Vector3
	local function on(px: number, pz: number): Vector3
		return at(px, side * sample(hullPlan(pz), px), pz)
	end
	local n = (on(x + 0.5, z) - on(x - 0.5, z)):Cross(on(x, z + 0.5) - on(x, z - 0.5)).Unit
	return if n.Z * side < 0 then -n else n
end

-- A frame on the hull surface at station x and height z on one side, facing outwards, `lift`
-- metres proud of the plating
local function onHull(poly, x: number, z: number, side: number, lift: number): CFrame
	local p, q = at(x - 1, side * sample(poly, x - 1), z), at(x + 1, side * sample(poly, x + 1), z)
	local outward = Vector3.yAxis:Cross(q - p).Unit
	if outward.Z * side < 0 then
		outward = -outward
	end
	return CFrame.fromMatrix((p + q) / 2 + outward * lift * STUDS, outward:Cross(Vector3.yAxis), Vector3.yAxis)
end

local function buildLivery(parent: Instance)
	local livery = Instance.new("Model")
	livery.Name = "Lettering"
	livery.Parent = parent
	for _, side in { -1, 1 } do
		-- The name under the bridge, and the small emblem near the stem
		local name = sign(livery, onHull(hullPlan(16.6), 52, 16.6, side, 0.08), 20, 1.9)
		words(name, "MSC PREZIOSA", 0, 0, 1, 1, NAVY, Enum.Font.Garamond)
		local n = hullNormal(9, 17.4, side)
		local up = (Vector3.yAxis - n * Vector3.yAxis:Dot(n)).Unit
		local bow = at(9, side * sample(hullPlan(17.4), 9), 17.4) + n * 0.1 * STUDS
		star(livery, bow, n, up, 1.3, NAVY, WHITE, NAVY)
		-- Low on the hull near the stern: the star and "MSC", two decks tall. The group is mirrored
		-- between the two sides, as on the real ship, so it reads from the star outwards on each side
		local reading = side
		local start = if side < 0 then 312 else 268
		local function along(s: number, z: number): CFrame
			return onHull(hullPlan(z), start + reading * s, z, side, 0.12)
		end
		local outward = Vector3.new(0, 0, side)
		star(livery, along(5, 6.0).Position, outward, Vector3.yAxis, 5.2, NAVY, WHITE, NAVY)
		words(sign(livery, along(17.5, 5.9), 14, 5.0), "MSC", 0, 0, 1, 1, NAVY, Enum.Font.Garamond)
	end
	-- Name and port of registry across the stern
	local stern = CFrame.fromMatrix(at(331.56, 0, 15.75), Vector3.zAxis, Vector3.yAxis)
	words(sign(livery, stern, 19, 1.7), "MSC PREZIOSA", 0, 0, 1, 1, NAVY, Enum.Font.Garamond)
	local port = CFrame.fromMatrix(at(331.56, 0, 12.45), Vector3.zAxis, Vector3.yAxis)
	words(sign(livery, port, 6, 0.7), "PANAMA", 0, 0, 1, 1, NAVY, Enum.Font.Garamond)
	return livery
end

-- The bridge front: a heavy white roof over the window band and wings, struts under the wings,
-- and white parapets round the terraces stepping up the front of decks 9-12
local function buildBridge(parent: Instance)
	local front = Instance.new("Model")
	front.Name = "Bridge"
	front.Parent = parent
	-- A heavy roof follows the curve of the bridge and wings, overhanging the windows but stopping
	-- flush with the wing ends
	local bridge = PLAN[13][1]
	local roof = {}
	for _, p in widen(clip(bridge, bridge[1][1], 57), 0.9) do
		table.insert(roof, { p[1], math.min(p[2], 23.59) })
	end
	slab(front, "BridgeRoof", roof, FLOOR[14] - 0.55, FLOOR[14] + 0.65, WHITE)
	box(
		front,
		"BridgeRoof",
		bridge[1][1] - 1.0,
		bridge[1][1] + 0.2,
		-roof[1][2],
		roof[1][2],
		FLOOR[14] - 0.55,
		FLOOR[14] + 0.65,
		WHITE
	)
	edges(front, "WingRail", widen(roof, -0.1), FLOOR[14] + 0.65, 1.15, RAIL, M.Glass, 0.5)
	for _, x in { 48.5, 52.5 } do
		for _, side in { -1, 1 } do
			strut(
				front,
				"WingStrut",
				Vector3.new(x, side * (sample(PLAN[12][1], x) - 0.2), FLOOR[12] + 0.6),
				Vector3.new(x, side * 22.8, FLOOR[13] + 0.05),
				0.35,
				0.5,
				WHITE
			)
		end
	end
	for _, deck in { 9, 10, 11, 12 } do
		local above = if deck == 12 then 13 else deck + 1
		local outline = PLAN[deck][1]
		local terrace = clip(outline, outline[1][1], PLAN[above][1][1][1] + 2)
		edges(front, "Parapet", terrace, FLOOR[above], 1, WHITE, M.SmoothPlastic, 0)
		box(
			front,
			"Parapet",
			terrace[1][1],
			terrace[1][1] + 0.12,
			-terrace[1][2],
			terrace[1][2],
			FLOOR[above],
			FLOOR[above] + 1,
			WHITE
		)
		-- Each deck's front is capped by a white eyebrow that projects over the glazing below
		slab(front, "TerraceLip", widen(terrace, 2.0), FLOOR[above] - 0.65, FLOOR[above] + 0.15, WHITE)
	end
	return front
end

-- The white mast: a tower swept back from a raked fin, two platforms with radar scanners, a signal
-- pole and the dressing lines run down to the jackstaff over a smaller antenna pole
local function buildMast(parent: Instance)
	local mast = Instance.new("Model")
	mast.Name = "Mast"
	mast.Parent = parent
	box(mast, "MastBase", 104, 114, -3, 3, ROOF, ROOF + 3.5, WHITE)
	box(mast, "Mast", 107.5, 111.5, -1.3, 1.3, ROOF, 61.5, WHITE)
	wedge(mast, "Mast", at(107.5, 0, ROOF + 3.5), at(102, 0, ROOF + 3.5), at(107.5, 0, 61.5), 2.6 * STUDS, WHITE)
	for _, deck in { { 57.4, 8.5, 3.4 }, { 61.5, 6, 2.4 } } do
		local z, length, half = deck[1], deck[2], deck[3]
		box(mast, "MastPlatform", 109.5 - length / 2, 109.5 + length / 2, -half, half, z, z + 0.35, WHITE)
		edges(
			mast,
			"MastRail",
			{ { 109.5 - length / 2, half }, { 109.5 + length / 2, half } },
			z + 0.35,
			1,
			RAIL,
			M.Glass,
			0.4
		)
	end
	box(mast, "RadarScanner", 105.6, 106.4, -3.6, 3.6, 58.6, 58.9, STEEL, M.Metal)
	box(mast, "RadarScanner", 112.6, 113.4, -3, 3, 58.6, 58.9, STEEL, M.Metal)
	box(mast, "RadarScanner", 109.1, 109.9, -2.4, 2.4, 62.7, 63, STEEL, M.Metal)
	box(mast, "Mast", 109.2, 109.8, -0.3, 0.3, 61.85, 66.8, WHITE)
	box(mast, "MastYard", 109.3, 109.7, -4, 4, 64.6, 64.9, WHITE)
	box(mast, "AntennaPole", 84.8, 85.2, -0.2, 0.2, ROOF, ROOF + 6.5, WHITE)
	local top, pole, jack =
		Vector3.new(109.5, 0, 66), Vector3.new(85, 0, ROOF + 6.4), Vector3.new(1.55, 0, FLOOR[9] + 6.9)
	strut(mast, "DressingLine", top, pole, 0.05, 0.05, SOOT)
	strut(mast, "DressingLine", pole, jack, 0.05, 0.05, SOOT)
	return mast
end

-- The funnel: a tall, narrow slatted sail standing on the Top 18 deck abaft the Galaxy pavilion.
-- In side view its forward edge rises steeply to a crest about 13 m above the deck, the crest runs
-- aft with a slight crown, and the after edge sweeps down to the solarium. Two fans of horizontal
-- slats fall away from the crest to the deck, with a solid navy panel under the MSC compass on each
-- side and eight exhaust stacks breaking out along the top.
local FUNNEL_AT = { 242, 251, 277, 292 } -- forward foot, crest start/end, aft foot
local FUNNEL_TOP = 59.0
local FUNNEL_BASE = FLOOR[18]
local CREST = 1.35 -- half-breadth of the ridge
local FUNNEL_HALF = 7.6 -- half-breadth at the bottom of the slats

-- The height of the crest at station x
local function crest(x: number): number
	local a, b, c, d = FUNNEL_AT[1], FUNNEL_AT[2], FUNNEL_AT[3], FUNNEL_AT[4]
	if x < b then
		local t = math.clamp((x - a) / (b - a), 0, 1)
		return FUNNEL_BASE + (FUNNEL_TOP - FUNNEL_BASE) * t ^ 1.12
	elseif x <= c then
		return FUNNEL_TOP - 1.8 * ((x - (b + c) / 2) / ((c - b) / 2)) ^ 2
	end
	local t = math.clamp((x - c) / (d - c), 0, 1)
	return FUNNEL_TOP - 1.8 - (FUNNEL_TOP - 1.8 - FUNNEL_BASE) * t ^ 1.9
end

-- How far the slats reach out from the ridge at x: nearly the full breadth amidships, pinching in
-- towards the two feet
local function funnelHalf(x: number): number
	local a, d = FUNNEL_AT[1], FUNNEL_AT[4]
	local nose = math.clamp((x - a) / 11, 0, 1)
	local tail = math.clamp((d - x) / 10, 0, 1)
	return CREST + (FUNNEL_HALF - CREST) * math.sqrt(nose * tail)
end

-- A point on one fan at station x, v from the ridge (0) to the lower edge (1)
local function funnelPoint(x: number, v: number, side: number): Vector3
	local zc = crest(x)
	return Vector3.new(x, side * (CREST + (funnelHalf(x) - CREST) * v), zc - (zc - FUNNEL_BASE) * v)
end

local function buildFunnel(parent: Instance)
	local funnel = Instance.new("Model")
	funnel.Name = "Funnel"
	funnel.Parent = parent
	local a, d = FUNNEL_AT[1], FUNNEL_AT[4]
	local function world(p: Vector3): Vector3
		return at(p.X, p.Y, p.Z)
	end
	local function normal(x: number, v: number, side: number): Vector3
		local du = world(funnelPoint(x + 0.2, v, side)) - world(funnelPoint(x - 0.2, v, side))
		local dv = world(funnelPoint(x, v + 0.02, side)) - world(funnelPoint(x, v - 0.02, side))
		local n = du:Cross(dv)
		if n.Magnitude < 1e-6 then
			return Vector3.yAxis
		end
		n = n.Unit
		return if n.Z * side < 0 then -n else n
	end
	local SPANS = 28
	local function station(i: number): number
		return a + (d - a) * i / SPANS
	end
	-- The height of the sail surface at station x for a given z, on one side
	local function surfaceY(x: number, z: number, side: number): number
		local zc = crest(x)
		local v = math.clamp((zc - z) / math.max(zc - FUNNEL_BASE, 0.01), 0, 1)
		return side * (CREST + (funnelHalf(x) - CREST) * v)
	end
	-- The forward and after ends of the slat at height z
	local function xRange(z: number): (number, number)
		local xf, xa
		for i = 0, 200 do
			local x = a + (d - a) * i / 200
			if crest(x) >= z then
				xf = xf or x
				xa = x
			end
		end
		return xf or a, xa or d
	end
	for _, side in { -1, 1 } do
		-- Horizontal louvres, clipped by the sloping forward and after edges of the sail
		for k = 0, 19 do
			local z = FUNNEL_BASE + 0.55 + (FUNNEL_TOP - 2.1 - FUNNEL_BASE - 0.55) * k / 19
			local xf, xa = xRange(z)
			local edge = k == 0 or k == 19
			local x = xf
			while x < xa - 0.2 do
				local x2 = math.min(x + 2.2, xa)
				local v = math.clamp((crest(x) - z) / math.max(crest(x) - FUNNEL_BASE, 0.01), 0.05, 0.95)
				strut(
					funnel,
					if edge then "FunnelRib" else "Slat",
					Vector3.new(x, surfaceY(x, z, side), z),
					Vector3.new(x2, surfaceY(x2, z, side), z),
					if edge then 0.45 else 0.16,
					if edge then 0.4 else 0.17,
					FUNNEL,
					nil,
					normal((x + x2) / 2, v, side)
				)
				x = x2
			end
		end
		-- Ribs fanning down across the slats, spreading away from the emblem
		for x = a + 5, d - 4, 5.5 do
			local split = 4
			for j = 0, split do
				local v0, v1 = j / (split + 1), (j + 1) / (split + 1)
				strut(
					funnel,
					"FunnelRib",
					funnelPoint(x + (x - 264) * 0.1 * v0, v0, side),
					funnelPoint(x + (x - 264) * 0.1 * v1, v1, side),
					0.3,
					0.32,
					FUNNEL
				)
			end
		end
		-- Solid plating behind the slats under the emblem
		local cells, rows = 9, 5
		local function inner(i: number, j: number): Vector3
			local x, v = 254 + 22 * i / cells, 0.12 + 0.76 * j / rows
			return world(funnelPoint(x, v, side)) - normal(x, v, side) * 0.28 * STUDS
		end
		for i = 0, cells - 1 do
			for j = 0, rows - 1 do
				local outward = normal(254 + 22 * (i + 0.5) / cells, 0.12 + 0.76 * (j + 0.5) / rows, side)
				triangle(funnel, "FunnelPlating", inner(i, j), inner(i + 1, j), inner(i, j + 1), outward, 0.2, FUNNEL)
				triangle(
					funnel,
					"FunnelPlating",
					inner(i + 1, j),
					inner(i + 1, j + 1),
					inner(i, j + 1),
					outward,
					0.2,
					FUNNEL
				)
			end
		end
		-- The compass emblem in the middle of the plating
		local emblemX, emblemV = 260, 0.5
		local n = normal(emblemX, emblemV, side)
		local up = (Vector3.yAxis - n * Vector3.yAxis:Dot(n)).Unit
		star(
			funnel,
			world(funnelPoint(emblemX, emblemV, side)) + n * 0.7 * STUDS,
			n,
			up,
			3.8,
			WHITE,
			WHITE,
			FUNNEL
		)
	end
	-- A white structural beam down the leading edge, as on the real funnel
	for _, side in { -1, 1 } do
		strut(
			funnel,
			"FunnelEdge",
			Vector3.new(FUNNEL_AT[1], side * funnelHalf(FUNNEL_AT[1]), FUNNEL_BASE),
			Vector3.new(FUNNEL_AT[2], side * CREST, crest(FUNNEL_AT[2])),
			0.35,
			0.4,
			WHITE
		)
	end
	-- A narrow navy cap along the crest
	for i = 0, SPANS - 1 do
		local z0, z1 = crest(station(i)), crest(station(i + 1))
		strut(
			funnel,
			"FunnelRib",
			Vector3.new(station(i), 0, z0 + 0.15),
			Vector3.new(station(i + 1), 0, z1 + 0.15),
			2 * CREST + 0.45,
			0.45,
			FUNNEL,
			nil,
			Vector3.yAxis
		)
	end
	-- Eight stacks in four pairs along the crest, splaying and leaning aft, sooty at the top
	for i, x in { 256, 262.5, 269, 275.5 } do
		for _, y in { -1.15, 1.15 } do
			local baseZ = crest(x) - 0.9
			local base = Vector3.new(x, y, baseZ)
			local top = base + Vector3.new(2.4, y * 0.55, (if i == 3 or i == 4 then 60.9 else 60.4) - baseZ)
			tube(funnel, "ExhaustStack", base, top, 1.85, STEEL, M.Metal)
			local dir = top - base
			tube(funnel, "ExhaustStack", top - dir * 0.06, top + dir * 0.03, 1.9, SOOT, M.Metal)
		end
	end
	-- A white rail around the foot of the funnel, tying it to the Top 18 deck
	for _, side in { -1, 1 } do
		sideBox(funnel, "FunnelBaseRail", 246, 287, side * 9.4, side * 9.6, FUNNEL_BASE, FUNNEL_BASE + 0.9, WHITE)
	end
	return funnel
end

-- A smooth curve through ship-coordinate points (Catmull-Rom), `steps` samples per span
local function spline(points: { Vector3 }, steps: number): { Vector3 }
	local out = {}
	for i = 1, #points - 1 do
		local p0, p1, p2 = points[math.max(i - 1, 1)], points[i], points[i + 1]
		local p3 = points[math.min(i + 2, #points)]
		for s = 0, steps - 1 do
			local t = s / steps
			table.insert(
				out,
				0.5
					* (
						2 * p1
						+ (p2 - p0) * t
						+ (2 * p0 - 5 * p1 + 4 * p2 - p3) * (t * t)
						+ (3 * p1 - p0 - 3 * p2 + p3) * (t * t * t)
					)
			)
		end
	end
	table.insert(out, points[#points])
	return out
end

-- An open white tower up to a slide start platform at `start`, landings every 2.4 m
local function slideTower(parent: Instance, start: Vector3)
	local floor = floorAt(start.X, start.Y) or ROOF
	for _, corner in { { -1.4, -1.4 }, { -1.4, 1.4 }, { 1.4, -1.4 }, { 1.4, 1.4 } } do
		local x, y = start.X + corner[1], start.Y + corner[2]
		box(parent, "SlideTower", x - 0.15, x + 0.15, y - 0.15, y + 0.15, floor, start.Z + 0.4, WHITE)
	end
	for z = floor + 2.4, start.Z - 1.5, 2.4 do
		box(parent, "SlideTower", start.X - 1.55, start.X + 1.55, start.Y - 1.55, start.Y + 1.55, z, z + 0.2, WHITE)
	end
	box(
		parent,
		"SlidePlatform",
		start.X - 1.6,
		start.X + 1.6,
		start.Y - 1.6,
		start.Y + 1.6,
		start.Z - 0.9,
		start.Z - 0.7,
		WHITE
	)
end

-- A navy water slide tube along a path, on posts down to the decks
local function slide(parent: Instance, path: { Vector3 })
	local curve = spline(path, 6)
	for i = 1, #curve - 1 do
		tube(parent, "WaterSlide", curve[i], curve[i + 1], 1.3, FUNNEL)
		local p = curve[i]
		local below = floorAt(p.X, p.Y)
		if i % 7 == 4 and below and p.Z - below > 1.2 then
			strut(parent, "SlidePost", Vector3.new(p.X, p.Y, p.Z - 0.6), Vector3.new(p.X, p.Y, below), 0.3, 0.3, WHITE)
		end
	end
end

-- Rows of sun loungers either side of the centre line, one row `rows[i]` out from it
local function loungers(parent: Instance, x0: number, x1: number, rows: { number }, z: number)
	for x = x0, x1, 1.25 do
		for _, y in rows do
			for _, side in { -1, 1 } do
				box(parent, "Lounger", x - 0.35, x + 0.35, side * y - 0.95, side * y + 0.95, z, z + 0.35, WHITE)
			end
		end
	end
end

-- Midships between the Yacht Club and the funnel block, deck 15 is the enclosed La Playa
-- Preziosa: long windows outside, an atrium over the indoor pools, and on its roof a sun deck round
-- the sliding glass roof (magrodome) over the atrium. Panoramic lifts climb the front of the
-- funnel block behind it.
local LIDO = { 117, 202 }
local ATRIUM = { 150, 197, 12 } -- from, to, half-breadth
local function buildLido(parent: Instance)
	local lido = Instance.new("Model")
	lido.Name = "La Playa"
	lido.Parent = parent
	local outline = clip(PLAN[15][1], LIDO[1], LIDO[2])
	local z0, z1 = FLOOR[15], FLOOR[16]
	local x0, x1, inner = ATRIUM[1], ATRIUM[2], ATRIUM[3]
	local outer = sample(outline, (x0 + x1) / 2)

	-- The ring of rooms round the atrium: long windows outside, gallery windows inside
	slab(lido, "Wall", clip(outline, LIDO[1], x0), z0, z1, WHITE)
	slab(lido, "Wall", clip(outline, x1, LIDO[2]), z0, z1, WHITE)
	for _, side in { -1, 1 } do
		sideBox(lido, "Wall", x0, x1, side * inner, side * outer, z0, z1, WHITE)
		sideBox(lido, "Windows", x0 + 1, x1 - 1, side * (inner - 0.06), side * inner, z0 + 0.9, z1 - 0.5, GLASS)
	end
	for a = LIDO[1] + 0.6, LIDO[2] - 2, 13.5 do
		local pane = clip(outline, a + 0.75, math.min(a + 12.75, LIDO[2] - 0.6))
		if #pane > 1 then
			slab(lido, "Windows", widen(pane, 0.06), z0 + 0.9, z1 - 0.7, GLASS)
		end
	end

	-- The sun deck round the dome (the Yacht Club block covers the roof forward of x 146)
	local deck = widen(clip(outline, 146, LIDO[2]), -0.3)
	slab(lido, "SunDeck", clip(deck, 146, x0), z1 - 0.05, z1 + 0.05, TEAK, M.WoodPlanks)
	slab(lido, "SunDeck", clip(deck, x1, LIDO[2]), z1 - 0.05, z1 + 0.05, TEAK, M.WoodPlanks)
	for _, side in { -1, 1 } do
		sideBox(
			lido,
			"SunDeck",
			x0,
			x1,
			side * (inner + 0.3),
			side * (outer - 0.3),
			z1 - 0.05,
			z1 + 0.05,
			TEAK,
			M.WoodPlanks
		)
		sideBox(lido, "DomeCurb", x0, x1, side * (inner - 0.1), side * (inner + 0.3), z1, z1 + 0.45, WHITE)
	end
	edges(lido, "DeckRail", deck, z1, 1.1, RAIL, M.Glass, 0.5)
	loungers(lido, x0 + 2, x1 - 2, { (inner + outer) / 2 }, z1 + 0.05)

	-- The magrodome: a low glass vault on white ribs, glazed at both ends
	local span, rise = inner + 0.1, 4.2
	local function vault(j: number): Vector3
		local t = math.pi * j / 8
		return Vector3.new(0, -span * math.cos(t), z1 + 0.55 + rise * math.sin(t))
	end
	for j = 0, 7 do
		local p, q = vault(j), vault(j + 1)
		local mid = (p + q) / 2
		local chord = q - p
		local pane = strut(
			lido,
			"Magrodome",
			Vector3.new(x0, mid.Y, mid.Z),
			Vector3.new(x1, mid.Y, mid.Z),
			chord.Magnitude,
			0.08,
			RAIL,
			M.Glass,
			Vector3.new(0, chord.Y, -chord.Z)
		)
		if pane then
			pane.Transparency = 0.4
			pane.CastShadow = false
		end
		for _, x in (if math.min(p.Z, q.Z) > z1 + 0.65 then { x0, x1 } else {}) do
			local gable =
				sideBox(lido, "Magrodome", x - 0.05, x + 0.05, p.Y, q.Y, z1 + 0.55, math.min(p.Z, q.Z), RAIL, M.Glass)
			gable.Transparency = 0.4
			gable.CastShadow = false
		end
	end
	for x = x0, x1 + 0.01, (x1 - x0) / 12 do
		for j = 0, 7 do
			local p, q = vault(j), vault(j + 1)
			strut(lido, "DomeRib", Vector3.new(x, p.Y, p.Z), Vector3.new(x, q.Y, q.Z), 0.25, 0.3, WHITE)
		end
	end
	local crown = vault(4)
	box(lido, "DomeRib", x0, x1, -0.2, 0.2, crown.Z, crown.Z + 0.3, WHITE)

	-- Panoramic lifts in glass towers on the front of the funnel block
	for _, side in { -1, 1 } do
		local shaft = sideBox(lido, "PanoramicLift", 198.5, 202.5, side * 5, side * 9, z1, ROOF + 1.1, RAIL, M.Glass)
		shaft.Transparency = 0.3
		for _, x in { 198.5, 202.5 } do
			for _, y in { 5, 9 } do
				sideBox(
					lido,
					"LiftFrame",
					x - 0.15,
					x + 0.15,
					side * (y - 0.15),
					side * (y + 0.15),
					z1,
					ROOF + 1.3,
					WHITE
				)
			end
		end
		for z = z1 + 3, ROOF + 1, 3 do
			sideBox(lido, "LiftFrame", 198.35, 202.65, side * 4.85, side * 9.15, z, z + 0.2, WHITE)
		end
	end
	return lido
end

-- The Yacht Club's open top deck: The One Pool and whirlpools behind the Top Sail Lounge, ringed
-- by a glass windbreak on the roof of the club's two cabin decks
local function buildYachtClubTop(parent: Instance)
	local club = Instance.new("Model")
	club.Name = "Yacht Club Sun Deck"
	club.Parent = parent
	local roof = widen(clip(PLAN[16][1], 58, 146), -0.25)
	slab(club, "SunDeck", roof, FLOOR[18] - 0.05, FLOOR[18] + 0.05, TEAK, M.WoodPlanks)
	edges(club, "DeckRail", roof, FLOOR[18], 1.15, RAIL, M.Glass, 0.5)
	-- The One Pool
	box(club, "PoolRim", 82.4, 102.6, -6.2, 6.2, FLOOR[18], FLOOR[18] + 0.32, WHITE)
	box(club, "Pool", 83, 102, -5.6, 5.6, FLOOR[18] + 0.32, FLOOR[18] + 0.4, POOL)
	-- Two whirlpools either side of the pool, and The One Bar aft of it
	for _, side in { -1, 1 } do
		tube(
			club,
			"Whirlpool",
			Vector3.new(111, side * 8.2, FLOOR[18]),
			Vector3.new(111, side * 8.2, FLOOR[18] + 0.55),
			3.0,
			WHITE
		)
		tube(
			club,
			"Whirlpool",
			Vector3.new(111, side * 8.2, FLOOR[18] + 0.3),
			Vector3.new(111, side * 8.2, FLOOR[18] + 0.62),
			2.4,
			POOL
		)
	end
	box(club, "BarCounter", 119, 131, -3.6, 3.6, FLOOR[18], FLOOR[18] + 1.1, WHITE)
	for _, post in { { 119.2, -3.4 }, { 130.8, -3.4 }, { 119.2, 3.4 }, { 130.8, 3.4 } } do
		box(
			club,
			"BarPost",
			post[1] - 0.12,
			post[1] + 0.12,
			post[2] - 0.12,
			post[2] + 0.12,
			FLOOR[18],
			FLOOR[18] + 2.9,
			WHITE
		)
	end
	box(club, "BarCanopy", 118.4, 131.6, -4.2, 4.2, FLOOR[18] + 2.9, FLOOR[18] + 3.1, WHITE)
	loungers(club, 104, 116, { 12.5 }, FLOOR[18] + 0.05)
	loungers(club, 134, 143, { 6.5, 11, 15 }, FLOOR[18] + 0.05)

	-- The Top Sail Lounge: a rounded white and glass crown at the forward end of the deck, its
	-- dark glazing rising above the pool deck
	local crown = widen(clip(PLAN[16][1], 60, 78), -0.45)
	slab(club, "TopSailLounge", crown, FLOOR[18], FLOOR[18] + 4.0, WHITE)
	glazing(club, "LoungeGlass", crown, FLOOR[18] + 0.6, FLOOR[18] + 3.7)
	mullions(club, widen(crown, 0.1), FLOOR[18] + 0.6, FLOOR[18] + 3.7, 1.5, true)
	slab(club, "LoungeRoof", widen(crown, 0.55), FLOOR[18] + 4.0, FLOOR[18] + 4.3, WHITE)
	edges(club, "LoungeRail", widen(crown, 0.1), FLOOR[18] + 4.3, 0.85, RAIL, M.Glass, 0.5)
	-- Close the lounge's after face over the pool deck
	local crownEnd = crown[#crown]
	box(
		club,
		"LoungeWall",
		crownEnd[1] - 0.2,
		crownEnd[1] + 0.05,
		-crownEnd[2],
		crownEnd[2],
		FLOOR[18],
		FLOOR[18] + 4.0,
		WHITE
	)
	box(
		club,
		"LoungeGlass",
		crownEnd[1] - 0.1,
		crownEnd[1] + 0.1,
		-crownEnd[2] + 0.5,
		crownEnd[2] - 0.5,
		FLOOR[18] + 0.6,
		FLOOR[18] + 3.7,
		GLASS,
		M.Glass
	)
	return club
end

-- A rounded silhouette for the funnel casing and the Top 18 platform
local CASING = { { 238, 8.6 }, { 241, 10.2 }, { 285, 10.2 }, { 288, 8.2 } }
local TOP18 = {
	{ 238, 5.6 },
	{ 240, 8.8 },
	{ 244, 11.3 },
	{ 250, 12.4 },
	{ 282, 12.4 },
	{ 286, 10.8 },
	{ 290, 7.4 },
	{ 292, 4.6 },
}

-- The aft top of the ship: the round Galaxy/Sky & Stars pavilion over the stern-facing terraces,
-- its roof carrying the Top 18 solarium and the funnel, and the open deck 16 solarium, bar and
-- children's aqua park aft of it
local function buildAftTop(parent: Instance)
	local aft = Instance.new("Model")
	aft.Name = "Aft Sun Decks"
	aft.Parent = parent
	local floor16, roof = FLOOR[16], FLOOR[18]
	local deck16 = clip(PLAN[16][2], 202, 316)
	local pav = clip(PLAN[16][2], 202, 240)

	-- The open deck 16 roof over the Garden terraces, with its white bulwark and glass windbreak
	slab(aft, "Solarium", widen(deck16, -0.2), floor16 - 0.06, floor16 + 0.04, TEAK, M.WoodPlanks)
	edges(aft, "Bulwark", widen(deck16, -0.25), floor16, 1.15, WHITE, M.SmoothPlastic, 0)
	edges(aft, "DeckRail", widen(deck16, -0.25), floor16 + 1.15, 1.0, RAIL, M.Glass, 0.5)

	-- The Galaxy Restaurant / Sky & Stars pavilion: two storeys of dark panoramic glazing with
	-- white piers, under a white overhanging roof
	slab(aft, "Pavilion", pav, floor16, roof + 0.55, WHITE)
	for _, band in { { floor16 + 0.65, floor16 + 1.55 }, { floor16 + 1.9, floor16 + 2.9 } } do
		glazing(aft, "PavilionGlass", pav, band[1], band[2])
		mullions(aft, widen(pav, 0.1), band[1], band[2], 1.8, true)
	end
	slab(aft, "PavilionRoof", widen(pav, 0.6), roof + 0.55, roof + 0.85, WHITE)
	edges(aft, "RoofRail", widen(pav, 0.1), roof + 0.85, 0.9, RAIL, M.Glass, 0.5)
	-- The Galaxy roof is an open teak terrace with a glazed skylight over the restaurant
	slab(aft, "PavilionSunDeck", widen(pav, -1.2), roof + 0.85, roof + 0.95, TEAK, M.WoodPlanks)
	box(aft, "PavilionSkylight", 212, 226, -5, 5, roof + 0.85, roof + 0.98, TINTED, M.Glass)
	loungers(aft, 206, 236, { 6, 10 }, roof + 0.95)

	-- Close the pavilion's after face against the funnel casing
	local pavEnd = pav[#pav]
	box(aft, "PavilionWall", pavEnd[1] - 0.2, pavEnd[1] + 0.05, -pavEnd[2], pavEnd[2], floor16, roof + 0.55, WHITE)
	-- White casing below the Top 18 platform, with a dark glazed band
	slab(aft, "FunnelCasing", CASING, floor16, roof, WHITE)
	box(aft, "CasingEnd", 238 - 0.2, 238 + 0.05, -8.6, 8.6, floor16, roof, WHITE)
	box(aft, "CasingEnd", 288 - 0.2, 288 + 0.05, -8.2, 8.2, floor16, roof, WHITE)
	for _, side in { -1, 1 } do
		sideBox(aft, "CasingWindows", 242, 284, side * 10.05, side * 10.25, floor16 + 0.8, floor16 + 2.1, GLASS)
		for x = 244, 282, 2.6 do
			sideBox(
				aft,
				"CasingMullion",
				x - 0.08,
				x + 0.08,
				side * 10.18,
				side * 10.34,
				floor16 + 0.8,
				floor16 + 2.1,
				WHITE
			)
		end
	end

	-- The Top 18 solarium round the funnel, with two whirlpools and rows of loungers
	slab(aft, "Top18", widen(TOP18, -0.15), roof - 0.05, roof + 0.05, TEAK, M.WoodPlanks)
	edges(aft, "Top18Bulwark", widen(TOP18, -0.2), roof - 0.2, 0.4, WHITE, M.SmoothPlastic, 0)
	edges(aft, "Top18Rail", widen(TOP18, -0.2), roof + 0.2, 1.05, RAIL, M.Glass, 0.5)
	for _, side in { -1, 1 } do
		tube(
			aft,
			"Whirlpool",
			Vector3.new(278, side * 10.5, roof),
			Vector3.new(278, side * 10.5, roof + 0.55),
			2.6,
			WHITE
		)
		tube(
			aft,
			"Whirlpool",
			Vector3.new(278, side * 10.5, roof + 0.3),
			Vector3.new(278, side * 10.5, roof + 0.62),
			2.1,
			POOL
		)
	end
	loungers(aft, 246, 266, { 11.2 }, roof + 0.05)

	-- Doremi Castle water play on deck 16 (port aft), with the Brezza Marina bar and hot tubs
	local floor = floor16
	box(aft, "AquaPark", 293, 309, -9.2, -1.4, floor, floor + 0.12, rgb(86, 164, 224))
	box(aft, "AquaPark", 294.5, 307.5, -8.7, -2.1, floor + 0.12, floor + 0.17, rgb(236, 242, 246))
	for _, post in { { 296, -7.6 }, { 296, -3.2 }, { 303, -7.6 }, { 303, -3.2 } } do
		box(
			aft,
			"AquaPark",
			post[1] - 0.18,
			post[1] + 0.18,
			post[2] - 0.18,
			post[2] + 0.18,
			floor,
			floor + 4.2,
			rgb(250, 202, 40)
		)
	end
	box(aft, "AquaPark", 295.7, 303.4, -7.9, -2.9, floor + 1.9, floor + 2.15, rgb(250, 202, 40))
	box(aft, "AquaPark", 295.4, 298.7, -8.1, -5.6, floor + 4.2, floor + 5.0, rgb(140, 70, 170))
	box(aft, "AquaPark", 300.4, 303.6, -5.2, -2.8, floor + 4.2, floor + 5.0, rgb(66, 170, 88))
	box(aft, "AquaPark", 305, 307.4, -4.6, -2.6, floor, floor + 1.7, rgb(248, 136, 36))
	tube(
		aft,
		"AquaPark",
		Vector3.new(300, -2.4, floor + 3.4),
		Vector3.new(300, -2.4, floor + 4.4),
		2.0,
		rgb(250, 202, 40)
	)
	for _, y in { -7.2, -6.0 } do
		strut(
			aft,
			"AquaPark",
			Vector3.new(303.4, y, floor + 2.0),
			Vector3.new(308.8, y, floor + 0.25),
			0.9,
			0.28,
			rgb(216, 40, 40)
		)
	end
	-- Brezza Marina bar and two starboard hot tubs
	box(aft, "BarCounter", 295, 307, 2.8, 8.2, floor, floor + 1.0, WHITE)
	box(aft, "BarCanopy", 294.5, 307.5, 2.3, 8.7, floor + 2.8, floor + 3.0, WHITE)
	for _, post in { { 295.2, 3 }, { 306.8, 3 }, { 295.2, 8 }, { 306.8, 8 } } do
		box(aft, "BarPost", post[1] - 0.12, post[1] + 0.12, post[2] - 0.12, post[2] + 0.12, floor, floor + 2.8, WHITE)
	end
	for _, side in { -1, 1 } do
		tube(
			aft,
			"Whirlpool",
			Vector3.new(311, side * 5.8, floor),
			Vector3.new(311, side * 5.8, floor + 0.5),
			2.4,
			WHITE
		)
		tube(
			aft,
			"Whirlpool",
			Vector3.new(311, side * 5.8, floor + 0.28),
			Vector3.new(311, side * 5.8, floor + 0.56),
			1.9,
			POOL
		)
	end
	loungers(aft, 310, 314, { 10.5 }, floor + 0.05)

	-- Big blue slides from a tower behind the funnel down to the Garden Pool, and a short one into
	-- the children's aqua park
	local tower = Vector3.new(298, -5.5, 49.2)
	slideTower(aft, tower)
	slide(aft, {
		tower,
		Vector3.new(304, -9.2, 48.2),
		Vector3.new(312, -11, 46.4),
		Vector3.new(318, -9.6, 43.8),
		Vector3.new(322, -7.2, 41.4),
		Vector3.new(323.5, -5.2, 39.8),
	})
	slide(aft, {
		tower,
		Vector3.new(295, -7.4, 48.4),
		Vector3.new(291, -8.4, 46.2),
		Vector3.new(290.5, -6.4, 44.0),
		Vector3.new(292.5, -5.2, 42.6),
	})
	return aft
end

-- The Yacht Club's Garden at the stern of deck 15: La Palmeraie restaurant forward, then the
-- infinity-edge Garden Pool in a teak terrace enclosed by a white bulwark and a glass windbreak
local function buildGarden(parent: Instance)
	local garden = Instance.new("Model")
	garden.Name = "The Garden"
	garden.Parent = parent
	local floor = FLOOR[15]
	local deck = widen(clip(PLAN[15][1], 296, 334), -0.2)
	slab(garden, "GardenDeck", deck, floor - 0.05, floor + 0.05, TEAK, M.WoodPlanks)
	edges(garden, "GardenBulwark", widen(deck, -0.15), floor, 1.15, WHITE, M.SmoothPlastic, 0)
	edges(garden, "GardenGlass", widen(deck, -0.15), floor + 1.15, 1.0, RAIL, M.Glass, 0.55)

	-- La Palmeraie, the Yacht Club's dedicated restaurant, under a white overhanging roof
	local rest = widen(clip(PLAN[15][1], 300, 313), -0.55)
	slab(garden, "LaPalmeraie", rest, floor, floor + 2.7, WHITE)
	for _, band in { { floor + 0.55, floor + 1.45 }, { floor + 1.75, floor + 2.55 } } do
		glazing(garden, "RestaurantGlass", rest, band[1], band[2])
		mullions(garden, widen(rest, 0.1), band[1], band[2], 1.9, true)
	end
	slab(garden, "RestaurantRoof", widen(rest, 0.55), floor + 2.7, floor + 3.0, WHITE)
	edges(garden, "RoofRail", widen(rest, 0.1), floor + 3.0, 0.9, RAIL, M.Glass, 0.5)
	slab(garden, "RestaurantSunDeck", widen(rest, -0.7), floor + 3.0, floor + 3.05, TEAK, M.WoodPlanks)
	-- Close the restaurant's after face over the Garden Pool
	local restEnd = rest[#rest]
	box(
		garden,
		"RestaurantWall",
		restEnd[1] - 0.2,
		restEnd[1] + 0.05,
		-restEnd[2],
		restEnd[2],
		floor,
		floor + 2.7,
		WHITE
	)
	box(
		garden,
		"RestaurantGlass",
		restEnd[1] - 0.1,
		restEnd[1] + 0.1,
		-restEnd[2] + 0.4,
		restEnd[2] - 0.4,
		floor + 0.55,
		floor + 2.55,
		GLASS,
		M.Glass
	)

	-- The Garden Pool, with a white rim and loungers on the teak round it
	box(garden, "PoolRim", 316.5, 330.5, -6.2, 6.2, floor, floor + 0.32, WHITE)
	box(garden, "Pool", 317.1, 329.9, -5.6, 5.6, floor + 0.32, floor + 0.4, POOL)
	loungers(garden, 318, 327, { 8.4 }, floor + 0.05)
	for _, side in { -1, 1 } do
		for _, x in { 303, 309, 315, 321, 327 } do
			box(
				garden,
				"Planter",
				x - 0.6,
				x + 0.6,
				side * 9.2 - 0.6,
				side * 9.2 + 0.6,
				floor,
				floor + 0.75,
				rgb(54, 112, 62)
			)
		end
	end
	-- The Garden Bar on the port side of the pool
	box(garden, "BarCounter", 314, 318, -10.2, -6.8, floor, floor + 1.0, WHITE)
	box(garden, "BarCanopy", 313.4, 318.6, -10.8, -6.2, floor + 2.7, floor + 2.9, WHITE)
	for _, post in { { 314.2, -9.9 }, { 317.8, -9.9 }, { 314.2, -7.1 }, { 317.8, -7.1 } } do
		box(
			garden,
			"BarPost",
			post[1] - 0.12,
			post[1] + 0.12,
			post[2] - 0.12,
			post[2] + 0.12,
			floor,
			floor + 2.7,
			WHITE
		)
	end
	return garden
end

local function buildTop(parent: Instance)
	local top = Instance.new("Model")
	top.Name = "Superstructure"
	top.Parent = parent

	-- The foredeck over the mooring deck, with its bulwark
	local foredeck = clip(PLAN[8][1], 0, 31)
	slab(top, "Foredeck", foredeck, FLOOR[9], FLOOR[9] + 0.1, MOORING)
	edges(top, "Bulwark", foredeck, FLOOR[9], 1.2, WHITE, M.SmoothPlastic, 0)
	box(top, "Jackstaff", 1.4, 1.7, -0.15, 0.15, FLOOR[9], FLOOR[9] + 7, WHITE)

	-- Teak over deck 14, and the glass rails round the open pool deck
	slab(top, "PoolDeck", widen(DECK14, -0.05), FLOOR[15] - 0.05, FLOOR[15] + 0.05, TEAK, M.WoodPlanks)
	edges(top, "DeckRail", PLAN[15][1], FLOOR[15], 1.2, RAIL, M.Glass, 0.5)

	-- The two indoor pools under the magrodome of La Playa Preziosa
	for _, pool in { { 158, 174, 5 }, { 181, 196, 4 } } do
		box(
			top,
			"PoolRim",
			pool[1] - 0.6,
			pool[2] + 0.6,
			-pool[3] - 0.6,
			pool[3] + 0.6,
			FLOOR[15],
			FLOOR[15] + 0.25,
			WHITE
		)
		box(top, "Pool", pool[1], pool[2], -pool[3], pool[3], FLOOR[15] + 0.25, FLOOR[15] + 0.3, POOL)
	end
	buildLido(top)
	buildYachtClubTop(top)
	buildAftTop(top)
	buildGarden(top)

	-- Brackets under deck 14 where it overhangs the lifeboats, one between each pair of boats
	for i = -1, 11 do
		local x = 124 + (i + 0.5) * 13.3
		if x > 118.5 and x < 275.5 then
			for _, side in { -1, 1 } do
				strut(
					top,
					"Bracket",
					Vector3.new(x, side * (sample(PLAN[12][1], x) - 0.1), FLOOR[12] + 0.2),
					Vector3.new(x, side * 17.5, FLOOR[14] - 0.05),
					0.3,
					0.45,
					WHITE
				)
			end
		end
	end
	for _, side in { -1, 1 } do
		sideBox(top, "EdgeGirder", 117, 283, side * 17.2, side * 17.8, FLOOR[14] - 0.55, FLOOR[14], WHITE)
	end

	-- Radomes on the Yacht Club roof and the Galaxy roof
	for _, dome in { { 92, -14, 4.8 }, { 92, 14, 4.8 }, { 104, -6, 3.6 }, { 104, 6, 3.6 }, { 210, 11, 4.6 } } do
		local base = if dome[1] > 200 then FLOOR[18] + 0.85 else FLOOR[18]
		part(
			top,
			"Radome",
			Vector3.one * dome[3] * STUDS,
			CFrame.new(at(dome[1], dome[2], base + 0.4 + dome[3] / 2)),
			WHITE,
			M.SmoothPlastic
		).Shape =
			Enum.PartType.Ball
		box(top, "RadomeBase", dome[1] - 1, dome[1] + 1, dome[2] - 1, dome[2] + 1, base, base + 0.6, WHITE)
	end

	buildBridge(top)
	buildMast(top)
	buildFunnel(top)
	return top
end

-- An enclosed lifeboat (orange canopy over a white hull, red helm position aft) or, for the
-- tenders, a white boat with a band of cabin windows under a red-orange roof, hanging from two
-- davits
local function lifeboat(parent: Instance, x: number, side: number, tender: boolean)
	local length, beam = if tender then 12.6 else 10.8, if tender then 4.4 else 4.0
	local y, half = side * 18.4, beam / 2
	local bow = x - length / 2
	local function outline(inset: number)
		local h = half - inset
		return {
			{ bow + 0.2 + inset * 1.5, h * 0.3 },
			{ bow + length * 0.2, h },
			{ bow + length * 0.85, h },
			{ bow + length - inset, h * 0.6 },
		}
	end
	local function station(f: number): number
		return bow + length * f
	end
	box(parent, "Keel", station(0.12), station(0.92), y - half * 0.45, y + half * 0.45, 13.7, 14.3, WHITE)
	slab(parent, "Hull", outline(0), 14.3, 15.4, WHITE, nil, y)
	for _, s in { -1, 1 } do
		sideBox(
			parent,
			"Fender",
			station(0.2),
			station(0.85),
			y + s * (half - 0.05),
			y + s * (half + 0.06),
			15.15,
			15.4,
			if tender then NAVY else HELM
		)
	end
	if tender then
		slab(parent, "Cabin", outline(0.25), 15.4, 16.9, WHITE, nil, y)
		slab(parent, "CabinWindows", outline(0.2), 15.9, 16.4, GLASS, nil, y)
		box(parent, "Roof", station(0.16), station(0.9), y - half + 0.7, y + half - 0.7, 16.9, 17.3, HELM)
		box(parent, "Helm", station(0.6), station(0.8), y - half * 0.4, y + half * 0.4, 17.3, 17.9, HELM)
		box(
			parent,
			"HelmWindows",
			station(0.6) - 0.04,
			station(0.8) + 0.04,
			y - half * 0.4 - 0.04,
			y + half * 0.4 + 0.04,
			17.5,
			17.75,
			GLASS
		)
	else
		slab(parent, "Canopy", outline(0.15), 15.4, 16.5, ORANGE, nil, y)
		box(parent, "Canopy", station(0.15), station(0.9), y - half + 0.6, y + half - 0.6, 16.5, 16.85, ORANGE)
		box(parent, "Helm", station(0.6), station(0.8), y - half * 0.45, y + half * 0.45, 16.5, 17.35, HELM)
		box(
			parent,
			"HelmWindows",
			station(0.6) - 0.04,
			station(0.8) + 0.04,
			y - half * 0.45 - 0.04,
			y + half * 0.45 + 0.04,
			16.95,
			17.2,
			GLASS
		)
		for _, s in { -1, 1 } do
			sideBox(
				parent,
				"Portlights",
				station(0.22),
				station(0.55),
				y + s * (half - 0.17),
				y + s * (half - 0.1),
				15.8,
				16.1,
				GLASS
			)
		end
	end
	-- Davits: posts against the promenade wall, arms reaching out over the boat, and the falls
	local roof = if tender then 17.9 else 17.35
	for _, f in { 0.22, 0.8 } do
		local xd = station(f)
		sideBox(parent, "Davit", xd - 0.18, xd + 0.18, side * 16, side * 16.3, FLOOR[7], 18.9, WHITE)
		local tip = Vector3.new(xd, y, 18.4)
		strut(parent, "Davit", Vector3.new(xd, side * 16.15, 18.9), tip, 0.3, 0.35, WHITE)
		strut(parent, "Fall", tip, Vector3.new(xd, y, roof), 0.05, 0.05, SOOT)
	end
end

local function buildLifeboats(parent: Instance)
	local boats = Instance.new("Model")
	boats.Name = "Lifeboats"
	boats.Parent = parent
	-- Twelve boats a side hang in the deck 7 recess; the three aftmost are the larger tenders
	for i = 0, 11 do
		for _, side in { -1, 1 } do
			lifeboat(boats, 124 + i * 13.3, side, i >= 9)
		end
	end
	return boats
end

function MscPreziosa.build(parent: Instance, position: Vector3, yield: (() -> ())?): Model
	origin = position
	built = 0
	pause = yield or task.wait
	resumed = os.clock()
	local ship = Instance.new("Model")
	ship.Name = "MSC Preziosa"

	buildHull(ship)
	pause()
	local tops = { 9, 10, 11, 12, 13, 14, 15, 16 }
	buildDeck(ship, 8, FLOOR[9], PLAN[8])
	for i, deck in tops do
		local top = if tops[i + 1] then FLOOR[tops[i + 1]] else FLOOR[18]
		local pieces = PLAN[deck]
		if deck == 14 then
			pieces = { DECK14 }
		elseif deck == 15 then
			-- Deck 15 is open around two enclosed blocks: the Yacht Club forward and the aft
			-- entertainment block, with the Yacht Club's Garden terrace opening to the stern
			pieces = { clip(PLAN[15][1], 51, 117), clip(PLAN[16][2], 202, 300) }
		elseif deck == 16 then
			-- The Yacht Club's upper cabins; the aft deck 16 is built as open deck above
			pieces = { PLAN[16][1] }
		end
		buildDeck(ship, deck, top, pieces)
		pause()
	end
	buildTop(ship)
	buildLifeboats(ship)
	buildLivery(ship)

	ship:SetAttribute("PartCount", built)
	ship.Parent = parent
	return ship
end

return MscPreziosa
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="205">
        <Properties>
          <string name="Name">MusselNetService</string>
          <string name="Source"><![CDATA[-- Mussel nets bought at Tide & Tackle are placed by the owner's dock. The server
-- saves their positions, timers and uses, and awards each harvest atomically.
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AnglerData = require(script.Parent.AnglerData)
local BoatService = require(script.Parent.BoatService)
local GamepassService = require(script.Parent.GamepassService)
local Props = require(script.Parent.Map.Props)
local BackpackCatalog = require(ReplicatedStorage.Shared.BackpackCatalog)
local Biomes = require(ReplicatedStorage.Shared.Biomes)
local Catalog = require(ReplicatedStorage.Shared.AnglerCatalog)
local MusselNets = require(ReplicatedStorage.Shared.MusselNets)
local DayNight = require(ReplicatedStorage.Shared.DayNight)
local FishCatch = require(ReplicatedStorage.Shared.FishCatch)
local FishModels = require(ReplicatedStorage.Shared.FishModels)
local FishMutations = require(ReplicatedStorage.Shared.FishMutations)
local MutationContext = require(ReplicatedStorage.Shared.MutationContext)
local StaffCatalog = require(ReplicatedStorage.Shared.StaffCatalog)
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))

local MusselNetService = {}
local BASE_TAG = "PlayerBase"
local OWNER_PROMPT_TAG = "ShopOwnerPrompt"
-- Placed cage models; the client bobs their floats.
local CAGE_TAG = "MusselNet"
local TOOL_ATTRIBUTE = "MusselNetTool"
local PROMPT_NAME = "PullMusselNetPrompt"
local TOOL_SCALE = 0.45
local READY = Color3.fromRGB(111, 202, 125)
local SOAKING = Color3.fromRGB(250, 214, 64)
local started = false
local update: RemoteEvent
local requests: { [Player]: number } = {}
local busy: { [Player]: boolean } = {}
local random = Random.new()

local function ownerOf(base: Model): Player?
	local userId = base:GetAttribute("OwnerUserId")
	return if type(userId) == "number" and userId ~= 0 then Players:GetPlayerByUserId(userId) else nil
end

local function baseOf(player: Player): Model?
	for _, base in CollectionService:GetTagged(BASE_TAG) do
		if base:GetAttribute("OwnerUserId") == player.UserId and base:IsA("Model") then
			return base
		end
	end
	return nil
end

local function dockFrame(base: Model): CFrame?
	local frame = base:GetAttribute("BoatDockFrame")
	return if typeof(frame) == "CFrame" then frame else nil
end

local function notify(player: Player, message: string)
	if player.Parent == Players and message ~= "" then
		update:FireClient(player, "Notice", message)
	end
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil
	end
	return root
end

local function formatSeconds(seconds: number): string
	return if seconds >= 60 then string.format("%d:%02d", seconds // 60, seconds % 60) else seconds .. "s"
end

-- The cage's base sits under the water so its float rides on the surface. The
-- client's placement preview builds the same frame. Every cage faces along the
-- dock; a per-spot turn made the preview spin as the pointer crossed spots.
local function cageFrame(dock: CFrame, x: number, z: number): CFrame
	local spot = dock * Vector3.new(x, 0, z)
	return CFrame.new(spot.X, Biomes.WaterLevel - Props.MUSSEL_NET_WATERLINE, spot.Z) * dock.Rotation
end

local function key(x: number, z: number): string
	return string.format("%.1f|%.1f", x, z)
end

-- A short burst of spray where a cage goes in or comes up.
local function splash(position: Vector3)
	local spray = Instance.new("Part")
	spray.Name = "MusselNetSplash"
	spray.Size = Vector3.one
	spray.Transparency, spray.Anchored = 1, true
	spray.CanCollide, spray.CanQuery, spray.CanTouch = false, false, false
	spray.CFrame = CFrame.new(position)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(Color3.fromRGB(222, 240, 246))
	emitter.Transparency = NumberSequence.new(0.15, 1)
	emitter.Size = NumberSequence.new(0.4, 0.1)
	emitter.Lifetime = NumberRange.new(0.5, 0.9)
	emitter.Speed = NumberRange.new(6, 11)
	emitter.SpreadAngle = Vector2.new(40, 40)
	emitter.Acceleration = Vector3.new(0, -32, 0)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Rate = 90
	emitter.Parent = spray
	spray.Parent = workspace
	task.delay(0.25, function()
		emitter.Rate = 0
	end)
	Debris:AddItem(spray, 2)
end

----------------------------------------------------------------------------------------------------
-- The hotbar cage

local function buildTool(): Tool
	local tool = Instance.new("Tool")
	tool.Name = "Mussel Net"
	tool.CanBeDropped = false
	tool.Grip = CFrame.Angles(0, math.rad(180), 0)
	tool:SetAttribute(TOOL_ATTRIBUTE, true)
	-- The client's placement preview sizes and sinks its copy of the cage with these.
	tool:SetAttribute("CageSize", Props.MUSSEL_NET_SIZE)
	tool:SetAttribute("CageScale", TOOL_SCALE)
	tool:SetAttribute("Waterline", Props.MUSSEL_NET_WATERLINE)
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.4, 0.4, 0.4)
	handle.Transparency = 1
	handle.CanCollide, handle.CanTouch, handle.CanQuery = false, false, false
	handle.Massless = true
	handle.Parent = tool
	local model = Props.musselNet(tool, CFrame.new(), false)
	model.Name = "CageModel"
	model:ScaleTo(TOOL_SCALE)
	-- Carried by the bridle, so the net hangs below the hand.
	handle.CFrame = CFrame.new(0, (Props.MUSSEL_NET_SIZE.Y + 0.47) * TOOL_SCALE, 0)
	for _, piece in model:GetDescendants() do
		if piece:IsA("BasePart") then
			piece.Anchored, piece.Massless = false, true
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1 = handle, piece
			weld.Parent = piece
		end
	end
	return tool
end

-- Keeps exactly one cage Tool while any cages are in stock; its name shows the count.
local function syncTool(player: Player)
	local profile = BoatService.getProfile(player)
	if not profile then
		return
	end
	local stock = profile.Angler.MusselNets.Stock
	local backpack = player:FindFirstChildOfClass("Backpack")
	local kept: Tool? = nil
	for _, container in { player.Character, backpack } do
		if not container then
			continue
		end
		for _, child in container:GetChildren() do
			if child:IsA("Tool") and child:GetAttribute(TOOL_ATTRIBUTE) then
				if stock > 0 and not kept then
					kept = child
				else
					child:Destroy()
				end
			end
		end
	end
	if stock > 0 and not kept and backpack then
		kept = buildTool()
		kept.Parent = backpack
	end
	if kept then
		kept.Name = if stock > 1 then string.format("Mussel Net x%d", stock) else "Mussel Net"
		kept.ToolTip = string.format("%d in stock · click the water by your dock to drop one", stock)
	end
end

local function holdingCage(player: Player): boolean
	local character = player.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	return tool ~= nil and tool:GetAttribute(TOOL_ATTRIBUTE) == true
end

----------------------------------------------------------------------------------------------------
-- Cages in the water

local function cageFolder(base: Model): Folder
	local folder = base:FindFirstChild("MusselNets")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "MusselNets"
		folder.Parent = base
	end
	return folder :: Folder
end

local function buildCage(folder: Folder, dock: CFrame, cage, userId: number): Model
	local frame = cageFrame(dock, cage.X, cage.Z)
	local model = Props.musselNet(folder, frame, true)
	model:SetAttribute("X", cage.X)
	model:SetAttribute("Z", cage.Z)
	model:SetAttribute("OwnerUserId", userId)
	model:SetAttribute("CageFrame", frame)
	local anchor = Instance.new("Part")
	anchor.Name = "CagePromptAnchor"
	anchor.Size = Vector3.one
	anchor.Transparency, anchor.Anchored = 1, true
	anchor.CanCollide, anchor.CanQuery, anchor.CanTouch = false, false, false
	anchor.CFrame = frame * CFrame.new(0, Props.MUSSEL_NET_WATERLINE + 0.6, 0)
	anchor.Parent = model
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = PROMPT_NAME
	prompt.ActionText = "Pull up"
	prompt.ObjectText = "Mussel Net"
	prompt.HoldDuration = 0.6
	-- Reaches down from the pier to anywhere the cage could have been dropped from it.
	prompt.MaxActivationDistance = MusselNets.REACH + 4
	prompt.RequiresLineOfSight = false
	prompt.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
	-- Owners' clients show it only while a crab is in (see ShopCustomers).
	prompt:SetAttribute("OwnerUserId", userId)
	prompt:SetAttribute("Available", false)
	CollectionService:AddTag(prompt, OWNER_PROMPT_TAG)
	prompt.Parent = anchor
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "CageStatus"
	billboard.Size = UDim2.fromOffset(200, 42)
	billboard.StudsOffset = Vector3.new(0, 1.8, 0)
	billboard.MaxDistance = 60
	billboard.Parent = anchor
	for _, row in { { "State", 0, 24, 16 }, { "Uses", 24, 18, 13 } } do
		local label = Instance.new("TextLabel")
		label.Name = row[1]
		label.Position, label.Size = UDim2.fromOffset(0, row[2]), UDim2.new(1, 0, 0, row[3])
		label.BackgroundTransparency = 1
		label.TextSize, label.Text = row[4], ""
		Theme.text(label)
		label.Parent = billboard
	end
	CollectionService:AddTag(model, CAGE_TAG)
	return model
end

-- The prompt, billboard and flag follow the saved net.
local function refreshCage(model: Model, cage, now: number)
	local remaining = MusselNets.remaining(cage, now)
	local ready = remaining <= 0
	local anchor = model:FindFirstChild("CagePromptAnchor")
	local prompt = anchor and anchor:FindFirstChild(PROMPT_NAME)
	if prompt then
		prompt:SetAttribute("Available", ready)
	end
	local billboard = anchor and anchor:FindFirstChild("CageStatus")
	local state = billboard and billboard:FindFirstChild("State") :: TextLabel?
	local uses = billboard and billboard:FindFirstChild("Uses") :: TextLabel?
	if state and uses then
		state.Text = if ready then "Ready to harvest!" else "Soaking · " .. formatSeconds(remaining)
		state.TextColor3 = if ready then READY else Theme.Colors.Text
		uses.Text = string.format("%d of %d hauls left", cage.Uses, MusselNets.USES)
	end
	if model:GetAttribute("Ready") == ready then
		return
	end
	model:SetAttribute("Ready", ready)
	local float = model:FindFirstChild("Float")
	local flag = float and float:FindFirstChild("Flag")
	if flag and flag:IsA("BasePart") then
		flag.Color = if ready then READY else SOAKING
	end
end

-- The owner's saved cages, decoded again only when their profile has changed:
-- the countdown below asks every second.
local placedCache: { [Player]: { revision: any, placed: { any }? } } = {}
local function placedOf(player: Player): { any }?
	local revision = player:GetAttribute("AnglerRevision")
	local cached = placedCache[player]
	if not cached or cached.revision ~= revision then
		local profile = BoatService.getProfile(player)
		cached = { revision = revision, placed = profile and profile.Angler.MusselNets.Placed }
		placedCache[player] = cached
	end
	return cached.placed
end

-- Matches the base's cage models to its owner's saved cages.
local function refreshBase(base: Model)
	local owner = ownerOf(base)
	local placed = owner and placedOf(owner)
	local dock = dockFrame(base)
	local wanted = {}
	if owner and placed and dock then
		for _, cage in placed do
			wanted[key(cage.X, cage.Z)] = cage
		end
	end
	local folder = base:FindFirstChild("MusselNets")
	if not folder and not next(wanted) then
		return
	end
	folder = folder or cageFolder(base)
	local now = os.time()
	local shown = {}
	for _, model in folder:GetChildren() do
		local x, z = model:GetAttribute("X"), model:GetAttribute("Z")
		local spot = if type(x) == "number" and type(z) == "number" then key(x, z) else ""
		local cage = wanted[spot]
		if model:IsA("Model") and cage and not shown[spot] and model:GetAttribute("OwnerUserId") == owner.UserId then
			shown[spot] = true
			refreshCage(model, cage, now)
		else
			model:Destroy()
		end
	end
	for spot, cage in wanted do
		if not shown[spot] then
			refreshCage(buildCage(folder, dock :: CFrame, cage, owner.UserId), cage, now)
		end
	end
end

local function refreshPlayer(player: Player)
	syncTool(player)
	local base = baseOf(player)
	if base then
		refreshBase(base)
	end
end

----------------------------------------------------------------------------------------------------
-- Dropping and pulling up

local function openWater(position: Vector3, ignore: { Instance }): boolean
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances = ignore
	parameters.IgnoreWater = false
	local result = workspace:Raycast(
		Vector3.new(position.X, Biomes.WaterLevel + 12, position.Z),
		Vector3.new(0, -24, 0),
		parameters
	)
	return result ~= nil and result.Instance == workspace.Terrain and result.Material == Enum.Material.Water
end

local function place(player: Player, target: any): (boolean, string)
	if
		typeof(target) ~= "Vector3"
		or target ~= target
		or math.abs(target.X) > 1e6
		or math.abs(target.Y) > 1e6
		or math.abs(target.Z) > 1e6
	then
		return false, ""
	end
	local profile = BoatService.getProfile(player)
	if not profile then
		return false, "Your progress is still loading. Try again in a moment."
	end
	local base = baseOf(player)
	local dock = base and dockFrame(base)
	if not base or not dock then
		return false, "You need a dock of your own to set mussel nets."
	end
	local root = rootOf(player)
	if not root or not holdingCage(player) then
		return false, "Equip a mussel net from your hotbar first."
	end
	local reach = target - root.Position
	if Vector3.new(reach.X, 0, reach.Z).Magnitude > MusselNets.REACH + 2 then
		return false, "That's too far away. Walk to the edge of your pier."
	end
	local spot = dock:PointToObjectSpace(target)
	local x, z = MusselNets.round(spot.X), MusselNets.round(spot.Z)
	local problem = MusselNets.placeProblem(profile.Angler, x, z)
	if problem then
		return false, problem
	end
	-- The whole footprint and the float must sit in open water, clear of piers,
	-- pilings, the quay and moored boats.
	local frame = cageFrame(dock, x, z)
	local ignore = {}
	for _, other in Players:GetPlayers() do
		if other.Character then
			table.insert(ignore, other.Character)
		end
	end
	for _, point in MusselNets.footprint(Props.MUSSEL_NET_SIZE) do
		if not openWater(frame * point, ignore) then
			return false, "Drop it into open water, clear of the piers."
		end
	end
	local now = os.time()
	local soak = MusselNets.soak(function()
		return random:NextNumber()
	end)
	busy[player] = true
	local ok, message = BoatService.updateProgress(player, function(current)
		MusselNets.place(current.Angler, x, z, now, soak)
	end)
	busy[player] = nil
	if not ok then
		return false, message
	end
	splash(Vector3.new(frame.X, Biomes.WaterLevel, frame.Z))
	refreshPlayer(player)
	return true, "Mussel net set! Harvest it in 3-5 minutes."
end

-- Keep a blocked harvest until it can be claimed; destroyed models drop out.
local pendingRolls: { [Instance]: any } = setmetatable({}, { __mode = "k" }) :: any

local function collect(player: Player, prompt: ProximityPrompt, automatic: boolean?)
	local anchor = prompt.Parent
	local model = anchor and anchor.Parent
	local base = baseOf(player)
	if
		not anchor
		or not anchor:IsA("BasePart")
		or not model
		or not CollectionService:HasTag(model, CAGE_TAG)
		or model:GetAttribute("OwnerUserId") ~= player.UserId
		or not base
		or not model:IsDescendantOf(base)
	then
		return
	end
	local root = rootOf(player)
	if not automatic and (not root or (root.Position - anchor.Position).Magnitude > prompt.MaxActivationDistance + 3) then
		return
	end
	local x, z = model:GetAttribute("X"), model:GetAttribute("Z")
	local profile = BoatService.getProfile(player)
	if type(x) ~= "number" or type(z) ~= "number" or not profile then
		return
	end
	local now = os.time()
	local problem = MusselNets.collectProblem(profile.Angler, x, z, now)
	if problem then
		notify(player, problem)
		return
	end
	local backpack = BackpackCatalog.Items[profile.Angler.BackpackId] or BackpackCatalog.Items.Starter
	-- Roll once so a blocked harvest or save retry cannot reroll the catches.
	local function rng()
		return random:NextNumber()
	end
	local rolls = pendingRolls[model]
	if not rolls then
		rolls = {}
		local pool = { Fish = table.clone(MusselNets.Pool.Fish) }
		local count = random:NextInteger(MusselNets.MIN_HARVEST, MusselNets.MAX_HARVEST)
		for _ = 1, count do
			local roll = FishCatch.roll(pool, Catalog.Fish, Catalog.Rarities, rng)
			table.remove(pool.Fish, table.find(pool.Fish, roll.FishId))
			roll.Traits = FishMutations.roll(
				Catalog.Fish[roll.FishId],
				DayNight.isNight(DayNight.clockTime()),
				rng,
				nil,
				MutationContext.at(anchor.Position, player)
			)
			roll.Value = FishMutations.value(roll.Value, roll.Traits.Mutation, roll.Traits.Corruptions)
			table.insert(rolls, roll)
		end
		pendingRolls[model] = rolls
	end
	local doubleXP = GamepassService.ownsDoubleXP(player)
	local noRoom = "Clear your hands or backpack to make room for the whole harvest."
	local function award(angler, layout)
		local destinations = {}
		for _, roll in rolls do
			local destination
			angler, destination = AnglerData.recordCatch(
				angler,
				roll.FishId,
				roll.Traits.Mutation,
				roll.Kg,
				roll.Value,
				now,
				Catalog.Fish,
				Catalog.Mutations,
				roll.Size,
				roll.Traits,
				layout,
				doubleXP,
				automatic
			)
			if destination == "Released" then
				return nil
			end
			table.insert(destinations, destination)
		end
		return angler, destinations
	end
	if not award(profile.Angler, backpack) then
		if not automatic then notify(player, noRoom) end
		return
	end
	local soak = MusselNets.soak(rng)
	local left, destinations = 0, nil
	local blocked = false
	busy[player] = true
	local ok, message = BoatService.updateProgress(player, function(current)
		if automatic then
			assert(current.Angler.Staff.Porter and StaffCatalog.workerLevel(current.Angler, "Porter") >= 3, "Porter unavailable")
		end
		assert(not MusselNets.collectProblem(current.Angler, x, z, now), "Harvest is no longer ready")
		local layout = BackpackCatalog.Items[current.Angler.BackpackId] or BackpackCatalog.Items.Starter
		local awarded
		awarded, destinations = award(current.Angler, layout)
		blocked = awarded == nil
		assert(not blocked, noRoom)
		current.Angler = awarded
		left = MusselNets.collect(current.Angler, x, z, now, soak)
	end)
	busy[player] = nil
	if not ok then
		if not automatic then notify(player, if blocked then noRoom else message) end
		return
	end
	pendingRolls[model] = nil
	local frame = model:GetAttribute("CageFrame")
	if typeof(frame) == "CFrame" then
		splash(Vector3.new(frame.X, Biomes.WaterLevel, frame.Z))
	end
	refreshPlayer(player)
	local catch = ReplicatedStorage:FindFirstChild("Catch")
	local reveal = catch and catch:FindFirstChild("Update")
	if not automatic and reveal and reveal:IsA("RemoteEvent") then
		local roll = rolls[1]
		reveal:FireClient(player, "Caught", {
			FishId = roll.FishId,
			Kg = roll.Kg,
			Size = roll.Size,
			Value = roll.Value,
			Mutation = roll.Traits.Mutation,
			NeonColor = roll.Traits.NeonColor,
			Corruptions = roll.Traits.Corruptions,
			Saved = true,
			AutoStored = false,
			BackpackStored = destinations[1] == "Backpack",
			Stored = destinations[1] == "Hand",
		})
	end
	local names = {}
	for _, roll in rolls do
		table.insert(names, Catalog.Fish[roll.FishId].Name)
	end
	if not automatic then notify(player, "Harvested: " .. table.concat(names, ", ") .. ".") end
	if left == 0 then
		notify(player, "That was the net's last harvest. Buy another at Tide & Tackle.")
	end
end

function MusselNetService.start()
	if started then
		return
	end
	started = true
	local remotes = Instance.new("Folder")
	remotes.Name = "MusselNets"
	local request = Instance.new("RemoteEvent")
	request.Name, request.Parent = "Request", remotes
	update = Instance.new("RemoteEvent")
	update.Name, update.Parent = "Update", remotes
	remotes.Parent = ReplicatedStorage
	request.OnServerEvent:Connect(function(player, action, target)
		if action ~= "Place" or busy[player] or os.clock() - (requests[player] or -math.huge) < 0.5 then
			return
		end
		requests[player] = os.clock()
		local _, message = place(player, target)
		notify(player, message)
	end)
	ProximityPromptService.PromptTriggered:Connect(function(triggered, player)
		if triggered.Name == PROMPT_NAME and not busy[player] then
			task.spawn(collect, player, triggered)
		end
	end)
	local function watchPlayer(player: Player)
		player:GetAttributeChangedSignal("AnglerRevision"):Connect(function()
			refreshPlayer(player)
		end)
		-- Respawning empties the Backpack, so hand the cages back.
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("Humanoid", 10)
			if player.Character == character then
				syncTool(player)
			end
		end)
	end
	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		requests[player], busy[player], placedCache[player] = nil, nil, nil
	end)
	local function watchBase(base: Instance)
		if base:IsA("Model") then
			base:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
				refreshBase(base)
			end)
			refreshBase(base)
		end
	end
	CollectionService:GetInstanceAddedSignal(BASE_TAG):Connect(watchBase)
	for _, base in CollectionService:GetTagged(BASE_TAG) do
		watchBase(base)
	end
	-- Harvest ready equipment while the owner has an active, upgraded porter.
	task.spawn(function()
		while true do
			task.wait(5)
			for _, player in Players:GetPlayers() do
				local profile = BoatService.getProfile(player)
				local base = baseOf(player)
				if profile and base and not busy[player] and profile.Angler.Staff.Porter
					and StaffCatalog.workerLevel(profile.Angler, "Porter") >= 3 then
					for _, model in CollectionService:GetTagged(CAGE_TAG) do
						if model:IsDescendantOf(base) then
							local x, z = model:GetAttribute("X"), model:GetAttribute("Z")
							local prompt = model:FindFirstChild(PROMPT_NAME, true)
							if prompt and type(x) == "number" and type(z) == "number"
								and not MusselNets.collectProblem(profile.Angler, x, z, os.time()) then
								local ok, failure = pcall(collect, player, prompt, true)
								if not ok then warn("[MusselNets] Porter harvest: " .. tostring(failure)) end
								break
							end
						end
					end
				end
			end
		end
	end)
	-- A level 4 porter replaces worn-out equipment using a tools rack.
	task.spawn(function()
		while true do
			task.wait(5)
			for _, player in Players:GetPlayers() do
				local profile = BoatService.getProfile(player)
				local base = baseOf(player)
				local dock = base and dockFrame(base)
				if not profile or not dock or busy[player] or not profile.Angler.Staff.Porter
					or StaffCatalog.workerLevel(profile.Angler, "Porter") < 4
					or #profile.Angler.MusselNets.Placed >= MusselNets.MAX_PLACED then continue end
				local rackIndex
				for index, rack in profile.Angler.Furniture do
					if rack.ItemId == "StorageRack" and rack.Mode == "Tools" and (rack.Nets or 0) > 0 then rackIndex = index break end
				end
				if not rackIndex then continue end
				local candidate = table.clone(profile.Angler)
				candidate.MusselNets = table.clone(profile.Angler.MusselNets)
				candidate.MusselNets.Stock += 1
				local ignore = {}
				for _, other in Players:GetPlayers() do if other.Character then table.insert(ignore, other.Character) end end
				local chosenX, chosenZ
				for z = -38, 2, 5 do
					for x = -22, 23, 5 do
						if not MusselNets.placeProblem(candidate, x, z) then
							local frame = cageFrame(dock, x, z)
							local clear = true
							for _, point in MusselNets.footprint(Props.MUSSEL_NET_SIZE) do
								if not openWater(frame * point, ignore) then clear = false break end
							end
							if clear then chosenX, chosenZ = x, z break end
						end
					end
					if chosenX then break end
				end
				if chosenX then
					local now = os.time()
					local soak = MusselNets.soak(function() return random:NextNumber() end)
					busy[player] = true
					local ok = BoatService.updateProgress(player, function(current)
						local rack = current.Angler.Furniture[rackIndex]
						assert(current.Angler.Staff.Porter and StaffCatalog.workerLevel(current.Angler, "Porter") >= 4, "Porter unavailable")
						assert(rack and rack.ItemId == "StorageRack" and rack.Mode == "Tools" and (rack.Nets or 0) > 0, "Rack unavailable")
						rack.Nets -= 1
						current.Angler.MusselNets.Stock += 1
						MusselNets.place(current.Angler, chosenX, chosenZ, now, soak)
					end)
					busy[player] = nil
					if ok then refreshPlayer(player) end
				end
			end
		end
	end)
	-- Countdowns tick once a second.
	task.spawn(function()
		while true do
			task.wait(1)
			for _, base in CollectionService:GetTagged(BASE_TAG) do
				if base:IsA("Model") and ownerOf(base) then
					local ok, failure = pcall(refreshBase, base)
					if not ok then
						warn("[MusselNets] " .. tostring(failure))
					end
				end
			end
		end
	end)
end

return MusselNetService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="206">
        <Properties>
          <string name="Name">NpcCollision</string>
          <string name="Source"><![CDATA[-- Moving NPCs share a collision group so they can pass one another without
-- changing their collisions with the world or with players.
local NpcCollision = {}
local GROUP = "BaseNPC"
local configured = false

function NpcCollision.bind(model: Model)
	if not configured then
		if not workspace:IsCollisionGroupRegistered(GROUP) then
			workspace:RegisterCollisionGroup(GROUP)
		end
		workspace:CollisionGroupSetCollidable(GROUP, GROUP, false)
		workspace:CollisionGroupSetCollidable(GROUP, "Default", true)
		configured = true
	end

	local originals = {}
	local function assign(part: Instance)
		if part:IsA("BasePart") and originals[part] == nil then
			originals[part] = part.CollisionGroup
			part.CollisionGroup = GROUP
		end
	end
	-- Accessories or carried objects may be parented after the avatar is made.
	-- Restore their original group if they leave the avatar, for example when a
	-- customer puts a carried fish back on a counter.
	model.DescendantAdded:Connect(assign)
	model.DescendantRemoving:Connect(function(part)
		local original = originals[part]
		if original ~= nil then
			part.CollisionGroup = original
			originals[part] = nil
		end
	end)
	for _, part in model:GetDescendants() do
		assign(part)
	end
end

return NpcCollision
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="207">
        <Properties>
          <string name="Name">NpcNavigation</string>
          <string name="Source"><![CDATA[-- Shared server-side navigation for customers and staff.
--
-- Walk each segment with a single Humanoid:MoveTo and poll progress instead of
-- re-steering every tick. Per-tick Move calls made R15 rigs stall at corners,
-- oscillate around waypoints and walk through low obstacles; a MoveTo is
-- allowed to settle while we watch for real progress. Failed routes are
-- replanned from the NPC's actual position; a rig is never teleported.
local PathfindingService = game:GetService("PathfindingService")

local NpcNavigation = {}
-- Humanoid MoveTo can finish roughly one stud short of its target.
local ARRIVAL_RADIUS = 1.25
-- Aim this far past an intermediate waypoint so MoveTo's short stop still
-- carries the rig around the corner instead of cutting through its inside.
local CORNER_RADIUS = 2
local STUCK_SECONDS = 1
local POLL_SECONDS = 0.1
local MAX_ATTEMPTS = 4
local MAX_WALK_SECONDS = 35
-- Small, supported step back before replanning a segment that stalled.
local BACKOFF_DISTANCE = 3
local BACKOFF_SECONDS = 1.5

local function flatDistance(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

function NpcNavigation.clearance(npc): number
	local torso = npc.model:FindFirstChild("UpperTorso") or npc.root
	return math.max(2, math.ceil(math.max(torso.Size.X, torso.Size.Z, npc.root.Size.Z) / 2))
end

function NpcNavigation.walk(
	npc,
	target: Vector3,
	allowed: (() -> boolean)?,
	stayOnGround: boolean?,
	straight: boolean?
): boolean
	local humanoid, root = npc.humanoid, npc.root
	local walkSpeed = humanoid.WalkSpeed
	local deadline = os.clock() + MAX_WALK_SECONDS
	local clearance = NpcNavigation.clearance(npc)
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances = { npc.model }
	parameters.RespectCanCollide = true
	parameters.CollisionGroup = root.CollisionGroup
	local head = npc.model:FindFirstChild("Head")
	local startFeet = root.Position.Y - humanoid.HipHeight - root.Size.Y / 2
	local height = if head
		then head.Position.Y + head.Size.Y / 2 - startFeet
		else humanoid.HipHeight + root.Size.Y / 2 + 2

	local function valid(): boolean
		return npc.active
			and npc.model.Parent ~= nil
			and root.Parent ~= nil
			and humanoid.Parent ~= nil
			and humanoid.Health > 0
			and (allowed == nil or allowed())
	end
	local function feet(): number
		return root.Position.Y - humanoid.HipHeight - root.Size.Y / 2
	end
	local function arrived(position: Vector3, radius: number?): boolean
		return flatDistance(root.Position, position) <= (radius or ARRIVAL_RADIUS)
			and math.abs(feet() - position.Y) <= 2.5
	end
	local function stop()
		if root.Parent and humanoid.Parent then
			humanoid:Move(Vector3.zero)
			-- Leave the rig standing where it is instead of walking on to an
			-- abandoned goal after a timeout or cancellation.
			humanoid:MoveTo(root.Position)
		end
	end
	-- A path can report a successful route across a gap or along a pier edge.
	-- Check the deck under the whole body along the segment before walking it.
	-- The segment Y is interpolated so ramps and steps stay supported.
	local function supportedBetween(fromPosition: Vector3, position: Vector3, strict: boolean?, sampleStep: number?): boolean
		local from = Vector3.new(fromPosition.X, 0, fromPosition.Z)
		local to = Vector3.new(position.X, 0, position.Z)
		local delta = to - from
		local distance = delta.Magnitude
		if distance < 0.05 then
			return true
		end
		local forward = delta.Unit
		local side = Vector3.new(-forward.Z, 0, forward.X) * (clearance - 0.5)
		local fromY, toY = fromPosition.Y, position.Y
		local samples = math.max(1, math.ceil(distance / (sampleStep or 0.5)))
		for sample = 1, samples do
			local t = sample / samples
			local point = from + delta * t
			local sampleY = fromY + (toY - fromY) * t
			for _, offset in { Vector3.zero, side, -side } do
				local floor = nil
				-- Tiny seams between deck planks must not read as missing deck.
				for _, seam in { 0, 0.13 } do
					floor = workspace:Raycast(
						Vector3.new(point.X, sampleY + 2, point.Z) + offset + forward * seam,
						Vector3.new(0, -5, 0),
						parameters
					)
					if floor and floor.Material ~= Enum.Material.Water and floor.Normal.Y >= 0.7
						and (not strict or math.abs(floor.Position.Y - sampleY) <= 1.1) then
						break
					end
					floor = nil
				end
				if not floor then
					return false
				end
			end
		end
		return true
	end
	local function supported(position: Vector3): boolean
		return not stayOnGround or supportedBetween(Vector3.new(root.Position.X, feet(), root.Position.Z), position, true)
	end
	local function follow(position: Vector3, radius: number, moveDeadline: number, blocked: () -> boolean, canTurn: (() -> boolean)?): boolean
		local function reached(): boolean
			return arrived(position, radius) and (canTurn == nil or canTurn())
		end
		if reached() then
			return true
		end
		if flatDistance(root.Position, position) < 0.1 then
			-- Horizontally aligned but on another floor: there is no walking
			-- direction that can fix this segment.
			return false
		end
		if not supported(position) then
			return false
		end
		humanoid:MoveTo(position)
		local best = flatDistance(root.Position, position)
		local progressAt = os.clock()
		local correcting = false
		local function finish(ok: boolean): boolean
			if correcting and root.Parent and humanoid.Parent then
				humanoid:Move(Vector3.zero)
			end
			return ok
		end
		while valid() and not blocked() and os.clock() < moveDeadline do
			if reached() then
				return finish(true)
			end
			if canTurn and not correcting and arrived(position, radius) then
				-- MoveTo may stop a stud before a narrow doorway's center.
				-- Finish this last short approach before turning; the next leg
				-- must clear the jamb from the rig's actual position. Issue one
				-- correction, keeping normal segment movement on MoveTo.
				local direction = Vector3.new(position.X - root.Position.X, 0, position.Z - root.Position.Z)
				if direction.Magnitude < 0.05 then return false end
				humanoid:Move(direction.Unit)
				correcting = true
			end
			-- Observe the short correction more often so a fast porter cannot
			-- step past the narrow band where the next doorway leg is clear.
			task.wait(if correcting then math.min(POLL_SECONDS, 0.2 / math.max(1, humanoid.WalkSpeed)) else POLL_SECONDS)
			if not valid() or blocked() then
				return finish(false)
			end
			if reached() then
				return finish(true)
			end
			local current = flatDistance(root.Position, position)
			if current < best - 0.15 then
				best, progressAt = current, os.clock()
			elseif os.clock() - progressAt >= STUCK_SECONDS then
				-- The humanoid is not making progress. Let the caller replan
				-- instead of pushing against a corner forever.
				return finish(false)
			end
		end
		return finish(valid() and not blocked() and reached())
	end
	-- A new path from the same jammed position often repeats the same corner.
	-- Step straight back along the incoming segment first; only do this after
	-- the rig actually moved, and never after a Blocked event (which reports a
	-- new obstacle and must be routed around from where we stand).
	local function backOff(from: Vector3, position: Vector3)
		local incoming = Vector3.new(position.X - from.X, 0, position.Z - from.Z)
		if incoming.Magnitude < 0.1 then
			return
		end
		local current = Vector3.new(root.Position.X, 0, root.Position.Z)
		local candidate = current - incoming.Unit * math.min(BACKOFF_DISTANCE, incoming.Magnitude)
		local destination = Vector3.new(candidate.X, feet(), candidate.Z)
		if stayOnGround and not supported(destination) then
			return
		end
		humanoid:MoveTo(destination)
		local untilTime = math.min(deadline, os.clock() + BACKOFF_SECONDS)
		while valid() and os.clock() < untilTime and flatDistance(root.Position, destination) > 0.6 do
			task.wait(POLL_SECONDS)
		end
	end

	if not valid() then
		stop()
		return false
	end
	if straight then
		-- Known dock centerlines already describe the safe corridor. Never
		-- take a navmesh detour or a sideways recovery step near water.
		local ok = follow(target, ARRIVAL_RADIUS, deadline, function()
			return false
		end)
		stop()
		return valid() and ok
	end


	-- Route across the base's house-local grid. Sample the actual walking
	-- surface for each cell: the yard, ramps and piers are at different heights,
	-- and empty cells over water must never become shortcuts.
	local gridFrame = npc.gridFrame
	if typeof(gridFrame) == "CFrame" then
		local grid = require(game:GetService("ReplicatedStorage").Shared.BaseGrid)
		local startLocal = gridFrame:PointToObjectSpace(root.Position)
		local goalLocal = gridFrame:PointToObjectSpace(target)
		local startColumn = grid.localToExtendedCell(startLocal.X, startLocal.Z)
		local goalColumn = grid.localToExtendedCell(goalLocal.X, goalLocal.Z)
		if startColumn and goalColumn then
			local overlap = OverlapParams.new()
			overlap.FilterType = Enum.RaycastFilterType.Exclude
			overlap.FilterDescendantsInstances = { npc.model }
			overlap.RespectCanCollide = true
			overlap.CollisionGroup = root.CollisionGroup
			-- The path service uses a conservative whole-stud radius, but that
			-- overstates the physical body for grid queries. In particular it
			-- marks customer access points next to counters as inside the counter.
			-- Reserve the actual torso/root footprint plus room for limbs instead.
			local torso = npc.model:FindFirstChild("UpperTorso") or root
			local width = math.max(3, torso.Size.X + 0.5, torso.Size.Z + 0.5, root.Size.X + 0.5, root.Size.Z + 0.5)
			local bodyHeight = math.max(2, math.min(height, 5))
			local bodySize = Vector3.new(width, bodyHeight, width)
			local topY = math.max(feet(), target.Y) + 2.5
			local bottomY = math.min(feet(), target.Y) - 3
			local function point(column: number, row: number, subdivisions: number): Vector3?
				local x, z = grid.extendedCellToLocal(column / subdivisions, row / subdivisions)
				local horizontal = gridFrame:PointToWorldSpace(Vector3.new(x, 0, z))
				local hit = workspace:Raycast(Vector3.new(horizontal.X, topY, horizontal.Z), Vector3.new(0, bottomY - topY, 0), parameters)
				-- The base house floor is 0.16 studs above HouseFrame, while the
				-- quay and docks are lower. Furniture tops are not walking surfaces.
				if not hit or hit.Material == Enum.Material.Water or hit.Normal.Y < 0.7
					or hit.Position.Y > gridFrame.Position.Y + 0.25 then
					return nil
				end
				return hit.Position
			end
			local function bodyFrame(position: Vector3): CFrame
				-- Leave room below the box for a sloping ramp under its uphill edge.
				return CFrame.new(position + Vector3.new(0, bodyHeight / 2 + 0.85, 0)) * gridFrame.Rotation
			end
			local function clearAt(position: Vector3): boolean
				return #workspace:GetPartBoundsInBox(bodyFrame(position), bodySize, overlap) == 0
			end
			local function clearBetween(from: Vector3, to: Vector3): boolean
				local delta = to - from
				return math.abs(delta.Y) <= 2
					and (delta.Magnitude < 0.05 or workspace:Blockcast(bodyFrame(from), bodySize, delta, parameters) == nil)
					-- Route search samples at one-stud intervals; follow() checks
					-- the actual segment again at half-stud intervals before moving.
					and supportedBetween(from, to, true, 1)
			end
			local function route(subdivisions: number): { Vector3 }?
				-- Furniture cells are 4.5 studs wide. A one-cell doorway can sit
				-- between their centers (the lobby door does), leaving no usable
				-- edge on that lattice. Retry at half-cell spacing while keeping
				-- the same physical bounds and full body/floor clearance checks.
				local spacing = grid.CELL_SIZE / subdivisions
				local minColumn, maxColumn = grid.BASE_MIN_COLUMN * subdivisions, grid.BASE_MAX_COLUMN * subdivisions
				local minRow, maxRow = grid.BASE_MIN_ROW * subdivisions, grid.BASE_MAX_ROW * subdivisions
				local queue, previous, points, usable, edges, cost, closed = {}, {}, {}, {}, {}, {}, {}
				local function key(column: number, row: number): number
					return (row - minRow) * (maxColumn - minColumn + 1) + column - minColumn + 1
				end
				local function isUsable(column: number, row: number): boolean
					if column < minColumn or column > maxColumn or row < minRow or row > maxRow then
						return false
					end
					local id = key(column, row)
					if usable[id] == nil then
						points[id] = point(column, row, subdivisions)
						usable[id] = points[id] ~= nil and clearAt(points[id])
					end
					return usable[id]
				end
				-- Multiple nearby entry cells avoid stranding a rig that starts
				-- beside a fixture or was pushed away from a cell center.
				local starts = {}
				for row = minRow, maxRow do
					for column = minColumn, maxColumn do
						local x, z = grid.extendedCellToLocal(column / subdivisions, row / subdivisions)
						local distance = (Vector3.new(x - startLocal.X, 0, z - startLocal.Z)).Magnitude
						if distance <= grid.CELL_SIZE * 1.5 and isUsable(column, row) then
							local candidate = points[key(column, row)]
							if clearBetween(Vector3.new(root.Position.X, feet(), root.Position.Z), candidate) then
								table.insert(starts, { column, row, distance })
							end
						end
					end
				end
				table.sort(starts, function(a, b) return a[3] < b[3] end)
				for _, start in starts do
					local id = key(start[1], start[2])
					previous[id] = 0
					cost[id] = start[3] / spacing
					table.insert(queue, { start[1], start[2] })
				end
				local finish = nil
				while #queue > 0 do
					-- Favor cells nearer the destination; this avoids scanning the
					-- whole quay for every trip down a narrow pier.
					local best, bestScore = 1, math.huge
					for index, candidate in queue do
						local id = key(candidate[1], candidate[2])
						local score = cost[id] + flatDistance(points[id], target) / spacing
						if score < bestScore then best, bestScore = index, score end
					end
					local current = table.remove(queue, best)
					local id = key(current[1], current[2])
					if closed[id] then continue end
					closed[id] = true
					local position = points[id]
					if flatDistance(position, target) <= grid.CELL_SIZE * 1.5 and clearBetween(position, target) then
						finish = id
						break
					end
					for _, step in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
						local column, row = current[1] + step[1], current[2] + step[2]
						local nextId = key(column, row)
						local nextCost = cost[id] + 1
						if not closed[nextId] and (cost[nextId] == nil or nextCost < cost[nextId]) and isUsable(column, row) then
							local edgeKey = math.min(id, nextId) .. ":" .. math.max(id, nextId)
							if edges[edgeKey] == nil then
								edges[edgeKey] = clearBetween(position, points[nextId])
							end
							if edges[edgeKey] then
								previous[nextId] = id
								cost[nextId] = nextCost
								table.insert(queue, { column, row })
							end
						end
					end
				end
				if not finish then return nil end
				local result = { target }
				while finish ~= 0 do
					table.insert(result, 1, points[finish])
					finish = previous[finish]
				end
				-- Consecutive grid cells are planning details, not stopping points.
				-- Skip as many as the actual swept body and continuous floor allow;
				-- retaining turns only where obstacles or dock edges require them.
				local simplified = {}
				local from = Vector3.new(root.Position.X, feet(), root.Position.Z)
				local first = 1
				while first <= #result do
					local last = first
					for candidate = #result, first + 1, -1 do
						local destination = result[candidate]
						if clearBetween(from, destination) and supportedBetween(from, destination, true) then
							last = candidate
							break
						end
					end
					from = result[last]
					table.insert(simplified, from)
					first = last + 1
				end
				return simplified
			end
			for attempt = 1, MAX_ATTEMPTS do
				if not valid() or os.clock() >= deadline then break end
				if arrived(target) then stop() return true end
				local waypoints = route(1) or route(2)
				if not waypoints then break end
				local failed = false
				for index, position in waypoints do
					local aim = position
					if index < #waypoints then
						local from = if index == 1 then root.Position else waypoints[index - 1]
						local direction = Vector3.new(position.X - from.X, 0, position.Z - from.Z)
						if direction.Magnitude > 0.1 then
							local ahead = position + direction.Unit * 1.1
							local current = Vector3.new(root.Position.X, feet(), root.Position.Z)
							-- Do not overshoot a corner if doing so makes the following
							-- leg cut across a wall, furniture, or the edge of a pier.
							if clearBetween(current, ahead) and supportedBetween(current, ahead, true)
								and clearBetween(ahead, waypoints[index + 1]) then
								aim = ahead
							end
						end
					end
					local distance = flatDistance(root.Position, aim)
					local moveDeadline = math.min(deadline, os.clock() + math.max(3, distance / math.max(1, humanoid.WalkSpeed) * 2 + 1))
					local nextPosition = waypoints[index + 1]
					local function canTurn(): boolean
						local current = Vector3.new(root.Position.X, feet(), root.Position.Z)
						return clearBetween(current, nextPosition)
					end
					if not follow(aim, ARRIVAL_RADIUS, moveDeadline, function() return false end, if nextPosition then canTurn else nil) then
						failed = true
						break
					end
				end
				if not failed and valid() and arrived(target) then stop() return true end
				if valid() and os.clock() < deadline then task.wait(0.25 * attempt) end
			end
			-- A tight fixture approach may not reach a whole-cell center even
			-- though the navmesh can reach it. Preserve that route as a fallback.
		end
	end

	for attempt = 1, MAX_ATTEMPTS do
		if not valid() or os.clock() >= deadline then
			break
		end
		if arrived(target) then
			stop()
			return true
		end
		local path = PathfindingService:CreatePath({
			AgentRadius = clearance,
			AgentHeight = math.max(5, math.ceil(height)),
			AgentCanJump = false,
			AgentCanClimb = false,
			WaypointSpacing = 3,
			Costs = { Water = math.huge },
		})
		local ok = pcall(function()
			path:ComputeAsync(root.Position, target)
		end)
		if not valid() then
			path:Destroy()
			stop()
			return false
		end
		local failed: Vector3? = nil
		local failedFrom: Vector3? = nil
		local progressed = false
		local blockedEvent = false
		if ok and path.Status == Enum.PathStatus.Success then
			local waypoints = path:GetWaypoints()
			local nextWaypoint = 2 -- First point is the computed starting position.
			local blocked = false
			local connection = path.Blocked:Connect(function(index)
				if index >= nextWaypoint then
					blocked = true
				end
			end)
			local previous: Vector3? = nil
			for index = 2, #waypoints do
				if not valid() or os.clock() >= deadline then
					break
				end
				nextWaypoint = index
				local position = waypoints[index].Position
				local distance = flatDistance(root.Position, position)
				local moveDeadline =
					math.min(deadline, os.clock() + math.max(3, distance / math.max(1, humanoid.WalkSpeed) * 2 + 1))
				local startPosition = root.Position
				local from = previous or startPosition
				local targetPosition = position
				if index < #waypoints then
					-- MoveTo stops about a stud short. Aim slightly past a
					-- corner so the rig actually rounds it instead of cutting
					-- across the inside of a doorway or wall.
					local direction = Vector3.new(position.X - from.X, 0, position.Z - from.Z)
					if direction.Magnitude >= 0.5 then
						-- The navmesh only guarantees clearance up to the waypoint.
						-- A wall can be immediately beyond a valid turn, so do not
						-- blindly extend the target into it.
						local extension = direction.Unit * CORNER_RADIUS
						local width = math.max(1, clearance * 2 - 0.1)
						local hit = workspace:Blockcast(
							CFrame.new(position + Vector3.new(0, 2.5, 0)),
							Vector3.new(width, 2, width),
							extension,
							parameters
						)
						local distance = if hit then math.max(0, (hit.Distance or 0) - 0.2) else CORNER_RADIUS
						local ahead = position + direction.Unit * math.min(CORNER_RADIUS, distance)
						local candidate = Vector3.new(ahead.X, position.Y, ahead.Z)
						if not stayOnGround or supported(candidate) then
							targetPosition = candidate
						end
					end
				end
				if not follow(targetPosition, ARRIVAL_RADIUS, moveDeadline, function()
					return blocked
				end) then
					failed = position
					failedFrom = from
					progressed = flatDistance(startPosition, root.Position) > 0.5
					blockedEvent = blocked
					break
				end
				previous = position
			end
			connection:Disconnect()
		end
		path:Destroy()
		if valid() and arrived(target) then
			stop()
			return true
		end
		if attempt < MAX_ATTEMPTS and valid() and os.clock() < deadline then
			if failed and progressed and not blockedEvent then
				backOff(failedFrom or failed, failed)
			end
			-- Let moved furniture/navmesh updates and other characters settle.
			task.wait(0.25 * attempt)
		end
	end
	stop()
	return false
end

return NpcNavigation
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="208">
        <Properties>
          <string name="Name">OxygenService</string>
          <string name="Source"><![CDATA[-- Owns a player's breath while their head is below the ocean surface.  The
-- replicated attributes deliberately contain presentation state only; the
-- server decides when a player has run out of air and respawns them.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Biomes = require(ReplicatedStorage.Shared.Biomes)

local OXYGEN_SECONDS = 20
local SAMPLE_INTERVAL = 0.1
local BLACKOUT_SECONDS = 1.15

type BreathState = {

	oxygen: number,
	drowning: boolean,
}

local OxygenService = {}
local states: { [Player]: BreathState } = {}
local elapsed = 0

local function isUnderwater(character: Model): boolean
	if character:GetAttribute("MetroRiding") then return false end
	-- Breathing is based on the head rather than the root part, so a player can
	-- tread water at the surface without losing oxygen.
	local head = character:FindFirstChild("Head") :: BasePart?
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local part = head or root
	if not part then
		return false
	end

	local position = part.Position
	return Biomes.inOceanBounds(position)
		and position.Y > Biomes.SeaFloor
		and position.Y < Biomes.WaterLevel
end

local function publish(player: Player, state: BreathState, underwater: boolean)
	player:SetAttribute("Underwater", underwater)
	player:SetAttribute("Oxygen", state.oxygen)
end

local function reset(player: Player, state: BreathState)
	state.oxygen = 1
	publish(player, state, false)
end

local function drown(player: Player, state: BreathState)
	if state.drowning then
		return
	end
	state.drowning = true
	publish(player, state, true)
	player:SetAttribute("OxygenBlackout", true)

	-- The client begins its fade immediately.  Loading the character after the
	-- fade means BaseService's normal CharacterAdded placement returns them to
	-- their owned base (or the harbour fallback if all bases are occupied).
	task.delay(BLACKOUT_SECONDS, function()
		if states[player] ~= state or not state.drowning or player.Parent ~= Players then
			return
		end
		player:LoadCharacter()
		task.delay(0.7, function()
			if states[player] ~= state then
				return
			end
			state.drowning = false
			reset(player, state)
			player:SetAttribute("OxygenBlackout", false)
		end)
	end)
end

local function track(player: Player)
	local state: BreathState = { oxygen = 1, drowning = false }
	states[player] = state
	player:SetAttribute("OxygenBlackout", false)
	reset(player, state)

	player.CharacterAdded:Connect(function()
		-- Natural respawns and BaseService placements always begin with a full
		-- tank. The blackout sequence clears itself after the new avatar appears.
		reset(player, state)
	end)
end

function OxygenService.start()
	Players.PlayerAdded:Connect(track)
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		track(player)
	end

	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < SAMPLE_INTERVAL then
			return
		end
		local step = elapsed
		elapsed = 0

		for player, state in states do
			if state.drowning then
				continue
			end
			local character = player.Character
			if not character then
				reset(player, state)
				continue
			end
			local underwater = isUnderwater(character)
			if underwater then
				state.oxygen = math.max(0, state.oxygen - step / OXYGEN_SECONDS)
				publish(player, state, true)
				if state.oxygen <= 0 then
					drown(player, state)
				end
			else
				reset(player, state)
			end
		end
	end)
end

return OxygenService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="209">
        <Properties>
          <string name="Name">PatrolBoat</string>
          <string name="Source"><![CDATA[-- Gray coastal patrol cruiser inspired by a long-bow, rear-wheelhouse launch.
-- Waterline origin; local -Z is the bow.
-- The faceted V hull and cockpit sole form one welded, server-driven assembly.
local PatrolBoat = {}
local LIGHT_GRAY = Color3.fromRGB(182, 185, 188)
local HULL_GRAY = Color3.fromRGB(94, 98, 103)
local DECK = Color3.fromRGB(121, 125, 129)
local DARK = Color3.fromRGB(43, 46, 50)
local GLASS = Color3.fromRGB(63, 73, 80)
local METAL = Color3.fromRGB(154, 158, 162)
local LAMP = Color3.fromRGB(212, 208, 196)
local PORT_LAMP = Color3.fromRGB(214, 48, 44)
local STARBOARD_LAMP = Color3.fromRGB(52, 196, 92)
local STROBE = Color3.fromRGB(46, 112, 235)
local THICKNESS = 0.18
-- Match the reference cruiser's scale beside a standard player avatar.
-- Scale around the waterline so previews and launched boats sit at the same height.
-- 1.2 is 80% of the original 1.5 display scale.
local SCALE = 1.2
-- The wheelhouse spans these stations; the foredeck runs up to its front wall.
local CABIN_FRONT = 4
local CABIN_REAR = 12.6

function PatrolBoat.build(frame: CFrame, anchored: boolean?): Model
	local isAnchored = anchored == true
	local model = Instance.new("Model")
	model.Name = "PatrolBoat"
	model:SetAttribute("HullLength", 42 * SCALE)
	model:SetAttribute("HullBeam", 12 * SCALE)
	model:SetAttribute("PassengerSeats", 2)
	model:SetAttribute("DriverSeat", "HelmSeat")
	model:SetAttribute("DryFloorHeight", 1.1 * SCALE)
	model:SetAttribute("DryFloorHalfBeam", 5.4 * SCALE)
	model:SetAttribute("DryFloorHalfLength", 21 * SCALE)

	local function scaledFrame(localFrame: CFrame): CFrame
		return frame
			* CFrame.fromMatrix(
				localFrame.Position * SCALE,
				localFrame.RightVector,
				localFrame.UpVector,
				localFrame.ZVector
			)
	end

	local root = Instance.new("Part")
	root.Name = "HullRoot"
	root.Size = Vector3.new(7, 0.5, 28) * SCALE
	root.CFrame = scaledFrame(CFrame.new(0, -0.4, 0))
	root.Transparency = 1
	root.Anchored = isAnchored
	root.CanCollide = false
	root.CanTouch = false
	root.RootPriority = 127
	root.CustomPhysicalProperties = PhysicalProperties.new(1.4, 0.45, 0.05, 100, 100)
	root.Parent = model
	model.PrimaryPart = root

	local function finish(p: BasePart, name: string, color: Color3, material: Enum.Material?, collide: boolean?)
		p.Size *= SCALE
		p.CFrame = scaledFrame(frame:ToObjectSpace(p.CFrame))
		p.Name = name
		p.Anchored = isAnchored
		p.CanCollide = collide == true
		p.CanTouch = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.Massless = true
		p.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = p
		weld.Parent = p
		return p
	end

	local function part(
		name: string,
		size: Vector3,
		localFrame: CFrame,
		color: Color3,
		material: Enum.Material?,
		collide: boolean?
	): Part
		local p = Instance.new("Part")
		p.Size = size
		p.CFrame = frame * localFrame
		finish(p, name, color, material, collide)
		return p
	end

	local function beam(
		name: string,
		a: Vector3,
		b: Vector3,
		width: number,
		depth: number,
		color: Color3,
		material: Enum.Material?,
		collide: boolean?
	): Part
		return part(
			name,
			Vector3.new(width, depth, (b - a).Magnitude),
			CFrame.lookAt((a + b) / 2, b),
			color,
			material,
			collide
		)
	end

	-- Thin facets form an open hull; there is no solid collision box through it.
	local function triangle(name: string, a: Vector3, b: Vector3, c: Vector3, inside: Vector3, color: Color3)
		local ab, ac, bc = b - a, c - a, c - b
		local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
		if abd > acd and abd > bcd then
			c, a = a, c
		elseif acd > bcd and acd > abd then
			a, b = b, a
		end
		ab, ac, bc = b - a, c - a, c - b
		local right = ac:Cross(ab).Unit
		local up = bc:Cross(right).Unit
		local back = bc.Unit
		local height = math.abs(ab:Dot(up))
		local normal = if right:Dot((a + b + c) / 3 - inside) >= 0 then right else -right
		local shift = -normal * THICKNESS / 2
		local first = Instance.new("WedgePart")
		first.Size = Vector3.new(THICKNESS, height, math.abs(ab:Dot(back)))
		first.CFrame = frame * CFrame.fromMatrix((a + b) / 2 + shift, right, up, back)
		finish(first, name, color, nil, true)
		local second = Instance.new("WedgePart")
		second.Size = Vector3.new(THICKNESS, height, math.abs(ac:Dot(back)))
		second.CFrame = frame * CFrame.fromMatrix((a + c) / 2 + shift, -right, up, -back)
		finish(second, name, color, nil, true)
	end

	-- A long, fine entry flares into a full-beam midsection; chine is the
	-- height where the topsides meet the bilge.
	local stations = {
		{ z = -22, width = 0.18, bottom = 0.12, top = 3.35, keel = -0.05, chine = 0.25 },
		{ z = -18.3, width = 2.4, bottom = 1.5, top = 3.1, keel = -1, chine = -0.3 },
		{ z = -13, width = 4.35, bottom = 3.45, top = 2.85, keel = -1.6, chine = -0.62 },
		{ z = -6, width = 5.85, bottom = 4.85, top = 2.6, keel = -1.85, chine = -0.72 },
		{ z = 6, width = 5.9, bottom = 4.95, top = 2.5, keel = -1.85, chine = -0.72 },
		{ z = 14, width = 5.7, bottom = 5.1, top = 2.5, keel = -1.55, chine = -0.72 },
		{ z = 19, width = 5.3, bottom = 4.75, top = 2.5, keel = -1.1, chine = -0.72 },
	}
	local function hullPoint(station, side: number, level: number): Vector3
		return Vector3.new(
			side * (station.bottom + (station.width - station.bottom) * level),
			station.chine + (station.top - station.chine) * level,
			station.z
		)
	end
	-- Each cross-section curves inward through the bilge to the center keel.
	-- These panels close the underside all the way from bow to transom.
	local function bottomPoint(station, side: number, level: number): Vector3
		if level == 0 then
			return hullPoint(station, side, 0)
		elseif level == 1 then
			local edge = hullPoint(station, side, 0)
			return Vector3.new(side * station.bottom * 0.52, station.keel + (edge.Y - station.keel) * 0.42, station.z)
		end
		return Vector3.new(0, station.keel, station.z)
	end
	for _, side in { -1, 1 } do
		for i = 1, #stations - 1 do
			local from, to = stations[i], stations[i + 1]
			for _, band in { { 0, 0.68, HULL_GRAY }, { 0.68, 1, LIGHT_GRAY } } do
				local a, b = hullPoint(from, side, band[1]), hullPoint(to, side, band[1])
				local c, d = hullPoint(to, side, band[2]), hullPoint(from, side, band[2])
				local inside = Vector3.new(0, 0.8, (from.z + to.z) / 2)
				triangle("HullPanel", a, b, c, inside, band[3])
				triangle("HullPanel", a, c, d, inside, band[3])
			end
			for band = 0, 1 do
				local a, b = bottomPoint(from, side, band), bottomPoint(to, side, band)
				local c, d = bottomPoint(to, side, band + 1), bottomPoint(from, side, band + 1)
				local inside = Vector3.new(0, 0.8, (from.z + to.z) / 2)
				local name = if band == 0 then "BilgePanel" else "BottomPanel"
				triangle(name, a, b, c, inside, HULL_GRAY)
				triangle(name, a, c, d, inside, HULL_GRAY)
			end
			beam("Gunwale", hullPoint(from, side, 1), hullPoint(to, side, 1), 0.3, 0.24, DARK)
			-- A dark fender strake marks the two-tone seam along the topsides.
			local strake = Vector3.new(side * 0.1, 0, 0)
			beam("RubRail", hullPoint(from, side, 0.68) + strake, hullPoint(to, side, 0.68) + strake, 0.26, 0.28, DARK)
		end
	end
	for _, station in { stations[1], stations[#stations] } do
		local center = Vector3.new(0, hullPoint(station, 1, 0).Y, station.z)
		local inside = Vector3.new(0, 0.8, 0)
		for _, side in { -1, 1 } do
			local edge, bilge, keel =
				bottomPoint(station, side, 0), bottomPoint(station, side, 1), bottomPoint(station, side, 2)
			triangle("HullEndCap", edge, bilge, keel, inside, HULL_GRAY)
			triangle("HullEndCap", edge, keel, center, inside, HULL_GRAY)
		end
		if station == stations[1] then
			local left, right = hullPoint(station, -1, 1), hullPoint(station, 1, 1)
			triangle("BowCap", center, left, right, inside, HULL_GRAY)
			triangle("BowCap", center, hullPoint(station, -1, 0), left, inside, HULL_GRAY)
			triangle("BowCap", center, right, hullPoint(station, 1, 0), inside, HULL_GRAY)
		end
	end
	local stern = stations[#stations]
	local sternLeft, sternRight = hullPoint(stern, -1, 0), hullPoint(stern, 1, 0)
	triangle("Transom", sternLeft, sternRight, hullPoint(stern, 1, 1), Vector3.new(0, 0.8, 0), LIGHT_GRAY)
	triangle("Transom", sternLeft, hullPoint(stern, 1, 1), hullPoint(stern, -1, 1), Vector3.new(0, 0.8, 0), LIGHT_GRAY)
	part("TransomTrim", Vector3.new(10.5, 0.5, 0.23), CFrame.new(0, 2.24, stern.z), LIGHT_GRAY)
	part("TransomCap", Vector3.new(10.6, 0.2, 0.3), CFrame.new(0, 2.5, stern.z), LIGHT_GRAY)
	for _, side in { -1, 1 } do
		part("ExhaustPort", Vector3.new(0.7, 0.35, 0.12), CFrame.new(side * 3.2, 1.3, stern.z + 0.08), DARK)
		part("PlatformBracket", Vector3.new(0.3, 0.5, 0.85), CFrame.new(side * 3.6, 0.3, stern.z + 0.43), DARK)
	end
	-- Low swim platform and transom step for boarding from the water. The transom
	-- and platform stay ahead of the drydock headwall when previewed on the slip.
	part("SwimPlatform", Vector3.new(9.4, 0.3, 0.95), CFrame.new(0, 0.7, stern.z + 0.475), DECK, nil, true)
	part("TransomStep", Vector3.new(2.2, 0.3, 0.55), CFrame.new(0, 1.75, stern.z + 0.3), DECK, nil, true)
	for index = 1, #stations - 1 do
		beam(
			"Keel",
			bottomPoint(stations[index], 1, 2),
			bottomPoint(stations[index + 1], 1, 2),
			0.18,
			0.16,
			HULL_GRAY,
			nil,
			true
		)
	end
	local bow = stations[1]
	part(
		"BowStem",
		Vector3.new(0.3, bow.top - bow.chine, 0.25),
		CFrame.new(0, (bow.top + bow.chine) / 2, bow.z),
		LIGHT_GRAY
	)
	part("BowAnchor", Vector3.new(0.55, 0.65, 0.2), CFrame.new(0, 2.45, bow.z - 0.12), DARK)

	-- A flat, uninterrupted sole keeps the stern entrance and side decks walkable.
	local function deckWidth(s)
		return s.bottom + (s.width - s.bottom) * (1.1 - s.chine) / (s.top - s.chine) - 0.1
	end
	for i = -9, 9 do
		local outside = (math.abs(i) + 0.5) * 0.55
		local startZ, endZ = stations[1].z, stations[#stations].z - 0.15
		for index = 1, #stations - 1 do
			local a, b = stations[index], stations[index + 1]
			local fromWidth, toWidth = deckWidth(a), deckWidth(b)
			if fromWidth < outside and toWidth >= outside then
				startZ = a.z + (b.z - a.z) * (outside - fromWidth) / (toWidth - fromWidth)
			elseif fromWidth >= outside and toWidth < outside then
				endZ = a.z + (b.z - a.z) * (outside - fromWidth) / (toWidth - fromWidth)
			end
		end
		part(
			"WorkingDeck",
			Vector3.new(0.55, 0.22, endZ - startZ),
			CFrame.new(i * 0.55, 0.99, (startZ + endZ) / 2),
			DECK,
			nil,
			true
		)
	end

	-- Long pointed foredeck, with the low angular center housing in the reference.
	for index = 1, 4 do
		local a, b = stations[index], stations[index + 1]
		local endZ = math.min(b.z, CABIN_FRONT - 0.12)
		local t = (endZ - a.z) / (b.z - a.z)
		local endWidth = a.width + (b.width - a.width) * t
		local endY = a.top + (b.top - a.top) * t - 0.12
		local centerA, centerB = Vector3.new(0, a.top - 0.12, a.z), Vector3.new(0, endY, endZ)
		for _, side in { -1, 1 } do
			local edgeA = hullPoint(a, side, 1) - Vector3.new(0, 0.12, 0)
			local edgeB = Vector3.new(side * endWidth, endY, endZ)
			triangle("Foredeck", centerA, edgeA, edgeB, Vector3.new(0, 0, -5), DECK)
			triangle("Foredeck", centerA, edgeB, centerB, Vector3.new(0, 0, -5), DECK)
		end
	end
	local housing = {
		{ z = -15, w = 0.75, y = 3.2 },
		{ z = -6.5, w = 2.6, y = 4.25 },
		{ z = CABIN_FRONT, w = 3.35, y = 4.25 },
	}
	for i = 1, #housing - 1 do
		local a, b = housing[i], housing[i + 1]
		local al, ar = Vector3.new(-a.w, a.y, a.z), Vector3.new(a.w, a.y, a.z)
		local bl, br = Vector3.new(-b.w, b.y, b.z), Vector3.new(b.w, b.y, b.z)
		triangle("RaisedBowHousing", al, ar, br, Vector3.new(0, 2, 0), LIGHT_GRAY)
		triangle("RaisedBowHousing", al, br, bl, Vector3.new(0, 2, 0), LIGHT_GRAY)
		for _, side in { -1, 1 } do
			local topA, topB = Vector3.new(side * a.w, a.y, a.z), Vector3.new(side * b.w, b.y, b.z)
			local lowA, lowB = Vector3.new(side * a.w, 2.38, a.z), Vector3.new(side * b.w, 2.38, b.z)
			triangle("BowHousingSide", topA, lowA, lowB, Vector3.new(0, 2, 0), LIGHT_GRAY)
			triangle("BowHousingSide", topA, lowB, topB, Vector3.new(0, 2, 0), LIGHT_GRAY)
		end
	end
	local nose = housing[1]
	part(
		"HousingNose",
		Vector3.new(nose.w * 2, nose.y - 2.38, 0.18),
		CFrame.new(0, (nose.y + 2.38) / 2, nose.z),
		LIGHT_GRAY,
		nil,
		true
	)
	part("ForedeckHatchRim", Vector3.new(2.5, 0.1, 2), CFrame.new(0, 4.32, -1), METAL)
	part("ForedeckHatch", Vector3.new(2.2, 0.12, 1.7), CFrame.new(0, 4.4, -1), DARK)
	-- Anchor gear sits on the narrow bow ahead of the housing.
	part("AnchorWindlass", Vector3.new(0.9, 0.5, 0.9), CFrame.new(0, 3.2, -17.8), DARK)
	part("WindlassDrum", Vector3.new(1.5, 0.3, 0.3), CFrame.new(0, 3.35, -17.8), METAL)
	part("BowCleat", Vector3.new(0.7, 0.15, 0.2), CFrame.new(0, 3.18, -20.3), METAL)
	-- Low bow rack follows the slope ahead of the cabin.
	for _, side in { -1, 1 } do
		beam("BowRackLeg", Vector3.new(side * 2.1, 4.3, -4), Vector3.new(side * 2.6, 5.5, 0.5), 0.12, 0.12, DARK)
	end
	for _, z in { -4, -1.75, 0.5 } do
		local alpha = (z + 4) / 4.5
		beam(
			"BowRackCrossbar",
			Vector3.new(-2.1 - alpha * 0.5, 4.3 + alpha * 1.2, z),
			Vector3.new(2.1 + alpha * 0.5, 4.3 + alpha * 1.2, z),
			0.12,
			0.12,
			DARK
		)
	end

	-- Rear wheelhouse: broad slanted windshield, side windows, open rear doorway.
	local windshieldTop = CABIN_FRONT + 0.85
	part("CabinFrontLower", Vector3.new(6.7, 2.9, 0.24), CFrame.new(0, 2.55, CABIN_FRONT), LIGHT_GRAY, nil, true)
	local pillars = {}
	for i = 0, 3 do
		pillars[i + 1] = windshieldTop + (CABIN_REAR - windshieldTop) * i / 3
	end
	for _, side in { -1, 1 } do
		part(
			"CabinSideLower",
			Vector3.new(0.24, 2.9, CABIN_REAR - CABIN_FRONT),
			CFrame.new(side * 3.35, 2.55, (CABIN_FRONT + CABIN_REAR) / 2),
			LIGHT_GRAY,
			nil,
			true
		)
		part(
			"CabinSideHeader",
			Vector3.new(0.28, 0.35, CABIN_REAR - windshieldTop),
			CFrame.new(side * 3.35, 6.3, (windshieldTop + CABIN_REAR) / 2),
			LIGHT_GRAY,
			nil,
			true
		)
		-- Closes the triangle between the raked windshield pillar and the side wall.
		local quarter = Instance.new("WedgePart")
		quarter.Size = Vector3.new(0.24, 2.1, windshieldTop - CABIN_FRONT)
		quarter.CFrame = frame * CFrame.new(side * 3.35, 5.1, (CABIN_FRONT + windshieldTop) / 2)
		finish(quarter, "CabinQuarterPanel", LIGHT_GRAY, nil, true)
		for i = 1, 3 do
			local window = part(
				"CabinSideWindow",
				Vector3.new(0.12, 2.1, pillars[i + 1] - pillars[i] - 0.24),
				CFrame.new(side * 3.35, 5.08, (pillars[i] + pillars[i + 1]) / 2),
				GLASS,
				nil,
				true
			)
			window.Transparency = 0.25
		end
		for _, z in pillars do
			part(
				"CabinWindowPillar",
				Vector3.new(0.28, 2.3, 0.22),
				CFrame.new(side * 3.35, 5.1, z),
				LIGHT_GRAY,
				nil,
				true
			)
		end
		part(
			"CabinRearWall",
			Vector3.new(1.95, 5.15, 0.24),
			CFrame.new(side * 2.425, 3.675, CABIN_REAR),
			LIGHT_GRAY,
			nil,
			true
		)
		local bottom, top =
			Vector3.new(side * 1.68, 4.05, CABIN_FRONT - 0.05), Vector3.new(side * 1.68, 6.15, windshieldTop)
		local window = beam("Windshield", bottom, top, 3.05, 0.12, GLASS, nil, true)
		window.Transparency = 0.22
		beam(
			"WindshieldPillar",
			Vector3.new(side * 3.3, 4.05, CABIN_FRONT - 0.05),
			Vector3.new(side * 3.3, 6.15, windshieldTop),
			0.25,
			0.25,
			LIGHT_GRAY,
			nil,
			true
		)
		beam(
			"RoofGrabRail",
			Vector3.new(side * 3.45, 6.9, windshieldTop + 0.6),
			Vector3.new(side * 3.45, 6.9, CABIN_REAR - 0.4),
			0.1,
			0.1,
			METAL
		)
		-- Running lights: red to port, green to starboard.
		local navLight = part(
			if side < 0 then "PortNavLight" else "StarboardNavLight",
			Vector3.new(0.14, 0.3, 0.5),
			CFrame.new(side * 3.5, 4.3, CABIN_FRONT + 0.5),
			if side < 0 then PORT_LAMP else STARBOARD_LAMP,
			Enum.Material.Neon
		)
		navLight.CastShadow = false
	end
	beam(
		"WindshieldMullion",
		Vector3.new(0, 4.05, CABIN_FRONT - 0.05),
		Vector3.new(0, 6.15, windshieldTop),
		0.22,
		0.22,
		LIGHT_GRAY,
		nil,
		true
	)
	part("RearDoorHeader", Vector3.new(2.9, 0.3, 0.26), CFrame.new(0, 6.25, CABIN_REAR), LIGHT_GRAY, nil, true)
	local roofFront, roofRear = windshieldTop - 0.45, CABIN_REAR + 0.6
	part(
		"CabinRoof",
		Vector3.new(7.35, 0.3, roofRear - roofFront),
		CFrame.new(0, 6.55, (roofFront + roofRear) / 2),
		HULL_GRAY,
		nil,
		true
	)
	part("RoofVent", Vector3.new(1.3, 0.65, 1.2), CFrame.new(0, 7.02, 9.4), DARK)
	part("VentCap", Vector3.new(1.7, 0.2, 1.6), CFrame.new(0, 7.45, 9.4), METAL)
	-- Patrol light bar across the windshield header.
	part("LightBar", Vector3.new(3.4, 0.24, 0.4), CFrame.new(0, 6.82, roofFront + 0.35), DARK)
	for _, side in { -1, 1 } do
		local strobe = part(
			"LightBarStrobe",
			Vector3.new(1.1, 0.2, 0.42),
			CFrame.new(side * 0.95, 6.98, roofFront + 0.35),
			STROBE,
			Enum.Material.Neon
		)
		strobe.CastShadow = false
	end
	part("SearchlightBase", Vector3.new(0.35, 0.2, 0.35), CFrame.new(-2.3, 6.8, roofFront + 0.9), DARK)
	part("Searchlight", Vector3.new(0.7, 0.5, 0.8), CFrame.new(-2.3, 7.15, roofFront + 0.9), METAL)
	local lens = part(
		"SearchlightLens",
		Vector3.new(0.55, 0.38, 0.06),
		CFrame.new(-2.3, 7.15, roofFront + 0.47),
		LAMP,
		Enum.Material.Neon
	)
	lens.CastShadow = false
	local searchlight = Instance.new("SpotLight")
	searchlight.Name = "SearchlightBeam"
	searchlight.Face = Enum.NormalId.Front
	searchlight.Color, searchlight.Range, searchlight.Brightness, searchlight.Angle = LAMP, 30, 0.45, 40
	searchlight.Shadows = false
	searchlight.Parent = lens
	-- Radar mast near the back of the roof, with whip antennas at the corners.
	local radarZ = CABIN_REAR - 1
	part("RadarMast", Vector3.new(0.3, 1.4, 0.3), CFrame.new(0, 7.4, radarZ), DARK)
	part("RadarPedestal", Vector3.new(0.7, 0.3, 0.7), CFrame.new(0, 8.1, radarZ), DARK)
	part("RadarArray", Vector3.new(3.4, 0.22, 0.4), CFrame.new(0, 8.36, radarZ), LIGHT_GRAY)
	local masthead =
		part("MastheadLight", Vector3.new(0.25, 0.25, 0.25), CFrame.new(0, 8.6, radarZ), LAMP, Enum.Material.Neon)
	masthead.CastShadow = false
	part("Antenna", Vector3.new(0.08, 2.7, 0.08), CFrame.new(-2.9, 8.05, CABIN_REAR), DARK)
	part("Antenna", Vector3.new(0.08, 2, 0.08), CFrame.new(2.9, 7.7, CABIN_REAR), DARK)

	-- The starboard helm is the only seat in the wheelhouse.
	local consoleZ = CABIN_FRONT + 1.8
	local seatZ = CABIN_FRONT + 4.1
	part("HelmConsole", Vector3.new(2.35, 1.1, 0.8), CFrame.new(1.3, 2.5, consoleZ), HULL_GRAY)
	part("InstrumentPanel", Vector3.new(2, 0.55, 0.12), CFrame.new(1.3, 3.17, consoleZ + 0.44), DARK)
	local wheelCenter = Vector3.new(1.3, 3.25, consoleZ + 0.8)
	for i = 0, 7 do
		local a, b = i * math.pi / 4, (i + 1) * math.pi / 4
		beam(
			"SteeringWheel",
			wheelCenter + Vector3.new(math.cos(a) * 0.44, math.sin(a) * 0.44, 0),
			wheelCenter + Vector3.new(math.cos(b) * 0.44, math.sin(b) * 0.44, 0),
			0.08,
			0.08,
			DARK
		)
	end
	part("HelmPedestal", Vector3.new(0.6, 0.8, 0.6), CFrame.new(1.3, 1.5, seatZ), METAL)
	part("HelmCushion", Vector3.new(1.9, 0.3, 1.5), CFrame.new(1.3, 2.05, seatZ), DARK)
	part("HelmBackrest", Vector3.new(1.9, 1.2, 0.22), CFrame.new(1.3, 2.7, seatZ + 0.7), DARK)
	local helm = Instance.new("VehicleSeat")
	helm.Size, helm.CFrame = Vector3.new(1.9, 0.24, 1.5), frame * CFrame.new(1.3, 2.2, seatZ)
	helm.Transparency, helm.HeadsUpDisplay = 1, false
	helm.MaxSpeed, helm.Torque, helm.TurnSpeed = 0, 0, 0
	finish(helm, "HelmSeat", DARK)
	helm.CanTouch, helm.Disabled = not isAnchored, isAnchored
	part("NavConsole", Vector3.new(1.7, 1.1, 0.8), CFrame.new(-2.15, 2.5, consoleZ), HULL_GRAY)
	part("ChartDisplay", Vector3.new(1.4, 0.5, 0.12), CFrame.new(-2.15, 3.17, consoleZ + 0.44), DARK)

	-- Open aft cockpit with forward-facing benches and a transom boarding gate.
	local benchZ = CABIN_REAR + 2.4
	for _, side in { -1, 1 } do
		-- Steps up from the side decks onto the raised foredeck.
		part(
			"ForedeckStep",
			Vector3.new(2, 0.6, 0.8),
			CFrame.new(side * 4.55, 1.45, CABIN_FRONT + 0.4),
			DECK,
			nil,
			true
		)
		part("SternSeatCushion", Vector3.new(2.2, 0.3, 1.7), CFrame.new(side * 3.1, 1.9, benchZ), DARK)
		part("SternSeatBack", Vector3.new(2.2, 1.1, 0.22), CFrame.new(side * 3.1, 2.6, benchZ + 0.75), HULL_GRAY)
		local seat = Instance.new("Seat")
		seat.Size, seat.CFrame = Vector3.new(2.2, 0.24, 1.7), frame * CFrame.new(side * 3.1, 2.05, benchZ)
		seat.Transparency = 1
		finish(seat, "PassengerSeat" .. (if side < 0 then "Port" else "Starboard"), DARK)
		seat.CanTouch, seat.Disabled = not isAnchored, isAnchored
		local points = {
			Vector3.new(side * 0.3, 4.2, -21.6),
			Vector3.new(side * 2.25, 3.95, -18.1),
			Vector3.new(side * 4.15, 3.7, -12.9),
			Vector3.new(side * 5.6, 3.45, -6),
			Vector3.new(side * 5.65, 3.4, CABIN_FRONT - 1),
		}
		for i, point in points do
			part("BowRailPost", Vector3.new(0.1, 0.85, 0.1), CFrame.new(point - Vector3.new(0, 0.425, 0)), METAL)
			if i > 1 then
				beam("BowRail", points[i - 1], point, 0.1, 0.1, METAL)
			end
		end
		local railFront, railRear = CABIN_REAR + 0.2, stern.z - 0.3
		for _, z in { railFront, (railFront + railRear) / 2, railRear } do
			part("SternRailPost", Vector3.new(0.12, 1.6, 0.12), CFrame.new(side * 5.15, 3.3, z), METAL)
		end
		beam(
			"SternRail",
			Vector3.new(side * 5.15, 4.1, railFront),
			Vector3.new(side * 5.15, 4.1, railRear),
			0.12,
			0.12,
			METAL
		)
		-- The transom rail leaves a center gate above the boarding step.
		beam(
			"TransomRail",
			Vector3.new(side * 5.15, 4.1, railRear),
			Vector3.new(side * 1.3, 4.1, railRear),
			0.12,
			0.12,
			METAL
		)
		part("TransomGatePost", Vector3.new(0.12, 1.6, 0.12), CFrame.new(side * 1.3, 3.3, railRear), METAL)
		part("SternCleat", Vector3.new(0.9, 0.15, 0.22), CFrame.new(side * 5.25, 2.62, stern.z - 0.9), METAL)
		part("MidshipCleat", Vector3.new(0.9, 0.15, 0.22), CFrame.new(side * 5.6, 2.72, 0), METAL)
		part("EngineVent", Vector3.new(0.15, 0.7, 2), CFrame.new(side * 5.55, 1.65, benchZ + 0.4), DARK)
	end
	local sternLight =
		part("SternLight", Vector3.new(0.3, 0.25, 0.3), CFrame.new(0, 2.72, stern.z - 0.1), LAMP, Enum.Material.Neon)
	sternLight.CastShadow = false
	for _, z in { stern.z - 2.6, stern.z - 1.5 } do
		part("CargoHatchRim", Vector3.new(3, 0.12, 0.9), CFrame.new(0, 1.16, z), METAL)
		part("CargoHatch", Vector3.new(2.8, 0.1, 0.7), CFrame.new(0, 1.27, z), HULL_GRAY)
	end
	for _, z in { 7, CABIN_REAR + 0.2 } do
		local deckLamp =
			part("DeckLightLens", Vector3.new(0.9, 0.14, 0.6), CFrame.new(0, 6.3, z), LAMP, Enum.Material.Neon)
		local deckLight = Instance.new("PointLight")
		deckLight.Name = "DeckLight"
		deckLight.Color, deckLight.Range, deckLight.Brightness = LAMP, 12, 0.3
		deckLight.Shadows = false
		deckLight.Parent = deckLamp
	end
	-- Bow lamps extend visibility beyond the long foredeck; the roof searchlight fills it in.
	for _, side in { -1, 1 } do
		part(
			"HeadlightStand",
			Vector3.new(0.18, 0.3, 0.18),
			CFrame.new(side * 1.4, 3.2, -18),
			METAL,
			Enum.Material.Metal
		)
		part(
			"HeadlightHousing",
			Vector3.new(0.75, 0.5, 0.65),
			CFrame.new(side * 1.4, 3.6, -18),
			DARK,
			Enum.Material.Metal
		)
		local bowLens = part(
			"HeadlightLens",
			Vector3.new(0.58, 0.34, 0.06),
			CFrame.new(side * 1.4, 3.6, -18.36),
			LAMP,
			Enum.Material.Neon
		)
		bowLens.CastShadow = false
		local headlight = Instance.new("SpotLight")
		headlight.Name = "Headlight"
		headlight.Face = Enum.NormalId.Front
		headlight.Color, headlight.Range, headlight.Brightness, headlight.Angle = LAMP, 30, 0.45, 40
		headlight.Shadows = false
		headlight.Parent = bowLens
	end
	return model
end

return PatrolBoat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="210">
        <Properties>
          <string name="Name">PirateCoveService</string>
          <string name="Source"><![CDATA[-- Pirate Cove's crew (Shared.PirateCove): quest givers, Gunner Flint who sells rods outright, and
-- Quartermaster Bess who buys fish from your hand and backpack, up to DAILY_SALES an in-game day.
-- The island is built by Map/PirateCove, possibly after this starts (distant generation runs once
-- the harbour is open), so the crew are placed once it exists. Talking happens on the client; every
-- action is checked here against the saved profile and the player standing beside that crew member.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BoatData = require(script.Parent.BoatData)
local BoatService = require(script.Parent.BoatService)
local Data = require(script.Parent.AnglerData)
local GuideCostume = require(script.Parent.GuideCostume)
local Catalog = require(ReplicatedStorage.Shared.AnglerCatalog)
local Cove = require(ReplicatedStorage.Shared.PirateCove)
local DayNight = require(ReplicatedStorage.Shared.DayNight)
local RodSkins = require(ReplicatedStorage.Shared.RodSkins)

local Service = {}
local started = false

local PROMPT = "PirateCoveNpcPrompt"
-- The client tutorial turns anything with this tag towards a player who walks up.
local TURN_TAG = "TutorialGuide"

local state: Folder
local crew: Folder
local positions: { [string]: Vector3 } = {}
local busy: { [Player]: boolean } = {}
local lastRequest: { [Player]: number } = {}

local function today(): number
	return Cove.day(DayNight.elapsed())
end

local function rarityOf(fishId: string): string?
	local fish = Catalog.Fish[fishId]
	return fish and fish.Rarity
end

local function fishName(fishId: string?): string?
	local fish = fishId and Catalog.Fish[fishId]
	return fish and fish.Name
end

----------------------------------------------------------------------------------------------------
-- Placing the crew

local function waitForIsland(): Model
	while true do
		local map = workspace:FindFirstChild("Map")
		local island = map and map:FindFirstChild(Cove.NAME)
		if island and island:IsA("Model") and island:GetAttribute("Plaza") then
			return island
		end
		task.wait(2)
	end
end

-- Feet frame for a crew member: a named anchor the island set, or an island-local spot dropped
-- onto the ground and turned towards its Face point (or the plaza).
local function placement(island: Model, npc): CFrame?
	local plaza = island:GetAttribute("Plaza")
	if type(npc.Spot) == "string" then
		local anchor = island:GetAttribute("Anchor_" .. npc.Spot)
		return if typeof(anchor) == "CFrame" then anchor else nil
	end
	local center = Vector3.new(Cove.CENTER[1], 0, Cove.CENTER[2])
	local spot = center + Vector3.new(npc.Spot[1], 0, npc.Spot[2])
	local rays = RaycastParams.new()
	rays.FilterType = Enum.RaycastFilterType.Include
	rays.FilterDescendantsInstances = { island }
	local hit = workspace:Raycast(spot + Vector3.new(0, 200, 0), Vector3.new(0, -260, 0), rays)
	local feet = if hit then hit.Position else spot + Vector3.new(0, 12, 0)
	local look = if type(npc.Face) == "table"
		then center + Vector3.new(npc.Face[1], 0, npc.Face[2])
		elseif typeof(plaza) == "Vector3" then plaza
		else center
	local flat = Vector3.new(look.X, feet.Y, look.Z)
	if (flat - feet).Magnitude < 0.1 then
		return CFrame.new(feet)
	end
	return CFrame.lookAt(feet, flat)
end

local function talkPrompt(head: BasePart, id: string, npc)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = PROMPT
	prompt.ActionText = if npc.Kind == "Shop" then "Buy rods" elseif npc.Kind == "Buyer" then "Sell fish" else "Talk"
	prompt.ObjectText = npc.Name .. " · " .. npc.Title
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.HoldDuration = 0
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.UIOffset = Vector2.new(0, -30)
	prompt:SetAttribute("NpcId", id)
	prompt.Parent = head
end

local function placeCrew()
	local island = waitForIsland()
	for _, id in Cove.Order do
		local npc = Cove.Npcs[id]
		local frame = placement(island, npc)
		if not frame then
			warn("[PirateCove] No place for " .. npc.Name)
			continue
		end
		positions[id] = frame.Position
		state:SetAttribute("Npc_" .. id, frame.Position)
		task.spawn(function()
			local model = GuideCostume.spawn(id, npc.Outfit, npc.Name .. " · " .. npc.Title, frame, crew)
			if not model then
				return
			end
			model:AddTag(TURN_TAG)
			local head = model:FindFirstChild("Head")
			if head and head:IsA("BasePart") then
				talkPrompt(head, id, npc)
			end
		end)
	end
end

----------------------------------------------------------------------------------------------------
-- What the client shows

local function questState(angler, id: string)
	local saved = angler.CoveQuests[id] or { Step = 1 }
	local quest = Cove.quest(id, saved.Step)
	if not quest then
		return { Step = saved.Step, Finished = true }
	end
	local caught = if saved.Accepted and saved.Base then angler.Stats.TotalCaught - saved.Base else 0
	local ready = false
	if saved.Accepted then
		if quest.Kind == "Catch" then
			ready = caught >= quest.Count
		else
			ready = Data.deliverFish(angler, function(record)
				return Cove.accepts(quest, record, rarityOf)
			end) ~= nil
		end
	end
	return {
		Step = saved.Step,
		Accepted = saved.Accepted == true,
		Ready = ready,
		Goal = Cove.goal(quest, caught, fishName(quest.FishId)),
	}
end

local function view(player: Player, id: string)
	local profile = BoatService.getProfile(player)
	local npc = Cove.Npcs[id]
	if not profile or not npc then
		return nil
	end
	local angler = profile.Angler
	if npc.Kind == "Buyer" then
		local backpack = 0
		for _, item in angler.Backpack do
			if item.Fish and not item.Locked then
				backpack += 1
			end
		end
		return {
			SalesLeft = Cove.salesLeft(angler.CoveSales, today()),
			Holding = angler.Hand ~= nil,
			Backpack = backpack,
		}
	elseif npc.Kind == "Shop" then
		return { Owned = table.clone(profile.RodSkins or {}), Cash = profile.Cash }
	end
	return questState(angler, id)
end

----------------------------------------------------------------------------------------------------
-- Actions

local function near(player: Player, id: string): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local position = positions[id]
	return position ~= nil
		and humanoid ~= nil
		and humanoid.Health > 0
		and root ~= nil
		and root:IsA("BasePart")
		and (root.Position - position).Magnitude <= Cove.TALK_RANGE
end

local function accept(player: Player, id: string): (boolean, string)
	local profile = BoatService.getProfile(player)
	local saved = profile and profile.Angler.CoveQuests[id]
	local quest = Cove.quest(id, saved and saved.Step)
	if not quest then
		return false, "There's nothing more to do here."
	elseif saved and saved.Accepted then
		return true, quest.Title
	end
	local ok, message = BoatService.updateProgress(player, function(current)
		local angler = current.Angler
		local entry = angler.CoveQuests[id] or { Step = 1 }
		entry.Accepted = true
		entry.Base = angler.Stats.TotalCaught
		angler.CoveQuests[id] = entry
	end)
	return ok, if ok then "Quest accepted: " .. quest.Title else message
end

local function claim(player: Player, id: string): (boolean, string)
	local profile = BoatService.getProfile(player)
	if not profile then
		return false, "Your progress is still loading."
	end
	local saved = profile.Angler.CoveQuests[id]
	local step = saved and saved.Step or 1
	local quest = Cove.quest(id, step)
	if not quest or not (saved and saved.Accepted) then
		return false, "Accept the quest first."
	end
	local function matches(record)
		return Cove.accepts(quest, record, rarityOf)
	end
	if quest.Kind == "Catch" then
		if profile.Angler.Stats.TotalCaught - (saved.Base or 0) < quest.Count then
			return false, "You haven't caught enough fish yet."
		end
	elseif not Data.deliverFish(profile.Angler, matches) then
		return false, "You don't have the right fish. Locked fish stay in your backpack."
	end
	local ok, message = BoatService.updateProgress(player, function(current)
		local angler = current.Angler
		local entry = angler.CoveQuests[id]
		-- UpdateAsync may retry; check the stored profile every time.
		assert(entry and entry.Step == step and entry.Accepted, "Quest changed")
		if quest.Kind == "Catch" then
			assert(angler.Stats.TotalCaught - (entry.Base or 0) >= quest.Count, "Not enough fish caught")
		else
			local updated = Data.deliverFish(angler, matches)
			assert(updated, "The fish is gone")
			angler = updated
			current.Angler = angler
		end
		angler.CoveQuests[id] = { Step = step + 1 }
		current.Cash += quest.Cash
		angler.Stats.CoinsEarned += quest.Cash
		angler.Stats.TotalXP += quest.XP
	end)
	if not ok then
		return false, message
	end
	return true, string.format("%s complete! +$%d · +%d XP", quest.Title, quest.Cash, quest.XP)
end

local function sell(player: Player, onlyHand: boolean): (boolean, string)
	local profile = BoatService.getProfile(player)
	if not profile then
		return false, "Your progress is still loading."
	end
	local day = today()
	if Cove.salesLeft(profile.Angler.CoveSales, day) <= 0 then
		return false, "Sorry, love - we've got enough fish to feed the whole cove today. Come back tomorrow!"
	end
	local _, preview = Data.sellToCove(profile.Angler, day, Cove.DAILY_SALES, onlyHand)
	if preview == 0 then
		return false, if onlyHand then "You're not holding a fish." else "You've no fish to sell. Locked fish stay put."
	end
	local sold, earned = 0, 0
	local ok, message = BoatService.updateProgress(player, function(current)
		local updated
		updated, sold, earned = Data.sellToCove(current.Angler, day, Cove.DAILY_SALES, onlyHand)
		current.Angler = updated
		current.Cash += earned
	end)
	if not ok then
		return false, message
	end
	local left = Cove.DAILY_SALES
		- ((BoatService.getProfile(player) or profile).Angler.CoveSales or { Count = 0 }).Count
	return true,
		string.format(
			"Sold %d fish for $%d. %s",
			sold,
			earned,
			if left > 0 then string.format("I'll take %d more today.", left) else "That's all the cove needs today!"
		)
end

local function buyRod(player: Player, skinId: any): (boolean, string)
	local offer
	for _, rod in Cove.Rods do
		if rod.SkinId == skinId then
			offer = rod
		end
	end
	if not offer then
		return false, "Flint doesn't sell that rod."
	end
	local profile = BoatService.getProfile(player)
	if not profile then
		return false, "Your wallet is still loading."
	end
	local preview = BoatData.buyRodSkin(profile, offer.SkinId, offer.Price, Cove.ROD_WEAR)
	if preview == "InsufficientFunds" then
		return false, string.format("You need $%d for the %s.", offer.Price, RodSkins.Skins[offer.SkinId].Name)
	elseif preview ~= "Purchased" then
		return false, "Your rod is still loading. Try again in a moment."
	end
	local ok, message = BoatService.updateProgress(player, function(current, serial)
		local result = BoatData.buyRodSkin(current, offer.SkinId, offer.Price, Cove.ROD_WEAR, serial)
		assert(result == "Purchased", result)
	end, offer.SkinId)
	if not ok then
		return false, message
	end
	return true, "You bought the " .. RodSkins.Skins[offer.SkinId].Name .. "! Equip it from your Equipment Bag."
end

function Service.start()
	if started then
		return
	end
	started = true
	state = Instance.new("Folder")
	state.Name = "PirateCove"
	local remote = Instance.new("RemoteFunction")
	remote.Name = "Request"
	remote.Parent = state
	state.Parent = ReplicatedStorage
	crew = Instance.new("Folder")
	crew.Name = "PirateCoveCrew"
	crew.Parent = workspace

	remote.OnServerInvoke = function(player, action, id, value)
		if type(id) ~= "string" or not Cove.Npcs[id] then
			return { Ok = false, Message = "Nobody here by that name." }
		end
		if action == "Get" then
			return { Ok = true, State = view(player, id) }
		end
		if os.clock() - (lastRequest[player] or -math.huge) < 0.3 or busy[player] then
			return { Ok = false, Message = "One moment...", State = view(player, id) }
		end
		lastRequest[player] = os.clock()
		if not near(player, id) then
			return { Ok = false, Message = "Walk up to " .. Cove.Npcs[id].Name .. " first.", State = view(player, id) }
		end
		local kind = Cove.Npcs[id].Kind
		busy[player] = true
		local ok, outcome = pcall(function()
			if kind == "Quests" and action == "Accept" then
				return table.pack(accept(player, id))
			elseif kind == "Quests" and action == "Claim" then
				return table.pack(claim(player, id))
			elseif kind == "Buyer" and (action == "SellHand" or action == "SellAll") then
				return table.pack(sell(player, action == "SellHand"))
			elseif kind == "Shop" and action == "BuyRod" then
				return table.pack(buyRod(player, value))
			end
			return table.pack(false, "That isn't something they can help with.")
		end)
		busy[player] = nil
		if not ok then
			warn("[PirateCove] " .. tostring(outcome))
			return { Ok = false, Message = "Something went wrong. Try again in a moment.", State = view(player, id) }
		end
		return { Ok = outcome[1], Message = outcome[2], State = view(player, id) }
	end

	Players.PlayerRemoving:Connect(function(player)
		busy[player], lastRequest[player] = nil, nil
	end)
	task.spawn(placeCrew)
end

return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="211">
        <Properties>
          <string name="Name">RacingSpeedboat</string>
          <string name="Source"><![CDATA[-- Long, low white racing launch with a charcoal cockpit and stern outboard. Waterline origin; local -Z is the bow.
-- The faceted V hull and cockpit sole form one welded, server-driven assembly.
local RacingSpeedboat = { VERSION = 3 }
local WHITE = Color3.fromRGB(237, 241, 246)
local UNDERBODY = Color3.fromRGB(205, 213, 220)
local DECK = Color3.fromRGB(55, 59, 65)
local DARK = Color3.fromRGB(27, 31, 37)
local UPHOLSTERY = Color3.fromRGB(48, 53, 60)
local STITCH = Color3.fromRGB(97, 104, 111)
local GLASS = Color3.fromRGB(62, 83, 99)
local METAL = Color3.fromRGB(122, 139, 151)
local THICKNESS = 0.18
-- Scale the whole ship around the waterline so previews and launched boats
-- keep the same draft and line up with the drydock cradle.
local SCALE = 1.2

function RacingSpeedboat.build(frame: CFrame, anchored: boolean?): Model
	local isAnchored = anchored == true
	local model = Instance.new("Model")
	model.Name = "RacingSpeedboat"
	model:SetAttribute("ModelVersion", RacingSpeedboat.VERSION)
	model:SetAttribute("HullLength", 30 * SCALE)
	model:SetAttribute("HullBeam", 8 * SCALE)
	model:SetAttribute("PassengerSeats", 3)
	model:SetAttribute("DriverSeat", "HelmSeat")
	model:SetAttribute("DryFloorHeight", 1.1 * SCALE)
	model:SetAttribute("DryFloorHalfBeam", 3.5 * SCALE)
	model:SetAttribute("DryFloorHalfLength", 12.4 * SCALE)

	local function scaledFrame(localFrame: CFrame): CFrame
		return frame
			* CFrame.fromMatrix(
				localFrame.Position * SCALE,
				localFrame.RightVector,
				localFrame.UpVector,
				localFrame.ZVector
			)
	end

	local root = Instance.new("Part")
	root.Name = "HullRoot"
	root.Size = Vector3.new(5.6, 0.5, 18) * SCALE
	root.CFrame = scaledFrame(CFrame.new(0, -0.4, 0))
	root.Transparency = 1
	root.Anchored = isAnchored
	root.CanCollide = false
	root.CanTouch = false
	root.RootPriority = 127
	root.CustomPhysicalProperties = PhysicalProperties.new(1.4, 0.45, 0.05, 100, 100)
	root.Parent = model
	model.PrimaryPart = root

	local function finish(p: BasePart, name: string, color: Color3, material: Enum.Material?, collide: boolean?)
		p.Size *= SCALE
		p.CFrame = scaledFrame(frame:ToObjectSpace(p.CFrame))
		p.Name = name
		p.Anchored = isAnchored
		p.CanCollide = collide == true
		p.CanTouch = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.Massless = true
		p.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = p
		weld.Parent = p
		return p
	end

	local function part(
		name: string,
		size: Vector3,
		localFrame: CFrame,
		color: Color3,
		material: Enum.Material?,
		collide: boolean?
	): Part
		local p = Instance.new("Part")
		p.Size = size
		p.CFrame = frame * localFrame
		finish(p, name, color, material, collide)
		return p
	end

	local function beam(
		name: string,
		a: Vector3,
		b: Vector3,
		width: number,
		depth: number,
		color: Color3,
		material: Enum.Material?,
		collide: boolean?
	): Part
		return part(
			name,
			Vector3.new(width, depth, (b - a).Magnitude),
			CFrame.lookAt((a + b) / 2, b),
			color,
			material,
			collide
		)
	end

	-- Thin facets form an open hull; there is no solid collision box through it.
	local function triangle(
		name: string,
		a: Vector3,
		b: Vector3,
		c: Vector3,
		inside: Vector3,
		color: Color3,
		collide: boolean?,
		transparency: number?
	)
		local ab, ac, bc = b - a, c - a, c - b
		local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
		if abd > acd and abd > bcd then
			c, a = a, c
		elseif acd > bcd and acd > abd then
			a, b = b, a
		end
		ab, ac, bc = b - a, c - a, c - b
		local right = ac:Cross(ab).Unit
		local up = bc:Cross(right).Unit
		local back = bc.Unit
		local height = math.abs(ab:Dot(up))
		local normal = if right:Dot((a + b + c) / 3 - inside) >= 0 then right else -right
		local shift = -normal * THICKNESS / 2
		local first = Instance.new("WedgePart")
		first.Size = Vector3.new(THICKNESS, height, math.abs(ab:Dot(back)))
		first.CFrame = frame * CFrame.fromMatrix((a + b) / 2 + shift, right, up, back)
		finish(first, name, color, nil, collide ~= false)
		first.Transparency = transparency or 0
		local second = Instance.new("WedgePart")
		second.Size = Vector3.new(THICKNESS, height, math.abs(ac:Dot(back)))
		second.CFrame = frame * CFrame.fromMatrix((a + c) / 2 + shift, -right, up, -back)
		finish(second, name, color, nil, collide ~= false)
		second.Transparency = transparency or 0
	end

	local stations = {
		{ z = -13.8, width = 0.12, bottom = 0.08, top = 2.2, keel = 0.05 },
		{ z = -12, width = 1.24, bottom = 0.66, top = 2.14, keel = -0.54 },
		{ z = -9.2, width = 2.55, bottom = 1.8, top = 2.02, keel = -1.05 },
		{ z = -5.7, width = 3.48, bottom = 2.9, top = 1.9, keel = -1.22 },
		{ z = -2.4, width = 3.88, bottom = 3.28, top = 1.82, keel = -1.28 },
		{ z = 3.7, width = 3.9, bottom = 3.32, top = 1.8, keel = -1.25 },
		{ z = 9, width = 3.77, bottom = 3.25, top = 1.84, keel = -1.1 },
		{ z = 12.4, width = 3.45, bottom = 2.85, top = 1.9, keel = -0.85 },
	}
	local function hullPoint(station, side: number, level: number): Vector3
		local bottomY = if station.z < -13 then 0.25 else -0.72
		return Vector3.new(
			side * (station.bottom + (station.width - station.bottom) * level),
			bottomY + (station.top - bottomY) * level,
			station.z
		)
	end
	-- Each cross-section curves inward through the bilge to the center keel.
	-- These panels close the underside all the way from bow to transom.
	local function bottomPoint(station, side: number, level: number): Vector3
		if level == 0 then
			return hullPoint(station, side, 0)
		elseif level == 1 then
			local edge = hullPoint(station, side, 0)
			return Vector3.new(side * station.bottom * 0.52, station.keel + (edge.Y - station.keel) * 0.42, station.z)
		end
		return Vector3.new(0, station.keel, station.z)
	end
	for _, side in { -1, 1 } do
		for i = 1, #stations - 1 do
			local from, to = stations[i], stations[i + 1]
			local inside = Vector3.new(0, 0.6, (from.z + to.z) / 2)
			local a, b = hullPoint(from, side, 0), hullPoint(to, side, 0)
			local c, d = hullPoint(to, side, 1), hullPoint(from, side, 1)
			triangle("HullPanel", a, b, c, inside, WHITE)
			triangle("HullPanel", a, c, d, inside, WHITE)
			-- A fine stripe follows the actual sheer instead of widening toward the bow.
			local offset = Vector3.new(side * 0.018, 0, 0)
			a, b = hullPoint(from, side, 0.62) + offset, hullPoint(to, side, 0.62) + offset
			c, d = hullPoint(to, side, 0.70) + offset, hullPoint(from, side, 0.70) + offset
			triangle("HullStripe", a, b, c, inside, DARK, false)
			triangle("HullStripe", a, c, d, inside, DARK, false)
			for band = 0, 1 do
				local a, b = bottomPoint(from, side, band), bottomPoint(to, side, band)
				local c, d = bottomPoint(to, side, band + 1), bottomPoint(from, side, band + 1)
				local inside = Vector3.new(0, 0.8, (from.z + to.z) / 2)
				local name = if band == 0 then "BilgePanel" else "BottomPanel"
				triangle(name, a, b, c, inside, UNDERBODY)
				triangle(name, a, c, d, inside, UNDERBODY)
			end
			beam("Gunwale", hullPoint(from, side, 1), hullPoint(to, side, 1), 0.23, 0.16, WHITE)
			local rub = Vector3.new(side * 0.04, -0.11, 0)
			beam("RubRail", hullPoint(from, side, 1) + rub, hullPoint(to, side, 1) + rub, 0.09, 0.08, DARK)
		end
	end
	for _, station in { stations[1], stations[#stations] } do
		local center = Vector3.new(0, hullPoint(station, 1, 0).Y, station.z)
		local inside = Vector3.new(0, 0.8, 0)
		for _, side in { -1, 1 } do
			local edge, bilge, keel =
				bottomPoint(station, side, 0), bottomPoint(station, side, 1), bottomPoint(station, side, 2)
			triangle("HullEndCap", edge, bilge, keel, inside, UNDERBODY)
			triangle("HullEndCap", edge, keel, center, inside, UNDERBODY)
		end
		if station == stations[1] then
			local left, right = hullPoint(station, -1, 1), hullPoint(station, 1, 1)
			triangle("BowCap", center, left, right, inside, UNDERBODY)
			triangle("BowCap", center, hullPoint(station, -1, 0), left, inside, UNDERBODY)
			triangle("BowCap", center, right, hullPoint(station, 1, 0), inside, UNDERBODY)
		end
	end
	local stern = stations[#stations]
	local sternLeft, sternRight = hullPoint(stern, -1, 0), hullPoint(stern, 1, 0)
	triangle("Transom", sternLeft, sternRight, hullPoint(stern, 1, 1), Vector3.new(0, 0.8, 0), WHITE)
	triangle("Transom", sternLeft, hullPoint(stern, 1, 1), hullPoint(stern, -1, 1), Vector3.new(0, 0.8, 0), WHITE)
	part("TransomTrim", Vector3.new(7.1, 0.5, 0.23), CFrame.new(0, 1.63, 12.4), WHITE)
	part("TransomCap", Vector3.new(7.2, 0.2, 0.3), CFrame.new(0, 1.9, 12.4), WHITE)
	for index = 1, #stations - 1 do
		beam(
			"Keel",
			bottomPoint(stations[index], 1, 2),
			bottomPoint(stations[index + 1], 1, 2),
			0.18,
			0.16,
			UNDERBODY,
			nil,
			true
		)
	end
	part("BowStem", Vector3.new(0.16, 1.95, 0.16), CFrame.new(0, 1.2, -13.8), WHITE)

	-- Continuous planks provide a working bow deck and two clear side walkways.
	local function deckWidth(station): number
		local bottomY = if station.z < -13 then 0.25 else -0.72
		local level = (1.1 - bottomY) / (station.top - bottomY)
		return math.max(0, station.bottom + (station.width - station.bottom) * level - 0.15)
	end
	for i = -6, 6 do
		local outside = (math.abs(i) + 0.5) * 0.55
		local startZ, endZ = stations[1].z, stations[#stations].z - 0.15
		for index = 1, #stations - 1 do
			local a, b = stations[index], stations[index + 1]
			local fromWidth, toWidth = deckWidth(a), deckWidth(b)
			if fromWidth < outside and toWidth >= outside then
				startZ = a.z + (b.z - a.z) * (outside - fromWidth) / (toWidth - fromWidth)
			elseif fromWidth >= outside and toWidth < outside then
				endZ = a.z + (b.z - a.z) * (outside - fromWidth) / (toWidth - fromWidth)
			end
		end
		part(
			"WorkingDeck",
			Vector3.new(0.55, 0.22, endZ - startZ),
			CFrame.new(i * 0.55, 0.99, (startZ + endZ) / 2),
			DECK,
			Enum.Material.SmoothPlastic,
			true
		)
	end

	local function quad(
		name: string,
		a: Vector3,
		b: Vector3,
		c: Vector3,
		d: Vector3,
		color: Color3,
		collide: boolean?,
		transparency: number?
	)
		local inside = (a + b + c + d) / 4 - Vector3.new(0, 1, 0)
		triangle(name, a, b, c, inside, color, collide, transparency)
		triangle(name, a, c, d, inside, color, collide, transparency)
	end
	local function stationAt(z: number)
		for index = 1, #stations - 1 do
			local a, b = stations[index], stations[index + 1]
			if z <= b.z then
				local t = math.clamp((z - a.z) / (b.z - a.z), 0, 1)
				return a.width + (b.width - a.width) * t, a.top + (b.top - a.top) * t
			end
		end
		return stations[#stations].width, stations[#stations].top
	end
	local function deckPoint(z: number, fraction: number): Vector3
		local width, top = stationAt(z)
		local x = width * math.abs(fraction)
		local crown = 0
		for index = 1, #stations - 1 do
			local a, b = stations[index], stations[index + 1]
			if z <= b.z then
				local t = math.clamp((z - a.z) / (b.z - a.z), 0, 1)
				-- Match the two actual deck triangles so trim cannot sink into their diagonal.
				crown = if x <= t * b.width then 1 - x / b.width else 1 - t - (x - t * b.width) / a.width
				break
			end
		end
		return Vector3.new(width * fraction, top - 0.045 + crown * 0.12, z)
	end
	-- Crown the foredeck across its beam and follow the curved sheer to the bow.
	for index = 1, 4 do
		local a, b = stations[index].z, stations[index + 1].z
		for _, side in { -1, 1 } do
			quad("Foredeck", deckPoint(a, 0), deckPoint(a, side), deckPoint(b, side), deckPoint(b, 0), WHITE)
		end
	end
	for _, side in { -1, 1 } do
		for _, range in { { -12, -9.2 }, { -9.2, -5.7 }, { -5.7, -3.8 } } do
			local cuts = { range[1], range[2] }
			for index = 1, #stations - 1 do
				local a, b = stations[index], stations[index + 1]
				if range[1] >= a.z and range[1] < b.z then
					for _, fraction in { 0.60, 0.66 } do
						local t = fraction * a.width / (b.width * (1 - fraction) + fraction * a.width)
						local z = a.z + (b.z - a.z) * t
						if z > range[1] and z < range[2] then
							table.insert(cuts, z)
						end
					end
					break
				end
			end
			table.sort(cuts)
			for index = 1, #cuts - 1 do
				local a, b = cuts[index], cuts[index + 1]
				local lift = Vector3.new(0, 0.018, 0)
				quad(
					"BowAccent",
					deckPoint(a, side * 0.60) + lift,
					deckPoint(a, side * 0.66) + lift,
					deckPoint(b, side * 0.66) + lift,
					deckPoint(b, side * 0.60) + lift,
					DARK,
					false
				)
			end
		end
		-- Fitted white side decks hide the hull edges around a recessed dark cockpit.
		for _, range in { { -2.4, 3.7 }, { 3.7, 6.7 } } do
			local a, b = range[1], range[2]
			local wa, ya = stationAt(a)
			local wb, yb = stationAt(b)
			quad(
				"CockpitCoaming",
				Vector3.new(side * 3.03, ya, a),
				Vector3.new(side * wa, ya, a),
				Vector3.new(side * wb, yb, b),
				Vector3.new(side * 3.03, yb, b),
				WHITE
			)
		end
		part("CockpitLiner", Vector3.new(0.12, 0.60, 8.6), CFrame.new(side * 3.04, 1.47, 2.1), DARK)
		part("CockpitTrim", Vector3.new(0.10, 0.10, 8.7), CFrame.new(side * 3.04, 1.86, 2.1), UPHOLSTERY)
		part("CockpitArmrest", Vector3.new(0.22, 0.15, 2), CFrame.new(side * 2.91, 1.68, 2.1), UPHOLSTERY)
	end
	-- Continuous stern deck fits the tapered transom; the sunpad sits in a white surround.
	for _, range in { { 6.7, 9 }, { 9, 12.4 } } do
		local a, b = range[1], range[2]
		for _, side in { -1, 1 } do
			quad("SternDeck", deckPoint(a, 0), deckPoint(a, side), deckPoint(b, side), deckPoint(b, 0), WHITE)
		end
	end
	part("SunpadRecess", Vector3.new(5.45, 0.12, 4.75), CFrame.new(0, 1.99, 9.35), DARK)
	for index = -1, 1 do
		part("SternSunpad", Vector3.new(1.72, 0.19, 4.53), CFrame.new(index * 1.78, 2.12, 9.35), UPHOLSTERY)
		part("SunpadPiping", Vector3.new(1.60, 0.025, 0.035), CFrame.new(index * 1.78, 2.22, 7.25), STITCH)
	end
	part("RearCockpitBulkhead", Vector3.new(5.95, 0.62, 0.16), CFrame.new(0, 1.42, 6.65), DARK)
	part("RearGrabRail", Vector3.new(3.2, 0.09, 0.09), CFrame.new(0, 1.87, 6.54), METAL)

	-- Two swept front panes and triangular quarter windows form a low wraparound screen.
	local lower = { Vector3.new(-3.02, 1.96, -2.1), Vector3.new(0, 2.04, -2.72), Vector3.new(3.02, 1.96, -2.1) }
	local upper = { Vector3.new(-2.66, 3.06, -0.9), Vector3.new(0, 3.16, -1.52), Vector3.new(2.66, 3.06, -0.9) }
	for index = 1, 2 do
		quad("Windshield", lower[index], lower[index + 1], upper[index + 1], upper[index], GLASS, false, 0.28)
		beam("WindshieldHeader", upper[index], upper[index + 1], 0.08, 0.08, DARK)
		beam("WindshieldSill", lower[index], lower[index + 1], 0.13, 0.13, DARK)
	end
	beam("WindshieldMullion", lower[2], upper[2], 0.075, 0.075, DARK)
	for _, index in { 1, 3 } do
		local side = if index == 1 then -1 else 1
		local rear = Vector3.new(side * 2.98, 1.88, 1.40)
		triangle("SideWindow", lower[index], upper[index], rear, Vector3.new(0, 1.9, 0), GLASS, false, 0.30)
		beam("WindowFrame", upper[index], rear, 0.08, 0.08, DARK)
		beam("WindshieldPillar", lower[index], upper[index], 0.10, 0.10, DARK)
	end
	local passengerIndex = 0
	for row, z in { 0.7, 4.6 } do
		for _, side in { -1, 1 } do
			local x = side * 1.49
			part("BucketPedestal", Vector3.new(0.55, 0.31, 0.55), CFrame.new(x, 1.26, z), METAL)
			part("BucketShell", Vector3.new(2.10, 0.24, 1.88), CFrame.new(x, 1.48, z + 0.05), DARK)
			part("BucketCushion", Vector3.new(1.63, 0.26, 1.54), CFrame.new(x, 1.68, z - 0.06), UPHOLSTERY)
			part(
				"BucketBackrest",
				Vector3.new(1.98, 1.34, 0.28),
				CFrame.new(x, 2.12, z + 0.78) * CFrame.Angles(math.rad(12), 0, 0),
				DARK
			)
			part(
				"BucketBackPad",
				Vector3.new(1.52, 1.09, 0.19),
				CFrame.new(x, 2.15, z + 0.59) * CFrame.Angles(math.rad(12), 0, 0),
				UPHOLSTERY
			)
			part("BucketHeadrest", Vector3.new(1.16, 0.28, 0.34), CFrame.new(x, 2.81, z + 0.88), UPHOLSTERY)
			for _, edge in { -1, 1 } do
				part("BucketBolster", Vector3.new(0.22, 0.40, 1.60), CFrame.new(x + edge * 0.91, 1.78, z), DARK)
				part("SeatPiping", Vector3.new(0.025, 0.025, 1.37), CFrame.new(x + edge * 0.71, 1.82, z - 0.05), STITCH)
			end
			local driver = row == 1 and side == 1
			local seat = Instance.new(if driver then "VehicleSeat" else "Seat")
			seat.Size = Vector3.new(1.65, 0.24, 1.5)
			seat.CFrame = frame * CFrame.new(x, 1.87, z)
			seat.Transparency = 1
			if driver then
				seat.HeadsUpDisplay = false
				seat.MaxSpeed, seat.Torque, seat.TurnSpeed = 0, 0, 0
			else
				passengerIndex += 1
			end
			finish(seat, if driver then "HelmSeat" else "PassengerSeat" .. passengerIndex, DARK)
			seat.CanTouch, seat.Disabled = not isAnchored, isAnchored
		end
	end
	-- Sloping dashboard, individual instruments, throttle and three-spoke wheel.
	part("HelmConsole", Vector3.new(2.38, 0.67, 0.80), CFrame.new(1.49, 1.65, -1.30), WHITE)
	part(
		"InstrumentPanel",
		Vector3.new(2.13, 0.53, 0.12),
		CFrame.new(1.49, 2.10, -1.04) * CFrame.Angles(math.rad(18), 0, 0),
		DARK
	)
	for index, x in { 0.86, 1.49, 2.12 } do
		local radius = if index == 2 then 0.28 else 0.21
		local gauge = part(
			"GaugeRim",
			Vector3.new(0.05, radius, radius),
			CFrame.new(x, 2.12, -0.94) * CFrame.Angles(0, math.pi / 2, 0),
			METAL
		)
		gauge.Shape = Enum.PartType.Cylinder
		local dial = part(
			"GaugeFace",
			Vector3.new(0.06, radius * 0.78, radius * 0.78),
			CFrame.new(x, 2.12, -0.90) * CFrame.Angles(0, math.pi / 2, 0),
			DARK
		)
		dial.Shape = Enum.PartType.Cylinder
		beam("GaugeNeedle", Vector3.new(x, 2.12, -0.86), Vector3.new(x + 0.05, 2.19, -0.86), 0.018, 0.018, WHITE)
	end
	part("ThrottleBase", Vector3.new(0.21, 0.32, 0.55), CFrame.new(2.79, 1.70, 0.15), DARK)
	beam("ThrottleLever", Vector3.new(2.79, 1.84, 0.15), Vector3.new(2.79, 2.12, 0.02), 0.06, 0.06, METAL)
	part("ThrottleGrip", Vector3.new(0.16, 0.14, 0.16), CFrame.new(2.79, 2.13, 0.02), DARK)
	local wheelCenter = Vector3.new(1.49, 2.36, -0.37)
	for index = 0, 11 do
		local a, b = index * math.pi / 6, (index + 1) * math.pi / 6
		beam(
			"SteeringWheel",
			wheelCenter + Vector3.new(math.cos(a) * 0.39, math.sin(a) * 0.39, 0),
			wheelCenter + Vector3.new(math.cos(b) * 0.39, math.sin(b) * 0.39, 0),
			0.065,
			0.065,
			DARK
		)
	end
	for index = 0, 2 do
		local a = index * math.pi * 2 / 3
		beam(
			"WheelSpoke",
			wheelCenter,
			wheelCenter + Vector3.new(math.cos(a) * 0.35, math.sin(a) * 0.35, 0),
			0.045,
			0.045,
			METAL
		)
	end

	-- Sculpted outboard cowling, vents, mounting bracket and submerged lower unit.
	part("MotorMount", Vector3.new(1.50, 0.42, 0.80), CFrame.new(0, 1.05, 12.65), METAL)
	part("OutboardCover", Vector3.new(1.65, 1.64, 1.45), CFrame.new(0, 1.46, 13.48), DARK)
	part("OutboardCrown", Vector3.new(1.44, 0.28, 1.23), CFrame.new(0, 2.40, 13.42), UPHOLSTERY)
	part(
		"OutboardFront",
		Vector3.new(1.36, 1.25, 0.28),
		CFrame.new(0, 1.50, 12.65) * CFrame.Angles(math.rad(-12), 0, 0),
		DARK
	)
	for _, side in { -1, 1 } do
		part("OutboardBadge", Vector3.new(0.025, 0.12, 1.05), CFrame.new(side * 0.84, 1.96, 13.48), WHITE)
		for index = 0, 3 do
			part(
				"OutboardVent",
				Vector3.new(0.026, 0.065, 0.50),
				CFrame.new(side * 0.84, 1.45 + index * 0.14, 13.55),
				METAL
			)
		end
		part("MotorBracket", Vector3.new(0.16, 0.78, 0.25), CFrame.new(side * 0.55, 0.68, 12.66), METAL)
	end
	part("OutboardLeg", Vector3.new(0.34, 1.75, 0.67), CFrame.new(0, -0.23, 13.48), DARK)
	part("CavitationPlate", Vector3.new(1.03, 0.07, 1.06), CFrame.new(0, -0.62, 13.55), DARK)
	local hub = part(
		"PropellerHub",
		Vector3.new(0.70, 0.29, 0.29),
		CFrame.new(0, -1.10, 13.88) * CFrame.Angles(0, math.pi / 2, 0),
		METAL
	)
	hub.Shape = Enum.PartType.Cylinder
	for index = 0, 2 do
		local angle = index * math.pi * 2 / 3
		part(
			"PropellerBlade",
			Vector3.new(0.27, 0.73, 0.07),
			CFrame.new(math.sin(angle) * 0.34, -1.10 + math.cos(angle) * 0.34, 14.23) * CFrame.Angles(0, 0, -angle),
			METAL
		)
	end
	for _, side in { -1, 1 } do
		part("SwimPlatform", Vector3.new(2.10, 0.18, 1.18), CFrame.new(side * 2.22, 0.75, 12.95), WHITE, nil, true)
		for index = 0, 3 do
			part(
				"PlatformGrip",
				Vector3.new(1.64, 0.025, 0.08),
				CFrame.new(side * 2.22, 0.855, 12.58 + index * 0.22),
				DECK
			)
		end
		for _, z in { -5.5, 11.8 } do
			local width, top = stationAt(z)
			local x = side * (width - 0.35)
			part("CleatBase", Vector3.new(0.22, 0.06, 0.50), CFrame.new(x, top + 0.06, z), METAL)
			part("DeckCleat", Vector3.new(0.48, 0.08, 0.12), CFrame.new(x, top + 0.16, z), METAL)
		end
		local color = if side < 0 then Color3.fromRGB(211, 61, 53) else Color3.fromRGB(53, 189, 115)
		part("NavigationLightBase", Vector3.new(0.19, 0.10, 0.36), CFrame.new(side * 3.62, 1.98, -2.35), METAL)
		part(
			"NavigationLight",
			Vector3.new(0.12, 0.07, 0.24),
			CFrame.new(side * 3.62, 2.06, -2.35),
			color,
			Enum.Material.Neon
		)
	end
	local lampColor = Color3.fromRGB(214, 206, 184)
	for _, side in { -1, 1 } do
		local deckLamp = part(
			"DeckLightLens",
			Vector3.new(0.08, 0.18, 0.5),
			CFrame.new(side * 3.74, 1.35, 4.2),
			lampColor,
			Enum.Material.Neon
		)
		local deckLight = Instance.new("PointLight")
		deckLight.Name = "DeckLight"
		deckLight.Color, deckLight.Range, deckLight.Brightness = lampColor, 12, 0.3
		deckLight.Shadows = false
		deckLight.Parent = deckLamp

		part(
			"HeadlightStand",
			Vector3.new(0.14, 0.7, 0.14),
			CFrame.new(side * 1.05, 2.4, -12),
			METAL,
			Enum.Material.Metal
		)
		part(
			"HeadlightHousing",
			Vector3.new(0.65, 0.4, 0.5),
			CFrame.new(side * 1.05, 2.95, -12),
			DARK,
			Enum.Material.Metal
		)
		local lens = part(
			"HeadlightLens",
			Vector3.new(0.5, 0.26, 0.06),
			CFrame.new(side * 1.05, 2.95, -12.29),
			lampColor,
			Enum.Material.Neon
		)
		lens.CastShadow = false
		local headlight = Instance.new("SpotLight")
		headlight.Name = "Headlight"
		headlight.Face = Enum.NormalId.Front
		headlight.Color, headlight.Range, headlight.Brightness, headlight.Angle = lampColor, 30, 0.45, 40
		headlight.Shadows = false
		headlight.Parent = lens
	end
	return model
end

return RacingSpeedboat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="212">
        <Properties>
          <string name="Name">RestaurantService</string>
          <string name="Source"><![CDATA[-- The Restaurant path. Unlocking it builds a dining room onto the back of the
-- owner's house; dining tables are placed there from build mode. Diners walk in,
-- take a free seat and order one specific dish. Serving it takes that dish off the
-- kitchen pass and pays the restaurant markup, in one profile update.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AnglerData = require(script.Parent.AnglerData)
local BoatService = require(script.Parent.BoatService)
local CustomerService = require(script.Parent.CustomerService)
local DiningRoom = require(script.Parent.Map.DiningRoom)
local Kitchen = require(script.Parent.Map.Kitchen)
local Furniture = require(ReplicatedStorage.Shared.FurnitureCatalog)
local Paths = require(ReplicatedStorage.Shared.Paths)
local Recipes = require(ReplicatedStorage.Shared.Recipes)

local RestaurantService = {}
local BASE_TAG = "PlayerBase"
local WAIT_SECONDS = 150
local EAT_SECONDS = 8
local SERVE_DISTANCE = 14
local ARRIVAL_SECONDS = 25
-- Most diners ask for something already on the pass; the rest for anything your
-- stations can make, so a full menu pays off.
local AVAILABLE_ORDER_CHANCE = 0.7
-- Diners walk in from the street along the west side of the house (house-local).
-- Stay in the clear strip along the west side of the house and dining room.
local STREET = Vector3.new(-27.1, 0.16, 12)

local npc = CustomerService.npc
local random = Random.new()
local started = false
local restaurants: { [Model]: any } = {}
local diners: { [ProximityPrompt]: any } = {}

local function profileOf(base: Model)
	local owner = npc.ownerOf(base)
	return owner, owner and BoatService.getProfile(owner)
end

local function open(profile): boolean
	return profile ~= nil and Paths.unlocked(profile, "Restaurant")
end

-- The dining room exists only while its owner runs a restaurant.
local function syncRoom(restaurant)
	local base = restaurant.base
	local house = base:FindFirstChild("BaseHouse")
	local frame = npc.houseFrame(base)
	if not house or not frame then
		return
	end
	local owner, profile = profileOf(base)
	local room = house:FindFirstChild("Dining")
	local wanted = open(profile)
	if room and (not wanted or room:GetAttribute("LayoutVersion") ~= DiningRoom.VERSION) then
		room:Destroy()
		room = nil
	end
	if wanted and not room and owner then
		DiningRoom.build(house, frame)
	end
end

local function at(restaurant, position: Vector3): Vector3
	return (restaurant.frame * CFrame.new(position)).Position
end

-- Free diner seats at the owner's placed tables, with each table's floor frame.
local function freeSeats(restaurant): { { seat: Seat, table: CFrame } }
	local house = restaurant.base:FindFirstChild("BaseHouse")
	local placed = house and house:FindFirstChild("Furniture")
	local result = {}
	for _, model in if placed then placed:GetChildren() else {} do
		if model:GetAttribute("ItemId") ~= "DiningTable" then
			continue
		end
		local tableFrame = Furniture.frame(restaurant.frame, {
			ItemId = "DiningTable",
			X = model:GetAttribute("X"),
			Z = model:GetAttribute("Z"),
			R = model:GetAttribute("R"),
		})
		for _, child in model:GetChildren() do
			if child:IsA("Seat") and not child.Occupant and not restaurant.seated[child] then
				table.insert(result, { seat = child, table = tableFrame })
			end
		end
	end
	return result
end

-- The best matching dish on the pass for an order, or nil.
local function dishFor(profile, recipeId: string)
	local best
	for _, dish in profile.Angler.Pantry do
		if dish.RecipeId == recipeId and (not best or dish.Value > best.Value) then
			best = dish
		end
	end
	return best
end

-- Recipes the owner can make: the prep bench's, plus each placed station's.
local function menu(profile): { string }
	local stations = { Prep = true }
	for _, entry in profile.Angler.Furniture do
		if Recipes.Stations[entry.ItemId] then
			stations[entry.ItemId] = true
		end
	end
	local result = {}
	for _, id in Recipes.Order do
		if stations[Recipes.Items[id].Station] then
			table.insert(result, id)
		end
	end
	return result
end

local function chooseOrder(profile): string
	local available = {}
	for _, dish in profile.Angler.Pantry do
		if not table.find(available, dish.RecipeId) then
			table.insert(available, dish.RecipeId)
		end
	end
	if #available > 0 and random:NextNumber() < AVAILABLE_ORDER_CHANCE then
		return available[random:NextInteger(1, #available)]
	end
	local options = menu(profile)
	return options[random:NextInteger(1, #options)]
end

local function updatePrompt(diner, profile)
	local prompt = diner.prompt
	if not prompt then
		return
	end
	local recipe = Recipes.Items[diner.order]
	local dish = profile and dishFor(profile, diner.order)
	prompt.ActionText = "Serve " .. string.lower(recipe.Name)
	prompt.ObjectText = if dish
		then string.format("Diner · $%d", Recipes.dinerPrice(dish.Value))
		else "Cook " .. string.lower(recipe.Name) .. " first"
end

local function release(diner)
	if diner.leaving then
		return
	end
	diner.leaving = true
	if diner.prompt then
		diners[diner.prompt] = nil
		diner.prompt:Destroy()
		diner.prompt = nil
	end
end

local function finish(restaurant, diner)
	diner.active = false
	release(diner)
	if diner.seat then
		restaurant.seated[diner.seat] = nil
	end
	for _, item in { diner.plate, diner.model } do
		if item then
			item:Destroy()
		end
	end
	local index = table.find(restaurant.diners, diner)
	if index then
		table.remove(restaurant.diners, index)
	end
end

local function stand(diner)
	local humanoid = diner.humanoid
	if humanoid and humanoid.Parent then
		humanoid.Sit = false
		humanoid.Jump = true
	end
end

local function visit(restaurant, diner)
	local base = restaurant.base
	diner.model = npc.spawn(at(restaurant, STREET))
	diner.humanoid = diner.model:FindFirstChildOfClass("Humanoid")
	diner.root = diner.model:FindFirstChild("HumanoidRootPart")
	diner.humanoid.Died:Once(function()
		diner.active = false
	end)
	local recipe = Recipes.Items[diner.order]
	npc.bubble(diner, "A table for one, please")
	local function going(position: Vector3): boolean
		return npc.walk(diner, position, function()
			return not diner.leaving
		end)
	end
	local seat = diner.seat :: Seat
	local beside = (seat.CFrame * CFrame.new(1.6, -seat.Size.Y / 2 - 1.4, 0)).Position
	local entered = going(at(restaurant, DiningRoom.ARRIVAL))
		and going(at(restaurant, DiningRoom.INSIDE))
	if not diner.active or diner.leaving then
		return
	end
	-- Squeezing between tables can defeat pathfinding; step up to the chair instead.
	if not (entered and going(beside)) then
		diner.model:PivotTo(CFrame.new(beside + Vector3.new(0, 3, 0)))
	end
	if not diner.active or diner.leaving or seat.Occupant then
		return
	end
	seat:Sit(diner.humanoid)
	task.wait(0.6)
	local owner = npc.ownerOf(base)
	npc.bubble(diner, "I'd like the " .. string.lower(recipe.Name) .. ", please")
	local prompt = npc.ownerPrompt(diner.root, "ServeDinerPrompt", "Serve", recipe.Name)
	prompt:SetAttribute("OwnerUserId", base:GetAttribute("OwnerUserId"))
	prompt.MaxActivationDistance = 8
	diner.prompt = prompt
	diners[prompt] = diner
	updatePrompt(diner, owner and BoatService.getProfile(owner))
	npc.notify(owner, "A diner in your restaurant ordered " .. string.lower(recipe.Name) .. ".")
	local deadline = os.clock() + WAIT_SECONDS
	while diner.active and not diner.leaving and not diner.served and os.clock() < deadline do
		task.wait(0.5)
	end
	if not diner.active then
		return
	end
	if diner.served then
		npc.bubble(diner, "Mmm…")
		task.wait(EAT_SECONDS)
		npc.bubble(diner, "Delicious, thank you!")
		if diner.plate then
			diner.plate:Destroy()
			diner.plate = nil
		end
	else
		release(diner)
		npc.bubble(diner, "I'll come back another day…")
	end
	task.wait(1)
	stand(diner)
	restaurant.seated[seat] = nil
	task.wait(0.4)
	for _, position in { DiningRoom.INSIDE, DiningRoom.ARRIVAL, STREET } do
		if not npc.walk(diner, at(restaurant, position)) then
			return
		end
	end
end

local function serve(player: Player, diner)
	local restaurant = diner.restaurant
	local function authorized(): boolean
		return npc.ownerOf(restaurant.base) == player
			and diner.active
			and not diner.leaving
			and not diner.served
			and npc.near(player, diner.root.Position, SERVE_DISTANCE)
	end
	local profile = BoatService.getProfile(player)
	if diner.serving or not profile or not authorized() then
		return
	end
	local dish = dishFor(profile, diner.order)
	local recipe = Recipes.Items[diner.order]
	if not dish then
		npc.notify(player, "Cook " .. string.lower(recipe.Name) .. " in your kitchen first. This diner wants nothing else.")
		return
	end
	diner.serving = true
	local price = 0
	local ok, message = BoatService.updateProgress(player, function(current)
		assert(authorized(), "This diner can no longer be served.")
		local chosen = dishFor(current, diner.order)
		assert(chosen, "That dish is no longer on your kitchen pass.")
		local data, paid = AnglerData.sellDish(current.Angler, chosen, Recipes.RESTAURANT_MARKUP, "DinersServed")
		assert(data, "That dish is no longer on your kitchen pass.")
		current.Angler = data
		current.Cash += paid
		price = paid
	end)
	diner.serving = false
	if not ok then
		npc.notify(player, message)
		return
	end
	diner.served = true
	release(diner)
	local seat = diner.seat
	local offset = seat and seat:GetAttribute("PlateOffset")
	if seat and diner.table and typeof(offset) == "Vector3" then
		local plate = Kitchen.buildDish(diner.order, recipe.Look, diner.table * CFrame.new(offset))
		plate.Name = "ServedDish"
		plate.Parent = workspace:FindFirstChild("ShopCustomers") or workspace
		diner.plate = plate
	end
	npc.notify(player, string.format("Served %s for $%d.", string.lower(recipe.Name), price))
end

local function arrive(restaurant)
	local _, profile = profileOf(restaurant.base)
	if not open(profile) then
		return
	end
	local seats = freeSeats(restaurant)
	if #seats == 0 then
		return
	end
	local choice = seats[random:NextInteger(1, #seats)]
	local diner = {
		restaurant = restaurant,
		order = chooseOrder(profile),
		seat = choice.seat,
		table = choice.table,
		active = true,
	}
	restaurant.seated[choice.seat] = diner
	table.insert(restaurant.diners, diner)
	restaurant.nextArrival = os.clock() + ARRIVAL_SECONDS
	task.spawn(function()
		local ok, failure = pcall(visit, restaurant, diner)
		if not ok then
			warn("[Restaurant] " .. tostring(failure))
		end
		finish(restaurant, diner)
	end)
end

local function register(base: Instance)
	if not base:IsA("Model") or restaurants[base] then
		return
	end
	local frame = npc.houseFrame(base)
	if not frame then
		return
	end
	local restaurant = {
		base = base,
		frame = frame,
		diners = {},
		seated = {},
		nextArrival = os.clock() + ARRIVAL_SECONDS,
	}
	restaurants[base] = restaurant
	base:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
		-- A new owner never inherits the previous owner's diners or room.
		for _, diner in restaurant.diners do
			release(diner)
			stand(diner)
		end
		syncRoom(restaurant)
		restaurant.nextArrival = os.clock() + ARRIVAL_SECONDS
	end)
	syncRoom(restaurant)
end

function RestaurantService.start()
	if started then
		return
	end
	started = true
	for _, base in CollectionService:GetTagged(BASE_TAG) do
		register(base)
	end
	CollectionService:GetInstanceAddedSignal(BASE_TAG):Connect(register)
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		local diner = prompt.Name == "ServeDinerPrompt" and diners[prompt]
		if diner then
			task.spawn(serve, player, diner)
		end
	end)
	local function watch(player: Player)
		player:GetAttributeChangedSignal("AnglerRevision"):Connect(function()
			for _, restaurant in restaurants do
				if npc.ownerOf(restaurant.base) == player then
					syncRoom(restaurant)
				end
			end
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	task.spawn(function()
		while true do
			task.wait(1)
			for _, restaurant in restaurants do
				local owner, profile = profileOf(restaurant.base)
				if not open(profile) then
					for _, diner in restaurant.diners do
						release(diner)
					end
					continue
				end
				for _, diner in restaurant.diners do
					updatePrompt(diner, profile)
				end
				if owner and os.clock() >= restaurant.nextArrival then
					arrive(restaurant)
				end
			end
		end
	end)
end

return RestaurantService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="213">
        <Properties>
          <string name="Name">RodSerials</string>
          <string name="Source"><![CDATA[-- One durable counter per skin, shared by every server in the experience.
-- Reserve before saving a player's profile; failed saves may leave gaps, but a
-- reserved number is never reused. No yielding calls run inside profile transforms.
local BoatData = if script then require(script.Parent.BoatData) else require("./BoatData")
local RodSerials = {}
RodSerials.Scope = "GlobalV1"

function RodSerials.reserve(store, skinId: string, count: number?): number
	local amount = count or 1
	assert(type(skinId) == "string" and #skinId > 0, "Missing serial skin")
	assert(amount >= 1 and amount % 1 == 0, "Invalid serial reservation")
	local last = store:UpdateAsync("RodSerial_v1_" .. skinId, function(raw)
		local previous = if raw == nil then 0 else raw
		assert(type(previous) == "number" and previous >= 0 and previous % 1 == 0, "Invalid global serial counter")
		assert(previous + amount < 2 ^ 53 - 1, "Global skin serial limit reached")
		return previous + amount
	end)
	assert(type(last) == "number" and last >= amount and last % 1 == 0, "Serial reservation was not saved")
	return last - amount + 1
end

-- Legacy per-player numbers can collide. Renumber all copies before exposing
-- the inventory, keeping the selected copy and claim receipts intact. Concurrent
-- loads may reserve unused ranges; only the first committed migration is kept.
function RodSerials.migrate(store, key: string, loaded)
	if loaded.RodSerialScope == RodSerials.Scope then
		return loaded
	end
	local ranges = {}
	for id, count in loaded.RodSkins do
		ranges[id] = { first = RodSerials.reserve(store, id, count), count = count }
	end
	local saved = store:UpdateAsync(key, function(raw)
		local profile = BoatData.decode(raw)
		if profile.RodSerialScope == RodSerials.Scope then
			return profile
		end
		local used = {}
		local equippedId, equippedSerial = profile.EquippedRodSkin, profile.EquippedRodSkinSerial
		for _, copy in profile.RodSkinCopies do
			local id, oldSerial = copy.SkinId, copy.Serial
			local range = ranges[id]
			local index = (used[id] or 0) + 1
			assert(range and index <= range.count, "Inventory changed during serial migration; retry loading")
			copy.Serial = range.first + index - 1
			if equippedId == id and equippedSerial == oldSerial then
				profile.EquippedRodSkinSerial = copy.Serial
			end
			used[id] = index
		end
		profile.RodSerialScope = RodSerials.Scope
		return BoatData.decode(profile)
	end)
	assert(saved ~= nil, "Serial migration was not saved")
	return BoatData.decode(saved)
end

return RodSerials
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="214">
        <Properties>
          <string name="Name">Rowboat</string>
          <string name="Source"><![CDATA[-- Native geometry shared by the drydock display and each player's working boat.
-- The frame origin is the waterline; forward is local -Z. The open hull is built
-- from thin faceted planks instead of a solid block across the passenger space.

local Rowboat = {}

local WOOD = {
	Color3.fromRGB(83, 69, 59),
	Color3.fromRGB(94, 78, 65),
	Color3.fromRGB(104, 86, 71),
	Color3.fromRGB(89, 74, 62),
}
local RAIL = Color3.fromRGB(112, 91, 73)
local IRON = Color3.fromRGB(49, 47, 42)
local LAMP = Color3.fromRGB(214, 168, 104)
local PLANK_THICKNESS = 0.14
local FLOOR_HEIGHT = 0.4
local connectedCoolers = setmetatable({}, { __mode = "k" })

-- Connections are runtime state, so baked shop boats must be rebound on load.
function Rowboat.ensureCoolerInteraction(model: Model)
	local lid = model:FindFirstChild("CoolerLid", true)
	local hinge = if lid then lid:FindFirstChild("CoolerHinge") else nil
	if not hinge or connectedCoolers[lid] then return end
	connectedCoolers[lid] = true
	lid.Anchored = false
	local closed = hinge:GetAttribute("ClosedC0")
	local busy = false
	local function toggle(player: Player)
		local character = player.Character
		local playerRoot = if character then character:FindFirstChild("HumanoidRootPart") else nil
		if busy or not playerRoot or not lid.Parent or (playerRoot.Position - lid.Position).Magnitude > 12 then return end
		busy = true
		local open = not model:GetAttribute("CoolerOpen")
		model:SetAttribute("CoolerOpen", open)
		local tween = game:GetService("TweenService"):Create(hinge,
			TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
			{ C0 = if open then closed * CFrame.Angles(math.rad(-105), 0, 0) else closed })
		tween.Completed:Once(function() busy = false end)
		tween:Play()
	end
	for _, piece in model:GetDescendants() do
		if piece:IsA("BasePart") and (piece.Name == "CoolerBody" or piece.Name == "CoolerWall" or piece == lid) then
			local click = piece:FindFirstChildOfClass("ClickDetector") or Instance.new("ClickDetector")
			click.MaxActivationDistance = 12
			click.Parent = piece
			click.MouseClick:Connect(toggle)
		end
	end
end

function Rowboat.build(frame: CFrame, anchored: boolean?): Model
	local isAnchored = anchored == true
	local model = Instance.new("Model")
	model.Name = "Rowboat"
	model:SetAttribute("HullLength", 14.4)
	model:SetAttribute("HullBeam", 6.8)
	model:SetAttribute("DryFloorHeight", FLOOR_HEIGHT)
	model:SetAttribute("DryFloorHalfBeam", 3.25)
	model:SetAttribute("DryFloorHalfLength", 7.1)

	local root = Instance.new("Part")
	root.Name = "HullRoot"
	root.Size = Vector3.new(3.4, 0.45, 8.5)
	root.CFrame = frame * CFrame.new(0, -0.4, 0)
	root.Transparency = 1
	root.Anchored = isAnchored
	root.CanCollide = false
	root.CanTouch = false
	root.RootPriority = 127
	root.CustomPhysicalProperties = PhysicalProperties.new(1.4, 0.45, 0.05, 100, 100)
	root.Parent = model
	model.PrimaryPart = root

	local function finish(p: BasePart, name: string, color: Color3, material: Enum.Material, collide: boolean?)
		p.Name = name
		p.Anchored = isAnchored
		p.CanCollide = collide ~= false
		p.CanTouch = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Color = color
		p.Material = material
		p.Massless = true
		p.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = p
		weld.Parent = p
		return p
	end

	local function part(
		name: string,
		size: Vector3,
		localFrame: CFrame,
		color: Color3,
		material: Enum.Material?,
		collide: boolean?
	): Part
		local p = Instance.new("Part")
		p.Size = size
		p.CFrame = frame * localFrame
		finish(p, name, color, material or Enum.Material.Wood, collide)
		return p
	end

	local function beam(
		name: string,
		a: Vector3,
		b: Vector3,
		width: number,
		depth: number,
		color: Color3,
		material: Enum.Material?,
		collide: boolean?
	): Part
		return part(
			name,
			Vector3.new(width, depth, (b - a).Magnitude),
			CFrame.lookAt((a + b) / 2, b),
			color,
			material,
			collide
		)
	end

	-- Two thin wedges cover one triangle. Their thickness is pushed inward, so
	-- adjacent patches share the outside edge without chunky projecting corners.
	local function triangle(name: string, a: Vector3, b: Vector3, c: Vector3, inside: Vector3, color: Color3)
		local ab, ac, bc = b - a, c - a, c - b
		local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
		if abd > acd and abd > bcd then
			c, a = a, c
		elseif acd > bcd and acd > abd then
			a, b = b, a
		end
		ab, ac, bc = b - a, c - a, c - b
		local right = ac:Cross(ab).Unit
		local up = bc:Cross(right).Unit
		local back = bc.Unit
		local height = math.abs(ab:Dot(up))
		local normal = if right:Dot((a + b + c) / 3 - inside) >= 0 then right else -right
		local shift = -normal * (PLANK_THICKNESS / 2)
		local first = Instance.new("WedgePart")
		first.Size = Vector3.new(PLANK_THICKNESS, height, math.abs(ab:Dot(back)))
		first.CFrame = frame * CFrame.fromMatrix((a + b) / 2 + shift, right, up, back)
		finish(first, name, color, Enum.Material.Wood)
		local second = Instance.new("WedgePart")
		second.Size = Vector3.new(PLANK_THICKNESS, height, math.abs(ac:Dot(back)))
		second.CFrame = frame * CFrame.fromMatrix((a + c) / 2 + shift, -right, up, -back)
		finish(second, name, color, Enum.Material.Wood)
	end

	local stations = {
		{ z = -7.1, width = 0.25, bottom = 0.12, top = 2.18 },
		{ z = -4.6, width = 2.73, bottom = 1.70, top = 1.83 },
		{ z = 0, width = 3.25, bottom = 2.08, top = 1.70 },
		{ z = 4.6, width = 2.73, bottom = 1.70, top = 1.83 },
		{ z = 7.1, width = 0.25, bottom = 0.12, top = 2.18 },
	}
	local function hullPoint(station, side: number, level: number): Vector3
		local bottomY = if math.abs(station.z) > 7 then 0.12 else -0.48
		return Vector3.new(
			side * (station.bottom + (station.width - station.bottom) * level),
			bottomY + (station.top - bottomY) * level,
			station.z
		)
	end
	for _, side in { -1, 1 } do
		for i = 1, #stations - 1 do
			local from, to = stations[i], stations[i + 1]
			for band = 0, 1 do
				local low, high = band / 2, (band + 1) / 2
				local a, b = hullPoint(from, side, low), hullPoint(to, side, low)
				local c, d = hullPoint(to, side, high), hullPoint(from, side, high)
				local inside = Vector3.new(0, 0.5, (from.z + to.z) / 2)
				local color = WOOD[(i + band + (if side > 0 then 1 else 0)) % #WOOD + 1]
				triangle("HullPlank", a, b, c, inside, color)
				triangle("HullPlank", a, c, d, inside, color)
			end
			beam("Gunwale", hullPoint(from, side, 1), hullPoint(to, side, 1), 0.24, 0.22, RAIL)
			beam("PlankSeam", hullPoint(from, side, 0.5), hullPoint(to, side, 0.5), 0.065, 0.075, WOOD[1], nil, false)
		end
	end

	-- Terrain water is not displaced by hull parts. A continuous, raised wooden
	-- sole meets the hull at every station, including the tapered bow and stern.
	local function floorPoint(station, side: number): Vector3
		local bottomY = if math.abs(station.z) > 7 then 0.12 else -0.48
		local level = (FLOOR_HEIGHT - bottomY) / (station.top - bottomY)
		return Vector3.new(side * (station.bottom + (station.width - station.bottom) * level), FLOOR_HEIGHT, station.z)
	end
	for i = 1, #stations - 1 do
		local a, b = floorPoint(stations[i], -1), floorPoint(stations[i + 1], -1)
		local c, d = floorPoint(stations[i + 1], 1), floorPoint(stations[i], 1)
		local inside = Vector3.new(0, -1, (a.Z + b.Z) / 2)
		triangle("FloorSeal", a, b, c, inside, WOOD[i % #WOOD + 1])
		triangle("FloorSeal", a, c, d, inside, WOOD[i % #WOOD + 1])
	end

	-- Narrow boards retain the planked appearance above the fitted sole.
	for i = -3, 3 do
		local length = 11.6 - math.abs(i) * 1.0
		part("Floorboard", Vector3.new(0.51, 0.20, length), CFrame.new(i * 0.53, FLOOR_HEIGHT - 0.08, 0), WOOD[(i + 3) % #WOOD + 1])
	end
	part("Keel", Vector3.new(0.26, 0.25, 13.5), CFrame.new(0, -0.51, 0), WOOD[1])
	for _, z in { -7.05, 7.05 } do
		part("Stem", Vector3.new(0.35, 2.05, 0.25), CFrame.new(0, 1.16, z), WOOD[1])
	end
	for _, z in { -3.65, 0.6, 3.65 } do
		local width = if z == 0.6 then 5.55 else 4.9
		part("Bench", Vector3.new(width, 0.24, 1.05), CFrame.new(0, 0.9, z), RAIL)
		for _, side in { -1, 1 } do
			part("BenchSupport", Vector3.new(0.22, 0.9, 0.5), CFrame.new(side * (width / 2 - 0.4), 0.34, z), WOOD[1])
		end
	end

	-- A compact insulated cooler rests on the bow floor ahead of the front bench.
	local coolerBlue = Color3.fromRGB(67, 111, 124)
	local coolerWhite = Color3.fromRGB(230, 230, 211)
	part("CoolerBody", Vector3.new(2, 0.12, 1.4), CFrame.new(0, FLOOR_HEIGHT + 0.08, -4.95), coolerBlue, Enum.Material.SmoothPlastic, false)
	for _, side in { -1, 1 } do
		part("CoolerWall", Vector3.new(0.12, 1.03, 1.4), CFrame.new(side * 0.94, 1.055, -4.95), coolerBlue, Enum.Material.SmoothPlastic, false)
		part("CoolerWall", Vector3.new(1.76, 1.03, 0.12), CFrame.new(0, 1.055, -4.95 + side * 0.64), coolerBlue, Enum.Material.SmoothPlastic, false)
		part("CoolerSeal", Vector3.new(0.14, 0.06, 1.48), CFrame.new(side * 0.97, 1.6, -4.95), IRON, Enum.Material.Rubber, false)
		part("CoolerSeal", Vector3.new(1.8, 0.06, 0.14), CFrame.new(0, 1.6, -4.95 + side * 0.67), IRON, Enum.Material.Rubber, false)
	end
	local lid = part("CoolerLid", Vector3.new(2.15, 0.18, 1.55), CFrame.new(0, 1.72, -4.95), coolerWhite, Enum.Material.SmoothPlastic, false)
	lid:FindFirstChildOfClass("WeldConstraint"):Destroy()
	local pivot = frame * CFrame.new(0, 1.63, -5.725)
	local hinge = Instance.new("Motor6D")
	hinge.Name = "CoolerHinge"
	hinge.Part0, hinge.Part1 = root, lid
	hinge.C0 = root.CFrame:ToObjectSpace(pivot)
	hinge.C1 = lid.CFrame:ToObjectSpace(pivot)
	hinge:SetAttribute("ClosedC0", hinge.C0)
	hinge.Parent = lid
	model:SetAttribute("CoolerOpen", false)
	for _, side in { -1, 1 } do
		part("CoolerLatch", Vector3.new(0.16, 0.32, 0.1), CFrame.new(side * 0.65, 1.48, -4.205), IRON, Enum.Material.Metal, false)
		part("CoolerHandleMount", Vector3.new(0.12, 0.3, 0.75), CFrame.new(side * 1.04, 1.26, -4.95), coolerWhite, Enum.Material.SmoothPlastic, false)
		part("CoolerHandle", Vector3.new(0.16, 0.13, 0.65), CFrame.new(side * 1.15, 1.23, -4.95), IRON, Enum.Material.SmoothPlastic, false)
	end

	local seat = Instance.new("VehicleSeat")
	seat.Size = Vector3.new(2.1, 0.22, 1.05)
	seat.CFrame = frame * CFrame.new(0, 0.92, 0.6)
	seat.Transparency = 1
	seat.HeadsUpDisplay = false
	seat.MaxSpeed = 0
	seat.Torque = 0
	seat.TurnSpeed = 0
	finish(seat, "RowerSeat", RAIL, Enum.Material.Wood, false)
	seat.CanTouch = not isAnchored
	seat.Disabled = isAnchored

	for _, side in { -1, 1 } do
		local inner = Vector3.new(side * 1.9, 1.91, -1.6)
		local outer = Vector3.new(side * 4.66, 1.08, 3.72)
		local shaft = beam("OarShaft", inner, outer, 0.13, 0.13, RAIL, nil, false)
		local grip = beam("OarGrip", inner, inner:Lerp(outer, 0.13), 0.19, 0.18, WOOD[1], nil, false)
		local bladeEnd = outer + (outer - inner).Unit * 1.15
		local blade = beam("OarBlade", outer, bladeEnd, 0.6, 0.13, WOOD[2], nil, false)
		-- One pivot per complete oar. Nothing is also welded directly to the hull.
		local pivot = frame * CFrame.new(side * 3.08, 1.76, 0.6)
		for _, piece in { shaft, grip, blade } do
			piece:FindFirstChildOfClass("WeldConstraint"):Destroy()
			if piece ~= shaft then
				local weld = Instance.new("WeldConstraint")
				weld.Part0, weld.Part1, weld.Parent = shaft, piece, piece
			end
		end
		local joint = Instance.new("Motor6D")
		joint.Name = if side < 0 then "PortOar" else "StarboardOar"
		joint.Part0, joint.Part1 = root, shaft
		joint.C0 = root.CFrame:ToObjectSpace(pivot)
		joint.C1 = shaft.CFrame:ToObjectSpace(pivot)
		joint:SetAttribute("RowSide", side)
		joint.Parent = shaft
		part(
			"Oarlock",
			Vector3.new(0.15, 0.32, 0.27),
			CFrame.new(side * 3.08, 1.76, 0.6),
			IRON,
			Enum.Material.Metal,
			false
		)
	end

	for _, z in { -6.25, 6.25 } do
		part("EndBoard", Vector3.new(1.45, 0.16, 0.8), CFrame.new(0, 1.95, z), RAIL)
		local base = Vector3.new(0, 2.12, z)
		part("LanternFoot", Vector3.new(0.44, 0.12, 0.44), CFrame.new(base), IRON, Enum.Material.Metal, false)
		local glow = part(
			"LanternGlass",
			Vector3.new(0.28, 0.47, 0.28),
			CFrame.new(base + Vector3.new(0, 0.28, 0)),
			LAMP,
			Enum.Material.Neon,
			false
		)
		part(
			"LanternCap",
			Vector3.new(0.44, 0.12, 0.44),
			CFrame.new(base + Vector3.new(0, 0.56, 0)),
			IRON,
			Enum.Material.Metal,
			false
		)
		for _, x in { -0.18, 0.18 } do
			part(
				"LanternFrame",
				Vector3.new(0.045, 0.49, 0.045),
				CFrame.new(base + Vector3.new(x, 0.29, 0)),
				IRON,
				Enum.Material.Metal,
				false
			)
		end
		part(
			"LanternHandle",
			Vector3.new(0.12, 0.2, 0.05),
			CFrame.new(base + Vector3.new(0, 0.72, 0)),
			IRON,
			Enum.Material.Metal,
			false
		)
		local light = Instance.new("PointLight")
		light.Color = LAMP
		light.Range = 8
		light.Brightness = 0.35
		light.Shadows = false
		light.Parent = glow
	end

	Rowboat.ensureCoolerInteraction(model)
	return model
end

return Rowboat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="215">
        <Properties>
          <string name="Name">ScaleModels</string>
          <string name="Source"><![CDATA[-- Admin-only showcase of full-size models, reached only with /tp models. It floats in its own patch
-- of sea 4,000 studs west of the map, outside Biomes.inOceanBounds: driven boats stop at the ocean's
-- edge (BoatService), so nothing can sail here and nobody can swim the empty gap.
--
-- The ship streams in pinned pieces: under memory pressure the client throws out everything past
-- StreamingMinRadius, which is the whole ship seen from the pier. Pieces are PersistentPerPlayer,
-- so only an admin who goes there downloads them, and small, so they arrive without a hitch.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Biomes = require(ReplicatedStorage.Shared.Biomes)
local MscPreziosa = require(script.Parent.MscPreziosa)

local ScaleModels = {}
-- Bump to rebuild a model saved in the place
ScaleModels.VERSION = 8
ScaleModels.ORIGIN = Vector3.new(-9500, Biomes.WaterLevel, 0)

local Terrain = workspace.Terrain
local WATER_HALF = Vector3.new(1100, 0, 700)
-- Small enough that one tile of water fills well within a frame
local TILE = 256
-- The pier sits off the starboard side amidships, far enough out to take in the whole ship
local PIER = ScaleModels.ORIGIN + Vector3.new(0, 0, 95 * MscPreziosa.STUDS)
local PIECE_PARTS = 200 -- as many parts as one pinned piece may hold (as for the islands)
local PINS_PER_FRAME = 2

local pieces: { Model } = {}
-- Players who went to the models; they keep the pieces pinned until they leave
local visitors: { [Player]: boolean } = {}

local function fillWater()
	local lo, hi = ScaleModels.ORIGIN - WATER_HALF, ScaleModels.ORIGIN + WATER_HALF
	local depth = Biomes.WaterLevel - Biomes.SeaFloor
	for x = lo.X, hi.X - 1, TILE do
		for z = lo.Z, hi.Z - 1, TILE do
			local sx, sz = math.min(TILE, hi.X - x), math.min(TILE, hi.Z - z)
			local cx, cz = x + sx / 2, z + sz / 2
			Terrain:FillBlock(
				CFrame.new(cx, Biomes.WaterLevel - depth / 2, cz),
				Vector3.new(sx, depth, sz),
				Enum.Material.Water
			)
			Terrain:FillBlock(CFrame.new(cx, Biomes.SeaFloor - 4, cz), Vector3.new(sx, 8, sz), Enum.Material.Rock)
			task.wait()
		end
	end
end

local function hasWater(): boolean
	local probe = PIER + Vector3.new(0, -8, 40)
	local region = Region3.new(probe - Vector3.one * 2, probe + Vector3.one * 2):ExpandToGrid(4)
	local ok, voxels = pcall(Terrain.ReadVoxels, Terrain, region, 4)
	return ok and voxels[1][1][1] == Enum.Material.Water
end

local function plank(
	parent: Instance,
	name: string,
	size: Vector3,
	position: Vector3,
	color: Color3,
	material: Enum.Material
): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Position = position
	p.Anchored = true
	p.CanTouch = false
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function buildPier(folder: Folder): Model
	local pier = Instance.new("Model")
	pier.Name = "ModelsPier"
	local wood, post = Color3.fromRGB(150, 110, 72), Color3.fromRGB(96, 70, 48)
	plank(pier, "PierDeck", Vector3.new(48, 1, 20), PIER + Vector3.new(0, 2, 0), wood, Enum.Material.WoodPlanks)
	for _, x in { -22, 22 } do
		for _, z in { -8, 8 } do
			plank(pier, "PierPost", Vector3.new(1.6, 14, 1.6), PIER + Vector3.new(x, -4, z), post, Enum.Material.Wood)
		end
		plank(pier, "PierRail", Vector3.new(0.6, 3, 20), PIER + Vector3.new(x, 4, 0), post, Enum.Material.Wood)
	end
	plank(pier, "PierRail", Vector3.new(48, 3, 0.6), PIER + Vector3.new(0, 4, 9.7), post, Enum.Material.Wood)
	-- Where /tp models lands, facing the ship
	local arrival = plank(
		pier,
		"ModelsArrival",
		Vector3.new(2, 0.2, 2),
		PIER + Vector3.new(0, 2.6, -4),
		wood,
		Enum.Material.WoodPlanks
	)
	arrival.CFrame = CFrame.lookAt(arrival.Position, arrival.Position - Vector3.zAxis)
	arrival.Transparency = 1
	arrival.CanCollide = false
	arrival.CanQuery = false
	pier.Parent = folder
	return pier
end

local function ensureFolder(): Folder
	local folder = workspace:FindFirstChild("ScaleModels")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "ScaleModels"
		folder.Parent = workspace
	end
	return folder
end

-- The pier is small and never yields, so /tp models can put it up on the spot when the build
-- has not reached it yet
function ScaleModels.ensurePier(): BasePart
	local folder = ensureFolder()
	local pier = folder:FindFirstChild("ModelsPier") or buildPier(folder)
	return pier:FindFirstChild("ModelsArrival") :: BasePart
end

-- Regroups each part of the model's sections into runs along the ship, PIECE_PARTS at most. It runs
-- before the model replicates, because a streaming mode set afterwards makes clients stream it again.
local function cutPieces(model: Model): { Model }
	local cut = {}
	for _, section in model:GetChildren() do
		local parts = {}
		for _, d in section:GetDescendants() do
			if d:IsA("BasePart") then
				table.insert(parts, d)
			end
		end
		if section:IsA("BasePart") then
			table.insert(parts, section)
		end
		table.sort(parts, function(a, b)
			return a.Position.X < b.Position.X
		end)
		local holder = if section:IsA("Model") then section else model
		local piece
		for i, part in parts do
			if (i - 1) % PIECE_PARTS == 0 then
				piece = Instance.new("Model")
				piece.Name = section.Name .. "Piece"
				piece.ModelStreamingMode = Enum.ModelStreamingMode.PersistentPerPlayer
				piece.Parent = holder
				table.insert(cut, piece)
			end
			part.Parent = piece
		end
	end
	return cut
end

-- A few pieces a frame, so the ship builds up round the admin instead of freezing the client
local function pin(player: Player, list: { Model })
	task.spawn(function()
		for i, piece in list do
			if not visitors[player] then
				return
			end
			if piece.Parent then
				piece:AddPersistentPlayer(player)
			end
			if i % PINS_PER_FRAME == 0 then
				RunService.Heartbeat:Wait()
			end
		end
	end)
end

-- Called by /tp models. Pinned pieces stay with the player until they leave
function ScaleModels.visit(player: Player)
	if visitors[player] then
		return
	end
	visitors[player] = true
	pin(player, pieces)
end

Players.PlayerRemoving:Connect(function(player)
	visitors[player] = nil
end)

function ScaleModels.ensure(): Folder
	local folder = ensureFolder()
	-- Water and the pier come first, so /tp models works even while (or if) the ship fails to build
	if not hasWater() then
		fillWater()
	end
	if not folder:FindFirstChild("ModelsPier") then
		buildPier(folder)
	end
	local ship = folder:FindFirstChild("MSC Preziosa")
	if not ship or ship:GetAttribute("ModelVersion") ~= ScaleModels.VERSION then
		if ship then
			ship:Destroy()
		end
		-- Built out of the world, so it is cut into pieces before any client sees it
		local built = MscPreziosa.build(ServerStorage, ScaleModels.ORIGIN)
		built:SetAttribute("ModelVersion", ScaleModels.VERSION)
		pieces = cutPieces(built)
		built.Parent = folder
		-- Admins who arrived while it was building
		for player in visitors do
			pin(player, pieces)
		end
	else
		for _, d in ship:GetDescendants() do
			if d:IsA("Model") and d.ModelStreamingMode == Enum.ModelStreamingMode.PersistentPerPlayer then
				table.insert(pieces, d)
			end
		end
	end
	return folder
end

return ScaleModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="216">
        <Properties>
          <string name="Name">ServerUpdates</string>
          <string name="Source"><![CDATA[-- A newer running place version announces itself across servers. The durable
-- high-water mark also catches missed messages and servers started from old jobs.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local TeleportService = game:GetService("TeleportService")
local RunService = game:GetService("RunService")

local Service = {}
local started = false
local current = game.PlaceVersion
local latest = current
local restartAt = 0
local checked = false
local closing = false
local store
local subscription
local topic = "FishingWatersVersions_" .. game.PlaceId
local key = tostring(game.PlaceId)
local destinations = {}
local admissions = {}
local transfers = {}
local fallbackCode, fallbackVersion, fallbackCreated
local reserving = false

local function outdated()
	return latest > current or restartAt > 0
end

local function refreshNotice()
	ReplicatedStorage:SetAttribute("FishingWatersServerVersion", current)
	ReplicatedStorage:SetAttribute("FishingWatersLatestVersion", latest)
	ReplicatedStorage:SetAttribute("FishingWatersUpdateAvailable", outdated())
	ReplicatedStorage:SetAttribute("FishingWatersRestartAt", restartAt)
end

local function observe(version)
	if type(version) == "number" and version == version and version < math.huge and version > latest then
		latest = version
		refreshNotice()
	end
end

local function syncVersion()
	local ok, result = pcall(function()
		store = store or DataStoreService:GetDataStore("FishingWatersPlaceVersions_v1")
		if not checked then
			return store:UpdateAsync(key, function(old)
				return math.max(if type(old) == "number" then old else 0, current)
			end)
		end
		return store:GetAsync(key)
	end)
	if ok then
		observe(result)
		checked = true
	else
		warn("[ServerUpdates] Version sync will retry: " .. tostring(result))
	end
end

local function reserveFresh()
	-- Share the fallback amongst arrivals from this server, so friends aren't
	-- each sent to an otherwise empty server. Never reuse it for a later update.
	while reserving do
		task.wait(0.1)
	end
	if fallbackCode and fallbackVersion == latest and os.clock() - fallbackCreated < 120 then
		return fallbackCode
	end
	reserving = true
	local version = latest
	local ok, code = pcall(TeleportService.ReserveServerAsync, TeleportService, game.PlaceId)
	reserving = false
	if not ok then
		error(code)
	end
	fallbackCode, fallbackVersion, fallbackCreated = code, version, os.clock()
	return code
end

local attempt
local function retry(player, state)
	if transfers[player] ~= state or state.waiting or player.Parent ~= Players then
		return
	end
	state.waiting = true
	player:SetAttribute("FishingWatersUpdateStatus", "Retrying")
	task.delay(math.min(30, 5 * state.attempts), function()
		if transfers[player] == state and player.Parent == Players then
			state.waiting = false
			attempt(player, state)
		end
	end)
end

attempt = function(player, state)
	if transfers[player] ~= state or player.Parent ~= Players or closing then
		return
	end
	state.attempts += 1
	local attemptNumber = state.attempts
	player:SetAttribute("FishingWatersUpdateStatus", "Connecting")
	local ok, failure = pcall(function()
		local options = Instance.new("TeleportOptions")
		local destination
		-- Only target a job which has actually reported running the new version.
		-- Ordinary matchmaking could choose the player's friend's old server again.
		if state.attempts <= 2 then
			for jobId, entry in destinations do
				if entry.version >= latest and entry.version > current and os.clock() - entry.seen < 120 then
					destination = jobId
					break
				end
			end
		end
		if destination then
			options.ServerInstanceId = destination
		else
			options.ReservedServerAccessCode = reserveFresh()
		end
		options:SetTeleportData({ FishingWatersUpdateAttempt = attemptNumber })
		-- The player may have left while ReserveServerAsync was yielding.
		if player.Parent == Players and transfers[player] == state then
			TeleportService:TeleportAsync(game.PlaceId, { player }, options)
		end
	end)
	if not ok then
		-- A full/dead fallback needs a new reservation on the next attempt.
		fallbackCode = nil
		warn("[ServerUpdates] Transfer will retry: " .. tostring(failure))
		retry(player, state)
	end
	-- A successful API call is not proof that the player actually left.
	task.delay(45, function()
		if transfers[player] == state and state.attempts == attemptNumber then
			retry(player, state)
		end
	end)
end

local function transfer(player)
	if player.Parent ~= Players or transfers[player] or not outdated() then
		return
	end
	local state = { attempts = 0, waiting = false }
	transfers[player] = state
	player:SetAttribute("FishingWatersUpdateStatus", "Connecting")
	-- Give the replicated notice a moment to render, including during map loading.
	task.delay(2, function()
		attempt(player, state)
	end)
end

local function checkAdmissions()
	if not checked and not outdated() then
		return
	end
	for player in admissions do
		admissions[player] = nil
		if outdated() then
			transfer(player)
		end
	end
end

local function subscribe()
	if subscription then
		return
	end
	local ok, result = pcall(function()
		return MessagingService:SubscribeAsync(topic, function(message)
			local data = message.Data
			if type(data) ~= "table" then
				return
			end
			observe(data.version)
			if
				type(data.jobId) == "string"
				and data.jobId ~= ""
				and data.jobId ~= game.JobId
				and type(data.version) == "number"
				and data.version >= latest
			then
				destinations[data.jobId] = { version = data.version, seen = os.clock() }
			end
			checkAdmissions()
		end)
	end)
	if ok then
		subscription = result
	else
		warn("[ServerUpdates] Subscription will retry: " .. tostring(result))
	end
end

function Service.start()
	if started then
		return
	end
	started = true
	refreshNotice()
	-- Studio must never advertise its version or send players to live servers.
	if RunService:IsStudio() or game.PlaceId == 0 then
		return
	end
	local remote = Instance.new("RemoteEvent")
	remote.Name = "JoinUpdatedServer"
	remote.Parent = ReplicatedStorage
	remote.OnServerEvent:Connect(transfer)
	TeleportService.TeleportInitFailed:Connect(function(player, _, _, placeId, options)
		local state = transfers[player]
		if not state or placeId ~= game.PlaceId or not options then
			return
		end
		local data = options:GetTeleportData()
		if type(data) == "table" and data.FishingWatersUpdateAttempt == state.attempts then
			fallbackCode = nil
			retry(player, state)
		end
	end)
	local function joined(player)
		-- Includes FollowUserId/friend joins, invites, and arrivals by teleport.
		admissions[player] = true
		if outdated() then
			checkAdmissions()
		else
			task.spawn(function()
				syncVersion()
				checkAdmissions()
			end)
		end
	end
	Players.PlayerAdded:Connect(joined)
	Players.PlayerRemoving:Connect(function(player)
		admissions[player], transfers[player] = nil, nil
	end)
	game.ServerRestartScheduled:Connect(function(time, source)
		restartAt = time.UnixTimestamp
		ReplicatedStorage:SetAttribute(
			"FishingWatersRestartKind",
			if source == Enum.CloseReason.DeveloperUpdate then "Update" else "Maintenance"
		)
		refreshNotice()
		checkAdmissions()
	end)
	game:BindToClose(function()
		closing = true
		if subscription then
			subscription:Disconnect()
		end
	end)
	for _, player in Players:GetPlayers() do
		joined(player)
	end
	task.spawn(function()
		while not closing do
			subscribe()
			syncVersion()
			checkAdmissions()
			local ok, failure = pcall(function()
				MessagingService:PublishAsync(topic, {
					version = current,
					-- Reserved/VIP jobs cannot be joined by ServerInstanceId.
					jobId = if game.PrivateServerId == ""
							and not outdated()
							and #Players:GetPlayers() < Players.MaxPlayers
						then game.JobId
						else "",
				})
			end)
			if not ok then
				warn("[ServerUpdates] Announcement will retry: " .. tostring(failure))
			end
			for jobId, entry in destinations do
				if os.clock() - entry.seen >= 120 or entry.version < latest then
					destinations[jobId] = nil
				end
			end
			task.wait(60)
		end
	end)
end

return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="217">
        <Properties>
          <string name="Name">SharkLootService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local BoatService = require(script.Parent.BoatService)
local Data = require(script.Parent.AnglerData)
local SharkService = require(script.Parent.SharkService)
local Catalog = require(ReplicatedStorage.Shared.AnglerCatalog)
local Backpacks = require(ReplicatedStorage.Shared.BackpackCatalog)
local SharkDrops = require(ReplicatedStorage.Shared.SharkDrops)

local Service = {}
local started = false
local random = Random.new()

function Service.start()
	if started then
		return
	end
	started = true
	local remote = Instance.new("RemoteEvent")
	remote.Name = "SharkLoot"
	remote.Parent = ReplicatedStorage
	SharkService.setKillRewardCallback(function(player)
		local drops = SharkDrops.roll(random)
		local ids = {}
		for _, item in drops do
			table.insert(ids, item.FishId)
		end
		local caughtAt = os.time()
		local saved, overflow = false, false
		for attempt = 1, 4 do
			saved = BoatService.updateProgress(player, function(profile)
				local backpack = Backpacks.Items[profile.Angler.BackpackId] or Backpacks.Items.Starter
				profile.Angler, overflow = Data.recordSharkDrops(profile.Angler, ids, caughtAt, Catalog.Fish, backpack)
			end)
			if saved or player.Parent ~= Players then
				break
			end
			task.wait(attempt)
		end
		if player.Parent == Players then
			remote:FireClient(player, drops, saved, overflow)
		end
	end)
end

return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="218">
        <Properties>
          <string name="Name">SharkModel</string>
          <string name="Source"><![CDATA[-- The attack shark, built from mesh ellipsoids and wedge-pair triangle fins like
-- FishModels: a Ball part is always a sphere, so it cannot give a torpedo body.
-- Model space: the snout points -Z, +Y is up and the origin sits on the water
-- surface, so the dorsal fin and the upper tail lobe cut through the waves.
-- Every visible piece stores its SwimOffset. SwimFlex pieces bend at z = 1.6
-- and SwimTail pieces bend there and again at z = 3.2 (client SharkSwim pivots).
local SharkModel = {}

local FIN = 0.12
local rgb = Color3.fromRGB
local BACK, SIDE, BELLY = rgb(66, 80, 88), rgb(101, 117, 124), rgb(224, 226, 219)
local FIN_COLOR, GILL = rgb(74, 89, 97), rgb(46, 56, 61)
local MOUTH, TOOTH, EYE = rgb(58, 28, 32), rgb(240, 237, 224), rgb(12, 14, 16)

-- Long overlapping body sections from snout to tail stalk: centre, size
-- (width, height, length) and the swim segment that carries them. Each one
-- takes over the outline near a swim joint, so the body narrows smoothly
-- instead of pinching between bulges.
local SECTIONS = {
	{ "Snout", Vector3.new(0, -1.34, -3.95), Vector3.new(1.75, 1.3, 3.7) },
	{ "Body", Vector3.new(0, -1.4, -1.1), Vector3.new(3, 2.45, 6.8) },
	{ "RearBody", Vector3.new(0, -1.37, 2), Vector3.new(1.85, 1.6, 4.6), "SwimFlex" },
	{ "TailStalk", Vector3.new(0, -1.33, 4), Vector3.new(0.8, 0.9, 2.6), "SwimTail" },
}

function SharkModel.build(parent: Instance, frame: CFrame): Model
	local model = Instance.new("Model")
	model.Name = "Shark"
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 1, 1)
	root.Transparency = 1
	root.Anchored, root.CanCollide, root.CanTouch, root.CanQuery = true, false, false, false
	root.Parent = model
	model.PrimaryPart = root

	local segment: string? = nil
	local hull: { { c: Vector3, h: Vector3 } } = {}

	local function piece(class: string, name: string, size: Vector3, offset: CFrame, color: Color3): BasePart
		local item = Instance.new(class) :: BasePart
		item.Name = name
		item.Size = size
		item.CFrame = offset
		item.Color = color
		item.Material = Enum.Material.SmoothPlastic
		item.TopSurface, item.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		item.Anchored, item.CanCollide, item.CanTouch, item.CanQuery = true, false, false, false
		item:SetAttribute("SwimOffset", offset)
		if segment then
			item:SetAttribute(segment, true)
		end
		item.Parent = model
		return item
	end

	local function ellipsoid(name: string, offset: CFrame, size: Vector3, color: Color3): BasePart
		local item = piece("Part", name, size, offset, color)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = item
		return item
	end

	-- Grey flank with a darker back above and a white belly below.
	local function layered(name: string, center: Vector3, size: Vector3)
		local back, belly = Vector3.new(0, size.Y * 0.12, 0), Vector3.new(0, size.Y * 0.15, 0)
		local layers = {
			{ name, center, size, SIDE },
			{ name .. "Back", center + back, size * Vector3.new(0.97, 0.86, 1), BACK },
			{ name .. "Belly", center - belly, size * Vector3.new(0.95, 0.78, 0.99), BELLY },
		}
		for _, layer in layers do
			table.insert(hull, { c = layer[2], h = layer[3] / 2 })
			ellipsoid(layer[1], CFrame.new(layer[2]), layer[3], layer[4])
		end
	end

	-- Half-width of the body surface at height y and length z.
	local function surfaceX(y: number, z: number): number
		local best = 0
		for _, section in hull do
			local dy, dz = (y - section.c.Y) / section.h.Y, (z - section.c.Z) / section.h.Z
			local remaining = 1 - dy * dy - dz * dz
			if remaining > 0 then
				best = math.max(best, section.h.X * math.sqrt(remaining))
			end
		end
		return best
	end

	-- Two wedges split at the foot of the longest edge's altitude.
	local function triangle(name: string, a: Vector3, b: Vector3, c: Vector3, color: Color3, thickness: number)
		local ab, ac, bc = b - a, c - a, c - b
		local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
		if abd > acd and abd > bcd then
			c, a = a, c
		elseif acd > bcd and acd > abd then
			a, b = b, a
		end
		ab, ac, bc = b - a, c - a, c - b
		local normal = ac:Cross(ab)
		if normal.Magnitude < 1e-7 then
			return
		end
		local right = normal.Unit
		local up = bc:Cross(right).Unit
		local back = bc.Unit
		local height = math.abs(ab:Dot(up))
		piece(
			"WedgePart",
			name,
			Vector3.new(thickness, height, math.abs(ab:Dot(back))),
			CFrame.fromMatrix((a + b) / 2, right, up, back),
			color
		)
		piece(
			"WedgePart",
			name,
			Vector3.new(thickness, height, math.abs(ac:Dot(back))),
			CFrame.fromMatrix((a + c) / 2, -right, up, -back),
			color
		)
	end

	-- Fan triangulation from the first point.
	local function fin(name: string, points: { Vector3 }, color: Color3, thickness: number?)
		for index = 2, #points - 1 do
			triangle(name, points[1], points[index], points[index + 1], color, thickness or FIN)
		end
	end

	for _, section in SECTIONS do
		segment = section[4]
		layered(section[1], section[2], section[3])
	end

	segment = nil
	-- Underslung mouth with a row of teeth along the front of the upper jaw.
	ellipsoid("Mouth", CFrame.new(0, -2.08, -3.5), Vector3.new(1.7, 0.22, 1.15), MOUTH)
	ellipsoid("LowerJaw", CFrame.new(0, -2.25, -3.2), Vector3.new(1.5, 0.28, 1.4), BELLY)
	for _, angle in { -0.75, -0.25, 0.25, 0.75 } do
		local center = Vector3.new(math.sin(angle) * 0.78, -2.06, -3.5 - math.cos(angle) * 0.52)
		local along = Vector3.new(math.cos(angle) * 0.78, 0, math.sin(angle) * 0.52).Unit * 0.08
		fin("Tooth", { center - along, center + along, center + Vector3.new(0, -0.24, 0) }, TOOTH, 0.04)
	end
	for _, side in { -1, 1 } do
		local label = if side < 0 then "Left" else "Right"
		ellipsoid(
			label .. "Eye",
			CFrame.new(side * (surfaceX(-1.12, -3.4) - 0.05), -1.12, -3.4),
			Vector3.new(0.16, 0.27, 0.29),
			EYE
		)
		for index = 0, 4 do
			local z = -2.25 + index * 0.25
			ellipsoid(
				label .. "Gill" .. index + 1,
				CFrame.new(side * (surfaceX(-1.5, z) - 0.03), -1.5, z) * CFrame.Angles(0.12, 0, 0),
				Vector3.new(0.1, 0.95 - index * 0.05, 0.07),
				GILL
			)
		end
		-- Long swept pectoral fins, angled down and back from the lower flank.
		fin(label .. "PectoralFin", {
			Vector3.new(side * 1.2, -1.85, -2.05),
			Vector3.new(side * 2.4, -2.2, -1.2),
			Vector3.new(side * 3.55, -2.75, 0.35),
			Vector3.new(side * 2.45, -2.45, -0.25),
			Vector3.new(side * 1.15, -2.15, -0.95),
		}, FIN_COLOR)
	end
	-- Tall dorsal fin with a concave trailing edge and a free rear tip.
	fin("DorsalFin", {
		Vector3.new(0, -0.35, 0.1),
		Vector3.new(0, -0.3, -1.05),
		Vector3.new(0, 0.75, -0.25),
		Vector3.new(0, 1.55, 0.75),
		Vector3.new(0, 0.45, 0.92),
		Vector3.new(0, -0.15, 1.35),
	}, FIN_COLOR)

	segment = "SwimFlex"
	fin(
		"RearDorsalFin",
		{ Vector3.new(0, -0.8, 2.4), Vector3.new(0, -0.2, 2.85), Vector3.new(0, -0.75, 3.1) },
		FIN_COLOR
	)
	fin("AnalFin", { Vector3.new(0, -1.95, 2.5), Vector3.new(0, -2.5, 3), Vector3.new(0, -1.95, 3.15) }, FIN_COLOR)
	for _, side in { -1, 1 } do
		fin((if side < 0 then "Left" else "Right") .. "PelvicFin", {
			Vector3.new(side * 0.5, -1.95, 1.75),
			Vector3.new(side * 1.35, -2.45, 2.75),
			Vector3.new(side * 0.45, -2.1, 2.45),
		}, FIN_COLOR)
	end

	segment = "SwimTail"
	-- Near-crescent tail: the upper lobe is a little longer than the lower one.
	ellipsoid("CaudalKeel", CFrame.new(0, -1.33, 4.2), Vector3.new(1.05, 0.16, 1.7), BACK)
	fin("Tail", {
		Vector3.new(0, -1.33, 4.4),
		Vector3.new(0, -0.95, 4.55),
		Vector3.new(0, 1.25, 6.35),
		Vector3.new(0, 0.05, 5.55),
		Vector3.new(0, -1.3, 5.2),
		Vector3.new(0, -3.15, 5.95),
		Vector3.new(0, -1.7, 4.6),
	}, FIN_COLOR)

	model:PivotTo(frame)
	model.Parent = parent
	return model
end

return SharkModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="219">
        <Properties>
          <string name="Name">SharkService</string>
          <string name="Source"><![CDATA[-- Sharks are server-controlled so every crew member sees the same attacks.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Biomes = require(Shared.Biomes)
local DayNight = require(Shared.DayNight)
local Weather = require(Shared.Weather)
local SpearSkins = require(Shared.SpearSkins)
local HullDamage = require(script.Parent.HullDamage)
local BoatService = require(script.Parent.BoatService)
local SharkModel = require(script.Parent.SharkModel)

local SharkService = {}
-- Sharks roam in packs of 1-3 around each boat at sea and only give chase when
-- a hull happens to pass within AGGRO_RANGE of a pack member.
local DAY_PACKS = 1
local NIGHT_PACKS = 2
local MIN_PACK_SIZE = 1
local MAX_PACK_SIZE = 3
local SPAWN_DELAY = 8
local SPAWN_DISTANCE = 120
local ROAM_SPEED = 12
local CHASE_SPEED = 55
local AGGRO_RANGE = 30
local LOSE_RANGE = 150
local DESPAWN_RANGE = 450
local PACK_SPACING = 7
local BITE_DAMAGE = 8
local BITE_INTERVAL = 12
local BITE_REACH = 4
local BITE_STANDOFF = 3.5
local STEP = 0.1
local random = Random.new()
local SHARK_HEALTH = 15
local CONTRIBUTION_WINDOW = 30
local SPEAR_RANGE = 24
local SPEAR_COOLDOWN = 0.6
local sharksByModel = {}
local lastAttack = {}
local rewardCallback

-- Called once per eligible contributor when a shark dies. The caller owns
-- reward generation and persistence, keeping combat independent of inventory.
function SharkService.setKillRewardCallback(callback)
	rewardCallback = callback
end

local function removeShark(shark)
	sharksByModel[shark.model] = nil
	shark.model:Destroy()
end

local function damageShark(player: Player, shark, now: number, damage: number)
	if shark.dead or sharksByModel[shark.model] ~= shark then
		return
	end
	shark.contributors[player] = now
	shark.health = math.max(0, shark.health - damage)
	shark.model:SetAttribute("Health", shark.health)
	if shark.health > 0 then
		return
	end
	shark.dead = true
	removeShark(shark)
	if rewardCallback then
		for contributor, hitTime in shark.contributors do
			if contributor.Parent == Players and now - hitTime <= CONTRIBUTION_WINDOW then
				task.spawn(function()
					local ok, err = pcall(rewardCallback, contributor)
					if not ok then
						warn("[Sharks] Could not award drops: " .. tostring(err))
					end
				end)
			end
		end
	end
end

local function finiteVector(value): boolean
	return typeof(value) == "Vector3"
		and value.X == value.X
		and value.Y == value.Y
		and value.Z == value.Z
		and math.abs(value.X) < 1e7
		and math.abs(value.Y) < 1e7
		and math.abs(value.Z) < 1e7
end

local function attack(player: Player, aim)
	if not finiteVector(aim) or player:GetAttribute("OwnsBasicSpear") ~= true then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return
	end
	local equipped = false
	for _, child in character:GetChildren() do
		if
			child:IsA("Tool")
			and child:GetAttribute("SpearId") == "BasicSpear"
			and child:GetAttribute("OwnerUserId") == player.UserId
		then
			equipped = true
			break
		end
	end
	if not equipped then
		return
	end
	local boosts = SpearSkins.boosts(player:GetAttribute("SpearSkin"), player:GetAttribute("SpearSkinWear"))
	local now = workspace:GetServerTimeNow()
	if now - (lastAttack[player] or -math.huge) < SPEAR_COOLDOWN / (1 + boosts.fireRate) then
		return
	end
	lastAttack[player] = now
	local origin = root.Position
	local delta = aim - origin
	if delta.Magnitude < 0.01 then
		return
	end
	local direction = delta.Unit
	local best, bestDistance
	for model, shark in sharksByModel do
		if not shark.dead and model.PrimaryPart then
			local center = model.PrimaryPart.Position + Vector3.new(0, -1.3, 0)
			local along = (center - origin):Dot(direction)
			local closest = origin + direction * math.clamp(along, 0, SPEAR_RANGE)
			-- The shark model is about 12 studs long; use a generous hit volume
			-- so aiming at its moving fins and tail is practical.
			if
				along > 0
				and along <= SPEAR_RANGE
				and (center - closest).Magnitude <= 5.5
				and (not bestDistance or along < bestDistance)
			then
				best, bestDistance = shark, along
			end
		end
	end
	if best then
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local excluded = { character, workspace:FindFirstChild("Sharks") }
		params.FilterDescendantsInstances = excluded
		params.IgnoreWater = true
		-- A deck or railing should not block a crew member from attacking the
		-- shark alongside their boat. Other boats and world geometry still do.
		local boats = workspace:FindFirstChild("PlayerBoats")
		local floor = workspace:Raycast(origin, Vector3.new(0, -10, 0), params)
		if boats and floor and floor.Instance and floor.Instance:IsDescendantOf(boats) then
			local boat = floor.Instance
			while boat.Parent and boat.Parent ~= boats do
				boat = boat.Parent
			end
			if boat.Parent == boats then
				table.insert(excluded, boat)
				params.FilterDescendantsInstances = excluded
			end
		end
		local obstruction = workspace:Raycast(origin, direction * bestDistance, params)
		if not obstruction then
			damageShark(player, best, now, 1 + boosts.damage)
		end
	end
end

local function isOpenWater(position: Vector3, params: RaycastParams): boolean
	if
		not Biomes.inOceanBounds(position)
		or Weather.inLake(position)
	then
		return false
	end
	local hit =
		workspace:Raycast(Vector3.new(position.X, Biomes.WaterLevel + 25, position.Z), Vector3.new(0, -40, 0), params)
	return hit ~= nil and hit.Material == Enum.Material.Water
end

local function spawnPosition(target: Vector3, params: RaycastParams): Vector3?
	local start = random:NextNumber(0, math.pi * 2)
	for index = 0, 11 do
		local angle = start + index * math.pi / 6
		local candidate = target + Vector3.new(math.cos(angle) * SPAWN_DISTANCE, 0, math.sin(angle) * SPAWN_DISTANCE)
		if isOpenWater(candidate, params) then
			return candidate
		end
	end
	return nil
end

local function headingVector(heading: number): Vector3
	return Vector3.new(math.cos(heading), 0, math.sin(heading))
end

-- Members trail the leader in a loose arrowhead.
local function formationPosition(center: Vector3, heading: number, index: number): Vector3
	if index == 1 then
		return center
	end
	local forward = headingVector(heading)
	local right = Vector3.new(-forward.Z, 0, forward.X)
	local side = if index == 2 then -1 else 1
	return center + right * (side * PACK_SPACING) - forward * PACK_SPACING
end

-- Flat offset from a position to the closest point on a hull, rather than a
-- large circular radius that would let sharks bite from far off a long side.
local function hullOffset(entry, position: Vector3): Vector3
	local root = entry.root
	local localPosition = root.CFrame:PointToObjectSpace(position)
	local halfBeam = (entry.boat:GetAttribute("HullBeam") or root.Size.X) / 2
	local halfLength = (entry.boat:GetAttribute("HullLength") or root.Size.Z) / 2
	local closest = root.CFrame:PointToWorldSpace(
		Vector3.new(
			math.clamp(localPosition.X, -halfBeam, halfBeam),
			0,
			math.clamp(localPosition.Z, -halfLength, halfLength)
		)
	)
	return Vector3.new(closest.X - position.X, 0, closest.Z - position.Z)
end

local function nearestMember(pack, entry): number
	local best = math.huge
	for _, shark in pack.sharks do
		best = math.min(best, hullOffset(entry, shark.position).Magnitude)
	end
	return best
end

local function removePack(packs, index: number)
	for _, shark in packs[index].sharks do
		if not shark.dead then
			removeShark(shark)
		end
	end
	table.remove(packs, index)
end

local function spawnPack(folder: Folder, owner: Player, root: BasePart, params: RaycastParams, now: number, weather)
	local center = spawnPosition(root.Position, params)
	if not center then
		return nil
	end
	-- Head roughly away from the boat so an encounter depends on where the
	-- player steers, not on the pack homing in.
	local outward = Vector3.new(center.X - root.Position.X, 0, center.Z - root.Position.Z)
	local heading = math.atan2(outward.Z, outward.X) + random:NextNumber(-1.2, 1.2)
	local pack = { owner = owner, sharks = {}, center = center, heading = heading }
	local facing = headingVector(heading)
	for index = 1, random:NextInteger(MIN_PACK_SIZE, MAX_PACK_SIZE) do
		local position = formationPosition(center, heading, index)
		if not isOpenWater(position, params) then
			position = center
		end
		local surface =
			Vector3.new(position.X, Biomes.WaterLevel + Weather.heightAt(position, now, weather), position.Z)
		local model = SharkModel.build(folder, CFrame.lookAt(surface, surface + facing))
		model:SetAttribute("Health", SHARK_HEALTH)
		model:SetAttribute("MaxHealth", SHARK_HEALTH)
		local shark = {
			model = model,
			position = position,
			direction = facing,
			lastBite = now,
			stuck = 0,
			health = SHARK_HEALTH,
			contributors = {},
		}
		sharksByModel[model] = shark
		table.insert(pack.sharks, shark)
	end
	return pack
end

local function moveShark(shark, goal: Vector3, speed: number, params: RaycastParams, keepDistance: number)
	local offset = Vector3.new(goal.X - shark.position.X, 0, goal.Z - shark.position.Z)
	local distance = offset.Magnitude
	if distance > 0.01 then
		shark.direction = offset.Unit
	end
	if distance <= keepDistance then
		return
	end
	local nextPosition = shark.position + shark.direction * math.min(speed * STEP, distance - keepDistance)
	if isOpenWater(nextPosition, params) then
		shark.position, shark.stuck = nextPosition, 0
	else
		shark.stuck += STEP
	end
end

function SharkService.start()
	local folder = Instance.new("Folder")
	folder.Name = "Sharks"
	folder.Parent = workspace
	local spearAttack = Instance.new("RemoteEvent")
	spearAttack.Name = "SpearAttack"
	spearAttack.Parent = ReplicatedStorage
	spearAttack.OnServerEvent:Connect(attack)
	Players.PlayerRemoving:Connect(function(player)
		lastAttack[player] = nil
		for _, shark in sharksByModel do
			shark.contributors[player] = nil
		end
	end)
	local spawnTimers = {}
	local packs = {}
	task.spawn(function()
		while true do
			local now = workspace:GetServerTimeNow()
			local night = DayNight.isNight(DayNight.clockTime(now))
			local weather = Weather.getState(now)
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			local excluded = { folder, workspace:FindFirstChild("PlayerBoats") }
			for _, player in Players:GetPlayers() do
				if player.Character then
					table.insert(excluded, player.Character)
				end
			end
			params.FilterDescendantsInstances = excluded
			params.IgnoreWater = false
			params.RespectCanCollide = true
			local boats = {}
			for _, player in Players:GetPlayers() do
				local _, boat = BoatService.activeBoat(player)
				local root = boat and boat.PrimaryPart
				local health = boat and boat:GetAttribute("Health")
				local eligible = root
					and type(health) == "number"
					and health > 0
					and math.abs(root.Position.Y - Biomes.WaterLevel) < 20
					and isOpenWater(root.Position, params)
				if eligible then
					table.insert(boats, { player = player, boat = boat, root = root })
				end
			end

			for index = #packs, 1, -1 do
				local pack = packs[index]
				for sharkIndex = #pack.sharks, 1, -1 do
					local shark = pack.sharks[sharkIndex]
					if shark.dead or shark.stuck > 3 then
						if not shark.dead then
							removeShark(shark)
						end
						table.remove(pack.sharks, sharkIndex)
					end
				end
				if #pack.sharks == 0 then
					table.remove(packs, index)
				end
			end

			local seen = {}
			for _, entry in boats do
				local player = entry.player
				seen[player] = true
				local timer = spawnTimers[player]
				if not timer or timer.boat ~= entry.boat then
					timer = { boat = entry.boat, nextSpawn = now + SPAWN_DELAY }
					spawnTimers[player] = timer
				end
				local count = if night then NIGHT_PACKS else DAY_PACKS
				local owned = {}
				for index, pack in packs do
					if pack.owner == player then
						table.insert(owned, index)
					end
				end
				-- Extra packs swim off when day returns, but never mid-chase.
				for position = #owned, 1, -1 do
					if #owned <= count then
						break
					end
					local index = owned[position]
					if not packs[index].target then
						removePack(packs, index)
						table.remove(owned, position)
					end
				end
				if #owned < count and now >= timer.nextSpawn then
					local pack = spawnPack(folder, player, entry.root, params, now, weather)
					if pack then
						table.insert(packs, pack)
					end
					timer.nextSpawn = now + SPAWN_DELAY
				end
			end
			for player in spawnTimers do
				if not seen[player] then
					spawnTimers[player] = nil
				end
			end

			for index = #packs, 1, -1 do
				local pack = packs[index]
				if pack.owner and not seen[pack.owner] then
					pack.owner = nil
				end
				local target
				if pack.target then
					for _, entry in boats do
						if entry.boat == pack.target.boat and entry.player == pack.target.player then
							target = entry
							break
						end
					end
					if target and nearestMember(pack, target) > LOSE_RANGE then
						target = nil
					end
				end
				if not target then
					for _, entry in boats do
						if nearestMember(pack, entry) <= AGGRO_RANGE then
							target = entry
							break
						end
					end
				end
				if pack.target and not target then
					-- Give up and turn away rather than drifting after the boat.
					pack.heading += math.pi + random:NextNumber(-0.6, 0.6)
				end
				pack.target = target
				if not target then
					local nearby = false
					for _, entry in boats do
						if (entry.root.Position - pack.center).Magnitude <= DESPAWN_RANGE then
							nearby = true
							break
						end
					end
					if not nearby then
						removePack(packs, index)
						continue
					end
				end

				if target then
					local sum = Vector3.new(0, 0, 0)
					for _, shark in pack.sharks do
						local offset = hullOffset(target, shark.position)
						-- Stop inside bite range: float32 world coordinates can round
						-- an exact-range stop outside it and prevent every bite.
						moveShark(shark, shark.position + offset, CHASE_SPEED, params, BITE_STANDOFF)
						local distance = hullOffset(target, shark.position).Magnitude
						if distance <= BITE_REACH and now - shark.lastBite >= BITE_INTERVAL then
							if BoatService.damageBoat(target.player, BITE_DAMAGE) then
								-- Scar the hull where the shark struck. Its own thread keeps a
								-- cosmetic failure from stopping every shark in this loop.
								local surface = Vector3.new(
									shark.position.X,
									Biomes.WaterLevel + Weather.heightAt(shark.position, now, weather),
									shark.position.Z
								)
								task.spawn(HullDamage.bite, target.boat, surface, shark.direction)
							end
							shark.lastBite = now
						end
						sum += shark.position
					end
					pack.center = sum * (1 / #pack.sharks)
					local lead = pack.sharks[1].direction
					pack.heading = math.atan2(lead.Z, lead.X)
				else
					pack.heading += random:NextNumber(-0.06, 0.06)
					local nextCenter = pack.center + headingVector(pack.heading) * (ROAM_SPEED * STEP)
					if isOpenWater(nextCenter, params) then
						pack.center = nextCenter
					else
						pack.heading += math.pi * random:NextNumber(0.5, 1)
					end
					for sharkIndex, shark in pack.sharks do
						-- Stragglers catch up to their slot, then cruise with the pack.
						local goal = formationPosition(pack.center, pack.heading, sharkIndex)
						moveShark(shark, goal, ROAM_SPEED * 2, params, 0)
					end
				end

				for _, shark in pack.sharks do
					local wave = Weather.heightAt(shark.position, now, weather)
					local surface = Vector3.new(shark.position.X, Biomes.WaterLevel + wave, shark.position.Z)
					local biteAge = now - shark.lastBite
					local lunge = if target and biteAge < 0.6 then math.sin(biteAge / 0.6 * math.pi) * 1.5 else 0
					local direction = shark.direction
					shark.model:PivotTo(CFrame.lookAt(surface + direction * lunge, surface + direction * (lunge + 1)))
				end
			end
			task.wait(STEP)
		end
	end)
end

return SharkService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="220">
        <Properties>
          <string name="Name">Speedboat</string>
          <string name="Source"><![CDATA[-- Blue-and-white sport cruiser. Waterline origin; local -Z is the bow.
-- The faceted V hull and cockpit sole form one welded, server-driven assembly.
local Speedboat = {}
local WHITE = Color3.fromRGB(237, 241, 246)
local BLUE = Color3.fromRGB(8, 113, 166)
local DECK = Color3.fromRGB(185, 204, 212)
local DARK = Color3.fromRGB(40, 51, 61)
local GLASS = Color3.fromRGB(62, 83, 99)
local METAL = Color3.fromRGB(122, 139, 151)
local THICKNESS = 0.18

function Speedboat.build(frame: CFrame, anchored: boolean?): Model
	local isAnchored = anchored == true
	local model = Instance.new("Model")
	model.Name = "Speedboat"
	model:SetAttribute("HullLength", 24)
	model:SetAttribute("HullBeam", 9.6)
	model:SetAttribute("PassengerSeats", 2)
	model:SetAttribute("DriverSeat", "HelmSeat")
	model:SetAttribute("DryFloorHeight", 1.1)
	model:SetAttribute("DryFloorHalfBeam", 4.2)
	model:SetAttribute("DryFloorHalfLength", 10.85)

	local root = Instance.new("Part")
	root.Name = "HullRoot"
	root.Size = Vector3.new(5.6, 0.5, 14)
	root.CFrame = frame * CFrame.new(0, -0.4, 0)
	root.Transparency = 1
	root.Anchored = isAnchored
	root.CanCollide = false
	root.CanTouch = false
	root.RootPriority = 127
	root.CustomPhysicalProperties = PhysicalProperties.new(1.4, 0.45, 0.05, 100, 100)
	root.Parent = model
	model.PrimaryPart = root

	local function finish(p: BasePart, name: string, color: Color3, material: Enum.Material?, collide: boolean?)
		p.Name = name
		p.Anchored = isAnchored
		p.CanCollide = collide == true
		p.CanTouch = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.Massless = true
		p.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = p
		weld.Parent = p
		return p
	end

	local function part(
		name: string,
		size: Vector3,
		localFrame: CFrame,
		color: Color3,
		material: Enum.Material?,
		collide: boolean?
	): Part
		local p = Instance.new("Part")
		p.Size = size
		p.CFrame = frame * localFrame
		finish(p, name, color, material, collide)
		return p
	end

	local function beam(
		name: string,
		a: Vector3,
		b: Vector3,
		width: number,
		depth: number,
		color: Color3,
		material: Enum.Material?,
		collide: boolean?
	): Part
		return part(
			name,
			Vector3.new(width, depth, (b - a).Magnitude),
			CFrame.lookAt((a + b) / 2, b),
			color,
			material,
			collide
		)
	end

	-- Thin facets form an open hull; there is no solid collision box through it.
	local function triangle(name: string, a: Vector3, b: Vector3, c: Vector3, inside: Vector3, color: Color3)
		local ab, ac, bc = b - a, c - a, c - b
		local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
		if abd > acd and abd > bcd then
			c, a = a, c
		elseif acd > bcd and acd > abd then
			a, b = b, a
		end
		ab, ac, bc = b - a, c - a, c - b
		local right = ac:Cross(ab).Unit
		local up = bc:Cross(right).Unit
		local back = bc.Unit
		local height = math.abs(ab:Dot(up))
		local normal = if right:Dot((a + b + c) / 3 - inside) >= 0 then right else -right
		local shift = -normal * THICKNESS / 2
		local first = Instance.new("WedgePart")
		first.Size = Vector3.new(THICKNESS, height, math.abs(ab:Dot(back)))
		first.CFrame = frame * CFrame.fromMatrix((a + b) / 2 + shift, right, up, back)
		finish(first, name, color, nil, true)
		local second = Instance.new("WedgePart")
		second.Size = Vector3.new(THICKNESS, height, math.abs(ac:Dot(back)))
		second.CFrame = frame * CFrame.fromMatrix((a + c) / 2 + shift, -right, up, -back)
		finish(second, name, color, nil, true)
	end

	local stations = {
		{ z = -10.85, width = 0.18, bottom = 0.12, top = 3.0, keel = -0.05 },
		{ z = -8.0, width = 3.3, bottom = 1.8, top = 2.55, keel = -1.3 },
		{ z = -3.5, width = 4.65, bottom = 3.95, top = 2.2, keel = -1.5 },
		{ z = 3.5, width = 4.65, bottom = 3.95, top = 2.2, keel = -1.5 },
		{ z = 8.5, width = 4.4, bottom = 4.1, top = 2.2, keel = -1.25 },
		{ z = 10.8, width = 3.65, bottom = 2.8, top = 2.3, keel = -0.95 },
	}
	local function hullPoint(station, side: number, level: number): Vector3
		local bottomY = if station.z < -10 then 0.25 else -0.72
		return Vector3.new(
			side * (station.bottom + (station.width - station.bottom) * level),
			bottomY + (station.top - bottomY) * level,
			station.z
		)
	end
	-- Each cross-section curves inward through the bilge to the center keel.
	-- These panels close the underside all the way from bow to transom.
	local function bottomPoint(station, side: number, level: number): Vector3
		if level == 0 then
			return hullPoint(station, side, 0)
		elseif level == 1 then
			local edge = hullPoint(station, side, 0)
			return Vector3.new(side * station.bottom * 0.52, station.keel + (edge.Y - station.keel) * 0.42, station.z)
		end
		return Vector3.new(0, station.keel, station.z)
	end
	for _, side in { -1, 1 } do
		for i = 1, #stations - 1 do
			local from, to = stations[i], stations[i + 1]
			for _, band in { { 0, 0.68, BLUE }, { 0.68, 1, WHITE } } do
				local a, b = hullPoint(from, side, band[1]), hullPoint(to, side, band[1])
				local c, d = hullPoint(to, side, band[2]), hullPoint(from, side, band[2])
				local inside = Vector3.new(0, 0.8, (from.z + to.z) / 2)
				triangle("HullPanel", a, b, c, inside, band[3])
				triangle("HullPanel", a, c, d, inside, band[3])
			end
			for band = 0, 1 do
				local a, b = bottomPoint(from, side, band), bottomPoint(to, side, band)
				local c, d = bottomPoint(to, side, band + 1), bottomPoint(from, side, band + 1)
				local inside = Vector3.new(0, 0.8, (from.z + to.z) / 2)
				local name = if band == 0 then "BilgePanel" else "BottomPanel"
				triangle(name, a, b, c, inside, BLUE)
				triangle(name, a, c, d, inside, BLUE)
			end
			beam("Gunwale", hullPoint(from, side, 1), hullPoint(to, side, 1), 0.3, 0.24, DARK)
		end
	end
	for _, station in { stations[1], stations[#stations] } do
		local center = Vector3.new(0, hullPoint(station, 1, 0).Y, station.z)
		local inside = Vector3.new(0, 0.8, 0)
		for _, side in { -1, 1 } do
			local edge, bilge, keel =
				bottomPoint(station, side, 0), bottomPoint(station, side, 1), bottomPoint(station, side, 2)
			triangle("HullEndCap", edge, bilge, keel, inside, BLUE)
			triangle("HullEndCap", edge, keel, center, inside, BLUE)
		end
		if station == stations[1] then
			local left, right = hullPoint(station, -1, 1), hullPoint(station, 1, 1)
			triangle("BowCap", center, left, right, inside, BLUE)
			triangle("BowCap", center, hullPoint(station, -1, 0), left, inside, BLUE)
			triangle("BowCap", center, right, hullPoint(station, 1, 0), inside, BLUE)
		end
	end
	local stern = stations[#stations]
	local sternLeft, sternRight = hullPoint(stern, -1, 0), hullPoint(stern, 1, 0)
	triangle("Transom", sternLeft, sternRight, hullPoint(stern, 1, 1), Vector3.new(0, 0.8, 0), WHITE)
	triangle("Transom", sternLeft, hullPoint(stern, 1, 1), hullPoint(stern, -1, 1), Vector3.new(0, 0.8, 0), WHITE)
	part("TransomTrim", Vector3.new(7.4, 0.5, 0.23), CFrame.new(0, 2.04, 10.8), WHITE)
	part("TransomCap", Vector3.new(7.5, 0.2, 0.3), CFrame.new(0, 2.3, 10.8), WHITE)
	for index = 1, #stations - 1 do
		beam(
			"Keel",
			bottomPoint(stations[index], 1, 2),
			bottomPoint(stations[index + 1], 1, 2),
			0.18,
			0.16,
			BLUE,
			nil,
			true
		)
	end
	part("BowStem", Vector3.new(0.3, 2.85, 0.25), CFrame.new(0, 1.625, -10.85), WHITE)

	-- Continuous planks provide a working bow deck and two clear side walkways.
	local function deckWidth(station): number
		local bottomY = if station.z < -10 then 0.25 else -0.72
		local level = (1.1 - bottomY) / (station.top - bottomY)
		return math.max(0, station.bottom + (station.width - station.bottom) * level - 0.15)
	end
	for i = -7, 7 do
		local outside = (math.abs(i) + 0.5) * 0.55
		local startZ, endZ = stations[1].z, stations[#stations].z - 0.15
		for index = 1, #stations - 1 do
			local a, b = stations[index], stations[index + 1]
			local fromWidth, toWidth = deckWidth(a), deckWidth(b)
			if fromWidth < outside and toWidth >= outside then
				startZ = a.z + (b.z - a.z) * (outside - fromWidth) / (toWidth - fromWidth)
			elseif fromWidth >= outside and toWidth < outside then
				endZ = a.z + (b.z - a.z) * (outside - fromWidth) / (toWidth - fromWidth)
			end
		end
		part(
			"WorkingDeck",
			Vector3.new(0.55, 0.22, endZ - startZ),
			CFrame.new(i * 0.55, 0.99, (startZ + endZ) / 2),
			DECK,
			Enum.Material.SmoothPlastic,
			true
		)
	end

	-- Fitted bow deck closes the forward hull while leaving the cockpit open.
	for index = 1, 3 do
		local a, b = stations[index], stations[index + 1]
		local centerA = Vector3.new(0, a.top - 0.12, a.z)
		local centerB = Vector3.new(0, b.top - 0.12, b.z)
		for _, side in { -1, 1 } do
			local edgeA = hullPoint(a, side, 1) - Vector3.new(0, 0.12, 0)
			local edgeB = hullPoint(b, side, 1) - Vector3.new(0, 0.12, 0)
			-- End the foredeck ahead of the helm, rather than covering the cockpit.
			if index == 3 then
				centerB = Vector3.new(0, 2.08, -0.8)
				edgeB = Vector3.new(side * 4.65, 2.08, -0.8)
			end
			triangle("Foredeck", centerA, edgeA, edgeB, Vector3.new(0, 0, -4), WHITE)
			triangle("Foredeck", centerA, edgeB, centerB, Vector3.new(0, 0, -4), WHITE)
		end
	end
	part("DeckStripe", Vector3.new(1.3, 0.035, 5.5), CFrame.new(0, 2.105, -3.6), BLUE)
	part("ForedeckHatchRim", Vector3.new(2.05, 0.12, 1.65), CFrame.new(0, 2.19, -4.6), METAL)
	part("ForedeckHatch", Vector3.new(1.8, 0.14, 1.4), CFrame.new(0, 2.26, -4.6), DARK)

	-- Swept windshield: dark glazing, white frame, and small triangular sides.
	local screenBottom = Vector3.new(0, 2.28, -0.7)
	local screenTop = Vector3.new(0, 4.15, 1.25)
	local windshield = beam("Windshield", screenBottom, screenTop, 6.0, 0.12, GLASS)
	windshield.Transparency = 0.2
	beam("WindshieldHeader", screenTop + Vector3.new(-3.1, 0, 0), screenTop + Vector3.new(3.1, 0, 0), 0.2, 0.2, WHITE)
	beam(
		"WindshieldSill",
		screenBottom + Vector3.new(-3.1, 0, 0),
		screenBottom + Vector3.new(3.1, 0, 0),
		0.24,
		0.24,
		WHITE
	)
	beam("WindshieldMullion", screenBottom, screenTop, 0.18, 0.18, WHITE)
	for _, side in { -1, 1 } do
		local front = screenBottom + Vector3.new(side * 3.1, 0, 0)
		local top = screenTop + Vector3.new(side * 3.1, 0, 0)
		local rear = Vector3.new(side * 3.1, 2.28, 3.0)
		beam("WindshieldPillar", front, top, 0.24, 0.24, WHITE)
		beam("WindowRearFrame", top, rear, 0.2, 0.2, WHITE)
		triangle("SideWindow", front, top, rear, Vector3.new(0, 2.4, 1), GLASS)
		part("CockpitCoaming", Vector3.new(0.35, 0.28, 9.8), CFrame.new(side * 3.3, 2.3, 5.85), WHITE)
		-- Round portholes with a pale rim along the blue hull.
		for _, z in { -2.8, 3.7, 8.1 } do
			local width = 0
			for index = 1, #stations - 1 do
				local a, b = stations[index], stations[index + 1]
				if z >= a.z and z <= b.z then
					local function widthAt(station)
						return station.bottom + (station.width - station.bottom) * (0.85 + 0.72) / (station.top + 0.72)
					end
					width = widthAt(a) + (widthAt(b) - widthAt(a)) * (z - a.z) / (b.z - a.z)
					break
				end
			end
			local rim =
				part("PortholeRim", Vector3.new(0.12, 0.65, 0.65), CFrame.new(side * (width + 0.045), 0.85, z), WHITE)
			rim.Shape = Enum.PartType.Cylinder
			local glass =
				part("PortholeGlass", Vector3.new(0.14, 0.43, 0.43), CFrame.new(side * (width + 0.11), 0.85, z), DARK)
			glass.Shape = Enum.PartType.Cylinder
		end
		-- Low rails follow the pointed bow and stop before the boarding cockpit.
		local railPoints = {
			Vector3.new(side * 0.22, 3.7, -10.5),
			Vector3.new(side * 3.15, 3.3, -8.0),
			Vector3.new(side * 4.4, 3.0, -3.5),
			Vector3.new(side * 4.4, 3.0, -0.9),
		}
		for index, point in railPoints do
			part("BowRailPost", Vector3.new(0.09, 0.75, 0.09), CFrame.new(point - Vector3.new(0, 0.375, 0)), METAL)
			if index > 1 then
				beam("BowRail", railPoints[index - 1], point, 0.1, 0.1, METAL)
			end
		end
		-- Stop the cushion at the front face of the backrest. The previous
		-- overlap left coincident blue faces along the seat's side edges.
		part("SternCushion", Vector3.new(2.15, 0.28, 1.425), CFrame.new(side * 1.6, 1.72, 8.4125), BLUE)
		part("SternBackrest", Vector3.new(2.15, 0.95, 0.25), CFrame.new(side * 1.6, 2.24, 9.25), WHITE)
		local passenger = Instance.new("Seat")
		passenger.Size = Vector3.new(2.15, 0.24, 1.6)
		passenger.CFrame = frame * CFrame.new(side * 1.6, 1.87, 8.5)
		passenger.Transparency = 1
		finish(passenger, "PassengerSeat" .. (if side < 0 then "Port" else "Starboard"), BLUE)
		passenger.CanTouch = not isAnchored
		passenger.Disabled = isAnchored
	end

	part("HelmPedestal", Vector3.new(0.5, 0.7, 0.5), CFrame.new(1.6, 1.45, 4.3), METAL)
	part("HelmCushion", Vector3.new(1.8, 0.3, 1.6), CFrame.new(1.6, 1.95, 4.3), BLUE)
	part("HelmBackrest", Vector3.new(1.8, 1.2, 0.25), CFrame.new(1.6, 2.5, 5.0), WHITE)
	local helm = Instance.new("VehicleSeat")
	helm.Size = Vector3.new(1.8, 0.24, 1.6)
	helm.CFrame = frame * CFrame.new(1.6, 2.1, 4.3)
	helm.Transparency = 1
	helm.HeadsUpDisplay = false
	helm.MaxSpeed, helm.Torque, helm.TurnSpeed = 0, 0, 0
	finish(helm, "HelmSeat", BLUE)
	helm.CanTouch = not isAnchored
	helm.Disabled = isAnchored
	part("HelmConsole", Vector3.new(2.3, 1.1, 0.7), CFrame.new(1.6, 1.75, 2.25), WHITE)
	part("InstrumentPanel", Vector3.new(1.9, 0.35, 0.12), CFrame.new(1.6, 2.48, 2.65), DARK)
	local wheelCenter = Vector3.new(1.6, 2.9, 2.95)
	for i = 0, 7 do
		local a, b = i * math.pi / 4, (i + 1) * math.pi / 4
		beam(
			"SteeringWheel",
			wheelCenter + Vector3.new(math.cos(a) * 0.42, math.sin(a) * 0.42, 0),
			wheelCenter + Vector3.new(math.cos(b) * 0.42, math.sin(b) * 0.42, 0),
			0.08,
			0.08,
			DARK
		)
	end
	for i = 0, 2 do
		local angle = i * math.pi * 2 / 3
		beam(
			"WheelSpoke",
			wheelCenter,
			wheelCenter + Vector3.new(math.cos(angle) * 0.4, math.sin(angle) * 0.4, 0),
			0.06,
			0.06,
			METAL
		)
	end
	part("EngineCover", Vector3.new(2.1, 0.55, 1.5), CFrame.new(0, 1.4, 10), WHITE)
	part("SwimPlatform", Vector3.new(5.8, 0.18, 0.8), CFrame.new(0, 0.65, 11.2), WHITE, nil, true)
	for _, x in { -1.7, 1.7 } do
		part("SternCleat", Vector3.new(0.65, 0.12, 0.18), CFrame.new(x, 2.44, 10.3), METAL)
	end
	local lampColor = Color3.fromRGB(214, 206, 184)
	for _, side in { -1, 1 } do
		-- Low cockpit lamps light the deck without obstructing the helm or seats.
		local deckLamp = part(
			"DeckLightLens",
			Vector3.new(0.08, 0.2, 0.55),
			CFrame.new(side * 4.48, 1.7, 4.8),
			lampColor,
			Enum.Material.Neon
		)
		local deckLight = Instance.new("PointLight")
		deckLight.Name = "DeckLight"
		deckLight.Color, deckLight.Range, deckLight.Brightness = lampColor, 12, 0.3
		deckLight.Shadows = false
		deckLight.Parent = deckLamp

		part(
			"HeadlightStand",
			Vector3.new(0.18, 0.7, 0.18),
			CFrame.new(side * 2.4, 2.8, -8),
			METAL,
			Enum.Material.Metal
		)
		part(
			"HeadlightHousing",
			Vector3.new(0.8, 0.46, 0.6),
			CFrame.new(side * 2.4, 3.35, -8),
			DARK,
			Enum.Material.Metal
		)
		local lens = part(
			"HeadlightLens",
			Vector3.new(0.62, 0.3, 0.06),
			CFrame.new(side * 2.4, 3.35, -8.34),
			lampColor,
			Enum.Material.Neon
		)
		lens.CastShadow = false
		local headlight = Instance.new("SpotLight")
		headlight.Name = "Headlight"
		headlight.Face = Enum.NormalId.Front
		headlight.Color, headlight.Range, headlight.Brightness, headlight.Angle = lampColor, 30, 0.45, 40
		headlight.Shadows = false
		headlight.Parent = lens
	end
	return model
end

return Speedboat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="221">
        <Properties>
          <string name="Name">Trawler</string>
          <string name="Source"><![CDATA[-- Traditional teal stern trawler. Waterline origin; local -Z is the bow.
-- One welded assembly, with a continuous deck and a walk-in forward wheelhouse.
local Trawler = { VERSION = 1 }

local V, F, rgb = Vector3.new, CFrame.new, Color3.fromRGB
local M = Enum.Material
local TEAL = rgb(65, 140, 143)
local TEAL_DARK = rgb(43, 96, 99)
local CREAM = rgb(232, 230, 210)
local WHITE = rgb(241, 239, 222)
local BROWN = rgb(100, 69, 53)
local ANTIFOUL = rgb(66, 49, 47)
local DECK = rgb(143, 134, 109)
local DARK = rgb(37, 43, 42)
local STEEL = rgb(163, 171, 160)
local ROPE = rgb(183, 161, 115)
local NET = rgb(69, 112, 83)
local GLASS = rgb(67, 99, 105)
local ORANGE = rgb(220, 113, 48)
local LAMP = rgb(220, 196, 150)

function Trawler.build(frame: CFrame, anchored: boolean?): Model
	local isAnchored = anchored == true
	local model = Instance.new("Model")
	model.Name = "Trawler"
	model:SetAttribute("ModelVersion", Trawler.VERSION)
	model:SetAttribute("HullLength", 44)
	model:SetAttribute("HullBeam", 14.8)
	model:SetAttribute("PassengerSeats", 2)
	model:SetAttribute("DriverSeat", "HelmSeat")
	model:SetAttribute("DryFloorHeight", 1.45)
	model:SetAttribute("DryFloorHalfBeam", 6.45)
	model:SetAttribute("DryFloorHalfLength", 21.7)

	local root = Instance.new("Part")
	root.Name, root.Size, root.CFrame = "HullRoot", V(9, 0.6, 32), frame * F(0, -0.4, 0)
	root.Transparency, root.Anchored = 1, isAnchored
	root.CanCollide, root.CanTouch = false, false
	root.RootPriority = 127
	root.CustomPhysicalProperties = PhysicalProperties.new(1.4, 0.45, 0.05, 100, 100)
	root.Parent, model.PrimaryPart = model, root

	local function finish(p: BasePart, name: string, color: Color3, material: Enum.Material?, collide: boolean?)
		p.Name, p.Anchored, p.Massless = name, isAnchored, true
		p.CanCollide, p.CanTouch = collide == true, false
		p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		p.Color, p.Material = color, material or M.SmoothPlastic
		p.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0, weld.Part1, weld.Parent = root, p, p
		return p
	end
	local function part(
		name: string,
		size: Vector3,
		cf: CFrame,
		color: Color3,
		material: Enum.Material?,
		collide: boolean?
	): Part
		local p = Instance.new("Part")
		p.Size, p.CFrame = size, frame * cf
		finish(p, name, color, material, collide)
		return p
	end
	local function beam(
		name: string,
		a: Vector3,
		b: Vector3,
		width: number,
		color: Color3,
		material: Enum.Material?
	): Part
		-- fromMatrix also supports vertical lines, for which lookAt's default up is parallel.
		local back = (a - b).Unit
		local reference = if math.abs(back.Y) > 0.98 then V(1, 0, 0) else V(0, 1, 0)
		local right = reference:Cross(back).Unit
		return part(
			name,
			V(width, width, (b - a).Magnitude),
			CFrame.fromMatrix((a + b) / 2, right, back:Cross(right), back),
			color,
			material
		)
	end
	local function cylinder(name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
		local p = part(name, size, cf, color, material)
		p.Shape = Enum.PartType.Cylinder
		return p
	end
	local function ring(
		name: string,
		center: Vector3,
		radius: number,
		thickness: number,
		axis: string,
		color: Color3,
		segments: number?
	)
		local count = segments or 12
		local function point(angle)
			local a, b = math.cos(angle) * radius, math.sin(angle) * radius
			return center + (if axis == "X" then V(0, a, b) elseif axis == "Y" then V(a, 0, b) else V(a, b, 0))
		end
		for i = 0, count - 1 do
			beam(name, point(i * math.pi * 2 / count), point((i + 1) * math.pi * 2 / count), thickness, color)
		end
	end
	local function triangle(name: string, a: Vector3, b: Vector3, c: Vector3, inside: Vector3, color: Color3)
		local ab, ac, bc = b - a, c - a, c - b
		local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
		if abd > acd and abd > bcd then
			c, a = a, c
		elseif acd > bcd and acd > abd then
			a, b = b, a
		end
		ab, ac, bc = b - a, c - a, c - b
		local right, back = ac:Cross(ab).Unit, bc.Unit
		local up = bc:Cross(right).Unit
		local height = math.abs(ab:Dot(up))
		local normal = if right:Dot((a + b + c) / 3 - inside) >= 0 then right else -right
		local shift = -normal * 0.09
		for _, spec in
			{
				{ (a + b) / 2, right, back, math.abs(ab:Dot(back)) },
				{ (a + c) / 2, -right, -back, math.abs(ac:Dot(back)) },
			}
		do
			local p = Instance.new("WedgePart")
			p.Size = V(0.18, height, spec[4])
			p.CFrame = frame * CFrame.fromMatrix(spec[1] + shift, spec[2], up, spec[3])
			finish(p, name, color, nil, true)
		end
	end
	local function quad(name, a, b, c, d, color, inside)
		triangle(name, a, b, c, inside or V(0, 1, 0), color)
		triangle(name, a, c, d, inside or V(0, 1, 0), color)
	end

	-- Round-bilged working hull: fine raised bow, broad shoulders and a full transom.
	local stations = {
		{ z = -22, w = 0.20, b = 0.12, top = 4.2, keel = -0.15, chine = 0.25 },
		{ z = -19, w = 3.3, b = 1.7, top = 3.95, keel = -1.4, chine = -0.35 },
		{ z = -14, w = 5.9, b = 4.3, top = 3.55, keel = -2.4, chine = -0.65 },
		{ z = -7, w = 7.25, b = 5.9, top = 3.15, keel = -2.85, chine = -0.75 },
		{ z = 3, w = 7.25, b = 6.15, top = 3.0, keel = -2.85, chine = -0.75 },
		{ z = 13, w = 7.0, b = 5.95, top = 3.0, keel = -2.55, chine = -0.75 },
		{ z = 21.8, w = 6.15, b = 5.1, top = 3.1, keel = -1.95, chine = -0.65 },
	}
	local function edge(s, side, t)
		return V(side * (s.b + (s.w - s.b) * t), s.chine + (s.top - s.chine) * t, s.z)
	end
	local function bottom(s, side, level)
		if level == 0 then
			return edge(s, side, 0)
		elseif level == 1 then
			return V(side * s.b * 0.56, s.keel + (s.chine - s.keel) * 0.34, s.z)
		end
		return V(0, s.keel, s.z)
	end
	for _, side in { -1, 1 } do
		for i = 1, #stations - 1 do
			local a, b = stations[i], stations[i + 1]
			for _, band in { { 0, 0.21, WHITE }, { 0.21, 1, TEAL } } do
				quad(
					"HullPanel",
					edge(a, side, band[1]),
					edge(b, side, band[1]),
					edge(b, side, band[2]),
					edge(a, side, band[2]),
					band[3]
				)
			end
			for level = 0, 1 do
				quad(
					if level == 0 then "BilgePanel" else "BottomPanel",
					bottom(a, side, level),
					bottom(b, side, level),
					bottom(b, side, level + 1),
					bottom(a, side, level + 1),
					ANTIFOUL
				)
			end
			beam("Gunwale", edge(a, side, 1), edge(b, side, 1), 0.22, CREAM)
			local offset = V(side * 0.11, 0, 0)
			beam("SheerStripe", edge(a, side, 0.78) + offset, edge(b, side, 0.78) + offset, 0.085, WHITE)
			beam("RubbingStrake", edge(a, side, 0.53) + offset, edge(b, side, 0.53) + offset, 0.16, TEAL_DARK)
		end
	end
	for _, s in { stations[1], stations[#stations] } do
		quad("Transom", edge(s, -1, 0), edge(s, 1, 0), edge(s, 1, 0.21), edge(s, -1, 0.21), WHITE)
		quad("Transom", edge(s, -1, 0.21), edge(s, 1, 0.21), edge(s, 1, 1), edge(s, -1, 1), TEAL)
		for _, side in { -1, 1 } do
			triangle("HullEndCap", bottom(s, side, 0), bottom(s, side, 1), bottom(s, side, 2), V(0, 1, 0), ANTIFOUL)
			triangle("HullEndCap", bottom(s, side, 0), bottom(s, side, 2), V(0, s.chine, s.z), V(0, 1, 0), ANTIFOUL)
		end
	end
	beam("TransomCap", edge(stations[#stations], -1, 1), edge(stations[#stations], 1, 1), 0.25, CREAM)
	for i = 1, #stations - 1 do
		beam("Keel", bottom(stations[i], 1, 2), bottom(stations[i + 1], 1, 2), 0.25, ANTIFOUL)
	end

	-- Individual flush planks follow the narrowing hull; no deck overhangs the bow.
	local function deckWidth(s)
		return s.b + (s.w - s.b) * (1.45 - s.chine) / (s.top - s.chine) - 0.18
	end
	for i = -10, 10 do
		local outside = (math.abs(i) + 0.5) * 0.6
		local startZ, endZ = stations[1].z, stations[#stations].z - 0.15
		for j = 1, #stations - 1 do
			local a, b = stations[j], stations[j + 1]
			local wa, wb = deckWidth(a), deckWidth(b)
			if wa < outside and wb >= outside then
				startZ = a.z + (b.z - a.z) * (outside - wa) / (wb - wa)
			elseif wa >= outside and wb < outside then
				endZ = a.z + (b.z - a.z) * (outside - wa) / (wb - wa)
			end
		end
		part("WorkingDeck", V(0.6, 0.24, endZ - startZ), F(i * 0.6, 1.33, (startZ + endZ) / 2), DECK, M.Wood, true)
	end
	for _, side in { -1, 1 } do
		for _, z in { -10, -3, 4, 11, 18 } do
			part("BulwarkRib", V(0.16, 1.4, 0.18), F(side * (if z == 18 then 5.88 else 6.35), 2.2, z), CREAM, M.Metal)
		end
		for _, z in { 0, 10, 17.8 } do
			part("Scupper", V(0.07, 0.2, 0.76), F(side * (if z > 15 then 6.25 else 6.76), 0.52, z), DARK)
		end
	end

	-- Brown lower cabin and cream upper window frames, with an open aft doorway.
	part("CabinFrontLower", V(6.8, 3.2, 0.22), F(0, 3.05, -12.15), BROWN, M.Wood, true)
	for _, side in { -1, 1 } do
		part("CabinSideLower", V(0.22, 3.2, 8.9), F(side * 3.3, 3.05, -7.7), BROWN, M.Wood, true)
		part("CabinSideHeader", V(0.26, 0.42, 9.5), F(side * 3.3, 8.04, -7.85), CREAM, nil, true)
		part("CabinSill", V(0.34, 0.17, 9.12), F(side * 3.3, 4.7, -7.7), CREAM)
		for _, z in { -11.98, -8.98, -6.0, -3.3 } do
			part("CabinWindowPost", V(0.28, 3.12, 0.2), F(side * 3.3, 6.26, z), CREAM, nil, true)
		end
		for _, z in { -10.48, -7.48, -4.65 } do
			local glass = part(
				"CabinSideWindow",
				V(0.09, 2.92, if z == -4.65 then 2.48 else 2.76),
				F(side * 3.3, 6.26, z),
				GLASS,
				nil,
				true
			)
			glass.Transparency = 0.3
		end
		-- Tongue-and-groove cladding and contrasting corner boards.
		for z = -11.6, -3.6, 0.8 do
			part("CabinCladdingSeam", V(0.025, 2.95, 0.025), F(side * 3.421, 3.02, z), ANTIFOUL)
		end
		part("CabinRearPanel", V(1.95, 6.35, 0.22), F(side * 2.36, 4.625, -3.25), BROWN, M.Wood, true)
		local rearGlass = part("CabinRearWindow", V(1.32, 2.36, 0.09), F(side * 2.36, 6.25, -3.38), GLASS)
		rearGlass.Transparency = 0.22
		part("DoorJamb", V(0.14, 6.35, 0.3), F(side * 1.33, 4.625, -3.25), CREAM, nil, true)
		beam("CabinGrabRail", V(side * 3.6, 3.0, -5.3), V(side * 3.6, 4.6, -5.3), 0.11, STEEL, M.Metal)
	end
	part("DoorHeader", V(6.8, 0.5, 0.3), F(0, 8.04, -3.25), CREAM, nil, true)
	-- Raked front glazing, black seals, paired windscreens and tiny wipers.
	local front = F(0, 6.28, -12.43) * CFrame.Angles(math.rad(-10), 0, 0)
	for _, x in { -3.3, -1.1, 1.1, 3.3 } do
		part("WindscreenMullion", V(0.17, 3.24, 0.18), front * F(x, 0, 0), CREAM, nil, true)
	end
	for _, x in { -2.2, 0, 2.2 } do
		-- Frame the pane without placing an opaque sheet behind the glass.
		for _, dx in { -0.985, 0.985 } do
			part("WindscreenSeal", V(0.08, 3.07, 0.09), front * F(x + dx, 0, 0.015), DARK)
		end
		for _, dy in { -1.495, 1.495 } do
			part("WindscreenSeal", V(1.89, 0.08, 0.09), front * F(x, dy, 0.015), DARK)
		end
		local window = part("Windscreen", V(1.89, 2.91, 0.12), front * F(x, 0, -0.065), GLASS, nil, true)
		window.Transparency = 0.27
		part("WiperArm", V(0.055, 1.43, 0.045), front * F(x + 0.3, -0.48, -0.15) * CFrame.Angles(0, 0, -0.3), DARK)
	end
	part("CabinRoof", V(7.65, 0.33, 10.25), F(0, 8.42, -8.0), CREAM, nil, true)
	part("RoofFascia", V(7.82, 0.16, 10.4), F(0, 8.24, -8.0), WHITE)
	for _, x in { -2.5, 0, 2.5 } do
		part("RoofSeam", V(0.045, 0.045, 9.9), F(x, 8.61, -8.0), WHITE)
	end

	part("HelmConsole", V(3.0, 1.3, 1.2), F(0, 2.1, -10.65), TEAL_DARK)
	part("ConsoleTop", V(3.22, 0.18, 1.36), F(0, 2.85, -10.65), BROWN, M.Wood)
	part("InstrumentPanel", V(2.6, 0.68, 0.12), F(0, 3.27, -10.0), DARK)
	for _, x in { -0.92, -0.45, 0.05 } do
		cylinder("GaugeBezel", V(0.08, 0.34, 0.34), F(x, 3.3, -9.9) * CFrame.Angles(0, math.pi / 2, 0), STEEL, M.Metal)
		cylinder("GaugeFace", V(0.09, 0.26, 0.26), F(x, 3.3, -9.85) * CFrame.Angles(0, math.pi / 2, 0), CREAM)
		part("GaugeNeedle", V(0.025, 0.1, 0.02), F(x + 0.02, 3.33, -9.79) * CFrame.Angles(0, 0, -0.5), DARK)
	end
	part("FishfinderFrame", V(0.65, 0.51, 0.16), F(0.83, 3.38, -9.93), DARK)
	part("FishfinderScreen", V(0.51, 0.35, 0.025), F(0.83, 3.38, -9.83), rgb(72, 152, 123), M.Neon)
	beam("ThrottleLever", V(1.15, 2.97, -9.7), V(1.15, 3.45, -9.9), 0.075, STEEL)
	part("ThrottleGrip", V(0.19, 0.14, 0.22), F(1.15, 3.45, -9.9), DARK)
	ring("HelmWheel", V(0, 3.35, -9.6), 0.55, 0.095, "Z", BROWN)
	for i = 0, 3 do
		local a = i * math.pi / 2
		beam("HelmSpoke", V(0, 3.35, -9.6), V(math.cos(a) * 0.5, 3.35 + math.sin(a) * 0.5, -9.6), 0.065, STEEL)
	end
	part("HelmPedestal", V(0.48, 0.8, 0.48), F(0, 1.85, -7.8), DARK)
	part("HelmCushion", V(2.0, 0.25, 1.65), F(0, 2.38, -7.8), BROWN)
	part("HelmBack", V(2.0, 1.3, 0.22), F(0, 3.12, -7.02), BROWN)
	local helm = Instance.new("VehicleSeat")
	helm.Size, helm.CFrame = V(2.0, 0.24, 1.65), frame * F(0, 2.42, -7.8)
	helm.Transparency, helm.HeadsUpDisplay = 1, false
	helm.MaxSpeed, helm.Torque, helm.TurnSpeed = 0, 0, 0
	finish(helm, "HelmSeat", BROWN)
	helm.CanTouch, helm.Disabled = not isAnchored, isAnchored
	-- Two aft fishing seats leave the center of the working deck open.
	for _, side in { -1, 1 } do
		part("PassengerPedestal", V(0.42, 0.75, 0.42), F(side * 4.65, 1.85, 0.1), TEAL_DARK)
		part("PassengerCushion", V(1.9, 0.24, 1.5), F(side * 4.65, 2.3, 0.1), CREAM)
		part("PassengerBack", V(1.9, 1.0, 0.2), F(side * 4.65, 2.91, -0.58), BROWN)
		local seat = Instance.new("Seat")
		seat.Size = V(1.9, 0.24, 1.5)
		seat.CFrame = frame * F(side * 4.65, 2.35, 0.1) * CFrame.Angles(0, math.pi, 0)
		seat.Transparency = 1
		finish(seat, if side < 0 then "FishingSeatPort" else "FishingSeatStarboard", CREAM)
		seat.CanTouch, seat.Disabled = not isAnchored, isAnchored
	end

	-- Stainless foredeck rails follow the raised bow's sheer.
	for _, side in { -1, 1 } do
		local points = {
			V(side * 0.25, 5.45, -21.6),
			V(side * 3.15, 5.2, -18.8),
			V(side * 5.65, 4.85, -13.8),
			V(side * 6.8, 4.45, -8.3),
		}
		for i, p in points do
			beam("BowRailPost", p - V(0, 1.3, 0), p, 0.11, STEEL, M.Metal)
			if i > 1 then
				beam("BowRail", points[i - 1], p, 0.11, STEEL, M.Metal)
				beam("BowMidRail", points[i - 1] - V(0, 0.63, 0), p - V(0, 0.63, 0), 0.07, STEEL)
			end
		end
		for _, z in { -15.2, 2.3, 18.7 } do
			local x = side * (if z < -10 then 4.3 elseif z > 15 then 5.95 else 6.9)
			part("CleatFoot", V(0.5, 0.16, 0.7), F(x, 3.14, z), STEEL, M.Metal)
			part("MooringCleat", V(0.24, 0.22, 1.05), F(x, 3.31, z), STEEL, M.Metal)
		end
	end
	cylinder("AnchorWindlass", V(1.6, 0.75, 0.75), F(0, 1.95, -17.2), TEAL_DARK, M.Metal)
	part("AnchorChainBed", V(0.3, 0.13, 3.3), F(0, 1.55, -19.05), DARK)
	for z = -20.4, -17.8, 0.32 do
		ring("AnchorChainLink", V(0, 1.65, z), 0.12, 0.045, "Y", STEEL, 6)
	end

	-- Hollow tire fenders hang clear of the hull; pale rope lashings and tread bands.
	for _, side in { -1, 1 } do
		for _, z in { -6.5, 4, 15.5 } do
			local x = side * (if z > 10 then 7.06 else 7.43)
			local center = V(x, 0.95, z)
			ring("TireFender", center, 0.81, 0.3, "X", DARK, 14)
			ring("TireSidewall", center + V(side * 0.17, 0, 0), 0.74, 0.1, "X", ANTIFOUL, 14)
			beam("FenderLashing", center + V(0, 0.8, 0), V(x - side * 0.35, 3.2, z + 0.12), 0.055, ROPE)
		end
	end
	-- Short cream rubbing pads break up the long teal sides like the reference.
	for _, side in { -1, 1 } do
		for _, z in { -1.5, 8.7, 18.2 } do
			part("HullRubbingPad", V(0.16, 0.43, 0.95), F(side * (if z > 15 then 6.55 else 7.05), 1.66, z), CREAM)
		end
	end

	-- Stern A-frame with diagonal bracing, sheaves, a forward boom and taut stays.
	for _, side in { -1, 1 } do
		beam("GantryLeg", V(side * 5.1, 1.5, 16.3), V(side * 4.15, 12.65, 16.3), 0.35, CREAM, M.Metal)
		beam("GantryBrace", V(side * 5.0, 2.2, 19.8), V(side * 4.15, 11.9, 16.3), 0.2, STEEL, M.Metal)
		part("GantryFoot", V(0.85, 0.16, 1.05), F(side * 5.1, 1.55, 16.3), TEAL_DARK, M.Metal)
		beam("GantryStay", V(side * 4.15, 12.5, 16.3), V(side * 5.9, 3.1, 5.0), 0.045, STEEL)
		cylinder("GantrySheave", V(0.25, 0.66, 0.66), F(side * 3.35, 12.7, 16.3), DARK, M.Metal)
	end
	beam("GantryCrossbar", V(-4.5, 12.7, 16.3), V(4.5, 12.7, 16.3), 0.38, CREAM, M.Metal)
	beam("GantryTopRail", V(-4.15, 13.55, 16.3), V(4.15, 13.55, 16.3), 0.1, STEEL)
	for _, x in { -4.15, 0, 4.15 } do
		beam("GantryGuardPost", V(x, 12.7, 16.3), V(x, 13.55, 16.3), 0.1, STEEL)
	end
	beam("TrawlBoom", V(0, 11.7, 16.3), V(0, 8.7, 5.2), 0.26, CREAM, M.Metal)
	beam("BoomStay", V(0, 13.2, 16.3), V(0, 8.7, 5.2), 0.045, STEEL)
	beam("TrawlCable", V(0, 8.7, 5.2), V(-2.7, 5.1, 7.8), 0.045, DARK)
	cylinder("BoomPulley", V(0.25, 0.55, 0.55), F(0, 8.65, 5.2), DARK, M.Metal)

	-- Green net drum, flanged cheeks, motor, visible wound net and hand controls.
	for _, x in { -4.65, -0.75 } do
		part("WinchPedestal", V(0.4, 1.35, 1.65), F(x, 2.12, 8.3), TEAL_DARK, M.Metal)
		cylinder("DrumFlange", V(0.18, 3.5, 3.5), F(x, 3.9, 8.3), CREAM, M.Metal)
		cylinder("DrumHub", V(0.3, 0.5, 0.5), F(x, 3.9, 8.3), STEEL, M.Metal)
	end
	cylinder("NetDrum", V(3.7, 3.15, 3.15), F(-2.7, 3.9, 8.3), NET)
	for x = -4.4, -1.0, 0.25 do
		ring("WoundNetRib", V(x, 3.9, 8.3), 1.59, 0.055, "X", TEAL_DARK, 12)
	end
	for i = 0, 9 do
		local a = i * math.pi / 5
		beam(
			"WoundNetStrand",
			V(-4.45, 3.9 + math.cos(a) * 1.61, 8.3 + math.sin(a) * 1.61),
			V(-0.95, 3.9 + math.cos(a + 0.5) * 1.61, 8.3 + math.sin(a + 0.5) * 1.61),
			0.045,
			ROPE
		)
	end
	cylinder("WinchMotor", V(0.85, 0.85, 0.85), F(-5.05, 2.7, 8.3), TEAL_DARK, M.Metal)
	part("WinchControlBox", V(0.6, 0.75, 0.45), F(-0.75, 2.58, 6.9), STEEL, M.Metal)
	beam("WinchLever", V(-0.75, 2.9, 6.9), V(-0.75, 3.45, 6.75), 0.065, DARK)
	-- Stowed lattice net is attached to the port quarter, clear of the passage.
	for i = 0, 7 do
		local z = 12.0 + i * 0.64
		beam("StowedNetMesh", V(-5.6, 1.6, z), V(-2.9, 2.6, z + 1.8), 0.055, NET)
		beam("StowedNetMesh", V(-5.6, 2.6, z + 1.8), V(-2.9, 1.6, z), 0.055, NET)
	end
	for _, z in { 12.2, 13.6, 15.0 } do
		local float = part("NetFloat", V(0.4, 0.52, 0.4), F(-5.55, 2.8, z), ORANGE)
		float.Shape = Enum.PartType.Ball
	end
	-- Flat cargo hatches with hinges and recessed handles.
	for _, z in { 2.5, 13.3 } do
		part("CargoHatchRim", V(3.0, 0.09, 2.5), F(0.65, 1.5, z), STEEL, M.Metal)
		part("CargoHatch", V(2.72, 0.07, 2.22), F(0.65, 1.58, z), TEAL_DARK, M.DiamondPlate)
		for _, x in { -0.3, 1.6 } do
			part("HatchHinge", V(0.32, 0.08, 0.18), F(x, 1.65, z - 1.1), STEEL)
		end
		part("HatchHandle", V(0.6, 0.05, 0.16), F(0.65, 1.64, z + 0.65), DARK)
	end
	for _, z in { 9.8, 12.0 } do
		part("FishCrate", V(1.7, 0.95, 1.55), F(4.9, 1.95, z), BROWN, M.Wood)
		part("CrateRim", V(1.82, 0.13, 1.67), F(4.9, 2.48, z), ROPE, M.Wood)
		for dz = -0.55, 0.55, 0.36 do
			part("CrateSlat", V(1.74, 0.08, 0.09), F(4.9, 2.55, z + dz), DECK)
		end
	end
	for i = 0, 2 do
		ring("RopeCoil", V(4.65, 1.58 + i * 0.06, 16.5), 0.5 + i * 0.16, 0.1, "Y", ROPE)
	end
	-- Stern boards, bollards and a center boarding gap with a short ladder.
	for x = -4.8, 4.8, 0.8 do
		part("TransomPlankSeam", V(0.025, 2.2, 0.025), F(x, 1.96, 21.91), TEAL_DARK)
	end
	for _, x in { -1.35, 1.35 } do
		beam("BoardingLadderRail", V(x, -0.1, 22.0), V(x, 3.3, 22.0), 0.12, STEEL, M.Metal)
	end
	for _, y in { 0.3, 1.1, 1.9, 2.7 } do
		part("BoardingRung", V(2.7, 0.16, 0.32), F(0, y, 22.0), STEEL, M.Metal, true)
	end

	-- Radar, swept mast, aerials, horn, exhaust and navigation lamps.
	part("RadarPedestal", V(0.65, 0.65, 0.65), F(0.7, 8.94, -10.1), TEAL_DARK)
	part("RadarScanner", V(2.65, 0.2, 0.65), F(0.7, 9.38, -10.1), CREAM)
	beam("Foremast", V(-0.6, 8.6, -7.0), V(-0.6, 15.6, -9.8), 0.17, CREAM, M.Metal)
	beam("MastAerial", V(-0.6, 15.6, -9.8), V(-0.6, 18.3, -10.9), 0.035, STEEL)
	beam("RadioAerial", V(2.2, 8.6, -5.0), V(2.2, 12.2, -5.15), 0.045, STEEL)
	beam("MastCrossbar", V(-2.2, 13.3, -8.9), V(1.0, 13.3, -8.9), 0.13, CREAM)
	for _, side in { -1, 1 } do
		beam("MastStay", V(-0.6, 15.4, -9.7), V(side * 3.2, 8.6, -4.3), 0.025, STEEL)
	end
	cylinder("ExhaustStack", V(1.1, 0.45, 0.45), F(-2.25, 9.1, -4.6) * CFrame.Angles(0, 0, math.pi / 2), DARK, M.Metal)
	part("ExhaustCap", V(0.65, 0.15, 0.55), F(-2.25, 9.72, -4.6), DARK)
	cylinder("RoofHorn", V(0.85, 0.28, 0.28), F(2.3, 8.92, -10.8) * CFrame.Angles(0, math.pi / 2, 0), STEEL, M.Metal)
	part("MastLamp", V(0.25, 0.3, 0.25), F(-0.6, 15.7, -9.8), LAMP, M.Neon)
	for _, side in { -1, 1 } do
		part("NavigationLampHousing", V(0.5, 0.35, 0.6), F(side * 3.65, 8.62, -9.1), TEAL_DARK)
		part(
			"NavigationLamp",
			V(0.25, 0.22, 0.3),
			F(side * 3.72, 8.8, -9.1),
			if side < 0 then rgb(218, 53, 44) else rgb(65, 194, 95),
			M.Neon
		)
		part("HeadlightHousing", V(0.7, 0.6, 0.6), F(side * 2.3, 8.92, -12.6), TEAL_DARK, M.Metal)
		local lens = part("HeadlightLens", V(0.53, 0.4, 0.055), F(side * 2.3, 8.92, -12.93), LAMP, M.Neon)
		local light = Instance.new("SpotLight")
		light.Name, light.Face = "Headlight", Enum.NormalId.Front
		light.Color, light.Range, light.Brightness, light.Angle = LAMP, 30, 0.45, 40
		light.Shadows, light.Parent = false, lens
	end
	for _, z in { -3.0, 16.3 } do
		local p = part("DeckWorkLamp", V(0.7, 0.24, 0.55), F(0, if z < 0 then 8.0 else 12.4, z), LAMP, M.Neon)
		local light = Instance.new("PointLight")
		light.Name, light.Color, light.Range, light.Brightness = "DeckLight", LAMP, 14, 0.3
		light.Shadows, light.Parent = false, p
	end
	-- Lifebuoy on the aft cabin wall with four white bindings.
	ring("LifeRing", V(2.3, 3.4, -3.07), 0.65, 0.22, "Z", ORANGE)
	for i = 0, 3 do
		local a = i * math.pi / 2
		part(
			"LifeRingBinding",
			V(0.23, 0.28, 0.24),
			F(2.3 + math.cos(a) * 0.65, 3.4 + math.sin(a) * 0.65, -3.06) * CFrame.Angles(0, 0, a),
			WHITE
		)
	end

	-- Painted registration boards follow the flared shoulders so no lettering sinks into the plating.
	for _, side in { -1, 1 } do
		local plate = part(
			"RegistrationPlate",
			V(0.09, 0.55, 3.5),
			F(side * 6.30, 2.6, -10.9) * CFrame.Angles(0, side * math.rad(11), -side * math.rad(20)),
			WHITE
		)
		local gui = Instance.new("SurfaceGui")
		gui.Name, gui.Face = "Registration", if side < 0 then Enum.NormalId.Left else Enum.NormalId.Right
		gui.SizingMode, gui.PixelsPerStud = Enum.SurfaceGuiSizingMode.PixelsPerStud, 70
		gui.Parent = plate
		local label = Instance.new("TextLabel")
		label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
		label.Text, label.TextColor3, label.Font, label.TextScaled = "FW 463346", DARK, Enum.Font.GothamBold, true
		label.Parent = gui
	end
	-- Underwater single screw, shaft and rudder complete the drydock silhouette.
	cylinder("PropellerShaft", V(3.0, 0.16, 0.16), F(0, -1.65, 19.7) * CFrame.Angles(0, math.pi / 2, 0), STEEL, M.Metal)
	cylinder("PropellerHub", V(0.65, 0.4, 0.4), F(0, -1.65, 20.5) * CFrame.Angles(0, math.pi / 2, 0), ROPE, M.Metal)
	for i = 0, 2 do
		local a = i * math.pi * 2 / 3
		part(
			"PropellerBlade",
			V(0.4, 0.95, 0.14),
			F(math.sin(a) * 0.48, -1.65 + math.cos(a) * 0.48, 20.5) * CFrame.Angles(0, 0, -a),
			ROPE,
			M.Metal
		)
	end
	part("Rudder", V(0.18, 1.8, 1.05), F(0, -1.5, 21.3), ANTIFOUL, M.Metal)
	return model
end

return Trawler
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="222">
        <Properties>
          <string name="Name">TrawlerNetService</string>
          <string name="Source"><![CDATA[-- The teal trawler's purchased stern net. Owns the visible gear welded behind the
-- transom, the helm toggle in ReplicatedStorage.TrawlerNet, and the passive catch
-- loop that only runs while the hull is moving. BoatRefitService calls dress()
-- whenever a hull is launched or refitted, and stows the net before a lift.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local AnglerData = require(script.Parent.AnglerData)
local BoatService = require(script.Parent.BoatService)
local GamepassService = require(script.Parent.GamepassService)
local Aboard = require(ReplicatedStorage.Shared.Aboard)
local AnglerCatalog = require(ReplicatedStorage.Shared.AnglerCatalog)
local BoatCatalog = require(ReplicatedStorage.Shared.BoatCatalog)
local BoatUpgrades = require(ReplicatedStorage.Shared.BoatUpgrades)
local CatchConditions = require(ReplicatedStorage.Shared.CatchConditions)
local FishCatch = require(ReplicatedStorage.Shared.FishCatch)
local FishMutations = require(ReplicatedStorage.Shared.FishMutations)
local MutationContext = require(ReplicatedStorage.Shared.MutationContext)
local DayNight = require(ReplicatedStorage.Shared.DayNight)
local Seasons = require(ReplicatedStorage.Shared.Seasons)
local TrawlerNet = require(ReplicatedStorage.Shared.TrawlerNet)

local TrawlerNetService = {}
local started = false
local remote: RemoteEvent
local random = Random.new()
local toggledAt = {}
local netTweens = setmetatable({}, { __mode = "k" })
local DEPLOY_SECONDS = 3
local NET_COLOR = Color3.fromRGB(69, 112, 83)
local NET_DARK = Color3.fromRGB(43, 88, 64)
local ROPE_COLOR = Color3.fromRGB(183, 161, 115)
local FLOAT_COLOR = Color3.fromRGB(220, 113, 48)
local STRANDS = 12
local SECTIONS = 5
local RADII = { 2.8, 2.25, 1.75, 1.3, 0.85 }

-- The pivot follows the hull. Its attachments form the knots in the mesh, so
-- individual net strands stretch as the bag opens without moving the hull.
local function buildNet(folder: Folder, root: BasePart)
	local pivot = Instance.new("Part")
	pivot.Name = "NetPivot"
	pivot.Size = Vector3.new(0.2, 0.2, 0.2)
	pivot.CFrame = root.CFrame
	pivot.Transparency = 1
	pivot.Anchored, pivot.Massless = false, true
	pivot.CanCollide, pivot.CanTouch, pivot.CanQuery = false, false, false
	pivot.Parent = folder
	local motor = Instance.new("Motor6D")
	motor.Name = "NetMotor"
	motor.Part0, motor.Part1 = root, pivot
	motor.C0 = CFrame.identity
	motor.Parent = pivot

	local nodes = {}
	for section = 1, SECTIONS do
		nodes[section] = {}
		for index = 1, STRANDS do
			local knot = Instance.new("Attachment")
			knot.Name = "NetKnot"
			knot.Parent = pivot
			nodes[section][index] = knot
		end
	end
	local codTie = Instance.new("Attachment")
	codTie.Name = "NetCodTie"
	codTie.Parent = pivot
	local function line(name: string, a: Attachment, b: Attachment, width: number, color: Color3)
		local strand = Instance.new("Beam")
		strand.Name = name
		strand.Attachment0, strand.Attachment1 = a, b
		strand.Width0, strand.Width1 = width, width
		strand.Color = ColorSequence.new(color)
		strand.FaceCamera = true
		strand.Segments = 1
		strand.Parent = folder
	end
	for section = 1, SECTIONS do
		for index = 1, STRANDS do
			local nextIndex = index % STRANDS + 1
			line(
				"NetRing",
				nodes[section][index],
				nodes[section][nextIndex],
				if section == 1 then 0.14 else 0.065,
				NET_COLOR
			)
			if section < SECTIONS then
				local color = if section % 2 == 0 then NET_DARK else NET_COLOR
				line("NetStrand", nodes[section][index], nodes[section + 1][index], 0.055, color)
				line("NetLacing", nodes[section][index], nodes[section + 1][nextIndex], 0.045, color)
				line("NetLacing", nodes[section][nextIndex], nodes[section + 1][index], 0.045, color)
			end
		end
	end
	-- Gather the last ring into a tied cod end, rather than leaving a tube open.
	for index = 1, STRANDS do
		line("NetCodEnd", nodes[SECTIONS][index], codTie, 0.07, NET_DARK)
	end

	-- Two hoist lines run from the actual A-frame sheaves to opposite sides of
	-- the mouth. They stay attached to the same moving knots throughout travel.
	for _, side in { -1, 1 } do
		local top = Instance.new("Attachment")
		top.Name = "NetGantryAttachment"
		top.Position = Vector3.new(side * 3.35, 12.7, 16.3)
		top.Parent = root
		local cleanup = Instance.new("ObjectValue")
		cleanup.Name, cleanup.Value, cleanup.Parent = "GantryAttachment", top, folder
		line("NetHoistRope", top, nodes[1][if side == 1 then 1 else 7], 0.08, ROPE_COLOR)
	end

	-- The floats and sinkers are tied to knots, and move with the mouth. Motors
	-- make them follow the hull without collision or visible rigid crossbars.
	local ornaments = {}
	for _, spec in
		{
			{ 2, true },
			{ 3, true },
			{ 4, true },
			{ 5, true },
			{ 6, true },
			{ 8, false },
			{ 10, false },
			{ 12, false },
		}
	do
		local float = spec[2]
		local piece = Instance.new("Part")
		piece.Name = if float then "NetFloat" else "NetWeight"
		piece.Shape = Enum.PartType.Ball
		piece.Size = if float then Vector3.new(0.48, 0.48, 0.48) else Vector3.new(0.3, 0.3, 0.3)
		piece.Color = if float then FLOAT_COLOR else Color3.fromRGB(75, 76, 70)
		piece.Material = if float then Enum.Material.SmoothPlastic else Enum.Material.Metal
		piece.CFrame = root.CFrame
		piece.Anchored, piece.Massless = false, true
		piece.CanCollide, piece.CanTouch, piece.CanQuery = false, false, false
		piece.Parent = folder
		local joint = Instance.new("Motor6D")
		joint.Part0, joint.Part1 = pivot, piece
		joint.Parent = piece
		table.insert(ornaments, { index = spec[1], motor = joint })
	end

	local progress = Instance.new("NumberValue")
	progress.Name = "NetDeployment"
	progress.Parent = folder
	local function update()
		local t = math.clamp(progress.Value, 0, 1)
		-- Lower the flat, draped net first. The bag opens only in the final
		-- fifth of the travel, once the mouth reaches the waterline.
		local lowering = math.clamp(t / 0.8, 0, 1)
		local opening = math.clamp((t - 0.8) / 0.2, 0, 1)
		opening = opening * opening * (3 - 2 * opening)
		for section = 1, SECTIONS do
			local along = (section - 1) / (SECTIONS - 1)
			local stowed = Vector3.new(0, 9.8 - along * 6.0, 17.3 + along * 2.7)
			local deployed = Vector3.new(0, -2.6 + along * 1.95, 23.6 + along * 10.4)
			local center = stowed:Lerp(deployed, lowering)
			if section == SECTIONS then
				codTie.Position = center + Vector3.new(0, -0.15 * (1 - opening), 0.5)
			end
			for index = 1, STRANDS do
				local angle = (index - 1) * math.pi * 2 / STRANDS
				local radius = RADII[section]
				nodes[section][index].Position = center
					+ Vector3.new(math.cos(angle) * radius, math.sin(angle) * radius * (0.025 + 0.975 * opening), 0)
			end
		end
		for _, ornament in ornaments do
			ornament.motor.C0 = CFrame.new(nodes[1][ornament.index].Position)
		end
	end
	progress.Changed:Connect(update)
	update()
end

function TrawlerNetService.setDeployed(model: Model, deployed: boolean, immediate: boolean?): boolean
	local folder = model:FindFirstChild("FishermansNet")
	local progress = folder and folder:FindFirstChild("NetDeployment")
	if not progress or not progress:IsA("NumberValue") then
		model:SetAttribute("NetDeployed", false)
		return false
	end
	local previous = netTweens[model]
	if previous then
		previous:Cancel()
		netTweens[model] = nil
	end
	model:SetAttribute("NetDeployed", deployed)
	local target = if deployed then 1 else 0
	if immediate then
		progress.Value = target
	else
		-- Preserve the current shape on a reversal and retain a constant speed.
		local duration = DEPLOY_SECONDS * math.abs(target - progress.Value)
		if duration <= 0 then
			progress.Value = target
		else
			local tween =
				TweenService:Create(progress, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Value = target })
			netTweens[model] = tween
			tween:Play()
		end
	end
	return true
end

function TrawlerNetService.stow(model: Model)
	-- The lift and outfit paths need the net safely aboard immediately.
	TrawlerNetService.setDeployed(model, false, true)
end

-- Adds the purchased net to a player's trawler, or removes it when a profile no
-- longer owns one. Called for every launch and refit, so it must be idempotent.
function TrawlerNetService.dress(player: Player, boatId: string, model: Model)
	local profile = BoatService.getProfile(player)
	local owned = boatId == BoatUpgrades.Net.BoatId and profile ~= nil and BoatUpgrades.ownsNet(profile.Angler)
	local existing = model:FindFirstChild("FishermansNet")
	if not owned then
		if existing then
			for _, child in existing:GetChildren() do
				if child:IsA("ObjectValue") and child.Name == "GantryAttachment" and child.Value then
					child.Value:Destroy()
				end
			end
			existing:Destroy()
		end
		model:SetAttribute("NetOwned", false)
		model:SetAttribute("NetDeployed", false)
		return
	end
	model:SetAttribute("NetOwned", true)
	if existing then
		TrawlerNetService.stow(model)
		return
	end
	local root = model.PrimaryPart
	if not root then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "FishermansNet"
	folder.Parent = model
	buildNet(folder, root)
	TrawlerNetService.stow(model)
end

local function catchFish(player: Player, boatId: string, model: Model)
	local profile = BoatService.getProfile(player)
	local layout = BoatCatalog[boatId]
	local root = model.PrimaryPart
	if not profile or not layout or not root then
		return
	end
	local pool = FishCatch.inSeason(
		AnglerCatalog.poolAt(CatchConditions.area(root.Position)),
		AnglerCatalog.Fish,
		(Seasons.current()),
		CatchConditions.at(root.Position)
	)
	local roll = TrawlerNet.roll(pool, AnglerCatalog.Fish, AnglerCatalog.Rarities, function()
		return random:NextNumber()
	end)
	if not roll then
		return
	end
 local traits = FishMutations.roll(AnglerCatalog.Fish[roll.FishId], DayNight.isNight(DayNight.clockTime()), function()
  return random:NextNumber()
 end, nil, MutationContext.at(root.Position, player))
 roll.Traits = traits
 roll.Value = FishMutations.value(roll.Value, traits.Mutation, traits.Corruptions)
	local doubleXP = GamepassService.ownsDoubleXP(player)
	local caught = false
	local ok = BoatService.updateProgress(player, function(current)
		local data = AnglerData.netCatch(
			current.Angler,
			boatId,
			layout,
			roll,
			os.time(),
			AnglerCatalog.Fish,
			AnglerCatalog.Mutations,
			doubleXP
		)
		if data then
			current.Angler = data
			caught = true
		end
	end)
	if ok and caught then
		local fish = AnglerCatalog.Fish[roll.FishId]
		remote:FireClient(player, "Catch", fish.Name, roll.Kg, roll.Value)
	end
end

function TrawlerNetService.start()
	if started then
		return
	end
	started = true
	remote = Instance.new("RemoteEvent")
	remote.Name = "TrawlerNet"
	remote.Parent = ReplicatedStorage
	remote.OnServerEvent:Connect(function(player, action)
		if action ~= "Toggle" then
			return
		end
		local now = os.clock()
		if now - (toggledAt[player] or -math.huge) < 0.3 then
			return
		end
		toggledAt[player] = now
		local boatId, model = BoatService.activeBoat(player)
		local profile = BoatService.getProfile(player)
		if boatId ~= BoatUpgrades.Net.BoatId or not model or not profile then
			return
		elseif not BoatUpgrades.ownsNet(profile.Angler) then
			return
		elseif model:GetAttribute("Hoisted") == true then
			remote:FireClient(player, "Notice", "The net is stowed while your boat is on the lift.")
			return
		elseif not Aboard(player.Character, model) then
			remote:FireClient(player, "Notice", "Climb aboard your trawler to use the net.")
			return
		end
		local deployed = not (model:GetAttribute("NetDeployed") == true)
		TrawlerNetService.setDeployed(model, deployed)
		remote:FireClient(player, "Notice", if deployed then "Fisherman's net deployed." else "Fisherman's net stowed.")
	end)
	Players.PlayerRemoving:Connect(function(player)
		toggledAt[player] = nil
	end)

	-- One low-frequency timer per player; a hull only fishes while it is moving.
	task.spawn(function()
		local nextCatch = {}
		while true do
			task.wait(1)
			local now = os.clock()
			for _, player in Players:GetPlayers() do
				local boatId, model = BoatService.activeBoat(player)
				local root = model and model.PrimaryPart
				local velocity = if root then root.AssemblyLinearVelocity else Vector3.zero
				local horizontalSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
				local fishing = boatId == BoatUpgrades.Net.BoatId
					and root ~= nil
					and model:GetAttribute("NetDeployed") == true
					and model:GetAttribute("Hoisted") ~= true
					and Aboard(player.Character, model)
					and horizontalSpeed >= TrawlerNet.MinSpeed
				if not fishing then
					nextCatch[player] = nil
				else
					local due = nextCatch[player]
					if not due then
						nextCatch[player] = now
							+ TrawlerNet.nextInterval(function()
								return random:NextNumber()
							end)
					elseif now >= due then
						nextCatch[player] = now
							+ TrawlerNet.nextInterval(function()
								return random:NextNumber()
							end)
						catchFish(player, boatId, model)
					end
				end
			end
		end
	end)
end

return TrawlerNetService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="223">
        <Properties>
          <string name="Name">Tugboat</string>
          <string name="Source"><![CDATA[-- Stocky black harbour tug. Waterline origin; local -Z is the bow.
-- Thick segmented rubber fender, green decks, a white deckhouse and a tall
-- all-round wheelhouse reached by stairs from the aft deck.
local Tugboat = { VERSION = 1 }

local V, F, rgb = Vector3.new, CFrame.new, Color3.fromRGB
local M = Enum.Material
local BLACK = rgb(34, 36, 38)
local BOOT = rgb(196, 72, 44)
local ANTIFOUL = rgb(132, 44, 36)
local WHITE = rgb(236, 238, 233)
local DECK = rgb(68, 150, 86)
local RAIL = rgb(52, 128, 74)
local RUBBER = rgb(62, 62, 64)
local RUBBER_DARK = rgb(44, 44, 46)
local GLASS = rgb(38, 72, 62)
local VISOR = rgb(30, 64, 58)
local YELLOW = rgb(232, 184, 46)
local ORANGE = rgb(226, 110, 40)
local STEEL = rgb(168, 172, 168)
local GRAY = rgb(146, 151, 149)
local DARK = rgb(30, 32, 34)
local LAMP = rgb(220, 196, 150)

local DECK_TOP = 1.6
local BRIDGE_TOP = 4.45
local ROOF_Y = 11.0

function Tugboat.build(frame: CFrame, anchored: boolean?): Model
	local isAnchored = anchored == true
	local model = Instance.new("Model")
	model.Name = "Tugboat"
	model:SetAttribute("ModelVersion", Tugboat.VERSION)
	model:SetAttribute("HullLength", 30)
	model:SetAttribute("HullBeam", 13.4)
	model:SetAttribute("PassengerSeats", 2)
	model:SetAttribute("DriverSeat", "HelmSeat")
	model:SetAttribute("DryFloorHeight", DECK_TOP)
	model:SetAttribute("DryFloorHalfBeam", 5.6)
	model:SetAttribute("DryFloorHalfLength", 14.6)

	local root = Instance.new("Part")
	root.Name, root.Size, root.CFrame = "HullRoot", V(9, 0.6, 22), frame * F(0, -0.4, 0)
	root.Transparency, root.Anchored = 1, isAnchored
	root.CanCollide, root.CanTouch = false, false
	root.RootPriority = 127
	root.CustomPhysicalProperties = PhysicalProperties.new(1.6, 0.45, 0.05, 100, 100)
	root.Parent, model.PrimaryPart = model, root

	local function finish(p: BasePart, name: string, color: Color3, material: Enum.Material?, collide: boolean?)
		p.Name, p.Anchored, p.Massless = name, isAnchored, true
		p.CanCollide, p.CanTouch = collide == true, false
		p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		p.Color, p.Material = color, material or M.SmoothPlastic
		p.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0, weld.Part1, weld.Parent = root, p, p
		return p
	end
	local function part(
		name: string,
		size: Vector3,
		cf: CFrame,
		color: Color3,
		material: Enum.Material?,
		collide: boolean?
	): Part
		local p = Instance.new("Part")
		p.Size, p.CFrame = size, frame * cf
		finish(p, name, color, material, collide)
		return p
	end
	local function beam(
		name: string,
		a: Vector3,
		b: Vector3,
		width: number,
		color: Color3,
		material: Enum.Material?,
		collide: boolean?
	): Part
		-- fromMatrix also supports vertical lines, for which lookAt's default up is parallel.
		local back = (a - b).Unit
		local reference = if math.abs(back.Y) > 0.98 then V(1, 0, 0) else V(0, 1, 0)
		local right = reference:Cross(back).Unit
		return part(
			name,
			V(width, width, (b - a).Magnitude),
			CFrame.fromMatrix((a + b) / 2, right, back:Cross(right), back),
			color,
			material,
			collide
		)
	end
	local function cylinder(name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
		local p = part(name, size, cf, color, material)
		p.Shape = Enum.PartType.Cylinder
		return p
	end
	-- A round bar from a to b; cylinders run along their local X axis.
	local function tube(name: string, a: Vector3, b: Vector3, diameter: number, color: Color3, collide: boolean?): Part
		local along = (b - a).Unit
		local reference = if math.abs(along.Y) > 0.98 then V(0, 0, 1) else V(0, 1, 0)
		local up = (reference - along * reference:Dot(along)).Unit
		local p = part(
			name,
			V((b - a).Magnitude, diameter, diameter),
			CFrame.fromMatrix((a + b) / 2, along, up, along:Cross(up)),
			color,
			nil,
			collide
		)
		p.Shape = Enum.PartType.Cylinder
		return p
	end
	local function ring(
		name: string,
		center: Vector3,
		radius: number,
		thickness: number,
		axis: string,
		color: Color3,
		segments: number?
	)
		local count = segments or 12
		local function point(angle)
			local a, b = math.cos(angle) * radius, math.sin(angle) * radius
			return center + (if axis == "X" then V(0, a, b) elseif axis == "Y" then V(a, 0, b) else V(a, b, 0))
		end
		for i = 0, count - 1 do
			beam(name, point(i * math.pi * 2 / count), point((i + 1) * math.pi * 2 / count), thickness, color)
		end
	end
	local function triangle(name: string, a: Vector3, b: Vector3, c: Vector3, inside: Vector3, color: Color3)
		local ab, ac, bc = b - a, c - a, c - b
		local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
		if abd > acd and abd > bcd then
			c, a = a, c
		elseif acd > bcd and acd > abd then
			a, b = b, a
		end
		ab, ac, bc = b - a, c - a, c - b
		local right, back = ac:Cross(ab).Unit, bc.Unit
		local up = bc:Cross(right).Unit
		local height = math.abs(ab:Dot(up))
		local normal = if right:Dot((a + b + c) / 3 - inside) >= 0 then right else -right
		local shift = -normal * 0.09
		for _, spec in
			{
				{ (a + b) / 2, right, back, math.abs(ab:Dot(back)) },
				{ (a + c) / 2, -right, -back, math.abs(ac:Dot(back)) },
			}
		do
			local p = Instance.new("WedgePart")
			p.Size = V(0.18, height, spec[4])
			p.CFrame = frame * CFrame.fromMatrix(spec[1] + shift, spec[2], up, spec[3])
			finish(p, name, color, nil, true)
		end
	end
	local function quad(name, a, b, c, d, color, inside)
		triangle(name, a, b, c, inside or V(0, 1, 0), color)
		triangle(name, a, c, d, inside or V(0, 1, 0), color)
	end

	-- Short, beamy push-tug hull: blunt rounded bow, parallel sides and a wide stern.
	local stations = {
		{ z = -15, w = 2.4, b = 1.3, top = 3.7, keel = -0.2, chine = 0.35 },
		{ z = -13.6, w = 4.6, b = 3.0, top = 3.55, keel = -1.3, chine = -0.3 },
		{ z = -11, w = 5.8, b = 4.6, top = 3.4, keel = -2.3, chine = -0.65 },
		{ z = -6, w = 6.3, b = 5.4, top = 3.3, keel = -2.7, chine = -0.75 },
		{ z = 5, w = 6.3, b = 5.4, top = 3.3, keel = -2.6, chine = -0.75 },
		{ z = 11.5, w = 6.0, b = 5.0, top = 3.35, keel = -1.9, chine = -0.65 },
		{ z = 15, w = 5.3, b = 4.0, top = 3.45, keel = -1.0, chine = -0.45 },
	}
	local function edge(s, side, t)
		return V(side * (s.b + (s.w - s.b) * t), s.chine + (s.top - s.chine) * t, s.z)
	end
	local function bottom(s, side, level)
		if level == 0 then
			return edge(s, side, 0)
		elseif level == 1 then
			return V(side * s.b * 0.56, s.keel + (s.chine - s.keel) * 0.34, s.z)
		end
		return V(0, s.keel, s.z)
	end
	local function deckT(s)
		return (DECK_TOP - s.chine) / (s.top - s.chine)
	end
	local function inset(p: Vector3, side: number, amount: number)
		return p - V(side * amount, 0, 0)
	end
	for _, side in { -1, 1 } do
		for i = 1, #stations - 1 do
			local a, b = stations[i], stations[i + 1]
			-- Red boot-top at the waterline, black topsides above.
			for _, band in { { 0, 0.2, BOOT }, { 0.2, 1, BLACK } } do
				quad(
					"HullPanel",
					edge(a, side, band[1]),
					edge(b, side, band[1]),
					edge(b, side, band[2]),
					edge(a, side, band[2]),
					band[3]
				)
			end
			for level = 0, 1 do
				quad(
					if level == 0 then "BilgePanel" else "BottomPanel",
					bottom(a, side, level),
					bottom(b, side, level),
					bottom(b, side, level + 1),
					bottom(a, side, level + 1),
					ANTIFOUL
				)
			end
			-- White inner bulwark from the deck up to the rail.
			quad(
				"BulwarkLining",
				inset(edge(a, side, deckT(a)), side, 0.22),
				inset(edge(b, side, deckT(b)), side, 0.22),
				inset(edge(b, side, 1), side, 0.22),
				inset(edge(a, side, 1), side, 0.22),
				WHITE,
				V(0, 2.4, (a.z + b.z) / 2)
			)
			beam("Gunwale", edge(a, side, 1), edge(b, side, 1), 0.26, BLACK)
		end
	end
	for index, s in { stations[1], stations[#stations] } do
		quad("Transom", edge(s, -1, 0), edge(s, 1, 0), edge(s, 1, 0.2), edge(s, -1, 0.2), BOOT)
		quad("Transom", edge(s, -1, 0.2), edge(s, 1, 0.2), edge(s, 1, 1), edge(s, -1, 1), BLACK)
		local inward = V(0, 0, if index == 1 then 0.22 else -0.22)
		quad(
			"BulwarkLining",
			edge(s, -1, deckT(s)) + inward,
			edge(s, 1, deckT(s)) + inward,
			edge(s, 1, 1) + inward,
			edge(s, -1, 1) + inward,
			WHITE,
			V(0, 2.4, 0)
		)
		beam("Gunwale", edge(s, -1, 1), edge(s, 1, 1), 0.26, BLACK)
		for _, side in { -1, 1 } do
			triangle("HullEndCap", bottom(s, side, 0), bottom(s, side, 1), bottom(s, side, 2), V(0, 1, 0), ANTIFOUL)
			triangle("HullEndCap", bottom(s, side, 0), bottom(s, side, 2), V(0, s.chine, s.z), V(0, 1, 0), ANTIFOUL)
		end
	end
	for i = 1, #stations - 1 do
		beam("Keel", bottom(stations[i], 1, 2), bottom(stations[i + 1], 1, 2), 0.3, ANTIFOUL)
	end

	-- Green steel deck strips follow the hull's taper at both ends.
	local function deckWidth(s)
		return s.b + (s.w - s.b) * deckT(s) - 0.3
	end
	local STRIP = 0.65
	for i = -8, 8 do
		local outside = (math.abs(i) + 0.5) * STRIP
		local startZ, endZ = stations[1].z + 0.3, stations[#stations].z - 0.3
		for j = 1, #stations - 1 do
			local a, b = stations[j], stations[j + 1]
			local wa, wb = deckWidth(a), deckWidth(b)
			if wa < outside and wb >= outside then
				startZ = a.z + (b.z - a.z) * (outside - wa) / (wb - wa)
			elseif wa >= outside and wb < outside then
				endZ = a.z + (b.z - a.z) * (outside - wa) / (wb - wa)
			end
		end
		part(
			"WorkingDeck",
			V(STRIP, 0.24, endZ - startZ),
			F(i * STRIP, DECK_TOP - 0.12, (startZ + endZ) / 2),
			DECK,
			nil,
			true
		)
	end
	for _, side in { -1, 1 } do
		for _, z in { -8, 0, 8.5 } do
			part("Scupper", V(0.07, 0.22, 0.8), F(side * 6.12, 1.75, z), DARK)
		end
	end

	-- Segmented rubber fender wraps the whole sheer, like a ring of tyres pressed flat.
	local FENDER_T = 0.84
	local function fenderRun(points: { Vector3 }, diameter: number)
		local index = 0
		for i = 1, #points - 1 do
			local a, b = points[i], points[i + 1]
			local length = (b - a).Magnitude
			local pieces = math.max(1, math.round(length / 1.25))
			for k = 0, pieces - 1 do
				local from = a:Lerp(b, k / pieces)
				local to = a:Lerp(b, (k + 1) / pieces)
				local gap = (to - from).Unit * 0.05
				index += 1
				tube("Fender", from + gap, to - gap, diameter, if index % 2 == 0 then RUBBER else RUBBER_DARK)
			end
		end
	end
	for _, side in { -1, 1 } do
		local run = {}
		for _, s in stations do
			table.insert(run, edge(s, side, FENDER_T) + V(side * 0.42, 0, 0))
		end
		fenderRun(run, 1.0)
	end
	for index, s in { stations[1], stations[#stations] } do
		local out = if index == 1 then -0.42 else 0.42
		local y = s.chine + (s.top - s.chine) * FENDER_T
		local w = s.b + (s.w - s.b) * FENDER_T + 0.42
		fenderRun({ V(-w, y, s.z + out), V(w, y, s.z + out) }, 1.0)
	end
	-- Heavy pudding fender on the blunt bow for pushing.
	for _, y in { 2.05, 1.05 } do
		tube("BowFender", V(-2.0, y, -15.55), V(2.0, y, -15.55), 1.15, RUBBER_DARK)
	end
	for _, x in { -1.25, 0, 1.25 } do
		beam("FenderChain", V(x, 3.6, -15.1), V(x, 2.55, -15.6), 0.07, STEEL, M.Metal)
	end

	-- White deckhouse: the bridge deck is its roof.
	part(
		"Deckhouse",
		V(7.4, BRIDGE_TOP - 0.25 - DECK_TOP, 11.5),
		F(0, (DECK_TOP + BRIDGE_TOP - 0.25) / 2, -2.25),
		WHITE,
		nil,
		true
	)
	part("BridgeDeck", V(7.9, 0.25, 11.9), F(0, BRIDGE_TOP - 0.125, -2.25), DECK, nil, true)
	part("BridgeDeckEdge", V(8.0, 0.12, 12.0), F(0, BRIDGE_TOP - 0.31, -2.25), WHITE)
	for _, side in { -1, 1 } do
		for _, z in { -6.2, -3.6, -1.0, 1.6 } do
			cylinder("Porthole", V(0.1, 0.62, 0.62), F(side * 3.72, 3.15, z), STEEL, M.Metal)
			cylinder("PortholeGlass", V(0.12, 0.46, 0.46), F(side * 3.73, 3.15, z), GLASS)
		end
		-- Lifebuoys on the deckhouse sides with four white bindings.
		ring("LifeRing", V(side * 3.82, 2.9, 2.8), 0.62, 0.2, "X", ORANGE)
		for i = 0, 3 do
			local a = i * math.pi / 2
			part(
				"LifeRingBinding",
				V(0.22, 0.26, 0.24),
				F(side * 3.83, 2.9 + math.cos(a) * 0.62, 2.8 + math.sin(a) * 0.62) * CFrame.Angles(a, 0, 0),
				WHITE
			)
		end
	end
	part("DeckhouseDoor", V(1.3, 2.3, 0.08), F(-2.2, 2.8, 3.54), WHITE)
	part("DoorHandle", V(0.22, 0.08, 0.1), F(-1.75, 2.75, 3.6), DARK)

	-- Stairs from the aft deck up to the bridge deck, on the centerline.
	local STEPS = 7
	local rise = (BRIDGE_TOP - DECK_TOP) / STEPS
	local run = 0.75
	for i = 1, STEPS do
		local top = DECK_TOP + i * rise
		local z = 3.7 + (STEPS - i + 0.5) * run
		part("StairStep", V(2.4, top - DECK_TOP, run), F(0, (DECK_TOP + top) / 2, z), DECK, M.DiamondPlate, true)
		part("StairNosing", V(2.42, 0.06, 0.1), F(0, top + 0.02, z - run / 2 + 0.05), YELLOW)
	end
	for _, x in { -1.3, 1.3 } do
		local low, high = V(x, DECK_TOP + 1.1, 3.7 + STEPS * run), V(x, BRIDGE_TOP + 1.1, 3.7)
		beam("StairHandrail", low, high, 0.1, STEEL, M.Metal)
		beam("StairPost", low - V(0, 1.1, 0), low, 0.1, STEEL, M.Metal)
		beam("StairStringer", low - V(0, 1.0, 0), high - V(0, 1.0, 0), 0.2, WHITE)
	end

	-- Bridge deck railing; the aft edge leaves the stairwell open.
	local function railRun(a: Vector3, b: Vector3)
		beam("BridgeRail", a + V(0, 1.1, 0), b + V(0, 1.1, 0), 0.12, RAIL, M.Metal, true)
		beam("BridgeMidRail", a + V(0, 0.55, 0), b + V(0, 0.55, 0), 0.08, RAIL, M.Metal)
		local length = (b - a).Magnitude
		local posts = math.max(1, math.round(length / 1.6))
		for k = 0, posts do
			local p = a:Lerp(b, k / posts)
			beam("BridgeRailPost", p, p + V(0, 1.1, 0), 0.1, RAIL, M.Metal)
		end
	end
	local y0 = BRIDGE_TOP
	railRun(V(-3.85, y0, -8.1), V(3.85, y0, -8.1))
	railRun(V(-3.85, y0, -8.1), V(-3.85, y0, 3.6))
	railRun(V(3.85, y0, -8.1), V(3.85, y0, 3.6))
	railRun(V(-3.85, y0, 3.6), V(-1.35, y0, 3.6))
	railRun(V(1.35, y0, 3.6), V(3.85, y0, 3.6))

	-- Tall wheelhouse with tinted glass on every side and an aft doorway.
	local FRONT, AFT, HALF = -7.2, -1.2, 3.1
	local SILL, HEAD = 7.2, 10.6
	local midZ, depth = (FRONT + AFT) / 2, AFT - FRONT
	local lowerH, glassH = SILL - BRIDGE_TOP, HEAD - SILL
	part("WheelhouseFrontLower", V(HALF * 2, lowerH, 0.24), F(0, BRIDGE_TOP + lowerH / 2, FRONT), WHITE, nil, true)
	part(
		"WheelhouseHeader",
		V(HALF * 2 + 0.24, ROOF_Y - HEAD, 0.26),
		F(0, (HEAD + ROOF_Y) / 2, FRONT),
		WHITE,
		nil,
		true
	)
	part("WheelhouseHeader", V(HALF * 2 + 0.24, ROOF_Y - HEAD, 0.26), F(0, (HEAD + ROOF_Y) / 2, AFT), WHITE, nil, true)
	for _, x in { -HALF, -1.03, 1.03, HALF } do
		part("WindowPost", V(0.22, glassH, 0.26), F(x, (SILL + HEAD) / 2, FRONT), WHITE, nil, true)
	end
	for _, x in { -2.07, 0, 2.07 } do
		local pane =
			part("WheelhouseWindow", V(1.84, glassH, 0.1), F(x, (SILL + HEAD) / 2, FRONT - 0.02), GLASS, nil, true)
		pane.Transparency = 0.32
		part("WiperArm", V(0.05, 1.3, 0.04), F(x + 0.3, SILL + 0.7, FRONT - 0.1) * CFrame.Angles(0, 0, -0.3), DARK)
	end
	for _, side in { -1, 1 } do
		local x = side * HALF
		part("WheelhouseSideLower", V(0.24, lowerH, depth), F(x, BRIDGE_TOP + lowerH / 2, midZ), WHITE, nil, true)
		part("WheelhouseHeader", V(0.26, ROOF_Y - HEAD, depth), F(x, (HEAD + ROOF_Y) / 2, midZ), WHITE, nil, true)
		for _, z in { FRONT, midZ, AFT } do
			part("WindowPost", V(0.26, glassH, 0.22), F(x, (SILL + HEAD) / 2, z), WHITE, nil, true)
		end
		for _, z in { (FRONT + midZ) / 2, (midZ + AFT) / 2 } do
			local pane =
				part("WheelhouseWindow", V(0.1, glassH, depth / 2 - 0.22), F(x, (SILL + HEAD) / 2, z), GLASS, nil, true)
			pane.Transparency = 0.32
		end
		-- Aft wall panels either side of the 2.2-stud doorway.
		local panelX = side * (HALF + 1.1) / 2
		local panelW = HALF - 1.1
		part("WheelhouseAftLower", V(panelW, lowerH, 0.24), F(panelX, BRIDGE_TOP + lowerH / 2, AFT), WHITE, nil, true)
		local pane = part(
			"WheelhouseWindow",
			V(panelW - 0.2, glassH, 0.1),
			F(panelX, (SILL + HEAD) / 2, AFT + 0.02),
			GLASS,
			nil,
			true
		)
		pane.Transparency = 0.32
		part(
			"DoorJamb",
			V(0.16, HEAD - BRIDGE_TOP, 0.3),
			F(side * 1.18, (BRIDGE_TOP + HEAD) / 2, AFT),
			WHITE,
			nil,
			true
		)
		-- Painted name board on each side below the windows.
		local board = part("NameBoard", V(0.06, 0.55, 3.2), F(side * (HALF + 0.14), SILL - 0.6, midZ), WHITE)
		local gui = Instance.new("SurfaceGui")
		gui.Name, gui.Face = "Name", if side < 0 then Enum.NormalId.Left else Enum.NormalId.Right
		gui.SizingMode, gui.PixelsPerStud = Enum.SurfaceGuiSizingMode.PixelsPerStud, 70
		gui.Parent = board
		local label = Instance.new("TextLabel")
		label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
		label.Text, label.TextColor3, label.Font, label.TextScaled = "FW TUG 17", DARK, Enum.Font.GothamBold, true
		label.Parent = gui
	end
	part("WheelhouseRoof", V(HALF * 2 + 0.8, 0.3, depth + 0.8), F(0, ROOF_Y + 0.15, midZ), WHITE, nil, true)
	part("RoofVisor", V(HALF * 2 + 1.0, 0.4, depth + 1.0), F(0, ROOF_Y - 0.1, midZ), VISOR)
	part("WheelhouseFloor", V(HALF * 2 - 0.2, 0.06, depth - 0.2), F(0, BRIDGE_TOP + 0.03, midZ), DARK, M.Wood)

	-- Helm: console, joystick levers and screens, with the driver facing forward.
	part("HelmConsole", V(4.2, 1.3, 1.0), F(0, BRIDGE_TOP + 0.65, FRONT + 0.8), VISOR)
	part("ConsoleTop", V(4.4, 0.16, 1.15), F(0, BRIDGE_TOP + 1.38, FRONT + 0.8), DARK)
	for _, x in { -1.2, 1.2 } do
		part(
			"ConsoleScreen",
			V(1.1, 0.7, 0.08),
			F(x, BRIDGE_TOP + 1.85, FRONT + 0.45) * CFrame.Angles(math.rad(-15), 0, 0),
			DARK
		)
		part(
			"ScreenGlow",
			V(0.95, 0.56, 0.02),
			F(x, BRIDGE_TOP + 1.85, FRONT + 0.5) * CFrame.Angles(math.rad(-15), 0, 0),
			rgb(72, 152, 123),
			M.Neon
		)
	end
	for _, x in { -0.35, 0.35 } do
		beam("ThrusterLever", V(x, BRIDGE_TOP + 1.45, FRONT + 1.05), V(x, BRIDGE_TOP + 1.95, FRONT + 1.15), 0.08, STEEL)
		part("LeverGrip", V(0.2, 0.2, 0.2), F(x, BRIDGE_TOP + 1.97, FRONT + 1.15), ORANGE)
	end
	local seatZ = FRONT + 2.6
	part("HelmPedestal", V(0.5, 0.6, 0.5), F(0, BRIDGE_TOP + 0.3, seatZ), DARK)
	part("HelmCushion", V(2.0, 0.25, 1.6), F(0, BRIDGE_TOP + 0.72, seatZ), DARK)
	part("HelmBack", V(2.0, 1.4, 0.22), F(0, BRIDGE_TOP + 1.5, seatZ + 0.8), DARK)
	local helm = Instance.new("VehicleSeat")
	helm.Size, helm.CFrame = V(2.0, 0.24, 1.6), frame * F(0, BRIDGE_TOP + 0.76, seatZ)
	helm.Transparency, helm.HeadsUpDisplay = 1, false
	helm.MaxSpeed, helm.Torque, helm.TurnSpeed = 0, 0, 0
	finish(helm, "HelmSeat", DARK)
	helm.CanTouch, helm.Disabled = not isAnchored, isAnchored

	-- Two crew seats on the aft deck, facing the stern.
	for _, side in { -1, 1 } do
		part("PassengerPedestal", V(0.42, 0.7, 0.42), F(side * 4.3, DECK_TOP + 0.35, 9.4), DARK)
		part("PassengerCushion", V(1.8, 0.24, 1.5), F(side * 4.3, DECK_TOP + 0.75, 9.4), WHITE)
		part("PassengerBack", V(1.8, 1.0, 0.2), F(side * 4.3, DECK_TOP + 1.35, 8.7), DARK)
		local seat = Instance.new("Seat")
		seat.Size = V(1.8, 0.24, 1.5)
		seat.CFrame = frame * F(side * 4.3, DECK_TOP + 0.8, 9.4) * CFrame.Angles(0, math.pi, 0)
		seat.Transparency = 1
		finish(seat, if side < 0 then "FishingSeatPort" else "FishingSeatStarboard", WHITE)
		seat.CanTouch, seat.Disabled = not isAnchored, isAnchored
	end

	-- Exhaust casings at the aft corners of the bridge deck.
	for _, side in { -1, 1 } do
		part("ExhaustCasing", V(1.3, 2.6, 1.4), F(side * 2.85, BRIDGE_TOP + 1.3, 2.5), WHITE, nil, true)
		cylinder(
			"ExhaustPipe",
			V(1.6, 0.5, 0.5),
			F(side * 2.85, BRIDGE_TOP + 3.4, 2.5) * CFrame.Angles(0, 0, math.pi / 2),
			DARK,
			M.Metal
		)
		part("ExhaustCap", V(0.7, 0.12, 0.7), F(side * 2.85, BRIDGE_TOP + 4.25, 2.5), DARK)
	end
	-- Inflatable liferaft canisters in cradles beside the wheelhouse.
	for _, side in { -1, 1 } do
		part("LiferaftCradle", V(0.9, 0.2, 1.4), F(side * 3.2, BRIDGE_TOP + 0.1, 0.4), STEEL, M.Metal)
		cylinder(
			"Liferaft",
			V(1.5, 0.85, 0.85),
			F(side * 3.2, BRIDGE_TOP + 0.6, 0.4) * CFrame.Angles(0, math.pi / 2, 0),
			WHITE
		)
		part("LiferaftStrap", V(0.9, 0.9, 0.1), F(side * 3.2, BRIDGE_TOP + 0.6, 0.4), ORANGE)
	end

	-- Yellow machinery box and its black vent on the starboard aft deck.
	part("MachineryBox", V(1.9, 2.1, 2.2), F(4.25, DECK_TOP + 1.05, 5.4), YELLOW, nil, true)
	part("MachineryVent", V(1.5, 0.7, 1.7), F(4.25, DECK_TOP + 2.45, 5.4), DARK)
	for dz = -0.6, 0.6, 0.3 do
		part("VentLouvre", V(0.04, 0.4, 0.1), F(3.29, DECK_TOP + 1.45, 5.4 + dz), DARK)
	end

	-- Foredeck towing winch with flanged drum, motor and bow bitts.
	cylinder("WinchDrum", V(2.8, 1.5, 1.5), F(0, DECK_TOP + 1.0, -10.2), GRAY, M.Metal)
	for _, x in { -1.5, 1.5 } do
		cylinder("WinchFlange", V(0.16, 2.1, 2.1), F(x, DECK_TOP + 1.0, -10.2), STEEL, M.Metal)
		part("WinchFrame", V(0.35, 1.1, 1.6), F(x * 1.18, DECK_TOP + 0.55, -10.2), GRAY, M.Metal)
	end
	part("WinchMotor", V(1.2, 1.1, 1.3), F(-2.45, DECK_TOP + 0.55, -10.2), GRAY, M.Metal)
	ring("WoundTowline", V(0, DECK_TOP + 1.0, -10.2), 0.78, 0.09, "X", rgb(214, 196, 150), 12)
	for _, x in { -2.2, 2.2 } do
		for _, dz in { -0.35, 0.35 } do
			cylinder(
				"BowBitt",
				V(0.9, 0.42, 0.42),
				F(x, DECK_TOP + 0.45, -12.6 + dz) * CFrame.Angles(0, 0, math.pi / 2),
				BLACK,
				M.Metal
			)
		end
	end
	part("BowFairlead", V(1.4, 0.4, 0.6), F(0, 3.85, -14.8), BLACK, M.Metal)

	-- Aft towing bitt, stern pins and a coiled towline.
	for _, x in { -0.8, 0.8 } do
		cylinder(
			"TowBitt",
			V(1.3, 0.55, 0.55),
			F(x, DECK_TOP + 0.65, 12.4) * CFrame.Angles(0, 0, math.pi / 2),
			BLACK,
			M.Metal
		)
	end
	beam("TowBittBar", V(-1.2, DECK_TOP + 0.9, 12.4), V(1.2, DECK_TOP + 0.9, 12.4), 0.22, BLACK, M.Metal)
	for _, x in { -1.1, 1.1 } do
		cylinder(
			"TowingPin",
			V(2.0, 0.3, 0.3),
			F(x, DECK_TOP + 1.0, 14.2) * CFrame.Angles(0, 0, math.pi / 2),
			YELLOW,
			M.Metal
		)
	end
	for i = 0, 2 do
		ring("RopeCoil", V(-3.6, DECK_TOP + 0.08 + i * 0.07, 12.2), 0.5 + i * 0.16, 0.1, "Y", rgb(214, 196, 150))
	end

	-- Mast, radar, searchlight, horn and navigation lamps.
	local roofTop = ROOF_Y + 0.3
	beam("Mast", V(0, roofTop, -3.2), V(0, roofTop + 6.8, -3.2), 0.24, YELLOW, M.Metal)
	beam("MastCrossbar", V(-2.0, roofTop + 4.8, -3.2), V(2.0, roofTop + 4.8, -3.2), 0.14, WHITE, M.Metal)
	beam("MastCrossbar", V(-1.2, roofTop + 2.6, -3.2), V(1.2, roofTop + 2.6, -3.2), 0.14, WHITE, M.Metal)
	for _, side in { -1, 1 } do
		beam("MastStay", V(0, roofTop + 4.6, -3.2), V(side * 3.0, roofTop, -1.8), 0.035, STEEL)
		part("SignalLamp", V(0.22, 0.28, 0.22), F(side * 1.9, roofTop + 5.05, -3.2), LAMP, M.Neon)
	end
	part("MastLamp", V(0.26, 0.32, 0.26), F(0, roofTop + 6.95, -3.2), LAMP, M.Neon)
	beam("Aerial", V(0.6, roofTop, -1.6), V(0.6, roofTop + 4.2, -1.65), 0.045, STEEL)
	beam("Aerial", V(-1.8, roofTop, -1.8), V(-1.8, roofTop + 3.0, -1.85), 0.045, STEEL)
	part("Pennant", V(0.04, 0.5, 0.8), F(2.0, roofTop + 4.45, -2.8), ORANGE)
	part("RadarPedestal", V(0.6, 0.6, 0.6), F(0, roofTop + 0.3, -5.6), VISOR)
	part("RadarScanner", V(3.0, 0.2, 0.55), F(0, roofTop + 0.72, -5.6), WHITE)
	cylinder(
		"Searchlight",
		V(0.7, 0.6, 0.6),
		F(-2.0, roofTop + 0.4, -6.4) * CFrame.Angles(0, math.pi / 2, 0),
		DARK,
		M.Metal
	)
	cylinder(
		"RoofHorn",
		V(0.8, 0.26, 0.26),
		F(2.0, roofTop + 0.25, -6.4) * CFrame.Angles(0, math.pi / 2, 0),
		STEEL,
		M.Metal
	)
	for _, side in { -1, 1 } do
		part("NavigationLampHousing", V(0.45, 0.35, 0.6), F(side * (HALF + 0.3), SILL - 0.1, FRONT + 0.6), VISOR)
		part(
			"NavigationLamp",
			V(0.22, 0.22, 0.3),
			F(side * (HALF + 0.42), SILL - 0.1, FRONT + 0.6),
			if side < 0 then rgb(218, 53, 44) else rgb(65, 194, 95),
			M.Neon
		)
		part("HeadlightHousing", V(0.7, 0.55, 0.55), F(side * 2.2, ROOF_Y - 0.55, FRONT - 0.45), DARK, M.Metal)
		local lens =
			part("HeadlightLens", V(0.52, 0.38, 0.05), F(side * 2.2, ROOF_Y - 0.55, FRONT - 0.74), LAMP, M.Neon)
		local light = Instance.new("SpotLight")
		light.Name, light.Face = "Headlight", Enum.NormalId.Front
		light.Color, light.Range, light.Brightness, light.Angle = LAMP, 30, 0.45, 40
		light.Shadows, light.Parent = false, lens
	end
	local workLamp = part("DeckWorkLamp", V(0.7, 0.24, 0.5), F(0, ROOF_Y - 0.35, AFT + 0.5), LAMP, M.Neon)
	local deckLight = Instance.new("PointLight")
	deckLight.Name, deckLight.Color, deckLight.Range, deckLight.Brightness = "DeckLight", LAMP, 14, 0.3
	deckLight.Shadows, deckLight.Parent = false, workLamp

	-- Twin azimuth thrusters under the stern and a short skeg.
	part("Skeg", V(0.3, 1.0, 6.0), F(0, -2.9, 2.0), ANTIFOUL, M.Metal)
	for _, side in { -1, 1 } do
		local x = side * 2.4
		cylinder(
			"ThrusterLeg",
			V(1.2, 0.5, 0.5),
			F(x, -1.9, 11.4) * CFrame.Angles(0, 0, math.pi / 2),
			ANTIFOUL,
			M.Metal
		)
		ring("ThrusterNozzle", V(x, -2.75, 11.4), 0.72, 0.22, "Z", ANTIFOUL, 10)
		cylinder(
			"PropellerHub",
			V(0.6, 0.36, 0.36),
			F(x, -2.75, 11.4) * CFrame.Angles(0, math.pi / 2, 0),
			YELLOW,
			M.Metal
		)
		for i = 0, 3 do
			local a = i * math.pi / 2 + side * 0.4
			part(
				"PropellerBlade",
				V(0.36, 0.62, 0.12),
				F(x + math.sin(a) * 0.34, -2.75 + math.cos(a) * 0.34, 11.4) * CFrame.Angles(0, 0, -a),
				YELLOW,
				M.Metal
			)
		end
	end
	return model
end

return Tugboat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="224">
        <Properties>
          <string name="Name">TutorialService</string>
          <string name="Source"><![CDATA[-- The island tutorial: guides round the home plaza, each dressed for their job (GuideCostume),
-- and each player's saved progress through them. Talking happens on the client; the
-- server only checks the player stood beside the right guide before saving the next step.
-- /tutorial restarts the tour for anyone.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

local Tutorial = require(ReplicatedStorage.Shared.Tutorial)
local BoatService = require(script.Parent.BoatService)
local GuideCostume = require(script.Parent.GuideCostume)
local PlazaHouses = require(script.Parent.Map.PlazaHouses)

local Service = {}
local started = false

local PROMPT = "TutorialNpcPrompt"
local GUIDE_TAG = "TutorialGuide"

local remote: RemoteEvent
local state: Folder
local guides: Folder
-- Feet position of each guide, set as soon as the spot is chosen so arrows work before the model loads.
local positions: { [string]: Vector3 } = {}
local busy: { [Player]: boolean } = {}

local function homePlaza(): (Model?, CFrame?)
	local map = workspace:FindFirstChild("Map")
	if not map then
		return nil, nil
	end
	for _, plaza in map:GetDescendants() do
		-- Other islands have piazzas too; the harbour's is the one with the Drydock.
		if plaza:IsA("Model") and plaza.Name == "Plaza" and plaza:FindFirstChild("Drydock") then
			local frame = PlazaHouses.pavingFrame(plaza)
			if frame then
				return plaza, frame
			end
		end
	end
	return nil, nil
end

-- The frame a guide's Spots are measured in, at ground level, or nil when that shop is missing.
local function anchorFrame(plaza: Model, plazaFrame: CFrame, anchor: string?): CFrame?
	if anchor == nil then
		return plazaFrame
	elseif anchor == "BackpackCounter" then
		local shop = plaza:FindFirstChild("BackpackShop")
		local counter = shop and shop:FindFirstChild("Counter")
		if counter and counter:IsA("BasePart") then
			return counter.CFrame * CFrame.new(0, -counter.Size.Y / 2, 0)
		end
	elseif anchor == "RodShopDoor" or anchor == "FurnitureShopDoor" then
		local shop = plaza:FindFirstChild(if anchor == "RodShopDoor" then "FishingRodShop" else "FurnitureShop")
		local exit = shop and shop:GetAttribute("ExitFrame")
		if typeof(exit) == "CFrame" then
			-- ExitFrame is where a character's root lands outside the door, facing out of it.
			return exit * CFrame.new(0, -3.2, 0)
		end
	end
	return nil
end

local function exclusions(): { Instance }
	local list: { Instance } = { guides }
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(list, player.Character)
		end
	end
	return list
end

-- Paving, kerbs and promenade slabs are parts of the plaza itself (or terrain, or broad flat
-- slabs elsewhere); benches, planters and stalls are their own models with narrow tops.
local function isFloor(plaza: Model, hit: RaycastResult): boolean
	local part = hit.Instance
	if part:IsA("Terrain") or part.Parent == plaza then
		return true
	end
	return part:IsA("BasePart") and math.min(part.Size.X, part.Size.Z) >= 4 and part.Size.Y <= 2
end

-- Ground under a spot, if it is open paving: no prop in the way or underfoot, and nothing
-- (a balcony, an awning) overhead that would catch the ray first.
local function openGround(plaza: Model, position: Vector3): Vector3?
	local ignore = exclusions()
	local rays = RaycastParams.new()
	rays.FilterType = Enum.RaycastFilterType.Exclude
	rays.FilterDescendantsInstances = ignore
	rays.RespectCanCollide = true
	local hit = workspace:Raycast(position + Vector3.new(0, 6, 0), Vector3.new(0, -14, 0), rays)
	if not hit or math.abs(hit.Position.Y - position.Y) > 2.5 or not isFloor(plaza, hit) then
		return nil
	end
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = ignore
	overlap.RespectCanCollide = true
	local box = CFrame.new(hit.Position + Vector3.new(0, 3.2, 0))
	if #workspace:GetPartBoundsInBox(box, Vector3.new(2.6, 4.6, 2.6), overlap) > 0 then
		return nil
	end
	return hit.Position
end

-- The first clear spot; then open paving in widening rings round the listed spots; then the
-- first listed spot so a guide always appears.
local function placement(plaza: Model, plazaFrame: CFrame, npc): CFrame
	local space = anchorFrame(plaza, plazaFrame, npc.Anchor)
	local spots = npc.Spots
	if not space then
		space, spots = plazaFrame, npc.Fallback or npc.Spots
	end
	local frame = space :: CFrame
	local chosen
	for _, spot in spots do
		chosen = openGround(plaza, frame * Vector3.new(spot[1], 0, spot[2]))
		if chosen then
			break
		end
	end
	for radius = 2, 8, 2 do
		if chosen then
			break
		end
		for _, spot in spots do
			for step = 0, 7 do
				local angle = step * math.pi / 4
				local x, z = spot[1] + math.cos(angle) * radius, spot[2] + math.sin(angle) * radius
				chosen = openGround(plaza, frame * Vector3.new(x, 0, z))
				if chosen then
					break
				end
			end
			if chosen then
				break
			end
		end
	end
	if not chosen then
		local first = frame * Vector3.new(spots[1][1], 0, spots[1][2])
		local rays = RaycastParams.new()
		rays.FilterType = Enum.RaycastFilterType.Exclude
		rays.FilterDescendantsInstances = exclusions()
		local hit = workspace:Raycast(first + Vector3.new(0, 6, 0), Vector3.new(0, -14, 0), rays)
		chosen = if hit then hit.Position else first
	end
	local look = frame * Vector3.new(npc.Face[1], 0, npc.Face[2])
	local flat = Vector3.new(look.X, chosen.Y, look.Z)
	if (flat - chosen).Magnitude < 0.1 then
		return CFrame.new(chosen)
	end
	return CFrame.lookAt(chosen, flat)
end

local function talkPrompt(head: BasePart, id: string, npc)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = PROMPT
	prompt.ActionText = "Talk"
	prompt.ObjectText = npc.Name .. " · " .. npc.Title
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.HoldDuration = 0
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.UIOffset = Vector2.new(0, -30)
	prompt:SetAttribute("NpcId", id)
	prompt.Parent = head
end

local function buildGuide(id: string, npc, frame: CFrame)
	local model = GuideCostume.spawn(id, npc.Outfit, npc.Name .. " · " .. npc.Title, frame, guides)
	if not model then
		return
	end
	model:AddTag(GUIDE_TAG)
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		talkPrompt(head, id, npc)
	end
end

local function placeGuides()
	local plaza, plazaFrame = homePlaza()
	if not plaza or not plazaFrame then
		warn("[Tutorial] The harbour plaza is missing; tutorial guides were not placed.")
		return
	end
	for _, id in Tutorial.Order do
		local npc = Tutorial.Npcs[id]
		local frame = placement(plaza, plazaFrame, npc)
		positions[id] = frame.Position
		state:SetAttribute("Npc_" .. id, frame.Position)
		-- Outfit requests yield; load every guide at once.
		task.spawn(buildGuide, id, npc, frame)
	end
end

local function publishState(player: Player): boolean
	local profile = BoatService.getProfile(player)
	if not profile then
		return false
	end
	local angler = profile.Angler
	local step = math.clamp(angler.TutorialStep, 1, #Tutorial.Steps)
	-- A save from a longer future tour counts as finished rather than stranding the player.
	local done = angler.TutorialDone or angler.TutorialStep > #Tutorial.Steps
	player:SetAttribute("TutorialStep", step)
	player:SetAttribute("TutorialDone", done)
	return true
end

local function near(player: Player, id: string): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local position = positions[id]
	return position ~= nil
		and humanoid ~= nil
		and humanoid.Health > 0
		and root ~= nil
		and root:IsA("BasePart")
		and (root.Position - position).Magnitude <= Tutorial.TALK_RANGE
end

-- Runs one saved change at a time per player, then republishes the attributes.
local function change(player: Player, transform: (any) -> ()): boolean
	if busy[player] then
		return false
	end
	busy[player] = true
	local ok = BoatService.updateProgress(player, transform)
	busy[player] = nil
	if ok then
		publishState(player)
	end
	return ok
end

local function finish(player: Player, id: string)
	if not near(player, id) then
		return
	end
	local finished, reward = false, 0
	local ok = change(player, function(profile)
		local angler = profile.Angler
		-- UpdateAsync may retry the transform; recompute from the stored profile every time.
		finished, reward = false, 0
		local step, done = Tutorial.advance(angler.TutorialStep, angler.TutorialDone, id)
		if not step then
			return
		end
		angler.TutorialStep, angler.TutorialDone = step, done
		finished = done
		if done and not angler.TutorialRewarded then
			angler.TutorialRewarded = true
			reward = Tutorial.REWARD
			profile.Cash += reward
		end
	end)
	if ok and finished then
		remote:FireClient(player, "Finished", reward)
	end
end

local function restart(player: Player)
	local ok = change(player, function(profile)
		profile.Angler.TutorialStep, profile.Angler.TutorialDone = 1, false
	end)
	remote:FireClient(
		player,
		"Notice",
		if ok
			then "Tutorial restarted! Follow the arrow to Captain Wren."
			else "The tutorial could not restart right now. Try again in a moment."
	)
end

local function onPlayer(player: Player)
	if publishState(player) then
		return
	end
	-- Profiles load after joining; read the tutorial fields once they arrive.
	local connection
	connection = player:GetAttributeChangedSignal("AnglerRevision"):Connect(function()
		if publishState(player) then
			connection:Disconnect()
		end
	end)
end

function Service.start()
	if started then
		return
	end
	started = true
	state = Instance.new("Folder")
	state.Name = "Tutorial"
	remote = Instance.new("RemoteEvent")
	remote.Name = "Request"
	remote.Parent = state
	state.Parent = ReplicatedStorage
	guides = Instance.new("Folder")
	guides.Name = "TutorialGuides"
	guides.Parent = workspace

	remote.OnServerEvent:Connect(function(player, action, id)
		if action == "Finish" and type(id) == "string" and Tutorial.Npcs[id] then
			finish(player, id)
		elseif action == "Skip" then
			change(player, function(profile)
				profile.Angler.TutorialDone = true
			end)
		end
	end)

	local command = Instance.new("TextChatCommand")
	command.Name = "TutorialCommand"
	command.PrimaryAlias = "/tutorial"
	command.AutocompleteVisible = true
	command.Triggered:Connect(function(source)
		local player = source and Players:GetPlayerByUserId(source.UserId)
		if player then
			restart(player)
		end
	end)
	command.Parent = TextChatService

	Players.PlayerAdded:Connect(onPlayer)
	Players.PlayerRemoving:Connect(function(player)
		busy[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayer, player)
	end
	placeGuides()
end

return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="225">
        <Properties>
          <string name="Name">WeatherService</string>
          <string name="Source"><![CDATA[-- Replicate a small deterministic forecast, never per-frame rain or wave instances.
-- The same epoch drives the time of day; clients animate it every frame, the
-- server only keeps Lighting close for players still loading in.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local DayNight = require(ReplicatedStorage.Shared.DayNight)
local Weather = require(ReplicatedStorage.Shared.Weather)
local WeatherService = {}
local started = false

function WeatherService.start()
	if started then
		return
	end
	started = true
	workspace:SetAttribute("WeatherEpoch", workspace:GetServerTimeNow())
	workspace:SetAttribute("WeatherSeed", Random.new():NextInteger(1, 1000000))
	local elapsed = 1
	local function update(dt: number)
		elapsed += dt
		if elapsed < 0.25 then
			return
		end
		elapsed %= 0.25
		local now = workspace:GetServerTimeNow()
		local state = Weather.getState(now)
		Lighting.ClockTime = DayNight.clockTime(now)
		workspace.GlobalWind = state.windDirection * state.windSpeed
		workspace:SetAttribute("WeatherKind", state.kind)
		workspace:SetAttribute("WeatherRain", state.rain)
		workspace:SetAttribute("WeatherWindSpeed", state.windSpeed)
	end
	update(0)
	RunService.Heartbeat:Connect(update)
end

return WeatherService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="226">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="227">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="228">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="229">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- Map streaming must not block shop input or equipment initialization.
local player = game:GetService("Players").LocalPlayer
local modules = {
	"AdminFly",
	"Leaderboard",
	"ServerUpdates",
	"BiomeAtmosphere",
	"Lod",
	"Metro",
	"Oxygen",
	"Boating",
	"BoatHealth",
	"BoatRefit",
	"BoatAudio",
	"BoatSpray",
	"EnvironmentAudio",
	"CoastalAmbience",
	"BackgroundMusic",
	"ParkedBoats",
	"Fishing",
	"RodWorkshop",
	"RodCrates",
	"FishingAudio",
	"Casting",
	"CastAnimation",
	"SpearCombat",
	"SharkSwim",
	"AmbientFish",
	"CargoHold",
	"BackpackShop",
	"MutationEffects",
	"FishMeshes",
	"Sprint",
	"ShopCustomers",
	"FurnitureShop",
	"BuildMode",
	"Kitchen",
	"KitchenStorage",
	"CompanyIslands",
	"CrabCages",
	"MusselNets",

	"PlayerMenu",
	"WorldMap",
	"Tutorial",
	"PirateCove",
	"HalloweenParty",
	"RodPhysics",
	"RowingAnimation",
	"ShoreWaves",
	"Weather",
	"BlackHoleWeather",
	"VolumetricClouds",
	"SupercellWeather",
	"WeatherRadar",
	"WaterWaves",
	"SwellSurface",
	"SeasonFoliage",
}
local required = { Boating = true, Fishing = true, Oxygen = true, RodPhysics = true, PlayerMenu = true }
local ready = 0
player:SetAttribute("FishingWatersClientReady", false)
player:SetAttribute("FishingWatersClientError", false)
for _, name in modules do
	task.spawn(function()
		local success, message = pcall(function()
			require(script[name]).start()
		end)
		if success and required[name] then
			ready += 1
			if ready == 5 then
				player:SetAttribute("FishingWatersClientReady", true)
			end
		elseif not success then
			if required[name] then
				player:SetAttribute("FishingWatersClientError", true)
			end
			warn("[Client] Could not start " .. name .. ": " .. tostring(message))
		end
	end)
end
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="230">
          <Properties>
            <string name="Name">AdminFly</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Fly = {}
local player = Players.LocalPlayer
local started = false
local character, humanoid, root, velocity
local previousPlatformStand = false

local function stop()
	if velocity then
		velocity:Destroy()
		velocity = nil
	end
	if root and root.Parent then
		root.AssemblyLinearVelocity = Vector3.zero
	end
	if humanoid and humanoid.Parent then
		humanoid.PlatformStand = previousPlatformStand
	end
	character, humanoid, root = nil, nil, nil
end

local function update()
	local current = player.Character
	if not player:GetAttribute("AdminFlyEnabled") or not current then
		if character then stop() end
		return
	end
	if character ~= current or not humanoid or not humanoid.Parent or not root or not root.Parent or humanoid.Health <= 0 then
		if character then stop() end
		local nextHumanoid = current:FindFirstChildOfClass("Humanoid")
		local nextRoot = current:FindFirstChild("HumanoidRootPart")
		if not nextHumanoid or nextHumanoid.Health <= 0 or not nextRoot then return end
		character, humanoid, root = current, nextHumanoid, nextRoot
		previousPlatformStand = humanoid.PlatformStand
		humanoid.Sit = false
		humanoid.PlatformStand = true
		velocity = Instance.new("BodyVelocity")
		velocity.Name = "AdminFlightVelocity"
		velocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		velocity.Velocity = Vector3.zero
		velocity.Parent = root
	end
	local direction = Vector3.zero
	if not UserInputService:GetFocusedTextBox() then
		direction = humanoid.MoveDirection
		local up = UserInputService:IsKeyDown(Enum.KeyCode.Space)
		local down = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
		direction += Vector3.new(0, (if up then 1 else 0) - (if down then 1 else 0), 0)
	end
	if direction.Magnitude > 1 then direction = direction.Unit end
	velocity.Velocity = direction * (player:GetAttribute("AdminFlySpeed") or 50)
end

function Fly.start()
	if started or player.UserId ~= 2541746813 then return end
	started = true
	RunService.Heartbeat:Connect(update)
end

return Fly
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="231">
          <Properties>
            <string name="Name">AmbientFish</string>
            <string name="Source"><![CDATA[-- Cosmetic schools of fish swimming just under the surface around the camera,
-- so the water reads as alive. Client-only: every player sees their own schools
-- and nothing replicates. Species come from the pool the school spawns in, so
-- what swims past is what bites there (commons most of the time).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Biomes = require(ReplicatedStorage.Shared.Biomes)
local FishModels = require(ReplicatedStorage.Shared.FishModels)
local FishSpecies = require(ReplicatedStorage.Shared.FishSpecies)
local Seasons = require(ReplicatedStorage.Shared.Seasons)
local Weather = require(ReplicatedStorage.Shared.Weather)

local AmbientFish = {}
local started = false
local TAU = math.pi * 2
local MAX_SCHOOLS = 8
local SCHOOL_SIZE = NumberRange.new(3, 5)
-- Big species cruise alone instead of in shoals.
local SOLO_KG = 20
local SPAWN_DISTANCE = NumberRange.new(40, 120)
local DESPAWN_DISTANCE = 170
-- School selection is spaced out; models are built or recycled on Heartbeat.
local SPAWN_INTERVAL = 0.6
local MODEL_INTERVAL = 0.12
local MAX_POOLED_FISH = MAX_SCHOOLS * SCHOOL_SIZE.Max
-- From higher up the shallow schools are invisible anyway.
local MAX_CAMERA_HEIGHT = 140
-- Moving welded fish is the costly part, so schools nobody can see skip their
-- move: those behind the camera every frame, distant ones on most frames.
local NEAR_DISTANCE = 60
local FAR_STRIDE = 3
local BEHIND_DOT = 0.15
-- Depth of a fish's top below the calm surface; body size and swell add to it.
local DEPTH = NumberRange.new(3, 6.5)
local SWELL_MARGIN = 1.5 -- wave crests rise this many amplitudes above the calm level
local MIN_CLEARANCE = 3 -- studs of water kept beneath a school
-- Studs per second: a lazy cruise, so schools drift past rather than dart.
local SPEED = NumberRange.new(1, 2.2)
local FLEE_BOOST = 4 -- brief startled dart away from a swimmer
local FLEE_RADIUS = 14
local FLEE_TIME = 1.6
local FLEE_TURN = 6 -- radians per second while turning to escape
local PROBE_INTERVAL = 0.5
local PROBE_AHEAD = 14
-- Bottom dwellers, shellfish, plants and junk never swim in open water.
-- Junk is matched by name too: some (the Tire) are catchable lake commons.
local GROUNDED = {
	"Crab$",
	"Mussel$",
	"Sea Cucumber$",
	"^Shrimp$",
	"^Kelp$",
	"^Seaweed$",
	"^Sea Lettuce$",
	"Tire$",
	"Boot$",
	"Branch$",
}

local function between(range: NumberRange, rng: Random): number
	return rng:NextNumber(range.Min, range.Max)
end

local function swims(species): boolean
	-- Limited species may be switched off on the dashboard, so they never swim past.
	if
		species.DropOnly
		or not species.Pools
		or species.Requires
		or species.Rarity == "Limited"
		or species.Rarity == "Junk"
	then
		return false
	end
	for _, pattern in GROUNDED do
		if string.find(species.Name, pattern) then
			return false
		end
	end
	return true
end

-- Weighted by encounter odds, so a Legendary swimming past stays a rare sight.
local function pickSpecies(pool: string, season: string, rng: Random): string?
	local total, choices = 0, {}
	for id, species in FishSpecies do
		if swims(species) and table.find(species.Pools, pool) and FishModels.has(id) then
			if not species.Seasons or table.find(species.Seasons, season) then
				local weight = 1 / math.max(species.RarityDenominator or 1, 1)
				total += weight
				table.insert(choices, { id = id, weight = weight })
			end
		end
	end
	local roll = rng:NextNumber(0, total)
	for _, choice in choices do
		roll -= choice.weight
		if roll <= 0 then
			return choice.id
		end
	end
	return if #choices > 0 then choices[#choices].id else nil
end

-- Every visible part is welded to one anchored, invisible root, so a frame moves
-- a single part per fish instead of every fin.
local function build(id: string): (Model?, BasePart?)
	local model = FishModels.create(id)
	if not model then
		return nil, nil
	end
	FishModels.scaleCatch(model, FishSpecies[id].AverageKg)
	-- Builders draw the head toward +X around the origin; keep that axis.
	local root = Instance.new("Part")
	root.Name = "SwimRoot"
	root.Size = Vector3.one * 0.2
	root.CFrame = CFrame.new(model:GetPivot().Position)
	root.Transparency = 1
	root.Anchored = true
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") then
			item.Anchored = false
			item.Massless = true
			item.CanCollide, item.CanQuery, item.CanTouch = false, false, false
			item.CastShadow = false
			-- Recycled schools must not pile up in SeasonFoliage's tracked parts.
			item:SetAttribute("SeasonExempt", true)
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1 = root, item
			weld.Parent = root
		end
	end
	root.CanCollide, root.CanQuery, root.CanTouch = false, false, false
	root.Parent = model
	model.PrimaryPart = root
	return model, root
end

function AmbientFish.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local function canSimulate(): boolean
		local camera = workspace.CurrentCamera
		if not camera or player:GetAttribute("MetroRiding") then
			return false
		end
		local eye = camera.CFrame.Position
		-- Surface schools cannot be seen from a dry underground station. Keep
		-- underwater swimming enabled in the ocean, including deep dives.
		return eye.Y - Biomes.WaterLevel <= MAX_CAMERA_HEIGHT
			and (eye.Y >= Biomes.WaterLevel or Biomes.inOceanBounds(eye))
	end
	local folder = Instance.new("Folder")
	folder.Name = "AmbientFish"
	folder.Parent = workspace
	local rng = Random.new()
	local terrainParams = RaycastParams.new()
	terrainParams.FilterType = Enum.RaycastFilterType.Include
	terrainParams.FilterDescendantsInstances = { workspace.Terrain }

	-- Height of the seabed (or dry land) under a point, or nil outside open water.
	local function floorAt(position: Vector3): number?
		if not Biomes.inOceanBounds(position) then
			return nil
		end
		terrainParams.IgnoreWater = false
		local top = Vector3.new(position.X, Biomes.WaterLevel + 6, position.Z)
		local surface = workspace:Raycast(top, Vector3.new(0, -12, 0), terrainParams)
		if not surface or surface.Material ~= Enum.Material.Water then
			return nil
		end
		terrainParams.IgnoreWater = true
		local bed =
			workspace:Raycast(top, Vector3.new(0, -(Biomes.WaterLevel - Biomes.SeaFloor) - 12, 0), terrainParams)
		return if bed then bed.Position.Y else Biomes.SeaFloor
	end

	local schools = {}
	local retired = {}
	local pool = {}
	local pooledCount = 0
	local function despawn(school)
		for _, fish in school.members do
			table.insert(retired, { id = school.id, model = fish.model, root = fish.root })
		end
		table.remove(schools, table.find(schools, school))
	end

	local function spawn(camera: Vector3)
		local angle = rng:NextNumber(0, TAU)
		local origin = camera + Vector3.new(math.cos(angle), 0, math.sin(angle)) * between(SPAWN_DISTANCE, rng)
		local now = workspace:GetServerTimeNow()
		local pool = if Weather.inLake(origin) then "MainLake" else "OpenSea"
		local id = pickSpecies(pool, (Seasons.current(now)), rng)
		if not id then
			return
		end
		local species = FishSpecies[id]
		local count = if species.AverageKg >= SOLO_KG then 1 else rng:NextInteger(SCHOOL_SIZE.Min, SCHOOL_SIZE.Max)
		local length = FishModels.catchLength(species.AverageKg, id)
		local spacing = math.max(length * 1.4, 1.5)
		-- Clear the body, the school's vertical spread, the bob and rough swell so
		-- fins and backs never break the surface.
		local spread = if count == 1 then 0 else spacing * 0.3
		local depth = between(DEPTH, rng)
			+ length * 0.5
			+ spread
			+ Weather.getState(now, origin).waveAmplitude * SWELL_MARGIN
		local floor = floorAt(origin)
		if not floor or floor > Biomes.WaterLevel - depth - MIN_CLEARANCE then
			return
		end
		local center = Vector3.new(origin.X, Biomes.WaterLevel - depth, origin.Z)
		local school = {
			id = id,
			remaining = count,
			spacing = spacing,
			solo = count == 1,
			center = center,
			depth = depth,
			heading = rng:NextNumber(0, TAU),
			turn = 0,
			turnTarget = 0,
			nextTurn = 0,
			nextProbe = 0,
			speed = between(SPEED, rng),
			currentSpeed = 0,
			fleeUntil = 0,
			fleeHeading = 0,
			blockedUntil = 0,
			blockedDirection = Vector3.xAxis,
			members = {},
		}
		table.insert(schools, school)
	end

	-- Limit cloning, parenting and disposal to one fish per Heartbeat. A bounded
	-- species-specific pool avoids rebuilding schools as the boat travels.
	local modelElapsed = MODEL_INTERVAL
	RunService.Heartbeat:Connect(function(dt: number)
		modelElapsed += dt
		if #retired > 0 then
			debug.profilebegin("AmbientFish/Recycle")
			local fish = table.remove(retired)
			fish.model.Parent = nil
			if pooledCount < MAX_POOLED_FISH then
				local bucket = pool[fish.id]
				if not bucket then
					bucket = {}
					pool[fish.id] = bucket
				end
				table.insert(bucket, fish)
				pooledCount += 1
			else
				fish.model:Destroy()
			end
			debug.profileend()
			return
		end
		-- Check here too: the ride attribute can change between render updates.
		if not canSimulate() or modelElapsed < MODEL_INTERVAL then
			return
		end
		modelElapsed = 0
		for _, school in schools do
			if school.remaining <= 0 then
				continue
			end
			school.remaining -= 1
			debug.profilebegin("AmbientFish/BuildOrReuse")
			local bucket = pool[school.id]
			local fish = if bucket then table.remove(bucket) else nil
			local model, root
			if fish then
				pooledCount -= 1
				model, root = fish.model, fish.root
			else
				model, root = build(school.id)
			end
			if not model or not root then
				school.remaining = 0
				if #school.members == 0 then
					despawn(school)
				end
				debug.profileend()
				return
			end
			local offset = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.3, 0.3), rng:NextNumber(-1, 1))
				* school.spacing
			if school.solo then
				offset = Vector3.zero
			end
			-- Start in the slot the school will hold, not swinging into it.
			local position = school.center + CFrame.Angles(0, -school.heading, 0) * offset
			root.CFrame = CFrame.new(position)
			model.Parent = folder
			table.insert(school.members, {
				model = model,
				root = root,
				offset = offset,
				position = position,
				direction = Vector3.new(math.cos(school.heading), 0, math.sin(school.heading)),
				phase = rng:NextNumber(0, TAU),
				-- How tightly a fish holds its slot; loose springs sloshed fish back and
				-- forth through the school whenever it sped up, slowed or turned.
				lag = rng:NextNumber(4, 6),
			})
			debug.profileend()
			return
		end
	end)

	-- Movement runs every rendered frame: stepping slower than the display reads
	-- as jitter on something this close to the camera.
	local spawnElapsed = SPAWN_INTERVAL
	local frame = 0
	RunService.RenderStepped:Connect(function(dt: number)
		dt = math.min(dt, 0.1)
		frame += 1
		if not canSimulate() then
			for index = #schools, 1, -1 do
				despawn(schools[index])
			end
			spawnElapsed = SPAWN_INTERVAL
			return
		end
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local eye = camera.CFrame.Position
		local look = camera.CFrame.LookVector
		local flat = Vector3.new(eye.X, 0, eye.Z)
		for index = #schools, 1, -1 do
			local school = schools[index]
			local offset = Vector3.new(school.center.X, 0, school.center.Z) - flat
			if offset.Magnitude > DESPAWN_DISTANCE then
				despawn(school)
			end
		end
		spawnElapsed += dt
		if #schools < MAX_SCHOOLS and spawnElapsed >= SPAWN_INTERVAL then
			spawnElapsed = 0
			spawn(eye)
		end

		local now = os.clock()
		local character = player.Character
		local body = character and character:FindFirstChild("HumanoidRootPart")
		local threat = if body
				and body:IsA("BasePart")
				and body.Position.Y < Biomes.WaterLevel + 4
			then body.Position
			else nil
		local roots, frames = {}, {}
		for index = #schools, 1, -1 do
			local school = schools[index]
			-- Wander with slow, smoothed turns.
			if now >= school.nextTurn then
				school.nextTurn = now + rng:NextNumber(2, 6)
				school.turnTarget = rng:NextNumber(-0.5, 0.5)
			end
			local forward = Vector3.new(math.cos(school.heading), 0, math.sin(school.heading))
			if now >= school.nextProbe then
				school.nextProbe = now + PROBE_INTERVAL
				local here = floorAt(school.center)
				if not here or here > school.center.Y - 1 then
					-- Stranded anyway (terrain edits, a missed probe): never linger on land.
					despawn(school)
					continue
				end
				local floor = floorAt(school.center + forward * PROBE_AHEAD)
				if not floor or floor > school.center.Y - MIN_CLEARANCE then
					-- Shallows, a beach or the map edge ahead: swing round, and never
					-- flee that way, so a swimmer can't chase fish ashore.
					school.turnTarget = if school.turnTarget >= 0 then 1.6 else -1.6
					school.nextTurn = now + 1.5
					school.blockedUntil = now + 1.5
					school.blockedDirection = forward
				end
			end
			local blocked = now < school.blockedUntil
			if threat then
				local away = Vector3.new(school.center.X - threat.X, 0, school.center.Z - threat.Z)
				local towardShore = blocked and away:Dot(school.blockedDirection) > 0
				if away.Magnitude < FLEE_RADIUS and away.Magnitude > 0.01 and not towardShore then
					school.fleeUntil = now + FLEE_TIME
					school.fleeHeading = math.atan2(away.Z, away.X)
				end
			end
			local fleeHeading = Vector3.new(math.cos(school.fleeHeading), 0, math.sin(school.fleeHeading))
			local fleeing = now < school.fleeUntil
				and not (blocked and fleeHeading:Dot(school.blockedDirection) > 0)
			if fleeing then
				-- Steer onto the escape line quickly but continuously; snapping the
				-- heading swung every member across the school each frame.
				local delta = (school.fleeHeading - school.heading + math.pi) % TAU - math.pi
				school.heading += math.clamp(delta, -FLEE_TURN * dt, FLEE_TURN * dt)
				school.turn = 0
			else
				school.turn += (school.turnTarget - school.turn) * (1 - math.exp(-dt * 1.5))
				school.heading += school.turn * dt
			end
			-- Ease speed changes too, and slow right down while turning off a shore.
			local targetSpeed = school.speed * (if fleeing then FLEE_BOOST elseif blocked then 0.4 else 1)
			-- A startle bolts at once; settling back to a cruise is gradual.
			local ease = if targetSpeed > school.currentSpeed then 8 else 2
			school.currentSpeed += (targetSpeed - school.currentSpeed) * (1 - math.exp(-dt * ease))
			local speed = school.currentSpeed
			forward = Vector3.new(math.cos(school.heading), 0, math.sin(school.heading))
			school.center += forward * speed * dt
			local spin = CFrame.Angles(0, -school.heading, 0)
			local toSchool = school.center - eye
			local distance = toSchool.Magnitude
			local shown = fleeing
				or distance < FLEE_RADIUS
				or (look:Dot(toSchool / distance) > BEHIND_DOT and (distance < NEAR_DISTANCE or (frame + index) % FAR_STRIDE == 0))
			for _, fish in school.members do
				local bob = Vector3.yAxis * math.sin(now * 0.8 + fish.phase) * 0.25
				local target = school.center + spin * fish.offset + bob
				local step = target - fish.position
				fish.position += step * (1 - math.exp(-dt * fish.lag))
				local heading = (forward * speed + step * 0.6)
				if heading.Magnitude > 0.05 then
					fish.direction = fish.direction:Lerp(heading.Unit, 1 - math.exp(-dt * 4))
				end
				if not shown then
					continue
				end
				local direction = Vector3.new(fish.direction.X, fish.direction.Y * 0.3, fish.direction.Z)
				if direction.Magnitude < 0.01 then
					direction = forward
				end
				-- A body yaw at swimming frequency reads as a tail beat at this range.
				local wiggle = math.sin(now * (2.5 + speed) + fish.phase) * 0.07
				table.insert(roots, fish.root)
				table.insert(
					frames,
					CFrame.lookAt(fish.position, fish.position + direction) * CFrame.Angles(0, math.pi / 2 + wiggle, 0)
				)
			end
		end
		if #roots > 0 then
			debug.profilebegin("AmbientFish/Move")
			workspace:BulkMoveTo(roots, frames, Enum.BulkMoveMode.FireCFrameChanged)
			debug.profileend()
		end
	end)
end

return AmbientFish
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="232">
          <Properties>
            <string name="Name">BackgroundMusic</string>
            <string name="Source"><![CDATA[-- Background music: a warm harbor playlist while on land and a calmer, more open
-- orchestral playlist out at sea. Every track is from Roblox's licensed music
-- library (free for every experience). PlayerSettings routes these sounds into
-- the Music mixer through their AudioCategory, so the Music slider applies.
local ContentProvider = game:GetService("ContentProvider")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Aboard = require(ReplicatedStorage.Shared.Aboard)

local BackgroundMusic = {}
local started = false
-- Both playlists are acoustic; the sea one sits a touch lower so the waves
-- stay in front of it.
local VOLUMES = { Island = 0.22, Ocean = 0.2 }
-- Swimming off a dock or stepping onto a moored deck must not flip the music.
local SWITCH_DELAY = 4
-- Out at sea the waves carry the quiet between tracks, so leave more of it.
local GAPS = { Island = NumberRange.new(3, 6), Ocean = NumberRange.new(10, 25) }
local FADE_RATE = 0.8

local PLAYLISTS = {
	-- APM "Easy Acoustic Chill" vols 1-2: laid-back modern acoustic guitar for
	-- a sunny fishing village, without sad or high-energy titles.
	Island = {
		"rbxassetid://1842613995", -- Easy Life (Jacob King)
		"rbxassetid://1842600804", -- Lazy Days (Jacob King)
		"rbxassetid://1842600316", -- Sunday Vibe (Terry Caster)
		"rbxassetid://1842601084", -- Twilight Beach (James Asher)
		"rbxassetid://1842613783", -- Castaway - Underscore (Terry Caster)
	},
	-- Slow, soft piano and acoustic guitar that sits under the waves instead of
	-- over them. docs/FISCH_FEEL.md says why each was picked and lists spares.
	Ocean = {
		"rbxassetid://1838786430", -- The Grace and the Gamble ("soft and lush piano and acoustic guitar")
		"rbxassetid://1846315728", -- Andante For Guitar And Piano In C Major
		"rbxassetid://9045573146", -- No Clouds Outside, underscore ("relaxed, peaceful acoustic")
		"rbxassetid://1839919231", -- Lonely Promises ("calm and laid-back, peaceful guitar bed")
		"rbxassetid://1839967674", -- In Five b ("tender piano melody, underscore")
		"rbxassetid://1837380492", -- Happy Birds Fly ("peaceful & fragile, piano")
	},
}

local function shuffled(list: { string }, avoidFirst: string?): { string }
	local result = table.clone(list)
	for i = #result, 2, -1 do
		local j = math.random(i)
		result[i], result[j] = result[j], result[i]
	end
	-- Never repeat the track that just finished when the order reshuffles.
	if #result > 1 and result[1] == avoidFirst then
		result[1], result[#result] = result[#result], result[1]
	end
	return result
end

local function atSea(character: Model?): boolean?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not humanoid or humanoid.Health <= 0 then
		return nil
	end
	if humanoid:GetState() == Enum.HumanoidStateType.Swimming then
		return true
	end
	local boats = workspace:FindFirstChild("PlayerBoats")
	if boats then
		for _, boat in boats:GetChildren() do
			if boat:IsA("Model") and Aboard(character, boat) then
				return true
			end
		end
	end
	return false
end

function BackgroundMusic.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local folder = Instance.new("Folder")
	folder.Name = "BackgroundMusic"
	folder.Parent = SoundService

	local zones = {}
	for name, list in PLAYLISTS do
		local sound = Instance.new("Sound")
		sound.Name = name .. "Music"
		sound.Volume = 0
		sound:SetAttribute("AudioCategory", "Music")
		sound.Parent = folder
		local zone = {
			name = name,
			sound = sound,
			list = list,
			order = shuffled(list),
			index = 0,
			waitUntil = 0,
			finished = true,
		}
		zones[name] = zone
		sound.Ended:Connect(function()
			local gap = GAPS[name]
			zone.finished, zone.waitUntil = true, os.clock() + gap.Min + math.random() * (gap.Max - gap.Min)
		end)
	end
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync({ zones.Island.order[1], zones.Ocean.order[1] })
		end)
	end)

	local function nextTrack(zone)
		zone.index += 1
		if zone.index > #zone.order then
			zone.order = shuffled(zone.list, zone.order[#zone.order])
			zone.index = 1
		end
		zone.sound.SoundId = zone.order[zone.index]
		zone.sound.TimePosition = 0
		zone.sound:Play()
		zone.finished = false
	end

	local current = zones.Island
	local pending: string? = nil
	local pendingSince = 0
	local sampleElapsed = math.huge
	RunService.Heartbeat:Connect(function(dt: number)
		local now = os.clock()
		-- The deck raycast is cheap but needs no per-frame resolution.
		sampleElapsed += dt
		if sampleElapsed >= 0.5 then
			sampleElapsed = 0
			local sea = atSea(player.Character)
			local wanted = if sea == nil then current.name elseif sea then "Ocean" else "Island"
			if wanted == current.name then
				pending = nil
			elseif wanted ~= pending then
				pending, pendingSince = wanted, now
			elseif now - pendingSince >= SWITCH_DELAY then
				current, pending = zones[wanted], nil
			end
		end
		local blend = 1 - math.exp(-math.clamp(dt, 0, 0.1) * FADE_RATE * 3)
		for _, zone in zones do
			local sound = zone.sound
			if zone == current then
				-- Resume where this zone's track was paused; start a new one after
				-- the previous track's short gap, or on the very first frame.
				if not sound.IsPlaying then
					if not zone.finished then
						sound:Resume()
					elseif now >= zone.waitUntil then
						nextTrack(zone)
					end
				end
				sound.Volume += (VOLUMES[zone.name] - sound.Volume) * blend
			else
				sound.Volume += (0 - sound.Volume) * blend
				if sound.Volume < 0.005 and sound.IsPlaying then
					sound.Volume = 0
					sound:Pause()
				end
			end
		end
	end)
end

return BackgroundMusic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="233">
          <Properties>
            <string name="Name">BackpackShop</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Backpacks = require(ReplicatedStorage.Shared.BackpackCatalog)
local Cargo = require(ReplicatedStorage.Shared.Cargo)
local Models = require(ReplicatedStorage.Shared.BackpackModels)
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))
local Shop = {}
local started = false
local function make(class, parent, properties)
	local item = Instance.new(class)
	for key, value in properties do
		item[key] = value
	end
	item.Parent = parent
	return item
end

function Shop.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local request = ReplicatedStorage:WaitForChild("BackpackShop")
	local gui = make("ScreenGui", player:WaitForChild("PlayerGui"), {
		Name = "BackpackShop",
		ResetOnSpawn = false,
		DisplayOrder = 29,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	local overlay = make("TextButton", gui, {
		Size = UDim2.fromScale(1, 1),
		Text = "",
		BackgroundColor3 = Color3.new(),
		BackgroundTransparency = 0.35,
		Visible = false,
		AutoButtonColor = false,
		Modal = true,
	})
	local card = make("Frame", overlay, {
		Active = true,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(540, 580),
	})
	Theme.window(card)
	local scale = make("UIScale", card, {})
	local function label(parent, value, position, size, textSize)
		local item = make("TextLabel", parent, {
			BackgroundTransparency = 1,
			Text = value,
			Position = position,
			Size = size,
			TextSize = textSize,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		Theme.text(item)
		return item
	end
	label(card, "PLAZA BACKPACK STORE", UDim2.fromOffset(20, 16), UDim2.fromOffset(440, 30), 24)
	local status = label(card, "", UDim2.fromOffset(20, 52), UDim2.fromOffset(490, 44), 14)
	label(
		card,
		"Fish use the same shaped tiles as boat cargo. Open Backpack [C], pick up your hand fish, rotate and pack it.",
		UDim2.fromOffset(20, 98),
		UDim2.fromOffset(500, 45),
		14
	)
	local close = make(
		"TextButton",
		card,
		{ Text = "×", TextSize = 24, Position = UDim2.new(1, -48, 0, 12), Size = UDim2.fromOffset(36, 36) }
	)
	Theme.button(close, "Danger")
	local list = make("ScrollingFrame", card, {
		Position = UDim2.fromOffset(18, 154),
		Size = UDim2.new(1, -36, 1, -174),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 5,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	})
	make("UIListLayout", list, { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder })
	local rows = {}
	local state = nil
	local pending = false
	local message = ""
	local function render()
		local current = if state then state.BackpackId else "Starter"
		status.Text = if message ~= ""
			then message
			elseif state then string.format(
				"Wallet: $%d · Equipped: %s",
				state.Cash,
				(Backpacks.Items[current] or Backpacks.Items.Starter).Name
			)
			else "Loading your backpack…"
		for id, row in rows do
			local owned = Backpacks.rank(id) <= Backpacks.rank(current)
			local price = Backpacks.Items[id].Price
			row.Active = state ~= nil and not pending and not owned and state.Cash >= price
			row.Text = if pending
				then "Please wait"
				elseif id == current then "Equipped"
				elseif owned then "Owned"
				elseif state and state.Cash < price then "Need $" .. price
				else "Buy · $" .. price
			Theme.button(row, if row.Active then "Normal" else "Disabled")
		end
	end
	local function invoke(action, id)
		if pending then
			return
		end
		pending, message = true, ""
		render()
		task.spawn(function()
			local ok, result = pcall(request.InvokeServer, request, action, id)
			pending = false
			if ok and type(result) == "table" then
				state = result.State or state
				message = result.Message or ""
			else
				message = "Could not reach the backpack store. Try again."
			end
			render()
		end)
	end
	for index, id in Backpacks.Order do
		local item = Backpacks.Items[id]
		local row = make("Frame", list, { Name = id, LayoutOrder = index, Size = UDim2.new(1, -8, 0, 152) })
		Theme.glassPanel(row, true)
		local view = make("ViewportFrame", row, {
			Name = "ModelPreview",
			Position = UDim2.fromOffset(10, 10),
			Size = UDim2.fromOffset(116, 132),
			BackgroundColor3 = Color3.fromRGB(25, 34, 35),
			BorderSizePixel = 0,
		})
		Models.show(view, id)
		label(row, item.Name, UDim2.fromOffset(142, 12), UDim2.new(1, -152, 0, 25), 19)
		label(
			row,
			string.format("%d tiles · %d × %d grid", Cargo.capacity(item.Hold), #item.Hold[1], #item.Hold),
			UDim2.fromOffset(142, 40),
			UDim2.new(1, -152, 0, 20),
			14
		)
		label(row, item.Description, UDim2.fromOffset(142, 65), UDim2.new(1, -156, 0, 34), 13)
		local buy = make("TextButton", row, {
			Name = "Buy",
			Position = UDim2.fromOffset(142, 108),
			Size = UDim2.new(1, -158, 0, 32),
			Text = "",
			TextSize = 15,
		})
		Theme.button(buy)
		rows[id] = buy
		buy.Activated:Connect(function()
			if buy.Active and not pending then
				invoke("Buy", id)
			end
		end)
	end
	close.Activated:Connect(function()
		overlay.Visible = false
	end)
	overlay.Activated:Connect(function()
		overlay.Visible = false
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.Escape then
			overlay.Visible = false
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
		if prompt.Name ~= "BrowseBackpacksPrompt" or (who and who ~= player) then
			return
		end
		overlay.Visible = true
		invoke("Get")
	end)
	RunService.RenderStepped:Connect(function()
		if overlay.Visible and workspace.CurrentCamera then
			local viewport = workspace.CurrentCamera.ViewportSize
			scale.Scale = math.min(1, (viewport.X - 24) / 540, (viewport.Y - 32) / 580)
		end
	end)
	render()
end
return Shop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="234">
          <Properties>
            <string name="Name">BiomeAtmosphere</string>
            <string name="Source"><![CDATA[-- Blends water colour, fog and colour grading toward whichever biome the camera is in,
-- and shows the area's name when you cross into it. Also runs the day/night clock
-- and darkens every biome's look at night.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Biomes = require(ReplicatedStorage.Shared.Biomes)
local DayNight = require(ReplicatedStorage.Shared.DayNight)
local Weather = require(ReplicatedStorage.Shared.Weather)
local PlayerSettings = require(script.Parent.PlayerSettings)

local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))
local BiomeAtmosphere = {}

local WEATHER_BLEND = TweenInfo.new(0.65, Enum.EasingStyle.Linear)
local DIVE_BLEND = TweenInfo.new(0.3, Enum.EasingStyle.Sine)
local SATURATION_REDUCTION = 0.1
local UNDERWATER_BLUE = Color3.fromRGB(65, 150, 210)
local UNDERWATER_FOG_COLOR = Color3.fromRGB(32, 96, 128)
local UNDERWATER_VISIBILITY = 10 / 0.28 -- 10 metres in Roblox studs
-- Terrain uses its own underwater fog instead of Lighting.FogEnd. Calibrated in
-- Studio: nearby objects remain visible, while a marker at 36 studs fades out.
local UNDERWATER_TRANSPARENCY = 0.01
local FADE = TweenInfo.new(1.5, Enum.EasingStyle.Sine)
local LEAVE_MARGIN = 1.1 -- stay in a biome until this far past its edge, so the title doesn't flicker
-- Deep-night targets each biome's look blends toward. The fog matches the night
-- sky so the horizon doesn't glow as a pale band, and distant islands fade into darkness.
local NIGHT_FOG = Color3.fromRGB(18, 24, 42)
local NIGHT_DECAY = Color3.fromRGB(8, 11, 24)
-- Dusk and dawn warm the far haze, with a glow on the sun's side.
local TWILIGHT_FOG = Color3.fromRGB(226, 156, 124)
local TWILIGHT_DECAY = Color3.fromRGB(118, 70, 78)
local NIGHT_TINT = Color3.fromRGB(188, 204, 255)
local NIGHT_CLOUDS = Color3.fromRGB(38, 44, 64)
local NIGHT_AMBIENT = Color3.fromRGB(44, 54, 86)

local function ensure<T>(parent: Instance, className: string): T
	local existing = parent:FindFirstChildOfClass(className)
	if existing then
		return existing :: any
	end
	local created = Instance.new(className)
	created.Parent = parent
	return created :: any
end

local function makeTitle(): TextLabel
	local gui = Instance.new("ScreenGui")
	gui.Name = "AreaTitle"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true

	local label = Instance.new("TextLabel")
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.2)
	label.Size = UDim2.new(0.8, 0, 0, 60)
	label.BackgroundTransparency = 1
	Theme.text(label)
	label.TextSize = 44
	label.TextColor3 = Theme.Colors.Text
	label.TextStrokeColor3 = Theme.Colors.Black
	label.TextStrokeTransparency = 1
	label.TextTransparency = 1
	label.Parent = gui

	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return label
end

function BiomeAtmosphere.start()
	local terrain = workspace.Terrain
	local atmosphere = ensure(Lighting, "Atmosphere") :: Atmosphere
	-- Weather lightning owns a separate effect, regardless of startup order.
	local grading = Lighting:FindFirstChild("BiomeColorGrading") :: ColorCorrectionEffect?
	if not grading then
		grading = Instance.new("ColorCorrectionEffect")
		grading.Name = "BiomeColorGrading"
		grading.Parent = Lighting
	end
	local clouds = ensure(terrain, "Clouds") :: Clouds
	local sky = ensure(Lighting, "Sky") :: Sky
	local celestialBodiesShown = sky.CelestialBodiesShown
	local title = makeTitle()
	local titleToken = 0
	local surfaceAmbient = Lighting.Ambient
	local surfaceFogColor = Lighting.FogColor
	local surfaceFogStart = Lighting.FogStart
	local surfaceFogEnd = Lighting.FogEnd
	local activeTweens: { Tween } = {}

	local function showTitle(text: string)
		titleToken += 1
		local token = titleToken
		title.Text = text
		TweenService:Create(title, FADE, { TextTransparency = 0, TextStrokeTransparency = 0 }):Play()
		task.delay(4, function()
			if token == titleToken then
				TweenService:Create(title, FADE, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
			end
		end)
	end

	local function apply(biome: Biomes.Biome, underwater: boolean, transition: TweenInfo)
		for _, tween in activeTweens do
			tween:Cancel()
		end
		table.clear(activeTweens)
		local function blend(instance: Instance, properties: { [string]: any })
			local tween = TweenService:Create(instance, transition, properties)
			table.insert(activeTweens, tween)
			tween:Play()
		end
		local look = biome.look
		local now = workspace:GetServerTimeNow()
		local camera = workspace.CurrentCamera
		local weather = Weather.getState(now, if camera then camera.CFrame.Position else Vector3.zero)
		local rain, storm = weather.rain, weather.storm
		local overcast = math.max(weather.cloudCover, math.clamp(rain / 0.08, 0, 1))
		-- The built-in sky otherwise draws the moon and stars through rain clouds.
		sky.CelestialBodiesShown = celestialBodiesShown and overcast < 0.85 and weather.kind ~= "BlackHole"
		clouds.Enabled = true
		local night = DayNight.darkness(DayNight.clockTime(now))
		-- Light under a supercell turns dim and faintly green.
		local cell = if camera then Weather.supercellCover(camera.CFrame.Position, weather.supercell) else 0
		local blackHole = weather.kind == "BlackHole"
		-- Distance fog is disabled while Atmosphere is in Lighting. Terrain also
		-- has its own underwater fog: set its opacity immediately on entry so the
		-- first submerged frame cannot see through the ocean during a dive tween.
		Lighting.FogColor = if blackHole then Color3.fromRGB(29, 5, 48)
			elseif underwater then UNDERWATER_FOG_COLOR else surfaceFogColor
		Lighting.FogStart = if underwater then 0 else surfaceFogStart
		Lighting.FogEnd = if underwater then UNDERWATER_VISIBILITY else surfaceFogEnd
		atmosphere.Parent = if underwater then nil else Lighting
		local waterColor = if blackHole then Color3.fromRGB(33, 6, 53)
			elseif underwater then UNDERWATER_BLUE else look.waterColor
		if underwater then
			terrain.WaterColor = waterColor
			terrain.WaterTransparency = UNDERWATER_TRANSPARENCY
		else
			blend(terrain, {
				WaterColor = waterColor,
				WaterTransparency = if blackHole then 0.22 else Biomes.SurfaceWaterTransparency,
			})
		end
		terrain.WaterReflectance = Biomes.WaterReflectance
		if blackHole then
			-- The admin event covers every biome, including the water beneath it.
			if not underwater then
				blend(atmosphere, {
					Offset = Biomes.DistanceFogOffset,
					Color = Color3.fromRGB(67, 17, 93),
					Decay = Color3.fromRGB(26, 3, 44),
					Density = 0.46,
					Haze = 3.2,
					Glare = 0,
				})
			end
			blend(grading, {
				TintColor = Color3.fromRGB(177, 108, 233),
				Brightness = if underwater then -0.04 else -0.12,
				Saturation = -0.2 - SATURATION_REDUCTION,
				Contrast = 0.16,
			})
			blend(clouds, { Cover = 1, Density = 0.9, Color = Color3.fromRGB(31, 7, 48) })
			blend(Lighting, {
				Ambient = Color3.fromRGB(39, 15, 61),
				OutdoorAmbient = Color3.fromRGB(47, 18, 68),
				Brightness = 0.45,
			})
			return
		end
		if not underwater then
			-- Peaks halfway through dusk/dawn; clouds hide the sunset.
			local twilight = 4 * night * (1 - night) * (1 - overcast)
			-- Under a night cloud deck the fog lifts toward the clouds instead of a black wall.
			local nightFog = NIGHT_FOG:Lerp(NIGHT_CLOUDS, overcast * 0.6)
			blend(atmosphere, {
				Offset = Biomes.DistanceFogOffset,
				Color = look.atmosphereColor
					:Lerp(Color3.fromRGB(112, 125, 142), rain * 0.65)
					:Lerp(TWILIGHT_FOG, twilight * 0.45)
					:Lerp(nightFog, night),
				Decay = look.atmosphereDecay
					:Lerp(Color3.fromRGB(55, 64, 82), rain * 0.5)
					:Lerp(TWILIGHT_DECAY, twilight * 0.5)
					:Lerp(NIGHT_DECAY, night),
				-- A touch thicker at night so far scenery dissolves into the dark.
				Density = math.min(0.5, look.density + rain * 0.13 + night * 0.06),
				-- Thin haze on clear nights; a bright haze layer reads as a glowing horizon.
				Haze = (look.haze + rain * 1.8) * (1 - night * 0.7 * (1 - overcast)),
				Glare = (look.glare * (1 - night) + twilight * 0.5) * (1 - rain),
			})
		end
		blend(grading, {
			TintColor = if underwater
				then Color3.fromRGB(215, 240, 255)
				else look.tint
					:Lerp(Color3.fromRGB(177, 193, 215), rain * 0.3)
					:Lerp(Color3.fromRGB(176, 214, 188), cell * 0.45)
					:Lerp(NIGHT_TINT, night * 0.6),
			Brightness = if underwater then 0.06 else 0,
			Saturation = (if underwater then 0.05 else look.saturation - rain * 0.12 - night * 0.15)
				- SATURATION_REDUCTION,
			Contrast = if underwater then 0 else look.contrast + storm * 0.04,
		})
		blend(clouds, {
			Cover = look.cloudCover + (1 - look.cloudCover) * overcast,
			Density = 0.5 + overcast * 0.5,
			Color = look.cloudColor:Lerp(Color3.fromRGB(75, 83, 99), rain * 0.8):Lerp(NIGHT_CLOUDS, night * 0.8),
		})
		blend(Lighting, {
			Ambient = if underwater then Color3.fromRGB(115, 145, 170) else surfaceAmbient,
			OutdoorAmbient = if underwater
				then Color3.fromRGB(145, 175, 200)
				else look.ambient:Lerp(Color3.fromRGB(68, 78, 96), rain * 0.75):Lerp(NIGHT_AMBIENT, night * 0.85),
			Brightness = (if underwater then 2 else 2 - rain * 0.95 - storm * 0.2 - cell * 0.35) * (1 - night * 0.45),
		})
	end

	local current: Biomes.Biome? = nil
	local underwater = false
	local biomeElapsed = 0.5
	local weatherElapsed = 0.5
	-- Follow the camera (including third-person/free cameras), not the avatar.
	RunService:BindToRenderStep("BiomeAtmosphere", Enum.RenderPriority.Camera.Value + 1, function(dt: number)
		local camera = workspace.CurrentCamera
		if not camera then
			PlayerSettings.setUnderwater(false)
			return
		end
		Lighting.ClockTime = DayNight.clockTime()
		local position = camera.CFrame.Position
		biomeElapsed += dt
		weatherElapsed += dt
		local biomeChanged = false
		if biomeElapsed >= 0.5 then
			biomeElapsed = 0
			local stay = current and current ~= Biomes.OpenSea and Biomes.depthIn(current, position) < LEAVE_MARGIN
			local biome = if stay then current :: Biomes.Biome else Biomes.at(position)
			if biome ~= current then
				current = biome
				biomeChanged = true
				showTitle(biome.name)
			end
		end
		-- Enter at the surface immediately; only delay the exit slightly to avoid
		-- flickering as the camera skims the waves.
		local inOcean = not Players.LocalPlayer:GetAttribute("MetroRiding") and Biomes.inOceanBounds(position)
			and position.Y > Biomes.SeaFloor
		local submerged = inOcean and position.Y < Biomes.WaterLevel + (if underwater then 0.1 else 0)
		local waterChanged = submerged ~= underwater
		underwater = submerged
		PlayerSettings.setUnderwater(underwater)
		if current and (biomeChanged or waterChanged or weatherElapsed >= 0.5) then
			weatherElapsed = 0
			apply(current, underwater, if waterChanged then DIVE_BLEND else WEATHER_BLEND)
		end
	end)
end

return BiomeAtmosphere
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="235">
          <Properties>
            <string name="Name">BlackHoleWeather</string>
            <string name="Source"><![CDATA[-- A client-only singularity and three rotating water spirals. The server owns
-- the event location and mutation radius; these parts never affect physics.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Weather = require(ReplicatedStorage.Shared.Weather)
local Controller = {}
local started = false
local TAU = math.pi * 2
local RING_SEGMENTS = 36
local SPIRAL_SEGMENTS = 24

local function part(name: string, parent: Instance): Part
	local result = Instance.new("Part")
	result.Name = name
	result.Anchored = true
	result.CanCollide = false
	result.CanTouch = false
	result.CanQuery = false
	result.CastShadow = false
	result.Size = Vector3.one
	result.Transparency = 1
	result.Parent = parent
	return result
end

local function path(parent: Part, count: number, loop: boolean, width: number, color: Color3)
	local points = {}
	for index = 1, count do
		local point = Instance.new("Attachment")
		point.Name = "VortexPoint" .. index
		point.Parent = parent
		table.insert(points, point)
	end
	for index = 1, if loop then count else count - 1 do
		local beam = Instance.new("Beam")
		beam.Name = "VortexStream"
		beam.Attachment0 = points[index]
		beam.Attachment1 = points[index % count + 1]
		beam.Width0, beam.Width1 = width, width
		beam.Color = ColorSequence.new(color)
		beam.Transparency = NumberSequence.new(0.25)
		beam.LightEmission = 0.8
		beam.LightInfluence = 0
		beam.FaceCamera = true
		beam.Segments = 1
		beam.Parent = parent
	end
	return points
end

function Controller.start()
	if started then
		return
	end
	started = true
	local model: Model? = nil
	local anchor: Part? = nil
	local core: Part? = nil
	local rim, lens, spirals = {}, {}, {}
	local elapsed = 0
	local function clear()
		if model then
			model:Destroy()
		end
		model, anchor, core = nil, nil, nil
		rim, lens, spirals = {}, {}, {}
	end
	local function create()
		model = Instance.new("Model")
		model.Name = "BlackHoleWeatherEffects"
		anchor = part("VortexOrigin", model)
		core = part("EventHorizon", model)
		core.Shape = Enum.PartType.Ball
		core.Size = Vector3.one * 40
		core.Color = Color3.new(0, 0, 0)
		core.Material = Enum.Material.SmoothPlastic
		core.Transparency = 0
		rim = path(anchor, RING_SEGMENTS, true, 3.2, Color3.fromRGB(181, 75, 255))
		lens = path(anchor, RING_SEGMENTS, true, 1.3, Color3.fromRGB(93, 32, 165))
		for index = 1, 3 do
			table.insert(spirals, path(anchor, SPIRAL_SEGMENTS, false, 3.5, Color3.fromRGB(91, 34, 133)))
		end
		model.Parent = workspace
	end
	RunService.RenderStepped:Connect(function(dt)
		elapsed += dt
		if elapsed < 1 / 30 then
			return
		end
		elapsed %= 1 / 30
		local center = Weather.blackHolePosition()
		local camera = workspace.CurrentCamera
		local enabled = Players.LocalPlayer:GetAttribute("WeatherEffectsEnabled") ~= false
		if not center or not camera or not enabled then
			clear()
			return
		end
		if not model then
			create()
		end
		local now = workspace:GetServerTimeNow()
		local origin = anchor :: Part
		local sphere = core :: Part
		origin.CFrame = CFrame.new(center)
		local hole = Vector3.new(0, 58, 0)
		sphere.Position = center + hole
		local facing = CFrame.lookAt(center + hole, camera.CFrame.Position)
		for index = 1, RING_SEGMENTS do
			local angle = (index - 1) / RING_SEGMENTS * TAU
			local warp = 1 + math.sin(angle * 3 + now * 1.4) * 0.035
			local edge = Vector3.new(math.cos(angle), math.sin(angle), 0) * 21.7 * warp
			rim[index].Position = hole + facing:VectorToWorldSpace(edge)
			local orbit = angle + now * 0.5
			lens[index].Position = hole + Vector3.new(math.cos(orbit) * 37, math.sin(orbit) * 8, math.sin(orbit) * 18)
		end
		for arm, points in spirals do
			for index, point in points do
				local fraction = (index - 1) / (SPIRAL_SEGMENTS - 1)
				local radius = 14 + fraction * (Weather.BlackHoleRadius - 14)
				local angle = arm * TAU / 3 + fraction * TAU * 1.2 - now * 0.42
				local height = 0.65 + math.sin(angle * 2 + now) * 0.25
				point.Position = Vector3.new(math.cos(angle) * radius, height, math.sin(angle) * radius)
			end
		end
	end)
end

return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="236">
          <Properties>
            <string name="Name">BoatAudio</string>
            <string name="Source"><![CDATA[-- Each client mixes positional engines for every boat it has streamed in.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local BoatCatalog = require(ReplicatedStorage.Shared.BoatCatalog)

local BoatAudio = {}
local started = false

function BoatAudio.start()
	if started then
		return
	end
	started = true
	local records = {}
	RunService.Heartbeat:Connect(function(dt)
		local folder = workspace:FindFirstChild("PlayerBoats")
		if folder then
			for _, model in folder:GetChildren() do
				local spec = BoatCatalog[model:GetAttribute("BoatId")]
				if spec and spec.EngineSoundId and model:IsA("Model") and not records[model] then
					local root = model.PrimaryPart
					local seat = model:FindFirstChild(spec.DriverSeat, true)
					if root and seat and seat:IsA("VehicleSeat") then
						local sound = Instance.new("Sound")
						sound.Name = "BoatEngine"
						sound.SoundId = spec.EngineSoundId
						sound.Looped = true
						sound.Volume = 0
						sound.PlaybackSpeed = 0.75
						sound.RollOffMode = Enum.RollOffMode.InverseTapered
						sound.RollOffMinDistance = 12
						sound.RollOffMaxDistance = 140
						sound.Parent = root
						records[model] = { sound = sound, root = root, seat = seat, spec = spec }
					end
				end
			end
		end
		local blend = 1 - math.exp(-8 * math.clamp(dt, 0, 0.1))
		for model, record in records do
			local sound = record.sound
			if
				not folder
				or model.Parent ~= folder
				or not record.root:IsDescendantOf(model)
				or not record.seat:IsDescendantOf(model)
			then
				sound:Destroy()
				records[model] = nil
				continue
			end
			local occupant = record.seat.Occupant
			local running = occupant ~= nil and occupant.Health > 0
			local throttle = if running then math.abs(model:GetAttribute("RowThrottle") or 0) else 0
			local velocity = record.root.AssemblyLinearVelocity
			local speed = Vector2.new(velocity.X, velocity.Z).Magnitude
			local rpm = math.clamp(math.max(throttle * 0.8, speed / record.spec.ForwardSpeed), 0, 1)
			local volume = if running then 0.18 + rpm * 0.5 else 0
			sound.Volume += (volume - sound.Volume) * blend
			sound.PlaybackSpeed += (0.75 + rpm * 0.8 - sound.PlaybackSpeed) * blend
			if running then
				if not sound.IsPlaying then
					sound:Play()
				end
			elseif sound.Volume < 0.001 then
				sound.Volume = 0
				if sound.IsPlaying then
					sound:Stop()
				end
			end
		end
	end)
end

return BoatAudio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="237">
          <Properties>
            <string name="Name">BoatCamera</string>
            <string name="Source"><![CDATA[-- Helm camera views. Trailing restores Roblox's follow camera; the other modes
-- frame the boat or put the eye at the helm without changing driving input.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local BoatCamera = {}

local MODES = table.freeze({
	table.freeze({ Name = "Trailing", Label = "Trailing" }),
	table.freeze({ Name = "Front", Label = "Front" }),
	table.freeze({ Name = "Cockpit", Label = "Cockpit" }),
	table.freeze({ Name = "Side", Label = "Side" }),
})

local player = Players.LocalPlayer
local modeIndex = 1
local activeBoat: Model? = nil
local activeSeat: BasePart? = nil
local bound = false
local saved: {
	CameraType: Enum.CameraType,
	CameraSubject: Instance?,
	CameraMode: Enum.CameraMode,
}? = nil

local function currentMode()
	return MODES[modeIndex]
end

local function restoreCustomCamera()
	if bound then
		bound = false
		RunService:UnbindFromRenderStep("BoatCamera")
	end
	local camera = workspace.CurrentCamera
	if camera and saved then
		-- Never strand the player on a scripted camera: the menu that owned it
		-- may already have closed while this view was active.
		if saved.CameraType == Enum.CameraType.Scriptable then
			local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			camera.CameraType = Enum.CameraType.Custom
			if humanoid then
				camera.CameraSubject = humanoid
			end
		else
			camera.CameraType = saved.CameraType
			if saved.CameraSubject then
				camera.CameraSubject = saved.CameraSubject
			end
		end
	end
end

-- Keep external shots level with the horizon while the hull rolls and pitches.
local function levelBasis(frame: CFrame): (Vector3, Vector3)
	local forward = Vector3.new(frame.LookVector.X, 0, frame.LookVector.Z)
	if forward.Magnitude < 1e-3 then
		return Vector3.new(0, 0, -1), Vector3.new(1, 0, 0)
	end
	forward = forward.Unit
	return forward, forward:Cross(Vector3.yAxis)
end

local function updateCamera()
	if player:GetAttribute("FreecamEnabled") then
		return
	end
	local camera = workspace.CurrentCamera
	local boat, seat = activeBoat, activeSeat
	if not camera or not boat or not boat.Parent or not seat or not seat.Parent then
		BoatCamera.stop()
		return
	end
	local root = boat.PrimaryPart
	if not root then
		BoatCamera.stop()
		return
	end

	local mode = currentMode().Name
	if mode == "Trailing" then
		return
	end

	local frame, focus
	if mode == "Cockpit" then
		local character = player.Character
		local head = character and character:FindFirstChild("Head")
		local seatFrame = seat.CFrame
		local eye = if head and head:IsA("BasePart")
			then head.Position
			else seatFrame.Position + seatFrame.UpVector * 2.4
		-- Sit just forward of the avatar's head so a hat or head mesh cannot
		-- fill the screen, then look along the helm toward the bow.
		eye += seatFrame.UpVector * 0.35 + seatFrame.LookVector * 1.2
		focus = eye + seatFrame.LookVector * 30 - seatFrame.UpVector * 3.5
		frame = CFrame.lookAt(eye, focus, seatFrame.UpVector)
	else
		local length = boat:GetAttribute("HullLength")
		length = if typeof(length) == "number" then length else 20
		local beam = boat:GetAttribute("HullBeam")
		beam = if typeof(beam) == "number" then beam else 8
		local origin = root.Position
		local forward, right = levelBasis(root.CFrame)
		local eye
		if mode == "Front" then
			local distance = 10 + length * 0.35
			local height = 4 + length * 0.12
			eye = origin - forward * (length * 0.5 + distance) + Vector3.yAxis * height
			focus = origin + Vector3.yAxis * (height * 0.35) + forward * (length * 0.05)
		else
			local distance = 8 + beam * 0.65
			local height = 3.5 + length * 0.09
			eye = origin + right * (beam * 0.5 + distance) + Vector3.yAxis * height - forward * (length * 0.04)
			focus = origin + Vector3.yAxis * (height * 0.35)
		end
		frame = CFrame.lookAt(eye, focus)
	end
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = frame
	camera.Focus = CFrame.new(focus)
end

local function applyMode()
	if player:GetAttribute("FreecamEnabled") then
		return
	end
	local camera = workspace.CurrentCamera
	if not activeBoat or not activeSeat or not camera then
		return
	end
	if currentMode().Name == "Trailing" then
		restoreCustomCamera()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		player.CameraMode = Enum.CameraMode.Classic
		camera.CameraType = Enum.CameraType.Custom
		if humanoid then
			camera.CameraSubject = humanoid
		end
		return
	end
	camera.CameraType = Enum.CameraType.Scriptable
	if not bound then
		bound = true
		RunService:BindToRenderStep("BoatCamera", Enum.RenderPriority.Camera.Value + 1, updateCamera)
	end
end

function BoatCamera.isActive(): boolean
	return activeBoat ~= nil
end

function BoatCamera.refresh()
	if activeBoat then
		applyMode()
	end
end

function BoatCamera.label(): string
	return currentMode().Label
end

function BoatCamera.cycle(): string
	modeIndex = modeIndex % #MODES + 1
	if activeBoat then
		applyMode()
	end
	return BoatCamera.label()
end

function BoatCamera.setActive(boat: Model?, seat: BasePart?)
	if boat and seat then
		if boat ~= activeBoat or seat ~= activeSeat then
			if not activeBoat then
				local camera = workspace.CurrentCamera
				if camera and not saved then
					saved = {
						CameraType = camera.CameraType,
						CameraSubject = camera.CameraSubject,
						CameraMode = player.CameraMode,
					}
				end
			end
			activeBoat, activeSeat = boat, seat
			applyMode()
		end
	else
		BoatCamera.stop()
	end
end

function BoatCamera.stop()
	activeBoat, activeSeat = nil, nil
	if player:GetAttribute("FreecamEnabled") then
		if bound then
			bound = false
			RunService:UnbindFromRenderStep("BoatCamera")
		end
		if saved then
			player.CameraMode = saved.CameraMode
			saved = nil
		end
		return
	end
	restoreCustomCamera()
	if saved then
		player.CameraMode = saved.CameraMode
		saved = nil
	end
end

return BoatCamera
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="238">
          <Properties>
            <string name="Name">BoatDriving</string>
            <string name="Source"><![CDATA[-- Drives the local player's own hull. While they are at the helm the server hands this
-- client network ownership of the boat (BoatService setDriver), and from then on the movers
-- are steered here every physics step from local input, with the same shared BoatDrive code
-- the server uses. The helm answers at once and the hull never waits on replication.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local BoatCatalog = require(ReplicatedStorage.Shared.BoatCatalog)
local BoatDrive = require(ReplicatedStorage.Shared.BoatDrive)
local BoatMotion = require(ReplicatedStorage.Shared.BoatMotion)

local BoatDriving = {}
local started = false
local helm: Model? = nil
local helmThrottle, helmSteer = 0, 0
local hull = nil

-- Called every frame by Boating with the hull at the local player's helm (or nil).
function BoatDriving.setInput(model: Model?, throttle: number, steer: number)
	helm, helmThrottle, helmSteer = model, throttle, steer
end

-- Refits retune the spec, so it is read from the hull's attributes each step.
local function readSpec(model: Model, spec)
	for _, field in BoatDrive.FIELDS do
		local value = model:GetAttribute("Drive" .. field)
		if type(value) == "number" then
			spec[field] = value
		end
	end
end

local function prepare(model: Model)
	local root = model.PrimaryPart
	local base = BoatCatalog[model:GetAttribute("BoatId")]
	local waterline = model:GetAttribute("WaterlineRootOffset")
	if not root or not base or typeof(waterline) ~= "Vector3" then
		return nil
	end
	local float = root:FindFirstChild("Waterline")
	local lift = root:FindFirstChild("WeightSupport")
	local heading = root:FindFirstChild("UprightHeading")
	local velocity = root:FindFirstChild("Rowing")
	local driveAttachment = root:FindFirstChild("BoatDrive")
	if not (float and lift and heading and velocity and driveAttachment) then
		return nil
	end
	local spec = table.clone(base)
	readSpec(model, spec)
	local look = root.CFrame.LookVector
	local forward = Vector3.new(look.X, 0, look.Z)
	forward = if forward.Magnitude > 0.0001 then forward.Unit else Vector3.zAxis
	local grace = model:GetAttribute("LaunchGraceUntil")
	return {
		spec = spec,
		model = model,
		root = root,
		float = float,
		lift = lift,
		heading = heading,
		velocity = velocity,
		driveAttachment = driveAttachment,
		waterlineOffset = waterline,
		yaw = math.atan2(-forward.X, -forward.Z),
		-- Taking over mid-voyage (say, after the server coasted it) keeps the way it has on.
		speed = root.AssemblyLinearVelocity:Dot(forward),
		turn = 0,
		bank = 0,
		bankVelocity = 0,
		clearWater = true,
		lastWaterCheck = 0,
		launchGraceUntil = if type(grace) == "number" then os.clock() + grace - workspace:GetServerTimeNow() else 0,
	}
end

function BoatDriving.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	-- Before the solver, like the server's loop, so each step uses one coherent set of targets.
	RunService.PreSimulation:Connect(function(dt)
		local model = helm
		if
			not model
			or not model.Parent
			or model:GetAttribute("DriverUserId") ~= player.UserId
			or model:GetAttribute("Parked")
			or model:GetAttribute("Sinking")
			or model:GetAttribute("Hoisted")
		then
			hull = nil
			return
		end
		if not hull or hull.model ~= model then
			hull = prepare(model)
			if not hull then
				return
			end
		end
		readSpec(model, hull.spec)
		local speed, turn = BoatMotion.step(hull.speed, hull.turn, helmThrottle, helmSteer, hull.spec, dt)
		BoatDrive.apply(hull, speed, turn, helmThrottle, helmSteer, dt, workspace:GetServerTimeNow(), nil)
	end)
end

return BoatDriving
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="239">
          <Properties>
            <string name="Name">BoatHealth</string>
            <string name="Source"><![CDATA[-- Shows the health of the boat the local player is riding or standing on.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Aboard = require(game:GetService("ReplicatedStorage").Shared.Aboard)

local BoatHealth = {}
local started = false

local function round(parent: GuiObject, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

function BoatHealth.start()
	if started then
		return
	end
	started = true

	local player = Players.LocalPlayer
	local gui = Instance.new("ScreenGui")
	gui.Name = "BoatHealthHud"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 20
	gui.Parent = player:WaitForChild("PlayerGui")

	local panel = Instance.new("Frame")
	panel.Name = "BoatHealth"
	panel.AnchorPoint = Vector2.new(1, 1)
	-- Keep clear of the map and cargo buttons along the right edge.
	panel.Position = UDim2.new(1, -142, 1, -24)
	panel.Size = UDim2.fromOffset(220, 58)
	panel.BackgroundColor3 = Color3.fromRGB(26, 23, 20)
	panel.BorderSizePixel = 0
	panel.Visible = false
	panel.Parent = gui
	round(panel, 4)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(150, 118, 72)
	stroke.Thickness = 2
	stroke.Parent = panel

	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(1, 0, 0, 25)
	header.BackgroundColor3 = Color3.fromRGB(92, 36, 34)
	header.BorderSizePixel = 0
	header.Parent = panel
	round(header, 4)

	local caption = Instance.new("TextLabel")
	caption.Name = "Caption"
	caption.BackgroundTransparency = 1
	caption.Position = UDim2.fromOffset(12, 5)
	caption.Size = UDim2.new(1, -24, 0, 20)
	caption.Font = Enum.Font.GothamBold
	caption.Text = "SHIP HEALTH"
	caption.TextSize = 12
	caption.TextColor3 = Color3.fromRGB(240, 240, 236)
	caption.TextXAlignment = Enum.TextXAlignment.Left
	caption.Parent = header

	local track = Instance.new("Frame")
	track.Name = "Track"
	track.Position = UDim2.fromOffset(12, 29)
	track.Size = UDim2.new(1, -24, 0, 17)
	track.BackgroundColor3 = Color3.fromRGB(16, 16, 16)
	track.BorderSizePixel = 0
	track.ClipsDescendants = true
	track.Parent = panel
	round(track, 4)
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(84, 192, 92)
	fill.BorderSizePixel = 0
	fill.Parent = track
	round(fill, 4)
	local remaining = Instance.new("TextLabel")
	remaining.Name = "Remaining"
	remaining.BackgroundTransparency = 1
	remaining.Size = UDim2.fromScale(1, 1)
	remaining.Font = Enum.Font.GothamBold
	remaining.TextSize = 11
	remaining.TextColor3 = Color3.new(1, 1, 1)
	remaining.TextStrokeTransparency = 0.5
	remaining.ZIndex = 2
	remaining.Parent = track

	local currentBoat: Model? = nil
	local connections = {}
	local fillTween: Tween? = nil
	local function refresh()
		if not currentBoat then
			panel.Visible = false
			return
		end
		local health = currentBoat:GetAttribute("Health")
		local maximum = currentBoat:GetAttribute("MaxHealth")
		if typeof(health) ~= "number" or typeof(maximum) ~= "number" or maximum <= 0 then
			panel.Visible = false
			return
		end
		local ratio = math.clamp(health / maximum, 0, 1)
		panel.Visible = true
		remaining.Text = string.format("%d / %d", math.ceil(math.max(0, health)), math.ceil(maximum))
		if fillTween then
			fillTween:Cancel()
		end
		fillTween = TweenService:Create(fill, TweenInfo.new(0.2), {
			Size = UDim2.fromScale(ratio, 1),
			BackgroundColor3 = if ratio <= 0.25
				then Color3.fromRGB(226, 72, 60)
				elseif ratio <= 0.5 then Color3.fromRGB(236, 174, 65)
				else Color3.fromRGB(84, 192, 92),
		})
		fillTween:Play()
	end
	local function setBoat(boat: Model?)
		if currentBoat == boat then
			return
		end
		for _, connection in connections do
			connection:Disconnect()
		end
		table.clear(connections)
		currentBoat = boat
		if boat then
			for _, attribute in { "Health", "MaxHealth" } do
				table.insert(connections, boat:GetAttributeChangedSignal(attribute):Connect(refresh))
			end
		end
		refresh()
	end

	local elapsed = 0
	local lastFound = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.2 then
			return
		end
		elapsed = 0
		local boats = workspace:FindFirstChild("PlayerBoats")
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not boats or not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
			setBoat(nil)
			return
		end
		local boat: Model? = nil
		-- Prefer the occupied seat if boats overlap, then use the same deck
		-- detection as cargo and refit.
		local seat = humanoid.SeatPart
		if seat then
			for _, candidate in boats:GetChildren() do
				if candidate:IsA("Model") and seat:IsDescendantOf(candidate) then
					boat = candidate
					break
				end
			end
		end
		if not boat then
			for _, candidate in boats:GetChildren() do
				if candidate:IsA("Model") and Aboard(character, candidate) then
					boat = candidate
					break
				end
			end
		end
		if boat then
			lastFound = os.clock()
			setBoat(boat)
		elseif not currentBoat or not currentBoat:IsDescendantOf(boats) or os.clock() - lastFound > 0.6 then
			setBoat(nil)
		end
	end)
end

return BoatHealth
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="240">
          <Properties>
            <string name="Name">BoatPreview</string>
            <string name="Source"><![CDATA[-- Uses replicated copies of the real builders, independent of world streaming.
local UserInputService = game:GetService("UserInputService")

local BoatPreview = {}

function BoatPreview.new(view: ViewportFrame, remotes: Instance, status: TextLabel)
	local world = Instance.new("WorldModel")
	world.Parent = view
	local camera = Instance.new("Camera")
	camera.FieldOfView = 34
	camera.Parent = view
	view.CurrentCamera = camera
	view.Ambient = Color3.fromRGB(185, 197, 211)
	view.LightColor = Color3.fromRGB(255, 241, 218)
	view.LightDirection = Vector3.new(-1, -1, -2)
	view.Active = true

	local selectedId: string? = nil
	local model: Model? = nil
	local target, radius = Vector3.zero, 1
	local yaw = math.rad(38)
	local drag: InputObject? = nil
	local lastX = 0
	local idle = 0
	local function frame()
		if not model then
			return
		end
		local aspect = math.max(0.1, view.AbsoluteSize.X / math.max(1, view.AbsoluteSize.Y))
		local halfFov = math.atan(math.tan(math.rad(camera.FieldOfView / 2)) * math.min(1, aspect))
		local distance = radius / math.sin(halfFov) * 1.06
		local direction = Vector3.new(math.sin(yaw), 0.6, -math.cos(yaw)).Unit
		camera.CFrame = CFrame.lookAt(target + direction * distance, target)
	end
	local function render()
		if not selectedId or model then
			return
		end
		local templates = remotes:FindFirstChild("Previews")
		local template = templates and templates:FindFirstChild(selectedId)
		if not template or not template:IsA("Model") then
			return
		end
		model = template:Clone()
		model.Parent = world
		local box, size = model:GetBoundingBox()
		target, radius = box.Position, size.Magnitude / 2
		status.Visible = false
		frame()
	end
	local function watchTemplates(folder: Instance)
		if folder.Name == "Previews" then
			folder.ChildAdded:Connect(render)
			render()
		end
	end
	remotes.ChildAdded:Connect(watchTemplates)
	local templates = remotes:FindFirstChild("Previews")
	if templates then
		watchTemplates(templates)
	end
	view:GetPropertyChangedSignal("AbsoluteSize"):Connect(frame)
	view.InputBegan:Connect(function(input)
		if
			selectedId
			and (
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			)
		then
			drag, lastX, idle = input, input.Position.X, 0
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if drag and (input == drag or input.UserInputType == Enum.UserInputType.MouseMovement) then
			yaw -= (input.Position.X - lastX) * 0.012
			lastX, idle = input.Position.X, 0
			frame()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input == drag then
			drag, idle = nil, 0
		end
	end)

	local controller = {}
	function controller.show(boatId: string?)
		if selectedId == boatId then
			return
		end
		selectedId, model, drag = boatId, nil, nil
		world:ClearAllChildren()
		yaw, idle = math.rad(38), 0
		status.Visible = boatId ~= nil
		status.Text = "Loading boat model…"
		render()
	end
	function controller.step(dt: number)
		if not model or drag then
			return
		end
		idle += dt
		if idle > 3 then
			yaw += math.min(dt, 0.1) * 0.14
			frame()
		end
	end
	return controller
end

return BoatPreview
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="241">
          <Properties>
            <string name="Name">BoatRefit</string>
            <string name="Source"><![CDATA[-- The drydock refit menu. Slowing your own boat over the underwater lift behind
-- the boat shop (or using its prompt) asks the server to lift the hull into the
-- dry basin; the menu opens once it is up, and closing it sets the boat back
-- afloat. Boating brakes the hull meanwhile. The server reserves motors and
-- rudders for the cargo hold, where the player picks their spot, and saves paint;
-- this module only presents what it reports.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Aboard = require(Shared:WaitForChild("Aboard"))
local BoatCatalog = require(Shared:WaitForChild("BoatCatalog"))
local BoatUpgrades = require(Shared:WaitForChild("BoatUpgrades"))
local Cargo = require(Shared:WaitForChild("Cargo"))
local Catalog = require(Shared:WaitForChild("AnglerCatalog"))

local BoatRefit = {}
local started = false

local WIDTH, HEIGHT = 960, 404
local CARD_WIDTH, CARD_HEIGHT, CARD_GAP = 220, 254, 14
local SWATCH, SWATCH_GAP = 42, 8
local GOLD = Color3.fromRGB(244, 196, 76)
local GOOD = Color3.fromRGB(111, 202, 125)
local BAD = Color3.fromRGB(238, 107, 111)
local ACCENTS = {
	Motor = Color3.fromRGB(238, 140, 66),
	Rudder = Color3.fromRGB(86, 196, 232),
	Paint = Color3.fromRGB(196, 120, 240),
	Net = Color3.fromRGB(111, 202, 125),
}
-- Below this speed (studs/s) a boat over the lift counts as pulling in to refit.
local PULL_IN_SPEED = 8
-- Menus that own the screen; the refit menu never opens over them.
local MENUS = { "PlayerMenuOpen", "DrydockScreenOpen", "RodWorkshopOpen" }
local HINT = "Motors and rudders use hold tiles — you pick their spot when fitting. Paint is free. The trawler's net is a permanent fitting."

function BoatRefit.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local remote = ReplicatedStorage:WaitForChild("BoatRefit") :: RemoteFunction
	local cream, muted = Theme.Colors.Text, Theme.Colors.Muted

	local gui = Instance.new("ScreenGui")
	gui.Name = "BoatRefit"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 23
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	local function label(parent: Instance, text: string, position: UDim2, size: UDim2, textSize: number, color: Color3)
		local item = Instance.new("TextLabel")
		item.BackgroundTransparency = 1
		item.Position, item.Size = position, size
		item.Text, item.TextSize = text, textSize
		item.TextWrapped = true
		item.TextXAlignment = Enum.TextXAlignment.Left
		Theme.text(item, color)
		item.Parent = parent
		return item
	end
	local function frame(parent: Instance, name: string, position: UDim2, size: UDim2, color: Color3): Frame
		local item = Instance.new("Frame")
		item.Name = name
		item.Position, item.Size = position, size
		item.BackgroundColor3 = color
		item.BorderSizePixel = 0
		item.Parent = parent
		return item
	end
	local function button(parent: Instance, name: string, position: UDim2, size: UDim2, textSize: number): TextButton
		local item = Instance.new("TextButton")
		item.Name = name
		item.Position, item.Size = position, size
		item.TextSize = textSize
		item.TextWrapped = true
		item.Parent = parent
		Theme.button(item, "Disabled")
		return item
	end

	-- An invisible click-catcher: the harbour stays untinted behind the menu, and
	-- a click outside still puts the boat back in the water.
	local overlay = Instance.new("TextButton")
	overlay.Name = "RefitOverlay"
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = Color3.new(0, 0, 0)
	overlay.BackgroundTransparency = 1
	overlay.Text = ""
	overlay.AutoButtonColor = false
	overlay.Visible = false
	overlay.Parent = gui

	local window = Instance.new("Frame")
	window.Name = "BoatRefit"
	window.Active = true
	window.AnchorPoint = Vector2.new(0.5, 1)
	window.Position = UDim2.new(0.5, 0, 1, -16)
	window.Size = UDim2.fromOffset(WIDTH, HEIGHT)
	window.Parent = overlay
	Theme.window(window)
	local scale = Instance.new("UIScale")
	scale.Parent = window

	local header = frame(window, "Header", UDim2.fromOffset(14, 14), UDim2.new(1, -28, 0, 74), Color3.new(1, 1, 1))
	Theme.corner(header, 8)
	local wash = Instance.new("UIGradient")
	wash.Rotation = 90
	wash.Color = ColorSequence.new(Color3.fromRGB(47, 74, 88), Color3.fromRGB(24, 38, 48))
	wash.Parent = header
	label(header, "REFIT DOCK", UDim2.fromOffset(18, 10), UDim2.fromOffset(300, 18), 13, GOLD)
	local boatName = label(header, "", UDim2.fromOffset(18, 30), UDim2.new(1, -280, 0, 32), 24, cream)
	local cargoPanel = frame(header, "Cargo", UDim2.new(1, -244, 0, 14), UDim2.fromOffset(184, 46), Theme.Colors.Inset)
	Theme.panel(cargoPanel, true, 23)
	label(cargoPanel, "FREE CARGO TILES", UDim2.fromOffset(16, 4), UDim2.new(1, -24, 0, 14), 11, muted)
	local cargoValue = label(cargoPanel, "—", UDim2.fromOffset(16, 18), UDim2.new(1, -24, 0, 24), 20, GOOD)
	cargoValue.RichText = true

	local close = Instance.new("TextButton")
	close.Name = "CloseRefit"
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(1, -8, 0, 8)
	close.Size = UDim2.fromOffset(34, 34)
	close.Text = "×"
	close.TextSize = 24
	close.ZIndex = 4
	close.Parent = header
	Theme.button(close, "Danger")

	local row = frame(window, "Refits", UDim2.fromOffset(0, 100), UDim2.new(1, 0, 0, CARD_HEIGHT), Color3.new())
	row.BackgroundTransparency = 1
	local left = (WIDTH - CARD_WIDTH * 4 - CARD_GAP * 3) / 2
	local function card(index: number, kind: string, title: string)
		local item = frame(
			row,
			kind,
			UDim2.fromOffset(left + (index - 1) * (CARD_WIDTH + CARD_GAP), 0),
			UDim2.fromOffset(CARD_WIDTH, CARD_HEIGHT),
			Theme.Colors.Panel
		)
		Theme.panel(item, false, 8)
		local stripe = frame(item, "Accent", UDim2.fromScale(0, 0), UDim2.new(1, 0, 0, 6), ACCENTS[kind])
		Theme.corner(stripe, 8)
		local glow = frame(item, "Glow", UDim2.fromOffset(0, 6), UDim2.new(1, 0, 0, 60), ACCENTS[kind])
		glow.BackgroundTransparency = 0.8
		local fade = Instance.new("UIGradient")
		fade.Rotation = 90
		fade.Transparency = NumberSequence.new(0, 1)
		fade.Parent = glow
		label(item, title, UDim2.fromOffset(14, 16), UDim2.new(1, -28, 0, 20), 15, ACCENTS[kind])
		return item, glow
	end

	-- Motors and rudders: count and pips, the stat now and next, fit and remove.
	local views = {}
	for index, kind in BoatUpgrades.Order do
		local upgrade = BoatUpgrades.Kinds[kind]
		local item, glow = card(index, kind, string.upper(upgrade.Plural))
		local count = label(item, "", UDim2.fromOffset(14, 38), UDim2.new(1, -28, 0, 28), 22, cream)
		count.RichText = true
		local description =
			label(item, upgrade.Description, UDim2.fromOffset(14, 66), UDim2.new(1, -28, 0, 32), 12, muted)
		description.Font = Enum.Font.GothamMedium
		description.TextYAlignment = Enum.TextYAlignment.Top
		local pips = {}
		local pipWidth = (CARD_WIDTH - 28 - (upgrade.Max - 1) * 4) / upgrade.Max
		for pip = 1, upgrade.Max do
			local cell = frame(
				item,
				"Pip" .. pip,
				UDim2.fromOffset(14 + (pip - 1) * (pipWidth + 4), 104),
				UDim2.fromOffset(pipWidth, 10),
				Theme.Colors.Inset
			)
			Theme.corner(cell, 3)
			pips[pip] = cell
		end
		local stat = label(item, "", UDim2.fromOffset(14, 122), UDim2.new(1, -28, 0, 18), 13, cream)
		local cost = label(item, "", UDim2.fromOffset(14, 142), UDim2.new(1, -28, 0, 18), 12, muted)
		cost.Font = Enum.Font.GothamMedium
		local fit = button(item, "Fit" .. kind, UDim2.fromOffset(12, 168), UDim2.new(1, -24, 0, 38), 15)
		local remove = button(item, "Remove" .. kind, UDim2.fromOffset(12, 212), UDim2.new(1, -24, 0, 30), 13)
		views[kind] = { glow = glow, count = count, pips = pips, stat = stat, cost = cost, fit = fit, remove = remove }
	end

	-- Paint: the boat's current finish and one swatch per preset.
	local paintCard, paintGlow = card(3, "Paint", "PAINT")
	local paintName = label(paintCard, "", UDim2.fromOffset(14, 38), UDim2.new(1, -28, 0, 28), 20, cream)
	local swatches = {}
	for index, paint in BoatUpgrades.Paints do
		local column, line = (index - 1) % 4, (index - 1) // 4
		local swatch = Instance.new("TextButton")
		swatch.Name = "Paint" .. paint.Id
		swatch.Position = UDim2.fromOffset(14 + column * (SWATCH + SWATCH_GAP), 72 + line * (SWATCH + SWATCH_GAP))
		swatch.Size = UDim2.fromOffset(SWATCH, SWATCH)
		swatch.AutoButtonColor = true
		swatch.BorderSizePixel = 0
		swatch.Text = ""
		swatch.BackgroundColor3 = if paint.RGB
			then Color3.fromRGB(paint.RGB[1], paint.RGB[2], paint.RGB[3])
			else Theme.Colors.Inset
		swatch.Parent = paintCard
		Theme.corner(swatch, 8)
		if not paint.RGB then
			local stock = label(swatch, "STOCK", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), 10, muted)
			stock.TextXAlignment = Enum.TextXAlignment.Center
		end
		local ring = Instance.new("UIStroke")
		ring.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		ring.Parent = swatch
		swatches[paint.Id] = { button = swatch, ring = ring, paint = paint }
	end
	local paintHint =
		label(paintCard, "Free · tap a colour", UDim2.fromOffset(14, 224), UDim2.new(1, -28, 0, 18), 12, muted)
	paintHint.Font = Enum.Font.GothamMedium

	-- Fisherman's net: a permanent trawler fitting that never uses hold tiles.
	local netCard, netGlow = card(4, "Net", "FISHERMAN'S NET")
	local netState = label(netCard, "", UDim2.fromOffset(14, 38), UDim2.new(1, -28, 0, 28), 20, cream)
	local netDescription =
		label(netCard, BoatUpgrades.Net.Description, UDim2.fromOffset(14, 66), UDim2.new(1, -28, 0, 38), 12, muted)
	netDescription.Font = Enum.Font.GothamMedium
	netDescription.TextYAlignment = Enum.TextYAlignment.Top
	local netDetail = label(netCard, "", UDim2.fromOffset(14, 106), UDim2.new(1, -28, 0, 30), 12, muted)
	netDetail.Font = Enum.Font.GothamMedium
	local netCost = label(netCard, "", UDim2.fromOffset(14, 138), UDim2.new(1, -28, 0, 28), 12, muted)
	netCost.Font = Enum.Font.GothamMedium
	local netBuy = button(netCard, "BuyNet", UDim2.fromOffset(12, 174), UDim2.new(1, -24, 0, 38), 15)
	local netHint = label(netCard, "Deploy or stow at the helm\nwith the net button or N.", UDim2.fromOffset(14, 216), UDim2.new(1, -28, 0, 30), 12, muted)
	netHint.TextXAlignment = Enum.TextXAlignment.Center
	netHint.Font = Enum.Font.GothamMedium

	local status = label(window, HINT, UDim2.fromOffset(24, HEIGHT - 44), UDim2.new(1, -48, 0, 32), 13, muted)
	status.TextXAlignment = Enum.TextXAlignment.Center
	status.Font = Enum.Font.GothamMedium

	local snapshot: any = nil
	local pending = false
	local lastRequest = -math.huge
	local hovered: string? = nil
	-- True while a fitted part waits for the player to choose its hold tiles;
	-- the refit window hides so the cargo grid has the screen to itself.
	local placing = false
	local restoreToken = 0

	local function setStatus(message: string, color: Color3)
		status.Text, status.TextColor3 = message, color
	end

	local function render()
		local layout = snapshot and snapshot.BoatId and BoatCatalog[snapshot.BoatId]
		local docked = layout ~= nil and snapshot.Lifted == true
		local items = if layout then snapshot.Items or {} else {}
		boatName.Text = if layout then layout.Name else "Sail a boat over the lift"
		local free = if layout then BoatUpgrades.freeTiles(layout, items, Catalog.Fish) else 0
		cargoValue.Text = if layout
			then string.format('%d <font size="14" color="#bdbdbd">/ %d</font>', free, Cargo.capacity(layout.Hold))
			else "—"
		local motors = if layout then BoatUpgrades.count(items, layout, "Motor") else 0
		local rudders = if layout then BoatUpgrades.count(items, layout, "Rudder") else 0
		for _, kind in BoatUpgrades.Order do
			local upgrade, view = BoatUpgrades.Kinds[kind], views[kind]
			local count = if kind == "Motor" then motors else rudders
			local maxed = count >= upgrade.Max
			view.count.Text = string.format('%d <font size="15" color="#9a9a9a">/ %d fitted</font>', count, upgrade.Max)
			for pip, cell in view.pips do
				cell.BackgroundColor3 = if pip <= count then ACCENTS[kind] else Theme.Colors.Inset
			end
			local tiles = if layout then BoatUpgrades.tiles(layout, kind) else 0
			if layout then
				local now = BoatUpgrades.tuned(layout, motors, rudders)
				local nextSpec = BoatUpgrades.tuned(
					layout,
					motors + (if kind == "Motor" then 1 else 0),
					rudders + (if kind == "Rudder" then 1 else 0)
				)
				if kind == "Motor" then
					view.stat.Text = if maxed
						then string.format("Top speed %.0f studs/s", now.ForwardSpeed)
						else string.format(
							"Top speed %.0f → %.0f studs/s",
							now.ForwardSpeed,
							nextSpec.ForwardSpeed
						)
				else
					view.stat.Text = if maxed
						then string.format("Turning %.0f°/s", math.deg(now.TurnRate))
						else string.format(
							"Turning %.0f → %.0f°/s",
							math.deg(now.TurnRate),
							math.deg(nextSpec.TurnRate)
						)
				end
				view.cost.Text = string.format("Uses %d cargo tiles each", tiles)
			else
				view.stat.Text, view.cost.Text = "", ""
			end
			local canFit = docked and not pending and not maxed and free >= tiles
			view.fit.Text = if not layout
				then "NO BOAT"
				elseif maxed then "MAXED OUT"
				elseif free < tiles then string.format("NEEDS %d FREE TILES", tiles)
				else string.format("FIT %s · PICK SPOT", if kind == "Motor" then "MOTOR" else "RUDDER")
			Theme.button(view.fit, if canFit then "Selected" else "Disabled")
			view.fit.Active, view.fit.Selectable, view.fit.AutoButtonColor = canFit, canFit, canFit
			local canRemove = docked and not pending and count > 0
			view.remove.Text = if count > 0 then "TAKE ONE OUT" else "NONE FITTED"
			Theme.button(view.remove, if canRemove then "Normal" else "Disabled")
			view.remove.Active, view.remove.Selectable, view.remove.AutoButtonColor = canRemove, canRemove, canRemove
		end
		local current = if layout then snapshot.Paint or "Factory" else nil
		local shown = BoatUpgrades.paint(hovered or current)
		paintName.Text = if shown then shown.Name else "—"
		paintName.TextColor3 = if hovered and hovered ~= current then muted else cream
		for id, swatch in swatches do
			local selected = id == current
			swatch.ring.Color = if selected then cream else Theme.Colors.Border
			swatch.ring.Thickness = if selected then 3 else 1
			swatch.ring.Transparency = if selected then 0 else 0.35
			swatch.button.Active = docked and not pending
		end
		local net = BoatUpgrades.Net
		local netOwned = snapshot ~= nil and snapshot.NetOwned == true
		local trawler = layout ~= nil and snapshot.BoatId == net.BoatId
		local cash = if snapshot and type(snapshot.Cash) == "number" then snapshot.Cash else 0
		netState.Text = if not layout
			then "—"
			elseif netOwned then "FITTED"
			elseif not trawler then "TRAWLER ONLY"
			else "NOT FITTED"
		netState.TextColor3 = if netOwned then GOOD elseif not layout or not trawler then muted else cream
		netDetail.Text = if not layout
			then ""
			elseif netOwned then "Deploy while underway. Catches common fish, and the odd uncommon."
			elseif not trawler then "Only the teal fishing trawler has the stern gear for this net."
			else "A permanent fitting — it never uses cargo tiles."
		netCost.Text = if not layout
			then ""
			elseif netOwned then "Already fitted to this boat."
			else string.format("$%d one-time · $%d aboard", net.Price, cash)
		local canBuyNet = docked and not pending and trawler and not netOwned and cash >= net.Price
		netBuy.Text = if not layout
			then "NO BOAT"
			elseif not trawler then "TEAL TRAWLER ONLY"
			elseif netOwned then "FITTED"
			elseif cash < net.Price then string.format("NEED $%d MORE", net.Price - cash)
			else string.format("FIT NET · $%d", net.Price)
		Theme.button(netBuy, if canBuyNet then "Selected" else "Disabled")
		netBuy.Active, netBuy.Selectable, netBuy.AutoButtonColor = canBuyNet, canBuyNet, canBuyNet
	end

	local function celebrate(glow: Frame)
		glow.BackgroundTransparency = 0.25
		TweenService:Create(glow, TweenInfo.new(0.8), { BackgroundTransparency = 0.8 }):Play()
	end

	local fetchId = 0
	local function fetch()
		fetchId += 1
		local id = fetchId
		task.spawn(function()
			local ok, result = pcall(remote.InvokeServer, remote, "Get")
			if id == fetchId and ok and type(result) == "table" and type(result.State) == "table" then
				snapshot = result.State
				render()
			end
		end)
	end

	local function send(action: string, key: string, glow: Frame)
		if pending or os.clock() - lastRequest < 0.35 then
			return
		end
		lastRequest, pending = os.clock(), true
		fetchId += 1
		setStatus("The dock crew is working on your boat…", muted)
		render()
		task.spawn(function()
			local ok, result = pcall(remote.InvokeServer, remote, action, key)
			pending = false
			if ok and type(result) == "table" then
				if type(result.State) == "table" then
					snapshot = result.State
				end
				setStatus(tostring(result.Message), if result.Ok then GOOD else BAD)
				if result.Ok then
					if action == "Install" then
						-- The cargo grid takes over so the player can pick the spot.
						placing = true
						overlay.Visible = false
					else
						celebrate(glow)
					end
				end
			else
				setStatus("The drydock didn't answer. Please try again.", BAD)
			end
			render()
		end)
	end

	-- Shown over the boat while the lift moves, and for lift refusals.
	local banner = label(gui, "", UDim2.new(0.5, -220, 0, 96), UDim2.fromOffset(440, 44), 18, cream)
	banner.Name = "LiftNotice"
	banner.TextXAlignment = Enum.TextXAlignment.Center
	banner.BackgroundColor3 = Theme.Colors.Window
	banner.BackgroundTransparency = 0.1
	banner.Visible = false
	Theme.corner(banner, 10)
	local bannerId = 0
	local function notice(message: string?, seconds: number?)
		bannerId += 1
		local id = bannerId
		banner.Text, banner.Visible = message or "", message ~= nil
		if message and seconds then
			task.delay(seconds, function()
				if bannerId == id then
					banner.Visible = false
				end
			end)
		end
	end

	-- BoatRefitOpen holds the helm (see Boating) from the lift request until the
	-- menu is closed again.
	local lifting = false
	local function blocked(): boolean
		for _, name in MENUS do
			if player:GetAttribute(name) then
				return true
			end
		end
		return false
	end
	local function lift()
		if lifting or overlay.Visible or blocked() then
			return
		end
		lifting = true
		player:SetAttribute("BoatRefitOpen", true)
		notice("Lifting your boat out of the water…")
		task.spawn(function()
			local ok, result = pcall(remote.InvokeServer, remote, "Lift")
			lifting = false
			if not ok or type(result) ~= "table" or not result.Ok then
				player:SetAttribute("BoatRefitOpen", false)
				notice(
					if ok and type(result) == "table" then tostring(result.Message) else "The drydock didn't answer.",
					4
				)
				return
			elseif blocked() or not player:GetAttribute("BoatRefitOpen") then
				-- Another menu took the screen, or the boat sailed off, while it rose.
				player:SetAttribute("BoatRefitOpen", false)
				task.spawn(pcall, remote.InvokeServer, remote, "Lower")
				notice(nil)
				return
			end
			notice(nil)
			snapshot = if type(result.State) == "table" then result.State else snapshot
			hovered = nil
			setStatus(HINT, muted)
			overlay.Visible = true
			render()
			window.Position = UDim2.new(0.5, 0, 1, 24)
			TweenService
				:Create(window, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Position = UDim2.new(0.5, 0, 1, -16) })
				:Play()
		end)
	end
	local function closeRefit()
		-- Drop any scheduled restore; the menu is going away for good.
		restoreToken += 1
		placing = false
		if overlay.Visible or player:GetAttribute("BoatRefitOpen") then
			overlay.Visible = false
			player:SetAttribute("BoatRefitOpen", false)
			notice("Setting your boat back in the water…", 4)
			task.spawn(pcall, remote.InvokeServer, remote, "Lower")
		end
	end
	player:SetAttribute("BoatRefitOpen", false)

	for _, kind in BoatUpgrades.Order do
		local view = views[kind]
		view.fit.Activated:Connect(function()
			if view.fit.Active then
				send("Install", kind, view.glow)
			end
		end)
		view.remove.Activated:Connect(function()
			if view.remove.Active then
				send("Remove", kind, view.glow)
			end
		end)
	end
	netBuy.Activated:Connect(function()
		if netBuy.Active then
			send("BuyNet", "", netGlow)
		end
	end)
	for id, swatch in swatches do
		swatch.button.Activated:Connect(function()
			if swatch.button.Active and id ~= (snapshot and snapshot.Paint) then
				send("Paint", id, paintGlow)
			end
		end)
		swatch.button.MouseEnter:Connect(function()
			hovered = id
			render()
		end)
		swatch.button.MouseLeave:Connect(function()
			if hovered == id then
				hovered = nil
				render()
			end
		end)
	end
	close.Activated:Connect(closeRefit)
	overlay.Activated:Connect(closeRefit)

	-- Fitting a part hides the window while the cargo grid takes the spot, then
	-- brings the window back once the part is placed or put back.
	player:GetAttributeChangedSignal("RefitPending"):Connect(function()
		if player:GetAttribute("RefitPending") ~= nil then
			restoreToken += 1
			placing = true
			overlay.Visible = false
			return
		end
		if not placing then
			return
		end
		restoreToken += 1
		local token = restoreToken
		task.delay(0.3, function()
			if token ~= restoreToken or not placing then
				return
			end
			placing = false
			if
				player:GetAttribute("RefitPending") ~= nil
				or not player:GetAttribute("BoatRefitOpen")
				or overlay.Visible
			then
				return
			end
			overlay.Visible = true
			setStatus(HINT, muted)
			render()
			window.Position = UDim2.new(0.5, 0, 1, 24)
			TweenService
				:Create(window, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Position = UDim2.new(0.5, 0, 1, -16) })
				:Play()
			fetch()
		end)
	end)
	UserInputService.InputBegan:Connect(function(input)
		-- While a part waits for its tiles, Esc belongs to the cargo grid and
		-- only cancels the placement.
		if player:GetAttribute("RefitPending") ~= nil then
			return
		end
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			closeRefit()
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		if prompt.Name == "RefitDockPrompt" then
			lift()
		end
	end)
	-- Any saved change (a fish stowed, a part moved) can change the free tiles.
	player:GetAttributeChangedSignal("AnglerRevision"):Connect(function()
		if overlay.Visible and not pending then
			fetch()
		end
	end)
	for _, name in MENUS do
		player:GetAttributeChangedSignal(name):Connect(function()
			if player:GetAttribute(name) then
				closeRefit()
			end
		end)
	end
	player.CharacterRemoving:Connect(closeRefit)

	local function ownBoat(): Model?
		local id = player:GetAttribute("ActiveBoatId")
		local boats = workspace:FindFirstChild("PlayerBoats")
		local boat = if type(id) == "string" and boats then boats:FindFirstChild(id .. "_" .. player.UserId) else nil
		return if boat and boat:IsA("Model") then boat else nil
	end
	local function slipAround(boat: Model): Instance?
		local root = boat.PrimaryPart
		if root then
			for _, dock in CollectionService:GetTagged("RefitDock") do
				if BoatUpgrades.inSlip(dock, root.Position) then
					return dock
				end
			end
		end
		return nil
	end

	-- Fit the screen, follow the boat over and off the lift and keep the prompt for
	-- the one drydock it floats over.
	local elapsed = 0
	local pulledIn = false
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.2 then
			return
		end
		elapsed = 0
		local camera = workspace.CurrentCamera
		if camera then
			local size = camera.ViewportSize
			scale.Scale = math.max(0.4, math.min(1, (size.X - 24) / WIDTH, size.Y * 0.62 / HEIGHT))
		end
		local character = player.Character
		local boat = ownBoat()
		local dock = if boat and Aboard(character, boat) then slipAround(boat) else nil
		-- A lift busy launching a purchase or carrying another boat stays down.
		local free = dock ~= nil
			and dock:GetAttribute("LaunchingUserId") == nil
			and dock:GetAttribute("LiftingUserId") == nil
		if dock and free and not pulledIn and boat then
			local root = boat.PrimaryPart :: BasePart
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local seat = humanoid and humanoid.SeatPart
			if
				seat
				and seat:IsA("VehicleSeat")
				and seat:IsDescendantOf(boat)
				and root.AssemblyLinearVelocity.Magnitude < PULL_IN_SPEED
			then
				pulledIn = true
				lift()
			end
		elseif not dock then
			pulledIn = false
			if not lifting then
				closeRefit()
			end
		end
		local idle = not overlay.Visible and not lifting and not player:GetAttribute("BoatRefitOpen")
		for _, each in CollectionService:GetTagged("RefitDock") do
			local prompt = each:FindFirstChild("RefitDockPrompt", true)
			if prompt and prompt:IsA("ProximityPrompt") then
				prompt.Enabled = each == dock and free and idle
			end
		end
	end)
	render()
end

return BoatRefit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="242">
          <Properties>
            <string name="Name">BoatSpray</string>
            <string name="Source"><![CDATA[-- Local stern spray for streamed-in, motor-powered player boats.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local BoatCatalog = require(ReplicatedStorage.Shared.BoatCatalog)
local Cargo = require(ReplicatedStorage.Shared.Cargo)
local Biomes = require(ReplicatedStorage.Shared.Biomes)
local Weather = require(ReplicatedStorage.Shared.Weather)

local BoatSpray = {}
local started = false
local MAX_DISTANCE = 280

local function stockMotors(spec): number
	local count = 0
	for _, item in spec.StarterParts or {} do
		local part = Cargo.Parts[item.PartId]
		if part and part.Motor then
			count += 1
		end
	end
	return count
end

local function makeSpray(model: Model, root: BasePart, spec, offset: Vector3)
	local jets = {}
	local transom = model:FindFirstChild("TransomCap", true) or model:FindFirstChild("TransomTrim", true)
	local stern = if transom and transom:IsA("BasePart")
		then root.CFrame:PointToObjectSpace(transom.Position).Z
		else spec.Length / 2 - offset.Z
	for _, side in { -1, 1 } do
		local attachment = Instance.new("Attachment")
		attachment.Name = "MotorSpray"
		-- Builders face -Z; +Z is behind the transom, at the waterline.
		local position = Vector3.new(side * spec.Beam * 0.16 - offset.X, 0.1 - offset.Y, stern + 0.7)
		attachment.CFrame = CFrame.lookAt(position, position + Vector3.new(side * 0.12, 0.32, 1))
		attachment.Parent = root
		local spray = Instance.new("ParticleEmitter")
		spray.Name = "WaterSpray"
		spray.Texture = "rbxasset://textures/particles/smoke_main.dds"
		spray.Color = ColorSequence.new(Color3.fromRGB(224, 244, 248))
		spray.LightInfluence = 0.6
		spray.EmissionDirection = Enum.NormalId.Front
		spray.SpreadAngle = Vector2.new(20, 12)
		spray.Lifetime = NumberRange.new(0.3, 0.65)
		spray.Acceleration = Vector3.new(0, -28, 0)
		spray.Drag = 1.5
		spray.VelocityInheritance = 0.15
		spray.LockedToPart = false
		spray.Rotation = NumberRange.new(0, 360)
		spray.RotSpeed = NumberRange.new(-40, 40)
		spray.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.25),
			NumberSequenceKeypoint.new(0.35, 0.8),
			NumberSequenceKeypoint.new(1, 1.5),
		})
		spray.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.25),
			NumberSequenceKeypoint.new(0.3, 0.45),
			NumberSequenceKeypoint.new(1, 1),
		})
		spray.Rate = 0
		spray.Enabled = false
		spray.Parent = attachment
		table.insert(jets, { attachment = attachment, spray = spray })
	end
	return jets
end

function BoatSpray.start()
	if started then
		return
	end
	started = true
	local records = {}
	local scan = 0.3
	RunService.Heartbeat:Connect(function(dt)
		local folder = workspace:FindFirstChild("PlayerBoats")
		scan += dt
		if folder and scan >= 0.3 then
			scan = 0
			for _, model in folder:GetChildren() do
				if not model:IsA("Model") or records[model] then
					continue
				end
				local spec = BoatCatalog[model:GetAttribute("BoatId")]
				local root = model.PrimaryPart
				local seat = spec and model:FindFirstChild(spec.DriverSeat, true)
				if root and seat and seat:IsA("VehicleSeat") then
					records[model] = { root = root, seat = seat, spec = spec, stock = stockMotors(spec) }
				end
			end
		end
		local camera = workspace.CurrentCamera
		for model, record in records do
			local root, seat, spec = record.root, record.seat, record.spec
			if
				not folder
				or model.Parent ~= folder
				or not root:IsDescendantOf(model)
				or not seat:IsDescendantOf(model)
			then
				for _, jet in record.jets or {} do
					jet.attachment:Destroy()
				end
				records[model] = nil
				continue
			end
			local motors = model:GetAttribute("MotorCount") or record.stock
			local velocity = root.AssemblyLinearVelocity
			local speed = math.abs(velocity:Dot(root.CFrame.LookVector))
			local nearby = camera and (root.Position - camera.CFrame.Position).Magnitude <= MAX_DISTANCE
			local driver = seat.Occupant
			local active = motors > 0
				and nearby
				and driver
				and driver.Health > 0
				and speed > 2
				and not model:GetAttribute("Parked")
				and not model:GetAttribute("Hoisted")
				and not model:GetAttribute("DisplayOnly")
			if active then
				-- A thrown hull must not spray while away from the surface.
				local wave = Weather.sample(root.Position, workspace:GetServerTimeNow())
				active = math.abs(root.Position.Y - (Biomes.WaterLevel + wave.height)) < 5
			end
			if active and not record.jets then
				record.jets =
					makeSpray(model, root, spec, model:GetAttribute("WaterlineRootOffset") or Vector3.new(0, -0.4, 0))
			end
			local strength = math.clamp(speed / spec.ForwardSpeed, 0, 1)
			for _, jet in record.jets or {} do
				jet.spray.Enabled = active == true
				jet.spray.Rate = if active then 25 + strength * 85 else 0
				jet.spray.Speed = NumberRange.new(7 + strength * 7, 11 + strength * 12)
				if not nearby then
					jet.spray:Clear()
				end
			end
		end
	end)
end

return BoatSpray
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="243">
          <Properties>
            <string name="Name">Boating</string>
            <string name="Source"><![CDATA[-- Drydock shop and owner-only dock prompts. Cash and ownership come from the server.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local UserInputService = game:GetService("UserInputService")
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))
local BoatCatalog = require(ReplicatedStorage.Shared.BoatCatalog)
local Paths = require(ReplicatedStorage.Shared.Paths)
local Weather = require(ReplicatedStorage.Shared.Weather)
local DayNight = require(ReplicatedStorage.Shared.DayNight)
local Seasons = require(ReplicatedStorage.Shared.Seasons)
local Calendar = require(ReplicatedStorage.Shared.Calendar)
local DrydockCamera = require(script.Parent.DrydockCamera)
local BoatPreview = require(script.Parent.BoatPreview)
local BoatCamera = require(script.Parent.BoatCamera)
local BoatDriving = require(script.Parent.BoatDriving)

local Boating = {}

local function formatPrice(price: number): string
	return if price == 0 then "Free" else "$" .. tostring(price)
end

function Boating.start()
	local player = Players.LocalPlayer
	BoatDriving.start()
	local remotes = ReplicatedStorage:WaitForChild("Boating")
	local request = remotes:WaitForChild("Request") :: RemoteEvent
	local feedback = remotes:WaitForChild("Feedback") :: RemoteEvent
	local netRemote = ReplicatedStorage:WaitForChild("TrawlerNet") :: RemoteEvent
	local boatIds = {}
	for id in BoatCatalog do
		table.insert(boatIds, id)
	end
	table.sort(boatIds, function(a, b)
		local priceA, priceB = BoatCatalog[a].Price, BoatCatalog[b].Price
		return if priceA == priceB then a < b else priceA < priceB
	end)
	local selectedBoatId = "Rowboat"
	local selectedDockBoatId = "Rowboat"
	local spec = BoatCatalog.Rowboat
	local previewShop: Model? = nil
	local dockBase: Instance? = nil
	local isLaunching = false
	local cream = Theme.Colors.Text
	local muted = Theme.Colors.Muted
	local gold = Theme.Colors.Blue
	local navy = Theme.Colors.Window
	local gui = Instance.new("ScreenGui")
	gui.Name = "Boating"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 20
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	local function corner(parent: GuiObject, radius: number)
		Theme.corner(parent, math.min(radius, 10))
	end
	local function label(
		parent: Instance,
		text: string,
		position: UDim2,
		size: UDim2,
		fontSize: number,
		color: Color3
	): TextLabel
		local item = Instance.new("TextLabel")
		item.BackgroundTransparency = 1
		item.Position, item.Size = position, size
		item.Font = Enum.Font.Gotham
		item.Text, item.TextSize, item.TextColor3 = text, fontSize, color
		item.TextXAlignment = Enum.TextXAlignment.Left
		item.TextWrapped = true
		Theme.text(item, color)
		item.Parent = parent
		return item
	end
	local wallet = Instance.new("Frame")
	wallet.Name = "Wallet"
	wallet.AnchorPoint = Vector2.new(0, 1)
	wallet.Position = UDim2.new(0, 24, 1, -22)
	wallet.Size = UDim2.fromOffset(244, 82)
	wallet.BackgroundTransparency = 1
	wallet.Parent = gui
	-- Time of day, season and weather sit in one row above the cash.
	local statusRow = Instance.new("Frame")
	statusRow.Name = "StatusIcons"
	statusRow.Position = UDim2.fromOffset(0, -44)
	statusRow.Size = UDim2.fromOffset(244, 36)
	statusRow.BackgroundTransparency = 1
	statusRow.ZIndex = 2
	statusRow.Parent = wallet
	local rowLayout = Instance.new("UIListLayout")
	rowLayout.FillDirection = Enum.FillDirection.Horizontal
	rowLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	rowLayout.SortOrder = Enum.SortOrder.LayoutOrder
	rowLayout.Padding = UDim.new(0, 6)
