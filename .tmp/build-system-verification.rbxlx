			Shirt = { 238, 234, 222 },
			Sleeves = "Short",
			Trousers = { 92, 70, 52 },
			Shoes = { 50, 36, 26 },
			Hair = { 26, 18, 14 },
			HairStyle = "Bun",
			Pieces = {
