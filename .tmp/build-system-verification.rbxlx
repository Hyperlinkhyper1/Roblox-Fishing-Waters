  <Item class="ServerScriptService" referent="126">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="127">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Set this before requiring generators/services, which may yield while loading.
-- Characters must never arrive on an empty or partly repaired home island.
Players.CharacterAutoLoads = false
ReplicatedStorage:SetAttribute("FishingWatersWorldReady", false)
ReplicatedStorage:SetAttribute("FishingWatersGenerationComplete", false)
ReplicatedStorage:SetAttribute("FishingWatersStartupError", false)
ReplicatedStorage:SetAttribute("FishingWatersGenerationError", false)

local started = os.clock()
local function stage(message: string, progress: number)
	ReplicatedStorage:SetAttribute("FishingWatersLoadStage", message)
	ReplicatedStorage:SetAttribute("FishingWatersLoadProgress", progress)
end
stage("Preparing your harbour", 0.02)

-- The admin-only showcase sits far outside the ocean, so nobody waits for it. It runs in its own
-- thread, scheduled before startup, so a startup step that fails or exhausts the script timeout
-- cannot keep it from being built. It waits for the world to finish (or give up) so it does not
-- compete with the harbour, but never longer than two minutes.
task.defer(function()
	local waited = 0
	while
		waited < 120
		and not ReplicatedStorage:GetAttribute("FishingWatersGenerationComplete")
		and not ReplicatedStorage:GetAttribute("FishingWatersGenerationError")
		and not ReplicatedStorage:GetAttribute("FishingWatersStartupError")
	do
		waited += task.wait(1)
	end
	print("[ScaleModels] Building the scale models")
	local built, problem = xpcall(function()
		require(script.ScaleModels).ensure()
	end, debug.traceback)
	if built then
		print("[ScaleModels] Scale models ready")
	else
		warn("[ScaleModels] " .. tostring(problem))
	end
end)

local ok, failure = xpcall(function()
	-- Update notices and stale-server admission must work even while the map loads.
	require(script.ServerUpdates).start()
	local BaseService = require(script.BaseService)
	local Map = require(script.Map)
	local Harbour = require(script.Map.Harbour)

	local function openHarbour(root: Folder)
		stage("Getting your dock ready", 0.9)
		Map.prepareStreaming(root)
		require(script.Map.ChartCatalog).start(root)
		require(script.WeatherService).start()
		-- Install inventory/character listeners and remotes before BaseService spawns players.
		require(script.BoatService).start()
		require(script.SharkService).start()
		require(script.FishingService).start()
		require(script.AnglerService).start()
		require(script.SharkLootService).start()
		require(script.CatchService).start()
		require(script.CargoService).start()
		require(script.BoatRefitService).start()
		require(script.TrawlerNetService).start()
		require(script.BackpackService).start()
		require(script.CustomerService).start()
		require(script.KitchenService).start()
		require(script.ChefService).start()
		require(script.CrabCageService).start()
		require(script.MusselNetService).start()
		require(script.FurnitureService).start()
		require(script.BuildingService).start()
		require(script.RestaurantService).start()
		require(script.CompanyService).start()
		require(script.CompanyIslandService).start()
		require(script.CompanyIslandPorter).start()
		require(script.TutorialService).start()
		require(script.PirateCoveService).start()
		require(script.MetroService).start()
		require(script.HalloweenService).start()

		require(script.LeaderboardService).start(root)
		BaseService.start()
		require(script.OxygenService).start()
		require(script.DashboardService).start()
		stage("Your harbour is ready", 1)
		ReplicatedStorage:SetAttribute("FishingWatersStartupSeconds", os.clock() - started)
		ReplicatedStorage:SetAttribute("FishingWatersWorldReady", true)
		print(
			string.format(
				"[Startup] Harbour playable in %.1fs; distant scenery may continue loading",
				os.clock() - started
			)
		)
	end

	local root = workspace:FindFirstChild("Map")
	if root then
		-- A baked map needs only gameplay repairs before spawning. Cosmetic
		-- migrations and distant LOD/seabed work can run after the harbour opens.
		stage("Preparing your dock", 0.35)
		Harbour.ensurePlazaPaving(root)
		Harbour.ensureBoating(root)
		Harbour.ensureFishing(root)
		Harbour.ensureBases(root)
		Harbour.ensureMetro(root)
		Map.ensureCompanyIslands(root)
		openHarbour(root :: Folder)
		-- Players are in by now. Each repair gets a fresh resume, and a slow one is named, because
		-- a run of them without a yield exhausted the script timeout and cut startup short.
		local function repair(name: string, run: () -> ())
			task.wait()
			local began = os.clock()
			run()
			if os.clock() - began > 1 then
				print(string.format("[Startup] %s took %.1fs", name, os.clock() - began))
			end
		end
		repair("City", function()
			Map.ensureCity(root)
		end)
		repair("Pirate Cove", function()
			Map.ensurePirateCove(root)
		end)
		repair("Seabed details", Map.ensureSeabedDetails)
		repair("Boats", function()
			require(script.Map.Mediterranean).ensureBoats(root)
		end)
		repair("Surf", function()
			Harbour.ensureSurf(root, require(ReplicatedStorage.Shared.Biomes).Normal.center)
		end)
		repair("Lod", Map.ensureLod)
		repair("Sign text", Map.ensureSignText)
		task.wait()
	else
		-- The callback runs once the home island, collision, shops and bases
		-- exist, before generating the surrounding islands and distant biomes.
		Map.build(openHarbour, stage)
	end
	Map.animate()
	ReplicatedStorage:SetAttribute("FishingWatersGenerationComplete", true)
end, debug.traceback)

if not ok then
	if ReplicatedStorage:GetAttribute("FishingWatersWorldReady") then
		ReplicatedStorage:SetAttribute("FishingWatersGenerationError", true)
	else
		ReplicatedStorage:SetAttribute("FishingWatersStartupError", true)
		stage("The harbour could not start", 0)
	end
	warn("[Startup] " .. tostring(failure))
end
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="128">
        <Properties>
          <string name="Name">AdminCommands</string>
          <string name="Source"><![CDATA[-- Private command replies and permission checks live on the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")
local Passes = require(ReplicatedStorage.Shared.Gamepasses)
local GamepassService = require(script.Parent.GamepassService)
local Calendar = require(ReplicatedStorage.Shared.Calendar)
local DayNight = require(ReplicatedStorage.Shared.DayNight)

local Service = {}
local started = false
local COMMAND_USER_ID = 2541746813 -- hyperlinkhyper
local help = table.concat({
	"Commands:",
	"/commands - show this list",
	"/gamepass list - list gamepasses",
	"/gamepass get <gamepass name> - enable a pass for this server session",
	"/event list - list events",
	"/event spawn <event> - start an event for the rest of the in-game day",
	"/set cash <amount> - set your cash",
	"/set weather list - list weather types",
	"/set weather <type> - change the weather",
	"/set season <spring|summer|autumn|winter|auto> - pin the season or let it follow the clock",
	"/set date <month-day> [hh:mm] - jump the in-game calendar there (e.g. 10-31 23:50), or auto",
	"/tp city - teleport to the city",
	"/tp models - teleport to the full-size scale models",
	"/fly - toggle flight (WASD, Space up, Ctrl down)",
	"/fly speed <studs per second> - set flight speed (default 50)",
}, "\n")

local function normalize(name: string): string
	return (string.lower(name):gsub("%s+", ""))
end

function Service.start(reply)
	if started then
		return
	end
	started = true
	local function register(name, alias, handler)
		local command = Instance.new("TextChatCommand")
		command.Name = name
		command.PrimaryAlias = alias
		command.AutocompleteVisible = false
		command.Triggered:Connect(function(source, message)
			local player = source and Players:GetPlayerByUserId(source.UserId)
			if player and player.UserId == COMMAND_USER_ID and type(message) == "string" then
				handler(player, string.lower(message))
			end
		end)
		command.Parent = TextChatService
	end

	register("CommandsCommand", "/commands", function(player)
		reply(player, help)
	end)
	register("EventCommand", "/event", function(player, message)
		if message:match("^/event%s+list%s*$") then
			reply(player, "Events: Halloween.")
			return
		end
		local requested = message:match("^/event%s+spawn%s+(%S+)%s*$")
		if requested == "halloween" then
			local now = workspace:GetServerTimeNow()
			local date = Calendar.now(now)
			workspace:SetAttribute("HalloweenEventDay", (date.Year - 1) * Calendar.DAYS_PER_YEAR + date.DayOfYear)
			workspace:SetAttribute("HalloweenEventEnds", now + (24 - date.Hour) * DayNight.SECONDS_PER_HOUR)
			reply(player, "Halloween is active in this server for the rest of the in-game day.")
		elseif requested then
			reply(player, "Unknown event. Use /event list for available events.")
		else
			reply(player, "Usage: /event list or /event spawn <event>.")
		end
	end)
	register("FlyCommand", "/fly", function(player, message)
		if message:match("^/fly%s*$") then
			local enabled = not player:GetAttribute("AdminFlyEnabled")
			player:SetAttribute("AdminFlyEnabled", enabled)
			reply(player, if enabled then "Flight enabled. Use WASD, Space and Ctrl to move." else "Flight disabled.")
			return
		end
		local input = message:match("^/fly%s+speed%s+(%S+)%s*$")
		local speed = input and tonumber(input)
		if not speed or speed <= 0 or speed ~= speed or speed == math.huge then
			reply(player, "Usage: /fly or /fly speed <positive studs per second>.")
			return
		end
		player:SetAttribute("AdminFlySpeed", speed)
		reply(player, "Flight speed set to " .. tostring(speed) .. " studs per second.")
	end)
	-- Each destination returns the part it lands on and the frame to land at
	local destinations = {
		city = function()
			local map = workspace:FindFirstChild("Map")
			local city = map and map:FindFirstChild("Modern City")
			-- Cities from version 4 on have only the arrival point at their top level
			local arrival = city and city:FindFirstChild("CityArrival")
			local pavement = city and city:FindFirstChild("CityPavement")
			if arrival and arrival:IsA("BasePart") then
				return arrival, arrival.CFrame * CFrame.new(0, 5, 0)
			elseif pavement and pavement:IsA("BasePart") then
				-- The oldest baked cities have no arrival point and keep the avenue-intersection fallback
				return pavement, pavement.CFrame * CFrame.new(-150, 5, -150)
			end
			return nil
		end,
		-- The showcase lies outside the ocean where no boat can sail, so this is the only way there.
		-- The pier goes up on the spot if needed, so the admin can watch the ship being built.
		models = function(player)
			local scaleModels = require(script.Parent.ScaleModels)
			local arrival = scaleModels.ensurePier()
			-- Pins the ship to this player, so a client short of memory does not drop it
			scaleModels.visit(player)
			return arrival, arrival.CFrame * CFrame.new(0, 3, 0)
		end,
	}
	local names = { city = "the city", models = "the scale models" }
	register("TeleportCommand", "/tp", function(player, message)
		local place = message:match("^/tp%s+(%a+)%s*$")
		local find = place and destinations[place]
		if not find then
			reply(player, "Usage: /tp city or /tp models.")
			return
		end
		local anchor, destination = find(player)
		if not anchor then
			local name = names[place]
			reply(player, string.upper(name:sub(1, 1)) .. name:sub(2) .. " " .. (if place == "city" then "is" else "are") .. " not ready yet. Try again shortly.")
			return
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not humanoid or humanoid.Health <= 0 or not root then
			reply(player, "Your character is not ready to teleport.")
			return
		end
		pcall(player.RequestStreamAroundAsync, player, destination.Position, 4)
		if player.Character ~= character or not character.Parent or humanoid.Health <= 0 or not anchor.Parent then
			return
		end
		humanoid.Sit = false
		character:PivotTo(destination)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		reply(player, "Teleported to " .. names[place] .. ".")
	end)
	register("GamepassCommand", "/gamepass", function(player, message)
		if message:match("^/gamepass%s+list%s*$") then
			local names = {}
			for _, pass in Passes do
				table.insert(names, pass.Name)
			end
			table.sort(names)
			reply(player, "Gamepasses: " .. table.concat(names, ", ") .. ".")
			return
		end
		local requested = message:match("^/gamepass%s+get%s+(.+)$")
		if requested then
			for key, pass in Passes do
				if normalize(requested) == normalize(pass.Name) or normalize(requested) == normalize(key) then
					local _, result = GamepassService.grantForSession(player, key)
					reply(player, result)
					return
				end
			end
			reply(player, "Unknown gamepass. Use /gamepass list for available names.")
		else
			reply(player, "Usage: /gamepass list or /gamepass get <gamepass name>.")
		end
	end)
end

return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="129">
        <Properties>
          <string name="Name">AnglerData</string>
          <string name="Source"><![CDATA[-- Pure, copy-on-write progress stored inside the existing wallet profile.
local Data = {}
-- Required on first use: several test harnesses inline this file's source, where
-- the relative path cannot resolve.
local Cargo
local function cargo()
	if not Cargo then
		Cargo = if script
			then require(game:GetService("ReplicatedStorage").Shared.Cargo)
			else require("../shared/Cargo")
	end
	return Cargo
end
local Furniture
local function furniture()
	if not Furniture then
		Furniture = if script
			then require(game:GetService("ReplicatedStorage").Shared.FurnitureCatalog)
			else require("../shared/FurnitureCatalog")
	end
	return Furniture
end
-- Structural build data shares the wallet save. Older profiles do not load the
-- catalog until they actually contain a building edit.
local Building
local function building()
	if not Building then
		Building = if script
			then require(game:GetService("ReplicatedStorage").Shared.BuildingCatalog)
			else require("../shared/BuildingCatalog")
	end
	return Building
end
local Recipes
local function recipes()
	if not Recipes then
		Recipes = if script
			then require(game:GetService("ReplicatedStorage").Shared.Recipes)
			else require("../shared/Recipes")
	end
	return Recipes
end
local Paths
local function paths()
	if not Paths then
		Paths = if script
			then require(game:GetService("ReplicatedStorage").Shared.Paths)
			else require("../shared/Paths")
	end
	return Paths
end
-- Base reward for unconfigured species and migration of old catch totals.
Data.XP_PER_CATCH = 100
Data.XP_LEVEL_STEP = 1000
Data.XP_LEVEL_GROWTH = 0.2
Data.WEEK_SECONDS = 7 * 24 * 60 * 60
-- Catches land in the angler's hand, which holds one fish; with full hands,
-- gameplay packs the next catch into the backpack when it fits. From the hand,
-- fish go into a boat's cargo hold or the shop freezer. Cooler holds fish saved before
-- the cargo hold existed.
local FreezerPacking, FreezerModels
local function freezerModules()
	if not FreezerPacking then
		local shared = game:GetService("ReplicatedStorage").Shared
		FreezerPacking = require(shared.FreezerPacking)
		FreezerModels = require(shared.FishModels)
	end
	return FreezerPacking, FreezerModels
end
-- Bought furniture waits in FurnitureStock until build mode places it in the
-- house (Furniture). Storage racks hold overflow fish (Storage) that customers
-- never see; only freezers stock the shop.
Data.RACK_CAPACITY = 12
-- A company island comes with its storage, kitchen and office as furniture in
-- FurnitureStock; the owner places them on the island's plot (CompanyFurniture).
Data.COMPANY_KIT = { StorageRack = 4, KitchenStorage = 1, CompanyPrep = 2, CompanyDesk = 1 }
-- Bench keys handed to placed CompanyPrep benches, in order (Recipes.CompanyBuiltIn).
Data.COMPANY_BENCHES = { "CompanyPrep1", "CompanyPrep2" }
-- Cooked dishes (Supermarket path) wait on the kitchen pass, which holds this many;
-- every placed food display case shows as many again to shop customers.
Data.PANTRY_CAPACITY = 6
Data.MAX_HOLD_CELL = 32

-- Unix epoch was a Thursday; offset to a Monday at 00:00 UTC.
function Data.weekStart(now)
	return math.floor((now + 3 * 86400) / Data.WEEK_SECONDS) * Data.WEEK_SECONDS - 3 * 86400
end

-- Level-up costs grow by 20%: 1000, 1200, 1440, ... XP. Round the
-- cumulative threshold so that saved XP and displayed progress stay integral.
function Data.xpForLevel(level)
	return math.floor(Data.XP_LEVEL_STEP * ((1 + Data.XP_LEVEL_GROWTH) ^ (level - 1) - 1) / Data.XP_LEVEL_GROWTH + 0.5)
end

function Data.level(xp)
	local level = math.max(1, math.floor(1 + math.log(1 + xp * Data.XP_LEVEL_GROWTH / Data.XP_LEVEL_STEP) / math.log(1 + Data.XP_LEVEL_GROWTH)))
	-- Correct logarithm and threshold rounding at exact level boundaries.
	while level > 1 and xp < Data.xpForLevel(level) do
		level -= 1
	end
	while xp >= Data.xpForLevel(level + 1) do
		level += 1
	end
	return level
end

function Data.levelProgress(xp)
	local level = Data.level(xp)
	local threshold = Data.xpForLevel(level)
	return level, xp - threshold, Data.xpForLevel(level + 1) - threshold
end
Data.DefaultSettings =
	{ Shadows = true, WeatherEffects = true, MasterVolume = 100, MusicVolume = 100, EffectsVolume = 100 }
local defaults = {
	TotalCaught = 0,
	TotalCaughtKg = 0,
	PerfectCatches = 0,
	CatchStreak = 0,
	HighestCatchStreak = 0,
	CoinsEarned = 0,
	CoinsSpent = 0,
	Deaths = 0,
	AstralAnomaliesActivated = 0,
	BestiaryPagesCompleted = 0,
	LimitedBestiariesCompleted = 0,
	PermanentBestiariesCompleted = 0,
	TreasureChestsOpened = 0,
	SunkenChestsOpened = 0,
	CrabCagesOpened = 0,
	MusselNetsOpened = 0,
	-- Business paths (Shared.Paths) count these per stage.
	FishSold = 0,
	FoodCooked = 0,
	FoodSold = 0,
	DinersServed = 0,
	FishermanCatches = 0,
}
local STAFF_ROLES = { Seller = true, Porter = true, Fisherman = true, RestaurantChef = true, CompanyChef = true }
local CHEF_PATHS = { RestaurantChef = "Restaurant", CompanyChef = "Company" }

local function number(value, integer)
	return type(value) == "number" and value >= 0 and value < 2 ^ 53 and (not integer or value % 1 == 0)
end
local function copy(value)
	if type(value) ~= "table" then
		return value
	end
	local result = {}
	for key, item in value do
		result[key] = copy(item)
	end
	return result
end
local function corruptionsValid(list)
	if type(list) ~= "table" or #list == 0 or #list > 8 then
		return false
	end
	for index, name in list do
		if type(index) ~= "number" or type(name) ~= "string" then
			return false
		end
	end
	return true
end
local function recordValid(record)
	return type(record) == "table"
		and type(record.FishId) == "string"
		and type(record.Mutation) == "string"
		and number(record.Kg, false)
		and record.Kg > 0
		and number(record.Value, false)
		and number(record.Rarity, false)
		and record.Rarity >= 1
		and number(record.Relative, false)
		and number(record.CaughtAt, true)
		and (record.Size == nil or type(record.Size) == "string")
		and (record.NeonColor == nil or type(record.NeonColor) == "string")
		and (record.Corruptions == nil or corruptionsValid(record.Corruptions))
end
-- A cooked dish keeps its source fish's identity so it can be shown and told apart.
local function dishValid(dish)
	return type(dish) == "table"
		and type(dish.RecipeId) == "string"
		and type(dish.FishId) == "string"
		and type(dish.Mutation) == "string"
		and number(dish.Kg, false)
		and number(dish.Value, false)
		and number(dish.MadeAt, true)
		and (dish.NeonColor == nil or type(dish.NeonColor) == "string")
end
local function flags(map)
	if type(map) ~= "table" then
		return false
	end
	for key, value in map do
		if type(key) ~= "string" or type(value) ~= "boolean" then
			return false
		end
	end
	return true
end
local function cell(value)
	return number(value, true) and value >= 1 and value <= Data.MAX_HOLD_CELL
end
local function itemValid(item)
	return type(item) == "table"
		and cell(item.X)
		and cell(item.Y)
		and number(item.R, true)
		and item.R <= 3
		and (item.Locked == nil or type(item.Locked) == "boolean")
		and (if item.PartId ~= nil then type(item.PartId) == "string" and item.Fish == nil else recordValid(item.Fish))
end
function Data.validSetting(key, value)
	local default = Data.DefaultSettings[key]
	return default ~= nil
		and (if type(default) == "boolean" then type(value) == "boolean" else number(value, true) and value <= 100)
end

-- The shop moved out of the house's front room into its own building across
-- the street, laid out as that room turned half a circle to face the house
-- (BaseGrid.SHOP_TURN). Everything placed in the old front room (centred
-- between its partition at z=2.25 and the front wall) turns with it, so every
-- saved layout fits exactly as it did and entries keep their place in the list.
local SHOP_TURN, OLD_SHOP_PARTITION, OLD_FRONT_WALL = 81, 2.25, 15.75
local function migrateShopBuilding(data)
	if data.ShopBuildingVersion == 1 then return end
	for _, entry in data.Furniture do
		if entry.Z > OLD_SHOP_PARTITION and entry.Z < OLD_FRONT_WALL then
			entry.X, entry.Z, entry.R = -entry.X, SHOP_TURN - entry.Z, (entry.R + 2) % 4
		end
	end
	data.ShopBuildingVersion = 1
end

-- The house's partitions and dining entrance moved onto grid borders, and the
-- kitchen's front corner was enclosed as the owner's office. Move only affected
-- furniture, retaining its entry and rotation so freezer/rack capacity and
-- active kitchen jobs stay attached to the player's profile.
local FURNITURE_WALL_VERSION = 2
local function migrateFurnitureWalls(data, retry)
	if data.FurnitureWallVersion == FURNITURE_WALL_VERSION and not retry then return end
	data.FurnitureWallMigrationPending = nil
	local indices = {}
	for index in data.Furniture do table.insert(indices, index) end
	table.sort(indices)
	if #indices > 0 then
		local catalog = furniture()
		for _, index in indices do
			local entry = data.Furniture[index]
			if not catalog.intersectsGridWall(entry) then continue end
			local others = {}
			for otherIndex, other in data.Furniture do
				if otherIndex ~= index and catalog.Items[other.ItemId] then table.insert(others, other) end
			end
			local bestX, bestZ, bestDistance = nil, nil, math.huge
			-- Scan the old half-stud lattice, not only the new coarse grid, so
			-- crowded legacy layouts have the best chance of remaining intact.
			for _, roomId in catalog.allowedRooms(entry.ItemId) do
				local room = catalog.Rooms[roomId]
				for ix = math.ceil(room[1] * 2), math.floor(room[3] * 2) do
					for iz = math.ceil(room[2] * 2), math.floor(room[4] * 2) do
						local x, z = ix / 2, iz / 2
						local distance = (x - entry.X) ^ 2 + (z - entry.Z) ^ 2
						if distance < bestDistance and not catalog.checkRelocation(others, entry.ItemId, x, z, entry.R)
							and not catalog.intersectsGridWall({ ItemId = entry.ItemId, X = x, Z = z, R = entry.R }) then
							bestX, bestZ, bestDistance = x, z, distance
						end
					end
				end
			end
			if bestX ~= nil then
				entry.X, entry.Z = bestX, bestZ
			else
				-- Do not discard a purchase or remove a capacity-bearing fixture
				-- if the existing room is too crowded to relocate it safely.
				data.FurnitureWallMigrationPending = true
			end
		end
	end
	data.FurnitureWallVersion = FURNITURE_WALL_VERSION
end

-- Furniture fills whole grid cells now (1x1 or 1x2), so some saved items grew
-- or moved onto their cells. Anything that no longer fits moves to the nearest
-- free grid spot, keeping its entry and rotation; with nowhere to go it stays.
local FURNITURE_CELL_VERSION = 1
local function migrateFurnitureCells(data)
	if data.FurnitureCellVersion == FURNITURE_CELL_VERSION then return end
	for _, site in { "Home", "Company" } do
		local entries = if site == "Company" then data.CompanyFurniture else data.Furniture
		local indices = {}
		for index in entries or {} do table.insert(indices, index) end
		if #indices == 0 then continue end
		table.sort(indices)
		local catalog = furniture()
		local function fits(entry, others, x, z, strict): boolean
			local reason = if strict
				then catalog.check(others, entry.ItemId, x, z, entry.R, nil, site)
				else catalog.checkRelocation(others, entry.ItemId, x, z, entry.R, site)
			-- Wall conflicts belong to migrateFurnitureWalls; never move into one.
			return reason == nil
				and (not strict or site == "Company" or not catalog.intersectsGridWall({ ItemId = entry.ItemId, X = x, Z = z, R = entry.R }))
		end
		for _, index in indices do
			local entry = entries[index]
			if not catalog.Items[entry.ItemId] then continue end
			local others = {}
			for otherIndex, other in entries do
				if otherIndex ~= index and catalog.Items[other.ItemId] then table.insert(others, other) end
			end
			if fits(entry, others, entry.X, entry.Z, false) then continue end
			local areas = { catalog.PLOT }
			if site == "Home" then
				areas = {}
				for _, roomId in catalog.allowedRooms(entry.ItemId) do table.insert(areas, catalog.Rooms[roomId]) end
			end
			local grid = catalog.GRID
			local bestX, bestZ, bestDistance = nil, nil, math.huge
			for _, area in areas do
				for ix = math.floor(area[1] / grid), math.ceil(area[3] / grid) do
					for iz = math.floor(area[2] / grid), math.ceil(area[4] / grid) do
						local x, z = ix * grid, iz * grid
						local distance = (x - entry.X) ^ 2 + (z - entry.Z) ^ 2
						if distance < bestDistance and fits(entry, others, x, z, true) then
							bestX, bestZ, bestDistance = x, z, distance
						end
					end
				end
			end
			if bestX ~= nil then
				entry.X, entry.Z = bestX, bestZ
			end
		end
	end
	data.FurnitureCellVersion = FURNITURE_CELL_VERSION
end

function Data.decode(raw)
	assert(raw == nil or type(raw) == "table", "Invalid angler progress")
	local data = copy(raw or {})
	if data.Building ~= nil then
		data.Building = building().decode(data.Building)
	end
	assert(data.ShopSign == nil or (type(data.ShopSign) == "string" and #data.ShopSign <= 96), "Invalid shop sign")
	data.ShopSign = data.ShopSign or ""
	assert(data.CompanyIsland == nil or (number(data.CompanyIsland, true) and data.CompanyIsland >= 1 and data.CompanyIsland <= 15), "Invalid company island")
	for _, name in
		{
			"Stats",
			"Settings",
			"Catches",
			"Findings",
			"Titles",
			"RedeemedCodes",
			"Cooler",
			"Freezer",
			"Holds",
			"Backpack",
			"Staff",
			"ChefRecipes",
			"FurnitureStock",
			"Furniture",
			"CompanyFurniture",
			"Storage",
			"Pantry",
			"Kitchen",
			"KitchenStorage",
			"Upgrades",
			"BoatPaint",
			"BoatUpgrades",
		}
	do
		assert(data[name] == nil or type(data[name]) == "table", "Invalid angler " .. name)
		data[name] = data[name] or {}
	end
	for role, hired in data.Staff do
		assert(STAFF_ROLES[role] and type(hired) == "boolean", "Invalid staff member")
	end
	for role, recipeId in data.ChefRecipes do
		assert(CHEF_PATHS[role] and type(recipeId) == "string" and #recipeId <= 100, "Invalid chef recipe")
	end
	assert(data.FishermanBoat == nil or type(data.FishermanBoat) == "string", "Invalid fisherman boat")
	for index, dish in data.Pantry do
		assert(type(index) == "number" and dishValid(dish), "Invalid dish")
	end
	for key, job in data.Kitchen do
		assert(
			type(key) == "string" and type(job) == "table" and dishValid(job.Dish) and number(job.ReadyAt, true)
				and (job.ChefRole == nil or CHEF_PATHS[job.ChefRole] ~= nil),
			"Invalid kitchen job"
		)
	end
	data.KitchenStorage = data.KitchenStorage or { Targets = {}, Fish = {} }
	assert(type(data.KitchenStorage) == "table", "Invalid kitchen storage")
	data.KitchenStorage.Targets = data.KitchenStorage.Targets or {}
	data.KitchenStorage.Fish = data.KitchenStorage.Fish or {}
	assert(type(data.KitchenStorage.Targets) == "table" and type(data.KitchenStorage.Fish) == "table", "Invalid kitchen storage")
	for rarity, count in data.KitchenStorage.Targets do
		assert(type(rarity) == "string" and number(count, true) and count >= 0, "Invalid kitchen storage target")
	end
	for index, record in data.KitchenStorage.Fish do
		assert(type(index) == "number" and recordValid(record), "Invalid kitchen storage fish")
	end
	for id, level in data.Upgrades do
		assert(type(id) == "string" and number(level, true), "Invalid upgrade")
	end
	-- Refit dock paint per boat id (Shared.BoatUpgrades.Paints); unknown ids paint nothing.
	for boatId, paint in data.BoatPaint do
		assert(type(boatId) == "string" and type(paint) == "string", "Invalid boat paint")
	end
	-- Permanent hull fittings per boat id (for example the trawler's stern net).
	for boatId, upgrades in data.BoatUpgrades do
		assert(type(boatId) == "string" and type(upgrades) == "table", "Invalid boat upgrades")
		for id, owned in upgrades do
			assert(type(id) == "string" and type(owned) == "boolean", "Invalid boat upgrade")
		end
	end
	-- Profiles from before paths start as a fish shop; their lifetime stats count
	-- towards it, since its baseline is empty.
	if data.Paths == nil then
		data.Paths = { Active = "Fishshop", Unlocked = { Fishshop = true }, Completed = {}, Baseline = {} }
	end
	local path = data.Paths
	assert(
		type(path) == "table"
			and type(path.Active) == "string"
			and flags(path.Unlocked)
			and flags(path.Completed)
			and type(path.Baseline) == "table"
			and path.Unlocked[path.Active] == true,
		"Invalid path progress"
	)
	path.SkipCredits = if path.SkipCredits == nil then 0 else path.SkipCredits
	path.SkipReceipts = if path.SkipReceipts == nil then {} else path.SkipReceipts
	assert(number(path.SkipCredits, true) and flags(path.SkipReceipts), "Invalid path skips")
	assert(path.SkipTarget == nil or type(path.SkipTarget) == "string", "Invalid path skip target")
	for stat, value in path.Baseline do
		assert(type(stat) == "string" and number(value, stat ~= "TotalCaughtKg"), "Invalid path baseline")
	end
	for key, value in defaults do
		if data.Stats[key] == nil then
			data.Stats[key] = value
		end
		assert(number(data.Stats[key], key ~= "TotalCaughtKg"), "Invalid statistic " .. key)
	end
	-- Legacy catches receive their lifetime XP without crediting the current week.
	if data.Stats.TotalXP == nil then
		data.Stats.TotalXP = data.Stats.TotalCaught * Data.XP_PER_CATCH
	end
	assert(number(data.Stats.TotalXP, true), "Invalid total XP")
	-- Anglers who fished before the island tutorial existed start with it finished; /tutorial replays it.
	if data.TutorialStep == nil then
		data.TutorialStep = 1
		data.TutorialDone = data.Stats.TotalCaught > 0
	end
	assert(number(data.TutorialStep, true) and data.TutorialStep >= 1, "Invalid tutorial step")
	data.TutorialDone = data.TutorialDone == true
	data.TutorialRewarded = data.TutorialRewarded == true
	-- Pirate Cove (Shared.PirateCove): each quest giver's current step, and the galley's sales today.
	data.CoveQuests = data.CoveQuests or {}
	assert(type(data.CoveQuests) == "table", "Invalid cove quests")
	for npcId, quest in data.CoveQuests do
		assert(
			type(npcId) == "string"
				and type(quest) == "table"
				and number(quest.Step, true)
				and quest.Step >= 1
				and (quest.Accepted == nil or type(quest.Accepted) == "boolean")
				and (quest.Base == nil or number(quest.Base, true)),
			"Invalid cove quest"
		)
	end
	if data.CoveSales ~= nil then
		assert(
			type(data.CoveSales) == "table" and number(data.CoveSales.Day, true) and number(data.CoveSales.Count, true),
			"Invalid cove sales"
		)
	end
	if data.Weekly ~= nil then
		assert(type(data.Weekly) == "table", "Invalid weekly progress")
		assert(number(data.Weekly.Start, true), "Invalid week start")
		for _, key in { "XP", "Caught", "Earned" } do
			assert(number(data.Weekly[key], true), "Invalid weekly " .. key)
		end
	end
	for key, value in Data.DefaultSettings do
		if data.Settings[key] == nil then
			data.Settings[key] = value
		end
		assert(Data.validSetting(key, data.Settings[key]), "Invalid setting " .. key)
	end
	for id, entry in data.Catches do
		assert(type(id) == "string" and type(entry) == "table", "Invalid fish entry")
		assert(number(entry.Count, true) and number(entry.BiggestKg, false), "Invalid catch totals")
		assert(type(entry.Mutations) == "table", "Invalid mutations")
		for mutation, count in entry.Mutations do
			assert(type(mutation) == "string" and number(count, true), "Invalid mutation count")
		end
	end
	for _, record in data.Findings do
		assert(recordValid(record), "Invalid finding")
	end
	for index, record in data.Cooler do
		assert(type(index) == "number" and recordValid(record), "Invalid cooler fish")
	end
	for index, record in data.Freezer do
		assert(type(index) == "number" and recordValid(record), "Invalid freezer fish")
	end
	for index, record in data.Storage do
		assert(type(index) == "number" and recordValid(record), "Invalid stored fish")
	end
	for itemId, count in data.FurnitureStock do
		assert(type(itemId) == "string" and number(count, true), "Invalid furniture stock")
	end
	-- Like holds, placement rules are checked when furniture moves, not here.
	for _, list in { data.Furniture, data.CompanyFurniture } do
		for index, entry in list do
			assert(
				type(index) == "number"
					and type(entry) == "table"
					and type(entry.ItemId) == "string"
					and type(entry.X) == "number"
					and type(entry.Z) == "number"
					and number(entry.R, true)
					and entry.R <= 3,
				"Invalid furniture"
			)
			if entry.ItemId == "StorageRack" then
				assert(entry.Mode == nil or entry.Mode == "Tools", "Invalid rack mode")
				assert((entry.Cages == nil or number(entry.Cages, true)) and (entry.Nets == nil or number(entry.Nets, true)), "Invalid rack tools")
				assert((entry.Cages or 0) + (entry.Nets or 0) <= Data.RACK_CAPACITY, "Rack tools exceed capacity")
			end
			assert(entry.Key == nil or table.find(Data.COMPANY_BENCHES, entry.Key), "Invalid bench key")
		end
	end
	assert(data.CompanyKit == nil or data.CompanyKit == 1, "Invalid company kit")
	-- Owners from before the kit had built-in houses; they get the same fixtures
	-- once, to place themselves. A purchase is granted it the same way.
	if data.CompanyIsland and not data.CompanyKit then
		for itemId, count in Data.COMPANY_KIT do
			data.FurnitureStock[itemId] = (data.FurnitureStock[itemId] or 0) + count
		end
		data.CompanyKit = 1
	end
	migrateShopBuilding(data)
	migrateFurnitureWalls(data)
	migrateFurnitureCells(data)
	-- Crab cages wait in Stock until dropped by the dock; Placed spots are dock-local
	-- studs (Shared.CrabCages holds the rules, which are checked when cages move).
	if data.CrabCages == nil then
		data.CrabCages = { Stock = 0, Placed = {} }
	end
	local cages = data.CrabCages
	assert(type(cages) == "table" and number(cages.Stock, true) and type(cages.Placed) == "table", "Invalid crab cages")
	for index, cage in cages.Placed do
		assert(
			type(index) == "number"
				and type(cage) == "table"
				and type(cage.X) == "number"
				and cage.X == cage.X
				and type(cage.Z) == "number"
				and cage.Z == cage.Z
				and number(cage.Uses, true)
				and cage.Uses >= 1
				and number(cage.ReadyAt, true),
			"Invalid crab cage"
		)
	end
	if data.MusselNets == nil then
		data.MusselNets = { Stock = 0, Placed = {} }
	end
	local nets = data.MusselNets
	assert(type(nets) == "table" and number(nets.Stock, true) and type(nets.Placed) == "table", "Invalid mussel nets")
	for index, net in nets.Placed do
		assert(type(index) == "number" and type(net) == "table" and type(net.X) == "number" and net.X == net.X
			and type(net.Z) == "number" and net.Z == net.Z and number(net.Uses, true) and net.Uses >= 1
			and number(net.ReadyAt, true), "Invalid mussel net")
	end
	data.BackpackId = data.BackpackId or "Starter"
	assert(type(data.BackpackId) == "string", "Invalid backpack")
	for index, item in data.Backpack do
		assert(type(index) == "number" and itemValid(item) and item.PartId == nil, "Invalid backpack fish")
	end
	-- Preserve the old 12-cell starter grid when it already contains saved fish.
	if data.BackpackVersion == nil and data.BackpackId == "Starter" and #data.Backpack > 0 then
		data.BackpackId = "Cooler"
	end
	data.BackpackVersion = 2
	assert(data.Hand == nil or recordValid(data.Hand), "Invalid fish in hand")
	-- Placement is checked when items move, not here, so a later hull change can
	-- never make a saved profile unreadable.
	for boatId, items in data.Holds do
		assert(type(boatId) == "string" and type(items) == "table", "Invalid cargo hold")
		for index, item in items do
			assert(type(index) == "number" and itemValid(item), "Invalid cargo")
		end
	end
	for _, name in { "Titles", "RedeemedCodes" } do
		for id, owned in data[name] do
			assert(type(id) == "string" and type(owned) == "boolean", "Invalid unlock")
		end
	end
	if data.EquippedTitle == nil then
		data.EquippedTitle = ""
	end
	assert(type(data.EquippedTitle) == "string", "Invalid equipped title")
	if data.Holds.PatrolBoat and data.PatrolHoldVersion ~= 3 then
		local boatCatalog = if script
			then require(game:GetService("ReplicatedStorage").Shared.BoatCatalog)
			else require("../shared/BoatCatalog")
		local fishCatalog = if script
			then require(game:GetService("ReplicatedStorage").Shared.AnglerCatalog)
			else require("../shared/AnglerCatalog")
		Data.migratePatrolHold(data, boatCatalog.PatrolBoat, fishCatalog.Fish)
	elseif not data.Holds.PatrolBoat then
		data.PatrolHoldVersion = 3
	end
	return data
end
-- `traits` carries the mutation's NeonColor and Corruptions, when it has them.
local function catchRecord(fishId, mutation, kg, value, caughtAt, species, mutations, size, traits)
	assert(type(fishId) == "string" and species[fishId], "Unknown fish")
	assert(type(mutation) == "string" and mutations[mutation], "Unknown mutation")
	local fish = species[fishId]
	assert(number(fish.AverageKg, false) and fish.AverageKg > 0, "Invalid fish average weight")
	assert(number(fish.RarityDenominator, false) and fish.RarityDenominator >= 1, "Invalid fish rarity")
	local rarityMultiplier = mutations[mutation].RarityMultiplier or 1
	assert(number(rarityMultiplier, false) and rarityMultiplier >= 1, "Invalid mutation rarity")
	local record = {
		FishId = fishId,
		Mutation = mutation,
		Kg = kg,
		Value = value,
		CaughtAt = caughtAt,
		Rarity = fish.RarityDenominator * rarityMultiplier,
		Relative = kg / fish.AverageKg,
		Size = size,
		NeonColor = traits and traits.NeonColor,
		Corruptions = traits and copy(traits.Corruptions),
	}
	assert(recordValid(record), "Invalid catch")
	return record
end

-- A cast is possible while the hand is empty or the backpack has an open tile.
function Data.hasCatchSpace(raw, backpackLayout, species)
	if not raw.Hand then
		return true
	end
	local grid = cargo()
	local taken = grid.occupied(raw.Backpack, species)
	for y, row in backpackLayout.Hold do
		for x = 1, #row do
			if grid.open(backpackLayout.Hold, x, y) and not grid.at(taken, x, y) then
				return true
			end
		end
	end
	return false
end

-- Shared bestiary, streak, XP and findings bookkeeping for every landed fish.
-- `record` is always a fresh record owned by this transaction.
local function registerCatch(data, record, species, doubleXP)
	local entry = data.Catches[record.FishId] or { Count = 0, BiggestKg = 0, Mutations = {} }
	data.Catches[record.FishId] = entry
	entry.Count += 1
	entry.BiggestKg = math.max(entry.BiggestKg, record.Kg)
	entry.Mutations[record.Mutation] = (entry.Mutations[record.Mutation] or 0) + 1
	local catchXP = species[record.FishId].CatchXP or Data.XP_PER_CATCH
	assert(number(catchXP, true) and catchXP > 0, "Invalid catch XP")
	data.Stats.TotalCaught += 1
	data.Stats.TotalCaughtKg += record.Kg
	data.Stats.TotalXP += catchXP * (if doubleXP then 2 else 1)
	data.Stats.CatchStreak += 1
	data.Stats.HighestCatchStreak = math.max(data.Stats.HighestCatchStreak, data.Stats.CatchStreak)
	for key, field in { HighestValue = "Value", Rarest = "Rarity", Largest = "Kg", RelativeLargest = "Relative" } do
		if not data.Findings[key] or record[field] > data.Findings[key][field] then
			data.Findings[key] = copy(record)
		end
	end
end

-- Gameplay supplies the owned backpack layout. Returns the catch's destination
-- so identical fish already in hand cannot be mistaken for the new catch.
function Data.recordCatch(raw, fishId, mutation, kg, value, caughtAt, species, mutations, size, traits, backpackLayout, doubleXP, toFreezer, perfectCatch)
	assert(type(fishId) == "string" and species[fishId], "Unknown fish")
	local record = catchRecord(fishId, mutation, kg, value, caughtAt, species, mutations, size, traits)
	local data = Data.decode(raw)
	registerCatch(data, record, species, doubleXP)
	if perfectCatch == true then
		data.Stats.PerfectCatches += 1
	end
	local destination = "Released"
	if toFreezer then
		if Data.canFreeze(data, record) then
			table.insert(data.Freezer, copy(record))
			destination = "Freezer"
		end
	elseif data.Hand == nil then
		data.Hand = copy(record)
		destination = "Hand"
	elseif backpackLayout then
		local spot = cargo().bestSpot(backpackLayout.Hold, data.Backpack, { Fish = record }, species)
		if spot then
			table.insert(data.Backpack, { Fish = copy(record), X = spot.X, Y = spot.Y, R = spot.R })
			destination = "Backpack"
		end
	end
	return data, destination
end

-- Shark rewards are awarded together. Overflow stays in storage so no roll is lost
-- when the player's hand and backpack are full.
function Data.recordSharkDrops(raw, drops, caughtAt, species, backpackLayout)
	local data = Data.decode(raw)
	local overflow = false
	for _, fishId in drops do
		local info = assert(species[fishId], "Unknown shark drop")
		local record = catchRecord(fishId, "Normal", info.AverageKg, info.BaseValue, caughtAt, species, { Normal = {} }, "Normal")
		if not data.Hand then
			data.Hand = record
		else
			local spot = cargo().bestSpot(backpackLayout.Hold, data.Backpack, { Fish = record }, species)
			if spot then
				table.insert(data.Backpack, { Fish = record, X = spot.X, Y = spot.Y, R = spot.R })
			else
				table.insert(data.Storage, record)
				overflow = true
			end
		end
	end
	return data, overflow
end

-- Repack an old wide patrol hold once. Install the larger engine first, then
-- pack large fish before small ones. Overflow stays recoverable on storage racks.
function Data.migratePatrolHold(data, layout, species)
	local grid = cargo()
	local items = copy(layout.StarterParts)
	local fish = {}
	-- Preserve paid upgrades from the previous hold before packing fish.
	if data.PatrolHoldVersion == 2 then
		local starters = {}
		for _, part in layout.StarterParts do
			starters[part.PartId] = (starters[part.PartId] or 0) + 1
		end
		for _, item in data.Holds.PatrolBoat do
			if item.PartId then
				if (starters[item.PartId] or 0) > 0 then
					starters[item.PartId] -= 1
				else
					local spot = grid.bestSpot(layout.Hold, items, item, species)
					assert(spot, "Patrol upgrade does not fit in migrated hold")
					table.insert(items, { PartId = item.PartId, X = spot.X, Y = spot.Y, R = spot.R })
				end
			end
		end
	end
	for index, item in data.Holds.PatrolBoat do
		if item.Fish then
			table.insert(fish, { Item = item, Index = index, Area = #grid.cells(grid.shape(item, species)) })
		end
	end
	table.sort(fish, function(a, b)
		return if a.Area == b.Area then a.Index < b.Index else a.Area > b.Area
	end)
	for _, entry in fish do
		local item = entry.Item
		local spot = grid.bestSpot(layout.Hold, items, item, species)
		if spot then
			table.insert(items, { Fish = item.Fish, X = spot.X, Y = spot.Y, R = spot.R })
		else
			table.insert(data.Storage, item.Fish)
		end
	end
	data.Holds.PatrolBoat = items
	data.PatrolHoldVersion = layout.HoldVersion
end

-- A hold that has never been opened starts with the boat's own kit aboard.
function Data.hold(raw, boatId, layout)
	return copy(raw.Holds and raw.Holds[boatId] or layout.StarterParts or {})
end

-- Moves one fish or boat part. `from` is "Hand" or an index into the hold; `to` is
-- "Hand", "Release" (back into the water) or { X, Y, R } in the hold. `layout` is
-- the boat's catalog entry, or nil when no hold is in reach. Returns nil and a
-- player-facing reason when the move is not allowed. With backpack=true, the
-- same placement rules operate on Backpack using its catalog layout.
function Data.moveCargo(raw, boatId, layout, from, to, species, backpack)
	local data = Data.decode(raw)
	local items = if backpack then data.Backpack elseif layout then Data.hold(data, boatId, layout) else nil
	local item, index
	if from == "Hand" then
		if not data.Hand then
			return nil, "Your hands are empty."
		end
		item = { Fish = data.Hand }
	elseif type(from) == "number" and items and items[from] then
		item, index = items[from], from
	elseif type(from) == "number" then
		return nil, if items then "That item is no longer in the hold." else "Your boat's hold is out of reach."
	else
		return nil, "That item can't be moved."
	end
	if to == "Release" or to == "Hand" then
		if item.PartId then
			return nil, "Boat parts stay in the hold."
		elseif to == "Hand" and data.Hand then
			return nil, "Your hands are already full."
		end
		if index then
			table.remove(items, index)
		end
		if to == "Hand" then
			data.Hand = item.Fish
		elseif from == "Hand" then
			data.Hand = nil
		end
	elseif type(to) == "table" then
		if not items then
			return nil, "Your boat's hold is out of reach."
		end
		local x, y, r = to.X, to.Y, to.R
		if not (cell(x) and cell(y) and number(r, true) and r <= 3) then
			return nil, "That isn't a spot in the hold."
		end
		local grid = cargo()
		local taken = grid.occupied(items, species, index)
		if not grid.fits(layout.Hold, taken, grid.shape(item, species), x, y, r) then
			return nil, "It doesn't fit there."
		end
		local placed = { Fish = item.Fish, PartId = item.PartId, Locked = item.Locked, X = x, Y = y, R = r }
		if index then
			items[index] = placed
		else
			table.insert(items, placed)
			data.Hand = nil
		end
	else
		return nil, "That item can't go there."
	end
	if backpack then
		data.Backpack = items
	elseif items then
		data.Holds[boatId] = items
	end
	return Data.decode(data)
end

-- Places a newly fitted boat part at the exact hold spot the player picked.
-- The caller has already checked the upgrade limit; this only enforces the grid.
function Data.placePart(raw, boatId, layout, partId, x, y, r, species)
	local data = Data.decode(raw)
	local grid = cargo()
	local part = grid.Parts[partId]
	local items = Data.hold(data, boatId, layout)
	if not part then
		return nil, "That boat part is not available."
	elseif not (cell(x) and cell(y) and number(r, true) and r <= 3) then
		return nil, "That isn't a spot in the hold."
	end
	local taken = grid.occupied(items, species)
	if not grid.fits(layout.Hold, taken, part.Shape, x, y, r) then
		return nil, "It doesn't fit there."
	end
	table.insert(items, { PartId = partId, X = x, Y = y, R = r })
	data.Holds[boatId] = items
	return Data.decode(data)
end

-- Packs every fish from the boat hold that fits into the backpack, largest first,
-- and leaves boat parts and any fish that no longer fit behind. Returns nil and a
-- player-facing reason when nothing could be moved.
function Data.moveAllToBackpack(raw, boatId, layout, backpackLayout, species)
	local data = Data.decode(raw)
	local items = Data.hold(data, boatId, layout)
	local backpack = data.Backpack or {}
	local grid = cargo()
	local fish = {}
	for index, item in items do
		if item.Fish then
			table.insert(fish, { Item = item, Index = index, Area = #grid.cells(grid.shape(item, species)) })
		end
	end
	if #fish == 0 then
		return nil, "Your boat's hold has no fish to move."
	end
	table.sort(fish, function(a, b)
		return if a.Area == b.Area then a.Index < b.Index else a.Area > b.Area
	end)
	local taken = {}
	for _, entry in fish do
		local spot = grid.bestSpot(backpackLayout.Hold, backpack, { Fish = entry.Item.Fish }, species)
		if spot then
			table.insert(backpack, {
				Fish = entry.Item.Fish,
				Locked = entry.Item.Locked,
				X = spot.X,
				Y = spot.Y,
				R = spot.R,
			})
			taken[entry.Item] = true
		end
	end
	local moved = 0
	local remaining = {}
	for _, item in items do
		if taken[item] then
			moved += 1
		else
			table.insert(remaining, item)
		end
	end
	if moved == 0 then
		return nil, "No room in your backpack for those fish."
	end
	data.Backpack = backpack
	data.Holds[boatId] = remaining
	return Data.decode(data), moved
end

-- Locking is specific to the fish's current backpack entry.
function Data.setBackpackLock(raw, index, locked, expected)
	local data = Data.decode(raw)
	local item = data.Backpack[index]
	if
		not item
		or type(locked) ~= "boolean"
		or type(expected) ~= "table"
		or item.X ~= expected.X
		or item.Y ~= expected.Y
		or item.Fish.FishId ~= expected.FishId
		or item.Fish.Kg ~= expected.Kg
		or item.Fish.CaughtAt ~= expected.CaughtAt
	then
		return nil, "That fish is no longer in that backpack spot."
	end
	item.Locked = if locked then true else nil
	return data
end

-- Called within the catch's save, so the fish never needs a second transaction.
function Data.autoStore(raw, boatId, layout, species)
	if not raw.Hand or not layout then
		return raw, false
	end
	local items = Data.hold(raw, boatId, layout)
	local placement = cargo().bestSpot(layout.Hold, items, { Fish = raw.Hand }, species)
	if not placement then
		return raw, false
	end
	local moved = Data.moveCargo(raw, boatId, layout, "Hand", placement, species)
	return moved or raw, moved ~= nil
end

-- Counted here rather than through the catalog, so inlined test harnesses that
-- never place furniture don't need to resolve it.
local function placed(raw, itemId)
	local count = 0
	for _, entry in raw.Furniture or {} do
		if entry.ItemId == itemId then
			count += 1
		end
	end
	return count
end

-- The built-in cooler and every placed cooler share one packing rule.
function Data.freezerCount(raw)
	return 1 + placed(raw, "Freezer")
end

local freezerLayouts = setmetatable({}, { __mode = "k" })
function Data.freezerLayout(raw, extra)
	local packing, models = freezerModules()
	local count = Data.freezerCount(raw)
	local frozen = raw.Freezer or {}
	local cached = freezerLayouts[frozen]
	if not extra and cached and cached.Count == count and cached.Length == #frozen then
		return cached.Layout, cached.Fits, cached.Used
	end
	local records = table.clone(frozen)
	if extra then
		table.insert(records, extra)
	end
	local layout, fits, used = packing.layout(records, count, models.catchBounds)
	if not extra then
		freezerLayouts[frozen] = { Count = count, Length = #frozen, Layout = layout, Fits = fits, Used = used }
	end
	return layout, fits, used
end

function Data.canFreeze(raw, record)
	local _, fits = Data.freezerLayout(raw, record)
	return fits
end

function Data.freezerUsage(raw)
	local _, fits, used = Data.freezerLayout(raw)
	return if fits then math.clamp(math.floor(used * 100 + 0.5), 0, 100) else 100
end

-- Racks at home and on the company plot share one pool of stored fish.
function Data.storageCapacity(raw)
	local count = 0
	for _, list in { raw.Furniture or {}, raw.CompanyFurniture or {} } do
		for _, entry in list do
			if entry.ItemId == "StorageRack" and entry.Mode ~= "Tools" then count += 1 end
		end
	end
	return Data.RACK_CAPACITY * count
end

-- The placed company bench holding saved bench key `key`, if any.
local function companyBench(data, key)
	for _, entry in data.CompanyFurniture or {} do
		if entry.ItemId == "CompanyPrep" and entry.Key == key then
			return entry
		end
	end
	return nil
end

-- Fish still waiting to be stocked: hand, backpack, racks, old cooler and holds.
function Data.unstocked(raw)
	local count = (if raw.Hand then 1 else 0) + #raw.Cooler + #(raw.Storage or {}) + #(raw.Backpack or {})
	for _, items in raw.Holds do
		for _, item in items do
			if item.Fish then
				count += 1
			end
		end
	end
	return count
end

-- Stock the equipped hand fish and every unlocked backpack fish that fits.
function Data.stockFreezer(raw, includeHand)
	local data = Data.decode(raw)
	local moved = 0
	if includeHand ~= false and data.Hand and Data.canFreeze(data, data.Hand) then
		table.insert(data.Freezer, data.Hand)
		data.Hand = nil
		moved += 1
	end
	local index = 1
	while index <= #data.Backpack do
		local item = data.Backpack[index]
		if not item.Locked and Data.canFreeze(data, item.Fish) then
			table.insert(data.Freezer, item.Fish)
			table.remove(data.Backpack, index)
			moved += 1
		else
			index += 1
		end
	end
	return data, moved
end

local function sameFish(a, b)
	return a.FishId == b.FishId
		and a.Kg == b.Kg
		and a.CaughtAt == b.CaughtAt
		and a.Value == b.Value
		and a.Mutation == b.Mutation
		and a.Size == b.Size
end

-- A porter carries a display copy. Only delivery changes the saved inventory,
-- so a disconnect, full freezer or a player moving that fish cannot lose it.
-- With `toStorage` the fish goes onto a storage rack instead of the freezer.
function Data.unloadFish(raw, boatId, index, record, toStorage)
	local data = Data.decode(raw)
	local items = data.Holds[boatId]
	local item = items and items[index]
	local shelf = if toStorage then data.Storage else data.Freezer
	if not item or not item.Fish or not sameFish(item.Fish, record) then
		return nil
	end
	if
		(toStorage and #shelf >= Data.storageCapacity(data)) or (not toStorage and not Data.canFreeze(data, item.Fish))
	then
		return nil
	end
	table.insert(shelf, item.Fish)
	table.remove(items, index)
	return data
end

function Data.unloadFishToKitchenStorage(raw, boatId, index, record, catalogFish)
	local data = Data.decode(raw)
	local items = data.Holds[boatId]
	local item = items and items[index]
	if not item or not item.Fish or not sameFish(item.Fish, record) then
		return nil
	end
	if not Data.canKitchenStorageAccept(data, item.Fish, catalogFish) then
		return nil
	end
	table.insert(data.KitchenStorage.Fish, item.Fish)
	table.remove(items, index)
	return data
end

function Data.restockFishToKitchenStorage(raw, record, catalogFish)
	local data = Data.decode(raw)
	for index, stored in data.Storage do
		if sameFish(stored, record) then
			if not Data.canKitchenStorageAccept(data, stored, catalogFish) then
				return nil
			end
			table.remove(data.Storage, index)
			table.insert(data.KitchenStorage.Fish, stored)
			return data
		end
	end
	return nil
end

-- The carried fish and every unlocked backpack fish go onto the storage racks
-- until they are full, like stocking a freezer.
function Data.storeFish(raw, includeHand)
	local data = Data.decode(raw)
	local capacity = Data.storageCapacity(data)
	local moved = 0
	if includeHand ~= false and data.Hand then
		if capacity == 0 then
			return nil, "Place a storage rack in your storage room first."
		elseif #data.Storage >= capacity then
			return nil, "Your storage racks are full."
		end
		table.insert(data.Storage, data.Hand)
		data.Hand = nil
		moved += 1
	end
	local index = 1
	while index <= #data.Backpack and #data.Storage < capacity do
		local item = data.Backpack[index]
		if not item.Locked then
			table.insert(data.Storage, item.Fish)
			table.remove(data.Backpack, index)
			moved += 1
		else
			index += 1
		end
	end
	if moved == 0 then
		if capacity == 0 then
			return nil, "Place a storage rack in your storage room first."
		elseif #data.Storage >= capacity then
			return nil, "Your storage racks are full."
		end
		for _, item in data.Backpack do
			if item.Locked then
				return nil, "Your backpack fish are locked. Right-click a fish to unlock it."
			end
		end
		return nil, "Equip a fish from your hotbar first."
	end
	return data, moved
end

-- The oldest stored fish goes back into the angler's hand.
function Data.takeStored(raw)
	local data = Data.decode(raw)
	if data.Hand then
		return nil, "Your hands are already full."
	elseif #data.Storage == 0 then
		return nil, "Your storage racks are empty."
	end
	data.Hand = table.remove(data.Storage, 1)
	return data
end

-- A porter moves one stored fish into a freezer with room.
function Data.restockFish(raw, record)
	local data = Data.decode(raw)
	if not Data.canFreeze(data, record) then
		return nil
	end
	for index, stored in data.Storage do
		if sameFish(stored, record) then
			table.insert(data.Freezer, table.remove(data.Storage, index))
			return data
		end
	end
	return nil
end

-- The caller charges the price in the same profile transaction.
function Data.buyFurniture(raw, itemId)
	local data = Data.decode(raw)
	if not furniture().Items[itemId] then
		return nil, "That isn't for sale."
	end
	data.FurnitureStock[itemId] = (data.FurnitureStock[itemId] or 0) + 1
	return data
end

-- Placed furniture on a site: "Company" is the island plot, anything else the house.
local function siteList(data, site)
	return if site == "Company" then data.CompanyFurniture else data.Furniture
end

-- Places a bought item (`from` is an item id) or moves a placed one (`from` is
-- its index in the site's list) on `site` (see siteList).
function Data.placeFurniture(raw, from, x, z, r, site)
	local data = Data.decode(raw)
	local catalog = furniture()
	if site == "Company" and not data.CompanyIsland then
		return nil, "Buy a company island first."
	end
	local list = siteList(data, site)
	local itemId, skip
	if type(from) == "number" then
		local entry = list[from]
		if not entry then
			return nil, "That furniture is no longer placed."
		end
		itemId, skip = entry.ItemId, from
	elseif type(from) == "string" and catalog.Items[from] then
		itemId = from
		if (data.FurnitureStock[itemId] or 0) < 1 then
			return nil, if catalog.Items[itemId].Kit then "That comes with a company island." else "Buy one at the furniture shop first."
		elseif catalog.count(list, itemId) >= catalog.Items[itemId].MaxPlaced then
			return nil, string.format("You can place up to %d of those.", catalog.Items[itemId].MaxPlaced)
		end
	else
		return nil, "That isn't furniture."
	end
	local locked = catalog.locked(itemId, data.Paths.Unlocked)
	if locked then
		return nil, locked
	end
	local reason = catalog.check(list, itemId, x, z, r, skip, site)
	if reason then
		return nil, reason
	end
	local placed = if skip then table.clone(list[skip]) else { ItemId = itemId }
	placed.X, placed.Z, placed.R = x, z, r
	if skip then
		list[skip] = placed
	else
		if itemId == "CompanyPrep" then
			for _, key in Data.COMPANY_BENCHES do
				if not companyBench(data, key) then
					placed.Key = key
					break
				end
			end
		end
		data.FurnitureStock[itemId] -= 1
		if data.FurnitureStock[itemId] == 0 then
			data.FurnitureStock[itemId] = nil
		end
		table.insert(list, placed)
	end
	if data.FurnitureWallMigrationPending then migrateFurnitureWalls(data, true) end
	return data
end

-- Puts a placed item back in stock, unless the fish it holds would have nowhere to go.
function Data.pickUpFurniture(raw, index, site)
	local data = Data.decode(raw)
	local list = siteList(data, site)
	local entry = type(index) == "number" and list[index]
	if not entry then
		return nil, "That furniture is no longer placed."
	end
	if entry.ItemId == "StorageRack" and ((entry.Cages or 0) + (entry.Nets or 0) > 0) then
		return nil, "Take the tools off this rack first."
	end
	table.remove(list, index)
	if entry.ItemId == "Freezer" and not Data.canFreeze(data) then
		return nil, "Sell some fish first. They wouldn't fit in your other freezers."
	elseif #data.Storage > Data.storageCapacity(data) then
		return nil, "Take some fish off your racks first."
	elseif #data.Pantry > Data.pantryCapacity(data) then
		return nil, "Sell some dishes first. They wouldn't fit in your other display cases."
	elseif entry.ItemId == "KitchenStorage" and #data.KitchenStorage.Fish > 0 then
		return nil, "Take the fish off your kitchen storage table first."
	elseif data.Kitchen[entry.Key or entry.ItemId] then
		return nil, "Collect the dish on this station first."
	end
	data.FurnitureStock[entry.ItemId] = (data.FurnitureStock[entry.ItemId] or 0) + 1
	if data.FurnitureWallMigrationPending then migrateFurnitureWalls(data, true) end
	return data
end

-- Configure one rack and transfer equipment to or from carried stock.
function Data.editRack(raw, index, action, site)
	local data = Data.decode(raw)
	local rack = type(index) == "number" and siteList(data, site)[index]
	if not rack or rack.ItemId ~= "StorageRack" then return nil, "Select a storage rack." end
	if action == "Mode" then
		if rack.Mode == "Tools" then
			if (rack.Cages or 0) + (rack.Nets or 0) > 0 then return nil, "Take the tools off this rack first." end
			rack.Mode = nil
		else
			rack.Mode = "Tools"
			if #data.Storage > Data.storageCapacity(data) then return nil, "Take some fish off your racks first." end
		end
	elseif rack.Mode == "Tools" then
		local field, stock
		if action == "AddCage" or action == "TakeCage" then field, stock = "Cages", data.CrabCages
		elseif action == "AddNet" or action == "TakeNet" then field, stock = "Nets", data.MusselNets
		else return nil, "Unknown rack action." end
		if string.sub(action, 1, 3) == "Add" then
			if stock.Stock < 1 then return nil, "You have none of those to store." end
			if (rack.Cages or 0) + (rack.Nets or 0) >= Data.RACK_CAPACITY then return nil, "This rack is full." end
			stock.Stock -= 1
			rack[field] = (rack[field] or 0) + 1
		else
			if (rack[field] or 0) < 1 then return nil, "There are none of those on this rack." end
			if stock.Stock >= 25 then return nil, "Your carried stock is full." end
			stock.Stock += 1
			rack[field] -= 1
		end
	else return nil, "Switch this rack to tools storage first." end
	return data
end

-- A customer pays the fish's value. Returns nil when that fish is no longer frozen;
-- the caller credits Cash in the same profile transaction.
function Data.sellFrozen(raw, record)
	local data = Data.decode(raw)
	for index, frozen in data.Freezer do
		if sameFish(frozen, record) then
			table.remove(data.Freezer, index)
			local price = math.max(1, math.floor(frozen.Value))
			data.Stats.CoinsEarned += price
			data.Stats.FishSold += 1
			return data, price
		end
	end
	return nil, 0
end

-- Pirate Cove's galley buys straight from the hand, then the backpack, up to `limit` fish on `day`
-- (counting what was already sold that day). Locked fish stay. `onlyHand` sells just the held fish.
function Data.sellToCove(raw, day, limit, onlyHand)
	local data = Data.decode(raw)
	local sales = data.CoveSales
	if not sales or sales.Day ~= day then
		sales = { Day = day, Count = 0 }
	end
	local sold, earned = 0, 0
	local function sell(record)
		local price = math.max(1, math.floor(record.Value))
		sold += 1
		earned += price
		data.Stats.CoinsEarned += price
		data.Stats.FishSold += 1
	end
	if data.Hand and sales.Count + sold < limit then
		sell(data.Hand)
		data.Hand = nil
	end
	if not onlyHand then
		local kept = {}
		for _, item in data.Backpack do
			if item.Fish and not item.Locked and sales.Count + sold < limit then
				sell(item.Fish)
			else
				table.insert(kept, item)
			end
		end
		data.Backpack = kept
	end
	sales.Count += sold
	data.CoveSales = sales
	return data, sold, earned
end

-- Hands over the first fish `matches` accepts, from the hand, then the backpack (never a locked one).
function Data.deliverFish(raw, matches)
	local data = Data.decode(raw)
	if data.Hand and matches(data.Hand) then
		local record = data.Hand
		data.Hand = nil
		return data, record
	end
	for index, item in data.Backpack do
		if item.Fish and not item.Locked and matches(item.Fish) then
			table.remove(data.Backpack, index)
			return data, item.Fish
		end
	end
	return nil, nil
end

-- The kitchen pass plus every placed food display case.
function Data.pantryCapacity(raw)
	return Data.PANTRY_CAPACITY * (1 + placed(raw, "FoodCase"))
end

-- Takes one particular frozen fish (one no customer is holding) into the empty hand.
function Data.takeFrozen(raw, record)
	local data = Data.decode(raw)
	if data.Hand then
		return nil, "Your hands are already full."
	end
	for index, frozen in data.Freezer do
		if sameFish(frozen, record) then
			data.Hand = table.remove(data.Freezer, index)
			return data
		end
	end
	return nil, "That fish is no longer in your freezer."
end

function Data.sameDish(a, b)
	return a.RecipeId == b.RecipeId
		and a.FishId == b.FishId
		and a.Kg == b.Kg
		and a.Value == b.Value
		and a.MadeAt == b.MadeAt
end

-- Starts cooking the carried fish at a kitchen station. `key` is a built-in bench key
-- or a station's furniture id; `species` is AnglerCatalog.Fish (for the fish's rarity).
-- The fish leaves the hand now and the dish is saved on the station, so it is never lost.
function Data.startCooking(raw, key, recipeId, species, now)
	local data = Data.decode(raw)
	local book = recipes()
	local station = type(key) == "string" and book.stationOf(key)
	if not paths().unlocked(data, "Supermarket") then
		return nil, "Cooking unlocks with the Supermarket path."
	elseif not station then
		return nil, "That isn't a kitchen station."
	elseif book.CompanyBuiltIn[key] and not (data.CompanyIsland and companyBench(data, key)) then
		return nil, if data.CompanyIsland then "Place a prep bench on your company plot first." else "Buy a company island to use this kitchen."
	elseif not book.BuiltIn[key] and not book.CompanyBuiltIn[key] and placed(data, key) == 0 then
		return nil, "Place that station in your processing room first."
	elseif data.Kitchen[key] then
		return nil, "This station is already in use."
	elseif not data.Hand then
		return nil, "Carry a fish to the station first."
	end
	local fish = data.Hand
	local problem = book.problem(recipeId, station, species[fish.FishId] and species[fish.FishId].Rarity)
	if problem then
		return nil, problem
	end
	data.Kitchen[key] = {
		Dish = {
			RecipeId = recipeId,
			FishId = fish.FishId,
			Mutation = fish.Mutation,
			Kg = fish.Kg,
			Value = book.value(recipeId, fish.Value),
			MadeAt = now,
			NeonColor = fish.NeonColor,
		},
		ReadyAt = now + book.Items[recipeId].Seconds,
	}
	data.Hand = nil
	return data
end

-- A finished dish goes from its station onto the kitchen pass.
function Data.collectDish(raw, key, now)
	local data = Data.decode(raw)
	local job = type(key) == "string" and data.Kitchen[key]
	if not job then
		return nil, "Nothing is cooking here."
	elseif now < job.ReadyAt then
		return nil, "It's still cooking."
	elseif #data.Pantry >= Data.pantryCapacity(data) then
		return nil, "Your kitchen pass is full. Sell some dishes or place another food display case."
	end
	table.insert(data.Pantry, job.Dish)
	data.Kitchen[key] = nil
	data.Stats.FoodCooked += 1
	return data
end

-- Each branch unlocks its own hire and its own independently selected recipe.
local function chefProblem(data, role)
	local path = CHEF_PATHS[role]
	if not path then
		return "That isn't a chef."
	elseif not paths().unlocked(data, path) then
		return "Unlock the " .. path .. " path first."
	elseif not data.Staff[role] then
		return "Hire this chef first."
	end
	return nil
end

function Data.setChefRecipe(raw, role, recipeId)
	local data = Data.decode(raw)
	local problem = chefProblem(data, role)
	if problem then
		return nil, problem
	elseif recipeId ~= nil and (type(recipeId) ~= "string" or not recipes().Items[recipeId]) then
		return nil, "Choose a valid recipe."
	end
	data.ChefRecipes[role] = recipeId
	return data
end

-- Reserve the fish and station together in one profile update. The player's hand
-- is never consumed: it is restored after using the same rules as manual cooking.
function Data.startChefCooking(raw, role, key, species, now)
	local data = Data.decode(raw)
	local problem = chefProblem(data, role)
	if problem then
		return nil, problem
	end
	local recipeId = data.ChefRecipes[role]
	local recipe = recipeId and recipes().Items[recipeId]
	if not recipe then
		return nil, "Choose a recipe for this chef."
	end
	local station = type(key) == "string" and recipes().stationOf(key)
	if station ~= recipe.Station then
		return nil, "This recipe needs a different station."
	end
	local index
	for i, fish in data.KitchenStorage.Fish do
		local info = species[fish.FishId]
		if not recipes().problem(recipeId, station, info and info.Rarity) then
			index = i
			break
		end
	end
	if not index then
		return nil, "Kitchen storage needs a suitable fish."
	end
	local hand = data.Hand
	data.Hand = table.remove(data.KitchenStorage.Fish, index)
	local cooked, failure = Data.startCooking(data, key, recipeId, species, now)
	if not cooked then
		return nil, failure
	end
	cooked.Hand = hand
	cooked.Kitchen[key].ChefRole = role
	return cooked
end

function Data.collectChefDish(raw, role, key, now)
	local data = Data.decode(raw)
	local job = type(key) == "string" and data.Kitchen[key]
	if not CHEF_PATHS[role] or not job or job.ChefRole ~= role then
		return nil, "This chef has no dish at that station."
	end
	return Data.collectDish(data, key, now)
end

-- A customer or diner pays for one dish. `multiplier` is 1 in the shop and the
-- restaurant markup for diners; `stat` is the counter the sale adds to.
function Data.sellDish(raw, dish, multiplier, stat)
	local data = Data.decode(raw)
	for index, stocked in data.Pantry do
		if Data.sameDish(stocked, dish) then
			table.remove(data.Pantry, index)
			local price = math.max(1, math.floor(stocked.Value * multiplier))
			data.Stats.CoinsEarned += price
			data.Stats[stat] += 1
			return data, price
		end
	end
	return nil, 0
end

-- Unlocks the next path. The caller checks Shared.Paths.chooseProblem and charges
-- the price in the same profile transaction. The finished stage stays completed and
-- the new one counts its stat goals from here.
function Data.choosePath(raw, stageId, stage)
	local data = Data.decode(raw)
	local path = data.Paths
	path.Completed[path.Active] = true
	path.Unlocked[stageId] = true
	path.Active = stageId
	path.Baseline = copy(data.Stats)
	for itemId, count in stage.Grants or {} do
		data.FurnitureStock[itemId] = (data.FurnitureStock[itemId] or 0) + count
	end
	return Data.decode(data)
end

-- Receipt and credit commit together in the wallet transaction, once per purchase.
function Data.grantPathSkip(raw, purchaseId)
	assert(type(purchaseId) == "string" and #purchaseId > 0, "Invalid path skip receipt")
	local data = Data.decode(raw)
	if not data.Paths.SkipReceipts[purchaseId] then
		data.Paths.SkipReceipts[purchaseId] = true
		data.Paths.SkipCredits += 1
	end
	return Data.decode(data)
end

-- The caller validates Paths.skipProblem against the whole current wallet first.
function Data.usePathSkip(raw, stageId)
	local data = Data.decode(raw)
	local path = data.Paths
	assert(path.Active == stageId and not path.Completed[stageId], "Path already finished or changed")
	assert(path.SkipCredits > 0, "No purchased quest skip available")
	path.SkipCredits -= 1
	path.Completed[stageId] = true
	path.SkipTarget = nil
	return Data.decode(data)
end

-- Stows one fish the hired fisherman landed into his boat's hold. Returns nil when
-- the hold has no room left for it.
function Data.fishermanCatch(raw, boatId, layout, roll, caughtAt, species, mutations)
	local data = Data.decode(raw)
	local traits = roll.Traits or {}
	local mutation = traits.Mutation or "Normal"
	local record =
		catchRecord(roll.FishId, mutation, roll.Kg, roll.Value, caughtAt, species, mutations, roll.Size, traits)
	local items = Data.hold(data, boatId, layout)
	local placement = cargo().bestSpot(layout.Hold, items, { Fish = record }, species)
	if not placement then
		return nil
	end
	table.insert(items, { Fish = record, X = placement.X, Y = placement.Y, R = placement.R })
	data.Holds[boatId] = items
	data.Stats.FishermanCatches += 1
	return Data.decode(data)
end

-- The trawler's stern net lands fish straight into the hold, but they still
-- count in the bestiary, XP and findings like any other catch. Returns nil when
-- the hold has no room, so a full boat never awards the fish.
function Data.netCatch(raw, boatId, layout, roll, caughtAt, species, mutations, doubleXP)
	local data = Data.decode(raw)
	local traits = roll.Traits or {}
	local mutation = traits.Mutation or "Normal"
	local record =
		catchRecord(roll.FishId, mutation, roll.Kg, roll.Value, caughtAt, species, mutations, roll.Size, traits)
	local items = Data.hold(data, boatId, layout)
	local placement = cargo().bestSpot(layout.Hold, items, { Fish = record }, species)
	if not placement then
		return nil
	end
	table.insert(items, { Fish = record, X = placement.X, Y = placement.Y, R = placement.R })
	data.Holds[boatId] = items
	registerCatch(data, record, species, doubleXP)
	return Data.decode(data)
end

-- Run inside the same wallet UpdateAsync as the award. Retried callbacks derive
-- deltas from the saved record, never from an in-memory leaderboard snapshot.
function Data.trackProgress(previous, current, now)
	local before = Data.decode(previous)
	local data = Data.decode(current)
	local start = Data.weekStart(now)
	local weekly = if before.Weekly and before.Weekly.Start == start
		then copy(before.Weekly)
		else { Start = start, XP = 0, Caught = 0, Earned = 0 }
	for weeklyKey, stat in { XP = "TotalXP", Caught = "TotalCaught", Earned = "CoinsEarned" } do
		weekly[weeklyKey] += math.max(0, data.Stats[stat] - before.Stats[stat])
	end
	data.Weekly = weekly
	return Data.decode(data)
end

function Data.scores(raw, now)
	local data = Data.decode(raw)
	local start = Data.weekStart(now)
	local weekly = if data.Weekly and data.Weekly.Start == start then data.Weekly else {}
	return {
		Level = Data.level(data.Stats.TotalXP),
		Caught = data.Stats.TotalCaught,
		Earned = data.Stats.CoinsEarned,
		WeeklyXP = weekly.XP or 0,
		WeeklyCaught = weekly.Caught or 0,
		WeeklyEarned = weekly.Earned or 0,
	},
		start
end
Data.KITCHEN_STORAGE_CAPACITY = 8
local KITCHEN_RARITIES = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythical", "Exotic", "Divine", "Limited" }

function Data.setKitchenStorageTargets(raw, targets)
	local data = Data.decode(raw)
	local total = 0
	local clean = {}
	for _, rarity in KITCHEN_RARITIES do
		local count = tonumber(targets and targets[rarity]) or 0
		count = math.max(0, math.floor(count))
		clean[rarity] = count
		total += count
	end
	if total > Data.KITCHEN_STORAGE_CAPACITY then
		return nil, "Kitchen storage can hold at most " .. Data.KITCHEN_STORAGE_CAPACITY .. " fish."
	end
	data.KitchenStorage.Targets = clean
	return data
end

function Data.takeKitchenStorageFish(raw, fishIndex)
	local data = Data.decode(raw)
	if data.Hand then
		return nil, "Your hands are already full."
	end
	local count = #data.KitchenStorage.Fish
	if count == 0 then
		return nil, "Kitchen storage is empty."
	end
	local idx = fishIndex or count
	local fish = table.remove(data.KitchenStorage.Fish, idx)
	if not fish then
		return nil, "That fish is no longer in kitchen storage."
	end
	data.Hand = fish
	return data, fish
end

function Data.neededKitchenStorage(data, catalogFish)
	local targets = data.KitchenStorage.Targets or {}
	local current = {}
	for _, fish in data.KitchenStorage.Fish or {} do
		local spec = catalogFish and catalogFish[fish.FishId]
		local r = spec and spec.Rarity or "Common"
		current[r] = (current[r] or 0) + 1
	end
	local needed = {}
	local totalCurrent = #(data.KitchenStorage.Fish or {})
	local totalRoom = math.max(0, Data.KITCHEN_STORAGE_CAPACITY - totalCurrent)
	for _, rarity in KITCHEN_RARITIES do
		local target = targets[rarity] or 0
		local have = current[rarity] or 0
		if target > have and totalRoom > 0 then
			needed[rarity] = math.min(target - have, totalRoom)
		else
			needed[rarity] = 0
		end
	end
	return needed, totalRoom
end

function Data.canKitchenStorageAccept(data, record, catalogFish)
	if not record then
		return false
	end
	local needed, totalRoom = Data.neededKitchenStorage(data, catalogFish)
	if totalRoom <= 0 then
		return false
	end
	local spec = catalogFish and catalogFish[record.FishId]
	local rarity = spec and spec.Rarity or "Common"
	return (needed[rarity] or 0) > 0
end

function Data.addKitchenStorageFish(raw, record, catalogFish)
	local data = Data.decode(raw)
	if not Data.canKitchenStorageAccept(data, record, catalogFish) then
		return nil, "Kitchen storage cannot accept that fish."
	end
	table.insert(data.KitchenStorage.Fish, record)
	return data
end

function Data.stockKitchenStorageFromStock(raw, catalogFish)
	local data = Data.decode(raw)
	local moved = 0
	local function checkAndMove(list)
		local i = 1
		while i <= #list do
			local record = list[i]
			if Data.canKitchenStorageAccept(data, record, catalogFish) then
				table.remove(list, i)
				table.insert(data.KitchenStorage.Fish, record)
				moved += 1
			else
				i += 1
			end
		end
	end
	checkAndMove(data.Freezer)
	checkAndMove(data.Storage)
	return data, moved
end

return Data
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="130">
        <Properties>
          <string name="Name">AnglerService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")
local MarketplaceService = game:GetService("MarketplaceService")
local BoatService = require(script.Parent.BoatService)
local Data = require(script.Parent.AnglerData)
local GamepassService = require(script.Parent.GamepassService)
local Aboard = require(ReplicatedStorage.Shared.Aboard)
local BoatCatalog = require(ReplicatedStorage.Shared.BoatCatalog)
local BackpackCatalog = require(ReplicatedStorage.Shared.BackpackCatalog)
local Catalog = require(ReplicatedStorage.Shared.AnglerCatalog)
local FishingRanks = require(ReplicatedStorage.Shared.FishingRanks)
local Paths = require(ReplicatedStorage.Shared.Paths)
local StaffCatalog = require(ReplicatedStorage.Shared.StaffCatalog)
local ShopUpgrades = require(ReplicatedStorage.Shared.ShopUpgrades)
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))
local Service = {}
local started = false
local requests = {}
-- No active codes have been configured yet.
local codes = {}

-- Call only after server gameplay has validated and awarded a catch. Never remote-exposed.
function Service.recordCatch(
	player: Player,
	fishId: string,
	mutation: string,
	kg: number,
	value: number,
	size: string?,
	traits: { NeonColor: string?, Corruptions: { string }? }?,
	perfectCatch: boolean?
)
	local caughtAt = os.time()
	local ownsAutoStore = GamepassService.ownsAutoStore(player)
	local doubleXP = GamepassService.ownsDoubleXP(player)
	local autoStored = false
	local destination
	local count
	local ok, message = BoatService.updateProgress(player, function(profile)
		local emptyHand = profile.Angler.Hand == nil
		local backpackLayout = BackpackCatalog.Items[profile.Angler.BackpackId] or BackpackCatalog.Items.Starter
		profile.Angler, destination = Data.recordCatch(
			profile.Angler,
			fishId,
			mutation,
			kg,
			value,
			caughtAt,
			Catalog.Fish,
			Catalog.Mutations,
			size,
			traits,
			backpackLayout,
			doubleXP,
			nil,
			perfectCatch
		)
		count = profile.Angler.Catches[fishId].Count
		autoStored = false
		if ownsAutoStore and emptyHand then
			local boatId, model = BoatService.activeBoat(player)
			local layout = boatId and BoatCatalog[boatId]
			if layout and Aboard(player.Character, model) then
				profile.Angler, autoStored = Data.autoStore(profile.Angler, boatId, layout, Catalog.Fish)
			end
		end
		if autoStored then
			destination = "Boat"
		end
	end)
	return ok, message, ok and autoStored, if ok then destination else nil, if ok then count else nil
end

function Service.start()
	if started then
		return
	end
	started = true
	GamepassService.start()
	MarketplaceService.ProcessReceipt = function(receipt)
		if receipt.ProductId ~= Paths.SKIP_PRODUCT_ID then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		if not player then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		-- Receipts can arrive before profile loading or during another wallet save.
		-- Roblox does not automatically retry on a timer, so retry transient failures here.
		for attempt = 1, 10 do
			if player.Parent ~= Players then
				break
			end
			local ok = BoatService.updateProgress(player, function(current)
				if current.Angler.Paths.SkipReceipts[receipt.PurchaseId] then
					return
				end
				current.Angler = Data.grantPathSkip(current.Angler, receipt.PurchaseId)
				local target = current.Angler.Paths.SkipTarget
				if target and not Paths.skipProblem(current, target) then
					current.Angler = Data.usePathSkip(current.Angler, target)
				else
					-- A delayed/external purchase stays available instead of skipping a different stage.
					current.Angler.Paths.SkipTarget = nil
				end
			end)
			if ok then
				return Enum.ProductPurchaseDecision.PurchaseGranted
			end
			task.wait(math.min(attempt, 5))
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local remote = Instance.new("RemoteFunction")
	remote.Name, remote.Parent = "AnglerMenu", ReplicatedStorage
	remote.OnServerInvoke = function(player, action, key, value)
		if os.clock() - (requests[player] or -math.huge) < 0.25 then
			return { Ok = false, Message = "Please wait a moment and try again." }
		end
		requests[player] = os.clock()
		local profile = BoatService.getProfile(player)
		if not profile then
			return { Ok = false, Message = "Your progress is still loading or unavailable." }
		end
		local ok, message = true, ""
		local promptProductId
		if action == "Setting" and type(key) == "string" and Data.validSetting(key, value) then
			ok, message = BoatService.updateProgress(player, function(current)
				current.Angler.Settings[key] = value
			end)
		elseif
			action == "Title"
			and type(key) == "string"
			and (key == "" or (Catalog.Titles[key] and profile.Angler.Titles[key]))
		then
			ok, message = BoatService.updateProgress(player, function(current)
				assert(key == "" or current.Angler.Titles[key], "Title is not unlocked")
				current.Angler.EquippedTitle = key
			end)
		elseif action == "ShopSign" then
			if type(key) ~= "string" or #key > 96 then
				return { Ok = false, Message = "Enter a shop name of up to 32 characters." }
			end
			local name = key:match("^%s*(.-)%s*$")
			local length = utf8.len(name)
			if not length or length > 32 or name:find("[%c]") then
				return { Ok = false, Message = "Enter a shop name of up to 32 characters on one line." }
			end
			local filtered = ""
			if name ~= "" then
				local success, result = pcall(function()
					return TextService:FilterStringAsync(name, player.UserId):GetNonChatStringForBroadcastAsync()
				end)
				if not success or type(result) ~= "string" or #result > 96 then
					return { Ok = false, Message = "Could not filter that name. Please try again." }
				end
				filtered = result
			end
			ok, message = BoatService.updateProgress(player, function(current)
				current.Angler.ShopSign = filtered
			end)
			if ok then
				message = if filtered == "" then "Shop sign reset." else "Shop sign updated."
			end
		elseif action == "HireStaff" then
			local role = if type(key) == "string" then StaffCatalog.Roles[key] else nil
			if not role then
				return { Ok = false, Message = "Choose a staff role from the Staff tab." }
			elseif role.Requires and not Paths.unlocked(profile, role.Requires) then
				return {
					Ok = false,
					Message = "Hiring a " .. role.Name .. " unlocks with " .. Paths.Stages[role.Requires].Name .. ".",
				}
			elseif profile.Angler.Staff[key] then
				return { Ok = false, Message = "You already hired a " .. role.Name .. "." }
			elseif profile.Cash < role.Price then
				return { Ok = false, Message = "You need $" .. role.Price .. " to hire a " .. role.Name .. "." }
			end
			ok, message = BoatService.updateProgress(player, function(current)
				assert(not current.Angler.Staff[key], "Staff already hired")
				assert(not role.Requires or Paths.unlocked(current, role.Requires), "Path is no longer unlocked")
				assert(current.Cash >= role.Price, "Not enough cash to hire staff")
				current.Cash -= role.Price
				current.Angler.Stats.CoinsSpent += role.Price
				current.Angler.Staff[key] = true
			end)
			if ok then
				message = role.Name .. " hired! They will work at your home base."
				if key == "Fisherman" then
					message ..= " Assign him a boat below."
				elseif key == "RestaurantChef" or key == "CompanyChef" then
					message ..= " Choose a recipe below."
				end
			end
		elseif action == "FireStaff" then
			local role = if type(key) == "string" then StaffCatalog.Roles[key] else nil
			if not role or not profile.Angler.Staff[key] then
				return { Ok = false, Message = "That worker is not hired." }
			end
			ok, message = BoatService.updateProgress(player, function(current)
				assert(current.Angler.Staff[key], "Worker is no longer hired")
				current.Angler.Staff[key] = nil
			end)
			if ok then message = role.Name .. " fired." end
		elseif action == "UpgradeWorker" then
			if key ~= "Porter" or not profile.Angler.Staff.Porter then
				return { Ok = false, Message = "Hire a porter first." }
			end
			local level = StaffCatalog.workerLevel(profile.Angler, "Porter")
			local price = StaffCatalog.PorterLevelPrices[level]
			if not price or value ~= level then return { Ok = false, Message = "Worker level changed or is already at maximum." } end
			if profile.Cash < price then return { Ok = false, Message = "Not enough cash." } end
			ok, message = BoatService.updateProgress(player, function(current)
				assert(current.Angler.Staff.Porter and StaffCatalog.workerLevel(current.Angler, "Porter") == level, "Worker level changed")
				assert(current.Cash >= price, "Not enough cash")
				current.Cash -= price
				current.Angler.Stats.CoinsSpent += price
				current.Angler.Upgrades.PorterLevel = level
			end)
			if ok then message = "Porter upgraded to level " .. (level + 1) .. "!" end
		elseif action == "SetChefRecipe" then
			local recipeId = if value == "" then nil else value
			local _, reason = Data.setChefRecipe(profile.Angler, key, recipeId)
			if reason then
				return { Ok = false, Message = reason }
			end
			ok, message = BoatService.updateProgress(player, function(current)
				local updated, failure = Data.setChefRecipe(current.Angler, key, recipeId)
				assert(updated, failure)
				current.Angler = updated
			end)
			if ok then
				message = if recipeId then "Chef recipe updated." else "Chef paused."
			end
		elseif action == "BuyShopUpgrade" then
			if key ~= "SocialMediaAdvertisement" and key ~= "Baskets" then
				return { Ok = false, Message = "Choose a valid shop upgrade." }
			end
			local upgrade = ShopUpgrades[key]
			if (profile.Angler.Upgrades[key] or 0) >= 1 then
				return { Ok = false, Message = "You already own this upgrade." }
			elseif profile.Cash < upgrade.Price then
				return { Ok = false, Message = "You need $" .. upgrade.Price .. " for this upgrade." }
			end
			ok, message = BoatService.updateProgress(player, function(current)
				assert((current.Angler.Upgrades[key] or 0) < 1, "Upgrade already owned")
				assert(current.Cash >= upgrade.Price, "Not enough cash for this upgrade")
				current.Cash -= upgrade.Price
				current.Angler.Stats.CoinsSpent += upgrade.Price
				current.Angler.Upgrades[key] = 1
			end)
			if ok then
				message = if key == "Baskets" then "Baskets unlocked! Customers can buy up to 3 items." else "Social Media Advertisement unlocked! Customers will arrive more often."
			end
		elseif action == "UpgradePorter" then
			local upgrade = if type(key) == "string" then StaffCatalog.PorterUpgrades[key] else nil
			if not upgrade then
				return { Ok = false, Message = "Choose a porter upgrade from the Workers tab." }
			elseif not profile.Angler.Staff.Porter then
				return { Ok = false, Message = "Hire a porter first." }
			end
			local level = StaffCatalog.porterLevel(profile.Angler, key)
			local price = upgrade.Prices[level + 1]
			if not price then
				return { Ok = false, Message = "Porter " .. upgrade.Name .. " is already at maximum level." }
			elseif value ~= level then
				return { Ok = false, Message = "This upgrade changed. Select the next level again." }
			elseif profile.Cash < price then
				return { Ok = false, Message = "You need $" .. price .. " for this upgrade." }
			end
			ok, message = BoatService.updateProgress(player, function(current)
				assert(current.Angler.Staff.Porter, "Hire a porter first")
				assert(StaffCatalog.porterLevel(current.Angler, key) == level, "Upgrade level changed")
				assert(current.Cash >= price, "Not enough cash for this upgrade")
				current.Cash -= price
				current.Angler.Stats.CoinsSpent += price
				current.Angler.Upgrades[key] = level + 1
			end)
			if ok then
				message =
					string.format("Porter %s upgraded to %d %s!", upgrade.Name, upgrade.Values[level + 2], upgrade.Unit)
			end
		elseif action == "PreparePathSkip" then
			local problem = Paths.skipProblem(profile, key)
			if problem then
				return { Ok = false, Message = problem }
			end
			local usedCredit = false
			ok, message = BoatService.updateProgress(player, function(current)
				local failure = Paths.skipProblem(current, key)
				assert(not failure, failure)
				usedCredit = current.Angler.Paths.SkipCredits > 0
				if usedCredit then
					current.Angler = Data.usePathSkip(current.Angler, key)
				else
					-- Persist the intended stage before opening the Roblox purchase prompt.
					current.Angler.Paths.SkipTarget = key
				end
			end)
			if ok then
				promptProductId = if usedCredit then nil else Paths.SKIP_PRODUCT_ID
				message = (if usedCredit then "Quests skipped! " else "") .. Paths.skipWarning(profile)
			end
		elseif action == "ChoosePath" then
			local problem = Paths.chooseProblem(profile, key)
			if problem then
				return { Ok = false, Message = problem }
			end
			local stage = Paths.Stages[key]
			ok, message = BoatService.updateProgress(player, function(current)
				local failure = Paths.chooseProblem(current, key)
				assert(not failure, failure)
				current.Cash -= stage.Price
				current.Angler.Stats.CoinsSpent += stage.Price
				current.Angler = Data.choosePath(current.Angler, key, stage)
			end)
			if ok then
				message = stage.Name .. " is open! Check the Paths tab for your new goals."
			end
		elseif action == "AssignBoat" then
			local spec = if type(key) == "string" then BoatCatalog[key] else nil
			if not profile.Angler.Staff.Fisherman then
				return { Ok = false, Message = "Hire a fisherman first." }
			elseif not spec or not profile.OwnedBoats[key] then
				return { Ok = false, Message = "Choose one of your own boats." }
			elseif profile.Angler.FishermanBoat == key then
				return { Ok = false, Message = "Your fisherman already sails the " .. spec.Name .. "." }
			end
			local activeId = BoatService.activeBoat(player)
			if activeId == key and not BoatService.stowBoat(player, key) then
				return { Ok = false, Message = "Everyone must leave your " .. spec.Name .. " before he can take it." }
			end
			ok, message = BoatService.updateProgress(player, function(current)
				assert(current.OwnedBoats[key] and current.Angler.Staff.Fisherman, "Boat is not available")
				current.Angler.FishermanBoat = key
			end)
			if ok then
				message = "Your fisherman takes the " .. spec.Name .. " out from your dock."
			end
		elseif action == "Code" then
			if type(key) ~= "string" or #key > 64 then
				return { Ok = false, Message = "Enter a valid code." }
			end
			local code = string.upper(key:match("^%s*(.-)%s*$"))
			local reward = codes[code]
			if not reward then
				return { Ok = false, Message = "This code is not active." }
			end
			if profile.Angler.RedeemedCodes[code] then
				return { Ok = false, Message = "You already redeemed this code." }
			end
			ok, message = BoatService.updateProgress(player, function(current)
				assert(not current.Angler.RedeemedCodes[code], "Code already redeemed")
				current.Angler.RedeemedCodes[code] = true
				current.Cash += reward
				current.Angler.Stats.CoinsEarned += reward
			end)
		elseif action ~= "Get" then
			return { Ok = false, Message = "That menu action is unavailable." }
		end
		local current = BoatService.getProfile(player)
		return {
			Ok = ok,
			Message = message,
			PromptProductId = promptProductId,
			Profile = current,
			FreezerUsage = if current then Data.freezerUsage(current.Angler) else 0,
			PantryCapacity = if current then Data.pantryCapacity(current.Angler) else 0,
		}
	end
	local function bind(player)
		local function updateTitle()
			local character = player.Character
			local head = character and character:FindFirstChild("Head")
			if not head then
				return
			end
			local current = BoatService.getProfile(player)
			local title = current and Catalog.Titles[current.Angler.EquippedTitle]
			local level = math.max(0, math.floor(player:GetAttribute("Level") or 0))
			local rank = FishingRanks.forLevel(level)
			local billboard = head:FindFirstChild("AnglerTitle")
			if not billboard then
				billboard = Instance.new("BillboardGui")
				billboard.Name, billboard.Size = "AnglerTitle", UDim2.fromOffset(360, 84)
				billboard.StudsOffset, billboard.MaxDistance = Vector3.new(0, 2.5, 0), 80
				billboard.Adornee = head
				for _, row in { { "Title", 0, 24 }, { "Rank", 24, 30 }, { "PlayerName", 54, 30 } } do
					local label = Instance.new("TextLabel")
					label.Name = row[1]
					label.Position, label.Size = UDim2.fromOffset(0, row[2]), UDim2.new(1, 0, 0, row[3])
					label.BackgroundTransparency = 1
					label.Font = if row[1] == "Rank" then Enum.Font.SourceSansBold else Enum.Font.SourceSans
					label.TextSize, label.TextColor3 = 24, Color3.new(1, 1, 1)
					label.TextStrokeColor3, label.TextStrokeTransparency = Color3.new(0, 0, 0), 0
					label.Parent = billboard
				end
				local titleLabel = billboard.Title
				titleLabel.Font, titleLabel.TextSize = Enum.Font.GothamBold, 15
				Theme.text(titleLabel)
				billboard.Parent = head
			end
			billboard.Rank.Text = string.format("[%d] %s", level, rank.Name)
			billboard.Rank.TextColor3 = rank.Color
			billboard.PlayerName.Text = player.DisplayName
			local hasTitle = title ~= nil and current.Angler.Titles[current.Angler.EquippedTitle] == true
			billboard.Title.Visible = hasTitle
			billboard.Title.Text = if hasTitle then title.Name else ""
		end
		player:GetAttributeChangedSignal("AnglerRevision"):Connect(updateTitle)
		player:GetAttributeChangedSignal("Level"):Connect(updateTitle)
		player:GetPropertyChangedSignal("DisplayName"):Connect(updateTitle)
		local function characterAdded(character)
			local humanoid = character:WaitForChild("Humanoid", 10)
			if not humanoid then
				return
			end
			character:WaitForChild("Head", 10)
			if player.Character ~= character then
				return
			end
			-- The custom name row replaces Roblox's default overhead display.
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			updateTitle()
			humanoid.Died:Once(function()
				-- Retry a concurrent purchase without discarding a death or resetting saved progress.
				for attempt = 1, 4 do
					if player.Parent ~= Players then
						return
					end
					local ok = BoatService.updateProgress(player, function(current)
						current.Angler.Stats.Deaths += 1
						current.Angler.Stats.CatchStreak = 0
					end)
					if ok then
						return
					end
					task.wait(attempt)
				end
			end)
		end
		player.CharacterAdded:Connect(characterAdded)
		if player.Character then
			task.spawn(characterAdded, player.Character)
		end
	end
	Players.PlayerAdded:Connect(bind)
	Players.PlayerRemoving:Connect(function(player)
		requests[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(bind, player)
	end
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="131">
        <Properties>
          <string name="Name">BackpackService</string>
          <string name="Source"><![CDATA[-- Plaza purchases use the same wallet transaction as all other progress.
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local BoatService = require(script.Parent.BoatService)
local Backpacks = require(ReplicatedStorage.Shared.BackpackCatalog)
local Models = require(ReplicatedStorage.Shared.BackpackModels)
local Service = {}
local started = false
local requests = {}

local function atShop(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return false
	end
	for _, shop in CollectionService:GetTagged("BackpackShop") do
		local counter = shop:FindFirstChild("Counter")
		local prompt = counter and counter:FindFirstChild("BrowseBackpacksPrompt")
		if
			shop:IsDescendantOf(workspace)
			and prompt
			and prompt.Enabled
			and (root.Position - counter.Position).Magnitude <= prompt.MaxActivationDistance + 2
		then
			return true
		end
	end
	return false
end

local function state(player)
	local profile = BoatService.getProfile(player)
	return if profile then { Cash = profile.Cash, BackpackId = profile.Angler.BackpackId } else nil
end

local function problem(profile, id)
	local item = if type(id) == "string" then Backpacks.Items[id] else nil
	if not item then
		return "Choose a backpack from the store."
	end
	if Backpacks.rank(id) <= Backpacks.rank(profile.Angler.BackpackId) then
		return "You already have this backpack or a larger one."
	end
	if profile.Cash < item.Price then
		return "You need $" .. item.Price .. " for this backpack."
	end
	return nil
end

local function syncAppearance(player, force)
	local profile = BoatService.getProfile(player)
	local character = player.Character
	if not profile or not character then
		return
	end
	local id = profile.Angler.BackpackId
	if not Backpacks.Items[id] then
		id = "Starter"
	end
	local existing = character:FindFirstChild("FishingBackpack")
	if not force and existing and existing:GetAttribute("BackpackId") == id then
		return
	end
	Models.wear(character, id)
end

function Service.start()
	if started then
		return
	end
	started = true
	local remote = Instance.new("RemoteFunction")
	remote.Name, remote.Parent = "BackpackShop", ReplicatedStorage
	remote.OnServerInvoke = function(player, action, id)
		if os.clock() - (requests[player] or -math.huge) < 0.25 then
			return { Ok = false, Message = "Please wait a moment.", State = state(player) }
		end
		requests[player] = os.clock()
		local profile = BoatService.getProfile(player)
		if not profile then
			return { Ok = false, Message = "Your backpack is still loading." }
		end
		if action == "Get" then
			return { Ok = true, State = state(player) }
		end
		if action ~= "Buy" then
			return { Ok = false, Message = "That action is unavailable." }
		end
		if not atShop(player) then
			return { Ok = false, Message = "Visit the backpack store at the plaza." }
		end
		local failure = problem(profile, id)
		if failure then
			return { Ok = false, Message = failure, State = state(player) }
		end
		local ok, message = BoatService.updateProgress(player, function(current)
			assert(atShop(player), "Visit the backpack store at the plaza.")
			local reason = problem(current, id)
			assert(not reason, reason)
			local item = Backpacks.Items[id]
			current.Cash -= item.Price
			current.Angler.Stats.CoinsSpent += item.Price
			current.Angler.BackpackId = id
		end)
		if ok then
			syncAppearance(player)
		end
		return {
			Ok = ok,
			Message = if ok
				then Backpacks.Items[id].Name .. " purchased! Open Backpack [C] to pack your fish."
				else message,
			State = state(player),
		}
	end
	local function bind(player)
		player:GetAttributeChangedSignal("AnglerRevision"):Connect(function()
			syncAppearance(player)
		end)
		player.CharacterAppearanceLoaded:Connect(function()
			syncAppearance(player, true)
		end)
		player.CharacterAdded:Connect(function(character)
			local humanoid = character:WaitForChild("Humanoid", 10)
			if not humanoid then
				return
			end
			character:WaitForChild(if humanoid.RigType == Enum.HumanoidRigType.R15 then "UpperTorso" else "Torso", 10)
			if player.Character == character then
				syncAppearance(player, true)
			end
		end)
		if player.Character then
			syncAppearance(player)
		end
	end
	Players.PlayerAdded:Connect(bind)
	for _, player in Players:GetPlayers() do
		bind(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		requests[player] = nil
	end)
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="132">
        <Properties>
          <string name="Name">BaseService</string>
          <string name="Source"><![CDATA[-- Gives each player one of the harbour bases for as long as they're in the server
-- and makes them spawn on it. Players beyond the number of bases spawn in the plaza.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local TextService = game:GetService("TextService")
local BoatService = require(script.Parent.BoatService)

local BASE_TAG = "PlayerBase"

local BaseService = {}

local owned: { [Player]: Model } = {}

local function setBoard(base: Model, text: string)
	local board = base:FindFirstChild("NameBoard")
	if board then
		for _, label in board:GetDescendants() do
			if label:IsA("TextLabel") then
				label.Text = text
			end
		end
	end
end

local function setShopSign(base: Model, value: string)
	local sign = base:FindFirstChild("ShopSign", true)
	local label = sign and sign:FindFirstChildWhichIsA("TextLabel", true)
	if label then
		label.Text = if value ~= "" then value else "FISH & TACKLE  /  " .. string.format("%02d", base:GetAttribute("BaseId") or 1)
	end
end

local function freeBase(): Model?
	local bases = CollectionService:GetTagged(BASE_TAG)
	table.sort(bases, function(a, b)
		return (a:GetAttribute("BaseId") or 0) < (b:GetAttribute("BaseId") or 0)
	end)
	for _, base in bases do
		if base:GetAttribute("OwnerUserId") == 0 then
			return base :: Model
		end
	end
	return nil
end

local function spawnPoint(base: Model): SpawnLocation?
	return base:FindFirstChild("SpawnPoint") :: SpawnLocation?
end

local function harbourSpawn(): SpawnLocation?
	local map = workspace:FindFirstChild("Map")
	return (map and map:FindFirstChild("HarbourSpawn")) :: SpawnLocation?
end

local function claim(player: Player)
	local base = freeBase()
	if not base then
		player.RespawnLocation = harbourSpawn()
		return
	end
	owned[player] = base
	base:SetAttribute("OwnerUserId", player.UserId)
	player:SetAttribute("BaseId", base:GetAttribute("BaseId"))
	setBoard(base, player.DisplayName .. "'s Dock")
	setShopSign(base, "")
	local lastName = nil
	local generation = 0
	local function updateSign()
		if owned[player] ~= base then
			return
		end
		local profile = BoatService.getProfile(player)
		if not profile then
			return
		end
		local name = profile.Angler.ShopSign
		if name == lastName then
			return
		end
		lastName = name
		generation += 1
		local currentGeneration = generation
		if name == "" then
			setShopSign(base, "")
			return
		end
		task.spawn(function()
			local ok, filtered = pcall(function()
				return TextService:FilterStringAsync(name, player.UserId):GetNonChatStringForBroadcastAsync()
			end)
			if ok and owned[player] == base and generation == currentGeneration then
				setShopSign(base, filtered)
			elseif not ok and generation == currentGeneration then
				lastName = nil
			end
		end)
	end
	player:GetAttributeChangedSignal("AnglerRevision"):Connect(updateSign)
	updateSign()
	player.RespawnLocation = spawnPoint(base)
end

local function release(player: Player)
	local base = owned[player]
	if base then
		owned[player] = nil
		base:SetAttribute("OwnerUserId", 0)
		setBoard(base, "Base " .. tostring(base:GetAttribute("BaseId")))
		setShopSign(base, "")
	end
end

-- RespawnLocation normally handles this; moving the character as well covers spawns that
-- happened before the base existed.
local function placeCharacter(player: Player, character: Model)
	player:SetAttribute("FishingWatersSpawnReady", false)
	local base = owned[player]
	local point = if base then spawnPoint(base) else harbourSpawn()
	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not point or not root or player.Character ~= character then
		return
	end
	task.wait()
	if player.Character ~= character or not root.Parent then
		return
	end
	if (root.Position - point.Position).Magnitude > 20 then
		character:PivotTo(point.CFrame + Vector3.new(0, 4, 0))
	end
	-- The loader may inspect collision only after the server's final placement.
	-- This also covers plaza spawns when all harbour bases have been claimed.
	player:SetAttribute("FishingWatersSpawnReady", true)
end

local function onPlayer(player: Player)
	player:SetAttribute("FishingWatersSpawnReady", false)
	claim(player)
	player.CharacterAdded:Connect(function(character)
		placeCharacter(player, character)
	end)
	if player.Character then
		task.spawn(placeCharacter, player, player.Character)
	else
		player:LoadCharacter()
	end
end

function BaseService.start()
	Players.PlayerRemoving:Connect(release)
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayer, player)
	end
	Players.CharacterAutoLoads = true
end

return BaseService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="133">
        <Properties>
          <string name="Name">BoatData</string>
          <string name="Source"><![CDATA[-- Wallet/boat transactions are pure so the same rules run inside UpdateAsync and tests.
local BoatData = {}
local BobberSkins = if script
	then require(game:GetService("ReplicatedStorage").Shared.BobberSkins)
	else require("../shared/BobberSkins")
local AnglerData = if script then require(script.Parent.AnglerData) else require("./AnglerData")
local RodUpgrades = if script
	then require(game:GetService("ReplicatedStorage").Shared.RodUpgrades)
	else require("../shared/RodUpgrades")
local RodSkins = if script
	then require(game:GetService("ReplicatedStorage").Shared.RodSkins)
	else require("../shared/RodSkins")
local SpearSkins = if script
	then require(game:GetService("ReplicatedStorage").Shared.SpearSkins)
	else require("../shared/SpearSkins")
local BoatCatalog = if script
	then require(game:GetService("ReplicatedStorage").Shared.BoatCatalog)
	else require("../shared/BoatCatalog")

BoatData.PRICE = BoatCatalog.Rowboat.Price

function BoatData.trackProgress(previous, current, now)
	current.Angler = AnglerData.trackProgress(previous.Angler, current.Angler, now)
end

function BoatData.leaderboardScores(profile, now)
	return AnglerData.scores(profile.Angler, now)
end

function BoatData.levelProgress(profile)
	return AnglerData.levelProgress(profile.Angler.Stats.TotalXP)
end

export type Profile = {
	Version: number,
	Cash: number,
	OwnedBoats: { [string]: boolean },
	OwnedRods: { [string]: boolean },
	OwnedSpears: { [string]: boolean },
	SpearSkinCopies: { { SkinId: string, Serial: number, Wear: number } },
	EquippedSpearSkin: string?,
	EquippedSpearSkinSerial: number?,
	RodUpgrades: { [string]: number },
	RodSkins: { [string]: number },
	RodSkinCopies: { { SkinId: string, Serial: number, Wear: number } },
	RodCrates: { [string]: number },
	NextRodSkinSerial: { [string]: number },
	RodSerialScope: string?,
	EquippedRodSkin: string?,
	EquippedRodSkinSerial: number?,
	GroupRodClaimed: boolean?,
	BobberSkins: { [string]: number },
	EquippedBobberSkin: string?,
	Angler: any,
}

function BoatData.decode(raw: any): Profile
	if raw == nil then
		return {
			Version = 1,
			Cash = 0,
			OwnedBoats = { Rowboat = true },
			OwnedRods = { StarterRod = true },
			OwnedSpears = {},
			SpearSkinCopies = {},
			RodUpgrades = {},
			RodSkins = {},
			RodSkinCopies = {},
			RodCrates = {},
			NextRodSkinSerial = {},
			RodSerialScope = "GlobalV1",
			BobberSkins = {},
			Angler = AnglerData.decode(nil),
		}
	end
	assert(type(raw) == "table" and raw.Version == 1, "Unsupported boating data")
	assert(
		type(raw.Cash) == "number" and raw.Cash >= 0 and raw.Cash < 2 ^ 53 and raw.Cash % 1 == 0,
		"Invalid wallet balance"
	)
	assert(type(raw.OwnedBoats) == "table", "Invalid boat inventory")
	for id, owned in raw.OwnedBoats do
		assert(type(id) == "string" and type(owned) == "boolean", "Invalid boat ownership")
	end
	-- Existing wallet records predate rods. Missing inventory migrates in memory;
	-- malformed saved inventory is rejected rather than silently overwritten.
	assert(raw.OwnedRods == nil or type(raw.OwnedRods) == "table", "Invalid rod inventory")
	for id, owned in raw.OwnedRods or {} do
		assert(type(id) == "string" and type(owned) == "boolean", "Invalid rod ownership")
	end
	assert(raw.OwnedSpears == nil or type(raw.OwnedSpears) == "table", "Invalid spear inventory")
	for id, owned in raw.OwnedSpears or {} do
		assert(type(id) == "string" and type(owned) == "boolean", "Invalid spear ownership")
	end
	assert(raw.RodUpgrades == nil or type(raw.RodUpgrades) == "table", "Invalid rod upgrades")
	for stat, level in raw.RodUpgrades or {} do
		assert(
			RodUpgrades.valid(stat) and type(level) == "number" and level % 1 == 0 and level >= 0,
			"Invalid rod upgrade level"
		)
	end
	-- Skin counts are copies won from crates. Skins no longer in the catalog are
	-- dropped rather than failing the whole save.
	assert(raw.RodSkins == nil or type(raw.RodSkins) == "table", "Invalid rod skins")
	for id, count in raw.RodSkins or {} do
		assert(type(id) == "string" and type(count) == "number" and count % 1 == 0 and count >= 0, "Invalid rod skin")
	end
	assert(raw.EquippedRodSkin == nil or type(raw.EquippedRodSkin) == "string", "Invalid equipped rod skin")
	local profile = table.clone(raw)
	assert(raw.RodSerialScope == nil or raw.RodSerialScope == "GlobalV1", "Unsupported rod serial scope")
	assert(raw.GroupRodClaimed == nil or type(raw.GroupRodClaimed) == "boolean", "Invalid group reward claim")
	profile.OwnedBoats = table.clone(raw.OwnedBoats)
	profile.OwnedRods = table.clone(raw.OwnedRods or {})
	profile.OwnedSpears = table.clone(raw.OwnedSpears or {})
	assert(raw.SpearSkinCopies == nil or type(raw.SpearSkinCopies) == "table", "Invalid spear skin copies")
	assert(raw.EquippedSpearSkin == nil or type(raw.EquippedSpearSkin) == "string", "Invalid equipped spear skin")
	assert(
		raw.EquippedSpearSkinSerial == nil
			or (
				type(raw.EquippedSpearSkinSerial) == "number"
				and raw.EquippedSpearSkinSerial >= 1
				and raw.EquippedSpearSkinSerial < 2 ^ 53 - 1
				and raw.EquippedSpearSkinSerial % 1 == 0
			),
		"Invalid equipped spear serial"
	)
	profile.SpearSkinCopies = {}
	profile.EquippedSpearSkin, profile.EquippedSpearSkinSerial = nil, nil
	local spearSerials = {}
	for index, copy in raw.SpearSkinCopies or {} do
		assert(
			type(index) == "number" and index >= 1 and index % 1 == 0 and index <= #raw.SpearSkinCopies,
			"Invalid spear skin index"
		)
		assert(type(copy) == "table" and type(copy.SkinId) == "string", "Invalid spear skin copy")
		assert(
			type(copy.Serial) == "number" and copy.Serial >= 1 and copy.Serial < 2 ^ 53 - 1 and copy.Serial % 1 == 0,
			"Invalid spear skin serial"
		)
		assert(SpearSkins.validWear(copy.Wear), "Invalid spear skin wear")
		local serials = spearSerials[copy.SkinId] or {}
		assert(not serials[copy.Serial], "Duplicate spear skin serial")
		serials[copy.Serial], spearSerials[copy.SkinId] = true, serials
		if SpearSkins.valid(copy.SkinId) then
			table.insert(profile.SpearSkinCopies, { SkinId = copy.SkinId, Serial = copy.Serial, Wear = copy.Wear })
			if copy.SkinId == raw.EquippedSpearSkin and copy.Serial == raw.EquippedSpearSkinSerial then
				profile.EquippedSpearSkin, profile.EquippedSpearSkinSerial = copy.SkinId, copy.Serial
			end
		end
	end
	-- Every angler starts with a rod, including profiles saved before this default.
	profile.OwnedRods.StarterRod = true
	profile.RodUpgrades = {}
	for stat, level in raw.RodUpgrades or {} do
		profile.RodUpgrades[stat] = math.min(level, RodUpgrades.Stats[stat].MaxLevel)
	end
	profile.RodSkins = {}
	for id, count in raw.RodSkins or {} do
		if count > 0 and RodSkins.valid(id) then
			profile.RodSkins[id] = count
		end
	end
	-- Normalize historical per-player counters for RodSerials.migrate. Numbers
	-- already in the global format survive decoding without being renumbered.
	local savedCounts = profile.RodSkins
	profile.RodSkins, profile.RodSkinCopies, profile.NextRodSkinSerial = {}, {}, {}
	local perSkinSerials = type(raw.NextRodSkinSerial) == "table"
	if perSkinSerials then
		for id, nextSerial in raw.NextRodSkinSerial do
			assert(
				type(id) == "string"
					and type(nextSerial) == "number"
					and nextSerial >= 1
					and nextSerial < 2 ^ 53
					and nextSerial % 1 == 0,
				"Invalid skin serial counter"
			)
			profile.NextRodSkinSerial[id] = nextSerial
		end
	elseif raw.NextRodSkinSerial ~= nil then
		assert(
			type(raw.NextRodSkinSerial) == "number"
				and raw.NextRodSkinSerial >= 1
				and raw.NextRodSkinSerial < 2 ^ 53
				and raw.NextRodSkinSerial % 1 == 0,
			"Invalid legacy skin serial counter"
		)
	end
	assert(
		raw.EquippedRodSkinSerial == nil
			or (
				type(raw.EquippedRodSkinSerial) == "number"
				and raw.EquippedRodSkinSerial >= 1
				and raw.EquippedRodSkinSerial % 1 == 0
			),
		"Invalid equipped skin serial"
	)
	profile.EquippedRodSkin, profile.EquippedRodSkinSerial = nil, nil
	local function addCopy(id, serial, originalSerial, wear)
		if not RodSkins.valid(id) then
			return
		end
		table.insert(profile.RodSkinCopies, { SkinId = id, Serial = serial, Wear = wear or RodSkins.DefaultWear })
		profile.RodSkins[id] = (profile.RodSkins[id] or 0) + 1
		if
			profile.EquippedRodSkin == nil
			and id == raw.EquippedRodSkin
			and (raw.EquippedRodSkinSerial == nil or originalSerial == raw.EquippedRodSkinSerial)
		then
			profile.EquippedRodSkin, profile.EquippedRodSkinSerial = id, serial
		end
	end
	if raw.RodSkinCopies == nil then
		local ids = {}
		for id in savedCounts do
			table.insert(ids, id)
		end
		table.sort(ids)
		for _, id in ids do
			local nextSerial = profile.NextRodSkinSerial[id] or 1
			for _ = 1, savedCounts[id] do
				addCopy(id, nextSerial, nextSerial)
				nextSerial += 1
			end
			profile.NextRodSkinSerial[id] = nextSerial
		end
	else
		assert(type(raw.RodSkinCopies) == "table", "Invalid skin copies")
		local seen, copies = {}, {}
		for index, copy in raw.RodSkinCopies do
			assert(
				type(index) == "number" and index >= 1 and index % 1 == 0 and index <= #raw.RodSkinCopies,
				"Invalid skin copy index"
			)
			assert(type(copy) == "table" and type(copy.SkinId) == "string", "Invalid skin copy")
			assert(copy.Wear == nil or RodSkins.validWear(copy.Wear), "Invalid skin wear")
			local serial = copy.Serial
			local skinSeen = seen[copy.SkinId] or {}
			assert(
				type(serial) == "number"
					and serial >= 1
					and serial < 2 ^ 53 - 1
					and serial % 1 == 0
					and not skinSeen[serial],
				"Invalid skin serial"
			)
			skinSeen[serial], seen[copy.SkinId] = true, skinSeen
			table.insert(copies, copy)
		end
		if not perSkinSerials then
			table.sort(copies, function(a, b)
				return a.Serial < b.Serial
			end)
		end
		for _, copy in copies do
			local id = copy.SkinId
			local nextSerial = profile.NextRodSkinSerial[id] or 1
			local serial = if perSkinSerials then copy.Serial else nextSerial
			profile.NextRodSkinSerial[id] = math.max(nextSerial, serial + 1)
			addCopy(id, serial, copy.Serial, copy.Wear)
		end
	end
	assert(raw.RodCrates == nil or type(raw.RodCrates) == "table", "Invalid rod crates")
	profile.RodCrates = {}
	for id, count in raw.RodCrates or {} do
		assert(
			type(id) == "string" and type(count) == "number" and count >= 0 and count < 2 ^ 53 and count % 1 == 0,
			"Invalid rod crate count"
		)
		if count > 0 then
			profile.RodCrates[id] = count
		end
	end
	-- Old profiles start with the original float. Unknown retired skins are ignored.
	assert(raw.BobberSkins == nil or type(raw.BobberSkins) == "table", "Invalid bobber inventory")
	profile.BobberSkins = {}
	for id, count in raw.BobberSkins or {} do
		assert(
			type(id) == "string" and type(count) == "number" and count >= 0 and count < 2 ^ 53 and count % 1 == 0,
			"Invalid bobber count"
		)
		if count > 0 and BobberSkins.valid(id) then
			profile.BobberSkins[id] = count
		end
	end
	assert(raw.EquippedBobberSkin == nil or type(raw.EquippedBobberSkin) == "string", "Invalid equipped bobber")
	profile.EquippedBobberSkin = if BobberSkins.valid(raw.EquippedBobberSkin)
			and profile.BobberSkins[raw.EquippedBobberSkin]
		then raw.EquippedBobberSkin
		else nil
	profile.Angler = AnglerData.decode(raw.Angler)
	return profile
end

-- Boats with a RequiresPath stay off sale until that business path is unlocked.
-- Reads the saved path table directly (see Shared.Paths.state for its shape).
function BoatData.pathLocked(profile: Profile, boatId: string): boolean
	local spec = BoatCatalog[boatId]
	if not spec or not spec.RequiresPath then
		return false
	end
	local paths = profile.Angler and profile.Angler.Paths
	return not (paths and paths.Unlocked and paths.Unlocked[spec.RequiresPath] == true)
end

function BoatData.purchase(raw: any, boatId: string?): (Profile, string)
	local profile = BoatData.decode(raw)
	local id = boatId or "Rowboat"
	local spec = BoatCatalog[id]
	if not spec then
		return profile, "UnknownBoat"
	end
	if profile.OwnedBoats[id] then
		return profile, "AlreadyOwned"
	end
	if BoatData.pathLocked(profile, id) then
		return profile, "Locked"
	end
	if profile.Cash < spec.Price then
		return profile, "InsufficientFunds"
	end
	profile.Cash -= spec.Price
	profile.Angler.Stats.CoinsSpent += spec.Price
	profile.OwnedBoats[id] = true
	return profile, "Purchased"
end

-- Mutates a decoded profile in place: buys the next level of one rod stat.
function BoatData.upgradeRod(profile: Profile, stat: string): string
	if not RodUpgrades.valid(stat) then
		return "UnknownUpgrade"
	end
	local level = RodUpgrades.level(profile.RodUpgrades, stat)
	local price = RodUpgrades.price(stat, level)
	if not price then
		return "Maxed"
	end
	if not profile.OwnedRods.StarterRod then
		return "NoRod"
	end
	if profile.Cash < price then
		return "InsufficientFunds"
	end
	profile.Cash -= price
	profile.Angler.Stats.CoinsSpent += price
	profile.RodUpgrades[stat] = level + 1
	return "Upgraded"
end

-- Separate atomic transactions preserve purchased crates across sessions.
function BoatData.buyRodCrates(profile: Profile, crateId: string, count: number): string
	local crate = RodSkins.Crates[crateId]
	if not crate then
		return "UnknownCrate"
	end
	if count ~= 1 and count ~= 3 and count ~= 10 then
		return "InvalidCount"
	end
	if not profile.OwnedRods.StarterRod then
		return "NoRod"
	end
	local price = crate.Price * count
	if profile.Cash < price then
		return "InsufficientFunds"
	end
	profile.Cash -= price
	profile.Angler.Stats.CoinsSpent += price
	profile.RodCrates[crateId] = (profile.RodCrates[crateId] or 0) + count
	return "Purchased"
end

-- A rod bought outright (Pirate Cove's trader): one copy of `skinId` with a reserved global serial.
-- Call with no serial to check affordability only.
function BoatData.buyRodSkin(profile: Profile, skinId: string, price: number, wear: number, serial: number?): string
	if not RodSkins.valid(skinId) then
		return "UnknownRod"
	end
	if not profile.OwnedRods.StarterRod then
		return "NoRod"
	end
	if profile.Cash < price then
		return "InsufficientFunds"
	end
	if serial == nil then
		return "Purchased"
	end
	assert(RodSkins.validWear(wear), "Invalid skin wear")
	assert(type(serial) == "number" and serial >= 1 and serial < 2 ^ 53 - 1 and serial % 1 == 0, "Missing global skin serial")
	for _, copy in profile.RodSkinCopies do
		assert(copy.SkinId ~= skinId or copy.Serial ~= serial, "Skin serial already owned")
	end
	profile.Cash -= price
	profile.Angler.Stats.CoinsSpent += price
	profile.RodSkins[skinId] = (profile.RodSkins[skinId] or 0) + 1
	table.insert(profile.RodSkinCopies, { SkinId = skinId, Serial = serial, Wear = wear })
	profile.NextRodSkinSerial[skinId] = math.max(profile.NextRodSkinSerial[skinId] or 1, serial + 1)
	return "Purchased"
end

function BoatData.openOwnedRodCrate(
	profile: Profile,
	crateId: string,
	skinId: string,
	serial: number,
	wear: number
): string
	local crate = RodSkins.Crates[crateId]
	if not crate or not table.find(crate.Skins, skinId) then
		return "UnknownCrate"
	end
	if (profile.RodCrates[crateId] or 0) < 1 then
		return "NoCrate"
	end
	assert(RodSkins.validWear(wear), "Invalid skin wear")
	assert(
		type(serial) == "number" and serial >= 1 and serial < 2 ^ 53 - 1 and serial % 1 == 0,
		"Missing global skin serial"
	)
	for _, copy in profile.RodSkinCopies do
		assert(copy.SkinId ~= skinId or copy.Serial ~= serial, "Skin serial already owned")
	end
	profile.RodCrates[crateId] -= 1
	profile.RodSkins[skinId] = (profile.RodSkins[skinId] or 0) + 1
	table.insert(profile.RodSkinCopies, { SkinId = skinId, Serial = serial, Wear = wear })
	profile.NextRodSkinSerial[skinId] = math.max(profile.NextRodSkinSerial[skinId] or 1, serial + 1)
	return "Opened"
end

function BoatData.equippedRodWear(profile: Profile): number
	for _, copy in profile.RodSkinCopies do
		if copy.SkinId == profile.EquippedRodSkin and copy.Serial == profile.EquippedRodSkinSerial then
			return copy.Wear or RodSkins.DefaultWear
		end
	end
	return RodSkins.DefaultWear
end

function BoatData.canOpenRodCrate(profile: Profile, crateId: string, skinId: string): string
	local crate = RodSkins.Crates[crateId]
	if not crate or not table.find(crate.Skins, skinId) then
		return "UnknownCrate"
	end
	if not profile.OwnedRods.StarterRod then
		return "NoRod"
	end
	if profile.Cash < crate.Price then
		return "InsufficientFunds"
	end
	return "Opened"
end

-- The server reserves a GLOBAL number before UpdateAsync, then supplies the same
-- number on every retry. Profile counters remain only for decoding older saves.
function BoatData.openRodCrate(profile: Profile, crateId: string, skinId: string, serial: number): (string, number?)
	local outcome = BoatData.canOpenRodCrate(profile, crateId, skinId)
	if outcome ~= "Opened" then
		return outcome
	end
	assert(
		type(serial) == "number" and serial >= 1 and serial < 2 ^ 53 - 1 and serial % 1 == 0,
		"Missing global skin serial"
	)
	for _, copy in profile.RodSkinCopies do
		assert(copy.SkinId ~= skinId or copy.Serial ~= serial, "Skin serial already owned")
	end
	local crate = RodSkins.Crates[crateId]
	profile.Cash -= crate.Price
	profile.Angler.Stats.CoinsSpent += crate.Price
	profile.RodSkins[skinId] = (profile.RodSkins[skinId] or 0) + 1
	table.insert(profile.RodSkinCopies, { SkinId = skinId, Serial = serial })
	profile.NextRodSkinSerial[skinId] = serial + 1
	return "Opened", serial
end

-- Membership is verified by FishingService. The receipt and serial are committed
-- together in the existing wallet transaction, including UpdateAsync retries.
function BoatData.claimGroupRod(profile: Profile, serial: number): (string, number?)
	local id = RodSkins.GroupReward
	if profile.GroupRodClaimed then
		return "AlreadyClaimed"
	end
	for _, copy in profile.RodSkinCopies do
		if copy.SkinId == id then
			profile.GroupRodClaimed = true
			return "AlreadyClaimed", copy.Serial
		end
	end
	assert(
		type(serial) == "number" and serial >= 1 and serial < 2 ^ 53 - 1 and serial % 1 == 0,
		"Missing global skin serial"
	)
	profile.RodSkins[id] = (profile.RodSkins[id] or 0) + 1
	table.insert(profile.RodSkinCopies, { SkinId = id, Serial = serial })
	profile.NextRodSkinSerial[id] = serial + 1
	profile.GroupRodClaimed = true
	return "Claimed", serial
end

-- Mutates a decoded profile in place: nil puts the plain starter rod back on.
function BoatData.equipRodSkin(profile: Profile, skinId: string?, serial: number?): string
	if skinId ~= nil and not RodSkins.valid(skinId) then
		return "UnknownSkin"
	end
	if skinId ~= nil and not profile.RodSkins[skinId] then
		return "NotOwned"
	end
	if skinId == nil then
		profile.EquippedRodSkin, profile.EquippedRodSkinSerial = nil, nil
		return "Equipped"
	end
	for _, copy in profile.RodSkinCopies do
		if copy.SkinId == skinId and (serial == nil or copy.Serial == serial) then
			profile.EquippedRodSkin, profile.EquippedRodSkinSerial = skinId, copy.Serial
			return "Equipped"
		end
	end
	return "NotOwned"
end

-- Rolls and serials are chosen before the transaction so retries award the same copy.
function BoatData.openSpearCrate(
	profile: Profile,
	crateId: string,
	skinId: string,
	serial: number,
	wear: number
): string
	local crate = SpearSkins.Crates[crateId]
	if not crate or not table.find(crate.Skins, skinId) then
		return "UnknownCrate"
	end
	if profile.Cash < crate.Price then
		return "InsufficientFunds"
	end
	assert(
		type(serial) == "number" and serial >= 1 and serial < 2 ^ 53 - 1 and serial % 1 == 0,
		"Invalid spear skin serial"
	)
	assert(SpearSkins.validWear(wear), "Invalid spear wear")
	for _, copy in profile.SpearSkinCopies do
		assert(copy.SkinId ~= skinId or copy.Serial ~= serial, "Spear skin serial already owned")
	end
	profile.Cash -= crate.Price
	profile.Angler.Stats.CoinsSpent += crate.Price
	table.insert(profile.SpearSkinCopies, { SkinId = skinId, Serial = serial, Wear = wear })
	return "Opened"
end

function BoatData.equipSpearSkin(profile: Profile, skinId: string?, serial: number?): string
	if skinId == nil then
		profile.EquippedSpearSkin, profile.EquippedSpearSkinSerial = nil, nil
		return "Equipped"
	end
	if not SpearSkins.valid(skinId) then
		return "UnknownSkin"
	end
	for _, copy in profile.SpearSkinCopies do
		if copy.SkinId == skinId and (serial == nil or copy.Serial == serial) then
			profile.EquippedSpearSkin, profile.EquippedSpearSkinSerial = skinId, copy.Serial
			return "Equipped"
		end
	end
	return "NotOwned"
end

function BoatData.equippedSpearWear(profile: Profile): number
	for _, copy in profile.SpearSkinCopies do
		if copy.SkinId == profile.EquippedSpearSkin and copy.Serial == profile.EquippedSpearSkinSerial then
			return copy.Wear
		end
	end
	return SpearSkins.DefaultWear
end

function BoatData.openBobberCrate(profile: Profile, crateId: string, skinId: string): string
	local crate = BobberSkins.Crates[crateId]
	if not crate or not table.find(crate.Skins, skinId) then
		return "UnknownCrate"
	end
	if not profile.OwnedRods.StarterRod then
		return "NoRod"
	end
	if profile.Cash < crate.Price then
		return "InsufficientFunds"
	end
	profile.Cash -= crate.Price
	profile.Angler.Stats.CoinsSpent += crate.Price
	profile.BobberSkins[skinId] = (profile.BobberSkins[skinId] or 0) + 1
	return "Opened"
end

function BoatData.equipBobberSkin(profile: Profile, skinId: string?): string
	if skinId ~= nil and not BobberSkins.valid(skinId) then
		return "UnknownSkin"
	end
	if skinId ~= nil and not profile.BobberSkins[skinId] then
		return "NotOwned"
	end
	profile.EquippedBobberSkin = skinId
	return "Equipped"
end

return BoatData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="134">
        <Properties>
          <string name="Name">BoatLaunchCollision</string>
          <string name="Source"><![CDATA[-- Temporary launch filtering leaves island ground solid while docks, players,
-- props and other boats can be passed through. CanCollide is never changed.
local BoatLaunchCollision = {}
local GHOST = "DrydockLaunch"
local ISLAND = "IslandGround"
local started = false

local function classify(item: Instance)
	if not item:IsA("BasePart") then
		return
	end
	local map = workspace:FindFirstChild("Map")
	if not map or not item:IsDescendantOf(map) then
		return
	end
	local ancestor = item.Parent
	while ancestor and ancestor ~= workspace do
		if ancestor.Name == "Ground" then
			item.CollisionGroup = ISLAND
			return
		end
		ancestor = ancestor.Parent
	end
end

local function configure()
	for _, name in { GHOST, ISLAND } do
		if not workspace:IsCollisionGroupRegistered(name) then
			workspace:RegisterCollisionGroup(name)
		end
	end
	for _, group in workspace:GetRegisteredCollisionGroups() do
		workspace:CollisionGroupSetCollidable(GHOST, group.name, group.name == ISLAND)
	end
end

function BoatLaunchCollision.start()
	if started then
		return
	end
	started = true
	configure()
	workspace.Terrain.CollisionGroup = ISLAND
	-- Covers saved ground and distant islands generated after the harbour opens.
	workspace.DescendantAdded:Connect(classify)
	local map = workspace:FindFirstChild("Map")
	if map then
		for _, item in map:GetDescendants() do
			classify(item)
		end
	end
end

function BoatLaunchCollision.protect(model: Model, seconds: number)
	BoatLaunchCollision.start()
	configure()
	local original = {}
	local function protectPart(item: Instance)
		if item:IsA("BasePart") and original[item] == nil then
			original[item] = item.CollisionGroup
			item.CollisionGroup = GHOST
		end
	end
	for _, item in model:GetDescendants() do
		protectPart(item)
	end
	local added = model.DescendantAdded:Connect(protectPart)
	local destroying
	local restored = false
	local function restore()
		if restored then
			return
		end
		restored = true
		added:Disconnect()
		if destroying then
			destroying:Disconnect()
		end
		for part, group in original do
			if part.Parent then
				part.CollisionGroup = group
			end
		end
		model:SetAttribute("LaunchGraceEndsAt", nil)
	end
	destroying = model.Destroying:Connect(restore)
	model:SetAttribute("LaunchGraceEndsAt", workspace:GetServerTimeNow() + seconds)
	task.delay(seconds, restore)
end

return BoatLaunchCollision
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="135">
        <Properties>
          <string name="Name">BoatRefitService</string>
          <string name="Source"><![CDATA[-- Refits on the drydock lift. Owners sail their launched boat over the underwater
-- cradle behind the boat shop; it lifts the hull into the dry basin, where they
-- fit extra motors and rudders, which are boat parts that take up cargo tiles
-- (see Shared.BoatUpgrades), repaint the hull in a preset colour, or buy the
-- trawler's stern net. Clients only display; every change is checked here against
-- the saved hold and the lift, and BoatService drives the hull with the tuned spec.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AnglerData = require(script.Parent.AnglerData)
local BoatService = require(script.Parent.BoatService)
local DrydockLaunch = require(script.Parent.DrydockLaunch)
local TrawlerNetService = require(script.Parent.TrawlerNetService)
local Aboard = require(ReplicatedStorage.Shared.Aboard)
local BoatCatalog = require(ReplicatedStorage.Shared.BoatCatalog)
local BoatUpgrades = require(ReplicatedStorage.Shared.BoatUpgrades)
local Catalog = require(ReplicatedStorage.Shared.AnglerCatalog)

local BoatRefitService = {}
local DOCK_TAG = "RefitDock"
local started = false
local requests = {}

-- Hull facets that can take paint. Decks, cabins, rails and trim keep their colours.
local HULL = {
	HullPanel = true,
	HullPlank = true,
	BilgePanel = true,
	BottomPanel = true,
	HullEndCap = true,
	BowCap = true,
	BowStem = true,
	Transom = true,
	TransomTrim = true,
	TransomCap = true,
}

-- Each facet keeps its builder colour in FactoryColor, so repainting never
-- compounds and the factory finish can always come back. The colour covering the
-- most side panel is the hull's own and takes the paint; stripes keep theirs.
-- Planked hulls change colour board by board, so every plank takes the paint at
-- its own shade.
function BoatRefitService.paint(model: Model, paintId: string?)
	local preset = BoatUpgrades.paint(paintId)
	local rgb = preset and preset.RGB
	local id = if rgb then preset.Id else nil
	if model:GetAttribute("Paint") == id then
		return
	end
	local hull, areas, lightest = {}, {}, 0
	for _, piece in model:GetDescendants() do
		if piece:IsA("BasePart") and HULL[piece.Name] then
			local factory = piece:GetAttribute("FactoryColor")
			if typeof(factory) ~= "Color3" then
				factory = piece.Color
				piece:SetAttribute("FactoryColor", factory)
			end
			table.insert(hull, piece)
			if piece.Name == "HullPanel" then
				local key = factory:ToHex()
				areas[key] = (areas[key] or 0) + piece.Size.Y * piece.Size.Z
			elseif piece.Name == "HullPlank" then
				lightest = math.max(lightest, factory.R + factory.G + factory.B)
			end
		end
	end
	local main, largest = nil, 0
	for key, area in areas do
		if area > largest then
			main, largest = key, area
		end
	end
	local color = if rgb then Color3.fromRGB(rgb[1], rgb[2], rgb[3]) else nil
	for _, piece in hull do
		local factory = piece:GetAttribute("FactoryColor")
		if not color then
			piece.Color = factory
		elseif piece.Name == "HullPlank" and lightest > 0 then
			piece.Color = color:Lerp(Color3.new(), 1 - (factory.R + factory.G + factory.B) / lightest)
		elseif factory:ToHex() == main then
			piece.Color = color
		end
	end
	model:SetAttribute("Paint", id)
end

-- The drydock whose lift the hull floats over, if any.
local function dockUnder(model: Model?): Model?
	local root = model and model.PrimaryPart
	if not root then
		return nil
	end
	for _, dock in CollectionService:GetTagged(DOCK_TAG) do
		if dock:IsA("Model") and dock:IsDescendantOf(workspace) and BoatUpgrades.inSlip(dock, root.Position) then
			return dock
		end
	end
	return nil
end

-- Hulls up on a lift, by owner: { model, lift } (lift is nil while it rises).
local lifted = {}

local function lower(player: Player)
	local entry = lifted[player]
	-- A refit waiting for a spot is dropped with the hull; nothing is saved.
	player:SetAttribute("RefitPending", nil)
	if not entry then
		return
	elseif not entry.lift then
		-- Still rising; it comes back down as soon as it is up.
		entry.cancelled = true
		return
	end
	DrydockLaunch.lower(entry.lift)
	if lifted[player] == entry then
		lifted[player] = nil
	end
end

-- Sails the boat onto the lift: the hull must float over it with its owner aboard.
local function raise(player: Player): (boolean, string)
	local boatId, model = BoatService.activeBoat(player)
	local layout = boatId and BoatCatalog[boatId]
	local dock = dockUnder(model)
	if lifted[player] then
		return false, "Your boat is already on the lift."
	elseif not layout or not model then
		return false, "Launch one of your boats and sail it over the drydock lift."
	elseif not dock then
		return false, "Sail your boat over the drydock lift first."
	elseif not Aboard(player.Character, model) then
		return false, "Climb aboard your boat first."
	end
	local entry = { model = model }
	lifted[player] = entry
	-- The stern net always comes in before the hull leaves the water.
	TrawlerNetService.stow(model)
	local lift, reason = DrydockLaunch.lift(dock, player, model, function(height)
		BoatService.hoist(player, height)
	end)
	if not lift then
		lifted[player] = nil
		return false, reason
	end
	entry.lift = lift
	if entry.cancelled or player.Parent ~= Players or not model.Parent then
		lower(player)
		return false, "The lift went back down."
	end
	-- Set the hull back afloat if it disappears or its owner leaves.
	task.spawn(function()
		while lifted[player] == entry do
			if player.Parent ~= Players or not model.Parent then
				lower(player)
				break
			end
			task.wait(0.5)
		end
	end)
	return true, "Your " .. layout.Name .. " is up on the lift."
end

-- The boat the player may refit: up on the lift with its owner aboard.
local function refitBoat(player: Player): (string?, any, Model?, string?)
	local boatId, model = BoatService.activeBoat(player)
	local layout = boatId and BoatCatalog[boatId]
	local entry = lifted[player]
	if not layout or not model then
		return nil, nil, nil, "Launch one of your boats and sail it over the drydock lift."
	elseif not entry or not entry.lift or entry.model ~= model then
		return nil, nil, nil, "Sail your boat over the drydock lift first."
	elseif not Aboard(player.Character, model) then
		return nil, nil, nil, "Climb aboard your boat first."
	end
	return boatId, layout, model, nil
end

-- The refit dock reserves the part in RefitPending while the player picks its
-- hold spot. Attributes cannot hold tables, so it is a server-owned
-- "BoatId|Kind|PartId" string.
local function pendingRefit(player: Player)
	local value = player:GetAttribute("RefitPending")
	if type(value) ~= "string" then
		return nil
	end
	local boatId, kind, partId = string.match(value, "^([^|]+)|([^|]+)|([^|]+)$")
	if not boatId or (kind ~= "Motor" and kind ~= "Rudder") then
		return nil
	end
	return { BoatId = boatId, Kind = kind, PartId = partId }
end

local function state(player: Player)
	local profile = BoatService.getProfile(player)
	local boatId, model = BoatService.activeBoat(player)
	local layout = boatId and BoatCatalog[boatId]
	if not profile or not layout then
		return { Ready = profile ~= nil }
	end
	local entry = lifted[player]
	local pending = pendingRefit(player)
	local waiting = if pending and pending.BoatId == boatId then pending else nil
	return {
		Ready = true,
		BoatId = boatId,
		Items = AnglerData.hold(profile.Angler, boatId, layout),
		Paint = profile.Angler.BoatPaint[boatId] or "Factory",
		NetOwned = BoatUpgrades.ownsNet(profile.Angler),
		Cash = profile.Cash,
		Pending = waiting,
		Lifted = entry ~= nil and entry.lift ~= nil and entry.model == model,
	}
end

-- Install only reserves the part: the player picks its hold spot themselves in
-- the cargo grid, and CargoService saves it there.
local function beginInstall(player: Player, kind: any): (boolean, string)
	local upgrade = if type(kind) == "string" then BoatUpgrades.Kinds[kind] else nil
	if not upgrade then
		return false, "Choose a motor or a rudder."
	end
	local boatId, layout, _, reason = refitBoat(player)
	local profile = BoatService.getProfile(player)
	if not boatId then
		return false, reason :: string
	elseif not profile then
		return false, "Your progress is still loading. Try again in a moment."
	elseif pendingRefit(player) ~= nil then
		return false, "A part is already waiting for a spot in your hold."
	end
	-- Reject a refit that could never fit before sending the player to the grid.
	local items, failure =
		BoatUpgrades.install(AnglerData.hold(profile.Angler, boatId, layout), layout, kind, Catalog.Fish)
	if not items then
		return false, failure
	end
	local partId = BoatUpgrades.partId(layout, kind)
	-- A string, because attributes cannot hold tables.
	player:SetAttribute("RefitPending", string.format("%s|%s|%s", boatId, kind, partId))
	return true, string.format("Choose where the %s goes in your hold.", string.lower(upgrade.Name))
end

local function remove(player: Player, kind: any): (boolean, string)
	local upgrade = if type(kind) == "string" then BoatUpgrades.Kinds[kind] else nil
	if not upgrade then
		return false, "Choose a motor or a rudder."
	end
	local boatId, layout, _, reason = refitBoat(player)
	local profile = BoatService.getProfile(player)
	if not boatId then
		return false, reason :: string
	elseif not profile then
		return false, "Your progress is still loading. Try again in a moment."
	end
	-- Check the cached profile first so a rejected refit never costs a save.
	local items, failure =
		BoatUpgrades.remove(AnglerData.hold(profile.Angler, boatId, layout), layout, kind, Catalog.Fish)
	if not items then
		return false, failure
	end
	local ok, message = BoatService.updateProgress(player, function(current)
		local updated, problem =
			BoatUpgrades.remove(AnglerData.hold(current.Angler, boatId, layout), layout, kind, Catalog.Fish)
		assert(updated, problem)
		current.Angler.Holds[boatId] = updated
	end)
	if not ok then
		return false, message
	end
	BoatService.refit(player)
	return true, string.format("%s taken out. Its cargo tiles are free again.", upgrade.Name)
end

local function repaint(player: Player, paintId: any): (boolean, string)
	local preset = BoatUpgrades.paint(paintId)
	if not preset then
		return false, "Choose one of the dock's paints."
	end
	local boatId, layout, _, reason = refitBoat(player)
	local profile = BoatService.getProfile(player)
	if not boatId then
		return false, reason :: string
	elseif not profile then
		return false, "Your progress is still loading. Try again in a moment."
	elseif (profile.Angler.BoatPaint[boatId] or "Factory") == preset.Id then
		return false, "Your " .. layout.Name .. " already wears that paint."
	end
	local ok, message = BoatService.updateProgress(player, function(current)
		current.Angler.BoatPaint[boatId] = if preset.RGB then preset.Id else nil
	end)
	if not ok then
		return false, message
	end
	BoatService.refit(player)
	return true,
		if preset.RGB
			then "Your " .. layout.Name .. " is painted " .. string.lower(preset.Name) .. "."
			else "Your " .. layout.Name .. " has its factory finish back."
end

-- The trawler's stern net is a one-time hull fitting. It is deliberately outside
-- the motor/rudder hold system, so it never takes cargo tiles.
local function buyNet(player: Player): (boolean, string)
	local boatId, layout, _, reason = refitBoat(player)
	local profile = BoatService.getProfile(player)
	local net = BoatUpgrades.Net
	if not boatId then
		return false, reason :: string
	elseif not profile then
		return false, "Your progress is still loading. Try again in a moment."
	elseif boatId ~= net.BoatId then
		return false, "The fisherman's net is made for the teal fishing trawler."
	elseif BoatUpgrades.ownsNet(profile.Angler) then
		return false, "Your " .. layout.Name .. " already carries its fisherman's net."
	elseif profile.Cash < net.Price then
		return false, string.format("You need $%d for the fisherman's net.", net.Price)
	end
	local ok, message = BoatService.updateProgress(player, function(current)
		assert(current.Cash >= net.Price, "Net purchase changed while saving")
		assert(not BoatUpgrades.ownsNet(current.Angler), "Net purchase changed while saving")
		current.Cash -= net.Price
		current.Angler.Stats.CoinsSpent += net.Price
		BoatUpgrades.grantNet(current.Angler)
	end)
	if not ok then
		return false, message
	end
	BoatService.refit(player)
	return true, "Fisherman's net fitted. Deploy it with the net button or N while underway."
end

-- Hulls launched from a dock, bought at the drydock or sailed by the hired
-- fisherman all come out painted and tuned.
local function outfit(player: Player, boatId: string, model: Model)
	local layout = BoatCatalog[boatId]
	local profile = BoatService.getProfile(player)
	if not layout or not profile then
		return nil
	end
	BoatRefitService.paint(model, profile.Angler.BoatPaint[boatId])
	TrawlerNetService.dress(player, boatId, model)
	local items = AnglerData.hold(profile.Angler, boatId, layout)
	local motorPartId = BoatUpgrades.partId(layout, "Motor")
	local motors = 0
	for _, item in items do
		if item.PartId == motorPartId then
			motors += 1
		end
	end
	model:SetAttribute("MotorCount", motors)
	return BoatUpgrades.spec(layout, items)
end

function BoatRefitService.start()
	if started then
		return
	end
	started = true
	BoatService.setOutfitter(outfit)
	local remote = Instance.new("RemoteFunction")
	remote.Name = "BoatRefit"
	remote.OnServerInvoke = function(player, action, key)
		if action == "Get" then
			return { Ok = true, Message = "", State = state(player) }
		elseif action == "Lower" then
			-- Always honoured, so closing the menu never strands a hull in the air.
			lower(player)
			return { Ok = true, Message = "", State = state(player) }
		elseif action ~= "Lift" and action ~= "Install" and action ~= "Remove" and action ~= "Paint" and action ~= "BuyNet" then
			return { Ok = false, Message = "That refit is unavailable.", State = state(player) }
		end
		if os.clock() - (requests[player] or -math.huge) < 0.3 then
			return { Ok = false, Message = "Please wait a moment and try again.", State = state(player) }
		end
		requests[player] = os.clock()
		local ok, message
		if action == "Lift" then
			ok, message = raise(player)
		elseif action == "Paint" then
			ok, message = repaint(player, key)
		elseif action == "BuyNet" then
			ok, message = buyNet(player)
		elseif action == "Install" then
			ok, message = beginInstall(player, key)
		else
			ok, message = remove(player, key)
		end
		return { Ok = ok, Message = message, State = state(player) }
	end
	remote.Parent = ReplicatedStorage
	Players.PlayerRemoving:Connect(function(player)
		requests[player] = nil
		lower(player)
	end)
end

return BoatRefitService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="136">
        <Properties>
          <string name="Name">BoatService</string>
          <string name="Source"><![CDATA[-- Server-owned wallet transactions, dock permissions, and one active boat per player.
local CollectionService = game:GetService("CollectionService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local BoatData = require(script.Parent.BoatData)
local RodSerials = require(script.Parent.RodSerials)
local AdminCommands = require(script.Parent.AdminCommands)
local Rowboat = require(script.Parent.Rowboat)
local FishingBoat = require(script.Parent.FishingBoat)
local Speedboat = require(script.Parent.Speedboat)
local RacingSpeedboat = require(script.Parent.RacingSpeedboat)
local PatrolBoat = require(script.Parent.PatrolBoat)
local Trawler = require(script.Parent.Trawler)
local Tugboat = require(script.Parent.Tugboat)
local Hovercraft = require(script.Parent.Hovercraft)
local DrydockLaunch = require(script.Parent.DrydockLaunch)
local BoatLaunchCollision = require(script.Parent.BoatLaunchCollision)
local BoatCatalog = require(ReplicatedStorage.Shared.BoatCatalog)
local AnglerCatalog = require(ReplicatedStorage.Shared.AnglerCatalog)
local BoatMotion = require(ReplicatedStorage.Shared.BoatMotion)
local RodSkins = require(ReplicatedStorage.Shared.RodSkins)
local SpearSkins = require(ReplicatedStorage.Shared.SpearSkins)
local BobberSkins = require(ReplicatedStorage.Shared.BobberSkins)
local RodUpgrades = require(ReplicatedStorage.Shared.RodUpgrades)
local Biomes = require(ReplicatedStorage.Shared.Biomes)
local Weather = require(ReplicatedStorage.Shared.Weather)
local BoatDrive = require(ReplicatedStorage.Shared.BoatDrive)
local builders = {
	Rowboat = Rowboat,
	FishingBoat = FishingBoat,
	Speedboat = Speedboat,
	PatrolBoat = PatrolBoat,
	RacingSpeedboat = RacingSpeedboat,
	Trawler = Trawler,
	Tugboat = Tugboat,
	Hovercraft = Hovercraft,
}

local BoatService = {}
local profiles = {}
local active = {}
local requests = {}
local spawnTimes = {}
local launching = {}
local launchPurchased
local boatLock: ((Player, string) -> string?)? = nil
local outfitter: ((Player, string, Model) -> any)? = nil
local started = false
local COMMAND_USER_ID = 2541746813 -- hyperlinkhyper
-- Studio tests use their own store; failed loads never overwrite saved data.
local studioSession = RunService:IsStudio() and game.GameId == 0
local store
if studioSession then
	-- Unpublished places cannot access DataStores. Keep test progress in this
	-- server only; never substitute defaults for a failed published save/load.
	local records = {}
	store = {
		GetAsync = function(_, key)
			return records[key]
		end,
		UpdateAsync = function(_, key, transform)
			local saved = transform(records[key])
			records[key] = saved
			return saved
		end,
	}
else
	local success, result = pcall(function()
		return DataStoreService:GetDataStore(
			if RunService:IsStudio() then "WalletAndBoats_Studio_v1" else "WalletAndBoats_v1"
		)
	end)
	if success then
		store = result
	else
		warn("[Wallet] Could not initialize saved data: " .. tostring(result))
	end
end
local feedback: RemoteEvent

local function notify(player: Player, message: string)
	if player.Parent == Players then
		feedback:FireClient(player, "Notice", message)
	end
end

local function publish(player: Player, state)
	player:SetAttribute("WalletSessionOnly", studioSession)
	player:SetAttribute("BoatDataStatus", state.status)
	player:SetAttribute("Cash", state.profile.Cash)
	for id in BoatCatalog do
		player:SetAttribute("Owns" .. id, state.status == "Ready" and state.profile.OwnedBoats[id] == true)
		player:SetAttribute("BoatLocked" .. id, BoatData.pathLocked(state.profile, id))
	end
	player:SetAttribute("OwnsStarterRod", state.status == "Ready" and state.profile.OwnedRods.StarterRod == true)
	player:SetAttribute("OwnsBasicSpear", state.status == "Ready" and state.profile.OwnedSpears.BasicSpear == true)
	for _, stat in RodUpgrades.Order do
		player:SetAttribute(RodUpgrades.attribute(stat), RodUpgrades.level(state.profile.RodUpgrades, stat))
	end
	for id in RodSkins.Skins do
		player:SetAttribute("RodSkinCount" .. id, state.profile.RodSkins[id] or 0)
	end
	for id in RodSkins.Crates do
		player:SetAttribute("RodCrateCount" .. id, state.profile.RodCrates[id] or 0)
	end
	local spearCounts = {}
	for _, copy in state.profile.SpearSkinCopies do
		spearCounts[copy.SkinId] = (spearCounts[copy.SkinId] or 0) + 1
	end
	for id in SpearSkins.Skins do
		player:SetAttribute("SpearSkinCount" .. id, spearCounts[id] or 0)
	end
	player:SetAttribute("SpearSkin", state.profile.EquippedSpearSkin or "")
	player:SetAttribute("SpearSkinSerial", state.profile.EquippedSpearSkinSerial or 0)
	player:SetAttribute("SpearSkinWear", BoatData.equippedSpearWear(state.profile))
	player:SetAttribute("RodSkinWear", BoatData.equippedRodWear(state.profile))
	player:SetAttribute("RodSkin", state.profile.EquippedRodSkin or "")
	player:SetAttribute("RodSkinSerial", state.profile.EquippedRodSkinSerial or 0)
	for id in BobberSkins.Skins do
		player:SetAttribute("BobberSkinCount" .. id, state.profile.BobberSkins[id] or 0)
	end
	player:SetAttribute("BobberSkin", state.profile.EquippedBobberSkin or "")
	local level, levelXP, requiredXP = BoatData.levelProgress(state.profile)
	player:SetAttribute("Level", level)
	player:SetAttribute("LevelXP", levelXP)
	player:SetAttribute("LevelXPRequired", requiredXP)
	-- Match the bestiary's species list, excluding shark drops which are not pages.
	local bestiaryPercent = nil
	if state.status == "Ready" then
		local discovered, total = 0, 0
		for id, species in AnglerCatalog.Fish do
			if not species.DropOnly then
				total += 1
				local entry = state.profile.Angler.Catches[id]
				if entry and (entry.Count or 0) > 0 then
					discovered += 1
				end
			end
		end
		bestiaryPercent = if total > 0 then math.floor(discovered * 100 / total + 0.5) else 0
	end
	player:SetAttribute("BestiaryPercent", bestiaryPercent)

	-- The built-in player list sorts by its first stat. Keep Level primary and
	-- mirror committed profile values here alongside the gameplay attributes.
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		leaderstats = Instance.new("Folder")
		leaderstats.Name = "leaderstats"
	end
	local levelStat = leaderstats:FindFirstChild("Level")
	if not levelStat then
		levelStat = Instance.new("IntValue")
		levelStat.Name = "Level"
		local primary = Instance.new("BoolValue")
		primary.Name, primary.Value = "IsPrimary", true
		primary.Parent = levelStat
	end
	levelStat.Value, levelStat.Parent = level, leaderstats
	local moneyStat = leaderstats:FindFirstChild("Money")
	if not moneyStat then
		moneyStat = Instance.new("IntValue")
		moneyStat.Name = "Money"
	end
	moneyStat.Value, moneyStat.Parent = state.profile.Cash, leaderstats
	leaderstats.Parent = player

	player:SetAttribute("AnglerRevision", (player:GetAttribute("AnglerRevision") or 0) + 1)
end

-- Server modules share the existing atomic store and lock; no client can submit a profile.
function BoatService.getProfile(player: Player)
	local state = profiles[player]
	return if state and state.status == "Ready" then BoatData.decode(state.profile) else nil
end

-- decode(nil) is only valid for a first-time load. An absent save result must
-- never replace a loaded player's live inventory with new-player defaults.
local function committedProfile(saved)
	assert(type(saved) == "table", "Save returned no confirmed player profile")
	return BoatData.decode(saved)
end

-- Multiple gameplay actions can arrive during a DataStore yield. Keep them in
-- arrival order so each sees the last committed profile and publishes in order.
local function acquireSave(player: Player, state): boolean
	state.nextSave = (state.nextSave or 0) + 1
	local ticket = state.nextSave
	while profiles[player] == state and player.Parent == Players do
		if not state.busy and ticket == (state.finishedSaves or 0) + 1 then
			state.busy = true
			return true
		end
		task.wait(0.05)
	end
	return false
end

local function releaseSave(state)
	state.finishedSaves = (state.finishedSaves or 0) + 1
	state.busy = false
end

function BoatService.updateProgress(player: Player, transform, rodSkinId: any, spearSkinIds: any): (boolean, string)
	local state = profiles[player]
	if not state or state.status ~= "Ready" then
		return false, "Your progress is still loading or unavailable."
	end
	if not acquireSave(player, state) then
		return false, "This session has ended."
	end
	local awardedAt = os.time()
	local success, saved = pcall(function()
		local serial
		if type(rodSkinId) == "table" then
			serial = {}
			for _, skinId in rodSkinId do
				assert(RodSkins.valid(skinId), "Unknown serial skin")
				table.insert(serial, RodSerials.reserve(store, skinId))
			end
		else
			assert(rodSkinId == nil or RodSkins.valid(rodSkinId), "Unknown serial skin")
			serial = if rodSkinId then RodSerials.reserve(store, rodSkinId) else nil
		end
		if spearSkinIds then
			assert(rodSkinId == nil and type(spearSkinIds) == "table", "Invalid spear serial request")
			serial = {}
			for _, skinId in spearSkinIds do
				assert(SpearSkins.valid(skinId), "Unknown spear serial skin")
				table.insert(serial, RodSerials.reserve(store, "Spear_" .. skinId))
			end
		end
		if profiles[player] ~= state or player.Parent ~= Players then
			error("This session has ended")
		end
		local result = store:UpdateAsync("Player_" .. player.UserId, function(raw)
			local profile = BoatData.decode(raw)
			assert(profile.RodSerialScope == RodSerials.Scope, "Rod serial migration is required")
			local previous = BoatData.decode(profile)
			transform(profile, serial)
			BoatData.trackProgress(previous, profile, awardedAt)
			return BoatData.decode(profile)
		end)
		return committedProfile(result)
	end)
	if not success then
		releaseSave(state)
		warn("[Angler] Save failed for " .. player.UserId .. ": " .. tostring(saved))
		return false, "Your change could not be saved. Please try again."
	end
	if profiles[player] ~= state or player.Parent ~= Players then
		releaseSave(state)
		return false, "This session has ended."
	end
	state.profile = saved
	publish(player, state)
	releaseSave(state)
	return true, "Saved."
end

local function loadPlayer(player: Player)
	if profiles[player] then
		return
	end
	local state = { profile = BoatData.decode(nil), status = "Loading", busy = false }
	profiles[player] = state
	publish(player, state)
	for attempt = 1, 3 do
		local success, result = pcall(function()
			local key = "Player_" .. player.UserId
			local loaded = BoatData.decode(store:GetAsync(key))
			return RodSerials.migrate(store, key, loaded)
		end)
		if profiles[player] ~= state then
			return
		end
		if success then
			state.profile, state.status = result, "Ready"
			publish(player, state)
			return
		end
		warn("[Boats] Could not load player " .. player.UserId .. ": " .. tostring(result))
		if attempt < 3 then
			task.wait(attempt)
		end
	end
	state.status = "Unavailable"
	publish(player, state)
	notify(player, "Boat data could not load. Rejoin to try again.")
end

local function nearPrompt(player: Player, prompt: ProximityPrompt): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local part = prompt.Parent
	return root ~= nil
		and root:IsA("BasePart")
		and humanoid ~= nil
		and humanoid.Health > 0
		and part ~= nil
		and part:IsA("BasePart")
		and (root.Position - part.Position).Magnitude <= prompt.MaxActivationDistance + 2
end

-- Talking and buying require being inside the hall with a clear view of the shipwright.
local function shopPrompt(player: Player): ProximityPrompt?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return nil
	end
	for _, shop in CollectionService:GetTagged("BoatShop") do
		if not shop:IsDescendantOf(workspace) then
			continue
		end
		local frame, size = shop:GetAttribute("InteriorFrame"), shop:GetAttribute("InteriorSize")
		if typeof(frame) ~= "CFrame" or typeof(size) ~= "Vector3" then
			continue
		end
		local position = frame:PointToObjectSpace(root.Position)
		if
			math.abs(position.X) > size.X / 2
			or math.abs(position.Y) > size.Y / 2
			or math.abs(position.Z) > size.Z / 2
		then
			continue
		end
		local prompt = shop:FindFirstChild("TalkToShipwrightPrompt", true)
		if not prompt or not prompt:IsA("ProximityPrompt") or not nearPrompt(player, prompt) then
			continue
		end
		local npc = prompt:FindFirstAncestorOfClass("Model")
		if not npc or not npc:FindFirstChildOfClass("Humanoid") then
			continue
		end
		local parameters = RaycastParams.new()
		parameters.FilterType = Enum.RaycastFilterType.Exclude
		parameters.FilterDescendantsInstances = { character }
		local head = character:FindFirstChild("Head")
		local eye = if head and head:IsA("BasePart") then head.Position else root.Position
		local result = workspace:Raycast(eye, prompt.Parent.Position - eye, parameters)
		if not result or result.Instance:IsDescendantOf(npc) then
			return prompt
		end
	end
	return nil
end

local function openShop(player: Player, expectedPrompt: ProximityPrompt?, boatId: string?)
	if launching[player] then
		return
	end
	local prompt = shopPrompt(player)
	if not prompt or (expectedPrompt and prompt ~= expectedPrompt) then
		return
	end
	local shop = prompt:FindFirstAncestorOfClass("Model")
	while shop and not CollectionService:HasTag(shop, "BoatShop") do
		shop = shop:FindFirstAncestorOfClass("Model")
	end
	if shop then
		feedback:FireClient(player, "OpenShop", shop, boatId or "Rowboat")
	end
end

local function readyState(player: Player)
	local state = profiles[player]
	if not state or state.status ~= "Ready" then
		notify(player, "Boat data is unavailable or still loading. Please try again shortly.")
		return nil
	end
	return state
end

-- This handler is server-only; the sender comes from TextChatCommand's TextSource.
function BoatService.setCashFromCommand(player: Player, message: string)
	if player.UserId ~= COMMAND_USER_ID then
		return
	end
	local digits = message:match("^/set%s+cash%s+(%d+)%s*$")
	local amount = digits and tonumber(digits)
	if not amount or amount < 0 or amount >= 2 ^ 53 or amount % 1 ~= 0 then
		notify(player, "Usage: /set cash <amount> (a non-negative whole number below 9007199254740992).")
		return
	end
	local state = readyState(player)
	if not state then
		return
	end
	if not acquireSave(player, state) then
		return
	end
	local success, saved = pcall(function()
		local result = store:UpdateAsync("Player_" .. player.UserId, function(raw)
			local profile = BoatData.decode(raw)
			profile.Cash = amount
			return profile
		end)
		return committedProfile(result)
	end)
	if not success then
		releaseSave(state)
		warn("[Wallet] Set cash failed for " .. player.UserId .. ": " .. tostring(saved))
		notify(player, "Cash could not be saved. Please try again.")
		return
	end
	local valid, profile = pcall(BoatData.decode, saved)
	if not valid or profiles[player] ~= state or player.Parent ~= Players then
		releaseSave(state)
		return
	end
	state.profile = profile
	publish(player, state)
	releaseSave(state)
	notify(player, "Cash set to $" .. tostring(profile.Cash) .. ".")
end

local function setFromCommand(player: Player, message: string)
	if player.UserId ~= COMMAND_USER_ID then
		return
	end
	local normalized = string.lower(message)
	local subject = normalized:match("^/set%s+(%S+)")
	if subject == "season" then
		local Seasons = require(ReplicatedStorage.Shared.Seasons)
		local argument = (normalized:match("^/set%s+season%s+(%a+)%s*$") or ""):lower()
		if argument == "auto" then
			workspace:SetAttribute("SeasonOverride", nil)
			notify(player, "Seasons follow the clock again.")
			return
		end
		for _, season in Seasons.ORDER do
			if string.lower(season) == argument then
				workspace:SetAttribute("SeasonOverride", season)
				notify(player, "Season set to " .. season .. ".")
				return
			end
		end
		notify(player, "Usage: /set season <spring|summer|autumn|winter|auto>.")
		return
	end
	if subject == "date" then
		local Calendar = require(ReplicatedStorage.Shared.Calendar)
		local argument = normalized:match("^/set%s+date%s+(.-)%s*$") or ""
		if argument == "auto" then
			workspace:SetAttribute("CalendarOffset", nil)
			notify(player, "The date follows the shared calendar again: " .. Calendar.format(Calendar.now()) .. ".")
			return
		end
		local month, day, hour = Calendar.parse(argument)
		if not month then
			notify(player, "Usage: /set date <month-day> [hh:mm], e.g. /set date 10-31 23:50, or /set date auto.")
			return
		end
		-- Shift the calendar so it reads that moment now, then let it run on from there.
		workspace:SetAttribute("CalendarOffset", nil)
		local today = Calendar.now()
		local target = Calendar.elapsedAt(today.Year, month, day :: number, hour or today.Hour)
		workspace:SetAttribute("CalendarOffset", target - Calendar.elapsedAt(today.Year, today.Month, today.Day, today.Hour))
		local date = Calendar.now()
		local clock = date.Hour
		notify(player, string.format("Date set to %s, %02d:%02d.", Calendar.format(date), math.floor(clock), math.floor(clock % 1 * 60)))
		return
	end
	if subject ~= "weather" then
		BoatService.setCashFromCommand(player, message)
		return
	end
	local argument = normalized:match("^/set%s+weather%s+(.+)") or ""
	argument = argument:gsub("%s+", "")
	local kinds = {}
	local selected
	for kind in Weather.Presets do
		if kind ~= "BlackHole" then
			table.insert(kinds, kind)
			if string.lower(kind) == argument then
				selected = kind
			end
		end
	end
	table.sort(kinds)
	if argument == "list" then
		notify(player, "Weather types: " .. table.concat(kinds, ", ") .. ".")
	elseif selected then
		workspace:SetAttribute("BlackHolePosition", nil)
		-- A summoned supercell circles the admin who called it.
		local root = player.Character and player.Character.PrimaryPart
		local summoned = selected == "Supercell" and root
		workspace:SetAttribute(
			"SupercellPosition",
			if summoned then Vector3.new(root.Position.X, Biomes.WaterLevel, root.Position.Z) else nil
		)
		workspace:SetAttribute("SupercellSince", if selected == "Supercell" then workspace:GetServerTimeNow() else nil)
		workspace:SetAttribute("WeatherOverride", selected)
		notify(player, "Weather set to " .. selected .. ".")
	else
		notify(player, "Usage: /set weather <type>. Use /set weather list for available types.")
	end
end

local function boatOccupied(player: Player): boolean
	local boat = active[player]
	if boat then
		for _, piece in boat.model:GetDescendants() do
			if (piece:IsA("Seat") or piece:IsA("VehicleSeat")) and piece.Occupant then
				return true
			end
		end
	end
	return false
end

local function lockedNotice(spec): string
	return "The " .. spec.Name .. " unlocks with the " .. spec.RequiresPath .. " path. Unlock it in Home ▸ Paths."
end

local function purchase(player: Player, boatId: string?)
	local id = boatId or "Rowboat"
	local spec = BoatCatalog[id]
	if not spec then
		return
	end
	local prompt = shopPrompt(player)
	if not prompt then
		return
	end
	local state = readyState(player)
	if not state or launching[player] or not acquireSave(player, state) then
		return
	end
	if launching[player] then
		releaseSave(state)
		return
	end
	if shopPrompt(player) ~= prompt then
		releaseSave(state)
		return
	end
	if state.profile.OwnedBoats[id] then
		releaseSave(state)
		notify(player, "You already own the " .. spec.Name .. ". Spawn it at your own dock.")
		return
	end
	if BoatData.pathLocked(state.profile, id) then
		releaseSave(state)
		notify(player, lockedNotice(spec))
		return
	end
	if boatOccupied(player) then
		releaseSave(state)
		notify(player, "Everyone must leave your current boat before launching a new purchase.")
		return
	end
	if state.profile.Cash < spec.Price then
		releaseSave(state)
		notify(player, "You need $" .. spec.Price .. " for the " .. spec.Name .. ".")
		return
	end
	local shop = prompt:FindFirstAncestorOfClass("Model")
	while shop and not CollectionService:HasTag(shop, "BoatShop") do
		shop = shop:FindFirstAncestorOfClass("Model")
	end
	if not shop then
		releaseSave(state)
		return
	end
	local reservation, reason = DrydockLaunch.reserve(shop, player, id)
	if not reservation then
		releaseSave(state)
		notify(player, reason)
		return
	end
	launching[player] = reservation
	local success, saved = pcall(function()
		local result = store:UpdateAsync("Player_" .. player.UserId, function(raw)
			local profile = BoatData.purchase(raw, id)
			return profile
		end)
		return committedProfile(result)
	end)
	if not success then
		releaseSave(state)
		launching[player] = nil
		DrydockLaunch.release(reservation)
		warn("[Boats] Purchase failed for " .. player.UserId .. ": " .. tostring(saved))
		notify(player, "The purchase could not be confirmed. Please try again.")
		return
	end
	-- Both the deduction and ownership are committed in one atomic store update.
	local valid, profile = pcall(BoatData.decode, saved)
	if not valid or profiles[player] ~= state or player.Parent ~= Players then
		releaseSave(state)
		launching[player] = nil
		DrydockLaunch.release(reservation)
		return
	end
	state.profile = profile
	publish(player, state)
	releaseSave(state)
	if profile.OwnedBoats[id] then
		-- The launch camera follows the lowering, after the cradle has risen.
		shop:SetAttribute("LaunchStartedAt", workspace:GetServerTimeNow() + DrydockLaunch.RAISE_SECONDS)
		feedback:FireClient(player, "LaunchStarted", shop, id)
		task.spawn(function()
			local launched, result = pcall(function()
				return DrydockLaunch.run(reservation, launchPurchased)
			end)
			DrydockLaunch.release(reservation)
			launching[player] = nil
			if player.Parent == Players then
				feedback:FireClient(player, "LaunchFinished")
				if not launched or not result then
					notify(
						player,
						"Your " .. spec.Name .. " is saved. Use your plot's boat stand if boarding was interrupted."
					)
				end
			end
			if not launched then
				warn("[Boats] Drydock launch interrupted: " .. tostring(result))
			end
		end)
	else
		launching[player] = nil
		DrydockLaunch.release(reservation)
		notify(
			player,
			if BoatData.pathLocked(profile, id)
				then lockedNotice(spec)
				else "You need $" .. spec.Price .. " for the " .. spec.Name .. "."
		)
	end
end

local function removeBoat(player: Player)
	local boat = active[player]
	if boat then
		active[player] = nil
		player:SetAttribute("ActiveBoatId", nil)
		boat.model:Destroy()
	end
end

-- Puts the player's launched boat away when it is `boatId` and nobody is aboard.
function BoatService.stowBoat(player: Player, boatId: string): boolean
	local boat = active[player]
	if not boat or boat.model:GetAttribute("BoatId") ~= boatId then
		return true
	elseif boatOccupied(player) or launching[player] then
		return false
	end
	removeBoat(player)
	return true
end

-- `check(player, boatId)` returns a reason when another system (the hired
-- fisherman) is using that boat, so the dock cannot launch a second copy.
function BoatService.setBoatLock(check: (Player, string) -> string?)
	boatLock = check
end

-- `outfit(player, boatId, model)` dresses one of the player's hulls with their
-- refit dock paint and returns the spec its motors and rudders tune it to.
-- Refits tune the spec per player; the driving client reads it from the hull.
local function publishDriveSpec(boat)
	for _, field in BoatDrive.FIELDS do
		boat.model:SetAttribute("Drive" .. field, boat.spec[field])
	end
end

function BoatService.setOutfitter(outfit: (Player, string, Model) -> any)
	outfitter = outfit
end

-- The spec a player's hull drives with, after dressing `model` for them.
function BoatService.outfit(player: Player, boatId: string, model: Model)
	return outfitter and outfitter(player, boatId, model) or BoatCatalog[boatId]
end

-- Reapplies refits to the launched boat once a motor, rudder or paint is saved.
function BoatService.refit(player: Player)
	local boat = active[player]
	if boat and boat.model.Parent then
		boat.spec = BoatService.outfit(player, boat.model:GetAttribute("BoatId"), boat.model)
		publishDriveSpec(boat)
	end
end

-- The player's launched boat, whose cargo hold they can reach.
function BoatService.activeBoat(player: Player): (string?, Model?)
	local boat = active[player]
	if boat and boat.model.Parent then
		return boat.model:GetAttribute("BoatId"), boat.model
	end
	return nil, nil
end

-- Apply damage from server systems to an active hull, without affecting cargo.
function BoatService.damageBoat(player: Player, amount: number): boolean
	local boat = active[player]
	if
		not boat
		or not boat.model.Parent
		or type(amount) ~= "number"
		or amount <= 0
		or amount ~= amount
		or amount == math.huge
	then
		return false
	end
	local health = boat.model:GetAttribute("Health")
	if type(health) ~= "number" or health <= 0 then
		return false
	end
	boat.model:SetAttribute("Health", math.max(0, health - amount))
	return true
end

local updateSuspension = BoatDrive.updateSuspension

-- The driver's client simulates its own hull while at the helm (see client/BoatDriving),
-- so steering answers without a server round trip and the boat is not an interpolated
-- replica that stalls whenever the connection is busy streaming the map. The server keeps
-- the hull whenever nobody drives it, and for parking, sinking, lifts and tornadoes.
local function setDriver(boat, driver: Player?)
	if boat.driver == driver then
		return
	end
	boat.driver = driver
	if not boat.parked then
		boat.root:SetNetworkOwner(driver)
	end
	-- The client starts its own bank spring from level, and ours restarts from level too.
	boat.bank, boat.bankVelocity = 0, 0
	if driver then
		publishDriveSpec(boat)
	else
		-- Our heading target went stale while the client steered.
		local look = boat.root.CFrame.LookVector
		if math.abs(look.X) + math.abs(look.Z) > 0.01 then
			boat.yaw = math.atan2(-look.X, -look.Z)
		end
	end
	boat.model:SetAttribute("DriverUserId", if driver then driver.UserId else nil)
end

-- A seated avatar should not push the hull below its waterline. Preserve the
-- original values, including accessories added while seated, and restore them
-- as soon as the rider leaves or the boat is removed.
local function protectSeatFromRiderWeight(seat: Seat | VehicleSeat)
	local saved = {}
	local addedConnection
	local function restore()
		if addedConnection then
			addedConnection:Disconnect()
			addedConnection = nil
		end
		for part, massless in saved do
			part.Massless = massless
		end
		table.clear(saved)
	end
	local function update()
		restore()
		local humanoid = seat.Occupant
		local character = humanoid and humanoid.Parent
		if not character or not Players:GetPlayerFromCharacter(character) then
			return
		end
		local function makeMassless(part)
			if part:IsA("BasePart") and saved[part] == nil then
				saved[part] = part.Massless
				part.Massless = true
			end
		end
		for _, part in character:GetDescendants() do
			makeMassless(part)
		end
		addedConnection = character.DescendantAdded:Connect(makeMassless)
	end
	seat:GetPropertyChangedSignal("Occupant"):Connect(update)
	seat.Destroying:Connect(restore)
	update()
end

local function clearMotion(boat)
	for _, piece in boat.model:GetDescendants() do
		if piece:IsA("BasePart") then
			piece.AssemblyLinearVelocity = Vector3.zero
			piece.AssemblyAngularVelocity = Vector3.zero
		end
	end
end

local function setParked(boat, parked: boolean)
	if boat.parked == parked then
		return
	end
	-- Anchoring resets ownership, and every release starts on the server.
	setDriver(boat, nil)
	boat.parked = parked
	if parked then
		-- A standing character is a separate, client-simulated assembly. Keeping
		-- an idle hull dynamic lets its contacts fight our server-side movers.
		-- Anchor only the hull root, leaving deck collisions and seats usable.
		boat.speed, boat.turn = 0, 0
		boat.bank, boat.bankVelocity = 0, 0
		boat.velocity.PlaneVelocity = Vector2.zero
		clearMotion(boat)
		-- Anchor every piece, not just the root. A standing player is carried by the
		-- velocity of the part underfoot, so no deck piece may keep a stray drift.
		for _, piece in boat.model:GetDescendants() do
			if piece:IsA("BasePart") then
				piece.Anchored = true
			end
		end
		boat.model:SetAttribute("RowThrottle", 0)
		boat.model:SetAttribute("RowSteer", 0)
		-- Clients bob the anchored hull locally from this pose and swell clock.
		boat.model:SetAttribute("ParkedFrame", boat.root.CFrame)
		boat.model:SetAttribute("ParkedAt", workspace:GetServerTimeNow())
		boat.model:SetAttribute("WaterlineRootOffset", boat.waterlineOffset)
	else
		-- Release from the pose clients have bobbed it to, so riders see no snap.
		local rest, parkedAt = boat.model:GetAttribute("ParkedFrame"), boat.model:GetAttribute("ParkedAt")
		if rest and parkedAt then
			boat.model:PivotTo(
				Weather.parkedOffset(
					rest,
					parkedAt,
					workspace:GetServerTimeNow(),
					boat.model:GetAttribute("DryFloorHeight"),
					boat.model:GetAttribute("DryFloorHalfBeam"),
					boat.model:GetAttribute("DryFloorHalfLength"),
					boat.waterlineOffset
				) * boat.model:GetPivot()
			)
		end
		for _, piece in boat.model:GetDescendants() do
			if piece:IsA("BasePart") then
				piece.Anchored = false
			end
		end
		-- Anchoring resets network ownership. Reapply it after releasing the
		-- hull, before enabling forces, so boarding cannot change its simulator.
		boat.root:SetNetworkOwner(nil)
	end
	boat.float.Enabled = not parked
	boat.lift.Enabled = not parked
	boat.heading.Enabled = not parked
	boat.velocity.Enabled = not parked
	boat.model:SetAttribute("Parked", parked)
end

-- Tornadoes throw boats. The hull's movers let go while the vortex spirals it up
-- the funnel, then hurl it outward; they take over again once it falls back to
-- the sea. Deterministic tornado tracks keep this where clients draw the funnel.
local FLING_LIFT_SECONDS = 0.9
local FLING_MAX_SECONDS = 5
local FLING_COOLDOWN = 4

local function setMovers(boat, enabled: boolean)
	boat.float.Enabled = enabled
	boat.lift.Enabled = enabled
	boat.heading.Enabled = enabled
	boat.velocity.Enabled = enabled
end

local function catchInTornado(boat, tornadoes): boolean
	if boat.flight or os.clock() - (boat.flungAt or -math.huge) < FLING_COOLDOWN then
		return false
	end
	local position = boat.root.Position
	for _, tornado in tornadoes do
		local dx, dz = position.X - tornado.position.X, position.Z - tornado.position.Z
		local reach = tornado.radius * Weather.TornadoReach
		if tornado.strength > 0.25 and dx * dx + dz * dz <= reach * reach then
			if boat.parked then
				setParked(boat, false)
			end
			setDriver(boat, nil)
			boat.speed, boat.turn = 0, 0
			boat.bank, boat.bankVelocity = 0, 0
			boat.velocity.PlaneVelocity = Vector2.zero
			setMovers(boat, false)
			boat.flight = { id = tornado.id, center = tornado.position, radius = tornado.radius, started = os.clock() }
			boat.flight.strength = math.max(0.6, tornado.strength)
			return true
		end
	end
	return false
end

-- True while the tornado still owns the hull.
local function updateFlight(boat, tornadoes): boolean
	local flight = boat.flight
	local root = boat.root
	local age = os.clock() - flight.started
	for _, tornado in tornadoes do
		if tornado.id == flight.id then
			flight.center = tornado.position
		end
	end
	local offset = Vector3.new(root.Position.X - flight.center.X, 0, root.Position.Z - flight.center.Z)
	local distance = offset.Magnitude
	local outward = if distance > 0.1 then offset / distance else Vector3.xAxis
	-- Counter-clockwise from above, like the cyclonic cell above it.
	local around = Vector3.yAxis:Cross(outward)
	local strength = flight.strength
	if age < FLING_LIFT_SECONDS then
		root.AssemblyLinearVelocity = around * 55 * strength
			+ Vector3.new(0, 40 + 30 * strength, 0)
			- outward * (distance - flight.radius) * 2
		root.AssemblyAngularVelocity = Vector3.new(1.4, 3.8, 0.9) * strength
		return true
	elseif not flight.thrown then
		flight.thrown = true
		root.AssemblyLinearVelocity = around * 70 * strength
			+ outward * 45 * strength
			+ Vector3.new(0, 45 * strength, 0)
		return true
	end
	local falling = root.AssemblyLinearVelocity.Y <= 0
	if (falling and root.Position.Y <= Biomes.WaterLevel + 6) or age > FLING_MAX_SECONDS then
		boat.flight = nil
		boat.flungAt = os.clock()
		local look = root.CFrame.LookVector
		if Vector2.new(look.X, look.Z).Magnitude > 0.01 then
			boat.yaw = math.atan2(-look.X, -look.Z)
		end
		boat.float.Position = root.Position
		setMovers(boat, true)
		return false
	end
	return true
end

-- Holds the launched boat on the drydock lift: parked, upright, deaf to the helm and
-- `height` studs above where it floated. nil sets it back afloat at that pose.
function BoatService.hoist(player: Player, height: number?): boolean
	local boat = active[player]
	if not boat or not boat.model.Parent or (not height and not boat.hoistBase) then
		return false
	end
	if not boat.hoistBase then
		setDriver(boat, nil)
		setParked(boat, true)
		local look = boat.root.CFrame.LookVector
		boat.hoistBase = CFrame.new(boat.root.Position) * CFrame.Angles(0, math.atan2(-look.X, -look.Z), 0)
		boat.model:SetAttribute("Hoisted", true)
	end
	local target = boat.hoistBase + Vector3.new(0, height or 0, 0)
	boat.model:PivotTo(target * boat.root.CFrame:ToObjectSpace(boat.model:GetPivot()))
	-- Clients bob a parked hull from this pose, and the helm releases from it.
	boat.model:SetAttribute("ParkedFrame", boat.root.CFrame)
	boat.model:SetAttribute("ParkedAt", workspace:GetServerTimeNow())
	if not height then
		boat.hoistBase = nil
		boat.model:SetAttribute("Hoisted", nil)
	end
	return true
end

local function launch(player: Player, frame: CFrame, existing: Model?, boatId: string?)
	local id = boatId or (existing and existing:GetAttribute("BoatId")) or "Rowboat"
	local model = existing or builders[id].build(frame, false)
	local spec = BoatService.outfit(player, id, model)
	model.Name = id .. "_" .. player.UserId
	model:SetAttribute("OwnerUserId", player.UserId)
	model:SetAttribute("BoatId", id)
	-- Each launched hull starts at full health; attributes replicate to everyone aboard.
	model:SetAttribute("MaxHealth", BoatCatalog[id].MaxHealth)
	model:SetAttribute("Health", BoatCatalog[id].MaxHealth)
	model:SetAttribute("LightsEnabled", true)
	-- Server time, for the driving client: a fresh hull may start in a dry slipway.
	model:SetAttribute("LaunchGraceUntil", if existing then workspace:GetServerTimeNow() + 10 else nil)
	local lights, lightParts = {}, {}
	for _, piece in model:GetDescendants() do
		if piece:IsA("PointLight") or piece:IsA("SpotLight") or piece:IsA("SurfaceLight") then
			table.insert(lights, piece)
		elseif piece:IsA("BasePart") and piece.Material == Enum.Material.Neon then
			table.insert(lightParts, piece)
		end
	end
	local root = model.PrimaryPart :: BasePart
	local seat = model:FindFirstChild(spec.DriverSeat, true) :: VehicleSeat
	model:SetAttribute("DisplayOnly", nil)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	if existing then
		BoatLaunchCollision.protect(model, 10)
		for _, piece in model:GetDescendants() do
			if piece:IsA("BasePart") then
				piece.Anchored = false
				local collide = piece:GetAttribute("PreviewCanCollide")
				if collide ~= nil then
					piece.CanCollide = collide
				end
				piece:SetAttribute("PreviewCanCollide", nil)
				if piece:IsA("Seat") or piece:IsA("VehicleSeat") then
					piece.Disabled = false
					piece.CanTouch = true
				end
			end
		end
		seat.Disabled = false
		seat.CanTouch = true
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "BoatMotion"
	attachment.Parent = root

	local float = Instance.new("AlignPosition")
	float.Name = "Waterline"
	float.Mode = Enum.PositionAlignmentMode.OneAttachment
	float.Attachment0 = attachment
	float.ApplyAtCenterOfMass = true
	float.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	float.ForceRelativeTo = Enum.ActuatorRelativeTo.World
	float.Position = root.Position
	-- Rigid alignment ignores the per-axis limits and can fight horizontal
	-- propulsion and deck contacts. Only the bounded Y suspension lifts boats.
	float.RigidityEnabled = false
	float.Responsiveness = 20
	float.MaxVelocity = 6
	float.Parent = root

	local lift = Instance.new("VectorForce")
	lift.Name = "WeightSupport"
	lift.Attachment0 = attachment
	lift.RelativeTo = Enum.ActuatorRelativeTo.World
	lift.ApplyAtCenterOfMass = true
	lift.Parent = root

	local heading = Instance.new("AlignOrientation")
	heading.Name = "UprightHeading"
	heading.Mode = Enum.OrientationAlignmentMode.OneAttachment
	heading.Attachment0 = attachment
	heading.CFrame = root.CFrame.Rotation
	heading.MaxAngularVelocity = spec.TurnRate + 2
	heading.RigidityEnabled = false
	heading.Responsiveness = 20
	heading.Parent = root

	-- Drive at the current center of mass; passengers can move it away from
	-- the hull root. The horizontal velocity below makes the stern the pivot.
	local driveAttachment = Instance.new("Attachment")
	driveAttachment.Name = "BoatDrive"
	driveAttachment.Parent = root
	local velocity = Instance.new("LinearVelocity")
	velocity.Name = "Rowing"
	velocity.Attachment0 = driveAttachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	velocity.PrimaryTangentAxis = Vector3.xAxis
	velocity.SecondaryTangentAxis = Vector3.zAxis
	velocity.PlaneVelocity = Vector2.zero
	velocity.ForceLimitsEnabled = true
	velocity.ForceLimitMode = Enum.ForceLimitMode.Magnitude
	velocity.Parent = root

	model.Parent = workspace:FindFirstChild("PlayerBoats")
	root:SetNetworkOwner(nil)
	for _, piece in model:GetDescendants() do
		if piece:IsA("Seat") or piece:IsA("VehicleSeat") then
			protectSeatFromRiderWeight(piece)
		end
	end
	local _, yaw = root.CFrame:ToOrientation()
	local boat = {
		spec = spec,
		model = model,
		lights = lights,
		lightParts = lightParts,
		root = root,
		seat = seat,
		heading = heading,
		float = float,
		lift = lift,
		velocity = velocity,
		driveAttachment = driveAttachment,
		-- Each hull's physical root is below its waterline. Preserve that local
		-- offset when the hull tilts, so its waterline follows the sampled surface.
		waterlineOffset = frame:PointToObjectSpace(root.Position),
		yaw = yaw,
		speed = 0,
		bank = 0,
		bankVelocity = 0,
		throttle = 0,
		steer = 0,
		lastInput = 0,
		lastWaterCheck = 0,
		clearWater = true,
		launchGraceUntil = if existing then os.clock() + 10 else 0,
	}
	updateSuspension(boat)
	setParked(boat, true)
	active[player] = boat
	player:SetAttribute("ActiveBoatId", id)
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		boat.throttle, boat.steer = 0, 0
		local humanoid = seat.Occupant
		if humanoid and Players:GetPlayerFromCharacter(humanoid.Parent) ~= player then
			task.defer(function()
				if humanoid.Parent then
					humanoid.Sit = false
				end
			end)
		end
	end)
	return boat
end

launchPurchased = function(player: Player, frame: CFrame, model: Model)
	removeBoat(player)
	local boat = launch(player, frame, model)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root then
		return false
	end
	-- Request streaming while the launch camera remains active. Failure to stream
	-- is bounded and does not undo an already committed purchase.
	pcall(function()
		player:RequestStreamAroundAsync(boat.root.Position, 3)
	end)
	for _ = 1, 8 do
		if player.Character ~= character or humanoid.Health <= 0 or not boat.model.Parent then
			return false
		end
		character:PivotTo(boat.seat.CFrame + Vector3.new(0, 3, 0))
		root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
		boat.seat:Sit(humanoid)
		task.wait(0.15)
		if boat.seat.Occupant == humanoid then
			notify(player, "Your " .. boat.spec.Name .. " is afloat! Use movement controls to sail to your plot.")
			return true
		end
	end
	notify(player, "Your " .. boat.spec.Name .. " is afloat beside the slipway. Sit in the driver's seat to sail.")
	return true
end

local function dockBase(player: Player, prompt: ProximityPrompt): Model?
	if not prompt:IsDescendantOf(workspace) or not nearPrompt(player, prompt) then
		return nil
	end
	local base = prompt:FindFirstAncestorOfClass("Model")
	while base and not CollectionService:HasTag(base, "PlayerBase") and not CollectionService:HasTag(base, "CompanyIsland") do
		base = base:FindFirstAncestorOfClass("Model")
	end
	if
		not base
		or base:GetAttribute("OwnerUserId") ~= player.UserId
		or (not CollectionService:HasTag(base, "CompanyIsland") and base:GetAttribute("BaseId") ~= player:GetAttribute("BaseId"))
	then
		notify(player, "You can only spawn boats at your own dock.")
		return nil
	end
	return base
end

local function openDock(player: Player, prompt: ProximityPrompt)
	local base = dockBase(player, prompt)
	if base then
		feedback:FireClient(player, "OpenDock", base)
	end
end

local function spawnBoat(player: Player, prompt: ProximityPrompt, boatId: string?)
	local id = boatId or "Rowboat"
	local spec = BoatCatalog[id]
	if not spec then
		return
	end
	if launching[player] then
		notify(player, "Your boat is being lowered at the drydock. Please wait.")
		return
	end
	local base = dockBase(player, prompt)
	if not base then
		return
	end
	local state = readyState(player)
	if not state then
		return
	end
	if not state.profile.OwnedBoats[id] then
		notify(player, "Buy the " .. spec.Name .. " at the plaza drydock first.")
		return
	end
	local locked = boatLock and boatLock(player, id)
	if locked then
		notify(player, locked)
		return
	end
	if os.clock() - (spawnTimes[player] or -math.huge) < 4 then
		return
	end
	local previous = active[player]
	if boatOccupied(player) then
		notify(player, "Everyone must leave your boat before spawning another one.")
		return
	end
	local marker = base:FindFirstChild("BoatSpawn")
	if not marker or not marker:IsA("BasePart") then
		return
	end
	-- Keep the stern clear of the dock when a larger hull uses an older marker.
	local extraLength = math.max(0, (spec.Length - BoatCatalog.Rowboat.Length) / 2)
	local spawnFrame = marker.CFrame + marker.CFrame.LookVector * extraLength
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = if previous then { previous.model, marker } else { marker }
	local bounds = Vector3.new(math.max(11, spec.Beam + 2), 16, spec.Length + 1)
	for _, part in workspace:GetPartBoundsInBox(spawnFrame + Vector3.new(0, 6, 0), bounds, overlap) do
		if part.CanCollide then
			notify(player, "The launch space is blocked. Clear the water in front of your dock.")
			return
		end
	end
	spawnTimes[player] = os.clock()
	removeBoat(player)
	launch(player, spawnFrame, nil, id)
	notify(player, spec.Name .. " launched. Jump aboard and sit in the driver's seat to sail.")
end

local function buildPreviews(parent: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "Previews"
	for id, builder in builders do
		local model = builder.build(CFrame.identity, true)
		model.Name = id
		for _, item in model:GetDescendants() do
			if item:IsA("BasePart") then
				item.Anchored = true
				item.CanCollide, item.CanTouch, item.CanQuery = false, false, false
			elseif
				item:IsA("Constraint")
				or item:IsA("JointInstance")
				or item:IsA("ClickDetector")
				or item:IsA("ProximityPrompt")
				or item:IsA("BaseScript")
				or item:IsA("Sound")
			then
				item:Destroy()
			end
		end
		model.Parent = folder
	end
	-- Publish completed templates once; the dock does not need the shipyard streamed in.
	folder.Parent = parent
end

function BoatService.start()
	if started then
		return
	end
	started = true
	BoatLaunchCollision.start()
	local boats = Instance.new("Folder")
	boats.Name = "PlayerBoats"
	boats.Parent = workspace
	local remotes = Instance.new("Folder")
	remotes.Name = "Boating"
	remotes.Parent = ReplicatedStorage
	local request = Instance.new("RemoteEvent")
	request.Name = "Request"
	request.Parent = remotes
	feedback = Instance.new("RemoteEvent")
	feedback.Name = "Feedback"
	feedback.Parent = remotes
	buildPreviews(remotes)

	local setCommand = Instance.new("TextChatCommand")
	setCommand.Name = "SetCommand"
	setCommand.PrimaryAlias = "/set"
	setCommand.AutocompleteVisible = false
	setCommand.Triggered:Connect(function(source, message)
		local player = source and Players:GetPlayerByUserId(source.UserId)
		if player then
			setFromCommand(player, message)
		end
	end)
	setCommand.Parent = TextChatService
	AdminCommands.start(function(player, message)
		if player.Parent == Players then
			feedback:FireClient(player, "CommandNotice", message)
		end
	end)

	request.OnServerEvent:Connect(function(player, action, throttle, steer)
		if action == "Row" then
			local boat = active[player]
			if not boat or not boat.seat.Occupant or boat.seat.Occupant.Parent ~= player.Character then
				return
			end
			if
				type(throttle) ~= "number"
				or type(steer) ~= "number"
				or throttle ~= throttle
				or steer ~= steer
				or math.abs(throttle) > 1
				or math.abs(steer) > 1
			then
				return
			end
			-- Always keep the newest input. Network jitter bunches packets, and
			-- dropping the later one left a released key held until the next send.
			boat.throttle, boat.steer, boat.lastInput = throttle, steer, os.clock()
		elseif action == "ToggleLights" then
			local boat = active[player]
			if not boat or not boat.seat.Occupant or boat.seat.Occupant.Parent ~= player.Character then
				return
			end
			local now = os.clock()
			if now - (boat.lastLightsToggle or -math.huge) < 0.2 then
				return
			end
			boat.lastLightsToggle = now
			local enabled = boat.model:GetAttribute("LightsEnabled") == false
			for _, light in boat.lights do
				light.Enabled = enabled
			end
			for _, part in boat.lightParts do
				part.Material = if enabled then Enum.Material.Neon else Enum.Material.SmoothPlastic
			end
			boat.model:SetAttribute("LightsEnabled", enabled)
		elseif action == "BrowseRowboat" then
			openShop(player)
		elseif action == "BrowseBoat" then
			if type(throttle) == "string" and BoatCatalog[throttle] then
				openShop(player, nil, throttle)
			end
		elseif action == "PurchaseRowboat" or action == "PurchaseBoat" then
			local id = if action == "PurchaseRowboat" then "Rowboat" else throttle
			if type(id) ~= "string" or not BoatCatalog[id] then
				return
			end
			if os.clock() - (requests[player] or -math.huge) < 1 then
				return
			end
			requests[player] = os.clock()
			purchase(player, id)
		elseif action == "SpawnBoat" then
			if type(throttle) ~= "string" or not BoatCatalog[throttle] then
				return
			end
			for _, tag in { "PlayerBase", "CompanyIsland" } do
				for _, base in CollectionService:GetTagged(tag) do
					if base:GetAttribute("OwnerUserId") == player.UserId then
						local prompt = base:FindFirstChild("SpawnRowboatPrompt", true)
						if prompt and prompt:IsA("ProximityPrompt") and nearPrompt(player, prompt) then
							spawnBoat(player, prompt, throttle)
							return
						end
					end
				end
			end
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		if prompt.Name == "TalkToShipwrightPrompt" then
			openShop(player, prompt)
		elseif prompt.Name == "SpawnRowboatPrompt" then
			openDock(player, prompt)
		end
	end)
	-- Update mover targets before the solver, so each physics step uses one
	-- coherent set of steering, banking and buoyancy commands.
	RunService.PreSimulation:Connect(function(dt)
		local serverTime = workspace:GetServerTimeNow()
		local tornadoes = Weather.tornadoes(serverTime)
		local weather = nil
		for player, boat in active do
			if not boat.model.Parent then
				active[player] = nil
				player:SetAttribute("ActiveBoatId", nil)
				continue
			end
			if boat.model:GetAttribute("Health") == 0 then
				if not boat.sinkingAt then
					-- Release an anchored hull and lower it under its own suspension so
					-- passengers see it sink instead of the boat vanishing at zero health.
					setParked(boat, false)
					setDriver(boat, nil)
					boat.sinkingAt = serverTime
					boat.sinkingPosition = boat.root.Position
					boat.model:SetAttribute("Sinking", true)
					boat.model:SetAttribute("RowThrottle", 0)
					boat.model:SetAttribute("RowSteer", 0)
					boat.velocity.Enabled = false
					boat.float.Enabled, boat.lift.Enabled, boat.heading.Enabled = true, true, true
					updateSuspension(boat)
					for _, piece in boat.model:GetDescendants() do
						if piece:IsA("Seat") or piece:IsA("VehicleSeat") then
							if piece.Occupant then
								piece.Occupant.Sit = false
							end
							piece.Disabled = true
						end
					end
				end
				local elapsed = serverTime - boat.sinkingAt
				if elapsed >= 12 then
					removeBoat(player)
				else
					boat.float.Position = boat.sinkingPosition - Vector3.new(0, elapsed * 3, 0)
				end
				continue
			end
			if boat.hoistBase then
				-- Up on the drydock lift; DrydockLaunch moves it.
				setDriver(boat, nil)
				continue
			end
			if catchInTornado(boat, tornadoes) or (boat.flight and updateFlight(boat, tornadoes)) then
				continue
			end
			local rowing = boat.seat.Occupant
				and boat.seat.Occupant.Parent == player.Character
				and os.clock() - boat.lastInput < 0.5
			local throttle, steer = if rowing then boat.throttle else 0, if rowing then boat.steer else 0
			local wantsMotion = throttle ~= 0 or math.abs(steer) >= 0.08
			if boat.parked then
				if not wantsMotion then
					-- Anchored assemblies have infinite mass. Do not sample their
					-- mass or run wave/drive corrections while people use the deck.
					local root = boat.root
					if root.AssemblyLinearVelocity ~= Vector3.zero or root.AssemblyAngularVelocity ~= Vector3.zero then
						clearMotion(boat)
					end
					continue
				end
				setParked(boat, false)
			end
			-- Integrate the speed command across frames; water drag and solver lag
			-- must not restart the acceleration ramp at every physics step.
			local speed, turn = BoatMotion.step(boat.speed, boat.turn or 0, throttle, steer, boat.spec, dt)
			if
				not wantsMotion
				and speed == 0
				and turn == 0
				and math.abs(boat.bank) < 0.001
				and math.abs(boat.bankVelocity) < 0.005
				-- A thrown hull settles back onto the swell before it may anchor.
				and os.clock() - (boat.flungAt or -math.huge) > FLING_COOLDOWN
			then
				-- Preserve normal coasting and steering decay before holding still.
				setParked(boat, true)
				continue
			end
			-- At the helm, the driver's client steers the movers from its own input; we only
			-- track the commanded speed so the hull still parks once it has coasted to rest.
			setDriver(boat, if rowing then player else nil)
			if boat.driver then
				boat.speed, boat.turn = speed, turn
			else
				weather = BoatDrive.apply(boat, speed, turn, throttle, steer, dt, serverTime, weather)
			end
			-- Replicated intent drives the cosmetic stroke on every viewing client.
			if boat.model:GetAttribute("RowThrottle") ~= throttle then
				boat.model:SetAttribute("RowThrottle", throttle)
			end
			if boat.model:GetAttribute("RowSteer") ~= steer then
				boat.model:SetAttribute("RowSteer", steer)
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		removeBoat(player)
		profiles[player], requests[player], spawnTimes[player] = nil, nil, nil
	end)
	Players.PlayerAdded:Connect(loadPlayer)
	for _, player in Players:GetPlayers() do
		task.spawn(loadPlayer, player)
	end
end

return BoatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="137">
        <Properties>
          <string name="Name">BuildingService</string>
          <string name="Source"><![CDATA[-- Owner-authoritative structural editing. Geometry is only changed after the
-- wallet transaction commits; every command is rechecked inside that save.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BoatService = require(script.Parent.BoatService)
local Building = require(ReplicatedStorage.Shared.BuildingCatalog)
local Renderer = require(ReplicatedStorage.Shared.BuildingRenderer)
local Furniture = require(ReplicatedStorage.Shared.FurnitureCatalog)

local Service = {}
local started = false
local requests, busy, histories = {}, {}, {}
local watched, queued, applied = {}, {}, {}
local update: RemoteEvent
local HISTORY_LIMIT = 20
local BATCH_LIMIT = 64

local function clone(value)
	if type(value) ~= "table" then return value end
	local result = {}
	for key, child in value do result[key] = clone(child) end
	return result
end

local function same(a, b): boolean
	if type(a) ~= type(b) then return false end
	if type(a) ~= "table" then return a == b end
	for key, value in a do if not same(value, b[key]) then return false end end
	for key in b do if a[key] == nil then return false end end
	return true
end

local function empty()
	return { NextId = 1, Pieces = {}, Overrides = {} }
end

local function siteData(profile, site)
	return if profile and profile.Angler.Building then profile.Angler.Building[site] or empty() else empty()
end

local function modelOf(player: Player, site: string): (Model?, CFrame?)
	local tag = if site == "Company" then "CompanyIsland" else "PlayerBase"
	for _, plot in CollectionService:GetTagged(tag) do
		if not plot:IsA("Model") or not plot:IsDescendantOf(workspace)
			or plot:GetAttribute("OwnerUserId") ~= player.UserId then continue end
		local model = if site == "Company" then plot else plot:FindFirstChild("BaseHouse")
		local frame = model and model:GetAttribute(if site == "Company" then "PlotFrame" else "HouseFrame")
		if model and model:IsA("Model") and typeof(frame) == "CFrame" then return model, frame end
	end
	return nil, nil
end

local function siteProblem(player: Player, site: string, model: Model?, frame: CFrame?): string?
	if not model or not model:IsDescendantOf(workspace) or not frame then
		return if site == "Company" then "Your company plot is not ready." else "Your base house is not ready."
	end
	local actual = modelOf(player, site)
	if actual ~= model then return "You can only build on your own property." end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart")
		or (root.Position - frame.Position).Magnitude > (if site == "Company" then 150 else 110) then
		return "Return to your property to build."
	end
	return nil
end

local function history(player: Player, site: string, current)
	histories[player] = histories[player] or {}
	local record = histories[player][site]
	if not record or not same(record.Expected, current) then
		record = { Undo = {}, Redo = {}, Expected = clone(current) }
		histories[player][site] = record
	end
	return record
end

local function syncModel(plot: Model, site: string)
	if not plot:IsDescendantOf(workspace) then applied[plot] = nil; return end
	local userId = plot:GetAttribute("OwnerUserId")
	local player = if type(userId) == "number" and userId ~= 0 then Players:GetPlayerByUserId(userId) else nil
	local model = if site == "Company" then plot else plot:FindFirstChild("BaseHouse")
	local frame = model and model:GetAttribute(if site == "Company" then "PlotFrame" else "HouseFrame")
	if not model or not model:IsA("Model") or typeof(frame) ~= "CFrame" then return end
	local data = siteData(if player then BoatService.getProfile(player) else nil, site)
	local previous = applied[plot]
	if previous and previous.Model == model and previous.Owner == userId and previous.Frame == frame and same(previous.Data, data) then return end
	Renderer.sync(model, frame, site, data)
	applied[plot] = { Model = model, Frame = frame, Owner = userId, Data = clone(data) }
end

local function syncPlayer(player: Player)
	for _, tag in { "PlayerBase", "CompanyIsland" } do
		for _, plot in CollectionService:GetTagged(tag) do
			if plot:IsA("Model") and plot:GetAttribute("OwnerUserId") == player.UserId then
				syncModel(plot, if tag == "CompanyIsland" then "Company" else "Home")
			end
		end
	end
end

local function state(player: Player, site: string)
	local profile = BoatService.getProfile(player)
	if not profile then return nil end
	local current = siteData(profile, site)
	local record = history(player, site, current)
	local model, frame = modelOf(player, site)
	return {
		Cash = profile.Cash,
		Pieces = current.Pieces,
		Overrides = current.Overrides,
		Builtins = if model and frame then Renderer.capture(model, frame, site) else {},
		CanUndo = #record.Undo > 0,
		CanRedo = #record.Redo > 0,
		Revision = player:GetAttribute("AnglerRevision") or 0,
	}
end

local function find(pieces, id)
	for index, entry in pieces do if entry.Id == id then return entry, index end end
	return nil, nil
end

local function overlaps(a, b): boolean
	return a[1] < b[3] - 0.02 and a[3] > b[1] + 0.02 and a[2] < b[4] - 0.02 and a[4] > b[2] + 0.02
end

local function equipmentProblem(profile, site, entry): string?
	if (entry.Kind ~= "Wall" and entry.Kind ~= "Stairs") or entry.Level ~= 0 then return nil end
	local wall = { math.min(entry.X1, entry.X2) - 0.2, math.min(entry.Z1, entry.Z2) - 0.2,
		math.max(entry.X1, entry.X2) + 0.2, math.max(entry.Z1, entry.Z2) + 0.2 }
	local placed = if site == "Company" then profile.Angler.CompanyFurniture else profile.Angler.Furniture
	for _, item in placed do
		local body = Furniture.body(item.ItemId, item.X, item.Z, item.R)
		if body and overlaps(wall, body) then return "Move the furniture out of the construction area first." end
	end
	-- These narrow passages lead to permanent gameplay fixtures. The furniture
	-- system also reserves them, and walls must keep the same routes usable.
	local passages = if site == "Company" then { { -4.5, -31.5, 4.5, -27 } } else {
		{ -4, 65.6, 4, 78.4 }, -- customer entrance
		{ 15.6, 69.5, 20.8, 78.5 }, -- built-in freezer
		{ -21, 65.6, -11.5, 74.9 }, -- register
		{ -4, 11.25, 1.95, 15.4 }, -- kitchen entrance
		{ 2.55, 11.25, 8, 15.4 }, -- storage entrance
		{ -1, -11.25, 6.5, -2.25 }, -- storage passage
		{ -5.8, -15.4, 1.95, -11 }, -- rear door
		{ -22.6, -14.6, -18, -1 }, -- prep benches
		{ -24.4, -30.5, -19.5, -23.5 }, -- dining entrance
	}
	for _, passage in passages do
		if overlaps(wall, passage) then return "Keep entrances and access to your working equipment clear." end
	end
	return nil
end

function Service.furnitureProblem(player: Player, entry, site: string?, currentProfile): string?
	local profile = currentProfile or BoatService.getProfile(player)
	if not profile then return "Your progress is still loading." end
	local body = Furniture.body(entry.ItemId, entry.X, entry.Z, entry.R)
	if not body then return nil end
	for _, wall in siteData(profile, site or "Home").Pieces do
		if (wall.Kind ~= "Wall" and wall.Kind ~= "Stairs") or wall.Level ~= 0 then continue end
		local area = { math.min(wall.X1, wall.X2) - 0.2, math.min(wall.Z1, wall.Z2) - 0.2,
			math.max(wall.X1, wall.X2) + 0.2, math.max(wall.Z1, wall.Z2) + 0.2 }
		if overlaps(body, area) then return "A custom wall or staircase blocks that furniture position." end
	end
	return nil
end

local function availableBuiltins(builtins, data)
	local result = {}
	for id, entry in builtins do
		if not (data.Overrides[id] and data.Overrides[id].Removed) then result[id] = entry end
	end
	return result
end

local function validate(profile, site, data, builtins): string?
	if #data.Pieces > Building.MAX_PIECES then return "This plot has reached its building limit." end
	local count = 0
	for _ in data.Overrides do count += 1 end
	if count > Building.MAX_OVERRIDES then return "This plot has reached its surface editing limit." end
	local hosts = availableBuiltins(builtins, data)
	for _, entry in data.Pieces do
		local problem = Building.check(data.Pieces, entry, site, hosts, entry.Id)
		if problem then return problem end
		if entry.Kind == "Wall" then
			for _, original in hosts do
				if original.Kind ~= "Wall" or original.Level ~= entry.Level then continue end
				local xLine = math.abs(entry.X2 - entry.X1) < 0.01 and math.abs(original.X2 - original.X1) < 0.01
					and math.abs(entry.X1 - original.X1) < 0.05
				local zLine = math.abs(entry.Z2 - entry.Z1) < 0.01 and math.abs(original.Z2 - original.Z1) < 0.01
					and math.abs(entry.Z1 - original.Z1) < 0.05
				if (xLine and math.min(entry.Z2, original.Z2) > math.max(entry.Z1, original.Z1) + 0.05)
					or (zLine and math.min(entry.X2, original.X2) > math.max(entry.X1, original.X1) + 0.05) then
					return "An existing wall covers this line. Paint it or remove it first."
				end
			end
		elseif entry.HostId then
			local host = hosts[entry.HostId]
			local _, bottom = Building.opening(entry)
			if host and host.BaseY and host.BaseY > 0.3 + (host.Level or 0) * Building.LEVEL_HEIGHT + bottom then
				return "Place this opening on a complete wall section."
			end
		end
		problem = equipmentProblem(profile, site, entry)
		if problem then return problem end
	end
	return nil
end

local function validId(id): boolean
	return Building.id(id)
end

local function builtinTargets(builtins, id)
	local selected = builtins[id]
	local group = if selected and selected.Kind == "Roof" then id:match("^(b:.+)/[^/]+$") else nil
	if not group then return { id } end
	local result = {}
	for otherId, entry in builtins do
		if entry.Kind == "Roof" and otherId:match("^(b:.+)/[^/]+$") == group then table.insert(result, otherId) end
	end
	return result
end

-- Pure transformation used once for rejection before a save and again against
-- the newest profile inside the atomic wallet update.
local function change(profile, site, action, payload, builtins, record)
	local before = siteData(profile, site)
	local data = clone(before)
	local cost = 0
	if action == "Undo" or action == "Redo" then
		local list = if action == "Undo" then record.Undo else record.Redo
		local item = list[#list]
		if not item or not same(before, record.Expected) then return nil, "There is no building change to " .. string.lower(action) .. "." end
		data = clone(if action == "Undo" then item.Before else item.After)
		cost = if action == "Undo" then -item.Cost else item.Cost
	elseif action == "Place" then
		if type(payload.Entries) ~= "table" or #payload.Entries == 0 or #payload.Entries > BATCH_LIMIT then
			return nil, "Draw up to 64 building pieces at a time."
		end
		if data.NextId + #payload.Entries >= 1000000000 then return nil, "This plot has reached its lifetime building limit." end
		local count = 0
		for index, raw in payload.Entries do
			count += 1
			if type(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > #payload.Entries or count > BATCH_LIMIT then
				return nil, "Invalid building selection."
			end
			local entry, problem = Building.normalize(raw)
			if not entry then return nil, problem or "Invalid building piece." end
			entry.Id = "p" .. tostring(data.NextId)
			data.NextId += 1
			table.insert(data.Pieces, entry)
			cost += Building.price(entry)
		end
	elseif action == "Paint" then
		if not validId(payload.Id) then return nil, "Select a building piece first." end
		local custom, index = find(data.Pieces, payload.Id)
		local target = custom or builtins[payload.Id]
		if not target or (data.Overrides[payload.Id] and data.Overrides[payload.Id].Removed) then return nil, "That building piece is no longer there." end
		local previous = data.Overrides[payload.Id] or {}
		local color = payload.Color or previous.Color or target.Color
		local material = payload.Material or previous.Material or target.Material
		local sample = clone(custom or { Kind = "Wall", X1 = 0, Z1 = 0, X2 = Building.GRID, Z2 = 0, Level = 0 })
		sample.Color, sample.Material = color, material
		if payload.Style ~= nil then sample.Style = payload.Style end
		local normalized, problem = Building.normalize(sample)
		if not normalized then return nil, problem or "Choose a valid material and color." end
		if custom then
			normalized.Id = custom.Id
			data.Pieces[index] = normalized
		else
			for _, id in builtinTargets(builtins, payload.Id) do
				local override = data.Overrides[id] or {}
				override.Material, override.Color = normalized.Material, clone(normalized.Color)
				data.Overrides[id] = override
			end
		end
	elseif action == "Remove" then
		if not validId(payload.Id) then return nil, "Select a building piece first." end
		local custom, index = find(data.Pieces, payload.Id)
		if custom then
			table.remove(data.Pieces, index)
		elseif builtins[payload.Id] and not (data.Overrides[payload.Id] and data.Overrides[payload.Id].Removed) then
			for _, id in builtinTargets(builtins, payload.Id) do
				local override = data.Overrides[id] or {}
				override.Removed = true
				data.Overrides[id] = override
			end
		else
			return nil, "That building piece is no longer there."
		end
		-- Openings belong to their wall and cannot survive without their host.
		for at = #data.Pieces, 1, -1 do
			if data.Pieces[at].HostId == payload.Id then table.remove(data.Pieces, at) end
		end
	elseif action == "Move" then
		if not validId(payload.Id) then return nil, "Select a building piece first." end
		local custom, index = find(data.Pieces, payload.Id)
		if not custom then return nil, "Existing house surfaces can be painted or removed. Move pieces you built yourself." end
		local entry, problem = Building.normalize(payload.Entry)
		if not entry then return nil, problem or "Invalid building position." end
		if entry.Kind ~= custom.Kind then return nil, "Choose the same building category when moving a piece." end
		entry.Id = custom.Id
		data.Pieces[index] = entry
		cost = math.max(0, Building.price(entry) - Building.price(custom))
	else
		return nil, "That building tool is unavailable."
	end
	if same(before, data) then return nil, "That surface already has this finish." end
	local problem = validate(profile, site, data, builtins)
	if problem then return nil, problem end
	if profile.Cash < cost then return nil, string.format("You need $%d for this build.", cost) end
	profile.Angler.Building = profile.Angler.Building or Building.decode(nil)
	profile.Angler.Building[site] = data
	profile.Cash -= cost
	return { Before = clone(before), After = clone(data), Cost = cost }, nil
end

local function edit(player: Player, action: string, payload, site: string): (boolean, string)
	if busy[player] then return false, "Please wait for your previous building change to save." end
	local model, frame = modelOf(player, site)
	local problem = siteProblem(player, site, model, frame)
	if problem then return false, problem end
	local profile = BoatService.getProfile(player)
	if not profile then return false, "Your progress is still loading." end
	local builtins = Renderer.capture(model, frame, site)
	local record = history(player, site, siteData(profile, site))
	local _, reason = change(profile, site, action, payload, builtins, record)
	if reason then return false, reason end
	busy[player] = true
	local committed
	local ok, message = BoatService.updateProgress(player, function(current)
		local failure = siteProblem(player, site, model, frame)
		assert(not failure, failure)
		local changed, rejected = change(current, site, action, payload, builtins, record)
		assert(changed, rejected)
		committed = changed
	end)
	busy[player] = nil
	if not ok then return false, message end
	if action == "Undo" then
		local item = table.remove(record.Undo)
		table.insert(record.Redo, item)
	elseif action == "Redo" then
		local item = table.remove(record.Redo)
		table.insert(record.Undo, item)
	else
		table.insert(record.Undo, committed)
		if #record.Undo > HISTORY_LIMIT then table.remove(record.Undo, 1) end
		table.clear(record.Redo)
	end
	record.Expected = clone(committed.After)
	-- publish() fires AnglerRevision before updateProgress returns. Restore the
	-- completed history after that listener has observed the new profile.
	histories[player][site] = record
	syncPlayer(player)
	return true, if action == "Place" then string.format("Built for $%d.", committed.Cost) else "Saved."
end

function Service.start()
	if started then return end
	started = true
	local remotes = Instance.new("Folder")
	remotes.Name = "Building"
	local request = Instance.new("RemoteFunction")
	request.Name, request.Parent = "Request", remotes
	update = Instance.new("RemoteEvent")
	update.Name, update.Parent = "Update", remotes
	remotes.Parent = ReplicatedStorage
	request.OnServerInvoke = function(player, action, payload, requestedSite)
		local site = requestedSite or "Home"
		if site ~= "Home" and site ~= "Company" then return { Ok = false, Message = "Unknown building plot." } end
		if action == "Get" then return { Ok = true, State = state(player, site) } end
		if type(action) ~= "string" or type(payload or {}) ~= "table" then return { Ok = false, Message = "Invalid building request." } end
		if os.clock() - (requests[player] or -math.huge) < 0.3 then
			return { Ok = false, Message = "Please wait a moment before using another tool.", State = state(player, site) }
		end
		requests[player] = os.clock()
		local ok, message = edit(player, action, payload or {}, site)
		return { Ok = ok, Message = message, State = state(player, site) }
	end
	local function bindPlayer(player: Player)
		player:GetAttributeChangedSignal("AnglerRevision"):Connect(function()
			syncPlayer(player)
			-- Do not expose a temporarily stale undo list during our own commit.
			if not busy[player] then
				for _, site in { "Home", "Company" } do update:FireClient(player, "State", state(player, site), site) end
			end
		end)
		syncPlayer(player)
	end
	Players.PlayerAdded:Connect(bindPlayer)
	for _, player in Players:GetPlayers() do bindPlayer(player) end
	Players.PlayerRemoving:Connect(function(player)
		requests[player], busy[player], histories[player] = nil, nil, nil
	end)
	local function watch(plot: Instance, site: string)
		if not plot:IsA("Model") or watched[plot] then return end
		watched[plot] = true
		local function queue()
			if queued[plot] then return end
			queued[plot] = true
			task.defer(function()
				queued[plot] = nil
				if plot.Parent then syncModel(plot, site) end
			end)
		end
		plot:GetAttributeChangedSignal("OwnerUserId"):Connect(queue)
		plot:GetAttributeChangedSignal(if site == "Company" then "PlotFrame" else "HouseFrame"):Connect(queue)
		plot.DescendantAdded:Connect(function(child)
			if child.Name == "BaseHouse" or child.Name == "Dressing" then applied[plot] = nil; queue() end
		end)
		plot.Destroying:Connect(function() watched[plot], queued[plot], applied[plot] = nil, nil, nil end)
		queue()
	end
	for _, tag in { "PlayerBase", "CompanyIsland" } do
		local site = if tag == "CompanyIsland" then "Company" else "Home"
		CollectionService:GetInstanceAddedSignal(tag):Connect(function(plot) watch(plot, site) end)
		for _, plot in CollectionService:GetTagged(tag) do watch(plot, site) end
	end
end

return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="138">
        <Properties>
          <string name="Name">CargoService</string>
          <string name="Source"><![CDATA[-- The angler's hand, backpack, and launched boat's cargo hold. The backpack is
-- reachable everywhere; the boat hold is only reachable while aboard. Clients only
-- preview placements; every move is checked against the saved profile here.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AnglerData = require(script.Parent.AnglerData)
local BoatService = require(script.Parent.BoatService)
local Aboard = require(ReplicatedStorage.Shared.Aboard)
local BoatCatalog = require(ReplicatedStorage.Shared.BoatCatalog)
local Backpacks = require(ReplicatedStorage.Shared.BackpackCatalog)
local Cargo = require(ReplicatedStorage.Shared.Cargo)
local Catalog = require(ReplicatedStorage.Shared.AnglerCatalog)
local FishCatch = require(ReplicatedStorage.Shared.FishCatch)
local FishModels = require(ReplicatedStorage.Shared.FishModels)
local FishMutations = require(ReplicatedStorage.Shared.FishMutations)

local CargoService = {}
local started = false
local requests = {}
local update: RemoteEvent

-- The refit dock reserves a motor or rudder in RefitPending while the player
-- picks its hold spot. Attributes cannot hold tables, so the reservation is a
-- server-owned "BoatId|Kind|PartId" string.
local function pendingRefit(player: Player)
	local value = player:GetAttribute("RefitPending")
	if type(value) ~= "string" then
		return nil
	end
	local boatId, kind, partId = string.match(value, "^([^|]+)|([^|]+)|([^|]+)$")
	if not boatId or (kind ~= "Motor" and kind ~= "Rudder") then
		return nil
	end
	return { BoatId = boatId, Kind = kind, PartId = partId }
end

local function boatInReach(player: Player): (string?, any?, boolean)
	local boatId, model = BoatService.activeBoat(player)
	local layout = boatId and BoatCatalog[boatId]
	if not layout or not model then
		return nil, nil, false
	end
	return boatId, layout, Aboard(player.Character, model)
end

local function state(player: Player)
	local profile = BoatService.getProfile(player)
	if not profile then
		return nil
	end
	local boatId, layout, near = boatInReach(player)
	local pending = pendingRefit(player)
	if not pending or pending.BoatId ~= boatId or not near then
		pending = nil
	end
	return {
		Hand = profile.Angler.Hand,
		BackpackId = profile.Angler.BackpackId,
		Backpack = profile.Angler.Backpack,
		BoatId = boatId,
		Items = if layout then AnglerData.hold(profile.Angler, boatId, layout) else {},
		Pending = if pending then { BoatId = pending.BoatId, Kind = pending.Kind, PartId = pending.PartId } else nil,
		Freezer = #profile.Angler.Freezer,
		FreezerUsage = AnglerData.freezerUsage(profile.Angler),
	}
end

local function fishKey(record): string
	return string.format("%s|%s|%s", tostring(record.FishId), tostring(record.Kg), tostring(record.CaughtAt))
end

-- A hotbar fish must actually be equipped to place it in the freezer.
function CargoService.isCarrying(player: Player, record): boolean
	local character = player.Character
	if not character or not record then
		return false
	end
	for _, child in character:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute("CargoFish") == fishKey(record) then
			return true
		end
	end
	return false
end

local function buildFishTool(record): Tool
	local species = Catalog.Fish[record.FishId]
	local tool = Instance.new("Tool")
	local mutation = FishMutations.label(record.Mutation, record.NeonColor)
	tool.Name = (if mutation ~= "" then mutation .. " " else "")
		.. (if species then species.Name else record.FishId)
		.. (if record.Size == "Huge" then " (Huge)" elseif record.Size == "Big" then " (Big)" else "")
	tool.ToolTip = string.format(
		"%s · $%d · stow it in your backpack, aboard or in your freezer",
		FishCatch.formatKg(record.Kg),
		math.floor(record.Value)
	)
	tool.CanBeDropped = false
	tool.Grip = CFrame.Angles(0, math.rad(180), 0)
	tool:SetAttribute("CargoFish", fishKey(record))
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.4, 0.4, 0.4)
	handle.Transparency = 1
	handle.CanCollide, handle.CanTouch, handle.CanQuery = false, false, false
	handle.Massless = true
	handle.Parent = tool
	local model = FishModels.create(record.FishId, record)
	if model then
		FishModels.scaleHeldCatch(model, record.Kg, record.Size)
		handle.CFrame = model:GetPivot()
		for _, piece in model:GetDescendants() do
			if piece:IsA("BasePart") then
				piece.Anchored, piece.Massless = false, true
				piece.CanCollide, piece.CanTouch, piece.CanQuery = false, false, false
				local weld = Instance.new("WeldConstraint")
				weld.Part0, weld.Part1 = handle, piece
				weld.Parent = piece
			end
		end
		model.Parent = tool
	end
	return tool
end

-- Keeps exactly one hotbar Tool for the fish in hand, rebuilt only when it changes.
local function syncTool(player: Player)
	local profile = BoatService.getProfile(player)
	if not profile then
		return
	end
	local hand = profile.Angler.Hand
	local wanted = if hand then fishKey(hand) else nil
	local backpack = player:FindFirstChildOfClass("Backpack")
	local kept = false
	for _, container in { player.Character, backpack } do
		if not container then
			continue
		end
		for _, child in container:GetChildren() do
			if child:IsA("Tool") and child:GetAttribute("CargoFish") ~= nil then
				if child:GetAttribute("CargoFish") == wanted and not kept then
					kept = true
				else
					child:Destroy()
				end
			end
		end
	end
	if hand and not kept and backpack then
		buildFishTool(hand).Parent = backpack
	end
end

function CargoService.push(player: Player)
	if player.Parent == Players then
		syncTool(player)
		update:FireClient(player, state(player))
	end
end

local function spot(value: any)
	if type(value) ~= "table" then
		return nil
	end
	local x, y, r = value.X, value.Y, value.R
	if type(x) ~= "number" or type(y) ~= "number" or type(r) ~= "number" then
		return nil
	end
	return { X = x, Y = y, R = r }
end

local function move(player: Player, from: any, to: any, container: any): (boolean, string)
	if container ~= nil and container ~= "Boat" and container ~= "Backpack" then
		return false, "Choose your backpack or boat hold."
	end
	local backpack = container == "Backpack"
	if from ~= "Hand" and not (type(from) == "number" and from % 1 == 0 and from >= 1 and from <= 256) then
		return false, "That item can't be moved."
	end
	if to ~= "Hand" and to ~= "Release" then
		to = spot(to)
		if not to then
			return false, "That isn't a spot in the hold."
		end
	end
	local profile = BoatService.getProfile(player)
	if not profile then
		return false, "Your cargo is still loading. Try again in a moment."
	end
	local boatId, layout, near = boatInReach(player)
	local usesHold = from ~= "Hand" or type(to) == "table"
	if usesHold and not backpack and not near then
		return false, if layout then "Climb aboard your boat to use its hold." else "Launch your boat to use its hold."
	end
	if not near then
		layout = nil
	end
	if backpack then
		boatId = nil
		layout = Backpacks.Items[profile.Angler.BackpackId] or Backpacks.Items.Starter
	end
	-- Check the cached profile first so a rejected move never costs a save.
	local data, reason = AnglerData.moveCargo(profile.Angler, boatId, layout, from, to, Catalog.Fish, backpack)
	if not data then
		return false, reason
	end
	return BoatService.updateProgress(player, function(current)
		local moved, failure = AnglerData.moveCargo(current.Angler, boatId, layout, from, to, Catalog.Fish, backpack)
		assert(moved, failure)
		current.Angler = moved
	end)
end

local function moveAll(player: Player): (boolean, string)
	local profile = BoatService.getProfile(player)
	if not profile then
		return false, "Your cargo is still loading. Try again in a moment."
	end
	local boatId, layout, near = boatInReach(player)
	if not layout then
		return false, "Launch your boat to use its hold."
	end
	if not near then
		return false, "Climb aboard your boat to use its hold."
	end
	local backpackLayout = Backpacks.Items[profile.Angler.BackpackId] or Backpacks.Items.Starter
	local data, count = AnglerData.moveAllToBackpack(profile.Angler, boatId, layout, backpackLayout, Catalog.Fish)
	if not data then
		-- On failure the second value is the player-facing reason instead of a count.
		return false, count
	end
	local ok, message = BoatService.updateProgress(player, function(current)
		local updated, failure =
			AnglerData.moveAllToBackpack(current.Angler, boatId, layout, backpackLayout, Catalog.Fish)
		assert(updated, failure)
		current.Angler = updated
	end)
	if not ok then
		return false, message
	end
	return true, string.format("Moved %d fish into your backpack.", count)
end

-- The refit dock reserves a motor or rudder in RefitPending; the player picks
-- where it sits in the hold, and this saves that exact placement.
local function placeRefit(player: Player, x: any, y: any, r: any): (boolean, string)
	local pending = pendingRefit(player)
	if not pending then
		return false, "Choose a motor or rudder at the dock first."
	end
	local profile = BoatService.getProfile(player)
	if not profile then
		return false, "Your cargo is still loading. Try again in a moment."
	end
	local boatId, layout, near = boatInReach(player)
	if not layout then
		return false, "Launch your boat to use its hold."
	elseif not near then
		return false, "Climb aboard your boat to use its hold."
	elseif pending.BoatId ~= boatId then
		return false, "That refit belongs to another boat."
	elseif not Cargo.Parts[pending.PartId] then
		return false, "That boat part is not available."
	end
	local data, reason = AnglerData.placePart(profile.Angler, boatId, layout, pending.PartId, x, y, r, Catalog.Fish)
	if not data then
		return false, reason
	end
	-- Clear before saving so the revision pushes during the save cannot re-arm
	-- placement; put it back if the save fails.
	local encoded = player:GetAttribute("RefitPending")
	player:SetAttribute("RefitPending", nil)
	local ok, message = BoatService.updateProgress(player, function(current)
		local updated, failure =
			AnglerData.placePart(current.Angler, boatId, layout, pending.PartId, x, y, r, Catalog.Fish)
		assert(updated, failure)
		current.Angler = updated
	end)
	if not ok then
		player:SetAttribute("RefitPending", encoded)
		return false, message
	end
	BoatService.refit(player)
	return true,
		if pending.Kind == "Motor"
			then "Extra motor fitted! Your " .. layout.Name .. " is faster now."
			else "Rudder fitted! Your " .. layout.Name .. " turns sharper now."
end

local function cancelRefit(player: Player): (boolean, string)
	if player:GetAttribute("RefitPending") == nil then
		return true, ""
	end
	player:SetAttribute("RefitPending", nil)
	return true, "Refit cancelled. Nothing was changed."
end

local function lockBackpack(player: Player, index: any, locked: any, expected: any): (boolean, string)
	if type(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > 256 or type(locked) ~= "boolean" then
		return false, "Choose a fish in your backpack."
	end
	local profile = BoatService.getProfile(player)
	if not profile then
		return false, "Your cargo is still loading. Try again in a moment."
	end
	local data, reason = AnglerData.setBackpackLock(profile.Angler, index, locked, expected)
	if not data then
		return false, reason
	end
	return BoatService.updateProgress(player, function(current)
		local updated, failure = AnglerData.setBackpackLock(current.Angler, index, locked, expected)
		assert(updated, failure)
		current.Angler = updated
	end)
end

function CargoService.start()
	if started then
		return
	end
	started = true
	local remotes = Instance.new("Folder")
	remotes.Name = "Cargo"
	local request = Instance.new("RemoteFunction")
	request.Name, request.Parent = "Request", remotes
	update = Instance.new("RemoteEvent")
	update.Name, update.Parent = "Update", remotes
	remotes.Parent = ReplicatedStorage
	request.OnServerInvoke = function(player, action, a, b, c)
		if action == "Get" then
			return { Ok = true, Message = "", State = state(player) }
		elseif
			action ~= "Move"
			and action ~= "Lock"
			and action ~= "MoveAll"
			and action ~= "Place"
			and action ~= "CancelPlace"
		then
			return { Ok = false, Message = "That cargo action is unavailable.", State = state(player) }
		end
		if os.clock() - (requests[player] or -math.huge) < 0.2 then
			return { Ok = false, Message = "Please wait a moment and try again.", State = state(player) }
		end
		requests[player] = os.clock()
		local ok, message
		if action == "Lock" then
			ok, message = lockBackpack(player, a, b, c)
		elseif action == "MoveAll" then
			ok, message = moveAll(player)
		elseif action == "Place" then
			ok, message = placeRefit(player, a, b, c)
		elseif action == "CancelPlace" then
			ok, message = cancelRefit(player)
		else
			ok, message = move(player, a, b, c)
		end
		return { Ok = ok, Message = message, State = state(player) }
	end
	-- Every saved change and every launch or docking refreshes the client's view.
	local function bind(player: Player)
		player:GetAttributeChangedSignal("AnglerRevision"):Connect(function()
			CargoService.push(player)
		end)
		player:GetAttributeChangedSignal("ActiveBoatId"):Connect(function()
			CargoService.push(player)
		end)
		-- Fitting a motor or rudder at the dock opens the hold placement view.
		player:GetAttributeChangedSignal("RefitPending"):Connect(function()
			CargoService.push(player)
		end)
		-- Respawning empties the Backpack, so hand the fish back.
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("Humanoid", 10)
			if player.Character == character then
				syncTool(player)
			end
		end)
	end
	Players.PlayerAdded:Connect(bind)
	for _, player in Players:GetPlayers() do
		bind(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		requests[player] = nil
	end)
end

return CargoService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="139">
        <Properties>
          <string name="Name">CatchService</string>
          <string name="Source"><![CDATA[-- Server-authoritative casting. The server validates each cast, decides when a
-- fish bites, rolls the fish and only awards it after a plausible reel fight.
-- Rod tools carry CastTarget/CastAt/CastPhase so every client can draw the line.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local AnglerService = require(script.Parent.AnglerService)
local AnglerData = require(script.Parent.AnglerData)
local BoatService = require(script.Parent.BoatService)
local BoatData = require(script.Parent.BoatData)
local BackpackCatalog = require(ReplicatedStorage.Shared.BackpackCatalog)
local Catalog = require(ReplicatedStorage.Shared.AnglerCatalog)
local CatchConditions = require(ReplicatedStorage.Shared.CatchConditions)
local CastTiming = require(ReplicatedStorage.Shared.CastTiming)
local DayNight = require(ReplicatedStorage.Shared.DayNight)
local FishCatch = require(ReplicatedStorage.Shared.FishCatch)
local FishMutations = require(ReplicatedStorage.Shared.FishMutations)
local MutationContext = require(ReplicatedStorage.Shared.MutationContext)
local RodSkins = require(ReplicatedStorage.Shared.RodSkins)
local BobberSkins = require(ReplicatedStorage.Shared.BobberSkins)
local RodUpgrades = require(ReplicatedStorage.Shared.RodUpgrades)
local Seasons = require(ReplicatedStorage.Shared.Seasons)

local CatchService = {}
local MAX_CAST_DISTANCE = 64
local MAX_LINE_LENGTH = 110
local MAX_FIGHT_SECONDS = 150
local BITE_SECONDS = Vector2.new(3, 8)
local casts = {}
local charges = {}
local lastCharge = {}
local lastRequest = {}
local random = Random.new()
local started = false
local update: RemoteEvent

local function equippedRod(player: Player): (Tool?, BasePart?)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil, nil
	end
	for _, child in character:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute("RodId") == "StarterRod" then
			return child, root
		end
	end
	return nil, nil
end

local function send(player: Player, kind: string, payload: any?)
	if player.Parent == Players then
		update:FireClient(player, kind, payload)
	end
end

local function clear(player: Player, reason: string?)
	local state = casts[player]
	if not state then
		return
	end
	casts[player] = nil
	for _, attribute in { "CastTarget", "CastAt", "CastPhase" } do
		state.tool:SetAttribute(attribute, nil)
	end
	if reason then
		send(player, "Cancelled", reason)
	end
end

local function finite(vector: Vector3): boolean
	return vector == vector and math.abs(vector.X) < 1e6 and math.abs(vector.Y) < 1e6 and math.abs(vector.Z) < 1e6
end

local function waterSurface(player: Player, target: Vector3): Vector3?
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances = { player.Character }
	parameters.IgnoreWater = false
	local result = workspace:Raycast(target + Vector3.new(0, 30, 0), Vector3.new(0, -70, 0), parameters)
	if result and result.Instance == workspace.Terrain and result.Material == Enum.Material.Water then
		return result.Position
	end
	return nil
end

local function beginCharge(player: Player)
	local now = os.clock()
	if casts[player] or now - (lastCharge[player] or -math.huge) < 0.2 then
		return
	end
	local tool = equippedRod(player)
	if tool then
		lastCharge[player] = now
		charges[player] = { tool = tool, startedAt = now }
	end
end

local function cast(player: Player, target: any, heldSeconds: any)
	local charge = charges[player]
	charges[player] = nil
	if typeof(target) ~= "Vector3" or not finite(target) or casts[player] then
		return
	end
	if player:GetAttribute("BoatDataStatus") ~= "Ready" then
		send(player, "Cancelled", "Your tackle box is still loading. Try again in a moment.")
		return
	end
	local tool, root = equippedRod(player)
	if not tool or not root then
		return
	end
	local profile = BoatService.getProfile(player)
	if not profile then
		send(player, "Cancelled", "Your tackle box is still loading. Try again in a moment.")
		return
	end
	local backpack = BackpackCatalog.Items[profile.Angler.BackpackId] or BackpackCatalog.Items.Starter
	if not AnglerData.hasCatchSpace(profile.Angler, backpack, Catalog.Fish) then
		send(player, "Cancelled", "Your hand and backpack are full. Make room before fishing.")
		return
	end
	local offset = target - root.Position
	if Vector3.new(offset.X, 0, offset.Z).Magnitude > MAX_CAST_DISTANCE + 4 or math.abs(offset.Y) > 60 then
		send(player, "Cancelled", "That's too far to cast.")
		return
	end
	local surface = waterSurface(player, target)
	if not surface then
		send(player, "Cancelled", "Cast into open water.")
		return
	end
	-- Upgrades and skins changed mid-cast apply from the next cast, matching the client's fight.
	local boosts = RodSkins.apply(
		RodUpgrades.boosts(profile and profile.RodUpgrades),
		profile and profile.EquippedRodSkin,
		profile and BoatData.equippedRodWear(profile)
	)
	boosts = BobberSkins.apply(boosts, profile and profile.EquippedBobberSkin)
	local perfect = charge ~= nil
		and charge.tool == tool
		and CastTiming.validRelease(heldSeconds, os.clock() - charge.startedAt)
		and CastTiming.isPerfect(heldSeconds)
	if perfect then
		boosts.luck += CastTiming.PerfectLuck
	end
	local state = { tool = tool, target = surface, phase = "Waiting", boosts = boosts, perfectThrow = perfect }
	casts[player] = state
	tool:SetAttribute("CastTarget", surface)
	tool:SetAttribute("CastAt", workspace:GetServerTimeNow())
	tool:SetAttribute("CastPhase", "Waiting")
	send(player, "Cast", surface)
	if perfect then
		send(player, "PerfectCast", CastTiming.PerfectLuck)
	end
	task.delay(random:NextNumber(BITE_SECONDS.X, BITE_SECONDS.Y), function()
		if casts[player] ~= state then
			return
		end
		local pool = FishCatch.inSeason(
			Catalog.poolAt(CatchConditions.area(state.target)),
			Catalog.Fish,
			(Seasons.current()),
			CatchConditions.at(state.target)
		)
		local function rng()
			return random:NextNumber()
		end
		local roll = FishCatch.roll(pool, Catalog.Fish, Catalog.Rarities, rng, state.boosts)
		-- Rolled at the bite, but only revealed once the fish is landed.
		local night = DayNight.isNight(DayNight.clockTime())
		local traits = FishMutations.roll(
			Catalog.Fish[roll.FishId],
			night,
			rng,
			state.boosts,
			MutationContext.at(state.target, player)
		)
		roll.Traits = traits
		roll.Value = FishMutations.value(roll.Value, traits.Mutation, traits.Corruptions)
		state.roll, state.phase, state.hookedAt = roll, "Hooked", os.clock()
		tool:SetAttribute("CastPhase", "Hooked")
		send(player, "Bite", {
			FishId = roll.FishId,
			Difficulty = roll.Difficulty,
			Pool = pool.Name,
			ReelBoost = state.boosts.reel,
			HandlingBoost = state.boosts.handling,
		})
	end)
end

local function award(player: Player, roll)
	local saved = false
	local autoStored = false
	local destination
	local count
	for attempt = 1, 4 do
		local traits = roll.Traits
		local message
		saved, message, autoStored, destination, count =
			AnglerService.recordCatch(player, roll.FishId, traits.Mutation, roll.Kg, roll.Value, roll.Size, traits, roll.PerfectCatch)
		if saved or player.Parent ~= Players then
			break
		end
		task.wait(attempt)
	end
	send(player, "Caught", {
		FishId = roll.FishId,
		Kg = roll.Kg,
		Size = roll.Size,
		Value = roll.Value,
		Mutation = roll.Traits.Mutation,
		NeonColor = roll.Traits.NeonColor,
		Corruptions = roll.Traits.Corruptions,
		Saved = saved,
		AutoStored = autoStored,
		BackpackStored = saved and destination == "Backpack",
		Stored = saved and destination == "Hand",
		Count = count,
	})
end

local function reel(player: Player, landed: any, noMistakes: any)
	local state = casts[player]
	if not state then
		return
	end
	if state.phase == "Waiting" then
		clear(player)
		send(player, "ReeledIn")
		return
	end
	local roll = state.roll
	local reelBoost = state.boosts.reel
	local elapsed = os.clock() - state.hookedAt
	clear(player)
	if
		landed ~= true
		or elapsed < FishCatch.minimumFightSeconds(roll.Difficulty, reelBoost, state.boosts.handling)
		or elapsed > MAX_FIGHT_SECONDS
	then
		send(player, "Escaped", roll.FishId)
		return
	end
	-- Reeling runs on the client; only the server-validated throw can qualify it.
	roll.PerfectCatch = state.perfectThrow == true and noMistakes == true
	task.spawn(award, player, roll)
end

function CatchService.start()
	if started then
		return
	end
	started = true
	local remotes = Instance.new("Folder")
	remotes.Name = "Catch"
	local request = Instance.new("RemoteEvent")
	request.Name, request.Parent = "Request", remotes
	update = Instance.new("RemoteEvent")
	update.Name, update.Parent = "Update", remotes
	remotes.Parent = ReplicatedStorage
	request.OnServerEvent:Connect(function(player, action, value, heldSeconds)
		if action == "Charge" then
			beginCharge(player)
			return
		elseif action == "CancelCharge" then
			charges[player] = nil
			return
		end
		if os.clock() - (lastRequest[player] or -math.huge) < 0.2 then
			return
		end
		lastRequest[player] = os.clock()
		if action == "Cast" then
			cast(player, value, heldSeconds)
		elseif action == "Reel" then
			reel(player, value, heldSeconds)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		clear(player)
		lastRequest[player] = nil
		charges[player] = nil
		lastCharge[player] = nil
	end)
	-- Unequipping, dying or walking away from the line ends the cast.
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.5 then
			return
		end
		elapsed = 0
		for player, charge in charges do
			local tool = equippedRod(player)
			if tool ~= charge.tool or os.clock() - charge.startedAt > CastTiming.MaxChargeSeconds then
				charges[player] = nil
			end
		end
		for player, state in casts do
			local tool, root = equippedRod(player)
			if tool ~= state.tool or not root then
				clear(player, "Your line went slack.")
			elseif (root.Position - state.target).Magnitude > MAX_LINE_LENGTH then
				clear(player, "You walked too far and your line snapped.")
			elseif state.phase == "Hooked" and os.clock() - state.hookedAt > MAX_FIGHT_SECONDS then
				clear(player)
				send(player, "Escaped", state.roll.FishId)
			end
		end
	end)
end

return CatchService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="140">
        <Properties>
          <string name="Name">ChefService</string>
          <string name="Source"><![CDATA[-- Hired chefs work independently at the owner's existing kitchen stations. Fish,
-- station jobs and finished dishes are moved together through the saved profile.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AnglerData = require(script.Parent.AnglerData)
local BoatService = require(script.Parent.BoatService)
local CompanyIslandAccess = require(script.Parent.CompanyIslandAccess)
local CustomerService = require(script.Parent.CustomerService)
local Kitchen = require(script.Parent.Map.Kitchen)
local Catalog = require(ReplicatedStorage.Shared.AnglerCatalog)
local Furniture = require(ReplicatedStorage.Shared.FurnitureCatalog)
local Paths = require(ReplicatedStorage.Shared.Paths)
local Recipes = require(ReplicatedStorage.Shared.Recipes)
local StaffCatalog = require(ReplicatedStorage.Shared.StaffCatalog)

local ChefService = {}
local roles = { "RestaurantChef", "CompanyChef" }
local rolePaths = { RestaurantChef = "Restaurant", CompanyChef = "Company" }
local npc = CustomerService.npc
local started = false
local bases = {}

local function ownerOf(base)
	local id = base:GetAttribute("OwnerUserId")
	return if type(id) == "number" and id ~= 0 then Players:GetPlayerByUserId(id) else nil
end

-- A saved station is usable only after its world model is present too.
local function stations(house, frame)
	local result = {}
	local processing = house:FindFirstChild("Processing")
	local benches = processing and processing:FindFirstChild("KitchenBenches")
	for key, bench in Recipes.BuiltIn do
		if benches and benches:FindFirstChild(key) then
			result[key] = Furniture.frame(frame, bench)
		end
	end
	local placed = house:FindFirstChild("Furniture")
	for _, model in if placed then placed:GetChildren() else {} do
		local key = model:GetAttribute("StationKey")
		local x, z, r = model:GetAttribute("X"), model:GetAttribute("Z"), model:GetAttribute("R")
		if
			type(key) == "string"
			and Recipes.stationOf(key)
			and type(x) == "number"
			and type(z) == "number"
			and type(r) == "number"
		then
			result[key] = Furniture.frame(frame, { ItemId = model:GetAttribute("ItemId"), X = x, Z = z, R = r })
		end
	end
	return result
end

local function removeWorker(state, role)
	local worker = state.workers[role]
	if worker then
		worker.model:Destroy()
		state.workers[role] = nil
	end
end

local function clear(state)
	for _, role in roles do
		removeWorker(state, role)
	end
end

local function ensureWorker(base, state, owner, role, position)
	local worker = state.workers[role]
	if worker and worker.model.Parent and worker.humanoid.Health > 0 then
		return worker
	end
	removeWorker(state, role)
	if state.spawning[role] then
		return nil
	end
	state.spawning[role] = true
	task.spawn(function()
		local model
		local ok, failure = pcall(function()
			model = npc.spawn(position, role)
			if bases[base] ~= state or ownerOf(base) ~= owner or not base.Parent then
				model:Destroy()
				return
			end
			local profile = BoatService.getProfile(owner)
			if not profile or not profile.Angler.Staff[role] or not Paths.unlocked(profile, rolePaths[role]) then
				model:Destroy()
				return
			end
			model.Name = role
			model:SetAttribute("OwnerUserId", owner.UserId)
			model:SetAttribute("StaffRole", role)
			StaffCatalog.finishModel(model)
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart")
			assert(humanoid and root and root:IsA("BasePart"), "Chef has no humanoid or root")
			for _, part in model:GetDescendants() do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
			root.Anchored = true
			model.Parent = if role == "CompanyChef" then (CompanyIslandAccess.get(owner) or base) else base
			state.workers[role] = { model = model, humanoid = humanoid, root = root }
		end)
		state.spawning[role] = nil
		if not ok then
			if model then
				model:Destroy()
			end
			warn("[Chef] Spawn: " .. tostring(failure))
		end
	end)
	return nil
end

local function display(worker, role, message, frame)
	if not worker then
		return
	end
	local height = worker.model:GetExtentsSize().Y / 2
	worker.model:PivotTo(frame * CFrame.new(0, height, 0))
	npc.bubble(worker, (if role == "RestaurantChef" then "Restaurant chef" else "Company chef") .. " · " .. message)
end

local function processRole(base, state, owner, role, houseFrame, available)
	local profile = BoatService.getProfile(owner)
	if not profile or not profile.Angler.Staff[role] or not Paths.unlocked(profile, rolePaths[role]) then
		removeWorker(state, role)
		return
	end
	local idle = houseFrame * CFrame.new(-18.5, 0, if role == "RestaurantChef" then -5 else -10)
	local worker = ensureWorker(base, state, owner, role, idle.Position)
	local now = os.time()
	local activeKey, activeJob
	for key, job in profile.Angler.Kitchen do
		if job.ChefRole == role then
			activeKey, activeJob = key, job
			break
		end
	end
	if activeJob then
		local stationFrame = available[activeKey]
		local stand = if stationFrame
			then stationFrame * CFrame.new(0, 0, Kitchen.DEPTH / 2 + 1.7) * CFrame.Angles(0, math.pi, 0)
			else idle
		local ready = now >= activeJob.ReadyAt
		local cookingRecipe = Recipes.Items[activeJob.Dish.RecipeId]
		display(
			worker,
			role,
			if ready
				then "Waiting for space on the pass"
				else "Cooking " .. (if cookingRecipe then cookingRecipe.Name else "dish"),
			stand
		)
		local _, reason = AnglerData.collectChefDish(profile.Angler, role, activeKey, now)
		if not reason then
			BoatService.updateProgress(owner, function(current)
				assert(ownerOf(base) == owner and base.Parent, "Kitchen owner changed")
				local data, failure = AnglerData.collectChefDish(current.Angler, role, activeKey, os.time())
				assert(data, failure)
				current.Angler = data
			end)
		end
		return
	end
	local recipeId = profile.Angler.ChefRecipes[role]
	local recipe = recipeId and Recipes.Items[recipeId]
	if not recipe then
		display(worker, role, "Choose a recipe in Workers", idle)
		return
	end
	local keys = {}
	for key in available do
		if Recipes.stationOf(key) == recipe.Station then
			table.insert(keys, key)
		end
	end
	table.sort(keys)
	local status = if #keys == 0
		then "Needs a " .. Recipes.Stations[recipe.Station].Name
		else "Waiting for fish or a free station"
	for _, key in keys do
		local _, reason = AnglerData.startChefCooking(profile.Angler, role, key, Catalog.Fish, now)
		if not reason then
			local ok = BoatService.updateProgress(owner, function(current)
				assert(ownerOf(base) == owner and base.Parent, "Kitchen owner changed")
				local data, failure = AnglerData.startChefCooking(current.Angler, role, key, Catalog.Fish, os.time())
				assert(data, failure)
				current.Angler = data
			end)
			if ok then
				status = "Cooking " .. recipe.Name
				local stand = available[key] * CFrame.new(0, 0, Kitchen.DEPTH / 2 + 1.7) * CFrame.Angles(0, math.pi, 0)
				display(worker, role, status, stand)
				return
			end
			break
		end
	end
	display(worker, role, status, idle)
end

local function processBase(base, state)
	local owner = ownerOf(base)
	local house = base:FindFirstChild("BaseHouse")
	local frame = house and house:GetAttribute("HouseFrame")
	if not owner or not house or typeof(frame) ~= "CFrame" then
		clear(state)
		return
	end
	if state.owner ~= owner then
		clear(state)
		state.owner = owner
	end
	local available = stations(house, frame)
	for _, role in roles do
		if ownerOf(base) ~= owner then
			break
		end
		local property = if role == "CompanyChef" then CompanyIslandAccess.get(owner) else nil
		local worker = state.workers[role]
		if worker then worker.model.Parent = property or base end
		if property then
			local companyStations = {}
			for key, station in CompanyIslandAccess.stations(owner) do
				companyStations[key] = station.frame
			end
			-- The company chef waits on the island plot between the benches the owner placed.
			processRole(base, state, owner, role, property:GetAttribute("PlotFrame"), companyStations)
		else
			processRole(base, state, owner, role, frame, available)
		end
	end
end

function ChefService.start()
	if started then
		return
	end
	started = true
	task.spawn(function()
		while true do
			for _, base in CollectionService:GetTagged("PlayerBase") do
				if base:IsA("Model") then
					local state = bases[base]
					if not state then
						state = { workers = {}, spawning = {}, busy = false }
						bases[base] = state
					end
					if not state.busy then
						state.busy = true
						task.spawn(function()
							local ok, failure = pcall(processBase, base, state)
							state.busy = false
							if not ok then
								warn("[Chef] " .. tostring(failure))
							end
						end)
					end
				end
			end
			for base, state in bases do
				if not base.Parent or not CollectionService:HasTag(base, "PlayerBase") then
					clear(state)
					bases[base] = nil
				end
			end
			task.wait(2)
		end
	end)
end

return ChefService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="141">
        <Properties>
          <string name="Name">CompanyIslandAccess</string>
          <string name="Source"><![CDATA[-- Small read-only interface; property ownership is assigned by CompanyIslandService.
local CollectionService = game:GetService("CollectionService")
local Access = {}

function Access.get(player: Player): Model?
	for _, island in CollectionService:GetTagged("CompanyIsland") do
		if island:IsA("Model") and island:IsDescendantOf(workspace) and island:GetAttribute("OwnerUserId") == player.UserId then
			return island
		end
	end
	return nil
end

function Access.ownsPrompt(player: Player, prompt: ProximityPrompt): boolean
	local island = Access.get(player)
	return island ~= nil and prompt:IsDescendantOf(island)
end

-- Prep benches the owner placed on the plot, keyed like their saved kitchen jobs.
function Access.stations(player: Player)
	local result = {}
	local island = Access.get(player)
	local plot = island and island:FindFirstChild("PlotFurniture")
	for _, model in if plot then plot:GetChildren() else {} do
		local key, frame = model:GetAttribute("StationKey"), model:GetAttribute("StationFrame")
		if model:IsA("Model") and type(key) == "string" and typeof(frame) == "CFrame" then
			result[key] = { model = model, frame = frame }
		end
	end
	return result
end

return Access
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="142">
        <Properties>
          <string name="Name">CompanyIslandPorter</string>
          <string name="Source"><![CDATA[-- The island branch of a hired porter walks catches up the terrace stairs to the
-- racks and kitchen storage the owner placed on the plot.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local AnglerData = require(script.Parent.AnglerData)
local BoatService = require(script.Parent.BoatService)
local CompanyService = require(script.Parent.CompanyService)
local CustomerService = require(script.Parent.CustomerService)
local Navigation = require(script.Parent.NpcNavigation)
local Catalog = require(ReplicatedStorage.Shared.AnglerCatalog)
local Furniture = require(ReplicatedStorage.Shared.FurnitureCatalog)
local Layout = require(ReplicatedStorage.Shared.CompanyIslands)
local Porter = {}
local started = false
local states = {}

local function clear(state)
	if state.worker then
		state.worker.active = false
		state.worker.model:Destroy()
		state.worker = nil
	end
end

-- Just inside the plot gate, at the top of the stairs.
local function gate(island)
	return (island:GetAttribute("PlotFrame") * CFrame.new(0, 0, -26)).Position
end

-- Where to stand to use the first placed `itemId` on the plot, or the gate without one.
local function fixture(island, itemId)
	local plotFrame = island:GetAttribute("PlotFrame")
	local plot = island:FindFirstChild("PlotFurniture")
	for _, model in if plot then plot:GetChildren() else {} do
		if model:GetAttribute("ItemId") == itemId then
			local entry = { ItemId = itemId, X = model:GetAttribute("X"), Z = model:GetAttribute("Z"), R = model:GetAttribute("R") }
			return (Furniture.frame(plotFrame, entry, "Company") * CFrame.new(0, 0, Furniture.Items[itemId].Depth / 2 + 1.2)).Position
		end
	end
	return gate(island)
end

local function tick(island, state)
	local owner = Players:GetPlayerByUserId(island:GetAttribute("OwnerUserId") or 0)
	local profile = owner and BoatService.getProfile(owner)
	if not owner or not profile or not profile.Angler.Staff.Porter then
		clear(state)
		return
	end
	if state.owner ~= owner then clear(state); state.owner = owner end
	local frame = island:GetAttribute("IslandFrame")
	local function point(x, y, z) return (frame * Vector3.new(x, y, z)) end
	local foot, head = Layout.stairEnds(frame)
	if not state.worker or state.worker.humanoid.Health <= 0 then
		clear(state)
		local model = CustomerService.npc.spawn(point(30, 4.4, -82), "Porter")
		if island:GetAttribute("OwnerUserId") ~= owner.UserId or owner.Parent ~= Players then model:Destroy(); return end
		model.Name, model.Parent = "CompanyPorter", island
		state.worker = { model = model, humanoid = model:FindFirstChildOfClass("Humanoid"), root = model:FindFirstChild("HumanoidRootPart"), active = true }
	end
	local worker = state.worker
	local function valid()
		return worker.active and island.Parent ~= nil and island:GetAttribute("OwnerUserId") == owner.UserId and owner.Parent == Players
	end
	local function walk(position)
		return Navigation.walk(worker, position, valid, true)
	end
	local data = profile.Angler
	-- Refill the chef's prep table from saved storage even between fishing trips.
	local restock, stockPreview = {}, AnglerData.decode(data)
	for _, record in data.Storage do
		if AnglerData.canKitchenStorageAccept(stockPreview, record, Catalog.Fish) then
			table.insert(restock, record)
			table.insert(stockPreview.KitchenStorage.Fish, record)
		end
		if #restock == 6 then break end
	end
	if #restock > 0 then
		CustomerService.npc.bubble(worker, "Company porter · Restocking the kitchen")
		if frame:PointToObjectSpace(worker.root.Position).Y < 16 then
			if not walk(point(30, 4.4, -82)) or not walk(foot) or not walk(head) then return end
		end
		if not walk(fixture(island, "StorageRack")) or not walk(fixture(island, "KitchenStorage")) or not valid() then return end
		BoatService.updateProgress(owner, function(current)
			assert(valid() and current.Angler.Staff.Porter, "The island porter is no longer assigned.")
			for _, record in restock do
				local changed = AnglerData.restockFishToKitchenStorage(current.Angler, record, Catalog.Fish)
				if changed then current.Angler = changed end
			end
		end)
		return
	end
	local boatId, boat = CompanyService.mooredAtIsland(owner)
	if not boat then
		boatId, boat = BoatService.activeBoat(owner)
		local root = boat and boat.PrimaryPart
		local marker = island:FindFirstChild("BoatSpawn")
		if not root or not marker or (root.Position - marker.Position).Magnitude > 60 or root.AssemblyLinearVelocity.Magnitude > 2 then
			boatId, boat = nil, nil
		end
	end
	if not boat then
		CustomerService.npc.bubble(worker, "Company porter · Waiting for a docked boat")
		return
	end
	local hold = data.Holds[boatId] or {}
	local kitchen = false
	for _, item in hold do
		if item.Fish and AnglerData.canKitchenStorageAccept(data, item.Fish, Catalog.Fish) then kitchen = true; break end
	end
	local preview = AnglerData.decode(data)
	local load = {}
	for index, item in hold do
		if item.Fish then
			local fits = if kitchen then AnglerData.canKitchenStorageAccept(preview, item.Fish, Catalog.Fish)
				else #preview.Storage < AnglerData.storageCapacity(preview)
			if fits then
				table.insert(load, { Index = index, Fish = item.Fish })
				table.insert(if kitchen then preview.KitchenStorage.Fish else preview.Storage, item.Fish)
			end
		end
		if #load == 6 then break end
	end
	if #load == 0 then
		CustomerService.npc.bubble(worker, "Company porter · Waiting for catches or storage space")
		return
	end
	if frame:PointToObjectSpace(worker.root.Position).Y > 16 then
		if not walk(head) or not walk(foot) then return end
	end
	local pickup = boat:GetAttribute("PorterPickup") or point(30, 4.4, -144)
	if not walk(point(30, 4.4, -82)) or not walk(pickup) then return end
	CustomerService.npc.bubble(worker, "Company porter · Bringing catches to " .. (if kitchen then "the kitchen" else "storage"))
	local drop = fixture(island, if kitchen then "KitchenStorage" else "StorageRack")
	if not walk(point(30, 4.4, -82)) or not walk(foot)
		or not walk(head) or not walk(gate(island)) or not walk(drop) or not valid() then return end
	BoatService.updateProgress(owner, function(current)
		assert(valid() and current.Angler.Staff.Porter, "The island porter is no longer assigned.")
		-- Check the boat at delivery too. Cargo remains saved in its hold while carried.
		local companyId, companyBoat = CompanyService.mooredAtIsland(owner)
		local activeId, activeBoat = BoatService.activeBoat(owner)
		assert((companyId == boatId and companyBoat == boat) or (activeId == boatId and activeBoat == boat and boat.PrimaryPart and (boat.PrimaryPart.Position - island.BoatSpawn.Position).Magnitude <= 60 and boat.PrimaryPart.AssemblyLinearVelocity.Magnitude <= 2), "The boat left the company dock.")
		for index = #load, 1, -1 do
			local entry = load[index]
			local changed = if kitchen
				then AnglerData.unloadFishToKitchenStorage(current.Angler, boatId, entry.Index, entry.Fish, Catalog.Fish)
				else AnglerData.unloadFish(current.Angler, boatId, entry.Index, entry.Fish, true)
			if changed then current.Angler = changed end
		end
	end)
end

function Porter.start()
	if started then return end
	started = true
	task.spawn(function()
		while true do
			for _, island in CollectionService:GetTagged("CompanyIsland") do
				local state = states[island]
				if not state then state = {}; states[island] = state end
				if not state.busy then
					state.busy = true
					task.spawn(function()
						local ok, failure = pcall(tick, island, state)
						state.busy = false
						if not ok then warn("[Company porter] " .. tostring(failure)) end
					end)
				end
			end
			for island, state in states do
				if not island.Parent then clear(state); states[island] = nil end
			end
			task.wait(2)
		end
	end)
end

return Porter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="143">
        <Properties>
          <string name="Name">CompanyIslandService</string>
          <string name="Source"><![CDATA[-- Saved property entitlement, exclusive server plots, and the island's look: plain
-- wild land while free, the owner's village and furnished plot while assigned.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Access = require(script.Parent.CompanyIslandAccess)
local BoatService = require(script.Parent.BoatService)
local FurnitureService = require(script.Parent.FurnitureService)
local MapIslands = require(script.Parent.Map.CompanyIslands)
local Layout = require(ReplicatedStorage.Shared.CompanyIslands)

local Service = {}
local started = false
local reserved, busy, requests = {}, {}, {}
local update: RemoteEvent

local function properties()
	local result = CollectionService:GetTagged(Layout.TAG)
	table.sort(result, function(a, b)
		return a:GetAttribute("IslandId") < b:GetAttribute("IslandId")
	end)
	return result
end

local function nearBoard(player, island): boolean
	local board = island:FindFirstChild("PropertyBoard")
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return island:IsDescendantOf(workspace) and board ~= nil and root ~= nil
		and humanoid ~= nil and humanoid.Health > 0 and (root.Position - board.Position).Magnitude <= 14
end

local function refresh(island: Model, player: Player?)
	MapIslands.dress(island, player ~= nil)
	FurnitureService.syncCompany(island)
	local board = island:FindFirstChild("PropertyBoard")
	for _, label in if board then board:GetDescendants() else {} do
		if label:IsA("TextLabel") then
			label.Text = if player then player.DisplayName .. "'s Company" else Layout.Names[island:GetAttribute("IslandId")] .. " / $50,000"
		end
	end
	for _, prompt in island:GetDescendants() do
		if prompt:IsA("ProximityPrompt") then
			if CollectionService:HasTag(prompt, "ShopOwnerPrompt") then
				prompt:SetAttribute("OwnerUserId", if player then player.UserId else 0)
			elseif prompt.Name == "BuyCompanyIslandPrompt" then
				prompt.Enabled = player == nil
			end
		end
	end
end

local function assign(player: Player)
	if player.Parent ~= Players then
		return
	end
	local profile = BoatService.getProfile(player)
	if not profile or not profile.Angler.CompanyIsland then
		return
	end
	local existing = Access.get(player)
	if existing then
		refresh(existing, player)
		return
	end
	local free
	for _, island in properties() do
		if island:GetAttribute("OwnerUserId") == 0 and (not reserved[island] or reserved[island] == player) then
			free = free or island
			if island:GetAttribute("IslandId") == profile.Angler.CompanyIsland then
				free = island
				break
			end
		end
	end
	if free then
		free:SetAttribute("OwnerUserId", player.UserId)
		player:SetAttribute("CompanyIslandId", free:GetAttribute("IslandId"))
		player:SetAttribute("CompanyIslandWaiting", false)
		refresh(free, player)
		update:FireClient(player, "Notice", "Your company island is " .. Layout.Names[free:GetAttribute("IslandId")] .. ". Find it on the map around Gullhaven.")
	else
		player:SetAttribute("CompanyIslandId", nil)
		if not player:GetAttribute("CompanyIslandWaiting") then
			player:SetAttribute("CompanyIslandWaiting", true)
			update:FireClient(player, "Notice", "All company islands are occupied. Your ownership is saved; a plot will be assigned when one becomes free.")
		end
	end
end

local function inspect(player, island)
	local profile = BoatService.getProfile(player)
	local problem = Layout.purchaseProblem(profile)
	if island:GetAttribute("OwnerUserId") ~= 0 or reserved[island] then
		problem = "This island is already occupied."
	end
	return { Id = island:GetAttribute("IslandId"), Name = Layout.Names[island:GetAttribute("IslandId")], Price = Layout.PRICE, Problem = problem }
end

local function purchase(player, island)
	local problem = inspect(player, island).Problem
	if problem then
		return { Ok = false, Message = problem }
	elseif busy[player] then
		return { Ok = false, Message = "Your island purchase is being saved." }
	end
	-- Reserve before the DataStore call yields, so two buyers cannot buy one plot.
	busy[player], reserved[island] = true, player
	local ok, message = BoatService.updateProgress(player, function(current)
		local saved, failure = Layout.purchase(current, island:GetAttribute("IslandId"))
		assert(saved, failure)
		current.Cash, current.Angler = saved.Cash, saved.Angler
	end)
	busy[player], reserved[island] = nil, nil
	if ok then
		assign(player)
		message ="Island purchased! Your storage racks, prep benches, kitchen storage and desk are in build mode: press B on your island's plot to place them."
	end
	return { Ok = ok, Message = message }
end

function Service.start()
	if started then return end
	started = true
	local remotes = Instance.new("Folder")
	remotes.Name = "CompanyIslands"
	local request = Instance.new("RemoteFunction")
	request.Name, request.Parent = "Request", remotes
	update = Instance.new("RemoteEvent")
	update.Name, update.Parent, remotes.Parent = "Update", remotes, ReplicatedStorage
	request.OnServerInvoke = function(player, action, id)
		if os.clock() - (requests[player] or -math.huge) < 0.4 then
			return { Ok = false, Message = "Please wait a moment." }
		end
		requests[player] = os.clock()
		if not Layout.validId(id) then return { Ok = false, Message = "Unknown island." } end
		for _, island in properties() do
			if island:GetAttribute("IslandId") == id and nearBoard(player, island) then
				if action == "Inspect" then return { Ok = true, Island = inspect(player, island) } end
				if action == "Buy" then return purchase(player, island) end
			end
		end
		return { Ok = false, Message = "Walk up to the island's purchase board." }
	end
	local function watchIsland(island)
		if not island:IsA("Model") then return end
		-- A Studio bake can contain session ownership; every server allocates afresh.
		island:SetAttribute("OwnerUserId", 0)
		refresh(island, nil)
	end
	for _, island in properties() do watchIsland(island) end
	CollectionService:GetInstanceAddedSignal(Layout.TAG):Connect(watchIsland)
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		if prompt.Name ~= "BuyCompanyIslandPrompt" then return end
		local island = prompt:FindFirstAncestorOfClass("Model")
		if island and CollectionService:HasTag(island, Layout.TAG) and nearBoard(player, island) then
			update:FireClient(player, "Inspect", inspect(player, island))
		end
	end)
	local function watch(player)
		player:GetAttributeChangedSignal("AnglerRevision"):Connect(function() assign(player) end)
		player:GetAttributeChangedSignal("BoatDataStatus"):Connect(function() assign(player) end)
		assign(player)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do watch(player) end
	Players.PlayerRemoving:Connect(function(player)
		local island = Access.get(player)
		if island then
			island:SetAttribute("OwnerUserId", 0)
			refresh(island, nil)
		end
		for property, buyer in reserved do
			if buyer == player then reserved[property] = nil end
		end
		requests[player], busy[player] = nil, nil
		task.defer(function()
			for _, waiting in Players:GetPlayers() do
				if waiting ~= player and not Access.get(waiting) then assign(waiting) end
			end
		end)
	end)
end

return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="144">
        <Properties>
          <string name="Name">CompanyService</string>
          <string name="Source"><![CDATA[-- The Company path's hired fisherman. He takes the boat the owner assigned (Home ▸
-- Staff) from its mooring beside the right-hand pier, sails out to open water and
-- fishes on a timer. Every catch is saved straight into that boat's cargo hold.
-- When the hold is full, or after a few catches, he sails home and moors; the
-- porter unloads the hold like any docked boat, then he heads out again. The
-- boat is a display copy moved by the server, so it never needs a driver.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local AnglerData = require(script.Parent.AnglerData)
local BoatService = require(script.Parent.BoatService)
local CompanyIslandAccess = require(script.Parent.CompanyIslandAccess)
local CustomerService = require(script.Parent.CustomerService)
local Rowboat = require(script.Parent.Rowboat)
local FishingBoat = require(script.Parent.FishingBoat)
local Trawler = require(script.Parent.Trawler)
local BoatCatalog = require(ReplicatedStorage.Shared.BoatCatalog)
local Biomes = require(ReplicatedStorage.Shared.Biomes)
local Catalog = require(ReplicatedStorage.Shared.AnglerCatalog)
local DayNight = require(ReplicatedStorage.Shared.DayNight)
local CatchConditions = require(ReplicatedStorage.Shared.CatchConditions)
local FishCatch = require(ReplicatedStorage.Shared.FishCatch)
local FishMutations = require(ReplicatedStorage.Shared.FishMutations)
local MutationContext = require(ReplicatedStorage.Shared.MutationContext)
local Paths = require(ReplicatedStorage.Shared.Paths)
local Seasons = require(ReplicatedStorage.Shared.Seasons)

local CompanyService = {}
local BASE_TAG = "PlayerBase"
local builders = { Rowboat = Rowboat, FishingBoat = FishingBoat, Trawler = Trawler }
-- Dock-local studs (BoatDockFrame: -Z is the water, +X the right-hand pier at x=17).
local MOORINGS = {
	{ boat = CFrame.new(28, 0, -24), pier = Vector3.new(17, 3.2, -24), pickup = Vector3.new(17, 3.2, -24) },
	{ boat = CFrame.new(-28, 0, -24), pier = Vector3.new(-17, 3.2, -24), pickup = Vector3.new(-17, 3.2, -24) },
}
local CATCH_SECONDS = Vector2.new(16, 26)
local TRIP_CATCHES = 8
local REST_SECONDS = 6
local SPEED_SCALE = 0.55
local TURN_RATE = 1.4

local npc = CustomerService.npc
local random = Random.new()
local started = false
local crews: { [Model]: any } = {}
local folder: Folder

local function dockFrame(base: Model): CFrame?
	local owner = Players:GetPlayerByUserId(base:GetAttribute("OwnerUserId") or 0)
	local property = owner and CompanyIslandAccess.get(owner)
	local frame = (property or base):GetAttribute("BoatDockFrame")
	return if typeof(frame) == "CFrame" then frame else nil
end

local function water(position: Vector3): boolean
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Include
	parameters.FilterDescendantsInstances = { workspace.Terrain }
	parameters.IgnoreWater = false
	local result = workspace:Raycast(
		Vector3.new(position.X, Biomes.WaterLevel + 14, position.Z),
		Vector3.new(0, -32, 0),
		parameters
	)
	return result ~= nil and result.Material == Enum.Material.Water
end

-- Every few studs along a straight run must be open water.
local function clearRun(from: Vector3, to: Vector3): boolean
	local steps = math.max(1, math.ceil((to - from).Magnitude / 8))
	for step = 0, steps do
		if not water(from:Lerp(to, step / steps)) then
			return false
		end
	end
	return true
end

-- The fisherman's hired state on the owner's profile, or nil when he isn't working.
local function assignment(profile): (string?, any?)
	local angler = profile and profile.Angler
	local boatId = angler and angler.FishermanBoat
	if
		not angler
		or not angler.Staff.Fisherman
		or not Paths.unlocked(profile, "Company")
		or not boatId
		or not profile.OwnedBoats[boatId]
		or not builders[boatId]
	then
		return nil, nil
	end
	return boatId, BoatCatalog[boatId]
end

local function holdFish(profile, boatId: string): number
	local count = 0
	for _, item in profile.Angler.Holds[boatId] or {} do
		if item.Fish then
			count += 1
		end
	end
	return count
end

local function despawn(crew)
	crew.active = false
	if crew.model then
		crew.model:Destroy()
	end
	crews[crew.base] = nil
end

local function status(crew, text: string)
	if crew.worker then
		npc.bubble(crew.worker, "Fisherman · " .. text)
	end
end

-- Hangs every part of `model` off the anchored hull root, so sailing moves one part
-- instead of replicating hundreds of anchored CFrames every frame. The builders
-- already joint each piece to the root; anything loose gets a weld.
local function carry(model: Instance, root: BasePart)
	root.Anchored = true
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part ~= root then
			if not part:FindFirstChildWhichIsA("JointInstance") and not part:FindFirstChildOfClass("WeldConstraint") then
				local weld = Instance.new("WeldConstraint")
				weld.Part0, weld.Part1, weld.Parent = root, part, part
			end
			part.Anchored = false
		end
	end
end

local function build(base: Model, owner: Player, boatId: string)
	local dock = dockFrame(base)
	if not dock then
		return nil
	end
	local mooring = MOORINGS[1]
	local property = CompanyIslandAccess.get(owner)
	local options = if property then {
		{ boat = CFrame.new(45, 0, -24), pier = Vector3.new(30, 4.4, -24), pickup = Vector3.new(30, 4.4, -24) },
		{ boat = CFrame.new(-45, 0, -24), pier = Vector3.new(-30, 4.4, -24), pickup = Vector3.new(-30, 4.4, -24) },
	} else MOORINGS
	mooring = options[1]
	for _, option in options do
		if water((dock * option.boat).Position) then
			mooring = option
			break
		end
	end
	local moor = dock * mooring.boat
	local model = builders[boatId].build(moor, true)
	model.Name = "CompanyBoat_" .. owner.UserId
	model:SetAttribute("OwnerUserId", owner.UserId)
	model:SetAttribute("BoatId", boatId)
	model:SetAttribute("CompanyBoat", true)
	local root = model.PrimaryPart :: BasePart
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			-- Players can't board or be shoved by a hull the server slides around.
			part.CanCollide, part.CanTouch = false, false
			if part:IsA("Seat") or part:IsA("VehicleSeat") then
				part.Disabled = true
			end
		end
	end
	local crew = {
		base = base,
		property = property,
		ownerId = owner.UserId,
		boatId = boatId,
		-- Wears the owner's refit dock paint and keeps the speed of its motors.
		spec = BoatService.outfit(owner, boatId, model),
		model = model,
		active = true,
		mode = "Moored",
		dock = dock,
		moor = moor,
		pier = (dock * CFrame.new(mooring.pier)).Position,
		pickup = (dock * CFrame.new(mooring.pickup)).Position,
		restUntil = os.clock() + REST_SECONDS,
		path = {},
		catches = 0,
		frame = moor,
		root = root,
		-- The hull root sits below the waterline frame it was built at.
		rootOffset = moor:ToObjectSpace(root.CFrame),
	}
	-- After the outfit, which can hang the trawl net off the hull.
	carry(model, root)
	model:SetAttribute("PorterPier", crew.pier)
	model:SetAttribute("PorterPickup", crew.pickup)
	model.Parent = folder
	-- The fisherman stands at the stern with a rod over the side.
	task.spawn(function()
		local ok, worker = pcall(npc.spawn, (moor * CFrame.new(0, 3, 0)).Position, "Fisherman")
		if not ok then
			warn("[Company] Fisherman: " .. tostring(worker))
			return
		end
		if not crew.active then
			worker:Destroy()
			return
		end
		worker.Name = "Fisherman"
		local humanoid = worker:FindFirstChildOfClass("Humanoid") :: Humanoid
		local workerRoot = worker:FindFirstChild("HumanoidRootPart") :: BasePart
		for _, part in worker:GetDescendants() do
			if part:IsA("BasePart") then
				part.CanCollide, part.Massless = false, true
			end
		end
		local floor = model:GetAttribute("DryFloorHeight") or 0.8
		local stand = crew.frame
			* CFrame.new(0, floor + humanoid.HipHeight + workerRoot.Size.Y / 2, crew.spec.Length * 0.28)
		worker:PivotTo(stand * CFrame.Angles(0, math.pi / 2, 0))
		local rod = Instance.new("Part")
		rod.Name = "FishermanRod"
		rod.Size = Vector3.new(0.12, 0.12, 7)
		rod.Color, rod.Material = Color3.fromRGB(70, 52, 38), Enum.Material.Wood
		rod.CanCollide, rod.CanQuery, rod.CanTouch = false, false, false
		rod.CFrame = stand
			* CFrame.new(-1.6, 0.6, 0)
			* CFrame.Angles(0, math.pi / 2, 0)
			* CFrame.Angles(math.rad(28), 0, 0)
			* CFrame.new(0, 0, -3.2)
		rod.Parent = worker
		carry(worker, root)
		worker.Parent = model
		crew.worker = { model = worker, humanoid = humanoid, root = root }
		status(crew, "Getting the boat ready")
	end)
	return crew
end

-- Straight out from the mooring, past the end of the piers.
local function mouthOf(crew): Vector3
	local side = crew.dock:PointToObjectSpace(crew.moor.Position).X
	return (crew.dock * CFrame.new(side, 0, if crew.property then -110 else -64)).Position
end

-- A fishing spot in open water reachable in a straight run from the harbour mouth.
local function plan(crew): { CFrame }
	local mouth = mouthOf(crew)
	local spot = mouth
	for _ = 1, 24 do
		local candidate = (crew.dock * CFrame.new(random:NextNumber(-90, 90), 0, -random:NextNumber(95, 210))).Position
		if water(candidate) and clearRun(mouth, candidate) then
			spot = candidate
			break
		end
	end
	return { CFrame.new(mouth), CFrame.new(spot) }
end

local function sail(crew, waypoints: { CFrame }, mode: string)
	crew.path, crew.mode = waypoints, mode
end

local function startTrip(crew)
	crew.catches = 0
	sail(crew, plan(crew), "Outbound")
	status(crew, "Heading out to fish")
end

local function returnHome(crew)
	sail(crew, { CFrame.new(mouthOf(crew)), crew.moor }, "Returning")
	status(crew, "Sailing home with the catch")
end

local function landFish(crew, owner: Player)
	local position = crew.frame.Position
	local pool = FishCatch.inSeason(
		Catalog.poolAt(CatchConditions.area(position)),
		Catalog.Fish,
		(Seasons.current()),
		CatchConditions.at(position)
	)
	local function rng()
		return random:NextNumber()
	end
	local roll = FishCatch.roll(pool, Catalog.Fish, Catalog.Rarities, rng)
	local traits = FishMutations.roll(
		Catalog.Fish[roll.FishId],
		DayNight.isNight(DayNight.clockTime()),
		rng,
		nil,
		MutationContext.at(position, owner)
	)
	roll.Traits = traits
	roll.Value = FishMutations.value(roll.Value, traits.Mutation, traits.Corruptions)
	local full = false
	local ok = BoatService.updateProgress(owner, function(current)
		local boatId = assignment(current)
		assert(boatId == crew.boatId, "The fisherman has another boat now.")
		local data = AnglerData.fishermanCatch(
			current.Angler,
			crew.boatId,
			crew.spec,
			roll,
			os.time(),
			Catalog.Fish,
			Catalog.Mutations
		)
		full = data == nil
		if data then
			current.Angler = data
		end
	end)
	if ok and not full then
		crew.catches += 1
		local fish = Catalog.Fish[roll.FishId]
		status(crew, string.format("Landed a %s (%d this trip)", if fish then fish.Name else roll.FishId, crew.catches))
	end
	if full or crew.catches >= TRIP_CATCHES then
		returnHome(crew)
	end
end

-- Steers the display hull along its waypoints at a fraction of the boat's speed.
local function move(crew, dt: number)
	local target = crew.path[1]
	if not target then
		return
	end
	local position = crew.frame.Position
	local goal = Vector3.new(target.Position.X, Biomes.WaterLevel, target.Position.Z)
	local offset = Vector3.new(goal.X - position.X, 0, goal.Z - position.Z)
	local speed = crew.spec.ForwardSpeed * SPEED_SCALE
	local _, yaw = crew.frame:ToOrientation()
	if offset.Magnitude <= math.max(1, speed * dt) then
		table.remove(crew.path, 1)
		if #crew.path == 0 and crew.mode == "Returning" then
			crew.frame = crew.moor
			crew.root.CFrame = crew.moor * crew.rootOffset
			return
		end
		crew.frame = CFrame.new(Vector3.new(goal.X, Biomes.WaterLevel, goal.Z)) * CFrame.Angles(0, yaw, 0)
	else
		-- Boats face -Z: turn towards the goal, then move along the bow.
		local wanted = math.atan2(-offset.X, -offset.Z)
		local delta = (wanted - yaw + math.pi) % (2 * math.pi) - math.pi
		yaw += math.clamp(delta, -TURN_RATE * dt, TURN_RATE * dt)
		local heading = CFrame.Angles(0, yaw, 0)
		local step = heading.LookVector * math.min(speed * dt, offset.Magnitude) * math.max(0.25, math.cos(delta))
		crew.frame = CFrame.new(Vector3.new(position.X, Biomes.WaterLevel, position.Z) + step) * heading
	end
	-- Only the anchored root replicates; the welded hull and crew follow it on each client.
	crew.root.CFrame = crew.frame * crew.rootOffset
end

-- One decision per tick: rest at the mooring, keep fishing, or set off again.
local function think(crew, owner: Player, profile)
	if crew.mode == "Moored" then
		local waiting = holdFish(profile, crew.boatId)
		if waiting > 0 then
			crew.restUntil = os.clock() + REST_SECONDS
			status(
				crew,
				if profile.Angler.Staff.Porter
					then string.format("Waiting for the porter to unload %d fish", waiting)
					else "Hire a porter to unload my catch"
			)
		elseif os.clock() >= crew.restUntil then
			startTrip(crew)
		end
	elseif crew.mode == "Outbound" and #crew.path == 0 then
		crew.mode = "Fishing"
		crew.nextCatch = os.clock() + random:NextNumber(CATCH_SECONDS.X, CATCH_SECONDS.Y)
		status(crew, "Fishing")
	elseif crew.mode == "Fishing" and os.clock() >= crew.nextCatch and not crew.busy then
		crew.busy = true
		crew.nextCatch = os.clock() + random:NextNumber(CATCH_SECONDS.X, CATCH_SECONDS.Y)
		task.spawn(function()
			local ok, failure = pcall(landFish, crew, owner)
			crew.busy = false
			if not ok then
				warn("[Company] Catch: " .. tostring(failure))
			end
		end)
	elseif crew.mode == "Returning" and #crew.path == 0 then
		crew.mode = "Moored"
		crew.restUntil = os.clock() + REST_SECONDS
		local count = holdFish(profile, crew.boatId)
		if count > 0 then
			npc.notify(owner, string.format("Your fisherman is back with %d fish in the %s.", count, crew.spec.Name))
		end
	end
end

-- The moored company boat for the porter (CustomerService), while it is tied up.
local function moored(shop, owner: Player): (string?, Model?)
	local crew = crews[shop.base]
	if crew and not crew.property and crew.active and crew.mode == "Moored" and crew.ownerId == owner.UserId and crew.model.Parent then
		return crew.boatId, crew.model
	end
	return nil, nil
end

-- Island porters have their own physical route from the quay to the upper houses.
function CompanyService.mooredAtIsland(owner: Player): (string?, Model?)
	for _, crew in crews do
		if crew.property and crew.active and crew.mode == "Moored" and crew.ownerId == owner.UserId and crew.model.Parent then
			return crew.boatId, crew.model
		end
	end
	return nil, nil
end

local function syncBase(base: Model)
	local crew = crews[base]
	local owner = npc.ownerOf(base)
	local profile = owner and BoatService.getProfile(owner)
	local boatId = assignment(profile)
	if crew and (not owner or crew.ownerId ~= owner.UserId or crew.boatId ~= boatId or crew.dock ~= dockFrame(base)) then
		despawn(crew)
		crew = nil
	end
	if not crew and owner and boatId then
		crew = build(base, owner, boatId)
		crews[base] = crew
	end
	return crew, owner, profile
end

function CompanyService.start()
	if started then
		return
	end
	started = true
	folder = Instance.new("Folder")
	folder.Name = "CompanyBoats"
	folder.Parent = workspace
	CustomerService.useCompanyDock(moored)
	BoatService.setBoatLock(function(player, boatId)
		local profile = BoatService.getProfile(player)
		if assignment(profile) == boatId then
			return "Your fisherman is using the "
				.. BoatCatalog[boatId].Name
				.. ". Give him another boat in Home ▸ Staff to sail it yourself."
		end
		return nil
	end)
	RunService.Heartbeat:Connect(function(dt)
		for _, crew in crews do
			if crew.active and #crew.path > 0 then
				move(crew, dt)
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, base in CollectionService:GetTagged(BASE_TAG) do
				if not base:IsA("Model") then
					continue
				end
				local ok, failure = pcall(function()
					local crew, owner, profile = syncBase(base)
					if crew and owner and profile then
						think(crew, owner, profile)
					end
				end)
				if not ok then
					warn("[Company] " .. tostring(failure))
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		for _, crew in crews do
			if crew.ownerId == player.UserId then
				despawn(crew)
			end
		end
	end)
end

return CompanyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="145">
        <Properties>
          <string name="Name">CrabCageService</string>
          <string name="Source"><![CDATA[-- Crab cages at the angler's own dock. Cages bought at Tide & Tackle (FishingService)
-- wait in stock as one hotbar Tool; clicking open water by the base's piers drops a
-- cage there. After each soak the owner pulls it up for a crab, which lands in their
-- hand or backpack like any catch, and after CrabCages.USES hauls the cage wears out.
-- Cages are saved in dock-local studs, so they follow the angler to whichever base
-- they get next session; the server rebuilds the models from the saved list.
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AnglerData = require(script.Parent.AnglerData)
local BoatService = require(script.Parent.BoatService)
local GamepassService = require(script.Parent.GamepassService)
local Props = require(script.Parent.Map.Props)
local BackpackCatalog = require(ReplicatedStorage.Shared.BackpackCatalog)
local Biomes = require(ReplicatedStorage.Shared.Biomes)
local Catalog = require(ReplicatedStorage.Shared.AnglerCatalog)
local CrabCages = require(ReplicatedStorage.Shared.CrabCages)
local DayNight = require(ReplicatedStorage.Shared.DayNight)
local FishCatch = require(ReplicatedStorage.Shared.FishCatch)
local FishModels = require(ReplicatedStorage.Shared.FishModels)
local FishMutations = require(ReplicatedStorage.Shared.FishMutations)
local MutationContext = require(ReplicatedStorage.Shared.MutationContext)
local StaffCatalog = require(ReplicatedStorage.Shared.StaffCatalog)
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))

local CrabCageService = {}
local BASE_TAG = "PlayerBase"
local OWNER_PROMPT_TAG = "ShopOwnerPrompt"
-- Placed cage models; the client bobs their floats.
local CAGE_TAG = "CrabCage"
local TOOL_ATTRIBUTE = "CrabCageTool"
local PROMPT_NAME = "PullCrabCagePrompt"
local TOOL_SCALE = 0.45
local READY = Color3.fromRGB(111, 202, 125)
local SOAKING = Color3.fromRGB(250, 214, 64)
local started = false
local update: RemoteEvent
local requests: { [Player]: number } = {}
local busy: { [Player]: boolean } = {}
local random = Random.new()

local function ownerOf(base: Model): Player?
	local userId = base:GetAttribute("OwnerUserId")
	return if type(userId) == "number" and userId ~= 0 then Players:GetPlayerByUserId(userId) else nil
end

local function baseOf(player: Player): Model?
	for _, base in CollectionService:GetTagged(BASE_TAG) do
		if base:GetAttribute("OwnerUserId") == player.UserId and base:IsA("Model") then
			return base
		end
	end
	return nil
end

local function dockFrame(base: Model): CFrame?
	local frame = base:GetAttribute("BoatDockFrame")
	return if typeof(frame) == "CFrame" then frame else nil
end

local function notify(player: Player, message: string)
	if player.Parent == Players and message ~= "" then
		update:FireClient(player, "Notice", message)
	end
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil
	end
	return root
end

local function formatSeconds(seconds: number): string
	return if seconds >= 60 then string.format("%d:%02d", seconds // 60, seconds % 60) else seconds .. "s"
end

-- The cage's base sits under the water so its float rides on the surface. The
-- client's placement preview builds the same frame. Every cage faces along the
-- dock; a per-spot turn made the preview spin as the pointer crossed spots.
local function cageFrame(dock: CFrame, x: number, z: number): CFrame
	local spot = dock * Vector3.new(x, 0, z)
	return CFrame.new(spot.X, Biomes.WaterLevel - Props.CRAB_CAGE_WATERLINE, spot.Z) * dock.Rotation
end

local function key(x: number, z: number): string
	return string.format("%.1f|%.1f", x, z)
end

-- A short burst of spray where a cage goes in or comes up.
local function splash(position: Vector3)
	local spray = Instance.new("Part")
	spray.Name = "CrabCageSplash"
	spray.Size = Vector3.one
	spray.Transparency, spray.Anchored = 1, true
	spray.CanCollide, spray.CanQuery, spray.CanTouch = false, false, false
	spray.CFrame = CFrame.new(position)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(Color3.fromRGB(222, 240, 246))
	emitter.Transparency = NumberSequence.new(0.15, 1)
	emitter.Size = NumberSequence.new(0.4, 0.1)
	emitter.Lifetime = NumberRange.new(0.5, 0.9)
	emitter.Speed = NumberRange.new(6, 11)
	emitter.SpreadAngle = Vector2.new(40, 40)
	emitter.Acceleration = Vector3.new(0, -32, 0)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Rate = 90
	emitter.Parent = spray
	spray.Parent = workspace
	task.delay(0.25, function()
		emitter.Rate = 0
	end)
	Debris:AddItem(spray, 2)
end

----------------------------------------------------------------------------------------------------
-- The hotbar cage

local function buildTool(): Tool
	local tool = Instance.new("Tool")
	tool.Name = "Crab Cage"
	tool.CanBeDropped = false
	tool.Grip = CFrame.Angles(0, math.rad(180), 0)
	tool:SetAttribute(TOOL_ATTRIBUTE, true)
	-- The client's placement preview sizes and sinks its copy of the cage with these.
	tool:SetAttribute("CageSize", Props.CRAB_CAGE_SIZE)
	tool:SetAttribute("CageScale", TOOL_SCALE)
	tool:SetAttribute("Waterline", Props.CRAB_CAGE_WATERLINE)
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.4, 0.4, 0.4)
	handle.Transparency = 1
	handle.CanCollide, handle.CanTouch, handle.CanQuery = false, false, false
	handle.Massless = true
	handle.Parent = tool
	local model = Props.crabCage(tool, CFrame.new(), false)
	model.Name = "CageModel"
	model:ScaleTo(TOOL_SCALE)
	-- Carried by the shackle on its bridle, so the cage hangs below the hand.
	handle.CFrame = CFrame.new(0, (Props.CRAB_CAGE_SIZE.Y + 0.47) * TOOL_SCALE, 0)
	for _, piece in model:GetDescendants() do
		if piece:IsA("BasePart") then
			piece.Anchored, piece.Massless = false, true
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1 = handle, piece
			weld.Parent = piece
		end
	end
	return tool
end

-- Keeps exactly one cage Tool while any cages are in stock; its name shows the count.
local function syncTool(player: Player)
	local profile = BoatService.getProfile(player)
	if not profile then
		return
	end
	local stock = profile.Angler.CrabCages.Stock
	local backpack = player:FindFirstChildOfClass("Backpack")
	local kept: Tool? = nil
	for _, container in { player.Character, backpack } do
		if not container then
			continue
		end
		for _, child in container:GetChildren() do
			if child:IsA("Tool") and child:GetAttribute(TOOL_ATTRIBUTE) then
				if stock > 0 and not kept then
					kept = child
				else
					child:Destroy()
				end
			end
		end
	end
	if stock > 0 and not kept and backpack then
		kept = buildTool()
		kept.Parent = backpack
	end
	if kept then
		kept.Name = if stock > 1 then string.format("Crab Cage x%d", stock) else "Crab Cage"
		kept.ToolTip = string.format("%d in stock · click the water by your dock to drop one", stock)
	end
end

local function holdingCage(player: Player): boolean
	local character = player.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	return tool ~= nil and tool:GetAttribute(TOOL_ATTRIBUTE) == true
end

----------------------------------------------------------------------------------------------------
-- Cages in the water

local function cageFolder(base: Model): Folder
	local folder = base:FindFirstChild("CrabCages")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "CrabCages"
		folder.Parent = base
	end
	return folder :: Folder
end

local function buildCage(folder: Folder, dock: CFrame, cage, userId: number): Model
	local frame = cageFrame(dock, cage.X, cage.Z)
	local model = Props.crabCage(folder, frame, true)
	model:SetAttribute("X", cage.X)
	model:SetAttribute("Z", cage.Z)
	model:SetAttribute("OwnerUserId", userId)
	model:SetAttribute("CageFrame", frame)
	local anchor = Instance.new("Part")
	anchor.Name = "CagePromptAnchor"
	anchor.Size = Vector3.one
	anchor.Transparency, anchor.Anchored = 1, true
	anchor.CanCollide, anchor.CanQuery, anchor.CanTouch = false, false, false
	anchor.CFrame = frame * CFrame.new(0, Props.CRAB_CAGE_SIZE.Y + 0.6, 0)
	anchor.Parent = model
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = PROMPT_NAME
	prompt.ActionText = "Pull up"
	prompt.ObjectText = "Crab Cage"
	prompt.HoldDuration = 0.6
	-- Reaches down from the pier to anywhere the cage could have been dropped from it.
	prompt.MaxActivationDistance = CrabCages.REACH + 4
	prompt.RequiresLineOfSight = false
	prompt.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
	-- Owners' clients show it only while a crab is in (see ShopCustomers).
	prompt:SetAttribute("OwnerUserId", userId)
	prompt:SetAttribute("Available", false)
	CollectionService:AddTag(prompt, OWNER_PROMPT_TAG)
	prompt.Parent = anchor
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "CageStatus"
	billboard.Size = UDim2.fromOffset(200, 42)
	billboard.StudsOffset = Vector3.new(0, 1.8, 0)
	billboard.MaxDistance = 60
	billboard.Parent = anchor
	for _, row in { { "State", 0, 24, 16 }, { "Uses", 24, 18, 13 } } do
		local label = Instance.new("TextLabel")
		label.Name = row[1]
		label.Position, label.Size = UDim2.fromOffset(0, row[2]), UDim2.new(1, 0, 0, row[3])
		label.BackgroundTransparency = 1
		label.TextSize, label.Text = row[4], ""
		Theme.text(label)
		label.Parent = billboard
	end
	CollectionService:AddTag(model, CAGE_TAG)
	return model
end

-- A crab clinging to the inside of the mesh, half out of the water, says the
-- cage is ready. Which crab it really is stays a surprise until the haul.
local function showCrab(model: Model, frame: CFrame)
	local crab = FishModels.create("ShoreCrab")
	if not crab then
		return
	end
	crab.Name = "CaughtCrab"
	local bounds = crab:GetAttribute("BoundsSize") :: Vector3
	crab:ScaleTo(1.3 / math.max(bounds.X, bounds.Y, bounds.Z, 0.1))
	local wall = Props.CRAB_CAGE_SIZE.Z / 2 - 0.12
	local spot = frame * CFrame.new(0.55, Props.CRAB_CAGE_WATERLINE - 0.15, wall)
	-- Head up the mesh, back facing into the cage.
	crab:PivotTo(CFrame.fromMatrix(spot.Position, frame.UpVector, frame.LookVector))
	local box, size = crab:GetBoundingBox()
	local belly = frame:PointToObjectSpace(box.Position - box.UpVector * size.Y / 2)
	crab:PivotTo(crab:GetPivot() + frame:VectorToWorldSpace(Vector3.new(0, 0, wall - belly.Z)))
	crab.Parent = model
end

-- The prompt, the billboard, the flag and the crab follow the saved cage.
local function refreshCage(model: Model, cage, now: number)
	local remaining = CrabCages.remaining(cage, now)
	local ready = remaining <= 0
	local anchor = model:FindFirstChild("CagePromptAnchor")
	local prompt = anchor and anchor:FindFirstChild(PROMPT_NAME)
	if prompt then
		prompt:SetAttribute("Available", ready)
	end
	local billboard = anchor and anchor:FindFirstChild("CageStatus")
	local state = billboard and billboard:FindFirstChild("State") :: TextLabel?
	local uses = billboard and billboard:FindFirstChild("Uses") :: TextLabel?
	if state and uses then
		state.Text = if ready then "Crab inside!" else "Soaking · " .. formatSeconds(remaining)
		state.TextColor3 = if ready then READY else Theme.Colors.Text
		uses.Text = string.format("%d of %d hauls left", cage.Uses, CrabCages.USES)
	end
	if model:GetAttribute("Ready") == ready then
		return
	end
	model:SetAttribute("Ready", ready)
	local float = model:FindFirstChild("Float")
	local flag = float and float:FindFirstChild("Flag")
	if flag and flag:IsA("BasePart") then
		flag.Color = if ready then READY else SOAKING
	end
	local crab = model:FindFirstChild("CaughtCrab")
	if crab and not ready then
		crab:Destroy()
	elseif ready and not crab then
		local frame = model:GetAttribute("CageFrame")
		if typeof(frame) == "CFrame" then
			showCrab(model, frame)
		end
	end
end

-- The owner's saved cages, decoded again only when their profile has changed:
-- the countdown below asks every second.
local placedCache: { [Player]: { revision: any, placed: { any }? } } = {}
local function placedOf(player: Player): { any }?
	local revision = player:GetAttribute("AnglerRevision")
	local cached = placedCache[player]
	if not cached or cached.revision ~= revision then
		local profile = BoatService.getProfile(player)
		cached = { revision = revision, placed = profile and profile.Angler.CrabCages.Placed }
		placedCache[player] = cached
	end
	return cached.placed
end

-- Matches the base's cage models to its owner's saved cages.
local function refreshBase(base: Model)
	local owner = ownerOf(base)
	local placed = owner and placedOf(owner)
	local dock = dockFrame(base)
	local wanted = {}
	if owner and placed and dock then
		for _, cage in placed do
			wanted[key(cage.X, cage.Z)] = cage
		end
	end
	local folder = base:FindFirstChild("CrabCages")
	if not folder and not next(wanted) then
		return
	end
	folder = folder or cageFolder(base)
	local now = os.time()
	local shown = {}
	for _, model in folder:GetChildren() do
		local x, z = model:GetAttribute("X"), model:GetAttribute("Z")
		local spot = if type(x) == "number" and type(z) == "number" then key(x, z) else ""
		local cage = wanted[spot]
		if model:IsA("Model") and cage and not shown[spot] and model:GetAttribute("OwnerUserId") == owner.UserId then
			shown[spot] = true
			refreshCage(model, cage, now)
		else
			model:Destroy()
		end
	end
	for spot, cage in wanted do
		if not shown[spot] then
			refreshCage(buildCage(folder, dock :: CFrame, cage, owner.UserId), cage, now)
		end
	end
end

local function refreshPlayer(player: Player)
	syncTool(player)
	local base = baseOf(player)
	if base then
		refreshBase(base)
	end
end

----------------------------------------------------------------------------------------------------
-- Dropping and pulling up

local function openWater(position: Vector3, ignore: { Instance }): boolean
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances = ignore
	parameters.IgnoreWater = false
	local result = workspace:Raycast(
		Vector3.new(position.X, Biomes.WaterLevel + 12, position.Z),
		Vector3.new(0, -24, 0),
		parameters
	)
	return result ~= nil and result.Instance == workspace.Terrain and result.Material == Enum.Material.Water
end

local function place(player: Player, target: any): (boolean, string)
	if
		typeof(target) ~= "Vector3"
		or target ~= target
		or math.abs(target.X) > 1e6
		or math.abs(target.Y) > 1e6
		or math.abs(target.Z) > 1e6
	then
		return false, ""
	end
	local profile = BoatService.getProfile(player)
	if not profile then
		return false, "Your progress is still loading. Try again in a moment."
	end
	local base = baseOf(player)
	local dock = base and dockFrame(base)
	if not base or not dock then
		return false, "You need a dock of your own to set crab cages."
	end
	local root = rootOf(player)
	if not root or not holdingCage(player) then
		return false, "Equip a crab cage from your hotbar first."
	end
	local reach = target - root.Position
	if Vector3.new(reach.X, 0, reach.Z).Magnitude > CrabCages.REACH + 2 then
		return false, "That's too far away. Walk to the edge of your pier."
	end
	local spot = dock:PointToObjectSpace(target)
	local x, z = CrabCages.round(spot.X), CrabCages.round(spot.Z)
	local problem = CrabCages.placeProblem(profile.Angler, x, z)
	if problem then
		return false, problem
	end
	-- The whole footprint and the float must sit in open water, clear of piers,
	-- pilings, the quay and moored boats.
	local frame = cageFrame(dock, x, z)
	local ignore = {}
	for _, other in Players:GetPlayers() do
		if other.Character then
			table.insert(ignore, other.Character)
		end
	end
	for _, point in CrabCages.footprint(Props.CRAB_CAGE_SIZE) do
		if not openWater(frame * point, ignore) then
			return false, "Drop it into open water, clear of the piers."
		end
	end
	local now = os.time()
	local soak = CrabCages.soak(function()
		return random:NextNumber()
	end)
	busy[player] = true
	local ok, message = BoatService.updateProgress(player, function(current)
		CrabCages.place(current.Angler, x, z, now, soak)
	end)
	busy[player] = nil
	if not ok then
		return false, message
	end
	splash(Vector3.new(frame.X, Biomes.WaterLevel, frame.Z))
	refreshPlayer(player)
	return true, "Crab cage set! Pull it up once a crab crawls in, usually within 1-3 minutes."
end

-- Keep a blocked haul's crab until it can be claimed; destroyed cages drop out.
local pendingRolls: { [Instance]: any } = setmetatable({}, { __mode = "k" }) :: any

local function collect(player: Player, prompt: ProximityPrompt, automatic: boolean?)
	local anchor = prompt.Parent
	local model = anchor and anchor.Parent
	local base = baseOf(player)
	if
		not anchor
		or not anchor:IsA("BasePart")
		or not model
		or not CollectionService:HasTag(model, CAGE_TAG)
		or model:GetAttribute("OwnerUserId") ~= player.UserId
		or not base
		or not model:IsDescendantOf(base)
	then
		return
	end
	local root = rootOf(player)
	if not automatic and (not root or (root.Position - anchor.Position).Magnitude > prompt.MaxActivationDistance + 3) then
		return
	end
	local x, z = model:GetAttribute("X"), model:GetAttribute("Z")
	local profile = BoatService.getProfile(player)
	if type(x) ~= "number" or type(z) ~= "number" or not profile then
		return
	end
	local now = os.time()
	local problem = CrabCages.collectProblem(profile.Angler, x, z, now)
	if problem then
		notify(player, problem)
		return
	end
	local backpack = BackpackCatalog.Items[profile.Angler.BackpackId] or BackpackCatalog.Items.Starter
	-- Rolled before saving so every save retry lands the same crab and timer.
	local function rng()
		return random:NextNumber()
	end
	local roll = pendingRolls[model]
	if not roll then
		roll = FishCatch.roll(CrabCages.Pool, Catalog.Fish, Catalog.Rarities, rng)
		roll.Traits = FishMutations.roll(
			Catalog.Fish[roll.FishId],
			DayNight.isNight(DayNight.clockTime()),
			rng,
			{ mutation = CrabCages.MUTATION_BONUS },
			MutationContext.at(anchor.Position, player)
		)
		roll.Value = FishMutations.value(roll.Value, roll.Traits.Mutation, roll.Traits.Corruptions)
	end
	pendingRolls[model] = roll
	local doubleXP = GamepassService.ownsDoubleXP(player)
	local noRoom = "this is a big one, clear your hands to grab this one"
	local function award(angler, layout)
		return AnglerData.recordCatch(
			angler,
			roll.FishId,
			roll.Traits.Mutation,
			roll.Kg,
			roll.Value,
			now,
			Catalog.Fish,
			Catalog.Mutations,
			roll.Size,
			roll.Traits,
			layout,
			doubleXP,
			automatic
		)
	end
	-- recordCatch checks the entire rotated shape, not just one free tile. Its
	-- copy is discarded if the catch would be released instead of stored.
	local _, previewDestination = award(profile.Angler, backpack)
	if previewDestination == "Released" then
		if not automatic then notify(player, noRoom) end
		return
	end
	local soak = CrabCages.soak(rng)
	local left, destination = 0, nil
	local blocked = false
	busy[player] = true
	local ok, message = BoatService.updateProgress(player, function(current)
		if automatic then
			assert(current.Angler.Staff.Porter and StaffCatalog.workerLevel(current.Angler, "Porter") >= 2, "Porter unavailable")
		end
		assert(not CrabCages.collectProblem(current.Angler, x, z, now), "Harvest is no longer ready")
		local layout = BackpackCatalog.Items[current.Angler.BackpackId] or BackpackCatalog.Items.Starter
		local awarded
		awarded, destination = award(current.Angler, layout)
		blocked = destination == "Released"
		assert(not blocked, noRoom)
		current.Angler = awarded
		left = CrabCages.collect(current.Angler, x, z, now, soak)
	end)
	busy[player] = nil
	if not ok then
		if not automatic then notify(player, if blocked then noRoom else message) end
		return
	end
	pendingRolls[model] = nil
	local frame = model:GetAttribute("CageFrame")
	if typeof(frame) == "CFrame" then
		splash(Vector3.new(frame.X, Biomes.WaterLevel, frame.Z))
	end
	refreshPlayer(player)
	-- The same catch card as a landed fish.
	local catch = ReplicatedStorage:FindFirstChild("Catch")
	local reveal = catch and catch:FindFirstChild("Update")
	if not automatic and reveal and reveal:IsA("RemoteEvent") then
		reveal:FireClient(player, "Caught", {
			FishId = roll.FishId,
			Kg = roll.Kg,
			Size = roll.Size,
			Value = roll.Value,
			Mutation = roll.Traits.Mutation,
			NeonColor = roll.Traits.NeonColor,
			Corruptions = roll.Traits.Corruptions,
			Saved = true,
			AutoStored = false,
			BackpackStored = destination == "Backpack",
			Stored = destination == "Hand",
		})
	end
	if left == 0 then
		notify(player, "That was the cage's last haul. Buy another at Tide & Tackle.")
	end
end

function CrabCageService.start()
	if started then
		return
	end
	started = true
	local remotes = Instance.new("Folder")
	remotes.Name = "CrabCages"
	local request = Instance.new("RemoteEvent")
	request.Name, request.Parent = "Request", remotes
	update = Instance.new("RemoteEvent")
	update.Name, update.Parent = "Update", remotes
	remotes.Parent = ReplicatedStorage
	request.OnServerEvent:Connect(function(player, action, target)
		if action ~= "Place" or busy[player] or os.clock() - (requests[player] or -math.huge) < 0.5 then
			return
		end
		requests[player] = os.clock()
		local _, message = place(player, target)
		notify(player, message)
	end)
	ProximityPromptService.PromptTriggered:Connect(function(triggered, player)
		if triggered.Name == PROMPT_NAME and not busy[player] then
			task.spawn(collect, player, triggered)
		end
	end)
	local function watchPlayer(player: Player)
		player:GetAttributeChangedSignal("AnglerRevision"):Connect(function()
			refreshPlayer(player)
		end)
		-- Respawning empties the Backpack, so hand the cages back.
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("Humanoid", 10)
			if player.Character == character then
				syncTool(player)
			end
		end)
	end
	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		requests[player], busy[player], placedCache[player] = nil, nil, nil
	end)
	local function watchBase(base: Instance)
		if base:IsA("Model") then
			base:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
				refreshBase(base)
			end)
			refreshBase(base)
		end
	end
	CollectionService:GetInstanceAddedSignal(BASE_TAG):Connect(watchBase)
	for _, base in CollectionService:GetTagged(BASE_TAG) do
		watchBase(base)
	end
	-- Harvest ready equipment while the owner has an active, upgraded porter.
	task.spawn(function()
		while true do
			task.wait(5)
			for _, player in Players:GetPlayers() do
				local profile = BoatService.getProfile(player)
				local base = baseOf(player)
				if profile and base and not busy[player] and profile.Angler.Staff.Porter
					and StaffCatalog.workerLevel(profile.Angler, "Porter") >= 2 then
					for _, model in CollectionService:GetTagged(CAGE_TAG) do
						if model:IsDescendantOf(base) then
							local x, z = model:GetAttribute("X"), model:GetAttribute("Z")
							local prompt = model:FindFirstChild(PROMPT_NAME, true)
							if prompt and type(x) == "number" and type(z) == "number"
								and not CrabCages.collectProblem(profile.Angler, x, z, os.time()) then
								local ok, failure = pcall(collect, player, prompt, true)
								if not ok then warn("[CrabCages] Porter harvest: " .. tostring(failure)) end
								break
							end
						end
					end
				end
			end
		end
	end)
	-- A level 4 porter replaces worn-out equipment using a tools rack.
	task.spawn(function()
		while true do
			task.wait(5)
			for _, player in Players:GetPlayers() do
				local profile = BoatService.getProfile(player)
				local base = baseOf(player)
				local dock = base and dockFrame(base)
				if not profile or not dock or busy[player] or not profile.Angler.Staff.Porter
					or StaffCatalog.workerLevel(profile.Angler, "Porter") < 4
					or #profile.Angler.CrabCages.Placed >= CrabCages.MAX_PLACED then continue end
				local rackIndex
				for index, rack in profile.Angler.Furniture do
					if rack.ItemId == "StorageRack" and rack.Mode == "Tools" and (rack.Cages or 0) > 0 then rackIndex = index break end
				end
				if not rackIndex then continue end
				local candidate = table.clone(profile.Angler)
				candidate.CrabCages = table.clone(profile.Angler.CrabCages)
				candidate.CrabCages.Stock += 1
				local ignore = {}
				for _, other in Players:GetPlayers() do if other.Character then table.insert(ignore, other.Character) end end
				local chosenX, chosenZ
				for z = -38, 2, 5 do
					for x = -22, 23, 5 do
						if not CrabCages.placeProblem(candidate, x, z) then
							local frame = cageFrame(dock, x, z)
							local clear = true
							for _, point in CrabCages.footprint(Props.CRAB_CAGE_SIZE) do
								if not openWater(frame * point, ignore) then clear = false break end
							end
							if clear then chosenX, chosenZ = x, z break end
						end
					end
					if chosenX then break end
				end
				if chosenX then
					local now = os.time()
					local soak = CrabCages.soak(function() return random:NextNumber() end)
					busy[player] = true
					local ok = BoatService.updateProgress(player, function(current)
						local rack = current.Angler.Furniture[rackIndex]
						assert(current.Angler.Staff.Porter and StaffCatalog.workerLevel(current.Angler, "Porter") >= 4, "Porter unavailable")
						assert(rack and rack.ItemId == "StorageRack" and rack.Mode == "Tools" and (rack.Cages or 0) > 0, "Rack unavailable")
						rack.Cages -= 1
						current.Angler.CrabCages.Stock += 1
						CrabCages.place(current.Angler, chosenX, chosenZ, now, soak)
					end)
					busy[player] = nil
					if ok then refreshPlayer(player) end
				end
			end
		end
	end)
	-- Countdowns tick once a second.
	task.spawn(function()
		while true do
			task.wait(1)
			for _, base in CollectionService:GetTagged(BASE_TAG) do
				if base:IsA("Model") and ownerOf(base) then
					local ok, failure = pcall(refreshBase, base)
					if not ok then
						warn("[CrabCages] " .. tostring(failure))
					end
				end
			end
		end
	end)
end

return CrabCageService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="146">
        <Properties>
          <string name="Name">CustomerService</string>
          <string name="Source"><![CDATA[-- Shop customers. Owners carry fish individually to their base freezers; a customer
-- wearing a random Roblox avatar takes displayed fish or dishes to a register
-- and waits until served. Each register serves one customer at a time. A sale
-- commits the whole basket in one profile update.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AnglerData = require(script.Parent.AnglerData)
local BoatService = require(script.Parent.BoatService)
local CargoService = require(script.Parent.CargoService)
local FurnitureService = require(script.Parent.FurnitureService)
local NpcCollision = require(script.Parent.NpcCollision)
local NpcNavigation = require(script.Parent.NpcNavigation)
local FishFreezer = require(script.Parent.Map.FishFreezer)
local ShopDesk = require(script.Parent.Map.ShopDesk)
local StorageRack = require(script.Parent.Map.StorageRack)
local Kitchen = require(script.Parent.Map.Kitchen)
local Catalog = require(ReplicatedStorage.Shared.AnglerCatalog)
local BaseGrid = require(ReplicatedStorage.Shared.BaseGrid)
local Paths = require(ReplicatedStorage.Shared.Paths)
local Recipes = require(ReplicatedStorage.Shared.Recipes)
local Furniture = require(ReplicatedStorage.Shared.FurnitureCatalog)
local FishCatch = require(ReplicatedStorage.Shared.FishCatch)
local FishModels = require(ReplicatedStorage.Shared.FishModels)
local StaffCatalog = require(ReplicatedStorage.Shared.StaffCatalog)
local ShopUpgrades = require(ReplicatedStorage.Shared.ShopUpgrades)
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))

local CustomerService = {}
local BASE_TAG = "PlayerBase"
local OWNER_PROMPT_TAG = "ShopOwnerPrompt"
local WALK_SPEED = 9
local STAFF_WALK_SPEED = 16
local WAIT_SECONDS = 150
local ARRIVAL_SECONDS = 25
local SERVE_DISTANCE = 14
local MAX_USER_ID = 3_000_000_000
-- Default R15 animations; NPCs have no Animate script of their own.
local IDLE_ANIMATION = "rbxassetid://507766666"
local WALK_ANIMATION = "rbxassetid://507777826"

local random = Random.new()
local started = false
local update: RemoteEvent
local folder: Folder
local shops: { [Model]: any } = {}
local customers: { [ProximityPrompt]: any } = {}
local stocking: { [Player]: boolean } = {}
local PORTER_DOCK_DISTANCE = 32
-- A porter still walking to the boat or the freezer after this long is moved there.
local PORTER_TELEPORT_SECONDS = 30

local function notify(player: Player?, message: string)
	if player and player.Parent == Players then
		update:FireClient(player, "Notice", message)
	end
end

local function ownerOf(base: Model): Player?
	local userId = base:GetAttribute("OwnerUserId")
	return if type(userId) == "number" and userId ~= 0 then Players:GetPlayerByUserId(userId) else nil
end

local function houseFrame(base: Model): CFrame?
	local house = base:FindFirstChild("BaseHouse")
	local frame = house and house:GetAttribute("HouseFrame")
	return if typeof(frame) == "CFrame" then frame else nil
end

local function near(player: Player, position: Vector3, distance: number): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return humanoid ~= nil
		and humanoid.Health > 0
		and root ~= nil
		and root:IsA("BasePart")
		and (root.Position - position).Magnitude <= distance
end

local function ownerPrompt(parent: Instance, name: string, action: string, object: string): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = 0.25
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
	CollectionService:AddTag(prompt, OWNER_PROMPT_TAG)
	prompt.Parent = parent
	return prompt
end

-- Fish still on the ice; a customer's fish stays in the save until it is sold.
local function frozenCount(shop, owner: Player?): number
	local profile = owner and BoatService.getProfile(owner)
	local count = if profile then #profile.Angler.Freezer else 0
	for _, customer in shop.customers do
		for _, item in customer.items do
			if item.taken and not item.food then
				count -= 1
			end
		end
	end
	return math.max(0, count)
end

local function describeFish(record): string
	local recipe = record.RecipeId and Recipes.Items[record.RecipeId]
	if recipe then
		return recipe.Name
	end
	local fish = Catalog.Fish[record.FishId]
	return string.format("%s · %s", if fish then fish.Name else record.FishId, FishCatch.formatKg(record.Kg))
end

-- Customers get a random real avatar; deleted accounts just mean another roll.
local function randomAvatar(): HumanoidDescription
	for _ = 1, 6 do
		local ok, description = pcall(function()
			return Players:GetHumanoidDescriptionFromUserId(random:NextInteger(1, MAX_USER_ID))
		end)
		if ok and description then
			return description
		end
	end
	return Instance.new("HumanoidDescription")
end

local function animate(humanoid: Humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator")
	animator.Parent = humanoid
	local function load(id: string, priority: Enum.AnimationPriority): AnimationTrack
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local track = animator:LoadAnimation(animation)
		track.Priority, track.Looped = priority, true
		return track
	end
	local idle = load(IDLE_ANIMATION, Enum.AnimationPriority.Idle)
	local walk = load(WALK_ANIMATION, Enum.AnimationPriority.Movement)
	idle:Play()
	humanoid.Running:Connect(function(speed)
		if speed > 0.5 and not walk.IsPlaying then
			walk:Play(0.15)
		elseif speed <= 0.5 and walk.IsPlaying then
			walk:Stop(0.2)
		end
	end)
end

local function bubble(customer, text: string)
	local label = customer.label
	if not label then
		local head = customer.model:FindFirstChild("Head")
		if not head then
			return
		end
		local billboard = Instance.new("BillboardGui")
		billboard.Name, billboard.Size = "CustomerBubble", UDim2.fromOffset(240, 34)
		billboard.StudsOffset, billboard.MaxDistance = Vector3.new(0, 2.6, 0), 60
		label = Instance.new("TextLabel")
		label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
		label.Font, label.TextSize = Enum.Font.GothamBold, 15
		Theme.text(label)
		label.Parent, billboard.Parent = billboard, head
		customer.label = label
	end
	label.Text = text
end

local function spawnCustomer(position: Vector3, staffRole: string?): Model
	local description = if staffRole then StaffCatalog.description(staffRole) else randomAvatar()
	local ok, model =
		pcall(Players.CreateHumanoidModelFromDescriptionAsync, Players, description, Enum.HumanoidRigType.R15)
	description:Destroy()
	if not ok then
		error(model)
	end
	if staffRole then
		StaffCatalog.finishModel(model)
	end
	model.Name = "Customer"
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.WalkSpeed = if staffRole then STAFF_WALK_SPEED else WALK_SPEED
	humanoid.BreakJointsOnDeath = false
	-- NPCs pass through one another so two can share a doorway.
	NpcCollision.bind(model)
	model:PivotTo(CFrame.new(position + Vector3.new(0, model:GetExtentsSize().Y / 2, 0)))
	model.Parent = folder
	-- Server-owned so a nearby player's client never takes over the walk.
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	pcall(root.SetNetworkOwner, root, nil)
	animate(humanoid)
	return model
end

-- Returns the fish at its catch's world size, plus its scaled size
-- in fish axes (snout +X, back +Y). Welded fish can be carried; others stay anchored.
local function fishModel(record, welded: boolean): (Model?, Vector3)
	local model = FishModels.create(record.FishId, record)
	if not model then
		return nil, Vector3.zero
	end
	local anchor: BasePart? = nil
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Massless = true
			if not anchor then
				anchor = part
			elseif welded then
				local weld = Instance.new("WeldConstraint")
				weld.Part0, weld.Part1, weld.Parent = anchor, part, part
			end
		end
	end
	if not anchor then
		model:Destroy()
		return nil, Vector3.zero
	end
	-- Pivot at the middle of the fish, keeping its axes.
	local center = model:GetAttribute("BoundsCenter") :: Vector3
	anchor.PivotOffset = anchor.CFrame:ToObjectSpace(CFrame.new(center))
	model.PrimaryPart = anchor
	local size = FishModels.scaleCatch(model, record.Kg)
	return model, size
end

-- How far the model reaches below `origin` along `axis` (negative when below).
local function lowestAlong(model: Model, origin: Vector3, axis: Vector3): number
	local lowest = math.huge
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			local frame, half = part.CFrame, part.Size / 2
			local reach = math.abs(frame.RightVector:Dot(axis)) * half.X
				+ math.abs(frame.UpVector:Dot(axis)) * half.Y
				+ math.abs(frame.LookVector:Dot(axis)) * half.Z
			lowest = math.min(lowest, (frame.Position - origin):Dot(axis) - reach)
		end
	end
	return lowest
end

-- Places the fish lying on the surface whose UpVector is the normal.
local function restOn(fish: Model, surface: CFrame, turn: CFrame)
	fish:PivotTo(surface * turn)
	local normal = surface.UpVector
	fish:PivotTo(fish:GetPivot() + normal * (0.01 - lowestAlong(fish, surface.Position, normal)))
end

-- The shop's built-in fixture first, then every placed one of `itemId`, as world frames.
local function fixtureFrames(shop, profile, itemId: string, builtIn: CFrame?): { CFrame }
	local frames = if builtIn then { builtIn } else {}
	for _, entry in if profile then profile.Angler.Furniture else {} do
		if entry.ItemId == itemId and (itemId ~= "StorageRack" or entry.Mode ~= "Tools") then
			table.insert(frames, Furniture.frame(shop.frame, entry))
		end
	end
	return frames
end

local function freezerFrames(shop, profile): { CFrame }
	return fixtureFrames(shop, profile, "Freezer", FishFreezer.frame(shop.frame))
end

local function recordKey(record): string
	return string.format(
		"%s:%s:%s:%s:%s:%s",
		record.FishId,
		record.Mutation,
		record.Size or "",
		record.Kg,
		record.CaughtAt,
		record.Value
	) .. ":" .. table.concat(record.Corruptions or {}, ",")
end

-- The owner's frozen fish use the authoritative size-based cooler layout. The
-- fish customers have taken are left out until they are sold or put back.
local function refreshDisplay(shop)
	local owner = ownerOf(shop.base)
	local profile = owner and BoatService.getProfile(owner)
	local frozen = if profile then profile.Angler.Freezer else {}
	local frames = freezerFrames(shop, profile)
	local takenKeys, taken = {}, {}
	for _, customer in shop.customers do
		for _, item in customer.items do
			if item.taken and not item.food then
				local key = recordKey(item.record)
				table.insert(takenKeys, key)
				taken[key] = (taken[key] or 0) + 1
			end
		end
	end
	table.sort(takenKeys)
	local keys = { tostring(owner and owner.UserId), table.concat(takenKeys, ","), tostring(#frames) }
	for _, frame in frames do
		table.insert(keys, tostring(frame))
	end
	for index = 1, #frozen do
		table.insert(keys, recordKey(frozen[index]))
	end
	local signature = table.concat(keys, "|")
	if signature == shop.displaySignature then
		return
	end
	shop.displaySignature = signature
	if shop.display then
		shop.display:Destroy()
	end
	local display = Instance.new("Model")
	display.Name = "FrozenFishDisplay"
	shop.display = display
	shop.displayFish = {}
	local placements = if profile then AnglerData.freezerLayout(profile.Angler) else {}
	shop.shown = 0
	for index, record in frozen do
		local placement = placements[index]
		local key = recordKey(record)
		-- Taken fish keep their reserved space until the sale completes.
		if (taken[key] or 0) > 0 then
			taken[key] -= 1
			continue
		end
		if not placement then
			continue
		end
		local frame = frames[placement.Freezer]
		local fish = fishModel(record, true)
		if not fish then
			continue
		end
		local turn = CFrame.Angles(0, if placement.Rotated then 0 else math.pi / 2, 0)
			* (if placement.Flat then CFrame.identity else CFrame.Angles(math.pi / 2, 0, 0))
		restOn(fish, FishFreezer.iceSurface(frame, placement.X, placement.Z), turn)
		fish.Parent = display
		shop.shown += 1
		table.insert(shop.displayFish, { record = record, model = fish, freezer = frame })
	end
	display.Parent = shop.freezerPrompt.Parent.Parent
end

local function setAnchored(model: Model, anchored: boolean)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = anchored
		end
	end
end

local function carry(customer, fish: Model, stackIndex: number?, heldItem)
	local hand = customer.model:FindFirstChild("RightHand") :: BasePart?
	if not hand then
		return
	end
	setAnchored(fish, false)
	-- Held by the middle just in front of the hand, snout forward.
	fish:PivotTo(hand.CFrame * CFrame.new(0, -0.3 + (stackIndex or 0) * 0.45, -0.5) * CFrame.Angles(0, math.pi / 2, 0))
	fish.Parent = customer.model
	local grip = Instance.new("WeldConstraint")
	grip.Name, grip.Part0, grip.Part1, grip.Parent = "FishGrip", hand, fish.PrimaryPart, hand
	local gripOwner = heldItem or customer
	gripOwner.grip = grip
end

local function takeFromFreezer(shop, customer, heldItem, stackIndex): Model?
	if not customer.model:FindFirstChild("RightHand") then
		return nil
	end
	for _, item in shop.displayFish or {} do
		if recordKey(item.record) == recordKey(heldItem.record) and item.model.Parent == shop.display then
			-- Move the actual displayed fish before rebuilding its former container.
			local fish = item.model
			carry(customer, fish, stackIndex, heldItem)
			heldItem.fish, heldItem.taken = fish, true
			refreshDisplay(shop)
			return fish
		end
	end
	return nil
end

local function putOnCounter(item, fish: Model, frame: CFrame, turn: CFrame?)
	if item.grip then
		item.grip:Destroy()
		item.grip = nil
	end
	-- Lying on its side along the counter edge, resting on the desk top. Dishes stay flat.
	setAnchored(fish, true)
	restOn(fish, frame, turn or CFrame.Angles(math.pi / 2, 0, 0))
	fish.Parent = folder
end

-- Cooked dishes (Supermarket path) sit in the placed food display cases, oldest
-- first, six to a case. Like frozen fish, a dish stays saved until it is paid for.
local function dishKey(dish): string
	return string.format(
		"%s:%s:%s:%s:%s",
		dish.RecipeId,
		dish.FishId,
		tostring(dish.Kg),
		tostring(dish.MadeAt),
		tostring(dish.Value)
	)
end

-- A carriable dish: every part welded to one anchor whose pivot is the plate's base.
local function dishModel(dish, frame: CFrame): Model?
	local recipe = Recipes.Items[dish.RecipeId]
	if not recipe then
		return nil
	end
	local model = Kitchen.buildDish(dish.RecipeId, recipe.Look, frame)
	local anchor: BasePart? = nil
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Massless = true
			if not anchor then
				anchor = part
			else
				local weld = Instance.new("WeldConstraint")
				weld.Part0, weld.Part1, weld.Parent = anchor, part, part
			end
		end
	end
	if not anchor then
		model:Destroy()
		return nil
	end
	anchor.PivotOffset = anchor.CFrame:ToObjectSpace(frame)
	model.PrimaryPart = anchor
	return model
end

local function refreshFoodDisplay(shop)
	local owner = ownerOf(shop.base)
	local profile = owner and BoatService.getProfile(owner)
	local dishes = if profile then profile.Angler.Pantry else {}
	local frames = fixtureFrames(shop, profile, "FoodCase")
	local taken = {}
	local keys = { tostring(owner and owner.UserId) }
	for _, customer in shop.customers do
		for _, item in customer.items do
			if item.taken and item.food then
				local key = dishKey(item.record)
				taken[key] = (taken[key] or 0) + 1
				table.insert(keys, "taken " .. key)
			end
		end
	end
	for _, frame in frames do
		table.insert(keys, tostring(frame.Position))
	end
	local shown = math.min(#dishes, #frames * #Kitchen.CASE_SPOTS)
	for index = 1, shown do
		table.insert(keys, dishKey(dishes[index]))
	end
	local signature = table.concat(keys, "|")
	if signature == shop.foodSignature then
		return
	end
	shop.foodSignature = signature
	if shop.foodDisplay then
		shop.foodDisplay:Destroy()
	end
	local display = Instance.new("Model")
	display.Name = "FoodDisplay"
	shop.foodDisplay, shop.displayFood = display, {}
	for index = 1, shown do
		local dish = dishes[index]
		local key = dishKey(dish)
		if (taken[key] or 0) > 0 then
			taken[key] -= 1
			continue
		end
		local case = frames[(index - 1) // #Kitchen.CASE_SPOTS + 1]
		local model = dishModel(dish, case * Kitchen.CASE_SPOTS[(index - 1) % #Kitchen.CASE_SPOTS + 1])
		if model then
			model.Parent = display
			table.insert(shop.displayFood, { record = dish, model = model, freezer = case, food = true })
		end
	end
	display.Parent = shop.freezerPrompt.Parent.Parent
end

local function takeFood(shop, customer, heldItem, stackIndex): Model?
	if not customer.model:FindFirstChild("RightHand") then
		return nil
	end
	for _, item in shop.displayFood or {} do
		if dishKey(item.record) == dishKey(heldItem.record) and item.model.Parent == shop.foodDisplay then
			local dish = item.model
			carry(customer, dish, stackIndex, heldItem)
			heldItem.fish, heldItem.taken = dish, true
			refreshFoodDisplay(shop)
			return dish
		end
	end
	return nil
end

local function refreshShelves(shop)
	refreshDisplay(shop)
	refreshFoodDisplay(shop)
end

-- Route over the base's house-local grid so NPCs find the doorways instead of
-- walking a straight line into a wall.
local function walk(customer, target: Vector3, allowed: (() -> boolean)?, stayOnGround: boolean?, straight: boolean?): boolean
	if customer.gridFrame == nil then
		local owner = customer.shop or customer.restaurant
		customer.gridFrame = owner and owner.frame
	end
	return NpcNavigation.walk(customer, target, allowed, stayOnGround, straight)
end

-- House-local doorway approach points. The house's front door faces the road at
-- z=15.75 and the shop's entrance faces back across it at BaseGrid.SHOP_FRONT;
-- both doors are on the centerline.
local HOUSE_DOOR_Z = 18.6
local SHOP_DOOR_Z = BaseGrid.SHOP_FRONT - 2.85
local SHOP_AISLE_Z = BaseGrid.SHOP_FRONT + 4.75

-- 1 = the house with its yard and dock, 2 = the road, 3 = inside the shop.
local function roadSide(shop, position: Vector3): number
	local z = shop.frame:PointToObjectSpace(position).Z
	return if z <= 16.1 then 1 elseif z >= BaseGrid.SHOP_FRONT - 0.4 then 3 else 2
end

-- Door-to-door legs between the house and the shop across the road. The grid
-- would find the doors on its own, but fixed legs keep each search short and
-- stop NPCs cutting along a front wall toward the wrong doorway.
local function doorLegs(shop, from: Vector3, to: Vector3): { Vector3 }
	local function at(z: number): Vector3
		return (shop.frame * CFrame.new(0, 0.16, z)).Position
	end
	local a, b = roadSide(shop, from), roadSide(shop, to)
	local legs = {}
	if a == 1 and b > 1 then
		table.insert(legs, at(HOUSE_DOOR_Z))
	end
	if a < 3 and b == 3 then
		table.insert(legs, at(SHOP_DOOR_Z))
		table.insert(legs, at(SHOP_AISLE_Z))
	elseif a == 3 and b < 3 then
		table.insert(legs, at(SHOP_DOOR_Z))
	end
	if a > 1 and b == 1 then
		table.insert(legs, at(HOUSE_DOOR_Z))
	end
	return legs
end

-- Where an NPC stands to use a fixture `depth` deep: its body clears the front.
local function accessSpot(npc, frame: CFrame, depth: number): Vector3
	return (frame * CFrame.new(0, 0, depth / 2 + NpcNavigation.clearance(npc) + 0.4)).Position
end

local function face(customer, position: Vector3)
	local root = customer.root
	local look = Vector3.new(position.X, root.Position.Y, position.Z)
	if (look - root.Position).Magnitude > 0.1 then
		root.CFrame = CFrame.lookAt(root.Position, look)
	end
end

local function leave(customer)
	if customer.leaving then
		return
	end
	customer.leaving = true
	if customer.prompt then
		customers[customer.prompt] = nil
		customer.prompt:Destroy()
		customer.prompt = nil
	end
end

local function finish(shop, customer)
	customer.active = false
	if customer.prompt then
		customers[customer.prompt] = nil
	end
	for _, item in customer.items do
		if item.counterFish then
			item.counterFish:Destroy()
		end
	end
	if customer.model then
		customer.model:Destroy()
	end
	local index = table.find(shop.customers, customer)
	if index then
		table.remove(shop.customers, index)
		refreshShelves(shop)
	end
end

local function waitingForRegister(shop, customer): boolean
	for _, other in shop.customers do
		if other == customer then
			break
		end
		if other.registerKey == customer.registerKey and other.active and not other.leaving then
			return true
		end
	end
	return false
end

local function visit(shop, customer)
	local base, frame = shop.base, shop.frame
	local function at(x: number, z: number): Vector3
		return (frame * CFrame.new(x, 0.16, z)).Position
	end
	local deskFrame = customer.register
	local counterTop = deskFrame * CFrame.new(0.2 * ShopDesk.WIDTH, ShopDesk.HEIGHT, -ShopDesk.DEPTH / 4)

	-- Arrive from the road outside the shop's entrance when there is ground there.
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances = { folder }
	parameters.RespectCanCollide = true
	parameters.IgnoreWater = true
	local street = at(0, BaseGrid.SHOP_FRONT - 7)
	local hit = workspace:Raycast(street + Vector3.new(0, 10, 0), Vector3.new(0, -20, 0), parameters)
	local entry = if hit then hit.Position else at(0, SHOP_DOOR_Z)

	customer.model = spawnCustomer(entry)
	customer.humanoid = customer.model:FindFirstChildOfClass("Humanoid")
	customer.root = customer.model:FindFirstChild("HumanoidRootPart")
	local clearance = NpcNavigation.clearance(customer) + 0.4
	local counterSpot = (deskFrame * CFrame.new(0.15 * ShopDesk.WIDTH, 0, -ShopDesk.DEPTH / 2 - clearance)).Position
	local name = if #customer.items == 1 then describeFish(customer.items[1].record) else tostring(#customer.items) .. " items"
	bubble(customer, "Looking for something to buy…")
	customer.humanoid.Died:Once(function()
		customer.active = false
	end)

	-- Each step stops early if the owner leaves or the customer is dismissed.
	local function shopping(): boolean
		local function going(target: Vector3): boolean
			local function allowed(): boolean
				return not customer.leaving
			end
			for _, position in doorLegs(shop, customer.root.Position, target) do
				if not walk(customer, position, allowed) then
					return false
				end
			end
			return walk(customer, target, allowed)
		end
		for index, item in customer.items do
			local freezerFrame = item.freezer
			local shelfDepth = if item.food then Kitchen.CASE_DEPTH else FishFreezer.DEPTH
			local freezerSpot = (freezerFrame * CFrame.new(0, 0, shelfDepth / 2 + clearance)).Position
			if not going(freezerSpot) then return false end
			face(customer, freezerFrame.Position)
			task.wait(1.2)
			if not customer.active or customer.leaving then return false end
			local fish = if item.food then takeFood(shop, customer, item, index - 1) else takeFromFreezer(shop, customer, item, index - 1)
			if not fish then return false end
		end
		bubble(customer, "I'll take " .. name)
		if not going(at(0, SHOP_AISLE_Z)) then
			return false
		end
		-- Customers sharing a register wait their turn before approaching its counter.
		local queueDeadline = os.clock() + WAIT_SECONDS
		while customer.active and not customer.leaving do
			if not waitingForRegister(shop, customer) then
				break
			elseif os.clock() >= queueDeadline then
				return false
			end
			task.wait(0.25)
		end
		if not customer.active or customer.leaving or not going(counterSpot) then
			return false
		end
		face(customer, deskFrame.Position)
		task.wait(0.5)
		if not customer.active or customer.leaving then
			return false
		end
		local price = 0
		for index, item in customer.items do
			putOnCounter(item, item.fish, counterTop * CFrame.new((index - 1) * 1.5, 0, 0), if item.food then CFrame.identity else nil)
			item.counterFish, item.fish = item.fish, nil
			price += math.max(1, math.floor(item.record.Value))
		end
		bubble(customer, string.format("%s — $%d", name, price))
		local prompt = ownerPrompt(customer.root, "SellToCustomerPrompt", "Sell for $" .. price, name)
		prompt:SetAttribute("OwnerUserId", base:GetAttribute("OwnerUserId"))
		customer.prompt = prompt
		customers[prompt] = customer
		notify(ownerOf(base), "A customer is waiting at your register for " .. name .. ".")
		local deadline = os.clock() + WAIT_SECONDS
		while customer.active and not customer.leaving and os.clock() < deadline do
			task.wait(0.25)
		end
		return true
	end

	shopping()
	if not customer.active then
		return
	end
	leave(customer)
	if customer.sold then
		for index, item in customer.items do
			if item.counterFish then
				carry(customer, item.counterFish, index - 1, item)
				item.counterFish = nil
			end
		end
		bubble(customer, "Thank you!")
	else
		for _, item in customer.items do
			for _, key in { "fish", "counterFish" } do
				if item[key] then
					item[key]:Destroy()
					item[key] = nil
				end
			end
			item.taken = false
		end
		refreshShelves(shop)
		bubble(customer, "Never mind…")
	end
	task.wait(0.8)
	for _, target in doorLegs(shop, customer.root.Position, entry) do
		if not walk(customer, target) then
			return
		end
	end
	walk(customer, entry)
end

local function sell(player: Player, customer, worker)
	local shop = customer.shop
	local function authorized(profile): boolean
		if ownerOf(shop.base) ~= player or not customer.active or customer.leaving then
			return false
		end
		if worker then
			local desk = ShopDesk.frame(shop.frame)
			return shop.staff.Seller == worker
				and worker.active
				and worker.humanoid.Health > 0
				and profile.Angler.Staff.Seller == true
				and worker.model.Parent ~= nil
				and (worker.root.Position - desk.Position).Magnitude <= SERVE_DISTANCE
		end
		return near(player, customer.root.Position, SERVE_DISTANCE)
	end
	local profile = BoatService.getProfile(player)
	if customer.leaving or customer.selling or not profile or not authorized(profile) then
		return
	end
	customer.selling = true
	local price = 0
	-- Commit all items together or leave every item in stock.
	local function pay(angler)
		local total = 0
		for _, item in customer.items do
			local data, paid
			if item.food then
				data, paid = AnglerData.sellDish(angler, item.record, 1, "FoodSold")
			else
				data, paid = AnglerData.sellFrozen(angler, item.record)
			end
			if not data then return nil, 0 end
			angler, total = data, total + paid
		end
		return angler, total
	end
	local gone = "An item is no longer available."
	local ok, message = BoatService.updateProgress(player, function(profile)
		assert(authorized(profile), "This customer can no longer be served.")
		local data, paid = pay(profile.Angler)
		assert(data, gone)
		profile.Angler = data
		profile.Cash += paid
		price = paid
	end)
	customer.selling = false
	if ok then
		customer.sold = true
		for _, item in customer.items do item.taken = false end
		refreshShelves(shop)
		leave(customer)
		notify(player, string.format("Sold %d item(s) for $%d.", #customer.items, price))
		return
	end
	local profile = BoatService.getProfile(player)
	if profile and not pay(profile.Angler) then
		-- The fish is gone (sold elsewhere or a stale session); the customer gives up.
		leave(customer)
		notify(player, gone)
	else
		notify(player, message)
	end
end

local function removeStaff(shop)
	for _, worker in shop.staff do
		worker.active = false
		worker.model:Destroy()
	end
	shop.staff = {}
end

-- The Company path's fisherman moors his boat beside the dock; CompanyService
-- sets this to report it (boat id and model) once it is tied up.
local companyDock: ((any, Player) -> (string?, Model?))? = nil

-- Only the owner's launched, stationary boat at this base can be unloaded.
local function dockedBoat(shop, owner: Player): (string?, Model?)
	local id, model = BoatService.activeBoat(owner)
	local marker = shop.base:FindFirstChild("BoatSpawn")
	local root = model and model.PrimaryPart
	if
		ownerOf(shop.base) ~= owner
		or not marker
		or not marker:IsA("BasePart")
		or not root
		or model:GetAttribute("OwnerUserId") ~= owner.UserId
	then
		return nil, nil
	end
	local delta = root.Position - marker.Position
	if
		Vector3.new(delta.X, 0, delta.Z).Magnitude > PORTER_DOCK_DISTANCE
		or math.abs(delta.Y) > 12
		or root.AssemblyLinearVelocity.Magnitude > 2
	then
		return nil, nil
	end
	return id, model
end

local function rackFrames(shop, profile): { CFrame }
	return fixtureFrames(shop, profile, "StorageRack")
end

local function flatDistance(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- The dock's walkway as one chain, in BoatDockFrame: the left landing, down
-- the left gangway and pier, across the pickup point at the pier head and back
-- up the right side. Points sit on the centerlines of the 7-wide decks and
-- ramps, so each hop between neighbours is a known-safe straight corridor
-- and the porter never takes a navmesh detour along the water's edge.
local PIER_CHAIN = {
	Vector3.new(-17, 5.9, 13),
	Vector3.new(-17, 4.55, 4),
	Vector3.new(-17, 3.3, -2),
	Vector3.new(-17, 3.3, -24),
	Vector3.new(-17, 3.3, -38),
	Vector3.new(0, 3.3, -38),
	Vector3.new(17, 3.3, -38),
	Vector3.new(17, 3.3, -24),
	Vector3.new(17, 3.3, -2),
	Vector3.new(17, 4.55, 4),
	Vector3.new(17, 5.9, 13),
}
local PIER_PICKUP, PIER_LEFT_MID, PIER_RIGHT_MID = 6, 4, 8

-- World chain points and the pickup index. A moored company boat's
-- PorterPier replaces the mid-pier point on its side.
local function pierChain(dock: CFrame, moorPier: Vector3?): ({ Vector3 }, number)
	local chain, goal = {}, PIER_PICKUP
	for index, point in PIER_CHAIN do
		chain[index] = (dock * CFrame.new(point.X, point.Y, point.Z)).Position
	end
	if moorPier then
		goal = if dock:PointToObjectSpace(moorPier).X < 0 then PIER_LEFT_MID else PIER_RIGHT_MID
		chain[goal] = moorPier
	end
	return chain, goal
end

-- The nearest chain point while the porter is out on the dock, else nil.
local function pierNode(dock: CFrame, chain: { Vector3 }, position: Vector3): number?
	local localPosition = dock:PointToObjectSpace(position)
	if math.abs(localPosition.X) > 25 or localPosition.Z < -48 or localPosition.Z > 8 then
		return nil
	end
	local best, bestDistance = nil, math.huge
	for index, point in chain do
		local distance = flatDistance(point, position)
		if distance < bestDistance then
			best, bestDistance = index, distance
		end
	end
	return best
end

local function walkChain(chain: { Vector3 }, from: number, to: number, go): boolean
	local step = if to >= from then 1 else -1
	for index = from + step, to, step do
		if not go(chain[index], true) then
			return false
		end
	end
	return true
end

-- Off the dock: through the house/shop doors, then a grid walk to `target`.
local function goVia(shop, worker, target: Vector3, go): boolean
	for _, position in doorLegs(shop, worker.root.Position, target) do
		if not go(position) then
			return false
		end
	end
	return go(target)
end

-- From wherever the porter stands to chain point `goal`. Each retry starts
-- again from the porter's actual position.
local function toPier(shop, worker, dock: CFrame, chain: { Vector3 }, goal: number, go): boolean
	local node = pierNode(dock, chain, worker.root.Position)
	if node then
		return go(chain[node]) and walkChain(chain, node, goal, go)
	end
	local landing = if goal < PIER_PICKUP then 1 else #chain
	return goVia(shop, worker, chain[landing], go) and walkChain(chain, landing, goal, go)
end

-- Up the nearer gangway if the porter is on the dock, then on to `target`.
local function fromPier(shop, worker, dock: CFrame, chain: { Vector3 }, target: Vector3, go): boolean
	local node = pierNode(dock, chain, worker.root.Position)
	if node then
		local landing = if node < PIER_PICKUP then 1 else #chain
		if not (go(chain[node]) and walkChain(chain, node, landing, go)) then
			return false
		end
	end
	return goVia(shop, worker, target, go)
end

-- A rig below the deck cannot use the dock's walking-only route back up.
local function belowDock(shop, worker): boolean
	local dock = shop.base:GetAttribute("BoatDockFrame")
	if typeof(dock) ~= "CFrame" then
		return false
	end
	local position = dock:PointToObjectSpace(worker.root.Position)
	local feet = position.Y - worker.humanoid.HipHeight - worker.root.Size.Y / 2
	return math.abs(position.X) <= 25 and position.Z >= -48 and position.Z <= 8 and feet < 2.2
end

-- Sets a porter down on a spot it could not walk to, facing the way it was going.
local function teleport(worker, position: Vector3)
	local root, humanoid = worker.root, worker.humanoid
	local center = position + Vector3.new(0, humanoid.HipHeight + root.Size.Y / 2 + 0.5, 0)
	local heading = (position - root.Position) * Vector3.new(1, 0, 1)
	root.AssemblyLinearVelocity = Vector3.zero
	root.CFrame = if heading.Magnitude > 0.1 then CFrame.lookAt(center, center + heading) else CFrame.new(center)
	-- Replace the stale walk goal so the rig does not head back to where it was stuck.
	humanoid:MoveTo(center)
end

-- Times a porter's legs (to the cargo, then on to its shelf); `moving` guards
-- every walk on the current leg. `leg` retries `step`, which walks on from
-- wherever the porter stands, until it arrives. A porter still not there after
-- PORTER_TELEPORT_SECONDS, or `stranded` where it cannot walk back from, is
-- set down at `destination` instead.
local function porterLegs(worker, valid: () -> boolean, stranded: (() -> boolean)?)
	local deadline = 0
	local function moving(): boolean
		return valid() and os.clock() < deadline
	end
	local function leg(destination: Vector3, step: () -> boolean): boolean
		deadline = os.clock() + PORTER_TELEPORT_SECONDS
		local attempt = 0
		while not step() do
			if not valid() then
				return false
			elseif not moving() or (stranded ~= nil and stranded()) then
				teleport(worker, destination)
				return valid()
			end
			attempt += 1
			task.wait(math.min(0.5 * attempt, 2))
		end
		return true
	end
	return moving, leg
end

-- Each fish has a visual copy; saved inventory changes only after delivery.
local function carryLoad(worker, load): boolean
	worker.load = {}
	for index, entry in load do
		local fish = fishModel(entry.Record, true)
		if not fish then
			return false
		end
		local carried = { fish = fish }
		table.insert(worker.load, carried)
		carry(worker, fish, index - 1)
		carried.grip = worker.grip
		worker.grip = nil
	end
	return true
end

-- Boat to the freezer, a storage rack or the kitchen storage table.
local function unloadTrip(shop, worker, owner: Player, boatId: string, boat: Model, load, rack: CFrame?, isKitchenStorage: boolean?)
	local dock = shop.base:GetAttribute("BoatDockFrame")
	if typeof(dock) ~= "CFrame" then
		return
	end
	local function valid(): boolean
		local currentId, currentBoat = dockedBoat(shop, owner)
		if currentBoat ~= boat and companyDock then
			currentId, currentBoat = companyDock(shop, owner)
		end
		return ownerOf(shop.base) == owner
			and worker.active
			and shop.staff.Porter == worker
			and worker.humanoid.Health > 0
			and currentId == boatId
			and currentBoat == boat
	end
	-- A pushed/fallen porter cannot climb back through the pier from below.
	local moving, leg = porterLegs(worker, valid, function()
		return belowDock(shop, worker)
	end)
	local function go(position: Vector3, straight: boolean?): boolean
		return moving() and walk(worker, position, moving, true, straight) and valid()
	end
	-- Collect at the pier's center, never the boat-side edge. Company hulls
	-- have no collision, so stepping toward them leaves no ground underfoot.
	local moorPier = boat:GetAttribute("PorterPier")
	local chain, goal = pierChain(dock, if typeof(moorPier) == "Vector3" then moorPier else nil)
	local shelfSpot = if rack
		then accessSpot(worker, rack, if isKitchenStorage then Kitchen.DEPTH else StorageRack.DEPTH)
		else accessSpot(worker, FishFreezer.frame(shop.frame), FishFreezer.DEPTH)
	bubble(worker, "Porter · Collecting fish")
	if not leg(chain[goal], function()
		return toPier(shop, worker, dock, chain, goal, go)
	end) or not carryLoad(worker, load) then
		return
	end
	bubble(worker, string.format("Porter · Bringing %d fish to %s", #load, if isKitchenStorage then "kitchen storage" else if rack then "storage" else "freezer"))
	if not leg(shelfSpot, function()
		return fromPier(shop, worker, dock, chain, shelfSpot, go)
	end) then
		return
	end
	-- Revalidate inside every UpdateAsync attempt. The player may have moved the
	-- fish while the porter walked; the saved fish never leaves its hold early.
	local ok = BoatService.updateProgress(owner, function(current)
		assert(valid() and current.Angler.Staff.Porter, "The porter is no longer unloading this boat.")
		assert(not isKitchenStorage or #fixtureFrames(shop, current, "KitchenStorage") > 0, "The kitchen storage table was removed.")
		local data = current.Angler
		-- Preserve pickup order so freezer packing matches the planned load.
		-- Earlier removals shift each later cargo slot down by one.
		for index, entry in load do
			if isKitchenStorage then
				data = AnglerData.unloadFishToKitchenStorage(data, boatId, entry.Index - index + 1, entry.Record, Catalog.Fish)
			else
				data = AnglerData.unloadFish(data, boatId, entry.Index - index + 1, entry.Record, rack ~= nil)
			end
			assert(data, "The fish moved or the shelf is full.")
		end
		current.Angler = data
	end)
	if ok and isKitchenStorage then
		FurnitureService.refreshPlayer(owner)
	end
	refreshDisplay(shop)
end

-- A storage rack to the freezer or the kitchen storage table.
local function restockTrip(shop, worker, owner: Player, load, rack: CFrame, kitchenStorage: CFrame?)
	local dock = shop.base:GetAttribute("BoatDockFrame")
	if typeof(dock) ~= "CFrame" then
		return
	end
	local function valid(): boolean
		return worker.active
			and shop.staff.Porter == worker
			and worker.humanoid.Health > 0
			and ownerOf(shop.base) == owner
	end
	local moving, leg = porterLegs(worker, valid)
	local function go(position: Vector3, straight: boolean?): boolean
		return moving() and walk(worker, position, moving, true, straight) and valid()
	end
	local chain = pierChain(dock)
	local rackSpot = accessSpot(worker, rack, StorageRack.DEPTH)
	local shelfSpot = if kitchenStorage
		then accessSpot(worker, kitchenStorage, Kitchen.DEPTH)
		else accessSpot(worker, FishFreezer.frame(shop.frame), FishFreezer.DEPTH)
	bubble(worker, if kitchenStorage then "Porter · Stocking kitchen prep table" else "Porter · Restocking the freezer")
	if not leg(rackSpot, function()
		return fromPier(shop, worker, dock, chain, rackSpot, go)
	end) or not carryLoad(worker, load) then
		return
	end
	if not leg(shelfSpot, function()
		return fromPier(shop, worker, dock, chain, shelfSpot, go)
	end) then
		return
	end
	local ok = BoatService.updateProgress(owner, function(current)
		assert(valid() and current.Angler.Staff.Porter, "The porter is no longer restocking.")
		assert(not kitchenStorage or #fixtureFrames(shop, current, "KitchenStorage") > 0, "The kitchen storage table was removed.")
		local data = current.Angler
		for _, entry in load do
			data = if kitchenStorage
				then AnglerData.restockFishToKitchenStorage(data, entry.Record, Catalog.Fish)
				else AnglerData.restockFish(data, entry.Record)
			assert(data, "The fish moved or the shelf is full.")
		end
		current.Angler = data
	end)
	if ok and kitchenStorage then
		FurnitureService.refreshPlayer(owner)
	end
	refreshDisplay(shop)
end

-- One trip per call, in priority order: fish the kitchen table still needs,
-- boat cargo that fits a freezer, shelf fish that fit a freezer, then boat
-- cargo onto a storage rack. A moored company boat is emptied before the
-- player's own, but a company boat with nothing usable never hides it.
local function porterTrip(shop, worker, owner: Player)
	local profile = BoatService.getProfile(owner)
	if not profile or not profile.Angler.Staff.Porter then
		return
	end
	local data = profile.Angler
	local speed, capacity = StaffCatalog.porterStats(data)
	worker.humanoid.WalkSpeed = speed
	local racks = rackFrames(shop, profile)
	local kitchenStorages = fixtureFrames(shop, profile, "KitchenStorage")
	local boats = {}
	if companyDock then
		local id, model = companyDock(shop, owner)
		if id then
			table.insert(boats, { id = id, model = model })
		end
	end
	local ownId, ownModel = dockedBoat(shop, owner)
	if ownId then
		table.insert(boats, { id = ownId, model = ownModel })
	end

	-- Fish from `records` (each { Index?, Record }) that `fits` accepts, in order.
	local function pick(records, fits: (any) -> boolean)
		local load = {}
		for _, entry in records do
			if #load >= capacity then
				break
			end
			if fits(entry.Record) then
				table.insert(load, entry)
			end
		end
		return load
	end
	local function cargo(id: string)
		local records = {}
		for slot, item in data.Holds[id] or {} do
			if item.Fish then
				table.insert(records, { Index = slot, Record = item.Fish })
			end
		end
		return records
	end
	local shelf = {}
	for index = 1, math.min(#data.Storage, AnglerData.RACK_CAPACITY) do
		table.insert(shelf, { Record = data.Storage[index] })
	end
	-- Each check previews the shelf it fills, so a load never overfills it.
	local function freezerFits()
		local preview = table.clone(data)
		preview.Freezer = table.clone(data.Freezer)
		return function(record): boolean
			if not AnglerData.canFreeze(preview, record) then
				return false
			end
			table.insert(preview.Freezer, record)
			return true
		end
	end
	local function kitchenFits()
		local preview = table.clone(data)
		preview.KitchenStorage = {
			Targets = data.KitchenStorage.Targets or {},
			Fish = table.clone(data.KitchenStorage.Fish or {}),
		}
		return function(record): boolean
			if not AnglerData.canKitchenStorageAccept(preview, record, Catalog.Fish) then
				return false
			end
			table.insert(preview.KitchenStorage.Fish, record)
			return true
		end
	end
	local function fromBoats(fits: () -> (any) -> boolean, deliver: (any, any) -> ()): boolean
		for _, boat in boats do
			local load = pick(cargo(boat.id), fits())
			if #load > 0 then
				deliver(boat, load)
				return true
			end
		end
		return false
	end

	if kitchenStorages[1] then
		if fromBoats(kitchenFits, function(boat, load)
			unloadTrip(shop, worker, owner, boat.id, boat.model, load, kitchenStorages[1], true)
		end) then
			return
		end
		local load = if racks[1] then pick(shelf, kitchenFits()) else {}
		if #load > 0 then
			restockTrip(shop, worker, owner, load, racks[1], kitchenStorages[1])
			return
		end
	end
	if fromBoats(freezerFits, function(boat, load)
		unloadTrip(shop, worker, owner, boat.id, boat.model, load)
	end) then
		return
	end
	local load = if racks[1] then pick(shelf, freezerFits()) else {}
	if #load > 0 then
		restockTrip(shop, worker, owner, load, racks[1])
		return
	end
	-- Racks fill in placement order, so the next free one gets the fish.
	local storageRoom = math.max(0, AnglerData.storageCapacity(data) - #data.Storage)
	local room = math.min(storageRoom, AnglerData.RACK_CAPACITY - #data.Storage % AnglerData.RACK_CAPACITY)
	local rack = racks[math.floor(#data.Storage / AnglerData.RACK_CAPACITY) + 1]
	if rack and room > 0 then
		fromBoats(function()
			local taken = 0
			return function(): boolean
				taken += 1
				return taken <= room
			end
		end, function(boat, load)
			unloadTrip(shop, worker, owner, boat.id, boat.model, load, rack)
		end)
	end
end

local function runPorter(shop, worker, owner: Player)
	if worker.busy then
		return
	end
	worker.busy = true
	task.spawn(function()
		local ok, failure = pcall(porterTrip, shop, worker, owner)
		for _, carried in worker.load or {} do
			if carried.grip then
				carried.grip:Destroy()
			end
			carried.fish:Destroy()
		end
		worker.load = nil
		if worker.grip then
			worker.grip:Destroy()
			worker.grip = nil
		end
		if worker.fish then
			worker.fish:Destroy()
			worker.fish = nil
		end
		worker.busy = false
		if worker.active and worker.model.Parent then
			bubble(worker, "Porter · Waiting for docked cargo / shelf space")
		end
		if not ok then
			warn("[Staff] Porter: " .. tostring(failure))
		end
	end)
end

local function ensureStaff(shop, owner: Player, role: string)
	local worker = shop.staff[role]
	if worker and worker.model.Parent and worker.humanoid.Health > 0 then
		return worker
	end
	if worker then
		worker.active = false
		worker.model:Destroy()
		shop.staff[role] = nil
	end
	if shop.spawning[role] then
		return nil
	end
	shop.spawning[role] = true
	task.spawn(function()
		local model
		local ok, failure = pcall(function()
			local desk = ShopDesk.frame(shop.frame)
			local position = if role == "Seller"
				then (desk * CFrame.new(0, 0, ShopDesk.DEPTH / 2 + 1.4)).Position
				else (shop.frame * CFrame.new(-10, 0.16, 10)).Position
			model = spawnCustomer(position, role)
			if ownerOf(shop.base) ~= owner or not (BoatService.getProfile(owner) and BoatService.getProfile(owner).Angler.Staff[role]) then
				model:Destroy()
				return
			end
			model.Name = role
			model:SetAttribute("OwnerUserId", owner.UserId)
			model:SetAttribute("StaffRole", role)
			local member = {
				shop = shop,
				model = model,
				active = true,
				humanoid = model:FindFirstChildOfClass("Humanoid"),
				root = model:FindFirstChild("HumanoidRootPart"),
			}
			shop.staff[role] = member
			bubble(member, role .. " · Ready to work")
			if role == "Seller" then
				face(member, desk.Position)
			end
		end)
		shop.spawning[role] = nil
		if not ok then
			if model then
				model:Destroy()
			end
			warn("[Staff] Spawn: " .. tostring(failure))
		end
	end)
	return nil
end

local function stock(player: Player, shop, prompt: ProximityPrompt)
	local position = (prompt.Parent :: BasePart).Position
	-- Leeway for walking while the prompt's hold completes.
	local reach = prompt.MaxActivationDistance + 2
	if stocking[player] or ownerOf(shop.base) ~= player or not near(player, position, reach) then
		return
	end
	local profile = BoatService.getProfile(player)
	if not profile then
		notify(player, "Your tackle box is still loading. Try again in a moment.")
		return
	end
	local carrying = CargoService.isCarrying(player, profile.Angler.Hand)
	local _, available = AnglerData.stockFreezer(profile.Angler, carrying)
	if available == 0 then
		local unlocked = 0
		for _, item in profile.Angler.Backpack do
			if not item.Locked then
				unlocked += 1
			end
		end
		notify(
			player,
			if carrying or unlocked > 0
				then "No fish fit in the remaining freezer space."
				elseif
					#profile.Angler.Backpack > 0
				then "Your backpack fish are locked. Right-click a fish to unlock it."
				else "Bring fish in your backpack or equip a fish to stock the freezer."
		)
		return
	end
	stocking[player] = true
	local moved, remaining = 0, 0
	local ok, message = BoatService.updateProgress(player, function(current)
		assert(ownerOf(shop.base) == player and near(player, position, reach), "Move closer to your freezer.")
		local hasHand = CargoService.isCarrying(player, current.Angler.Hand)
		current.Angler, moved = AnglerData.stockFreezer(current.Angler, hasHand)
		remaining = if hasHand and current.Angler.Hand then 1 else 0
		for _, item in current.Angler.Backpack do
			if not item.Locked then
				remaining += 1
			end
		end
	end)
	stocking[player] = nil
	if ok then
		notify(
			player,
			if moved > 0
				then string.format(
					"Placed %d fish in the freezer.%s",
					moved,
					if remaining > 0 then " Some fish did not fit." else ""
				)
				else "No fish fit in the remaining freezer space."
		)
		update:FireClient(player, "Stocked")
		refreshDisplay(shop)
	else
		notify(player, message)
	end
end

-- Supermarket path: take a fish back out of the freezer to cook it. Fish a
-- customer has already chosen stay put.
local function takeFrozenFish(player: Player, shop, prompt: ProximityPrompt)
	local position = (prompt.Parent :: BasePart).Position
	local reach = prompt.MaxActivationDistance + 2
	if stocking[player] or ownerOf(shop.base) ~= player or not near(player, position, reach) then
		return
	end
	local profile = BoatService.getProfile(player)
	if not profile then
		notify(player, "Your tackle box is still loading. Try again in a moment.")
		return
	elseif not Paths.unlocked(profile, "Supermarket") then
		notify(player, "Taking fish out to cook unlocks with the Supermarket path.")
		return
	elseif profile.Angler.Hand then
		notify(player, "Your hands are already full.")
		return
	end
	local claimed = {}
	for _, customer in shop.customers do
		for _, item in customer.items do
			if not item.food then
				local key = recordKey(item.record)
				claimed[key] = (claimed[key] or 0) + 1
			end
		end
	end
	local choice
	for index = #profile.Angler.Freezer, 1, -1 do
		local record = profile.Angler.Freezer[index]
		local key = recordKey(record)
		if (claimed[key] or 0) > 0 then
			claimed[key] -= 1
		else
			choice = record
			break
		end
	end
	if not choice then
		notify(
			player,
			if #profile.Angler.Freezer == 0
				then "Your freezers are empty."
				else "Every fish in your freezer is promised to a customer."
		)
		return
	end
	stocking[player] = true
	local ok, message = BoatService.updateProgress(player, function(current)
		assert(ownerOf(shop.base) == player and near(player, position, reach), "Stand at your freezer.")
		local data, failure = AnglerData.takeFrozen(current.Angler, choice)
		assert(data, failure)
		current.Angler = data
	end)
	stocking[player] = nil
	if ok then
		notify(player, "Took a " .. describeFish(choice) .. " from the freezer. Carry it to a kitchen station.")
		refreshDisplay(shop)
	else
		notify(player, message)
	end
end

local function arrive(shop)
	local owner = ownerOf(shop.base)
	local profile = owner and BoatService.getProfile(owner)
	if not profile or (#profile.Angler.Freezer == 0 and #profile.Angler.Pantry == 0) then
		return
	end
	-- The advertisement allows one waiting customer behind each active register.
	local advertised = ShopUpgrades.hasAdvertisement(profile.Angler)
	local registers = fixtureFrames(shop, profile, "Register", ShopDesk.frame(shop.frame))
	local registerLoads, claimed = {}, {}
	for _, other in shop.customers do
		if not advertised or (other.active and not other.leaving) then
			registerLoads[other.registerKey] = (registerLoads[other.registerKey] or 0) + 1
		end
		for _, item in other.items do
			if not item.taken then
				local key = if item.food then "food " .. dishKey(item.record) else recordKey(item.record)
				claimed[key] = (claimed[key] or 0) + 1
			end
		end
	end
	local register, lowestLoad = nil, if advertised then 2 else 1
	for _, frame in registers do
		local load = registerLoads[tostring(frame.Position)] or 0
		if load < lowestLoad then
			register, lowestLoad = frame, load
		end
	end
	if not register then
		return
	end
	-- Only choose fish that actually fit on the ice, have a displayed model and
	-- aren't already wanted by another customer.
	local choices, seen = {}, {}
	for _, list in { shop.displayFish or {}, shop.displayFood or {} } do
		for _, item in list do
			local key = if item.food then "food " .. dishKey(item.record) else recordKey(item.record)
			seen[key] = (seen[key] or 0) + 1
			if seen[key] > (claimed[key] or 0) then
				table.insert(choices, item)
			end
		end
	end
	if #choices == 0 then
		return
	end
	local items = {}
	local count = if ShopUpgrades.hasBaskets(profile.Angler) then math.min(3, #choices) else 1
	for _ = 1, count do
		local choice = table.remove(choices, random:NextInteger(1, #choices))
		table.insert(items, { record = choice.record, freezer = choice.freezer, food = choice.food })
	end
	local customer = {
		shop = shop,
		items = items,
		register = register,
		registerKey = tostring(register.Position),
		active = true,
	}
	table.insert(shop.customers, customer)
	-- Alternate 17 and 18 seconds: two evenly spaced arrivals per 35 seconds.
	local interval = ARRIVAL_SECONDS
	if advertised then
		interval = if shop.shortArrival then 17 else 18
		shop.shortArrival = not shop.shortArrival
	end
	shop.nextArrival = os.clock() + interval
	task.spawn(function()
		local ok, failure = pcall(visit, shop, customer)
		if not ok then
			warn("[Customers] " .. tostring(failure))
		end
		finish(shop, customer)
	end)
end

local function registerShop(base: Model)
	if shops[base] then
		return
	end
	local frame = houseFrame(base)
	local house = base:FindFirstChild("BaseHouse")
	local shopModel = house and house:FindFirstChild("Shop")
	if not frame or not shopModel then
		return
	end
	local anchor = Instance.new("Part")
	anchor.Name = "FreezerPromptAnchor"
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.Transparency, anchor.Anchored = 1, true
	anchor.CanCollide, anchor.CanQuery, anchor.CanTouch = false, false, false
	anchor.CFrame = FishFreezer.frame(frame) * CFrame.new(0, FishFreezer.HEIGHT * 0.7, FishFreezer.DEPTH / 2)
	anchor.Parent = shopModel
	local shop = {
		base = base,
		frame = frame,
		staff = {},
		spawning = {},
		customers = {},
		nextArrival = os.clock() + ARRIVAL_SECONDS,
	}
	shop.freezerPrompt = ownerPrompt(anchor, "StockFreezerPrompt", "Place fish", "Freezer")
	shop.freezerPrompt.MaxActivationDistance = 5
	shops[base] = shop
	local function owned()
		removeStaff(shop)
		local userId = base:GetAttribute("OwnerUserId")
		shop.freezerPrompt:SetAttribute("OwnerUserId", userId)
		for _, customer in shop.customers do
			if customer.prompt then
				customer.prompt:SetAttribute("OwnerUserId", userId)
			end
			-- A new or departed owner never inherits the previous customers.
			leave(customer)
		end
		shop.nextArrival = os.clock() + ARRIVAL_SECONDS
		shop.shortArrival = false
	end
	base:GetAttributeChangedSignal("OwnerUserId"):Connect(owned)
	shop.freezerPrompt:SetAttribute("OwnerUserId", base:GetAttribute("OwnerUserId"))
end

-- Lets the Company path's fisherman boat be unloaded by the porter.
function CustomerService.useCompanyDock(report: (any, Player) -> (string?, Model?))
	companyDock = report
end

-- Shared NPC helpers for the restaurant's diners and the hired fisherman.
CustomerService.npc = {
	spawn = function(position: Vector3, staffRole: string?): Model
		return spawnCustomer(position, staffRole)
	end,
	walk = walk,
	face = face,
	bubble = bubble,
	carry = carry,
	notify = notify,
	ownerOf = ownerOf,
	houseFrame = houseFrame,
	near = near,
	ownerPrompt = ownerPrompt,
	dishModel = dishModel,
	setAnchored = setAnchored,
}

function CustomerService.start()
	if started then
		return
	end
	started = true
	local remotes = Instance.new("Folder")
	remotes.Name = "ShopCustomers"
	update = Instance.new("RemoteEvent")
	update.Name, update.Parent = "Update", remotes
	remotes.Parent = ReplicatedStorage
	folder = Instance.new("Folder")
	folder.Name = "ShopCustomers"
	folder.Parent = workspace

	for _, base in CollectionService:GetTagged(BASE_TAG) do
		registerShop(base)
	end
	CollectionService:GetInstanceAddedSignal(BASE_TAG):Connect(registerShop)
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		if prompt.Name == "SellToCustomerPrompt" then
			local customer = customers[prompt]
			if customer then
				sell(player, customer)
			end
		elseif prompt.Name == "StockFreezerPrompt" and prompt.Parent and prompt.Parent:IsA("BasePart") then
			-- The built-in freezer and every placed one share the same stock.
			for base, shop in shops do
				if prompt:IsDescendantOf(base) then
					task.spawn(stock, player, shop, prompt)
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		stocking[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			for _, shop in shops do
				local owner = ownerOf(shop.base)
				local profile = owner and BoatService.getProfile(owner)
				if profile then
					for _, role in { "Seller", "Porter" } do
						if not profile.Angler.Staff[role] and shop.staff[role] then
							shop.staff[role].active = false
							shop.staff[role].model:Destroy()
							shop.staff[role] = nil
						end
						if profile.Angler.Staff[role] then
							local worker = ensureStaff(shop, owner, role)
							if worker and role == "Porter" then
								if not worker.busy then
									local speed = StaffCatalog.porterStats(profile.Angler)
									worker.humanoid.WalkSpeed = speed
								end
								runPorter(shop, worker, owner)
							elseif worker then
								for _, customer in shop.customers do
									-- Share the manual sale's lock and atomic wallet update.
									if customer.prompt and not customer.leaving and not customer.autoServing then
										customer.autoServing = true
										task.spawn(function()
											sell(owner, customer, worker)
											customer.autoServing = false
										end)
									end
								end
							end
						end
					end
				end
				local label = string.format(
					"Freezer · %d fish · %d%% space used",
					frozenCount(shop, owner),
					if profile then AnglerData.freezerUsage(profile.Angler) else 0
				)
				shop.freezerPrompt.ObjectText = label
				local house = shop.base:FindFirstChild("BaseHouse")
				local placed = house and house:FindFirstChild("Furniture")
				for _, item in if placed then placed:GetChildren() else {} do
					local prompt = item.Name == "Freezer" and item:FindFirstChild("StockFreezerPrompt", true)
					if prompt then
						prompt.ObjectText = label
					end
				end
				refreshShelves(shop)
				if owner and os.clock() >= shop.nextArrival then
					arrive(shop)
				end
			end
		end
	end)
end

return CustomerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="147">
        <Properties>
          <string name="Name">DashboardService</string>
          <string name="Source"><![CDATA[-- Reports this server's players and weather to the luma admin dashboard
-- (sync.luma-app.cc/admin, Fishing Waters project) and applies what the
-- operator set there: a weather override, gamepass grants and which Limited
-- fish bite (and how often). Game servers
-- can't be called into, so both ride back on the heartbeat's response.
-- Needs Allow HTTP Requests and the LumaDashboardKey secret; without them it
-- warns once and stays off.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Biomes = require(ReplicatedStorage.Shared.Biomes)
local Catalog = require(ReplicatedStorage.Shared.AnglerCatalog)
local FishCatch = require(ReplicatedStorage.Shared.FishCatch)
local Passes = require(ReplicatedStorage.Shared.Gamepasses)
local Weather = require(ReplicatedStorage.Shared.Weather)
local GamepassService = require(script.Parent.GamepassService)

local Service = {}
local URL = "https://sync.luma-app.cc/api/v1/fishing-waters/heartbeat"
local SECRET_NAME = "LumaDashboardKey"
local started = false
local jobId = if game.JobId ~= "" then game.JobId else "studio-" .. HttpService:GenerateGUID(false):sub(1, 8)
local startedAt = os.time()
local joinedAt = {}
local interval = 15
local soon = false
local appliedWeatherVersion = 0
local failures = 0

local function payload(closing: boolean?)
	if closing then
		return { jobId = jobId, closing = true }
	end
	local players = {}
	for _, player in Players:GetPlayers() do
		local entry = {
			userId = player.UserId,
			name = player.Name,
			displayName = player.DisplayName,
			joinedAt = joinedAt[player] or startedAt,
		}
		local root = player.Character and player.Character.PrimaryPart
		if root then
			entry.x = math.round(root.Position.X)
			entry.z = math.round(root.Position.Z)
		end
		table.insert(players, entry)
	end

	local now = workspace:GetServerTimeNow()
	local state = Weather.getState(now)
	local epoch = workspace:GetAttribute("WeatherEpoch") or now
	local override = workspace:GetAttribute("WeatherOverride")
	local blackHole = Weather.blackHolePosition()
	local supercell = Weather.supercell(now)
	local tornadoes = {}
	for _, tornado in Weather.tornadoes(now) do
		table.insert(tornadoes, {
			x = math.round(tornado.position.X),
			z = math.round(tornado.position.Z),
			radius = math.round(tornado.radius),
			strength = math.round(tornado.strength * 100) / 100,
		})
	end
	local kinds, schedule, passes = {}, {}, {}
	for kind in Weather.Presets do
		table.insert(kinds, kind)
	end
	-- Calmest first, so the dashboard's weather buttons read in order; the rare
	-- supercell after ordinary weather, the admin-only black hole last.
	local rank = { Supercell = 5, BlackHole = 10 }
	table.sort(kinds, function(a, b)
		local pa, pb = Weather.Presets[a], Weather.Presets[b]
		local sa = pa.rain + pa.storm + (rank[a] or 0)
		local sb = pb.rain + pb.storm + (rank[b] or 0)
		return if sa == sb then a < b else sa < sb
	end)
	for _, stage in Weather.Schedule do
		table.insert(schedule, { kind = stage.kind, duration = stage.duration })
	end
	for key, pass in Passes do
		table.insert(passes, { key = key, name = pass.Name, id = pass.Id })
	end
	table.sort(passes, function(a, b)
		return a.name < b.name
	end)

	return {
		jobId = jobId,
		placeVersion = game.PlaceVersion,
		privateServer = game.PrivateServerId ~= "",
		studio = RunService:IsStudio(),
		startedAt = startedAt,
		players = players,
		weather = {
			kind = state.kind,
			blackHole = if blackHole
				then { x = blackHole.X, z = blackHole.Z, radius = Weather.BlackHoleRadius }
				else nil,
			supercell = if supercell
				then {
					x = math.round(supercell.position.X),
					z = math.round(supercell.position.Z),
					radius = Weather.SupercellRadius,
					strength = math.round(supercell.strength * 100) / 100,
					forced = supercell.forced,
				}
				else nil,
			tornadoes = tornadoes,
			override = if type(override) == "string" then override else nil,
			rain = state.rain,
			storm = state.storm,
			cloudCover = state.cloudCover,
			windSpeed = state.windSpeed,
			windAngle = math.deg(math.atan2(state.windDirection.Z, state.windDirection.X)),
			waveAmplitude = state.waveAmplitude,
			seed = workspace:GetAttribute("WeatherSeed"),
			cycleElapsed = math.max(0, now - epoch) % Weather.CycleSeconds,
			maxWaveAmplitude = Weather.MaxWaveAmplitude,
			radar = Weather.radar(now),
		},
		kinds = kinds,
		schedule = schedule,
		passes = passes,
	}
end

local function apply(reply)
	if type(reply.intervalSeconds) == "number" then
		interval = math.clamp(reply.intervalSeconds, 5, 120)
	end
	-- Only a change made on the dashboard touches the weather, so /set weather
	-- in chat still works until the operator picks something there.
	local version = reply.weatherVersion
	if type(version) == "number" and version > appliedWeatherVersion then
		local kind = reply.weatherOverride
		local center, cell
		local valid = true
		local function location(point): Vector3?
			if
				type(point) == "table"
				and type(point.x) == "number"
				and type(point.z) == "number"
				and point.x == point.x
				and point.z == point.z
				and math.abs(point.x) <= Weather.RadarHalfSize
				and math.abs(point.z) <= Weather.RadarHalfSize
			then
				return Vector3.new(point.x, Biomes.WaterLevel, point.z)
			end
			return nil
		end
		if kind == "BlackHole" then
			center = location(reply.blackHole)
			valid = center ~= nil
		elseif kind == "Supercell" then
			-- A location is optional: without one the cell circles a random
			-- player, so the operator's choice is actually seen by someone.
			cell = location(reply.supercell) or location(reply.blackHole)
			if not cell then
				local players = Players:GetPlayers()
				local chosen = players[math.random(math.max(1, #players))]
				local root = chosen and chosen.Character and chosen.Character.PrimaryPart
				cell = if root then Vector3.new(root.Position.X, Biomes.WaterLevel, root.Position.Z) else nil
			end
		end
		if valid then
			appliedWeatherVersion = version
			workspace:SetAttribute("BlackHolePosition", center)
			workspace:SetAttribute("SupercellPosition", cell)
			workspace:SetAttribute("SupercellSince", if kind == "Supercell" then workspace:GetServerTimeNow() else nil)
			workspace:SetAttribute(
				"WeatherOverride",
				if type(kind) == "string" and Weather.Presets[kind] then kind else nil
			)
		end
	end
	if type(reply.grants) == "table" then
		GamepassService.setDashboardGrants(reply.grants)
	end
	-- Limited species the operator switched on, as percent chance per catch.
	-- Every reply carries the full list, so one left out is switched off.
	if type(reply.limitedFish) == "table" then
		table.clear(FishCatch.limited)
		for id, percent in reply.limitedFish do
			local fish = Catalog.Fish[id]
			if fish and fish.Rarity == "Limited" and type(percent) == "number" and percent > 0 then
				FishCatch.limited[id] = math.min(percent, 100) / 100
			end
		end
	end
end

local function send(secret, closing: boolean?): boolean
	local ok, response = pcall(HttpService.RequestAsync, HttpService, {
		Url = URL,
		Method = "POST",
		Headers = { ["Content-Type"] = "application/json", ["X-Fishing-Waters-Key"] = secret },
		Body = HttpService:JSONEncode(payload(closing)),
	})
	local problem
	if not ok then
		problem = tostring(response)
	elseif not response.Success then
		problem = "HTTP " .. response.StatusCode
	elseif not closing then
		local decoded, reply = pcall(HttpService.JSONDecode, HttpService, response.Body)
		if decoded and type(reply) == "table" then
			apply(reply)
		else
			problem = "unreadable reply"
		end
	end
	if problem then
		-- The first failure and then one in twenty, so an outage can't flood the log.
		if failures % 20 == 0 then
			warn("[Dashboard] Heartbeat failed: " .. problem)
		end
		failures += 1
		return false
	end
	failures = 0
	return true
end

function Service.start()
	if started then
		return
	end
	started = true
	local ok, secret = pcall(HttpService.GetSecret, HttpService, SECRET_NAME)
	if not ok then
		warn("[Dashboard] No " .. SECRET_NAME .. " secret; the admin dashboard won't see this server.")
		return
	end
	for _, player in Players:GetPlayers() do
		joinedAt[player] = os.time()
	end
	-- Joins and leaves report within a second instead of waiting a full interval,
	-- so a grant reaches a player who just joined straight away.
	Players.PlayerAdded:Connect(function(player)
		joinedAt[player] = os.time()
		soon = true
	end)
	Players.PlayerRemoving:Connect(function(player)
		joinedAt[player] = nil
		soon = true
	end)
	game:BindToClose(function()
		send(secret, true)
	end)
	task.spawn(function()
		while true do
			send(secret)
			local waited = 0
			while waited < interval and not soon do
				waited += task.wait(1)
			end
			soon = false
		end
	end)
end

return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="148">
        <Properties>
          <string name="Name">DrydockLaunch</string>
          <string name="Source"><![CDATA[-- A server reservation spans the saved purchase and the complete launch.
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Rowboat = require(script.Parent.Rowboat)
local FishingBoat = require(script.Parent.FishingBoat)
local Speedboat = require(script.Parent.Speedboat)
local RacingSpeedboat = require(script.Parent.RacingSpeedboat)
local PatrolBoat = require(script.Parent.PatrolBoat)
local Trawler = require(script.Parent.Trawler)
local Tugboat = require(script.Parent.Tugboat)
local Hovercraft = require(script.Parent.Hovercraft)

local DrydockLaunch = {}
-- A purchase first raises the underwater cradle into the basin, then lowers the new hull.
DrydockLaunch.RAISE_SECONDS = 3
local LIFT_SECONDS = 4
local reservations = {}
local boats = {
	Trawler = {
		previewName = "TrawlerPreview",
		frameAttribute = "TrawlerPreviewFrame",
		builder = Trawler,
		-- Full stern and boarding ladder need the same headwall clearance as the cruiser.
		launchOffset = CFrame.new(0, 0, -10.5),
	},
	Tugboat = { previewName = "TugboatPreview", frameAttribute = "TugboatPreviewFrame", builder = Tugboat },
	RacingSpeedboat = {
		previewName = "RacingSpeedboatPreview",
		frameAttribute = "RacingSpeedboatPreviewFrame",
		builder = RacingSpeedboat,
	},
	Rowboat = { previewName = "LaunchPreview", frameAttribute = "PreviewOriginFrame", builder = Rowboat },
	FishingBoat = {
		previewName = "FishingBoatPreview",
		frameAttribute = "FishingBoatPreviewFrame",
		builder = FishingBoat,
	},
	Speedboat = { previewName = "SpeedboatPreview", frameAttribute = "SpeedboatPreviewFrame", builder = Speedboat },
	Hovercraft = { previewName = "HovercraftPreview", frameAttribute = "HovercraftPreviewFrame", builder = Hovercraft },
	PatrolBoat = {
		previewName = "PatrolBoatPreview",
		frameAttribute = "PatrolBoatPreviewFrame",
		builder = PatrolBoat,
		-- Keep the enlarged stern ahead of the basin headwall; the bow overhangs the slipway.
		launchOffset = CFrame.new(0, 0, -10.5),
	},
}

local function marker(shop: Model, name: string): BasePart?
	local item = shop:FindFirstChild(name, true)
	return if item and item:IsA("BasePart") then item else nil
end

function DrydockLaunch.reserve(shop: Model, player: Player, boatId: string?)
	local selectedId = boatId or "Rowboat"
	local spec = boats[selectedId]
	if not spec then
		return nil, "This boat is not available at the drydock."
	end
	if reservations[shop] then
		return nil, "The drydock lift is in use. Please wait a moment."
	end
	local preview = shop:FindFirstChild(spec.previewName, true)
	local start, railEnd, finish =
		marker(shop, "PreviewOrigin"), marker(shop, "SlipwayTop"), marker(shop, "LaunchWater")
	local cradle = shop:FindFirstChild("LaunchCradle", true)
	local displayFrame = shop:GetAttribute(spec.frameAttribute)
	if
		(preview and not preview:IsA("Model"))
		or not start
		or not railEnd
		or not finish
		or not cradle
		or not cradle:IsA("Model")
		or typeof(displayFrame) ~= "CFrame"
	then
		return nil, "The drydock is not ready. Please try again shortly."
	end
	local launchOffset = spec.launchOffset or CFrame.new()
	displayFrame *= launchOffset
	-- The cradle rests underwater (LiftDrop below the basin) and the hull is built
	-- when purchased; it appears once the cradle has risen under it.
	local rest = cradle:GetPivot()
	local drop = shop:GetAttribute("LiftDrop")
	local raised = if type(drop) == "number" then rest + Vector3.new(0, drop, 0) else rest
	local parent = nil
	if not preview then
		preview = spec.builder.build(displayFrame, true)
		preview.Name = spec.previewName
		preview:SetAttribute("BoatId", selectedId)
		preview:SetAttribute("DisplayOnly", true)
		for _, piece in preview:GetDescendants() do
			if piece:IsA("BasePart") then
				piece:SetAttribute("PreviewCanCollide", piece.CanCollide)
				piece.CanCollide = false
			end
		end
		parent = shop:FindFirstChild("RearDrydock") or shop
	end
	-- Launch without querying water depth, terrain, boats, or nearby objects.
	local reservation = {
		boatId = selectedId,
		spec = spec,
		shop = shop,
		player = player,
		preview = preview,
		start = start.CFrame * launchOffset,
		railEnd = railEnd.CFrame,
		finish = finish.CFrame * launchOffset,
		cradle = cradle,
		cradleStart = raised,
		cradleRest = rest,
		parent = parent,
		previewStart = preview:GetPivot(),
		displayFrame = displayFrame,
	}
	reservations[shop] = reservation
	-- Keep the default display out of the world while another hull uses the bay.
	if selectedId ~= "Rowboat" then
		local rowPreview = shop:FindFirstChild("LaunchPreview", true)
		if rowPreview and rowPreview:IsA("Model") then
			reservation.displacedPreview = rowPreview
			reservation.displacedStart = rowPreview:GetPivot()
			reservation.displacedParent = rowPreview.Parent
			rowPreview.Parent = nil
		end
	end
	preview:PivotTo(reservation.start * displayFrame:ToObjectSpace(reservation.previewStart))
	preview:SetAttribute("BoatId", selectedId)
	shop:SetAttribute("LaunchingUserId", player.UserId)
	shop:SetAttribute("LaunchingBoatId", selectedId)
	return reservation
end

local function reset(reservation)
	local shop = reservation.shop
	if reservations[shop] ~= reservation then
		return
	end
	reservations[shop] = nil
	if not shop.Parent then
		if reservation.displacedPreview then
			reservation.displacedPreview:Destroy()
		end
		return
	end
	shop:SetAttribute("LaunchingUserId", nil)
	shop:SetAttribute("LaunchingBoatId", nil)
	shop:SetAttribute("LaunchStartedAt", nil)
	if reservation.cradle.Parent then
		reservation.cradle:PivotTo(reservation.cradleRest)
	end
	if reservation.preview:IsDescendantOf(shop) then
		reservation.preview:PivotTo(reservation.previewStart)
	end
	if reservation.displacedPreview then
		reservation.displacedPreview.Parent = reservation.displacedParent
		reservation.displacedPreview:PivotTo(reservation.displacedStart)
	end
	-- An unlaunched hull is only a temporary display.
	if reservation.preview:IsDescendantOf(shop) then
		reservation.preview:Destroy()
	end
end

-- Return asynchronously so the buyer regains the driving camera immediately.
function DrydockLaunch.release(reservation)
	if not reservation.activated then
		reset(reservation)
		return
	end
	if reservation.returning then
		return
	end
	reservation.returning = true
	task.spawn(function()
		local ok, reason = pcall(function()
			local model, shop = reservation.preview, reservation.shop
			while model.Parent and shop.Parent do
				local clear = true
				for _, piece in model:GetDescendants() do
					if piece:IsA("BasePart") then
						-- A bounding sphere around each piece conservatively covers
						-- rotated hulls, so the stern must clear the deck as well.
						local point = reservation.start:PointToObjectSpace(piece.Position)
						local radius = piece.Size.Magnitude / 2
						if math.abs(point.X) < 13 + radius and math.abs(point.Z) < 63 + radius then
							clear = false
							break
						end
					end
				end
				if clear then
					break
				end
				RunService.Heartbeat:Wait()
			end
			local cradle = reservation.cradle
			if not cradle.Parent or not shop.Parent then
				return
			end
			local from, elapsed = cradle:GetPivot(), 0
			repeat
				elapsed += RunService.Heartbeat:Wait()
				local alpha = math.min(elapsed / 5, 1)
				alpha = alpha * alpha * (3 - 2 * alpha)
				cradle:PivotTo(from:Lerp(reservation.cradleRest, alpha))
			until elapsed >= 5 or not cradle.Parent or not shop.Parent
		end)
		reset(reservation)
		if not ok then
			warn("[Boats] Lift return failed: " .. tostring(reason))
		end
	end)
end

function DrydockLaunch.run(reservation, activate)
	local model, cradle = reservation.preview, reservation.cradle
	local initialPivot = model:GetPivot()
	-- Bring the empty cradle up from the water, then set the new hull on it.
	local rise = reservation.cradleStart.Position - reservation.cradleRest.Position
	local elapsed = 0
	while rise.Magnitude > 0 and elapsed < DrydockLaunch.RAISE_SECONDS do
		elapsed += RunService.Heartbeat:Wait()
		if not reservation.shop.Parent then
			error("Drydock removed")
		end
		local alpha = math.min(elapsed / DrydockLaunch.RAISE_SECONDS, 1)
		cradle:PivotTo(reservation.cradleRest + rise * (alpha * alpha * (3 - 2 * alpha)))
	end
	if reservation.parent and not model.Parent then
		model.Parent = reservation.parent
	end
	-- Lowering ends with the cradle back at rest, under the floating hull.
	local sink = rise - (reservation.start.Position - reservation.finish.Position)
	local function move(from: CFrame, to: CFrame, duration: number)
		local elapsed = 0
		repeat
			elapsed += RunService.Heartbeat:Wait()
			if not model.Parent or not reservation.shop.Parent then
				error("Launch model removed")
			end
			local alpha = math.min(elapsed / duration, 1)
			alpha = alpha * alpha * (3 - 2 * alpha)
			local frame = from:Lerp(to, alpha)
			local offset = frame.Position - reservation.start.Position
			model:PivotTo(initialPivot + offset)
			-- The cradle descends further under the floating hull at the end.
			local submerge = if to ~= reservation.finish
				then Vector3.zero
				elseif rise.Magnitude > 0 then -sink * alpha
				else Vector3.new(0, -2 * alpha, 0)
			cradle:PivotTo(reservation.cradleStart + offset + submerge)
		until elapsed >= duration
	end
	move(reservation.start, reservation.finish, 7)
	local player = reservation.player
	if player.Parent ~= Players then
		return nil
	end
	-- Physics is attached only after the anchored lowering animation has ended.
	local ok, result = pcall(activate, player, reservation.finish, model)
	reservation.activated = not model:IsDescendantOf(reservation.shop)
	if not ok then
		error(result)
	end
	return result
end

local function tween(seconds: number, step: (number) -> ())
	local elapsed = 0
	repeat
		elapsed += RunService.Heartbeat:Wait()
		local alpha = math.min(elapsed / seconds, 1)
		step(alpha * alpha * (3 - 2 * alpha))
	until alpha >= 1
end

-- World height of the hull's lowest keel point.
local function keelBottom(model: Model): number?
	local lowest = nil
	for _, piece in model:GetDescendants() do
		if piece:IsA("BasePart") and piece.Name == "Keel" then
			local frame, size = piece.CFrame, piece.Size
			local reach = math.abs(frame.RightVector.Y) * size.X
				+ math.abs(frame.UpVector.Y) * size.Y
				+ math.abs(frame.LookVector.Y) * size.Z
			lowest = math.min(lowest or math.huge, frame.Position.Y - reach / 2)
		end
	end
	return lowest
end

local function moveLift(lift, rise: number)
	lift.rise = rise
	if lift.cradle.Parent then
		lift.cradle:PivotTo(lift.rest + Vector3.new(0, rise, 0))
	end
	pcall(lift.hoist, math.max(0, rise - lift.contact))
end

-- The refit lift: the cradle rises under a floating hull until its keel blocks
-- meet the keel, then carries the hull up into the dry basin. `hoist(height)`
-- holds the boat that far above where it floated (nil lets it go). Yields until
-- the hull is up; returns nil and a reason when the lift is busy.
function DrydockLaunch.lift(shop: Model, player: Player, model: Model, hoist: (number?) -> ())
	if reservations[shop] then
		return nil, "The drydock lift is in use. Please wait a moment."
	end
	local cradle = shop:FindFirstChild("LaunchCradle", true)
	local drop, keel = shop:GetAttribute("LiftDrop"), shop:GetAttribute("LiftKeelHeight")
	local bottom = keelBottom(model)
	if not cradle or not cradle:IsA("Model") or type(drop) ~= "number" or type(keel) ~= "number" or not bottom then
		return nil, "The drydock lift is not ready. Please try again shortly."
	end
	local lift = {
		shop = shop,
		player = player,
		cradle = cradle,
		rest = cradle:GetPivot(),
		drop = drop,
		hoist = hoist,
		rise = 0,
		-- How far the blocks climb before they touch the keel.
		contact = math.clamp(bottom - (keel - drop), 0, drop),
	}
	reservations[shop] = lift
	shop:SetAttribute("LiftingUserId", player.UserId)
	tween(LIFT_SECONDS, function(alpha)
		moveLift(lift, drop * alpha)
	end)
	return lift
end

-- Sets the hull back afloat and returns the cradle underwater. Safe to call more than once.
function DrydockLaunch.lower(lift)
	if reservations[lift.shop] ~= lift or lift.lowering then
		return
	end
	lift.lowering = true
	local from = lift.rise
	if from > 0 then
		tween(LIFT_SECONDS * from / lift.drop, function(alpha)
			moveLift(lift, from * (1 - alpha))
		end)
	end
	moveLift(lift, 0)
	pcall(lift.hoist, nil)
	reservations[lift.shop] = nil
	lift.shop:SetAttribute("LiftingUserId", nil)
end

return DrydockLaunch
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="149">
        <Properties>
          <string name="Name">FishingBoat</string>
          <string name="Source"><![CDATA[-- A small working fisher, shared by the drydock display and owned boats.
-- The supplied frame is the waterline and local -Z points toward the bow.
-- Only the hull, deck, and wheelhouse walls collide; equipment stays decorative.

local FishingBoat = {}

local WHITE = Color3.fromRGB(224, 229, 215)
local CREAM = Color3.fromRGB(239, 222, 179)
local TEAL = Color3.fromRGB(47, 103, 96)
local DECK = Color3.fromRGB(98, 123, 109)
local DARK = Color3.fromRGB(38, 47, 43)
local ROOF = Color3.fromRGB(119, 65, 47)
local WOOD = Color3.fromRGB(145, 111, 73)
local ROPE = Color3.fromRGB(188, 171, 128)
local ORANGE = Color3.fromRGB(220, 109, 49)
local GLASS = Color3.fromRGB(103, 159, 169)
local METAL = Color3.fromRGB(145, 155, 146)
local THICKNESS = 0.18

function FishingBoat.build(frame: CFrame, anchored: boolean?): Model
	local isAnchored = anchored == true
	local model = Instance.new("Model")
	model.Name = "FishingBoat"
	model:SetAttribute("HullLength", 22)
	model:SetAttribute("HullBeam", 9.6)
	model:SetAttribute("PassengerSeats", 2)
	model:SetAttribute("DriverSeat", "HelmSeat")
	model:SetAttribute("DryFloorHeight", 1.1)
	model:SetAttribute("DryFloorHalfBeam", 4.2)
	model:SetAttribute("DryFloorHalfLength", 10.85)

	local root = Instance.new("Part")
	root.Name = "HullRoot"
	root.Size = Vector3.new(5.6, 0.5, 14)
	root.CFrame = frame * CFrame.new(0, -0.4, 0)
	root.Transparency = 1
	root.Anchored = isAnchored
	root.CanCollide = false
	root.CanTouch = false
	root.RootPriority = 127
	root.CustomPhysicalProperties = PhysicalProperties.new(1.4, 0.45, 0.05, 100, 100)
	root.Parent = model
	model.PrimaryPart = root

	local function finish(p: BasePart, name: string, color: Color3, material: Enum.Material?, collide: boolean?)
		p.Name = name
		p.Anchored = isAnchored
		p.CanCollide = collide == true
		p.CanTouch = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.Massless = true
		p.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = p
		weld.Parent = p
		return p
	end

	local function part(
		name: string,
		size: Vector3,
		localFrame: CFrame,
		color: Color3,
		material: Enum.Material?,
		collide: boolean?
	): Part
		local p = Instance.new("Part")
		p.Size = size
		p.CFrame = frame * localFrame
		finish(p, name, color, material, collide)
		return p
	end

	local function beam(
		name: string,
		a: Vector3,
		b: Vector3,
		width: number,
		depth: number,
		color: Color3,
		material: Enum.Material?,
		collide: boolean?
	): Part
		return part(
			name,
			Vector3.new(width, depth, (b - a).Magnitude),
			CFrame.lookAt((a + b) / 2, b),
			color,
			material,
			collide
		)
	end

	-- Thin facets form an open hull; there is no solid collision box through it.
	local function triangle(name: string, a: Vector3, b: Vector3, c: Vector3, inside: Vector3, color: Color3)
		local ab, ac, bc = b - a, c - a, c - b
		local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
		if abd > acd and abd > bcd then
			c, a = a, c
		elseif acd > bcd and acd > abd then
			a, b = b, a
		end
		ab, ac, bc = b - a, c - a, c - b
		local right = ac:Cross(ab).Unit
		local up = bc:Cross(right).Unit
		local back = bc.Unit
		local height = math.abs(ab:Dot(up))
		local normal = if right:Dot((a + b + c) / 3 - inside) >= 0 then right else -right
		local shift = -normal * THICKNESS / 2
		local first = Instance.new("WedgePart")
		first.Size = Vector3.new(THICKNESS, height, math.abs(ab:Dot(back)))
		first.CFrame = frame * CFrame.fromMatrix((a + b) / 2 + shift, right, up, back)
		finish(first, name, color, nil, true)
		local second = Instance.new("WedgePart")
		second.Size = Vector3.new(THICKNESS, height, math.abs(ac:Dot(back)))
		second.CFrame = frame * CFrame.fromMatrix((a + c) / 2 + shift, -right, up, -back)
		finish(second, name, color, nil, true)
	end

	local stations = {
		{ z = -10.85, width = 0.18, bottom = 0.12, top = 3.0, keel = -0.05 },
		{ z = -8.0, width = 3.3, bottom = 1.8, top = 2.55, keel = -1.3 },
		{ z = -3.5, width = 4.65, bottom = 3.95, top = 2.2, keel = -1.5 },
		{ z = 3.5, width = 4.65, bottom = 3.95, top = 2.2, keel = -1.5 },
		{ z = 8.5, width = 4.4, bottom = 4.1, top = 2.2, keel = -1.25 },
		{ z = 10.8, width = 3.65, bottom = 2.8, top = 2.3, keel = -0.95 },
	}
	local function hullPoint(station, side: number, level: number): Vector3
		local bottomY = if station.z < -10 then 0.25 else -0.72
		return Vector3.new(
			side * (station.bottom + (station.width - station.bottom) * level),
			bottomY + (station.top - bottomY) * level,
			station.z
		)
	end
	-- Each cross-section curves inward through the bilge to the center keel.
	-- These panels close the underside all the way from bow to transom.
	local function bottomPoint(station, side: number, level: number): Vector3
		if level == 0 then
			return hullPoint(station, side, 0)
		elseif level == 1 then
			local edge = hullPoint(station, side, 0)
			return Vector3.new(side * station.bottom * 0.52, station.keel + (edge.Y - station.keel) * 0.42, station.z)
		end
		return Vector3.new(0, station.keel, station.z)
	end
	for _, side in { -1, 1 } do
		for i = 1, #stations - 1 do
			local from, to = stations[i], stations[i + 1]
			for _, band in { { 0, 0.79, WHITE }, { 0.79, 1, TEAL } } do
				local a, b = hullPoint(from, side, band[1]), hullPoint(to, side, band[1])
				local c, d = hullPoint(to, side, band[2]), hullPoint(from, side, band[2])
				local inside = Vector3.new(0, 0.8, (from.z + to.z) / 2)
				triangle("HullPanel", a, b, c, inside, band[3])
				triangle("HullPanel", a, c, d, inside, band[3])
			end
			for band = 0, 1 do
				local a, b = bottomPoint(from, side, band), bottomPoint(to, side, band)
				local c, d = bottomPoint(to, side, band + 1), bottomPoint(from, side, band + 1)
				local inside = Vector3.new(0, 0.8, (from.z + to.z) / 2)
				local name = if band == 0 then "BilgePanel" else "BottomPanel"
				triangle(name, a, b, c, inside, WHITE)
				triangle(name, a, c, d, inside, WHITE)
			end
			beam("Gunwale", hullPoint(from, side, 1), hullPoint(to, side, 1), 0.3, 0.24, DARK)
		end
	end
	for _, station in { stations[1], stations[#stations] } do
		local center = Vector3.new(0, hullPoint(station, 1, 0).Y, station.z)
		local inside = Vector3.new(0, 0.8, 0)
		for _, side in { -1, 1 } do
			local edge, bilge, keel =
				bottomPoint(station, side, 0), bottomPoint(station, side, 1), bottomPoint(station, side, 2)
			triangle("HullEndCap", edge, bilge, keel, inside, WHITE)
			triangle("HullEndCap", edge, keel, center, inside, WHITE)
		end
		if station == stations[1] then
			local left, right = hullPoint(station, -1, 1), hullPoint(station, 1, 1)
			triangle("BowCap", center, left, right, inside, WHITE)
			triangle("BowCap", center, hullPoint(station, -1, 0), left, inside, WHITE)
			triangle("BowCap", center, right, hullPoint(station, 1, 0), inside, WHITE)
		end
	end
	local stern = stations[#stations]
	local sternLeft, sternRight = hullPoint(stern, -1, 0), hullPoint(stern, 1, 0)
	triangle("Transom", sternLeft, sternRight, hullPoint(stern, 1, 1), Vector3.new(0, 0.8, 0), WHITE)
	triangle("Transom", sternLeft, hullPoint(stern, 1, 1), hullPoint(stern, -1, 1), Vector3.new(0, 0.8, 0), WHITE)
	part("TransomTrim", Vector3.new(7.4, 0.5, 0.23), CFrame.new(0, 2.04, 10.8), TEAL)
	part("TransomCap", Vector3.new(7.5, 0.2, 0.3), CFrame.new(0, 2.3, 10.8), DARK)
	for index = 1, #stations - 1 do
		beam(
			"Keel",
			bottomPoint(stations[index], 1, 2),
			bottomPoint(stations[index + 1], 1, 2),
			0.18,
			0.16,
			TEAL,
			nil,
			true
		)
	end
	part("BowStem", Vector3.new(0.3, 2.85, 0.25), CFrame.new(0, 1.625, -10.85), WHITE)

	-- Continuous planks provide a working bow deck and two clear side walkways.
	local function deckWidth(station): number
		local bottomY = if station.z < -10 then 0.25 else -0.72
		local level = (1.1 - bottomY) / (station.top - bottomY)
		return math.max(0, station.bottom + (station.width - station.bottom) * level - 0.15)
	end
	for i = -7, 7 do
		local outside = (math.abs(i) + 0.5) * 0.55
		local startZ, endZ = stations[1].z, stations[#stations].z - 0.15
		for index = 1, #stations - 1 do
			local a, b = stations[index], stations[index + 1]
			local fromWidth, toWidth = deckWidth(a), deckWidth(b)
			if fromWidth < outside and toWidth >= outside then
				startZ = a.z + (b.z - a.z) * (outside - fromWidth) / (toWidth - fromWidth)
			elseif fromWidth >= outside and toWidth < outside then
				endZ = a.z + (b.z - a.z) * (outside - fromWidth) / (toWidth - fromWidth)
			end
		end
		part(
			"WorkingDeck",
			Vector3.new(0.55, 0.22, endZ - startZ),
			CFrame.new(i * 0.55, 0.99, (startZ + endZ) / 2),
			DECK,
			Enum.Material.Wood,
			true
		)
	end

	-- Cream wheelhouse near the stern. The 2.6-stud front opening reaches the
	-- same level deck without a doorstep; the helm controls do not obstruct it.
	-- Transparent SmoothPlastic keeps terrain water visible through the windows;
	-- refractive Glass hides water and other transparent effects behind it.
	part("CabinBackLower", Vector3.new(4.2, 2.35, 0.24), CFrame.new(0, 2.275, 7.8), CREAM, nil, true)
	part("CabinBackHeader", Vector3.new(4.2, 0.55, 0.24), CFrame.new(0, 6.525, 7.8), CREAM, nil, true)
	for _, side in { -1, 1 } do
		part("CabinSideLower", Vector3.new(0.24, 2.35, 4.8), CFrame.new(side * 1.98, 2.275, 5.4), CREAM, nil, true)
		part("CabinSideHeader", Vector3.new(0.24, 0.55, 4.8), CFrame.new(side * 1.98, 6.525, 5.4), CREAM, nil, true)
		part("CabinFrontJamb", Vector3.new(0.8, 2.35, 0.24), CFrame.new(side * 1.7, 2.275, 3.0), CREAM, nil, true)
		part("CabinFrontHeader", Vector3.new(0.8, 0.55, 0.24), CFrame.new(side * 1.7, 6.525, 3.0), CREAM, nil, true)
		local frontGlass = part(
			"CabinFrontWindow",
			Vector3.new(0.58, 2.55, 0.12),
			CFrame.new(side * 1.7, 4.825, 3.0),
			GLASS,
			Enum.Material.SmoothPlastic,
			true
		)
		frontGlass.Transparency = 0.28
		part("CabinCorner", Vector3.new(0.25, 2.85, 0.25), CFrame.new(side * 1.98, 4.825, 7.8), CREAM, nil, true)
		for _, z in { 4.2, 6.6 } do
			local glass = part(
				"CabinSideWindow",
				Vector3.new(0.12, 2.55, 2.12),
				CFrame.new(side * 1.98, 4.825, z),
				GLASS,
				Enum.Material.SmoothPlastic,
				true
			)
			glass.Transparency = 0.28
		end
		part("WindowMullion", Vector3.new(0.29, 2.85, 0.2), CFrame.new(side * 1.98, 4.825, 5.4), CREAM, nil, true)
		part("WindowSill", Vector3.new(0.36, 0.15, 4.95), CFrame.new(side * 1.98, 3.48, 5.4), TEAL)
		local rearGlass = part(
			"CabinRearWindow",
			Vector3.new(1.67, 2.55, 0.12),
			CFrame.new(side * 0.97, 4.825, 7.8),
			GLASS,
			Enum.Material.SmoothPlastic,
			true
		)
		rearGlass.Transparency = 0.28
	end
	part("CabinRearMullion", Vector3.new(0.2, 2.85, 0.26), CFrame.new(0, 4.825, 7.8), CREAM, nil, true)
	part("DoorHeader", Vector3.new(2.6, 0.2, 0.24), CFrame.new(0, 6.7, 3.0), CREAM, nil, true)
	part("CabinRoof", Vector3.new(4.85, 0.32, 5.65), CFrame.new(0, 6.96, 5.35), ROOF, nil, true)
	part("RoofEdge", Vector3.new(4.95, 0.12, 5.76), CFrame.new(0, 6.82, 5.35), DARK)
	part("RoofRidge", Vector3.new(0.14, 0.1, 5.45), CFrame.new(0, 7.16, 5.35), WOOD)
	for _, x in { -1.6, -0.8, 0.8, 1.6 } do
		part("RoofSeam", Vector3.new(0.035, 0.035, 5.45), CFrame.new(x, 7.135, 5.35), Color3.fromRGB(94, 51, 39))
	end

	part("HelmPedestal", Vector3.new(0.55, 0.8, 0.55), CFrame.new(0, 1.5, 5.9), DARK)
	part("HelmCushion", Vector3.new(1.85, 0.25, 1.3), CFrame.new(0, 1.99, 5.9), ROOF)
	part("HelmBack", Vector3.new(1.85, 1.25, 0.2), CFrame.new(0, 2.67, 6.5), ROOF)
	local helm = Instance.new("VehicleSeat")
	helm.Size = Vector3.new(1.85, 0.24, 1.3)
	helm.CFrame = frame * CFrame.new(0, 2.04, 5.9)
	helm.Transparency = 1
	helm.HeadsUpDisplay = false
	helm.MaxSpeed = 0
	helm.Torque = 0
	helm.TurnSpeed = 0
	finish(helm, "HelmSeat", ROOF, nil, false)
	helm.CanTouch = not isAnchored
	helm.Disabled = isAnchored
	part("HelmConsole", Vector3.new(1.5, 1.0, 0.75), CFrame.new(0, 2.1, 4.25), TEAL)
	part("ConsoleTop", Vector3.new(1.65, 0.13, 0.86), CFrame.new(0, 2.67, 4.25), WOOD)
	part("InstrumentPanel", Vector3.new(1.2, 0.3, 0.1), CFrame.new(0, 2.95, 4.6), DARK)
	for _, x in { -0.33, 0.33 } do
		local gauge = part(
			"HelmGauge",
			Vector3.new(0.05, 0.26, 0.26),
			CFrame.new(x, 2.95, 4.67) * CFrame.Angles(0, math.pi / 2, 0),
			CREAM
		)
		gauge.Shape = Enum.PartType.Cylinder
	end
	local wheelCenter = Vector3.new(0, 3.05, 4.85)
	for i = 0, 7 do
		local a, b = i * math.pi / 4, (i + 1) * math.pi / 4
		beam(
			"SteeringWheel",
			wheelCenter + Vector3.new(math.cos(a) * 0.48, math.sin(a) * 0.48, 0),
			wheelCenter + Vector3.new(math.cos(b) * 0.48, math.sin(b) * 0.48, 0),
			0.1,
			0.1,
			WOOD
		)
	end
	for i = 0, 2 do
		local angle = i * math.pi * 2 / 3
		beam(
			"WheelSpoke",
			wheelCenter,
			wheelCenter + Vector3.new(math.cos(angle) * 0.45, math.sin(angle) * 0.45, 0),
			0.07,
			0.07,
			METAL
		)
	end

	-- Two usable fishing seats leave a broad lane down the middle of the bow.
	for _, side in { -1, 1 } do
		part("FishingSeatPedestal", Vector3.new(0.35, 0.68, 0.35), CFrame.new(side * 2.35, 1.44, -1.5), DARK)
		part("FishingSeatCushion", Vector3.new(1.6, 0.22, 1.3), CFrame.new(side * 2.35, 1.86, -1.5), CREAM)
		part("FishingSeatBack", Vector3.new(1.6, 0.85, 0.17), CFrame.new(side * 2.35, 2.36, -0.88), TEAL)
		local passenger = Instance.new("Seat")
		passenger.Size = Vector3.new(1.6, 0.24, 1.3)
		passenger.CFrame = frame * CFrame.new(side * 2.35, 1.9, -1.5)
		passenger.Transparency = 1
		finish(passenger, "FishingSeat" .. (if side < 0 then "Port" else "Starboard"), CREAM, nil, false)
		passenger.CanTouch = not isAnchored
		passenger.Disabled = isAnchored
	end

	-- Hanging rubber fenders and their pale lashings give the working hull scale.
	for _, side in { -1, 1 } do
		for _, z in { -3.7, 1.2, 6.8 } do
			local x = side * (if z == 6.8 then 4.54 else 4.7)
			local fender = part("RubberFender", Vector3.new(0.4, 1.25, 1.25), CFrame.new(x, 1.22, z), DARK)
			fender.Shape = Enum.PartType.Cylinder
			local inset = part("FenderInset", Vector3.new(0.415, 0.54, 0.54), CFrame.new(x, 1.22, z), TEAL)
			inset.Shape = Enum.PartType.Cylinder
			beam("FenderRope", Vector3.new(x, 1.75, z), Vector3.new(x - side * 0.2, 2.35, z + 0.15), 0.055, 0.055, ROPE)
		end
	end

	-- Low-profile equipment sits against the sides, clear of the central route.
	for _, spec in { { -2.8, -5.65 }, { -2.65, -4.15 } } do
		local x, z = spec[1], spec[2]
		part("FishCrate", Vector3.new(1.5, 0.85, 1.2), CFrame.new(x, 1.54, z), WOOD, Enum.Material.Wood)
		part("CrateRim", Vector3.new(1.62, 0.12, 1.32), CFrame.new(x, 2.01, z), CREAM, Enum.Material.Wood)
		for _, dz in { -0.4, 0, 0.4 } do
			part("CrateSlat", Vector3.new(1.54, 0.06, 0.11), CFrame.new(x, 1.96, z + dz), DARK)
		end
	end
	local ropeCenter = Vector3.new(2.65, 1.24, -5.2)
	for ring = 0, 1 do
		local radius = 0.54 + ring * 0.15
		for i = 0, 9 do
			local a, b = i * math.pi / 5, (i + 1) * math.pi / 5
			beam(
				"CoiledRope",
				ropeCenter + Vector3.new(math.cos(a) * radius, ring * 0.06, math.sin(a) * radius),
				ropeCenter + Vector3.new(math.cos(b) * radius, ring * 0.06, math.sin(b) * radius),
				0.1,
				0.1,
				ROPE
			)
		end
	end
	for _, side in { -1, 1 } do
		part("BowCleat", Vector3.new(0.7, 0.12, 0.2), CFrame.new(side * 1.8, 2.5, -8.1), METAL)
		part("BowCleatFoot", Vector3.new(0.18, 0.25, 0.18), CFrame.new(side * 1.8, 2.35, -8.1), METAL)
		local a, b = Vector3.new(side * 3.8, 1.3, -3.0), Vector3.new(side * 4.25, 5.6, -5.7)
		beam("FishingRod", a, b, 0.055, 0.055, DARK)
		beam("RodGrip", a, a:Lerp(b, 0.18), 0.13, 0.13, WOOD)
		beam("FishingLine", b, Vector3.new(side * 4.15, 0.45, -6.0), 0.018, 0.018, ROPE)
	end
	for _, spec in { { 2.85, 8.7, ORANGE }, { 3.45, 8.4, CREAM }, { 3.0, 9.3, ORANGE } } do
		local buoy = part("FishingBuoy", Vector3.new(0.66, 0.95, 0.66), CFrame.new(spec[1], 1.62, spec[2]), spec[3])
		buoy.Shape = Enum.PartType.Ball
		part("BuoyHandle", Vector3.new(0.12, 0.23, 0.12), CFrame.new(spec[1], 2.18, spec[2]), DARK)
	end

	-- The wheelhouse roof, mast, boom, and safety ring establish the silhouette.
	part("Mast", Vector3.new(0.17, 5.4, 0.17), CFrame.new(0, 9.8, 4.4), WOOD)
	part("MastCrossbar", Vector3.new(4.6, 0.12, 0.12), CFrame.new(0, 11.25, 4.4), WOOD)
	beam("MastBoom", Vector3.new(0, 9.1, 4.4), Vector3.new(0, 8.0, -0.8), 0.13, 0.13, WOOD)
	for _, side in { -1, 1 } do
		beam("MastRigging", Vector3.new(0, 12.3, 4.4), Vector3.new(side * 3.65, 2.3, 8.8), 0.035, 0.035, ROPE)
	end
	beam("BoomRigging", Vector3.new(0, 11.6, 4.4), Vector3.new(0, 8.0, -0.8), 0.035, 0.035, ROPE)
	part("NavigationLamp", Vector3.new(0.23, 0.28, 0.23), CFrame.new(0, 12.6, 4.4), CREAM, Enum.Material.Neon)
	part("Vent", Vector3.new(0.42, 0.85, 0.42), CFrame.new(1.18, 7.52, 6.3), DARK, Enum.Material.Metal)
	part("VentCap", Vector3.new(0.63, 0.12, 0.63), CFrame.new(1.18, 8.0, 6.3), METAL, Enum.Material.Metal)
	local ringCenter = Vector3.new(0, 4.8, 8.0)
	for i = 0, 11 do
		local a, b = i * math.pi / 6, (i + 1) * math.pi / 6
		beam(
			"LifeRing",
			ringCenter + Vector3.new(math.cos(a) * 0.72, math.sin(a) * 0.72, 0),
			ringCenter + Vector3.new(math.cos(b) * 0.72, math.sin(b) * 0.72, 0),
			0.2,
			0.2,
			if i % 3 == 0 then CREAM else ORANGE
		)
	end

	-- A warm bow lantern keeps the working-boat look alongside electric lighting.
	local lanternBase = Vector3.new(0, 2.6, -8.5)
	local lanternColor = Color3.fromRGB(214, 168, 104)
	part("LanternStand", Vector3.new(0.16, 1.44, 0.16), CFrame.new(0, 1.82, -8.5), DARK, Enum.Material.Metal)
	part("LanternFoot", Vector3.new(0.52, 0.12, 0.52), CFrame.new(lanternBase), DARK, Enum.Material.Metal)
	local lantern = part(
		"LanternGlass",
		Vector3.new(0.36, 0.58, 0.36),
		CFrame.new(lanternBase + Vector3.new(0, 0.35, 0)),
		lanternColor,
		Enum.Material.Neon
	)
	part(
		"LanternCap",
		Vector3.new(0.52, 0.12, 0.52),
		CFrame.new(lanternBase + Vector3.new(0, 0.7, 0)),
		DARK,
		Enum.Material.Metal
	)
	for _, x in { -0.22, 0.22 } do
		part(
			"LanternFrame",
			Vector3.new(0.05, 0.6, 0.05),
			CFrame.new(lanternBase + Vector3.new(x, 0.35, 0)),
			DARK,
			Enum.Material.Metal
		)
	end
	part(
		"LanternHandle",
		Vector3.new(0.12, 0.24, 0.06),
		CFrame.new(lanternBase + Vector3.new(0, 0.88, 0)),
		DARK,
		Enum.Material.Metal
	)
	local lanternLight = Instance.new("PointLight")
	lanternLight.Name = "LanternLight"
	lanternLight.Color, lanternLight.Range, lanternLight.Brightness = lanternColor, 8, 0.35
	lanternLight.Shadows = false
	lanternLight.Parent = lantern

	local lampColor = Color3.fromRGB(222, 206, 172)
	local ceiling =
		part("CabinLight", Vector3.new(0.8, 0.12, 0.55), CFrame.new(0, 6.72, 5.4), lampColor, Enum.Material.Neon)
	local deckLight = Instance.new("PointLight")
	deckLight.Name = "DeckLight"
	deckLight.Color, deckLight.Range, deckLight.Brightness = lampColor, 12, 0.3
	deckLight.Shadows = false
	deckLight.Parent = ceiling
	-- Keep the lamps above the bow sides, with beams pointing along local -Z.
	for _, side in { -1, 1 } do
		part(
			"HeadlightStand",
			Vector3.new(0.16, 1.4, 0.16),
			CFrame.new(side * 1.15, 1.8, -8.7),
			DARK,
			Enum.Material.Metal
		)
		part(
			"HeadlightHousing",
			Vector3.new(0.7, 0.5, 0.55),
			CFrame.new(side * 1.15, 2.75, -8.7),
			DARK,
			Enum.Material.Metal
		)
		local lens = part(
			"HeadlightLens",
			Vector3.new(0.54, 0.34, 0.06),
			CFrame.new(side * 1.15, 2.75, -9.01),
			lampColor,
			Enum.Material.Neon
		)
		lens.CastShadow = false
		local headlight = Instance.new("SpotLight")
		headlight.Name = "Headlight"
		headlight.Face = Enum.NormalId.Front
		headlight.Color, headlight.Range, headlight.Brightness, headlight.Angle = lampColor, 30, 0.45, 40
		headlight.Shadows = false
		headlight.Parent = lens
	end
	return model
end

return FishingBoat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="150">
        <Properties>
          <string name="Name">FishingService</string>
          <string name="Source"><![CDATA[-- Server-authorized shop transactions and one restored Tool per rod owner.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BoatData = require(script.Parent.BoatData)
local BoatService = require(script.Parent.BoatService)
local FishingRod = require(ReplicatedStorage.Shared.FishingRod)
local RodSkins = require(ReplicatedStorage.Shared.RodSkins)
local BobberSkins = require(ReplicatedStorage.Shared.BobberSkins)
local RodUpgrades = require(ReplicatedStorage.Shared.RodUpgrades)
local CrabCages = require(ReplicatedStorage.Shared.CrabCages)
local MusselNets = require(ReplicatedStorage.Shared.MusselNets)
local Spears = require(ReplicatedStorage.Shared.Spears)
local SpearSkins = require(ReplicatedStorage.Shared.SpearSkins)

local FishingService = {}
local states = {}
local started = false
local feedback: RemoteEvent

local function notify(player: Player, message: string)
	if player.Parent == Players then
		feedback:FireClient(player, "Notice", message)
	end
end

local function livingCharacter(player: Player): (Model?, Humanoid?, BasePart?)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil, nil, nil
	end
	return character, humanoid, root
end

-- Finn wears genuine Roblox Marketplace items, applied by HumanoidDescription.
-- Asset IDs are catalog items, not clothing-template image IDs.
local KEEPER_OUTFIT = {
	Shirt = 733260904, -- Fisherman Shirt
	Pants = 129459077, -- Black Slacks, including black shoes
	Hat = "10714423462", -- Green Fisherman Hat
	Hair = "376548738", -- Brown Charmer Hair
	Skin = Color3.fromRGB(234, 184, 146),
}
local KEEPER_PROMPT = "TalkToRodKeeperPrompt"

local function keeperDescription(): HumanoidDescription
	local description = Instance.new("HumanoidDescription")
	description.Name = "RodKeeperAppearance"
	description.Shirt, description.Pants = KEEPER_OUTFIT.Shirt, KEEPER_OUTFIT.Pants
	description.HatAccessory, description.HairAccessory = KEEPER_OUTFIT.Hat, KEEPER_OUTFIT.Hair
	local skin = KEEPER_OUTFIT.Skin
	description.HeadColor, description.TorsoColor = skin, skin
	description.LeftArmColor, description.RightArmColor = skin, skin
	description.LeftLegColor, description.RightLegColor = skin, skin
	description.BodyTypeScale, description.ProportionScale = 0, 0
	return description
end

local function keeperPrompt(head: BasePart)
	local prompt = head:FindFirstChild(KEEPER_PROMPT) :: ProximityPrompt?
	if not prompt then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = KEEPER_PROMPT
		prompt.Parent = head
	end
	local p = prompt :: ProximityPrompt
	p.ActionText = "Talk"
	p.ObjectText = "Finn · Rod Keeper"
	-- He stands behind the counter, so the prompt reaches a little further than the till's.
	p.MaxActivationDistance = 11
	p.RequiresLineOfSight = false
	p.HoldDuration = 0
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.GamepadKeyCode = Enum.KeyCode.ButtonX
	p.UIOffset = Vector2.new(0, -30)
end

-- One anchored keeper per rod hall, built only if a hall arrives without him.
local function staffRodCounter(hall: Instance)
	local frame = hall:GetAttribute("KeeperFrame")
	if typeof(frame) ~= "CFrame" or hall:GetAttribute("KeeperPending") then
		return
	end
	local existing = hall:FindFirstChild("RodKeeper")
	local existingHead = existing and existing:FindFirstChild("Head")
	if existingHead and existingHead:IsA("BasePart") then
		keeperPrompt(existingHead)
		return
	end
	hall:SetAttribute("KeeperPending", true)
	task.spawn(function()
		local description = keeperDescription()
		local ok, keeper =
			pcall(Players.CreateHumanoidModelFromDescriptionAsync, Players, description, Enum.HumanoidRigType.R15)
		description:Destroy()
		if not ok then
			warn("[Fishing] Rod keeper outfit failed to load: " .. tostring(keeper))
			-- A plain body keeps the counter staffed when the catalog is unavailable.
			local plain = Instance.new("HumanoidDescription")
			plain.HeadColor, plain.TorsoColor = KEEPER_OUTFIT.Skin, Color3.fromRGB(70, 120, 90)
			ok, keeper =
				pcall(Players.CreateHumanoidModelFromDescriptionAsync, Players, plain, Enum.HumanoidRigType.R15)
			plain:Destroy()
		end
		hall:SetAttribute("KeeperPending", nil)
		if not ok then
			warn("[Fishing] Rod keeper could not be built: " .. tostring(keeper))
			return
		end
		if not hall.Parent or hall:FindFirstChild("RodKeeper") then
			keeper:Destroy()
			return
		end
		keeper.Name = "RodKeeper"
		keeper:SetAttribute("NpcName", "Finn")
		local head = keeper:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			-- Classic faces are retired from the Marketplace; use the engine's smile.
			local face = head:FindFirstChild("face")
			if not face then
				face = Instance.new("Decal")
				face.Name, face.Parent = "face", head
			end
			if face:IsA("Decal") then
				face.Face, face.Texture = Enum.NormalId.Front, "rbxasset://textures/face.png"
			end
		end
		local humanoid = keeper:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.DisplayName = "Finn · Rod Keeper"
			humanoid.NameDisplayDistance = 28
			humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
			humanoid.WalkSpeed, humanoid.JumpPower = 0, 0
			humanoid.BreakJointsOnDeath = false
		end
		for _, part in keeper:GetDescendants() do
			if part:IsA("BasePart") then
				part.Anchored = part.Name == "HumanoidRootPart"
				part.CanCollide, part.CanTouch = false, false
				-- The server's sightline check aims at his head; hat and hair must not block it.
				part.CanQuery = part.Name == "Head"
			end
		end
		-- The pivot is the root part; it rides HipHeight above the feet. Measuring the
		-- whole model instead counts hats and hair and leaves the NPC hovering.
		local root = keeper.PrimaryPart or keeper:FindFirstChild("HumanoidRootPart")
		local lift = if humanoid and root and root:IsA("BasePart")
			then humanoid.HipHeight + root.Size.Y / 2
			else keeper:GetExtentsSize().Y / 2
		keeper:PivotTo(frame + Vector3.new(0, lift, 0))
		keeper.Parent = hall
		if head and head:IsA("BasePart") then
			keeperPrompt(head)
		end
		-- Roblox's stock R15 idle keeps him breathing instead of standing like a statue.
		local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
		if animator then
			local idle = Instance.new("Animation")
			idle.AnimationId = "rbxassetid://507766388"
			local loaded, track = pcall(animator.LoadAnimation, animator, idle)
			if loaded then
				track.Looped = true
				track:Play()
			end
		end
	end)
end

local function shopPrompt(player: Player, promptName: string): ProximityPrompt?
	local character, _, root = livingCharacter(player)
	if not character or not root then
		return nil
	end
	for _, shop in CollectionService:GetTagged("FishingRodShop") do
		if not shop:IsDescendantOf(workspace) then
			continue
		end
		local frame, size = shop:GetAttribute("InteriorFrame"), shop:GetAttribute("InteriorSize")
		if typeof(frame) ~= "CFrame" or typeof(size) ~= "Vector3" then
			continue
		end
		local position = frame:PointToObjectSpace(root.Position)
		if
			math.abs(position.X) > size.X / 2
			or math.abs(position.Y) > size.Y / 2
			or math.abs(position.Z) > size.Z / 2
		then
			continue
		end
		local prompt = shop:FindFirstChild(promptName, true)
		local part = prompt and prompt.Parent
		if not prompt or not prompt:IsA("ProximityPrompt") or not part or not part:IsA("BasePart") then
			continue
		end
		if (root.Position - part.Position).Magnitude > prompt.MaxActivationDistance + 2 then
			continue
		end
		local parameters = RaycastParams.new()
		parameters.FilterType = Enum.RaycastFilterType.Exclude
		parameters.FilterDescendantsInstances = { character }
		local head = character:FindFirstChild("Head")
		local eye = if head and head:IsA("BasePart") then head.Position else root.Position
		local result = workspace:Raycast(eye, part.Position - eye, parameters)
		if not result or result.Instance == part then
			return prompt
		end
	end
	return nil
end

-- Shop street doors and exits lead between the plaza and their interiors,
-- which stand away from the map. Stream the far side in before moving the character.
local function walkThroughDoor(player: Player, prompt: ProximityPrompt)
	local destination = prompt:GetAttribute("TeleportTo")
	local character, humanoid, root = livingCharacter(player)
	local door = prompt.Parent
	local state = states[player]
	if
		typeof(destination) ~= "CFrame"
		or not character
		or not humanoid
		or not root
		or humanoid.SeatPart
		or not state
		or not door
		or not door:IsA("BasePart")
		or (root.Position - door.Position).Magnitude > prompt.MaxActivationDistance + 4
		or os.clock() - state.lastDoor < 1.5
	then
		return
	end
	local trip = os.clock()
	state.lastDoor = trip
	feedback:FireClient(player, "DoorFade", trip)
	task.spawn(function()
		pcall(player.RequestStreamAroundAsync, player, destination.Position, 4)
		task.wait(0.25)
		if states[player] == state and character.Parent and humanoid.Health > 0 then
			character:PivotTo(destination)
			root.AssemblyLinearVelocity = Vector3.zero
		end
		-- Sent even when the move was skipped, so the client's fade always lifts.
		feedback:FireClient(player, "DoorArrived", trip)
	end)
end

local UPGRADE_FAILURES = {
	UnknownUpgrade = "Finn doesn't offer that upgrade.",
	Maxed = "That upgrade is already maxed out.",
	NoRod = "Your starter rod is still loading. Please try again shortly.",
}

local function upgradeRod(player: Player, stat: any): (boolean, string)
	if not RodUpgrades.valid(stat) then
		return false, UPGRADE_FAILURES.UnknownUpgrade
	end
	local spec = RodUpgrades.Stats[stat]
	local profile = BoatService.getProfile(player)
	if not profile then
		return false, "Your wallet is still loading. Try again in a moment."
	end
	-- Pre-check the cached profile so a rejected request never costs a save.
	local level = RodUpgrades.level(profile.RodUpgrades, stat)
	local outcome = BoatData.upgradeRod(profile, stat)
	if outcome == "InsufficientFunds" then
		local price = RodUpgrades.price(stat, level)
		return false, string.format("You need $%d for %s level %d.", price or 0, spec.Name, level + 1)
	elseif outcome ~= "Upgraded" then
		return false, UPGRADE_FAILURES[outcome] or "That upgrade isn't available."
	end
	local ok, message = BoatService.updateProgress(player, function(current)
		local result = BoatData.upgradeRod(current, stat)
		assert(result == "Upgraded", result)
	end)
	if not ok then
		return false, message
	end
	return true, string.format("%s upgraded to level %d!", spec.Name, level + 1)
end

local CRATE_PROMPT = "OpenRodCratePrompt"
local BOBBER_PROMPT = "OpenBobberCratePrompt"
local CRATE_FAILURES = {
	UnknownCrate = "Finn doesn't have that crate.",
	NoRod = "Your starter rod is still loading. Please try again shortly.",
}

-- Rolls before saving so every UpdateAsync retry awards the same skin.
local function openRodCrate(player: Player, request: any, bobber: boolean?): (boolean, string, any, number?)
	local skins = if bobber then BobberSkins else RodSkins
	local purchase = if bobber then BoatData.openBobberCrate else BoatData.openRodCrate
	local crateId = if type(request) == "table" then request.CrateId else request
	local count = if type(request) == "table" then request.Count else 1
	if count ~= 1 and count ~= 3 and count ~= 10 then
		return false, "Choose 1, 3, or 10 crates."
	end
	if not skins.validCrate(crateId) then
		return false, CRATE_FAILURES.UnknownCrate
	end
	local crate = skins.Crates[crateId]
	local profile = BoatService.getProfile(player)
	if not profile then
		return false, "Your wallet is still loading. Try again in a moment."
	end
	local rewards = {}
	local skinIds = {}
	for _ = 1, count do
		local skinId = skins.roll(crateId, math.random(), math.random())
		table.insert(skinIds, skinId)
		table.insert(rewards, { SkinId = skinId })
	end
	-- Pre-check the cached profile so a rejected request never costs a save.
	local outcome = BoatData.canOpenRodCrate(profile, crateId, skinIds[1])
	-- Bobber and rod crates have separate catalogs, but share the ownership and wallet requirements.
	if bobber then
		outcome = if not profile.OwnedRods.StarterRod then "NoRod" else "Opened"
	end
	if profile.Cash < crate.Price * count then
		outcome = "InsufficientFunds"
	end
	if outcome == "InsufficientFunds" then
		return false, string.format("You need $%d to open %d %s.", crate.Price * count, count, crate.Name)
	elseif outcome ~= "Opened" then
		return false, CRATE_FAILURES[outcome] or "That crate isn't available."
	end
	local ok, message = BoatService.updateProgress(player, function(current, reservedSerials)
		assert(current.Cash >= crate.Price * count, "InsufficientFunds")
		for index, reward in rewards do
			local result, serial =
				purchase(current, crateId, reward.SkinId, if bobber then nil else reservedSerials[index])
			assert(result == "Opened", result)
			reward.Serial = serial
		end
	end, if bobber then nil else skinIds)
	if not ok then
		return false, message
	end
	if count == 1 then
		local reward = rewards[1]
		return true, string.format("You unboxed the %s!", skins.Skins[reward.SkinId].Name), reward.SkinId, reward.Serial
	end
	return true, string.format("You unboxed %d crates!", count), rewards
end

local function buyRodCrates(player: Player, request: any): (boolean, string, string?, number?)
	local crateId = if type(request) == "table" then request.CrateId else request
	local count = if type(request) == "table" then request.Count else 1
	if not RodSkins.validCrate(crateId) then
		return false, CRATE_FAILURES.UnknownCrate
	end
	if count ~= 1 and count ~= 3 and count ~= 10 then
		return false, "Choose 1, 3, or 10 crates."
	end
	local profile = BoatService.getProfile(player)
	if not profile then
		return false, "Your wallet is still loading. Try again in a moment."
	end
	local preview = BoatData.buyRodCrates(profile, crateId, count)
	if preview == "InsufficientFunds" then
		return false, "You don't have enough coins."
	end
	if preview ~= "Purchased" then
		return false, CRATE_FAILURES[preview] or "That crate isn't available."
	end
	local ok, message = BoatService.updateProgress(player, function(current)
		assert(BoatData.buyRodCrates(current, crateId, count) == "Purchased", "Crate purchase failed")
	end)
	if not ok then
		return false, message
	end
	return true, "Crate purchased!", crateId, count
end

-- Roll before saving so UpdateAsync retries use the same reward and wear.
local function openOwnedRodCrate(player: Player, crateId: any): (boolean, string, any)
	if not RodSkins.validCrate(crateId) then
		return false, CRATE_FAILURES.UnknownCrate
	end
	local profile = BoatService.getProfile(player)
	if not profile then
		return false, "Your inventory is still loading. Try again in a moment."
	end
	if (profile.RodCrates[crateId] or 0) < 1 then
		return false, "You don't own that crate."
	end
	local skinId = RodSkins.roll(crateId, math.random(), math.random())
	local wear = math.random()
	local reward = { SkinId = skinId, Wear = wear }
	local ok, message = BoatService.updateProgress(player, function(current, serial)
		assert(BoatData.openOwnedRodCrate(current, crateId, skinId, serial, wear) == "Opened", "Crate opening failed")
		reward.Serial = serial
	end, skinId)
	if not ok then
		return false, message
	end
	return true, "You unboxed the " .. RodSkins.Skins[skinId].Name .. "!", reward
end

local SPEAR_CRATE_PROMPT = "OpenSpearCratePrompt"

local function openSpearCrate(player: Player, request: any): (boolean, string, any)
	local crateId = if type(request) == "table" then request.CrateId else request
	local count = if type(request) == "table" then request.Count else 1
	if not SpearSkins.validCrate(crateId) then
		return false, "That spear crate is unavailable."
	end
	if count ~= 1 and count ~= 3 and count ~= 10 then
		return false, "Choose 1, 3, or 10 crates."
	end
	local profile = BoatService.getProfile(player)
	if not profile then
		return false, "Your wallet is still loading. Try again in a moment."
	end
	local crate = SpearSkins.Crates[crateId]
	if profile.Cash < crate.Price * count then
		return false, "You don't have enough coins."
	end
	local rewards, ids = {}, {}
	for _ = 1, count do
		local id = SpearSkins.roll(crateId, math.random(), math.random())
		table.insert(ids, id)
		table.insert(rewards, { SkinId = id, Wear = math.random() })
	end
	local ok, message = BoatService.updateProgress(player, function(current, serials)
		for index, reward in rewards do
			assert(
				BoatData.openSpearCrate(current, crateId, reward.SkinId, serials[index], reward.Wear) == "Opened",
				"Spear crate purchase failed"
			)
			reward.Serial = serials[index]
		end
	end, nil, ids)
	if not ok then
		return false, message
	end
	if count == 1 then
		return true, "You unboxed the " .. SpearSkins.Skins[rewards[1].SkinId].Name .. "!", rewards
	end
	return true, string.format("You unboxed %d spear crates!", count), rewards
end

local function equipSpearSkin(player: Player, request: any): (boolean, string)
	local id = if type(request) == "table" then request.SkinId else request
	local serial = if type(request) == "table" then request.Serial else nil
	if id == "" then
		id = nil
	end
	if id ~= nil and not SpearSkins.valid(id) then
		return false, "That spear skin doesn't exist."
	end
	if serial ~= nil and (type(serial) ~= "number" or serial < 1 or serial % 1 ~= 0) then
		return false, "Invalid spear skin serial."
	end
	local profile = BoatService.getProfile(player)
	if not profile then
		return false, "Your inventory is still loading."
	end
	if BoatData.equipSpearSkin(profile, id, serial) ~= "Equipped" then
		return false, "You don't own that spear skin."
	end
	local ok, message = BoatService.updateProgress(player, function(current)
		assert(BoatData.equipSpearSkin(current, id, serial) == "Equipped", "Spear skin equip failed")
	end)
	if not ok then
		return false, message
	end
	return true, if id then SpearSkins.Skins[id].Name .. " equipped!" else "Starter spear look equipped."
end

local CAGE_PROMPT = "BuyCrabCagePrompt"
local NET_PROMPT = "BuyMusselNetPrompt"
local SPEAR_PROMPT = "BuySpearPrompt"

local function buySpear(player: Player): (boolean, string)
	local state = states[player]
	if not state or state.cageBusy then
		return false, "Please wait a moment and try again."
	end
	local profile = BoatService.getProfile(player)
	if not profile then
		return false, "Your wallet is still loading. Try again in a moment."
	end
	local problem = Spears.buyProblem(profile)
	if problem then
		return false, problem
	end
	state.cageBusy = true
	local ok, message = BoatService.updateProgress(player, function(current)
		Spears.buy(current)
	end)
	state.cageBusy = false
	if not ok then
		return false, message
	end
	return true, "Spear bought! Equip it from your hotbar to hunt sharks."
end

