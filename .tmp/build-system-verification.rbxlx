      <Item class="ModuleScript" referent="107">
        <Properties>
          <string name="Name">MetroSchedule</string>
          <string name="Source"><![CDATA[-- One absolute clock drives both termini, doors, indicators and passenger journeys.
local Schedule = {}
Schedule.PERIOD = 60
Schedule.OPEN = 8
Schedule.CLOSE = 26
Schedule.DEPART = 28
Schedule.TUNNEL = 36
Schedule.TRANSFER = 48
Schedule.RUN = 250
Schedule.OTHER = { Harbour = "City", City = "Harbour" }
Schedule.NAMES = { Harbour = "Gullhaven", City = "Hafen Mitte" }

function Schedule.state(now)
	local cycle = math.floor(now / Schedule.PERIOD)
	local phase = now - cycle * Schedule.PERIOD
	local offset, doors, status = 0, 0, "Boarding"
	if phase < 6 then
		local t = phase / 6
		offset, status = -Schedule.RUN * (1 - t) ^ 2, "Arriving"
	elseif phase < Schedule.OPEN then
		doors, status = (phase - 6) / 2, "Doors opening"
	elseif phase < Schedule.CLOSE then
		doors = 1
	elseif phase < Schedule.DEPART then
		doors, status = 1 - (phase - Schedule.CLOSE) / 2, "Doors closing"
	elseif phase < Schedule.TUNNEL then
		offset, status = Schedule.RUN * ((phase - Schedule.DEPART) / 8) ^ 2, "Departing"
	else
		offset, status = Schedule.RUN, "Next train"
	end
	return {
		cycle = cycle, phase = phase, offset = offset, doors = doors, status = status,
		boarding = phase >= Schedule.OPEN and phase < Schedule.CLOSE,
		visible = phase < Schedule.TUNNEL,
		seconds = math.ceil(if phase < Schedule.CLOSE then Schedule.CLOSE - phase else Schedule.PERIOD - phase),
	}
end

function Schedule.frame(dock, now)
	return dock * CFrame.new(Schedule.state(now).offset, 0, 0)
end

function Schedule.darkness(now, departure)
	-- Finish the fade while the doors close, before the carriage can leave
	-- the station shell. Stay covered across the clock wrap and until Arrive.
	return math.clamp((now - departure) / (Schedule.DEPART - Schedule.CLOSE), 0, 1)
end

function Schedule.inside(position)
	-- Door thresholds are excluded; a passenger must actually be inside a carriage.
	if math.abs(position.Z) > 4.7 or position.Y < 0 or position.Y > 9 then return false end
	for _, x in { -46, 0, 46 } do
		if math.abs(position.X - x) < 21.5 then return true end
	end
	return false
end

return Schedule
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="108">
        <Properties>
          <string name="Name">MetroTrain</string>
          <string name="Source"><![CDATA[-- Three walk-through cars. The server builds a small invisible collision hull;
-- clients build the detailed body and animate it from MetroSchedule without replication spam.
local Train = {}
local V, rgb, M = Vector3.new, Color3.fromRGB, Enum.Material
local CREAM, TEAL = rgb(239, 231, 209), rgb(35, 88, 81)
local DARK, RED = rgb(29, 38, 40), rgb(152, 62, 44)
local poses = setmetatable({}, { __mode = "k" })

function Train.build(parent, dock, collisionOnly)
	local model = Instance.new("Model")
	model.Name = if collisionOnly then "TrainCollision" else "LineOneTrain"
	model:SetAttribute("LodSkip", true)
	local doors = {}
	local function p(name, x, y, z, w, h, d, color, material, solid)
		local part = Instance.new("Part")
		part.Name, part.Size = name, V(w, h, d)
		part.CFrame = dock * CFrame.new(x, y, z)
		part.Anchored, part.CanTouch = true, false
		part.CanCollide = collisionOnly and solid == true
		part.CanQuery = collisionOnly
		part.Color, part.Material = color or CREAM, material or M.Metal
		part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		part.Transparency = if collisionOnly then 1 else 0
		part.CastShadow = not collisionOnly
		part.Parent = model
		return part
	end
	local function label(part, words, face)
		local gui = Instance.new("SurfaceGui")
		gui.Face, gui.PixelsPerStud = face or Enum.NormalId.Front, 32
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.Parent = part
		local text = Instance.new("TextLabel")
		text.Size, text.BackgroundTransparency = UDim2.fromScale(1, 1), 1
		text.Text, text.TextColor3, text.TextScaled = words, CREAM, true
		text.Font, text.Parent = Enum.Font.GothamMedium, gui
	end
	for _, cx in { -46, 0, 46 } do
		p("CarriageFloor", cx, -0.35, 0, 44, 0.7, 10, DARK, M.Metal, true)
		p("CarriageRoof", cx, 9.4, 0, 44.6, 0.8, 10.6, TEAL, M.Metal, true)
		for _, side in { -1, 1 } do
			local z = side * 5
			-- Solid wall runs stop at the two real door openings.
			for _, run in { { -22, -13.8 }, { -8.2, 8.2 }, { 13.8, 22 } } do
				local x, width = cx + (run[1] + run[2]) / 2, run[2] - run[1]
				p("LowerBody", x, 1.7, z, width, 3.4, 0.35, TEAL, M.Metal, true)
				local window = p("WindowGlass", x, 5.45, z, width, 4.1, 0.28, rgb(75, 112, 118), M.Glass, true)
				if not collisionOnly then window.Transparency = 0.38 end
			end
			p("UpperBody", cx, 8.4, z, 44, 1.8, 0.4, CREAM, M.Metal, true)
			for _, dx in { -11, 11 } do
				-- Meet the floor edge without laying a second face over its top.
				p("DoorThreshold", cx + dx, -0.18, side * 5.65, 5.6, 0.36, 1.3, DARK, M.Metal, true)
				for _, half in { -1, 1 } do
					local door = p("SlidingDoor", cx + dx + half * 1.4, 3.8, z - side * 0.15, 2.76, 7.6, 0.3, RED, M.Metal, true)
					table.insert(doors, { part = door, closed = dock:ToObjectSpace(door.CFrame), direction = half })
					if not collisionOnly then
						local glass = p("DoorWindow", cx + dx + half * 1.4, 5.15, z + side * 0.04, 1.9, 3.25, 0.14, rgb(52, 82, 88), M.Glass)
						table.insert(doors, { part = glass, closed = dock:ToObjectSpace(glass.CFrame), direction = half })
					end
				end
			end
		end
		for _, dx in { -21.7, 21.7 } do
			-- End bulkheads leave a gangway between cars.
			-- The outer cabs already provide their own complete end wall.
			if math.abs(cx + dx) > 67 then continue end
			for _, side in { -1, 1 } do
				p("EndBulkhead", cx + dx, 4.5, side * 3.4, 0.4, 9, 3.2, CREAM, M.Metal, true)
			end
		end
		if not collisionOnly then
			p("InteriorCeiling", cx, 8.88, 0, 42, 0.18, 9.3, CREAM)
			p("CeilingLight", cx, 8.74, 0, 36, 0.12, 0.55, rgb(255, 229, 178), M.Neon)
			for _, side in { -1, 1 } do
				for _, dx in { -18, 0, 18 } do
					local width = if dx == 0 then 12 else 5
					p("SeatCushion", cx + dx, 1.9, side * 3.55, width, 0.55, 2, RED, M.Fabric)
					p("SeatBack", cx + dx, 3.175, side * 4.35, width, 2, 0.4, RED, M.Fabric)
					for sx = -width / 2 + 1, width / 2, 2 do
						p("SeatSeam", cx + dx + sx, 1.93, side * 3.55, 0.08, 0.6, 1.95, rgb(125, 47, 37))
					end
				end
				for _, dx in { -7.7, 7.7 } do
					p("GrabPole", cx + dx, 4.4, side * 2.5, 0.15, 8.6, 0.15, rgb(183, 163, 114))
				end
				local route = p("InteriorRouteMap", cx, 7.7, side * 4.73, 11, 0.75, 0.1, TEAL)
				label(route, "1  GULLHAVEN  ──  HAFEN MITTE", if side < 0 then Enum.NormalId.Back else Enum.NormalId.Front)
				for _, dx in { -20, -15, -6, 0, 6, 15, 20 } do
					p("WindowMullion", cx + dx, 5.5, side * 5.2, 0.16, 4.1, 0.12, CREAM)
				end
				p("CoachWaistStripe", cx, 3.5, side * 5.24, 44, 0.16, 0.1, rgb(192, 155, 82))
			end
			for _, dx in { -15.5, 15.5 } do
				p("BogieFrame", cx + dx, -1.55, 0, 7, 1.3, 7.6, DARK)
				for _, axle in { -2, 2 } do
					local wheel = p("WheelAxle", cx + dx + axle, -1.8, 0, 1.9, 1.9, 8.4, DARK)
					wheel.Shape = Enum.PartType.Cylinder
					wheel.Size = V(8.4, 1.9, 1.9)
					wheel.CFrame *= CFrame.Angles(0, math.pi / 2, 0)
				end
			end
			p("RoofVent", cx, 10, 0, 12, 0.5, 4, rgb(103, 117, 113))
		end
	end
	for _, x in { -23, 23 } do
		p("GangwayFloor", x, -0.35, 0, 2, 0.7, 4, DARK, M.Metal, true)
	end
	for _, side in { -1, 1 } do
		p("CabEnd", side * 68, 4.5, 0, 0.4, 9, 10, TEAL, M.Metal, true)
		if not collisionOnly then
			p("CabWindscreen", side * 68.26, 5.7, 0, 0.12, 3.9, 7.6, rgb(35, 54, 60), M.Glass)
			local destination = p("DestinationDisplay", side * 68.3, 8.25, 0, 0.16, 1, 7.5, DARK)
			label(destination, "1  GULLHAVEN ↔ HAFEN MITTE", if side > 0 then Enum.NormalId.Right else Enum.NormalId.Left)
			for _, z in { -3.6, 3.6 } do
				p("CabLight", side * 68.35, 2.15, z, 0.18, 0.7, 0.9, if side > 0 then rgb(255, 233, 171) else RED, M.Neon)
			end
		end
	end
	model.WorldPivot = dock
	-- Cache the finished geometry (including rotated wheels). A moving train
	-- gets one engine call, and parked trains only move their sliding doors.
	local parts, closed, frames, doorParts, doorFrames = {}, {}, {}, {}, {}
	local doorIndices = {}
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			table.insert(parts, part)
			table.insert(closed, dock:ToObjectSpace(part.CFrame))
			doorIndices[part] = #parts
		end
	end
	for index, door in doors do
		doorParts[index] = door.part
	end
	-- Key by the caller's door list, which the cache itself never retains.
	-- Dropping a streamed-out train also releases its cached part references.
	poses[doors] = {
		parts = parts, closed = closed, frames = frames,
		doorParts = doorParts, doorFrames = doorFrames, doorIndices = doorIndices,
		frame = dock, open = 0,
	}
	model.Parent = parent
	return model, doors
end

function Train.pose(model, doors, frame, open)
	local pose = poses[doors]
	if pose.frame == frame and pose.open == open then return end
	local moving = pose.frame ~= frame
	local parts, frames = pose.doorParts, pose.doorFrames
	if moving then
		parts, frames = pose.parts, pose.frames
		for index, closed in pose.closed do
			frames[index] = frame * closed
		end
	end
	for index, door in doors do
		local target = if moving then pose.doorIndices[door.part] else index
		frames[target] = frame * door.closed * CFrame.new(door.direction * open * 2.7, 0, 0)
	end
	debug.profilebegin("Metro/Pose")
	workspace:BulkMoveTo(parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
	debug.profileend()
	model.WorldPivot = frame
	pose.frame, pose.open = frame, open
end

return Train
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="109">
        <Properties>
          <string name="Name">MusselNets</string>
          <string name="Source"><![CDATA[-- Shared rules for mussel nets, saved in dock-local coordinates like crab cages.
local MusselNets = {}

MusselNets.PRICE = 125
MusselNets.USES = 5
-- Each harvest is ready in three to five minutes.
MusselNets.SOAK_MIN, MusselNets.SOAK_MAX = 180, 300
MusselNets.MAX_STOCK = 25
MusselNets.MAX_PLACED = 6
MusselNets.SPACING = 4.5 -- studs between neighbouring nets
MusselNets.REACH = 16 -- studs from the angler to where the net lands
MusselNets.MIN_HARVEST = 2
MusselNets.MAX_HARVEST = 5
-- Water round the base's piers in dock-local studs (BoatDockFrame: -Z is the
-- water, the piers run along x = +-17 from z = 5 to -43). It stops short of the
-- fisherman's moorings at x = +-28 and the boat spawn past the pier ends.
MusselNets.ZONE = { MinX = -24, MaxX = 24, MinZ = -42, MaxZ = 6 }
-- What a net can catch. FishCatch.roll weighs these by rarity like any pool;
-- no fishing pool lists them, so mussels only ever come from nets.
MusselNets.Pool = { Name = "Mussel Net", Fish = { "BlueMussel", "GreenMussel", "GoldenMussel", "Kelp", "SeaLettuce" } }

-- Spots are kept to a tenth of a stud, so a net's saved spot doubles as its id.
function MusselNets.round(value: number): number
	return math.round(value * 10) / 10
end

-- Cage-local points that must all be open water: the middle, the corners with a
-- little clearance and the marker float beside it. `size` is the net's size.
-- Builds Vector3s, so only call it in Roblox.
function MusselNets.footprint(size: Vector3): { Vector3 }
	local half = size / 2 + Vector3.new(0.4, 0, 0.4)
	return {
		Vector3.zero,
		Vector3.new(half.X, 0, half.Z),
		Vector3.new(-half.X, 0, half.Z),
		Vector3.new(half.X, 0, -half.Z),
		Vector3.new(-half.X, 0, -half.Z),
		Vector3.new(size.X / 2 + 0.3, 0, 0.3),
	}
end

-- `rng` returns a uniform [0, 1). Whole seconds, both ends included.
function MusselNets.soak(rng: () -> number): number
	return MusselNets.SOAK_MIN + math.floor(rng() * (MusselNets.SOAK_MAX - MusselNets.SOAK_MIN + 1))
end

function MusselNets.find(angler, x: number, z: number): (number?, any)
	for index, net in angler.MusselNets.Placed do
		if math.abs(net.X - x) < 0.05 and math.abs(net.Z - z) < 0.05 then
			return index, net
		end
	end
	return nil, nil
end

-- `profile` is the whole wallet profile: the price comes out of its Cash.
function MusselNets.buyProblem(profile): string?
	if profile.Angler.MusselNets.Stock >= MusselNets.MAX_STOCK then
		return string.format("You can carry up to %d mussel nets. Set some out first.", MusselNets.MAX_STOCK)
	elseif profile.Cash < MusselNets.PRICE then
		return string.format("You need $%d for a mussel net.", MusselNets.PRICE)
	end
	return nil
end

-- These mutate the table they are given: the profile copy inside a save.
function MusselNets.buy(profile)
	local problem = MusselNets.buyProblem(profile)
	assert(problem == nil, problem)
	profile.Cash -= MusselNets.PRICE
	profile.Angler.Stats.CoinsSpent += MusselNets.PRICE
	profile.Angler.MusselNets.Stock += 1
end

-- Only the dock-local spot; the server also checks there is open water there.
function MusselNets.zoneProblem(x: number, z: number): string?
	local zone = MusselNets.ZONE
	if x ~= x or z ~= z or x < zone.MinX or x > zone.MaxX or z < zone.MinZ or z > zone.MaxZ then
		return "Drop mussel nets in the water by your own dock."
	end
	return nil
end

function MusselNets.placeProblem(angler, x: number, z: number): string?
	local nets = angler.MusselNets
	if nets.Stock < 1 then
		return "You have no mussel nets. Buy one at Tide & Tackle."
	elseif #nets.Placed >= MusselNets.MAX_PLACED then
		return string.format("You already have %d nets out. Pull one up first.", MusselNets.MAX_PLACED)
	end
	local problem = MusselNets.zoneProblem(x, z)
	if problem then
		return problem
	end
	x, z = MusselNets.round(x), MusselNets.round(z)
	local neighbours = table.clone(nets.Placed)
	for _, other in (angler.CrabCages and angler.CrabCages.Placed or {}) do
		table.insert(neighbours, other)
	end
	for _, net in neighbours do
		if (net.X - x) ^ 2 + (net.Z - z) ^ 2 < MusselNets.SPACING ^ 2 then
			return "That's too close to another net or cage."
		end
	end
	return nil
end

-- `soak` is rolled before saving, so every save retry sets the same timer.
function MusselNets.place(angler, x: number, z: number, now: number, soak: number)
	local problem = MusselNets.placeProblem(angler, x, z)
	assert(problem == nil, problem)
	angler.MusselNets.Stock -= 1
	table.insert(angler.MusselNets.Placed, {
		X = MusselNets.round(x),
		Z = MusselNets.round(z),
		Uses = MusselNets.USES,
		ReadyAt = now + soak,
	})
end

-- Seconds until a mussel is in, or 0 once the net is ready to pull up.
function MusselNets.remaining(net, now: number): number
	return math.max(0, net.ReadyAt - now)
end

function MusselNets.collectProblem(angler, x: number, z: number, now: number): string?
	local _, net = MusselNets.find(angler, x, z)
	if not net then
		return "That mussel net is gone."
	elseif now < net.ReadyAt then
		return "The net isn't ready yet. Give it a moment."
	end
	return nil
end

-- Returns the hauls the net has left. At 0 it has worn out and is removed.
function MusselNets.collect(angler, x: number, z: number, now: number, soak: number): number
	local problem = MusselNets.collectProblem(angler, x, z, now)
	assert(problem == nil, problem)
	local index, net = MusselNets.find(angler, x, z)
	angler.Stats.MusselNetsOpened += 1
	net.Uses -= 1
	if net.Uses <= 0 then
		table.remove(angler.MusselNets.Placed, index)
		return 0
	end
	net.ReadyAt = now + soak
	return net.Uses
end

return MusselNets
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="110">
        <Properties>
          <string name="Name">MutationContext</string>
          <string name="Source"><![CDATA[-- Server-side catch context from the validated location and catch owner.
local Calendar = require(script.Parent.Calendar)
local Halloween = require(script.Parent.Halloween)
local Seasons = require(script.Parent.Seasons)
local CatchConditions = require(script.Parent.CatchConditions)
local Weather = require(script.Parent.Weather)
local MutationContext = {}
function MutationContext.at(position: Vector3, player: Player)
 local context = Weather.mutationContext(position) or {}
 local date = Calendar.now()
 context.season = Seasons.current()
 context.halloween = Halloween.partyActive(date)
 context.volcanic = CatchConditions.area(position) == "volcanic"
 context.supercell = Weather.supercellCover(position, Weather.supercell()) >= Weather.SupercellThreshold
 context.level = player:GetAttribute("Level") or 0
 return context
end
return MutationContext
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="111">
        <Properties>
          <string name="Name">Paths</string>
          <string name="Source"><![CDATA[-- Business paths shown on the Home ▸ Paths tab. A player starts as a fish shop and
-- grows the business one stage at a time; stages stack, so every earlier stage keeps
-- working. The active stage must reach 100% (every goal done) before the next one
-- can be bought. Pure: no Roblox services, so the server, the menu and the saved-data
-- tests all read the same rules. See docs/PATHS.md for adding goals and stages.
local Paths = {}

-- Road order. A stage's Requires must all be completed before it can be chosen, so
-- Restaurant and Company both open after Supermarket and the player picks one first.
Paths.Order = { "Fishshop", "Supermarket", "Restaurant", "Company" }
Paths.FIRST = "Fishshop"
Paths.SKIP_PRODUCT_ID = 3722698836

-- Goal kinds (see docs/PATHS.md):
--   Stat      Stats[Stat] gained since the stage started reaches Target.
--   Staff     Staff[Role] is hired.
--   Furniture at least Target of Item are placed in the house.
--   Boat      the boat Boat is owned.
--   Upgrade   Angler.Upgrades[Upgrade] is at least Target (home upgrades, once added).
--   RodUpgrade the rod stat Upgrade is at least level Target.
Paths.Stages = {
	Fishshop = {
		Name = "Fish Shop",
		Tagline = "Where it all begins",
		Description = "Sell the raw fish you catch from your freezer to walk-in customers.",
		Price = 0,
		Requires = {},
		Features = { "Sell raw fish from your freezers", "Hire a Seller and a Porter" },
		Goals = {
			{ Kind = "Stat", Stat = "FishSold", Target = 25, Text = "Sell %d fish to customers" },
			{ Kind = "Stat", Stat = "CoinsEarned", Target = 2500, Money = true, Text = "Earn $%s" },
			{ Kind = "Staff", Role = "Seller", Text = "Hire a Seller" },
			{ Kind = "Staff", Role = "Porter", Text = "Hire a Porter" },
		},
	},
	Supermarket = {
		Name = "Fish Supermarket",
		Tagline = "Raw fish and ready meals",
		Description = "Cook fish into dishes on the kitchen benches in your processing room. "
			.. "Customers buy dishes from food display cases as well as raw fish.",
		Price = 1000,
		Requires = { "Fishshop" },
		Features = {
			"Two prep benches in your processing room",
			"Buy grill, smokehouse and sushi stations for pricier recipes",
			"Food display cases sell dishes in the shop",
		},
		-- Given once when the stage is bought, waiting in build mode.
		Grants = { FoodCase = 1 },
		Goals = {
			{ Kind = "Stat", Stat = "FoodCooked", Target = 20, Text = "Cook %d dishes" },
			{ Kind = "Stat", Stat = "FoodSold", Target = 15, Text = "Sell %d dishes in your shop" },
			{ Kind = "Furniture", Item = "FoodCase", Target = 1, Text = "Place a food display case" },
			{ Kind = "Furniture", Item = "GrillStation", Target = 1, Text = "Set up a grill station" },
			{ Kind = "Stat", Stat = "CoinsEarned", Target = 10000, Money = true, Text = "Earn $%s" },
		},
	},
	Restaurant = {
		Name = "The Restaurant",
		Tagline = "Fine dining by the water",
		Description = "A dining room opens behind your house. Diners sit down, order one specific "
			.. "dish and pay more than shop prices when you serve it.",
		Price = 3000,
		Requires = { "Supermarket" },
		Features = { "A dining room extension behind your house", "Diners pay 1.5x for the dish they order", "Hire a chef" },
		Grants = { DiningTable = 2 },
		Goals = {
			{ Kind = "Stat", Stat = "DinersServed", Target = 25, Text = "Serve %d diners" },
			{ Kind = "Furniture", Item = "DiningTable", Target = 4, Text = "Place %d dining tables" },
			{ Kind = "Furniture", Item = "SushiBar", Target = 1, Text = "Set up a sushi bar" },
			{ Kind = "Stat", Stat = "CoinsEarned", Target = 25000, Money = true, Text = "Earn $%s" },
		},
	},
	Company = {
		Name = "The Company",
		Tagline = "Let the crew do the fishing",
		Description = "Hire a fisherman who takes one of your boats onto the water and fishes on his own. "
			.. "He brings the catch home for your porter to unload.",
		Price = 4000,
		Requires = { "Supermarket" },
		Features = {
			"Hire a fisherman",
			"Buy a private island for $50,000: large dock, storage, kitchen and office",
			"Assign him one of your boats",
			"Hire a chef",
			"Buy the harbour tugboat at the shipyard",
		},
		Goals = {
			{ Kind = "Staff", Role = "Fisherman", Text = "Hire a Fisherman" },
			{ Kind = "Stat", Stat = "FishermanCatches", Target = 50, Text = "Your fisherman lands %d fish" },
			{ Kind = "Boat", Boat = "FishingBoat", Text = "Own a small fishing boat" },
			{ Kind = "Stat", Stat = "CoinsEarned", Target = 40000, Money = true, Text = "Earn $%s" },
		},
	},
}

local function commas(value: number): string
	local text = tostring(math.floor(value))
	while true do
		local replaced, count = string.gsub(text, "^(-?%d+)(%d%d%d)", "%1,%2")
		text = replaced
		if count == 0 then
			return text
		end
	end
end

-- The saved path state, filled in for profiles from before paths existed.
function Paths.state(angler)
	local saved = angler and angler.Paths
	return {
		Active = if saved and saved.Active then saved.Active else Paths.FIRST,
		Unlocked = if saved and saved.Unlocked then saved.Unlocked else { [Paths.FIRST] = true },
		Completed = if saved and saved.Completed then saved.Completed else {},
		Baseline = if saved and saved.Baseline then saved.Baseline else {},
		SkipCredits = if saved and saved.SkipCredits then saved.SkipCredits else 0,
	}
end

-- Accepts a whole wallet profile or just its Angler table.
local function anglerOf(profile)
	return if profile and profile.Angler then profile.Angler else profile
end

function Paths.unlocked(profile, stageId: string): boolean
	return Paths.state(anglerOf(profile)).Unlocked[stageId] == true
end

function Paths.goalText(goal): string
	local target = goal.Target or 1
	return string.format(goal.Text, if goal.Money then commas(target) else tostring(target))
end

-- Current and target counts for one goal of the active stage.
function Paths.goalProgress(goal, profile): (number, number)
	local angler = anglerOf(profile)
	local state = Paths.state(angler)
	local target = goal.Target or 1
	local current = 0
	if goal.Kind == "Stat" then
		local stats = angler and angler.Stats or {}
		current = (stats[goal.Stat] or 0) - (state.Baseline[goal.Stat] or 0)
	elseif goal.Kind == "Staff" then
		current = if angler and angler.Staff and angler.Staff[goal.Role] then 1 else 0
	elseif goal.Kind == "Furniture" then
		for _, entry in angler and angler.Furniture or {} do
			if entry.ItemId == goal.Item then
				current += 1
			end
		end
	elseif goal.Kind == "Boat" then
		current = if profile and profile.OwnedBoats and profile.OwnedBoats[goal.Boat] then 1 else 0
	elseif goal.Kind == "Upgrade" then
		current = angler and angler.Upgrades and angler.Upgrades[goal.Upgrade] or 0
	elseif goal.Kind == "RodUpgrade" then
		current = profile and profile.RodUpgrades and profile.RodUpgrades[goal.Upgrade] or 0
	end
	return math.clamp(current, 0, target), target
end

-- 0..1 for a stage: completed stages are 1, locked ones 0 and the active one the
-- average of its goals, so it is exactly 1 only when every goal is done.
function Paths.progress(profile, stageId: string): number
	local state = Paths.state(anglerOf(profile))
	if state.Completed[stageId] then
		return 1
	elseif state.Active ~= stageId then
		return 0
	end
	local goals = Paths.Stages[stageId].Goals
	if #goals == 0 then
		return 1
	end
	local total = 0
	for _, goal in goals do
		local current, target = Paths.goalProgress(goal, profile)
		total += if current >= target then 1 else current / target
	end
	local average = total / #goals
	-- Rounding must never show 100% while a goal is still open.
	for _, goal in goals do
		local current, target = Paths.goalProgress(goal, profile)
		if current < target then
			return math.min(average, 0.99)
		end
	end
	return 1
end

-- Potential next stages, including while the current quests are unfinished.
function Paths.nextStages(profile): { string }
	local state = Paths.state(anglerOf(profile))
	local result = {}
	for _, id in Paths.Order do
		if not state.Unlocked[id] then
			local ready = true
			for _, required in Paths.Stages[id].Requires do
				if required ~= state.Active and not state.Completed[required] then
					ready = false
				end
			end
			if ready then
				table.insert(result, id)
			end
		end
	end
	return result
end

-- Stages that can be chosen once the active one is finished or skipped.
function Paths.choices(profile): { string }
	local state = Paths.state(anglerOf(profile))
	return if Paths.progress(profile, state.Active) >= 1 then Paths.nextStages(profile) else {}
end

function Paths.skipProblem(profile, stageId: any): string?
	local state = Paths.state(anglerOf(profile))
	if type(stageId) ~= "string" or stageId ~= state.Active then
		return "Your active path changed. Reopen the Paths tab."
	elseif Paths.progress(profile, stageId) >= 1 then
		return "These quests are already complete. You still need money to open the next path."
	elseif #Paths.nextStages(profile) == 0 then
		return "There are no more path levels to unlock."
	end
	return nil
end

function Paths.skipWarning(profile): string
	local prices = {}
	for _, id in Paths.nextStages(profile) do
		table.insert(prices, Paths.Stages[id].Name .. ": $" .. commas(Paths.Stages[id].Price))
	end
	return "Warning: this skips quests only. You still need in-game money to open the next path"
		.. (if #prices > 0 then " (" .. table.concat(prices, " or ") .. ")." else ".")
end

-- nil when `stageId` can be bought now, otherwise a player-facing reason.
function Paths.chooseProblem(profile, stageId: any): string?
	local stage = if type(stageId) == "string" then Paths.Stages[stageId] else nil
	if not stage then
		return "Choose a path from the Paths tab."
	end
	local state = Paths.state(anglerOf(profile))
	if state.Unlocked[stageId] then
		return "You already run " .. stage.Name .. "."
	elseif Paths.progress(profile, state.Active) < 1 then
		return "Finish " .. Paths.Stages[state.Active].Name .. " to 100% first."
	elseif not table.find(Paths.choices(profile), stageId) then
		return stage.Name .. " isn't open yet."
	elseif (profile.Cash or 0) < stage.Price then
		return "You need $" .. commas(stage.Price) .. " for " .. stage.Name .. "."
	end
	return nil
end

-- Every stage is unlocked and the last one is finished.
function Paths.finished(profile): boolean
	local state = Paths.state(anglerOf(profile))
	for _, id in Paths.Order do
		if not state.Unlocked[id] then
			return false
		end
	end
	return Paths.progress(profile, state.Active) >= 1
end

Paths.commas = commas

return Paths
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="112">
        <Properties>
          <string name="Name">PirateCove</string>
          <string name="Source"><![CDATA[-- Pirate Cove: a tropical trading island in the Coral Shallows, between home and the lagoon. Its
-- crew hand out quests, a rod trader sells basic rods outright, and the galley buys fish straight
-- from your hand and backpack, up to DAILY_SALES a day. Pure data and rules, so the server, the
-- client and the tests share them. Spots are island-local (x, z) offsets from CENTER (north is -Z);
-- colours are { r, g, b } because this module also loads outside Roblox.

local PirateCove = {}

PirateCove.NAME = "Pirate Cove"
-- World X/Z of the island's middle: inside the Coral Shallows, clear of its central atoll.
PirateCove.CENTER = { -650, 2150 }
PirateCove.RADIUS = 170
-- How close the server requires a player to stand to the crew member they deal with.
PirateCove.TALK_RANGE = 18

-- The galley feeds the whole cove; past this many fish a day it has all it needs.
PirateCove.DAILY_SALES = 15
-- One in-game day (DayNight runs a day every 24 real minutes).
PirateCove.DAY_SECONDS = 24 * 60

-- Rods the trader sells outright. Every one is an ordinary RodSkins copy in Field-Tested wear:
-- second-hand, but honest.
PirateCove.ROD_WEAR = 0.25
PirateCove.Rods = {
	{ SkinId = "BambooRod", Price = 500 },
	{ SkinId = "UmbrellaRod", Price = 500 },
	{ SkinId = "PencilRod", Price = 650 },
	{ SkinId = "BaseballRod", Price = 750 },
	{ SkinId = "MusketRod", Price = 2000 },
}

-- Rarity order for "bring me anything this rare" quests (matches AnglerCatalog.Rarities).
local RARITY_ORDER = {
	Junk = 0,
	Common = 1,
	Uncommon = 2,
	Rare = 3,
	Epic = 4,
	Legendary = 5,
	Mythical = 6,
	Exotic = 7,
	Divine = 8,
	Limited = 9,
}

-- Kind "Shop" opens the rod trader, "Buyer" the galley; everyone else gives quests.
PirateCove.Npcs = {
	Hale = {
		Name = "Captain Morwenna Hale",
		Title = "Cove Captain",
