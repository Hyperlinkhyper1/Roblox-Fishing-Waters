      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">BoatDrive</string>
          <string name="Source"><![CDATA[-- The helm's per-step mover targets for a launched hull: buoyancy on the swell, banking,
-- heading and drive. The server runs them for hulls it simulates (coasting, tornadoes,
-- nobody at the helm); the driver's client runs the same code for its own hull, so the
-- helm answers at once and the boat is never a replica waiting on the network.
local Biomes = require(script.Parent.Biomes)
local BoatMotion = require(script.Parent.BoatMotion)
local Weather = require(script.Parent.Weather)

local BoatDrive = {}

-- The waterline target looks this far ahead along the hull's motion, so the soft
-- suspension starts rising before the bow reaches a crest instead of after.
local WAVE_LEAD_SECONDS = 0.12
-- At full speed the hull spans this much more water: planing boats skim chop.
local PLANING_STRETCH = 0.5

-- Spec fields the drive reads. The server publishes them on the hull (as Drive<Field>
-- attributes) because refits tune them per player.
BoatDrive.FIELDS = {
	"ForwardSpeed",
	"ReverseSpeed",
	"Acceleration",
	"BrakeDeceleration",
	"CoastDeceleration",
	"TurnRate",
	"TurnAcceleration",
	"IdleSteering",
	"MaxBankAngle",
	"Length",
	"Beam",
}

function BoatDrive.waterAhead(boat, direction: Vector3): boolean
	local parameters = RaycastParams.new()
	-- Only terrain can tell us whether the water ends. Docks, floating objects,
	-- and other boats are handled by physical collisions instead of the drive.
	parameters.FilterType = Enum.RaycastFilterType.Include
	parameters.FilterDescendantsInstances = { workspace.Terrain }
	parameters.IgnoreWater = false
	parameters.RespectCanCollide = true
	local position = boat.root.Position + direction * (boat.spec.Length / 2 + 2)
	-- The sea ends at the ocean bounds even where the ray below finds nothing: past them is
	-- empty sky, and the admin-only scale models beyond (ScaleModels) must stay out of reach.
	if not Biomes.inOceanBounds(Vector3.new(position.X, Biomes.WaterLevel, position.Z)) then
		return false
	end
	local result = workspace:Raycast(
		Vector3.new(position.X, Biomes.WaterLevel + 14, position.Z),
		Vector3.new(0, -32, 0),
		parameters
	)
	-- A missed ray is inconclusive (for example at a water voxel boundary).
	return result == nil or result.Material == Enum.Material.Water
end

function BoatDrive.updateSuspension(boat)
	local mass = boat.root.AssemblyMass
	local gravity = workspace.Gravity
	-- Cancel the assembly's weight separately so soft alignment does not need
	-- a permanent height error to hold up the hull and its seated passengers.
	boat.lift.Force = Vector3.new(0, mass * gravity, 0)
	boat.float.MaxAxesForce = Vector3.new(0, mass * (gravity + 100) * 4, 0)
	-- Allow acceleration, braking, turning and water drag, but let solid contacts
	-- stop the hull rather than asking the solver for unlimited collision force.
	local spec = boat.spec
	boat.velocity.MaxForce = mass
		* (math.max(spec.Acceleration, spec.BrakeDeceleration) + spec.ForwardSpeed * spec.TurnRate + gravity * 0.25)
	-- Approximate hull inertia; keep righting torque proportional to hull size
	-- without the oversized gravity-based torque that pried boats off obstacles.
	boat.heading.MaxTorque = mass * (spec.Length ^ 2 + spec.Beam ^ 2) / 12 * 20
	boat.heading.MaxAngularVelocity = spec.TurnRate + 2
end

-- Steers the movers for one physics step, given the speed and turn BoatMotion.step chose.
-- Returns the weather state so callers driving several hulls sample it once.
function BoatDrive.apply(
	boat,
	speed: number,
	turn: number,
	throttle: number,
	steer: number,
	dt: number,
	serverTime: number,
	weather
)
	boat.turn = turn
	local root = boat.root
	local actualForward = root.CFrame.LookVector
	actualForward = Vector3.new(actualForward.X, 0, actualForward.Z)
	actualForward = if actualForward.Magnitude > 0.0001
		then actualForward.Unit
		else CFrame.Angles(0, boat.yaw, 0).LookVector
	-- Like a real boat (or car), reversing mirrors the steering direction.
	local yawRateCommand = -turn * (if speed < 0 then -1 else 1)
	local actualYaw = math.atan2(-actualForward.X, -actualForward.Z)
	if math.abs(steer) < 0.08 then
		boat.yaw = actualYaw
	end
	boat.yaw = BoatMotion.advanceHeading(boat.yaw, actualYaw, yawRateCommand, dt)
	-- Seat welds change assembly mass when passengers board or leave.
	BoatDrive.updateSuspension(boat)
	local flatHeading = CFrame.Angles(0, boat.yaw, 0)
	local motion = root.AssemblyLinearVelocity
	motion = Vector3.new(motion.X, 0, motion.Z)
	local planing = math.clamp(math.abs(speed) / boat.spec.ForwardSpeed, 0, 1)
	weather = weather or Weather.getState(serverTime)
	local wave = Weather.hullSample(
		root.Position + motion * WAVE_LEAD_SECONDS,
		flatHeading.LookVector,
		boat.spec.Length * 0.4 * (1 + PLANING_STRETCH * planing),
		boat.spec.Beam * 0.4,
		serverTime,
		weather,
		-- Ride the visible surface: crests are drawn by the client swell mesh,
		-- troughs are hidden beneath Terrain's flat water.
		0
	)
	-- Riding a swell at speed climbs far faster than bobbing in place: a fixed
	-- 6 stud/s cap left fast hulls under each oncoming crest, bow first.
	boat.float.MaxVelocity = 6 + motion.Magnitude * 0.5
	local yawRate = root.AssemblyAngularVelocity.Y
	local bankYawRate = -BoatMotion.steering(speed, steer, boat.spec) * (if speed < 0 then -1 else 1)
	boat.bank, boat.bankVelocity = BoatMotion.bank(
		boat.bank,
		boat.bankVelocity,
		root.AssemblyLinearVelocity:Dot(actualForward),
		bankYawRate,
		boat.spec,
		workspace.Gravity,
		dt
	)
	-- Project the chosen heading onto the wave plane. Sampling a shared
	-- normal keeps pitch and roll correct at every heading, including
	-- when the same hull moves between the sheltered lake and open sea.
	local normal = wave.normal
	local forward = flatHeading.LookVector
	forward = (forward - normal * forward:Dot(normal)).Unit
	local right = forward:Cross(normal).Unit
	-- Bank relative to the wave plane, keeping the existing swell pitch.
	local bankCos, bankSin = math.cos(boat.bank), math.sin(boat.bank)
	right, normal = right * bankCos + normal * bankSin, normal * bankCos - right * bankSin
	local surfaceFrame = CFrame.fromMatrix(Vector3.zero, right, normal, -forward)
	boat.heading.CFrame = surfaceFrame
	local rootOffset = surfaceFrame:VectorToWorldSpace(boat.waterlineOffset)
	local surfaceHeight = Biomes.WaterLevel + wave.height
	local floorHeight = boat.model:GetAttribute("DryFloorHeight")
	if floorHeight then
		-- The terrain swimming surface stays flat while the boat follows swells.
		-- Keep even the lowest tilted corner of the sole above its ripples.
		local lowestFloor = floorHeight * normal.Y
			- math.abs(right.Y) * boat.model:GetAttribute("DryFloorHalfBeam")
			- math.abs(forward.Y) * boat.model:GetAttribute("DryFloorHalfLength")
		surfaceHeight = math.max(surfaceHeight, Biomes.WaterLevel + 0.35 - lowestFloor)
	end
	boat.float.Position = Vector3.new(boat.root.Position.X, surfaceHeight + rootOffset.Y, boat.root.Position.Z)
	local direction = flatHeading.LookVector * (if speed < 0 then -1 else 1)
	if os.clock() < boat.launchGraceUntil then
		boat.clearWater = true
	elseif (math.abs(speed) > 0.1 or throttle ~= 0) and os.clock() - boat.lastWaterCheck > 0.15 then
		boat.clearWater, boat.lastWaterCheck = BoatDrive.waterAhead(boat, direction), os.clock()
	end
	if not boat.clearWater then
		speed = 0
	end
	boat.speed = speed
	-- Compensate only normal yaw around the stern. Impact-induced pitch,
	-- roll or spinning must not feed extra horizontal propulsion back in.
	local center = root.AssemblyCenterOfMass
	boat.driveAttachment.Position = root.CFrame:PointToObjectSpace(center)
	local stern = root.Position
		+ root.CFrame:VectorToWorldSpace(Vector3.new(0, 0, boat.spec.Length * 0.4) - boat.waterlineOffset)
	local lever = center - stern
	local driveYaw = Vector3.new(0, math.clamp(yawRate, -boat.spec.TurnRate, boat.spec.TurnRate), 0)
	local movement = actualForward * speed + driveYaw:Cross(lever)
	boat.velocity.PlaneVelocity = Vector2.new(movement.X, movement.Z)
	-- AlignOrientation alone owns rotation. Overwriting angular velocity
	-- every frame fights its roll/pitch corrections and collision response.
	return weather
end

return BoatDrive
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">BoatMotion</string>
          <string name="Source"><![CDATA[-- Rates are in studs/s² and radians/s². Always brake through zero before reversing.
local BoatMotion = {}

function BoatMotion.approach(value: number, target: number, delta: number): number
	return value + math.clamp(target - value, -delta, delta)
end

-- A blocked hull must not accumulate turns to unwind after contact ends.
function BoatMotion.heading(target: number, actual: number): number
	local error = math.atan2(math.sin(target - actual), math.cos(target - actual))
	return actual + math.clamp(error, -0.35, 0.35)
end

-- Discard an old heading lead as soon as the requested turn changes direction.
function BoatMotion.advanceHeading(target: number, actual: number, yawRate: number, dt: number): number
	local error = math.atan2(math.sin(target - actual), math.cos(target - actual))
	if yawRate == 0 or error * yawRate < 0 then
		target = actual
	end
	return BoatMotion.heading(target + yawRate * math.clamp(dt, 0, 0.1), actual)
end

function BoatMotion.steering(speed: number, steer: number, spec): number
	local idle = spec.IdleSteering or 0.25
	local scale = idle + (1 - idle) * math.clamp(math.abs(speed) / spec.ForwardSpeed, 0, 1)
	local input = if math.abs(steer) < 0.08 then 0 else steer * math.abs(steer)
	return input * spec.TurnRate * scale
end

function BoatMotion.step(speed: number, turn: number, throttle: number, steer: number, spec, dt: number)
	dt = math.clamp(dt, 0, 0.1)
	local target = throttle * (if throttle < 0 then spec.ReverseSpeed else spec.ForwardSpeed)
	local reversing = speed * target < 0
	local rate = if throttle == 0
		then spec.CoastDeceleration
		elseif reversing or math.abs(target) < math.abs(speed) then spec.BrakeDeceleration
		else spec.Acceleration
	speed = BoatMotion.approach(speed, if reversing then 0 else target, rate * dt)
	local targetTurn = BoatMotion.steering(speed, steer, spec)
	-- The constraint handles physical inertia. Do not spend another half-second
	-- ramping the command through the old turn before countersteering can begin.
	if turn * targetTurn < 0 then
		turn = 0
	end
	local turnRate = math.max(spec.TurnAcceleration, spec.TurnRate / 0.18)
	turn = BoatMotion.approach(turn, targetTurn, turnRate * (if targetTurn == 0 then 2 else 1) * dt)
	return speed, turn
end

-- Lean into the requested lateral acceleration, independent of noisy measured
-- spin. Countersteering cancels outward roll momentum before easing back over.
function BoatMotion.bank(
	bank: number,
	bankVelocity: number,
	speed: number,
	yawRate: number,
	spec,
	gravity: number,
	dt: number
)
	dt = math.clamp(dt, 0, 0.1)
	local limit = math.rad(spec.MaxBankAngle)
	local target = math.clamp(math.atan(speed * yawRate * 0.8 / math.max(gravity, 1)), -limit, limit)
	if bankVelocity * (target - bank) < 0 then
		bankVelocity = 0
	end
	local frequency = 12
	local offset = bank - target
	local decay = math.exp(-frequency * dt)
	local spring = bankVelocity + frequency * offset
	return target + (offset + spring * dt) * decay, (bankVelocity - frequency * spring * dt) * decay
end

return BoatMotion
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">BoatUpgrades</string>
          <string name="Source"><![CDATA[-- Refit dock upgrades. Extra motors and rudders are boat kit stowed in the cargo
-- hold (Shared.Cargo parts), so every one fitted costs hold tiles; the boat's own
-- kit from BoatCatalog.StarterParts never counts as an upgrade. Paint is a saved
-- preset colour per boat. Pure: the saved-data tests run it without Roblox.
local Cargo = if script then require(script.Parent.Cargo) else require("./Cargo")

local BoatUpgrades = {}

BoatUpgrades.Order = { "Motor", "Rudder" }
BoatUpgrades.Kinds = {
	-- Boost is the share of the stock figure each fitted part adds.
	Motor = {
		Name = "Extra motor",
		Plural = "motors",
		Max = 3,
		Boost = 0.12,
		Description = "Each one adds 12% top speed and acceleration.",
	},
	Rudder = {
		Name = "Rudder",
		Plural = "rudders",
		Max = 3,
		Boost = 0.15,
		Description = "Each one turns the hull 15% sharper and quicker.",
	},
}

-- The trawler's stern net is a permanent hull fitting, not hold cargo. It is
-- saved apart from the motor and rudder kit so it never consumes cargo tiles.
BoatUpgrades.Net = {
	Id = "FishermansNet",
	Name = "Fisherman's Net",
	BoatId = "Trawler",
	Price = 5000,
	Description = "Trawls the stern while underway. Catches common fish, and sometimes uncommon ones.",
}

-- Preset hull colours as RGB, so this module needs no Roblox types. Factory puts
-- the builder's own colours back.
BoatUpgrades.Paints = {
	{ Id = "Factory", Name = "Factory finish" },
	{ Id = "White", Name = "White", RGB = { 238, 240, 236 } },
	{ Id = "Black", Name = "Black", RGB = { 36, 38, 42 } },
	{ Id = "Gray", Name = "Gray", RGB = { 128, 134, 140 } },
	{ Id = "Red", Name = "Red", RGB = { 196, 40, 40 } },
	{ Id = "Orange", Name = "Orange", RGB = { 232, 118, 36 } },
	{ Id = "Yellow", Name = "Yellow", RGB = { 240, 196, 48 } },
	{ Id = "Green", Name = "Green", RGB = { 46, 139, 70 } },
	{ Id = "Blue", Name = "Blue", RGB = { 36, 104, 196 } },
	{ Id = "Navy", Name = "Navy", RGB = { 28, 44, 92 } },
	{ Id = "Purple", Name = "Purple", RGB = { 120, 64, 168 } },
	{ Id = "Pink", Name = "Pink", RGB = { 232, 120, 168 } },
}

function BoatUpgrades.paint(id: any)
	for _, paint in BoatUpgrades.Paints do
		if paint.Id == id then
			return paint
		end
	end
	return nil
end

-- Whether this angler has bought the trawler's stern net. Profiles from before
-- the net existed simply have no BoatUpgrades table yet.
function BoatUpgrades.ownsNet(angler)
	local boats = type(angler) == "table" and angler.BoatUpgrades
	local upgrades = type(boats) == "table" and boats[BoatUpgrades.Net.BoatId]
	return type(upgrades) == "table" and upgrades[BoatUpgrades.Net.Id] == true
end

function BoatUpgrades.grantNet(angler)
	local boatId = BoatUpgrades.Net.BoatId
	angler.BoatUpgrades = angler.BoatUpgrades or {}
	angler.BoatUpgrades[boatId] = angler.BoatUpgrades[boatId] or {}
	angler.BoatUpgrades[boatId][BoatUpgrades.Net.Id] = true
	return angler
end

-- Extra motors match the boat's own engine; a hull without one (the rowboat)
-- takes the small inboard engine.
function BoatUpgrades.partId(layout, kind: string): string
	if kind == "Rudder" then
		return "Rudder"
	end
	for _, item in layout.StarterParts or {} do
		local part = Cargo.Parts[item.PartId]
		if part and part.Motor then
			return item.PartId
		end
	end
	return "Engine"
end

function BoatUpgrades.tiles(layout, kind: string): number
	return #Cargo.cells(Cargo.Parts[BoatUpgrades.partId(layout, kind)].Shape)
end

-- How many of `kind` were fitted at the refit dock, beyond the boat's own kit.
function BoatUpgrades.count(items, layout, kind: string): number
	local partId = BoatUpgrades.partId(layout, kind)
	local count = 0
	for _, item in items do
		if item.PartId == partId then
			count += 1
		end
	end
	for _, item in layout.StarterParts or {} do
		if item.PartId == partId then
			count -= 1
		end
	end
	return math.max(count, 0)
end

-- The catalog spec with `motors` extra motors and `rudders` rudders fitted.
function BoatUpgrades.tuned(layout, motors: number, rudders: number)
	if motors == 0 and rudders == 0 then
		return layout
	end
	local spec = table.clone(layout)
	local speed = 1 + motors * BoatUpgrades.Kinds.Motor.Boost
	local turn = 1 + rudders * BoatUpgrades.Kinds.Rudder.Boost
	spec.ForwardSpeed *= speed
	spec.ReverseSpeed *= speed
	spec.Acceleration *= speed
	spec.TurnRate *= turn
	spec.TurnAcceleration *= turn
	return spec
end

-- The spec a hull drives with, given its saved hold.
function BoatUpgrades.spec(layout, items)
	return BoatUpgrades.tuned(
		layout,
		BoatUpgrades.count(items, layout, "Motor"),
		BoatUpgrades.count(items, layout, "Rudder")
	)
end

function BoatUpgrades.freeTiles(layout, items, species): number
	local used = 0
	for _ in Cargo.occupied(items, species) do
		used += 1
	end
	return math.max(Cargo.capacity(layout.Hold) - used, 0)
end

-- Returns a copy of the hold with one more `kind` stowed in the best open spot,
-- or nil and a player-facing reason.
function BoatUpgrades.install(items, layout, kind: string, species)
	local upgrade = BoatUpgrades.Kinds[kind]
	if not upgrade then
		return nil, "Choose a motor or a rudder."
	elseif BoatUpgrades.count(items, layout, kind) >= upgrade.Max then
		return nil, string.format("Your %s already has %d extra %s.", layout.Name, upgrade.Max, upgrade.Plural)
	end
	local partId = BoatUpgrades.partId(layout, kind)
	local spot = Cargo.bestSpot(layout.Hold, items, { PartId = partId }, species)
	if not spot then
		return nil,
			string.format(
				"There's no room in your hold. Clear %d cargo tiles in one place first.",
				BoatUpgrades.tiles(layout, kind)
			)
	end
	local result = table.clone(items)
	table.insert(result, { PartId = partId, X = spot.X, Y = spot.Y, R = spot.R })
	return result
end

-- Returns a copy of the hold with the last fitted `kind` taken out. The boat's own
-- kit always stays aboard.
function BoatUpgrades.remove(items, layout, kind: string)
	local upgrade = BoatUpgrades.Kinds[kind]
	if not upgrade then
		return nil, "Choose a motor or a rudder."
	elseif BoatUpgrades.count(items, layout, kind) == 0 then
		return nil, string.format("Your %s has no extra %s to take out.", layout.Name, upgrade.Plural)
	end
	local partId = BoatUpgrades.partId(layout, kind)
	local result = table.clone(items)
	for index = #result, 1, -1 do
		if result[index].PartId == partId then
			table.remove(result, index)
			break
		end
	end
	return result
end

-- Whether `position` is inside a refit dock's slip (its SlipFrame and SlipSize).
function BoatUpgrades.inSlip(dock: Instance, position: Vector3): boolean
	local frame, size = dock:GetAttribute("SlipFrame"), dock:GetAttribute("SlipSize")
	if typeof(frame) ~= "CFrame" or typeof(size) ~= "Vector3" then
		return false
	end
	local point = frame:PointToObjectSpace(position)
	return math.abs(point.X) <= size.X / 2 and math.abs(point.Y) <= size.Y / 2 and math.abs(point.Z) <= size.Z / 2
end

return BoatUpgrades
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">BobberSkins</string>
          <string name="Source"><![CDATA[-- Budget bobber skins. Luck uses the same rarity bias as Finn's upgrades;
-- Mutation adds percentage points to the mutation roll. Only one skin contributes.
local BobberSkins = {}

BobberSkins.RarityOrder = { "Common", "Uncommon", "Rare", "Epic", "Legendary" }
BobberSkins.Rarities = {
	Common = { Color = { 196, 201, 205 } },
	Uncommon = { Color = { 111, 202, 125 } },
	Rare = { Color = { 86, 156, 240 } },
	Epic = { Color = { 186, 104, 240 } },
	Legendary = { Color = { 255, 196, 64 } },
}
BobberSkins.Skins = {
	CherryBobber = {
		Name = "Cherry Bobber",
		Rarity = "Common",
		Top = { 221, 66, 73 },
		Bottom = { 248, 239, 218 },
		Luck = 0.005,
		Mutation = 0.0001,
	},
	BlueBobber = {
		Name = "Blue Bobber",
		Rarity = "Common",
		Top = { 64, 139, 224 },
		Bottom = { 248, 239, 218 },
		Luck = 0.005,
		Mutation = 0.0001,
	},
	MintBobber = {
		Name = "Mint Bobber",
		Rarity = "Uncommon",
		Top = { 93, 201, 153 },
		Bottom = { 235, 251, 242 },
		Luck = 0.01,
		Mutation = 0.0002,
	},
	OrangeBobber = {
		Name = "Orange Bobber",
		Rarity = "Uncommon",
		Top = { 241, 151, 60 },
		Bottom = { 255, 232, 191 },
		Luck = 0.01,
		Mutation = 0.0002,
	},
	RoseBobber = {
		Name = "Rose Bobber",
		Rarity = "Rare",
		Top = { 231, 116, 169 },
		Bottom = { 95, 48, 92 },
		Luck = 0.015,
		Mutation = 0.0004,
	},
	NeonPurpleBobber = {
		Name = "Neon Purple Bobber",
		Rarity = "Epic",
		Top = { 178, 48, 255 },
		Bottom = { 15, 13, 20 },
		NeonTop = true,
		Luck = 0.02,
		Mutation = 0.0007,
	},
	CrownedGoldBobber = {
		Name = "Crowned Gold Bobber",
		Rarity = "Legendary",
		Top = { 255, 199, 65 },
		Bottom = { 207, 147, 34 },
		Crown = true,
		Luck = 0.03,
		Mutation = 0.001,
	},
}

BobberSkins.CrateOrder = { "BobberCase" }
BobberSkins.Crates = {
	BobberCase = {
		Name = "Bobber Case",
		Description = "Simple recolors with small luck and mutation perks. Epic and legendary have special finishes.",
		Price = 350,
		Odds = { Common = 0.675, Uncommon = 0.25, Rare = 0.05, Epic = 0.02, Legendary = 0.005 },
		Skins = {
			"CherryBobber",
			"BlueBobber",
			"MintBobber",
			"OrangeBobber",
			"RoseBobber",
			"NeonPurpleBobber",
			"CrownedGoldBobber",
		},
	},
}

function BobberSkins.valid(id: any): boolean
	return type(id) == "string" and BobberSkins.Skins[id] ~= nil
end

function BobberSkins.validCrate(id: any): boolean
	return type(id) == "string" and BobberSkins.Crates[id] ~= nil
end

function BobberSkins.rarity(id: string, _crateId: string?): string
	return BobberSkins.Skins[id].Rarity
end

function BobberSkins.roll(crateId: string, rarityPick: number, skinPick: number): string
	local crate = BobberSkins.Crates[crateId]
	local rarity = BobberSkins.RarityOrder[1]
	for _, name in BobberSkins.RarityOrder do
		rarity = name
		rarityPick -= crate.Odds[name]
		if rarityPick < 0 then
			break
		end
	end
	local pool = {}
	for _, id in crate.Skins do
		if BobberSkins.rarity(id) == rarity then
			table.insert(pool, id)
		end
	end
	return pool[math.clamp(math.floor(skinPick * #pool) + 1, 1, #pool)]
end

function BobberSkins.chance(crateId: string, skinId: string): number
	local crate = BobberSkins.Crates[crateId]
	if not table.find(crate.Skins, skinId) then
		return 0
	end
	local rarity, count = BobberSkins.rarity(skinId), 0
	for _, id in crate.Skins do
		if BobberSkins.rarity(id) == rarity then
			count += 1
		end
	end
	return crate.Odds[rarity] / count
end

function BobberSkins.apply(boosts, skinId: string?)
	local result = table.clone(boosts)
	local skin = skinId and BobberSkins.Skins[skinId]
	if skin then
		result.luck = (result.luck or 0) + skin.Luck
		result.mutation = (result.mutation or 0) + skin.Mutation
	end
	return result
end

function BobberSkins.perks(skinId: string): { string }
	local skin = BobberSkins.Skins[skinId]
	return {
		string.format("+%g%% luck", skin.Luck * 100),
		string.format("+%g%% mutation chance", skin.Mutation * 100),
	}
end

return BobberSkins
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">BuildingCatalog</string>
          <string name="Source"><![CDATA[-- Pure, shared construction rules. All saved values are numbers/strings/tables.
local Building = {}
Building.GRID = 4.5
Building.WALL_HEIGHT = 11.5
Building.LEVEL_HEIGHT = 12
Building.MAX_LEVEL = 3
Building.MAX_PIECES = 350
Building.MAX_OVERRIDES = 600
-- Drawing and snapping use the same visible plane and lattice everywhere.
Building.GRID_PLANE_OFFSET = 0.16
function Building.gridOffset(site)
	return if site == "Company" then 0 else Building.GRID / 2
end
function Building.snap(value, size, site)
	local offset = Building.gridOffset(site)
	return math.round((value - offset) / size) * size + offset
end
function Building.planeHeight(site, level)
	return (if site == "Company" then 0 else 0.16) + level * Building.LEVEL_HEIGHT + Building.GRID_PLANE_OFFSET
end
Building.Materials = { "Plaster", "Brick", "WoodPlanks", "Wood", "Concrete", "Slate", "Marble", "CeramicTiles", "Cobblestone", "Metal", "RoofShingles", "SmoothPlastic", "Glass" }
Building.Colors = {
	{Name="Ivory",Color={235,229,211}}, {Name="White",Color={246,246,242}},
	{Name="Sand",Color={196,172,137}}, {Name="Clay",Color={166,82,59}},
	{Name="Oak",Color={128,88,54}}, {Name="Walnut",Color={69,47,38}},
	{Name="Charcoal",Color={43,47,53}}, {Name="Stone",Color={135,142,146}},
	{Name="Sage",Color={118,145,119}}, {Name="Seafoam",Color={137,192,180}},
	{Name="Ocean",Color={55,108,146}}, {Name="Navy",Color={42,58,83}},
	{Name="Rose",Color={195,133,139}}, {Name="Lilac",Color={153,132,180}},
	{Name="Gold",Color={213,176,82}}, {Name="Black",Color={24,25,29}},
}
Building.Bounds = {
	Home = { {-24.75,-33.75,24.75,15.75}, {-24.75,65.25,24.75,83.25} },
	Company = { {-54,-31.5,54,31.5} },
}
local kinds = {Wall=true,Floor=true,Roof=true,Window=true,Door=true,Stairs=true}
local styles = {Roof={Flat=true,Gable=true,Shed=true},Window={Picture=true,Classic=true},Door={Open=true,Panel=true},Stairs={North=true,East=true,South=true,West=true}}
local defaults = {Wall="Plaster",Floor="WoodPlanks",Roof="RoofShingles",Window="Wood",Door="Wood",Stairs="WoodPlanks"}
local function finite(n)
	return type(n)=="number" and n==n and math.abs(n)<10000
end
function Building.color(raw)
	if type(raw)~="table" then return nil end
	local result={}
	for i=1,3 do
		local n=raw[i]
		if not finite(n) or n<0 or n>255 or n%1~=0 then return nil end
		result[i]=n
	end
	return result
end
function Building.id(id)
	return type(id)=="string" and #id>0 and #id<=220 and id:match("^[%w_:%.%-%/]+$")~=nil
end
function Building.normalize(raw)
	if type(raw)~="table" or not kinds[raw.Kind] then return nil,"Choose a building piece." end
	local kind=raw.Kind
	local material=raw.Material or defaults[kind]
	if not table.find(Building.Materials,material) then return nil,"Choose a material from the palette." end
	local color=Building.color(raw.Color or Building.Colors[1].Color)
	if not color then return nil,"Choose a valid RGB color (0–255)." end
	local level=raw.Level or 0
	if not finite(level) or level%1~=0 or level<0 or level>Building.MAX_LEVEL then return nil,"Choose a floor from 1 to 4." end
	local clean={Kind=kind,Material=material,Color=color,Level=level}
	if raw.Id~=nil then
		if not Building.id(raw.Id) then return nil,"Invalid piece ID." end
		clean.Id=raw.Id
	end
	if styles[kind] then
		local style=raw.Style or (if kind=="Roof" then "Gable" elseif kind=="Window" then "Classic" elseif kind=="Stairs" then "North" else "Open")
		if not styles[kind][style] then return nil,"Choose a valid style." end
		clean.Style=style
	end
	if kind=="Window" or kind=="Door" then
		if not Building.id(raw.HostId) or not finite(raw.Offset) or math.abs(raw.Offset)>150 then return nil,"Place this on a wall." end
		clean.HostId,clean.Offset=raw.HostId,math.round(raw.Offset*1000)/1000
	else
		for _,key in {"X1","Z1","X2","Z2"} do
			if not finite(raw[key]) or math.abs(raw[key])>150 then return nil,"Keep construction inside your plot." end
			clean[key]=math.round(raw[key]*1000)/1000
		end
		if kind=="Wall" then
			if math.abs(clean.X1-clean.X2)>0.01 and math.abs(clean.Z1-clean.Z2)>0.01 then return nil,"Walls follow horizontal or vertical grid lines." end
			if clean.X1>clean.X2 or clean.Z1>clean.Z2 then clean.X1,clean.X2,clean.Z1,clean.Z2=clean.X2,clean.X1,clean.Z2,clean.Z1 end
		else
			clean.X1,clean.X2=math.min(clean.X1,clean.X2),math.max(clean.X1,clean.X2)
			clean.Z1,clean.Z2=math.min(clean.Z1,clean.Z2),math.max(clean.Z1,clean.Z2)
		end
	end
	return clean,nil
end
function Building.host(pieces,builtins,id)
	if builtins and builtins[id] then return builtins[id] end
	for _,entry in pieces or {} do if entry.Id==id then return entry end end
	return nil
end
function Building.length(entry)
	return math.sqrt((entry.X2-entry.X1)^2+(entry.Z2-entry.Z1)^2)
end
function Building.opening(entry)
	-- Each opening fits one 4.5 stud cell with a solid post on either side.
	return 3.5, (if entry.Kind=="Door" then 0 else 3), (if entry.Kind=="Door" then 8.8 else 8.5)
end
local function areaOverlap(a,b)
	return math.min(a.X2,b.X2)>math.max(a.X1,b.X1)+0.02 and math.min(a.Z2,b.Z2)>math.max(a.Z1,b.Z1)+0.02
end
local function wallArea(wall)
	local reach=(wall.Thickness or 0.45)/2
	return {X1=math.min(wall.X1,wall.X2)-reach,Z1=math.min(wall.Z1,wall.Z2)-reach,
		X2=math.max(wall.X1,wall.X2)+reach,Z2=math.max(wall.Z1,wall.Z2)+reach}
end
local function stairConflict(stair,other)
	local level=stair.Level or 0
	if other.Kind=="Wall" and ((other.Level or 0)==level or (other.Level or 0)==level+1) then
		return areaOverlap(stair,wallArea(other))
	elseif other.Kind=="Roof" and (other.Level or 0)==level then
		return areaOverlap(stair,other)
	elseif other.Kind=="Stairs" and math.abs((other.Level or 0)-level)<=1 then
		return areaOverlap(stair,other)
	end
	return false
end
function Building.check(pieces,entry,site,builtins,skipId)
	local clean,reason=Building.normalize(entry)
	if not clean then return reason end
	entry=clean
	if #pieces>=Building.MAX_PIECES and not skipId then return "Your plot has reached its building limit." end
	if entry.HostId then
		local host=Building.host(pieces,builtins,entry.HostId)
		if not host or host.Kind~="Wall" then return "Place doors and windows on a wall." end
		local width,bottom,top=Building.opening(entry)
		if entry.Offset-width/2<0.2 or entry.Offset+width/2>Building.length(host)-0.2 then return "Leave room for a post at each end of the wall." end
		if (host.Height or Building.WALL_HEIGHT)<top then return "This wall section is too low for that opening." end
		if host.BaseY and host.BaseY>0.3+(host.Level or 0)*Building.LEVEL_HEIGHT+bottom then return "Place this opening on a complete wall section." end
		for _,other in pieces do
			if other.Id~=skipId and other.HostId==entry.HostId then
				local w,b,t=Building.opening(other)
				if math.abs(other.Offset-entry.Offset)<(w+width)/2+0.15 and bottom<t and top>b then return "There is already an opening here." end
			end
		end
		return nil
	end
	local dx,dz=entry.X2-entry.X1,entry.Z2-entry.Z1
	if entry.Kind=="Wall" then
		if Building.length(entry)<1.125 then return "Draw at least one grid segment." end
	elseif entry.Kind=="Stairs" then
		if entry.Level>=Building.MAX_LEVEL then return "Stairs must start below the fourth floor." end
		local alongX=entry.Style=="East" or entry.Style=="West"
		local width,run=if alongX then dz else dx,if alongX then dx else dz
		if width<3.5 or run<8 then return "Stairs need at least 3.5 studs of width and 8 studs of run in their climb direction." end
	elseif dx<1.125 or dz<1.125 then return "Draw an area at least one grid square wide." end
	local inside=false
	for _,area in Building.Bounds[site or "Home"] or {} do
		if entry.X1>=area[1]-0.01 and entry.Z1>=area[2]-0.01 and entry.X2<=area[3]+0.01 and entry.Z2<=area[4]+0.01 then inside=true break end
	end
	if not inside then return "Keep the whole piece on your house, yard, shop, or company plot. Roads stay clear." end
	if site=="Company" and (entry.Kind=="Wall" or entry.Kind=="Stairs") and entry.Level==0 then
		if entry.Z1<=-27 and entry.X1<4.5 and entry.X2>-4.5 then return "Keep the company plot entrance clear." end
	end
	for _,collection in {pieces,builtins or {}} do
		for _,other in collection do
			if other.Id==skipId or other.HostId then continue end
			if (entry.Kind=="Stairs" and stairConflict(entry,other)) or (other.Kind=="Stairs" and stairConflict(other,entry)) then
				return "Keep the staircase clear through both floors. Move walls or remove the roof above it."
			end
		end
	end
	if entry.Kind=="Wall" then
		for _,other in builtins or {} do
			if other.Kind~="Wall" or other.Level~=entry.Level then continue end
			local xLine=math.abs(dx)<0.01 and math.abs(other.X2-other.X1)<0.01 and math.abs(entry.X1-other.X1)<0.05
			local zLine=math.abs(dz)<0.01 and math.abs(other.Z2-other.Z1)<0.01 and math.abs(entry.Z1-other.Z1)<0.05
			if (xLine and math.min(entry.Z2,other.Z2)>math.max(entry.Z1,other.Z1)+0.05)
				or (zLine and math.min(entry.X2,other.X2)>math.max(entry.X1,other.X1)+0.05) then return "An existing wall covers this line. Paint it or remove it first." end
		end
	end
	for _,other in pieces do
		if other.Id==skipId or other.HostId or other.Kind~=entry.Kind or other.Level~=entry.Level then continue end
		if entry.Kind=="Wall" then
			local xLine=math.abs(dx)<0.01 and math.abs(other.X2-other.X1)<0.01 and math.abs(entry.X1-other.X1)<0.05
			local zLine=math.abs(dz)<0.01 and math.abs(other.Z2-other.Z1)<0.01 and math.abs(entry.Z1-other.Z1)<0.05
			if (xLine and math.min(entry.Z2,other.Z2)>math.max(entry.Z1,other.Z1)+0.05)
				or (zLine and math.min(entry.X2,other.X2)>math.max(entry.X1,other.X1)+0.05) then return "A wall already covers this line." end
		elseif math.min(entry.X2,other.X2)>math.max(entry.X1,other.X1)+0.05 and math.min(entry.Z2,other.Z2)>math.max(entry.Z1,other.Z1)+0.05 then
			return "These building areas overlap. Paint or remove the existing piece first."
		end
	end
	return nil
end
function Building.price(entry)
	if entry.Kind=="Window" then return 45 elseif entry.Kind=="Door" then return 60 end
	local units=if entry.Kind=="Wall" then Building.length(entry)/Building.GRID else math.abs((entry.X2-entry.X1)*(entry.Z2-entry.Z1))/(Building.GRID^2)
	return math.max(1,math.ceil(units*(if entry.Kind=="Wall" then 12 elseif entry.Kind=="Roof" then 10 elseif entry.Kind=="Stairs" then 20 else 6)))
end
function Building.decode(raw)
	local result={}
	for _,site in {"Home","Company"} do
		local source=if type(raw)=="table" and type(raw[site])=="table" then raw[site] else {}
		local data={NextId=1,Pieces={},Overrides={}}
		local seen={}
		if type(source.Pieces)=="table" then
			for _,entry in source.Pieces do
				if #data.Pieces>=Building.MAX_PIECES then break end
				local clean=Building.normalize(entry)
				local serial=clean and clean.Id and tonumber(clean.Id:sub(2))
				if clean and clean.Id and clean.Id:match("^p%d+$") and serial and serial<1000000000 and not seen[clean.Id] then
					seen[clean.Id]=true
					table.insert(data.Pieces,clean)
					data.NextId=math.max(data.NextId,(tonumber(clean.Id:sub(2)) or 0)+1)
				end
			end
		end
		if type(source.NextId)=="number" and source.NextId%1==0 and source.NextId>=data.NextId and source.NextId<1000000000 then data.NextId=source.NextId end
		local count=0
		if type(source.Overrides)=="table" then
			for id,edit in source.Overrides do
				if count>=Building.MAX_OVERRIDES then break end
				if not Building.id(id) or id:sub(1,2)~="b:" or type(edit)~="table" then continue end
				local patch={}
				if edit.Removed==true then patch.Removed=true end
				if table.find(Building.Materials,edit.Material) then patch.Material=edit.Material end
				patch.Color=Building.color(edit.Color)
				data.Overrides[id]=patch
				count+=1
			end
		end
		result[site]=data
	end
	return result
end
return Building
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">BuildingRenderer</string>
          <string name="Source"><![CDATA[-- Shared geometry for authoritative construction and the client's placement ghost.
-- Original shells stay in place so upgrades and functional room references survive.
local Catalog = require(script.Parent.BuildingCatalog)
local Renderer = {}
local captures = setmetatable({}, {__mode="k"})
local UP = Vector3.new(0,1,0)
local function color(value)
	return Color3.fromRGB(value[1],value[2],value[3])
end
local function bytes(value)
	return {math.round(value.R*255),math.round(value.G*255),math.round(value.B*255)}
end
local function kindOf(part)
	local n=part.Name
	if n:find("Floor") and not n:find("Lamp") then return "Floor" end
	if n:find("Roof") or n:find("Ridge") or n:find("Gable") or n:find("Eaves") or n:find("Gutter") or n:find("CeilingTie") or n:find("TileCourse") or n:lower():find("bargeboard") then return "Roof" end
	if n:find("Window") or n=="StoneSill" or n=="OpenShutter" then return "Window" end
	if n:find("DoorJamb") or n:find("DoorHeader") or n=="Door" or n=="DoorPanel" then return "Door" end
	if n:find("Wall") or n:find("Partition") or n:find("PassageLintel") or n:find("DoorLintel") then return "Wall" end
	return nil
end
local function excluded(part,model)
	local node=part.Parent
	while node and node~=model do
		if node.Name=="Furniture" or node.Name=="PlotFurniture" or node.Name=="BuildingPieces"
			or node.Name=="CeilingLights" or node.Name=="Staff" then return true end
		node=node.Parent
	end
	return false
end
local function stableId(part,model,_localFrame)
	local names={}
	local node=part
	while node and node~=model do
		local ordinal=0
		if node.Parent then
			for _,sibling in node.Parent:GetChildren() do
				if sibling.Name==node.Name then ordinal+=1 end
				if sibling==node then break end
			end
		end
		table.insert(names,1,(node.Name:gsub("[^%w_%-]","_")).."_"..tostring(ordinal))
		node=node.Parent
	end
	return "b:"..table.concat(names,"/")
end
function Renderer.capture(model,frame,site)
	local records=captures[model]
	if not records then records={} captures[model]=records end
	local known={}
	for _,record in records do known[record.Part]=true end
	for _,part in model:GetDescendants() do
		if not part:IsA("BasePart") or known[part] or excluded(part,model) then continue end
		-- An island's decorative buildings are outside its building plot.
		if site=="Company" then continue end
		local kind=kindOf(part)
		if not kind then continue end
		local localFrame=frame:ToObjectSpace(part.CFrame)
		local id=stableId(part,model,localFrame)
		local p=localFrame.Position
		local axis=if part.Size.X>=part.Size.Z then localFrame.RightVector else -localFrame.LookVector
		local length=math.max(part.Size.X,part.Size.Z)
		local start=p-axis*length/2
		local finish=p+axis*length/2
		local descriptor={Id=id,Kind=kind,X1=start.X,Z1=start.Z,X2=finish.X,Z2=finish.Z,
			BaseY=p.Y-part.Size.Y/2,Height=part.Size.Y,Thickness=math.min(part.Size.X,part.Size.Z),
			Level=0,Material=part.Material.Name,Color=bytes(part.Color)}
		if kind=="Floor" or kind=="Roof" then
			local right,up,back=localFrame.RightVector,localFrame.UpVector,localFrame.LookVector
			local halfX=(math.abs(right.X)*part.Size.X+math.abs(up.X)*part.Size.Y+math.abs(back.X)*part.Size.Z)/2
			local halfZ=(math.abs(right.Z)*part.Size.X+math.abs(up.Z)*part.Size.Y+math.abs(back.Z)*part.Size.Z)/2
			descriptor.X1,descriptor.X2=p.X-halfX,p.X+halfX
			descriptor.Z1,descriptor.Z2=p.Z-halfZ,p.Z+halfZ
			if kind=="Floor" then
				local base=if site=="Company" then 0 else 0.16
				descriptor.Level=math.clamp(math.round((p.Y+part.Size.Y/2-base)/Catalog.LEVEL_HEIGHT),0,Catalog.MAX_LEVEL)
			end
		end
		if kind=="Wall" and (math.abs(start.X-finish.X)<0.01 or math.abs(start.Z-finish.Z)<0.01) then
			if descriptor.X1>descriptor.X2+0.01 or descriptor.Z1>descriptor.Z2+0.01 then
				descriptor.X1,descriptor.X2,descriptor.Z1,descriptor.Z2=descriptor.X2,descriptor.X1,descriptor.Z2,descriptor.Z1
			end
		end
		records[id]={Part=part,Descriptor=descriptor,Color=part.Color,Material=part.Material,
			Transparency=part.Transparency,CanCollide=part.CanCollide,CanQuery=part.CanQuery,CanTouch=part.CanTouch}
		part:SetAttribute("BuildingId",id)
		part:SetAttribute("BuildingKind",kind)
	end
	local descriptors={}
	for id,record in records do
		if record.Part:IsDescendantOf(model) then descriptors[id]=record.Descriptor else records[id]=nil end
	end
	return descriptors
end
Renderer.describe=Renderer.capture
local function part(parent,name,size,cf,entry,id,kind)
	local result=Instance.new("Part")
	result.Name=name
	result.Size=size
	result.CFrame=cf
	result.Anchored=true
	result.TopSurface=Enum.SurfaceType.Smooth
	result.BottomSurface=Enum.SurfaceType.Smooth
	result.Material=Enum.Material[entry.Material] or Enum.Material.Plaster
	result.Color=color(entry.Color)
	result:SetAttribute("BuildingId",id or entry.Id)
	result:SetAttribute("BuildingKind",kind or entry.Kind)
	result.Parent=parent
	return result
end
local function hostFrame(frame,host)
	local dx,dz=host.X2-host.X1,host.Z2-host.Z1
	local length=math.sqrt(dx*dx+dz*dz)
	local right=Vector3.new(dx/length,0,dz/length)
	local y=host.BaseY or (0.16+(host.Level or 0)*Catalog.LEVEL_HEIGHT)
	local start=Vector3.new(host.X1,y,host.Z1)
	return frame*CFrame.fromMatrix(start,right,UP,right:Cross(UP)),length
end
local function drawWall(parent,frame,host,openings)
	local cf,length=hostFrame(frame,host)
	local height=host.Height or Catalog.WALL_HEIGHT
	local thickness=host.Thickness or 0.45
	local function slab(x1,x2,y1,y2)
		if x2-x1<0.01 or y2-y1<0.01 then return end
		part(parent,"Wall",Vector3.new(x2-x1,y2-y1,thickness),cf*CFrame.new((x1+x2)/2,(y1+y2)/2,0),host)
	end
	table.sort(openings,function(a,b) return a.Offset<b.Offset end)
	local cursor=0
	for _,opening in openings do
		local width,bottom,top=Catalog.opening(opening)
		local left,right=opening.Offset-width/2,opening.Offset+width/2
		slab(cursor,left,0,height)
		slab(left,right,0,bottom)
		slab(left,right,top,height)
		cursor=right
	end
	slab(cursor,length,0,height)
end
local function drawOpening(parent,frame,entry,host)
	if not host then return end
	local cf=hostFrame(frame,host)
	local width,bottom,top=Catalog.opening(entry)
	local t=math.max(0.6,host.Thickness or 0.45)
	local function piece(name,size,x,y,z)
		return part(parent,name,size,cf*CFrame.new(entry.Offset+x,y,z or 0),entry)
	end
	local trim=0.14
	for _,side in {-1,1} do
		piece("Frame",Vector3.new(trim,top-bottom+trim,t),side*(width-trim)/2,(bottom+top)/2)
	end
	piece("Header",Vector3.new(width,trim,t),0,top-trim/2)
	if entry.Kind=="Window" then
		piece("Sill",Vector3.new(width+0.2,trim,t+0.15),0,bottom+trim/2)
		local glass=piece("Glass",Vector3.new(width-trim*2,top-bottom-trim*2,0.1),0,(bottom+top)/2)
		glass.Material=Enum.Material.Glass
		glass.Color=Color3.fromRGB(163,205,215)
		glass.Transparency=0.6
		glass.Reflectance=0.1
		glass.CanCollide=false
		if entry.Style=="Classic" then
			piece("Mullion",Vector3.new(0.1,top-bottom,0.2),0,(bottom+top)/2)
			piece("Rail",Vector3.new(width,0.1,0.2),0,(bottom+top)/2)
		end
	elseif entry.Style=="Panel" then
		-- The panel is held open, leaving a walkable 3.2-stud opening without scripts.
		local panel=piece("OpenDoor",Vector3.new(0.18,top-0.2,width-0.3),-width/2,top/2,(width-0.3)/2)
		panel.CanCollide=false
		local handle=piece("Handle",Vector3.new(0.12,0.16,0.35),-width/2+0.15,4,width-0.7)
		handle.Material=Enum.Material.Metal
	end
end
local function floorRectangles(entry,pieces)
	local rectangles={{entry.X1,entry.Z1,entry.X2,entry.Z2}}
	local cut=false
	for _,stairs in pieces do
		if stairs.Kind~="Stairs" or stairs.Level+1~=(entry.Level or 0) then continue end
		local nextRectangles={}
		for _,rect in rectangles do
			local ax,az=math.max(rect[1],stairs.X1),math.max(rect[2],stairs.Z1)
			local bx,bz=math.min(rect[3],stairs.X2),math.min(rect[4],stairs.Z2)
			if bx<=ax+0.01 or bz<=az+0.01 then table.insert(nextRectangles,rect);continue end
			cut=true
			local function keep(x1,z1,x2,z2)
				if x2>x1+0.01 and z2>z1+0.01 then table.insert(nextRectangles,{x1,z1,x2,z2}) end
			end
			keep(rect[1],rect[2],ax,rect[4])
			keep(bx,rect[2],rect[3],rect[4])
			keep(ax,rect[2],bx,az)
			keep(ax,bz,bx,rect[4])
		end
		rectangles=nextRectangles
	end
	return rectangles,cut
end
local function drawFloor(parent,frame,entry,pieces,y,thickness,original)
	local rectangles=floorRectangles(entry,pieces)
	for _,rect in rectangles do
		local floor=part(parent,"Floor",Vector3.new(rect[3]-rect[1],thickness,rect[4]-rect[2]),
			frame*CFrame.new((rect[1]+rect[3])/2,y,(rect[2]+rect[4])/2),entry)
		if original then
			floor.Transparency=original.Transparency
			floor.CanCollide,floor.CanQuery,floor.CanTouch=original.CanCollide,original.CanQuery,original.CanTouch
		end
	end
end
local function drawStairs(parent,frame,entry,floor)
	local width,depth=entry.X2-entry.X1,entry.Z2-entry.Z1
	local alongX=entry.Style=="East" or entry.Style=="West"
	local run=if alongX then width else depth
	local tread=run/16
	for step=1,16 do
		local x,z=(entry.X1+entry.X2)/2,(entry.Z1+entry.Z2)/2
		local offset=(step-0.5)*tread
		if entry.Style=="East" then x=entry.X1+offset
		elseif entry.Style=="West" then x=entry.X2-offset
		elseif entry.Style=="South" then z=entry.Z1+offset
		else z=entry.Z2-offset end
		local height=(Catalog.LEVEL_HEIGHT+0.13)*step/16
		part(parent,"StairStep",Vector3.new(if alongX then tread else width,height,if alongX then depth else tread),
			frame*CFrame.new(x,floor+height/2,z),entry)
	end
end
local function drawPiece(parent,frame,entry,pieces,builtins,site)
	local level=(entry.Level or 0)*Catalog.LEVEL_HEIGHT
	local floor=(if site=="Company" then 0 else 0.16)+level
	if entry.Kind=="Wall" then
		local host=table.clone(entry)
		host.BaseY=floor
		local openings={}
		for _,other in pieces do if other.HostId==entry.Id then table.insert(openings,other) end end
		drawWall(parent,frame,host,openings)
	elseif entry.Kind=="Stairs" then
		drawStairs(parent,frame,entry,floor)
	elseif entry.HostId then
		local host=Catalog.host(pieces,builtins,entry.HostId)
		if host then
			host=table.clone(host)
			host.BaseY=host.BaseY or (if site=="Company" then 0 else 0.16)+(host.Level or 0)*Catalog.LEVEL_HEIGHT
			drawOpening(parent,frame,entry,host)
		end
	else
		local width,depth=entry.X2-entry.X1,entry.Z2-entry.Z1
		local x,z=(entry.X1+entry.X2)/2,(entry.Z1+entry.Z2)/2
		if entry.Kind=="Floor" then
			-- New finishes sit just above the original floor, avoiding coplanar flicker.
			drawFloor(parent,frame,entry,pieces,floor+0.07,0.12)
		else
			local eave=floor+Catalog.WALL_HEIGHT+0.15
			if entry.Style=="Flat" then
				part(parent,"FlatRoof",Vector3.new(width,0.3,depth),frame*CFrame.new(x,eave,z),entry)
			elseif entry.Style=="Shed" then
				local rise=math.min(5,depth*0.24)
				local pitch=math.atan2(rise,depth)
				part(parent,"ShedRoof",Vector3.new(width+0.4,0.3,math.sqrt(depth^2+rise^2)+0.4),frame*CFrame.new(x,eave+rise/2,z)*CFrame.Angles(pitch,0,0),entry)
			else
				local rise=math.min(6,width*0.24)
				local half=width/2
				local pitch=math.atan2(rise,half)
				for _,side in {-1,1} do
					part(parent,"RoofSlope",Vector3.new(math.sqrt(half^2+rise^2)+0.3,0.3,depth+0.4),frame*CFrame.new(x+side*width/4,eave+rise/2,z)*CFrame.Angles(0,0,-side*pitch),entry)
				end
				part(parent,"RidgeCap",Vector3.new(0.3,0.3,depth+0.5),frame*CFrame.new(x,eave+rise,z),entry)
				-- Thin stacked strips close both triangular gable ends.
				for _,side in {-1,1} do
					for row=0,11 do
						local fraction=(row+0.5)/12
						part(parent,"RoofGable",Vector3.new(width*(1-fraction),rise/12+0.02,0.24),
							frame*CFrame.new(x,eave+rise*fraction,z+side*depth/2),entry)
					end
				end
			end
		end
	end
end
function Renderer.sync(model,frame,site,data)
	local builtins=Renderer.capture(model,frame,site)
	local folder=model:FindFirstChild("BuildingPieces")
	if folder then folder:Destroy() end
	folder=Instance.new("Folder")
	folder.Name="BuildingPieces"
	-- Populate off-tree so viewers never see half of a reconstructed wall.
	for id,record in captures[model] do
		local original=record.Part
		local edit=data.Overrides[id] or {}
		original.Color=if edit.Color then color(edit.Color) else record.Color
		original.Material=if edit.Material then Enum.Material[edit.Material] else record.Material
		original.Transparency=record.Transparency
		original.CanCollide,original.CanQuery,original.CanTouch=record.CanCollide,record.CanQuery,record.CanTouch
		local openings={}
		if not edit.Removed and record.Descriptor.Kind=="Wall" then
			for _,entry in data.Pieces do if entry.HostId==id then table.insert(openings,entry) end end
		end
		local floorCut=false
		if record.Descriptor.Kind=="Floor" then
			local rectangles
			rectangles,floorCut=floorRectangles(record.Descriptor,data.Pieces)
		end
		local hidden=edit.Removed or #openings>0 or floorCut
		original:SetAttribute("BuildingRemoved",hidden==true)
		if hidden then
			original.Transparency=1
			original.CanCollide,original.CanQuery,original.CanTouch=false,false,false
		end
		if #openings>0 then
			local wall=table.clone(record.Descriptor)
			wall.Material=edit.Material or wall.Material
			wall.Color=edit.Color or wall.Color
			drawWall(folder,frame,wall,openings)
		end
		if floorCut and not edit.Removed then
			local floor=table.clone(record.Descriptor)
			floor.Material=edit.Material or floor.Material
			floor.Color=edit.Color or floor.Color
			drawFloor(folder,frame,floor,data.Pieces,floor.BaseY+floor.Height/2,floor.Height,record)
		end
	end
	for _,entry in data.Pieces do
		if entry.HostId and data.Overrides[entry.HostId] and data.Overrides[entry.HostId].Removed then continue end
		drawPiece(folder,frame,entry,data.Pieces,builtins,site)
	end
	folder.Parent=model
end
function Renderer.preview(parent,frame,entry,pieces,builtins,valid,site)
	local model=Instance.new("Model")
	model.Name="StructurePreview"
	local clean=Catalog.normalize(entry)
	if not clean then model.Parent=parent return model end
	clean.Id=clean.Id or "preview"
	drawPiece(model,frame,clean,pieces or {},builtins or {},site)
	for _,piece in model:GetDescendants() do
		if piece:IsA("BasePart") then
			piece.Color=if valid then Color3.fromRGB(193,153,235) else Color3.fromRGB(239,87,94)
			piece.Material=Enum.Material.SmoothPlastic
			piece.Transparency=0.5
			piece.CanCollide,piece.CanQuery,piece.CanTouch=false,false,false
			piece.CastShadow=false
		end
	end
	model.Parent=parent
	return model
end
return Renderer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Calendar</string>
          <string name="Source"><![CDATA[-- The in-game calendar: one date per in-game day (24 real minutes) over a 365-day year of real
-- months, so a year takes about six real days. It counts from DayNight's fixed epoch, so every
-- server shows the same date and holidays such as Halloween arrive everywhere at once.
local DayNight = require(script.Parent.DayNight)

local Calendar = {}

Calendar.MONTHS = {
	"January",
	"February",
	"March",
	"April",
	"May",
	"June",
	"July",
	"August",
	"September",
	"October",
	"November",
	"December",
}
Calendar.DAYS_IN_MONTH = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 }
Calendar.DAYS_PER_YEAR = 365
Calendar.SECONDS_PER_DAY = 24 * DayNight.SECONDS_PER_HOUR

export type Date = {
	Year: number, -- 1-based
	Month: number, -- 1-12
	Day: number, -- 1-based day of the month
	DayOfYear: number, -- 1-365
	Hour: number, -- 0-24, the clock without any ClockOverride
}

-- The date `elapsed` in-game seconds after the epoch.
function Calendar.at(elapsed: number): Date
	local days = math.floor(elapsed / Calendar.SECONDS_PER_DAY)
	local years = math.floor(days / Calendar.DAYS_PER_YEAR)
	local dayOfYear = days - years * Calendar.DAYS_PER_YEAR + 1
	local month, day = 1, dayOfYear
	while day > Calendar.DAYS_IN_MONTH[month] do
		day -= Calendar.DAYS_IN_MONTH[month]
		month += 1
	end
	return {
		Year = years + 1,
		Month = month,
		Day = day,
		DayOfYear = dayOfYear,
		Hour = (elapsed - days * Calendar.SECONDS_PER_DAY) / DayNight.SECONDS_PER_HOUR,
	}
end

-- Today's date on the shared clock.
function Calendar.now(serverTime: number?): Date
	return Calendar.at(DayNight.elapsed(serverTime))
end

-- In-game seconds since the epoch at `hour` o'clock on that day.
function Calendar.elapsedAt(year: number, month: number, day: number, hour: number): number
	local dayOfYear = day
	for earlier = 1, month - 1 do
		dayOfYear += Calendar.DAYS_IN_MONTH[earlier]
	end
	local days = (year - 1) * Calendar.DAYS_PER_YEAR + dayOfYear - 1
	return days * Calendar.SECONDS_PER_DAY + hour * DayNight.SECONDS_PER_HOUR
end

-- "31 October", or "31 Oct" when short.
function Calendar.format(date: Date, short: boolean?): string
	local month = Calendar.MONTHS[date.Month]
	return string.format("%d %s", date.Day, if short then month:sub(1, 3) else month)
end

local function monthNamed(name: string): number?
	name = name:lower()
	if #name < 3 then
		return nil
	end
	for index, month in Calendar.MONTHS do
		if month:lower():sub(1, #name) == name then
			return index
		end
	end
	return nil
end

-- Reads "10-31", "10/31", "31 oct" or "october 31", optionally followed by "23:50".
-- Returns month, day and hour (nil when no time was given), or nil when it is not a real date.
function Calendar.parse(text: string): (number?, number?, number?)
	text = text:lower():gsub("^%s+", ""):gsub("%s+$", "")
	local datePart, hours, minutes = text:match("^(.-)%s+(%d%d?):(%d%d)$")
	if not datePart then
		datePart = text
	end
	local month, day
	local a, b = datePart:match("^(%d%d?)%s*[-/]%s*(%d%d?)$")
	if a then
		month, day = tonumber(a), tonumber(b)
	else
		local number, name = datePart:match("^(%d%d?)%s+(%a+)$")
		if not number then
			name, number = datePart:match("^(%a+)%s+(%d%d?)$")
		end
		month, day = if name then monthNamed(name) else nil, tonumber(number)
	end
	if not month or not day or month < 1 or month > 12 or day < 1 or day > Calendar.DAYS_IN_MONTH[month] then
		return nil, nil, nil
	end
	local hour
	if hours then
		local h, m = tonumber(hours) :: number, tonumber(minutes) :: number
		if h > 23 or m > 59 then
			return nil, nil, nil
		end
		hour = h + m / 60
	end
	return month, day, hour
end

return Calendar
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Cargo</string>
          <string name="Source"><![CDATA[-- Dredge-style cargo grid rules shared by the server (which validates every
-- placement) and the client (which previews it). Pure: no Roblox services, so the
-- saved-data tests run it directly.
--
-- Shapes and hold masks are rows of text read top to bottom: "#" is a filled
-- cell, "." is empty. Items sit at X, Y (1-based, the top-left of the rotated
-- shape's bounding box) with R quarter turns clockwise.
local Cargo = {}

-- Boat kit stowed in a hold. It can be rearranged and rotated, but never
-- released or frozen. Motors and rudders can be added at the refit dock
-- (Shared.BoatUpgrades).
Cargo.Parts = {
	Engine = { Name = "Inboard engine", Shape = { "##", "##" }, Motor = true },
	PatrolEngine = { Name = "Inboard engine", Shape = { "###", "###", "###", "###" }, Motor = true },
	-- Broad engine bed across the trawler's transom, with a twin-cell shaft trunk forward.
	TrawlerEngine = { Name = "Inboard engine", Shape = { ".##.", ".##.", "####" }, Motor = true },
	Lantern = { Name = "Deck lantern", Shape = { "#" } },
	Rudder = { Name = "Rudder", Shape = { "#", "#" } },
}

-- Species without their own Shapes in the catalog still grow with their size class.
local FALLBACK = { Normal = { "#" }, Big = { "##" }, Huge = { "##", "##" } }

-- Returns the filled cells as { dx, dy } offsets (0-based) plus the rotated width and height.
function Cargo.cells(rows: { string }, rotation: number?): ({ { number } }, number, number)
	local cells, width, height = {}, 0, #rows
	for y, row in rows do
		width = math.max(width, #row)
		for x = 1, #row do
			if string.sub(row, x, x) == "#" then
				table.insert(cells, { x - 1, y - 1 })
			end
		end
	end
	for _ = 1, (rotation or 0) % 4 do
		for index, cell in cells do
			cells[index] = { height - 1 - cell[2], cell[1] }
		end
		width, height = height, width
	end
	return cells, width, height
end

-- Accepts a hold item ({ Fish = record } or { PartId = ... }) or a bare fish record.
function Cargo.shape(item, species): { string }
	if item.PartId then
		local part = Cargo.Parts[item.PartId]
		return if part then part.Shape else FALLBACK.Normal
	end
	local fish = item.Fish or item
	local entry = species[fish.FishId]
	local shapes = if entry and entry.Shapes then entry.Shapes else FALLBACK
	return shapes[fish.Size or "Normal"] or shapes.Normal or FALLBACK.Normal
end

function Cargo.open(mask: { string }, x: number, y: number): boolean
	local row = mask[y]
	return row ~= nil and x >= 1 and string.sub(row, x, x) == "#"
end

function Cargo.capacity(mask: { string }): number
	return #Cargo.cells(mask)
end

local function key(x: number, y: number): number
	return y * 256 + x
end

-- Maps every filled cell to the index of the item covering it, ignoring `skip`
-- (the item being moved).
function Cargo.occupied(items, species, skip: number?): { [number]: number }
	local taken = {}
	for index, item in items do
		if index ~= skip then
			for _, cell in Cargo.cells(Cargo.shape(item, species), item.R) do
				taken[key(item.X + cell[1], item.Y + cell[2])] = index
			end
		end
	end
	return taken
end

function Cargo.at(taken, x: number, y: number): number?
	return taken[key(x, y)]
end

function Cargo.fits(mask: { string }, taken, shape: { string }, x: number, y: number, rotation: number): boolean
	for _, cell in Cargo.cells(shape, rotation) do
		local cx, cy = x + cell[1], y + cell[2]
		if not Cargo.open(mask, cx, cy) or taken[key(cx, cy)] then
			return false
		end
	end
	return true
end

-- Try every orientation, preferring contact with walls/cargo to limit fragmentation.
-- Existing placements (including installed kit) are preserved.
function Cargo.bestSpot(mask, items, item, species)
	local taken = Cargo.occupied(items, species)
	local shape = Cargo.shape(item, species)
	local best, bestScore = nil, -math.huge
	for rotation = 0, 3 do
		local cells = Cargo.cells(shape, rotation)
		local own = {}
		for _, cell in cells do
			own[key(cell[1], cell[2])] = true
		end
		for y, row in mask do
			for x = 1, #row do
				if not Cargo.fits(mask, taken, shape, x, y, rotation) then
					continue
				end
				local score = 0
				for _, cell in cells do
					for _, direction in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
						local dx, dy = cell[1] + direction[1], cell[2] + direction[2]
						if not own[key(dx, dy)] then
							local cx, cy = x + dx, y + dy
							if not Cargo.open(mask, cx, cy) or Cargo.at(taken, cx, cy) then
								score += 1
							end
						end
					end
				end
				if score > bestScore then
					best, bestScore = { X = x, Y = y, R = rotation }, score
				end
			end
		end
	end
	return best
end

return Cargo
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">CastTiming</string>
          <string name="Source"><![CDATA[-- Shared timing keeps the displayed power and the server's luck award in sync.
local CastTiming = {}

CastTiming.ChargeSeconds = 1
CastTiming.PerfectThreshold = 0.94
CastTiming.PerfectLuck = 0.15
CastTiming.MaxChargeSeconds = 30
CastTiming.NetworkTolerance = 0.2

function CastTiming.strength(elapsed: number): number
	local cycle = math.max(0, elapsed) / CastTiming.ChargeSeconds % 2
	return 1 - math.abs(1 - cycle)
end

function CastTiming.isPerfect(elapsed: number): boolean
	return CastTiming.strength(elapsed) + 1e-6 >= CastTiming.PerfectThreshold
end

-- The client supplies its release duration, never a trusted perfect/luck flag.
-- Compare it with the charge observed by the server, allowing network jitter.
function CastTiming.validRelease(elapsed: any, observed: number): boolean
	return type(elapsed) == "number"
		and elapsed == elapsed
		and elapsed >= 0
		and elapsed <= CastTiming.MaxChargeSeconds
		and observed >= 0
		and observed <= CastTiming.MaxChargeSeconds
		and math.abs(elapsed - observed) <= CastTiming.NetworkTolerance
end

return CastTiming
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">CatchConditions</string>
          <string name="Source"><![CDATA[-- What holds at a fishing spot right now (weather, time of day, terrain), for species with Requires keys in
-- Shared.Fish, and which area (pool) the spot is in. The server passes `at` to FishCatch.inSeason
-- and `area` to AnglerCatalog.poolAt.
local Biomes = require(script.Parent.Biomes)
local DayNight = require(script.Parent.DayNight)
local Weather = require(script.Parent.Weather)

local CatchConditions = {}

-- Light rain and heavier (Weather.getState's LightRain threshold) count as rain.
CatchConditions.RAIN = 0.06
-- Storm strength where Weather.getState starts calling a spot "Storm".
CatchConditions.STORM = 0.38
-- A beach is sand terrain this close below the water at or around the spot.
CatchConditions.BEACH_DEPTH = 10
CatchConditions.BEACH_REACH = 12

local function sandyShallow(position: Vector3): boolean
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Include
	parameters.FilterDescendantsInstances = { workspace.Terrain }
	parameters.IgnoreWater = true
	local reach = CatchConditions.BEACH_REACH
	for _, offset in
		{
			Vector3.zero,
			Vector3.new(reach, 0, 0),
			Vector3.new(-reach, 0, 0),
			Vector3.new(0, 0, reach),
			Vector3.new(0, 0, -reach),
		}
	do
		local origin = position + offset + Vector3.new(0, 4, 0)
		local result = workspace:Raycast(origin, Vector3.new(0, -(CatchConditions.BEACH_DEPTH + 4), 0), parameters)
		if result and result.Material == Enum.Material.Sand then
			return true
		end
	end
	return false
end

function CatchConditions.at(position: Vector3, serverTime: number?): { [string]: boolean }
	local weather = Weather.getState(serverTime, position)
	local rain = weather.rain > CatchConditions.RAIN
	local night = DayNight.isNight(DayNight.clockTime(serverTime))
	return {
		Rain = rain,
		Clear = not rain and weather.storm < CatchConditions.STORM,
		-- A supercell overhead counts as a storm too.
		Storm = weather.storm > CatchConditions.STORM or weather.kind == "Supercell",
		Supercell = weather.kind == "Supercell",
		BlackHole = weather.kind == "BlackHole",
		Night = night,
		Day = not night,
		Beach = sandyShallow(position),
	}
end

-- "lake" inside the main island's sheltered bay, otherwise the Shared.Biomes id there.
function CatchConditions.area(position: Vector3): string
	return if Weather.inLake(position) then "lake" else Biomes.at(position).id
end

return CatchConditions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">CompanyIslands</string>
          <string name="Source"><![CDATA[-- Property rules shared by the purchase screen, map and server transactions.
local CompanyIslands = {}

CompanyIslands.COUNT = 15
CompanyIslands.PRICE = 50000
CompanyIslands.RING_RADIUS = 1600
-- Includes the long piers and the approach to the harbour mouth.
CompanyIslands.FOOTPRINT = 245
CompanyIslands.TAG = "CompanyIsland"
CompanyIslands.Names = {
	"Pinehaven", "Gullrock", "Lantern Isle", "Saltwind", "Cedar Cay", "Anchor Isle",
	"Driftwood Isle", "Heron Point", "Mossbank", "Seabreeze Cay", "Willow Reach",
	"Mariner Isle", "Pebblehaven", "Osprey Rock", "Tidewatch",
}

function CompanyIslands.validId(id): boolean
	return type(id) == "number" and id % 1 == 0 and id >= 1 and id <= CompanyIslands.COUNT
end

function CompanyIslands.position(id: number): Vector2
	-- The western bay entrance points between two properties, preserving a
	-- shipping lane while every player has room for a separate company dock.
	local angle = math.rad(-96 + (id - 1) * 360 / CompanyIslands.COUNT)
	return Vector2.new(math.cos(angle), math.sin(angle)) * CompanyIslands.RING_RADIUS
end

function CompanyIslands.frame(id: number): CFrame
	local position = CompanyIslands.position(id)
	-- Every dock faces the main island, leaving the outer shore quiet.
	return CFrame.lookAt(Vector3.new(position.X, 0, position.Y), Vector3.zero)
end

-- The fenced building plot on the upper terrace, centred this far behind the
-- island's centre with its surface at this height (island-local studs). Its
-- frame is where company furniture is measured from (FurnitureCatalog.PLOT).
CompanyIslands.PLOT_Z = 40
CompanyIslands.PLOT_HEIGHT = 24.56

-- The terrace stair is cut into the cliff front: its foot on the beach and its head
-- on the terrace short of the plot gate, in world space for walking NPCs.
function CompanyIslands.stairEnds(islandFrame: CFrame): (Vector3, Vector3)
	return islandFrame * Vector3.new(0, 4.4, -42), islandFrame * Vector3.new(0, 24.4, 4)
end

function CompanyIslands.plotFrame(id: number): CFrame
	return CompanyIslands.frame(id) * CFrame.new(0, CompanyIslands.PLOT_HEIGHT, CompanyIslands.PLOT_Z)
end

function CompanyIslands.purchaseProblem(profile): string?
	if not profile then
		return "Your progress is still loading."
	elseif profile.Angler.CompanyIsland then
		return "You already own a company island."
	elseif not (profile.Angler.Paths and profile.Angler.Paths.Unlocked.Company) then
		return "Unlock The Company in Home > Paths first."
	elseif profile.Cash < CompanyIslands.PRICE then
		return "A company island costs $50,000."
	end
	return nil
end

-- Called inside the wallet's UpdateAsync callback; never mutates the input.
function CompanyIslands.purchase(profile, id: number)
	local problem = CompanyIslands.purchaseProblem(profile)
	if problem then
		return nil, problem
	elseif not CompanyIslands.validId(id) then
		return nil, "Choose an available company island."
	end
	local result = table.clone(profile)
	result.Angler = table.clone(profile.Angler)
	result.Angler.CompanyIsland = id
	result.Angler.Stats = table.clone(profile.Angler.Stats or {})
	result.Angler.Stats.CoinsSpent = (result.Angler.Stats.CoinsSpent or 0) + CompanyIslands.PRICE
	result.Cash -= CompanyIslands.PRICE
	return result
end

return CompanyIslands
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">CrabCages</string>
          <string name="Source"><![CDATA[-- Crab cage rules shared by the server (which saves every change), the client
-- (which previews where a cage may go) and scripts/crab-cages.luau. Cages are
-- bought at Tide & Tackle and wait in Angler.CrabCages.Stock until the angler
-- drops one into the water by their own dock. A placed cage catches one crab per
-- soak and wears out after USES hauls. Pure Luau: no Roblox globals.
local CrabCages = {}

CrabCages.PRICE = 35
CrabCages.USES = 3
-- A crab crawls in somewhere between one and three minutes after each drop.
CrabCages.SOAK_MIN, CrabCages.SOAK_MAX = 60, 180
CrabCages.MAX_STOCK = 25
CrabCages.MAX_PLACED = 6
CrabCages.SPACING = 4.5 -- studs between neighbouring cages
CrabCages.REACH = 16 -- studs from the angler to where the cage lands
-- Added to the normal mutation chance, giving crabs an extra 0.25 percentage points.
CrabCages.MUTATION_BONUS = 0.0025
-- Water round the base's piers in dock-local studs (BoatDockFrame: -Z is the
-- water, the piers run along x = +-17 from z = 5 to -43). It stops short of the
-- fisherman's moorings at x = +-28 and the boat spawn past the pier ends.
CrabCages.ZONE = { MinX = -24, MaxX = 24, MinZ = -42, MaxZ = 6 }
-- What a cage can catch. FishCatch.roll weighs these by rarity like any pool;
-- no fishing pool lists them, so crabs only ever come from cages.
CrabCages.Pool = { Name = "Crab Cage", Fish = { "ShoreCrab", "BlueCrab", "KingCrab" } }

-- Spots are kept to a tenth of a stud, so a cage's saved spot doubles as its id.
function CrabCages.round(value: number): number
	return math.round(value * 10) / 10
end

-- Cage-local points that must all be open water: the middle, the corners with a
-- little clearance and the marker float beside it. `size` is the cage's size.
-- Builds Vector3s, so only call it in Roblox.
function CrabCages.footprint(size: Vector3): { Vector3 }
	local half = size / 2 + Vector3.new(0.4, 0, 0.4)
	return {
		Vector3.zero,
		Vector3.new(half.X, 0, half.Z),
		Vector3.new(-half.X, 0, half.Z),
		Vector3.new(half.X, 0, -half.Z),
		Vector3.new(-half.X, 0, -half.Z),
		Vector3.new(size.X / 2 + 0.7, 0, size.Z / 2 - 0.35),
	}
end

-- `rng` returns a uniform [0, 1). Whole seconds, both ends included.
function CrabCages.soak(rng: () -> number): number
	return CrabCages.SOAK_MIN + math.floor(rng() * (CrabCages.SOAK_MAX - CrabCages.SOAK_MIN + 1))
end

function CrabCages.find(angler, x: number, z: number): (number?, any)
	for index, cage in angler.CrabCages.Placed do
		if math.abs(cage.X - x) < 0.05 and math.abs(cage.Z - z) < 0.05 then
			return index, cage
		end
	end
	return nil, nil
end

-- `profile` is the whole wallet profile: the price comes out of its Cash.
function CrabCages.buyProblem(profile): string?
	if profile.Angler.CrabCages.Stock >= CrabCages.MAX_STOCK then
		return string.format("You can carry up to %d crab cages. Set some out first.", CrabCages.MAX_STOCK)
	elseif profile.Cash < CrabCages.PRICE then
		return string.format("You need $%d for a crab cage.", CrabCages.PRICE)
	end
	return nil
end

-- These mutate the table they are given: the profile copy inside a save.
function CrabCages.buy(profile)
	local problem = CrabCages.buyProblem(profile)
	assert(problem == nil, problem)
	profile.Cash -= CrabCages.PRICE
	profile.Angler.Stats.CoinsSpent += CrabCages.PRICE
	profile.Angler.CrabCages.Stock += 1
end

-- Only the dock-local spot; the server also checks there is open water there.
function CrabCages.zoneProblem(x: number, z: number): string?
	local zone = CrabCages.ZONE
	if x ~= x or z ~= z or x < zone.MinX or x > zone.MaxX or z < zone.MinZ or z > zone.MaxZ then
		return "Drop crab cages in the water by your own dock."
	end
	return nil
end

function CrabCages.placeProblem(angler, x: number, z: number): string?
	local cages = angler.CrabCages
	if cages.Stock < 1 then
		return "You have no crab cages. Buy one at Tide & Tackle."
	elseif #cages.Placed >= CrabCages.MAX_PLACED then
		return string.format("You already have %d cages out. Pull one up first.", CrabCages.MAX_PLACED)
	end
	local problem = CrabCages.zoneProblem(x, z)
	if problem then
		return problem
	end
	x, z = CrabCages.round(x), CrabCages.round(z)
	local neighbours = table.clone(cages.Placed)
	for _, other in (angler.MusselNets and angler.MusselNets.Placed or {}) do
		table.insert(neighbours, other)
	end
	for _, cage in neighbours do
		if (cage.X - x) ^ 2 + (cage.Z - z) ^ 2 < CrabCages.SPACING ^ 2 then
			return "That's too close to another cage."
		end
	end
	return nil
end

-- `soak` is rolled before saving, so every save retry sets the same timer.
function CrabCages.place(angler, x: number, z: number, now: number, soak: number)
	local problem = CrabCages.placeProblem(angler, x, z)
	assert(problem == nil, problem)
	angler.CrabCages.Stock -= 1
	table.insert(angler.CrabCages.Placed, {
		X = CrabCages.round(x),
		Z = CrabCages.round(z),
		Uses = CrabCages.USES,
		ReadyAt = now + soak,
	})
end

-- Seconds until a crab is in, or 0 once the cage is ready to pull up.
function CrabCages.remaining(cage, now: number): number
	return math.max(0, cage.ReadyAt - now)
end

function CrabCages.collectProblem(angler, x: number, z: number, now: number): string?
	local _, cage = CrabCages.find(angler, x, z)
	if not cage then
		return "That crab cage is gone."
	elseif now < cage.ReadyAt then
		return "Nothing has crawled in yet. Give it a moment."
	end
	return nil
end

-- Returns the hauls the cage has left. At 0 it has worn out and is removed.
function CrabCages.collect(angler, x: number, z: number, now: number, soak: number): number
	local problem = CrabCages.collectProblem(angler, x, z, now)
	assert(problem == nil, problem)
	local index, cage = CrabCages.find(angler, x, z)
	angler.Stats.CrabCagesOpened += 1
	cage.Uses -= 1
	if cage.Uses <= 0 then
		table.remove(angler.CrabCages.Placed, index)
		return 0
	end
	cage.ReadyAt = now + soak
	return cage.Uses
end

return CrabCages
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">DayNight</string>
          <string name="Source"><![CDATA[-- One server clock drives the time of day on every client and the night-only
-- catch rules on the server. It runs off one fixed epoch rather than each server's
-- start, so every server shares the same hour and the same calendar date (Calendar).
local DayNight = {}

-- One in-game hour per real minute: a full day takes 24 minutes.
DayNight.SECONDS_PER_HOUR = 60
-- In-game midnight on 1 January of year 1: 2026-01-01 00:00 UTC.
DayNight.EPOCH = 1767225600
-- Night, for catch rules, runs from NIGHT_START to NIGHT_END.
DayNight.NIGHT_START = 18
DayNight.NIGHT_END = 6
-- Lighting fades over these twilight windows (hours).
DayNight.DUSK = { 17.5, 19.5 }
DayNight.DAWN = { 4.5, 6.5 }

local function smoothstep(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

-- In-game seconds since the epoch. A CalendarOffset attribute on workspace shifts the whole
-- calendar (the admin /set date command), and the clock keeps running from there.
function DayNight.elapsed(serverTime: number?): number
	local offset = workspace:GetAttribute("CalendarOffset")
	return (serverTime or workspace:GetServerTimeNow()) - DayNight.EPOCH + (if type(offset) == "number" then offset else 0)
end

-- Clock hour (0-24) after `elapsed` seconds since the epoch, which fell at midnight.
function DayNight.clockAt(elapsed: number): number
	return (elapsed / DayNight.SECONDS_PER_HOUR) % 24
end

-- The current clock hour. A ClockOverride attribute on workspace pins it (Studio previews).
function DayNight.clockTime(serverTime: number?): number
	local override = workspace:GetAttribute("ClockOverride")
	if type(override) == "number" then
		return override % 24
	end
	return DayNight.clockAt(DayNight.elapsed(serverTime))
end

function DayNight.isNight(clock: number): boolean
	return clock >= DayNight.NIGHT_START or clock < DayNight.NIGHT_END
end

-- 0 in full daylight, 1 in deep night, easing through dusk and dawn.
function DayNight.darkness(clock: number): number
	local dusk = smoothstep((clock - DayNight.DUSK[1]) / (DayNight.DUSK[2] - DayNight.DUSK[1]))
	local dawn = 1 - smoothstep((clock - DayNight.DAWN[1]) / (DayNight.DAWN[2] - DayNight.DAWN[1]))
	return if clock >= 12 then dusk else dawn
end

return DayNight
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="27">
        <Properties>
          <string name="Name">Fish</string>
        </Properties>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Albacore</string>
            <string name="Source"><![CDATA[return {
	Name = "Albacore",
	Rarity = "Epic",
	RarityDenominator = 30,
	MinKg = 4,
	AverageKg = 15,
	MaxKg = 45,
	BaseValue = 380,
	Fight = 0.07,
	Pools = { "OpenSea" },
	Seasons = { "Autumn", "Winter" },
	Shapes = {
		Normal = { "###", "###" },
		Big = { "####", "####" },
		Huge = { ".####.", "######", ".####." },
	},
	-- Long-finned tuna: dark blue back and pectorals that reach past the second dorsal.
	Build = function(b, kit)
		local rgb, v2 = kit.rgb, kit.v2
		local colors = { back = rgb(20, 32, 66), side = rgb(140, 152, 172), belly = rgb(236, 238, 240) }
		local fin = rgb(32, 44, 76)
		b:fishBody(0.245, 0.18, colors, 0.03)
		b:edgeFin(0.14, 0.02, { 0.08, 0.06, 0.03 }, fin, false, 0.05)
		b:fin({ v2(-0.01, b:top(-0.01) - 0.008), v2(-0.1, b:top(-0.01) + 0.1), v2(-0.08, b:top(-0.08) - 0.008) }, fin)
		b:fin({
			v2(-0.03, b:bottom(-0.03) + 0.008),
			v2(-0.12, b:bottom(-0.03) - 0.09),
			v2(-0.09, b:bottom(-0.09) + 0.008),
		}, fin)
		for index = 0, 5 do
			local x = -0.15 - index * 0.03
			for _, below in { false, true } do
				local edge = if below then b:bottom(x) else b:top(x)
				local sign = if below then -1 else 1
				b:fin({
					v2(x + 0.008, edge - sign * 0.004),
					v2(x - 0.012, edge + sign * 0.02),
					v2(x - 0.014, edge - sign * 0.004),
				}, rgb(120, 116, 80))
			end
		end
		b:lunateTail(0.23, fin)
		-- Very long pectoral fins are the albacore's trademark.
		b:pectoral(0.21, 0.01, 0.34, 0.06, fin)
		b:stroke({ v2(0.28, 0.03), v2(0, 0.035), v2(-0.28, 0.01) }, 0.012, rgb(100, 130, 180))
		b:face(0.37, 0.03, 0.05, rgb(170, 170, 150), rgb(60, 70, 100))
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Anchovy</string>
            <string name="Source"><![CDATA[return {
	Name = "Anchovy",
	Rarity = "Common",
	RarityDenominator = 4,
	MinKg = 0.01,
	AverageKg = 0.04,
	MaxKg = 0.18,
	BaseValue = 17,
	Fight = 0.05,
	Pools = { "OpenSea" },
	Seasons = { "Summer" },
	Shapes = {
		Normal = { "#" },
		Big = { "#" },
		Huge = { "##" },
	},
	Build = function(b, kit)
		local rgb, v2 = kit.rgb, kit.v2
		local colors = { back = rgb(70, 112, 104), side = rgb(196, 204, 196), belly = rgb(236, 238, 232) }
		local fin = rgb(176, 184, 176)
		b:fishBody(0.15, 0.09, colors, 0.02)
		b:edgeFin(0.04, -0.06, { 0.05, 0.04, 0.025 }, fin, false, 0.25)
		b:edgeFin(-0.06, -0.2, { 0.025, 0.025, 0.02 }, fin, true, 0.25)
		b:forkTail(0.11, 0.08, fin, 0.2)
		b:pectoral(0.22, -0.035, 0.06, 0.02, fin, 0.25)
		b:stroke({ v2(0.24, 0), v2(-0.32, 0) }, 0.016, rgb(214, 224, 228))
		-- Rounded snout overhanging a long jaw.
		b:ellipsoid("Snout", CFrame.new(0.47, 0.012, 0), Vector3.new(0.07, 0.05, 0.05), colors.back)
		b:face(0.39, 0.015, 0.058, rgb(200, 206, 200), rgb(130, 140, 134))
		b:stroke({ v2(0.46, -0.012), v2(0.34, -0.028) }, 0.006, rgb(40, 40, 36))
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Angelfish</string>
            <string name="Source"><![CDATA[return {
	Name = "Angelfish",
	Rarity = "Uncommon",
	RarityDenominator = 9,
	MinKg = 0.08,
	AverageKg = 0.25,
	MaxKg = 1.2,
	BaseValue = 28,
	Fight = 0.03,
	Pools = { "MainLake" },
	Seasons = { "Summer" },
	Shapes = {
		Normal = { "#" },
		Big = { "#", "#" },
		Huge = { "#.", "##", "#." },
	},
	Build = function(b, kit)
		local rgb, v2 = kit.rgb, kit.v2
		local colors = { back = rgb(184, 186, 180), side = rgb(216, 218, 216), belly = rgb(238, 240, 240) }
		local fin = rgb(206, 208, 206)
		b:fishBody(0.5, 0.07, colors, 0.12)
		b:fin({ v2(0.16, 0.2), v2(-0.02, 0.42), v2(-0.36, 0.66), v2(-0.26, 0.26), v2(-0.24, 0.1) }, fin, 0.2)
		b:fin({ v2(0.1, -0.2), v2(-0.04, -0.42), v2(-0.36, -0.66), v2(-0.26, -0.26), v2(-0.24, -0.1) }, fin, 0.2)
		b:roundTail(0.13, fin, 0.2)
		for _, side in { 1, -1 } do
			b:limb(
				Vector3.new(0.14, -0.2, side * 0.02),
				Vector3.new(0.0, -0.66, side * 0.03),
				0.008,
				rgb(226, 224, 214),
				"Filament"
			)
		end
		for _, tip in { v2(-0.6, 0.22), v2(-0.6, -0.22) } do
			b:limb(Vector3.new(-0.46, tip.Y * 0.5, 0), Vector3.new(tip.X, tip.Y, 0), 0.006, fin, "Filament")
		end
		local dark = rgb(26, 26, 30)
		b:stroke({ v2(0.33, b:top(0.33) - 0.01), v2(0.33, b:bottom(0.33) + 0.01) }, 0.045, dark)
		b:stroke({ v2(0.1, b:top(0.1) - 0.01), v2(0.08, b:bottom(0.08) + 0.01) }, 0.055, dark)
		b:stroke({ v2(-0.15, b:top(-0.15) - 0.01), v2(-0.17, b:bottom(-0.17) + 0.01) }, 0.045, dark)
		b:rays(v2(0.09, 0.22), { v2(-0.12, 0.5) }, dark)
		b:rays(v2(0.07, -0.22), { v2(-0.12, -0.5) }, dark)
		b:rays(v2(-0.15, 0.17), { v2(-0.3, 0.55) }, dark)
		b:rays(v2(-0.17, -0.17), { v2(-0.3, -0.55) }, dark)
		b:pectoral(0.2, -0.02, 0.09, 0.03, fin, 0.3)
		b:face(0.37, 0.06, 0.05, rgb(196, 70, 54), rgb(170, 170, 160))
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">ArrowSquid</string>
            <string name="Source"><![CDATA[return {
	Name = "Arrow Squid",
	Rarity = "Rare",
	RarityDenominator = 20,
	MinKg = 0.3,
	AverageKg = 1,
	MaxKg = 6,
	BaseValue = 60,
	Fight = 0.04,
	Pools = { "MainLake" },
	Seasons = { "Summer" },
	Shapes = {
		Normal = { "#.", "##" },
		Big = { "#..", "###" },
		Huge = { "#...", "####", "#..." },
	},
	Build = function(b, kit)
		local rgb, v2 = kit.rgb, kit.v2
		local colors = { back = rgb(176, 94, 84), side = rgb(206, 134, 120), belly = rgb(236, 206, 194) }
		b:layered("Mantle", Vector3.new(0.17, 0, 0), Vector3.new(0.6, 0.15, 0.15), colors)
		b:layered("MantleTip", Vector3.new(0.42, 0, 0), Vector3.new(0.2, 0.075, 0.075), colors)
		b:body("MantlePoint", Vector3.new(0.5, 0, 0), Vector3.new(0.09, 0.034, 0.034), colors.side)
		b:body("Head", Vector3.new(-0.15, 0, 0), Vector3.new(0.14, 0.11, 0.12), colors.side)
		b:ellipsoid("Collar", CFrame.new(-0.11, 0, 0), Vector3.new(0.06, 0.13, 0.135), colors.back)
		local finColor = rgb(214, 152, 136)
		-- Rhomboid fins wrapping the rear third of the mantle.
		for _, side in { 1, -1 } do
			b:fin({
				Vector3.new(0.53, 0, 0),
				Vector3.new(0.45, 0, side * 0.1),
				Vector3.new(0.38, 0, side * 0.135),
				Vector3.new(0.3, 0, side * 0.09),
				Vector3.new(0.25, 0, side * 0.03),
				Vector3.new(0.25, 0, 0),
			}, finColor, 0.12)
		end
		b:speckle(70, v2(-0.08, 0.5), v2(-0.07, 0.075), v2(0.007, 0.016), rgb(128, 52, 46))
		b:stroke({ v2(0.48, 0.02), v2(0.0, 0.07) }, 0.006, rgb(150, 70, 62))
		b:eye(-0.15, 0.008, 0.07, rgb(172, 192, 204))
		local armColor = rgb(212, 142, 128)
		for index = 0, 7 do
			local angle = index / 8 * math.pi * 2
			local spread = Vector3.new(0, math.cos(angle), math.sin(angle))
			local root = Vector3.new(-0.2, 0, 0) + spread * 0.035
			local middle = Vector3.new(-0.34, -0.01, 0) + spread * 0.055
			local tip = Vector3.new(-0.47 + math.abs(math.sin(angle)) * 0.03, -0.03, 0) + spread * 0.045
			b:limb(root, middle, 0.028, armColor, "Arm")
			b:limb(middle, tip, 0.017, armColor, "Arm")
			for step = 1, 3 do
				local sucker = root:Lerp(middle, step / 4) - spread * 0.012
				b:ellipsoid("Sucker", CFrame.new(sucker), Vector3.one * 0.008, rgb(238, 210, 196))
			end
		end
		for _, side in { 1, -1 } do
			local root, middle = Vector3.new(-0.2, -0.01, side * 0.015), Vector3.new(-0.42, -0.05, side * 0.04)
			local club = Vector3.new(-0.62, -0.03, side * 0.05)
			b:limb(root, middle, 0.012, armColor, "Tentacle")
			b:limb(middle, club, 0.01, armColor, "Tentacle")
			b:ellipsoid(
				"TentacleClub",
				CFrame.lookAt(club, club + Vector3.xAxis),
				Vector3.new(0.022, 0.026, 0.07),
				armColor
			)
		end
		b.model:SetAttribute("ViewDirection", Vector3.new(0.1, 0.65, 1))
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Batfish</string>
            <string name="Source"><![CDATA[return {
	Name = "Batfish",
	Rarity = "Uncommon",
	RarityDenominator = 12,
	MinKg = 0.2,
	AverageKg = 0.8,
	MaxKg = 4,
	BaseValue = 34,
	Fight = 0.04,
	Pools = { "MainLake", "GullhavenSound" },
	Seasons = { "Summer" },
	Requires = { "Rain" },
	Shapes = {
		Normal = { "#" },
		Big = { "#", "#" },
		Huge = { "#.", "##", "#." },
	},
	Build = function(b, kit)
		local rgb, v2 = kit.rgb, kit.v2
		local colors = { back = rgb(96, 96, 100), side = rgb(196, 198, 196), belly = rgb(232, 232, 226) }
		local fin = rgb(58, 56, 62)
		local dark = rgb(34, 32, 38)
		local pale = rgb(206, 206, 200)
		-- Wider, strongly compressed disc body with a small head; the extra
		-- Z depth keeps it looking chunky from the side and full head-on.
		b:fishBody(0.52, 0.14, colors, 0.12)
		-- Tall leading dorsal lobe and long-based anal fin, both dark like a
		-- spadefish, with ray rods fanning through the membranes.
		b:edgeFin(0.16, -0.18, { 0.13, 0.17, 0.15, 0.1, 0.07, 0.05 }, fin, false, 0.05)
		b:edgeFin(0.02, -0.16, { 0.11, 0.1, 0.07, 0.05 }, fin, true, 0.05)
		b:rays(v2(0.08, b:top(0.08) + 0.01), { v2(-0.02, b:top(-0.02) + 0.16), v2(-0.09, b:top(-0.09) + 0.12), v2(-0.16, b:top(-0.16) + 0.06) }, rgb(78, 76, 82))
		b:rays(v2(0.06, b:bottom(0.06) - 0.01), { v2(-0.04, b:bottom(-0.04) - 0.11), v2(-0.12, b:bottom(-0.12) - 0.06) }, rgb(78, 76, 82))
		-- Short pelvic filaments dangling below the chest.
		for _, side in { 1, -1 } do
			b:limb(
				Vector3.new(0.16, b:bottom(0.16) + 0.02, side * 0.02),
				Vector3.new(0.1, b:bottom(0.16) - 0.17, side * 0.04),
				0.008,
				fin,
				"Filament"
			)
			b:limb(
				Vector3.new(0.12, b:bottom(0.12) + 0.015, side * 0.018),
				Vector3.new(0.06, b:bottom(0.12) - 0.12, side * 0.03),
				0.006,
				fin,
				"Filament"
			)
		end
		b:forkTail(0.14, 0.04, fin)
		b:pectoral(0.2, -0.02, 0.1, 0.04, fin, 0.2)
		-- Pale margin along the trailing edges of the dark fins.
		b:stroke({ v2(-0.17, b:top(-0.17) + 0.13), v2(-0.2, b:top(-0.2) + 0.035) }, 0.014, pale)
		b:stroke({ v2(-0.15, b:bottom(-0.15) - 0.1), v2(-0.18, b:bottom(-0.18) - 0.03) }, 0.014, pale)
		-- Two to three broad dark vertical bands across the silvery flank,
		-- each one slightly wavy with a paler inner core like juvenile spades.
		b:stroke({ v2(0.2, b:top(0.2) - 0.012), v2(0.19, b:bottom(0.19) + 0.012) }, 0.06, dark)
		b:stroke({ v2(0.205, b:top(0.205) - 0.03), v2(0.19, 0.0) }, 0.022, rgb(120, 118, 120))
		b:stroke({ v2(-0.02, b:top(-0.02) - 0.012), v2(-0.03, b:bottom(-0.03) + 0.012) }, 0.075, dark)
		b:stroke({ v2(-0.015, b:top(-0.015) - 0.03), v2(-0.03, 0.0) }, 0.026, rgb(120, 118, 120))
		b:stroke({ v2(-0.22, b:top(-0.22) - 0.012), v2(-0.23, b:bottom(-0.23) + 0.012) }, 0.055, dark)
		b:stroke({ v2(-0.215, b:top(-0.215) - 0.025), v2(-0.228, 0.0) }, 0.018, rgb(120, 118, 120))
		-- Soft speckling over the back between the bands, plus a silver
		-- shimmer of tiny bright flecks along the upper flank.
		b:speckle(28, v2(-0.3, 0.3), v2(0.02, 0.2), v2(0.008, 0.016), rgb(120, 120, 126))
		b:speckle(18, v2(-0.28, 0.32), v2(0.0, 0.14), v2(0.005, 0.009), rgb(240, 242, 240))
		-- Faint darker edging above each eye for the classic spadefish brow.
		b:marks(0.37, 0.09, 0.05, 0.014, rgb(96, 94, 98))
		-- Small protruding mouth and a bright silvery iris.
		b:face(0.37, 0.05, 0.045, rgb(214, 210, 190), rgb(140, 138, 130))
		b:marks(0.45, -0.045, 0.032, 0.02, rgb(52, 48, 50))
		-- Chin barbel bump and a pale pelvic patch between the filaments.
		b:marks(0.42, b:bottom(0.42) * 0.6, 0.02, 0.016, rgb(148, 146, 148))
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
