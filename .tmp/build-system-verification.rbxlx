        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Crimsonfish</string>
            <string name="Source"><![CDATA[return {
	Name = "Crimsonfish",
	Rarity = "Rare",
	RarityDenominator = 15,
	MinKg = 0.3,
	AverageKg = 1.2,
	MaxKg = 8,
	BaseValue = 100,
