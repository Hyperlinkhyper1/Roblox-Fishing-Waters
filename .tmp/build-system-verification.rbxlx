		ring("AirHose", 0.48, F(0, 0.73, 0.36), rgb(24, 35, 39))
		cylinder("DiveGaugeRim", 0.2, 0.1, F(0, -0.2, 0.68) * CFrame.Angles(math.pi / 2, 0, 0), brass, M.Metal)
		cylinder(
			"DiveGaugeFace",
			0.16,
			0.03,
			F(0, -0.2, 0.75) * CFrame.Angles(math.pi / 2, 0, 0),
