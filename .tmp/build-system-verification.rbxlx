-- "" puts the plain starter rod back on.
local function equipRodSkin(player: Player, skinId: any): (boolean, string)
	local serial
	if type(skinId) == "table" then
		serial = skinId.Serial
		skinId = skinId.SkinId
		if type(serial) ~= "number" or serial < 1 or serial >= 2 ^ 53 or serial % 1 ~= 0 then
			return false, "That skin serial isn't valid."
		end
	end
	local wanted = if skinId == "" then nil else skinId
	if wanted ~= nil and not RodSkins.valid(wanted) then
		return false, "That rod skin doesn't exist."
	end
	if
		(player:GetAttribute("RodSkin") or "") == (wanted or "")
		and (serial == nil or player:GetAttribute("RodSkinSerial") == serial)
	then
		return true, "Already equipped."
	end
	local profile = BoatService.getProfile(player)
	if not profile then
		return false, "Your inventory is still loading. Try again in a moment."
	end
	if BoatData.equipRodSkin(profile, wanted, serial) ~= "Equipped" then
		return false, "You don't own that rod skin yet."
	end
	local ok, message = BoatService.updateProgress(player, function(current)
		local result = BoatData.equipRodSkin(current, wanted, serial)
		assert(result == "Equipped", result)
	end)
	if not ok then
		return false, message
	end
	return true, if wanted then RodSkins.Skins[wanted].Name .. " equipped!" else "Starter rod look equipped."
end

local function equipBobberSkin(player: Player, skinId: any): (boolean, string)
	local wanted = if skinId == "" then nil else skinId
	if wanted ~= nil and not BobberSkins.valid(wanted) then
		return false, "That bobber skin doesn't exist."
	end
	local profile = BoatService.getProfile(player)
	if not profile then
		return false, "Your inventory is still loading. Try again in a moment."
	end
	if BoatData.equipBobberSkin(profile, wanted) ~= "Equipped" then
		return false, "You don't own that bobber skin yet."
	end
	local ok, message = BoatService.updateProgress(player, function(current)
		assert(BoatData.equipBobberSkin(current, wanted) == "Equipped", "Bobber is not owned")
	end)
	if not ok then
		return false, message
	end
	return true, if wanted then BobberSkins.Skins[wanted].Name .. " equipped!" else "Starter bobber equipped."
end

local function claimGroupReward(player: Player, automatic: boolean?)
	local state = states[player]
	if not state or state.groupBusy then
		return
	end
	local profile = BoatService.getProfile(player)
	if not profile then
		if not automatic then
			notify(player, "Your inventory is still loading. Try again shortly.")
		end
		return
	end
	if profile.GroupRodClaimed or (profile.RodSkins and profile.RodSkins[RodSkins.GroupReward]) then
		if not automatic then
			notify(player, "Your Tidebound Rod is already in your equipment bag!")
		end
		return
	end
	if os.clock() - state.lastGroupCheck < 5 then
		if not automatic then
			notify(player, "Please wait a few seconds before checking your group reward again.")
		end
		return
	end
	state.groupBusy, state.lastGroupCheck = true, os.clock()
	local ok, member = pcall(function()
		return player:IsInGroupAsync(RodSkins.GroupId)
	end)
	if states[player] ~= state or player.Parent ~= Players then
		return
	end
	if not ok or not member then
		state.groupBusy = false
		if not automatic then
			notify(
				player,
				if not ok
					then "Group membership couldn't be checked. Please try again."
					else "Join our group to claim! If you just joined, wait a minute and claim again, or rejoin the game."
			)
		end
		return
	end
	local outcome, serial
	local saved, message = BoatService.updateProgress(player, function(current, reservedSerial)
		outcome, serial = BoatData.claimGroupRod(current, reservedSerial)
	end, RodSkins.GroupReward)
	state.groupBusy = false
	if not saved then
		notify(player, message .. " Claim your group rod again from the equipment bag.")
	elseif outcome == "Claimed" then
		notify(
			player,
			string.format(
				"Group reward: Tidebound Rod · Serial #%06d! +7.5%% speed & strength. Find it in your equipment bag.",
				serial
			)
		)
	elseif not automatic then
		notify(player, "Your Tidebound Rod is already in your equipment bag!")
	end
end

local function wantedSkin(player: Player): string
	local skin = player:GetAttribute("RodSkin")
	return if RodSkins.valid(skin) then skin else ""
end

local function ownsRod(player: Player): boolean
	return player:GetAttribute("BoatDataStatus") == "Ready" and player:GetAttribute("OwnsStarterRod") == true
end

local function wantedBobber(player: Player): string
	local skin = player:GetAttribute("BobberSkin")
	return if BobberSkins.valid(skin) then skin else ""
end

local function ensureTool(player: Player): Tool?
	local character = livingCharacter(player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not ownsRod(player) or not character or not backpack then
		player:SetAttribute("RodEquipped", false)
		return nil
	end
	local rod: Tool? = nil
	-- Prefer the equipped instance. Repeated requests never duplicate a Tool.
	for _, container in { character, backpack } do
		for _, child in container:GetChildren() do
			if child:IsA("Tool") and child:GetAttribute("RodId") == "StarterRod" then
				if rod then
					child:Destroy()
				else
					rod = child
				end
			end
		end
	end
	-- A changed skin swaps the whole Tool, keeping it in the hand it was in.
	local wasEquipped = false
	if
		rod
		and (
			(rod:GetAttribute("RodSkin") or "") ~= wantedSkin(player)
			or (rod:GetAttribute("BobberSkin") or "") ~= wantedBobber(player)
			or (wantedSkin(player) ~= "" and rod:GetAttribute("RodSkinWear") ~= player:GetAttribute("RodSkinWear"))
		)
	then
		wasEquipped = rod.Parent == character
		rod:Destroy()
		rod = nil
	end
	if not rod then
		local skin = wantedSkin(player)
		local bobber = wantedBobber(player)
		rod = FishingRod.build(
			if skin ~= "" then skin else nil,
			if bobber ~= "" then bobber else nil,
			player:GetAttribute("RodSkinWear")
		)
		rod:SetAttribute("OwnerUserId", player.UserId)
		rod.Parent = backpack
		local humanoid = (character :: Model):FindFirstChildOfClass("Humanoid")
		if wasEquipped and humanoid then
			humanoid:EquipTool(rod)
		end
	end
	player:SetAttribute("RodEquipped", rod.Parent == character)
	return rod
end

local function ensureSpear(player: Player)
	local character = livingCharacter(player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if
		player:GetAttribute("BoatDataStatus") ~= "Ready"
		or not player:GetAttribute("OwnsBasicSpear")
		or not character
		or not backpack
	then
		return
	end
	local spear: Tool? = nil
	for _, container in { character, backpack } do
		for _, child in container:GetChildren() do
			if child:IsA("Tool") and child:GetAttribute("SpearId") == Spears.ID then
				if spear then
					child:Destroy()
				else
					spear = child
				end
			end
		end
	end
	local skin = player:GetAttribute("SpearSkin") or ""
	local wear = player:GetAttribute("SpearSkinWear")
	if
		spear
		and (
			(spear:GetAttribute("SpearSkin") or "") ~= skin
			or (skin ~= "" and spear:GetAttribute("SpearSkinWear") ~= wear)
		)
	then
		local wasEquipped = spear.Parent == character
		spear:Destroy()
		spear = Spears.build(skin, wear)
		spear:SetAttribute("OwnerUserId", player.UserId)
		spear.Parent = backpack
		if wasEquipped then
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid:EquipTool(spear)
			end
		end
	end
	if not spear then
		spear = Spears.build(skin, wear)
		spear:SetAttribute("OwnerUserId", player.UserId)
		spear.Parent = backpack
	end
end

local function equip(player: Player)
	local character, humanoid = livingCharacter(player)
	if not character or not humanoid then
		return
	end
	local rod = ensureTool(player)
	if rod then
		humanoid:EquipTool(rod)
		player:SetAttribute("RodEquipped", rod.Parent == character)
	else
		notify(player, "Your starter rod is still loading. Please try again shortly.")
	end
end

local function disconnect(connections)
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
end

local function bindPlayer(player: Player)
	if states[player] then
		return
	end
	local state = {
		connections = {},
		characterConnections = {},
		backpackConnections = {},
		queued = false,
		lastRequest = -math.huge,
		lastDoor = -math.huge,
		lastGroupCheck = -math.huge,
	}
	states[player] = state
	local function checkGroupReward()
		if player:GetAttribute("BoatDataStatus") == "Ready" and not state.groupChecked then
			state.groupChecked = true
			task.spawn(claimGroupReward, player, true)
		end
	end
	table.insert(state.connections, player:GetAttributeChangedSignal("BoatDataStatus"):Connect(checkGroupReward))
	checkGroupReward()
	player:SetAttribute("RodEquipped", false)
	local function scheduleSync()
		if state.queued then
			return
		end
		state.queued = true
		task.defer(function()
			state.queued = false
			if states[player] == state and player.Parent == Players then
				ensureTool(player)
				ensureSpear(player)
			end
		end)
	end
	local function bindBackpack(backpack: Instance)
		disconnect(state.backpackConnections)
		table.insert(state.backpackConnections, backpack.ChildAdded:Connect(scheduleSync))
		table.insert(state.backpackConnections, backpack.ChildRemoved:Connect(scheduleSync))
		scheduleSync()
	end
	local function bindCharacter(character: Model)
		disconnect(state.characterConnections)
		player:SetAttribute("RodEquipped", false)
		table.insert(state.characterConnections, character.ChildAdded:Connect(scheduleSync))
		table.insert(state.characterConnections, character.ChildRemoved:Connect(scheduleSync))
		task.spawn(function()
			local humanoid = character:WaitForChild("Humanoid", 10)
			character:WaitForChild("HumanoidRootPart", 10)
			if states[player] ~= state or player.Character ~= character then
				return
			end
			if humanoid and humanoid:IsA("Humanoid") then
				table.insert(
					state.characterConnections,
					humanoid.Died:Connect(function()
						player:SetAttribute("RodEquipped", false)
					end)
				)
			end
			scheduleSync()
		end)
	end
	for _, attribute in { "BoatDataStatus", "OwnsStarterRod", "OwnsBasicSpear", "SpearSkin", "SpearSkinWear", "RodSkin", "RodSkinWear", "BobberSkin" } do
		table.insert(state.connections, player:GetAttributeChangedSignal(attribute):Connect(scheduleSync))
	end
	table.insert(state.connections, player.CharacterAdded:Connect(bindCharacter))
	table.insert(
		state.connections,
		player.CharacterRemoving:Connect(function()
			disconnect(state.characterConnections)
			player:SetAttribute("RodEquipped", false)
		end)
	)
	table.insert(
		state.connections,
		player.ChildAdded:Connect(function(child)
			if child:IsA("Backpack") then
				bindBackpack(child)
			end
		end)
	)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		bindBackpack(backpack)
	end
	if player.Character then
		bindCharacter(player.Character)
	end
end

function FishingService.start()
	if started then
		return
	end
	started = true
	local remotes = Instance.new("Folder")
	remotes.Name, remotes.Parent = "Fishing", ReplicatedStorage
	local request = Instance.new("RemoteEvent")
	request.Name, request.Parent = "Request", remotes
	feedback = Instance.new("RemoteEvent")
	feedback.Name, feedback.Parent = "Feedback", remotes
	request.OnServerEvent:Connect(function(player, action, value)
		if
			action ~= "EquipRod"
			and action ~= "UnequipRod"
			and action ~= "UpgradeRod"
			and action ~= "BuyRodCrate"
			and action ~= "OpenOwnedRodCrate"
			and action ~= "OpenBobberCrate"
			and action ~= "EquipBobberSkin"
			and action ~= "EquipRodSkin"
			and action ~= "OpenSpearCrate"
			and action ~= "EquipSpearSkin"
			and action ~= "ClaimGroupReward"
		then
			return
		end
		local state = states[player]
		if not state or os.clock() - state.lastRequest < 0.5 then
			return
		end
		state.lastRequest = os.clock()
		if action == "ClaimGroupReward" then
			claimGroupReward(player)
		elseif action == "OpenSpearCrate" then
			if not shopPrompt(player, SPEAR_CRATE_PROMPT) then
				feedback:FireClient(
					player,
					"SpearCrateResult",
					false,
					"Step up to the spear crate stand in the tackle shop."
				)
				return
			end
			local success, message, reward = openSpearCrate(player, value)
			if player.Parent == Players then
				feedback:FireClient(player, "SpearCrateResult", success, message, reward)
			end
		elseif action == "EquipSpearSkin" then
			local success, message = equipSpearSkin(player, value)
			if player.Parent == Players then
				feedback:FireClient(player, "SpearSkinResult", success, message)
			end
		elseif action == "BuyRodCrate" then
			if not shopPrompt(player, CRATE_PROMPT) then
				feedback:FireClient(
					player,
					"RodCratePurchaseResult",
					false,
					"Step up to the rod crate stand in the tackle shop."
				)
				return
			end
			local success, message, crateId, count = buyRodCrates(player, value)
			if player.Parent == Players then
				feedback:FireClient(player, "RodCratePurchaseResult", success, message, crateId, count)
			end
		elseif action == "OpenOwnedRodCrate" then
			local success, message, reward = openOwnedRodCrate(player, value)
			if player.Parent == Players then
				feedback:FireClient(player, "CrateResult", success, message, reward)
			end
		elseif action == "OpenBobberCrate" then
			if not shopPrompt(player, BOBBER_PROMPT) then
				feedback:FireClient(
					player,
					"BobberCrateResult",
					false,
					"Step up to the matching case stand in the tackle shop."
				)
				return
			end
			local success, message, skinId, serial = openRodCrate(player, value, true)
			if player.Parent == Players then
				feedback:FireClient(player, "BobberCrateResult", success, message, skinId, serial)
			end
		elseif action == "EquipBobberSkin" then
			local success, message = equipBobberSkin(player, value)
			if player.Parent == Players then
				feedback:FireClient(player, "BobberSkinResult", success, message)
			end
		elseif action == "EquipRodSkin" then
			local success, message = equipRodSkin(player, value)
			if player.Parent == Players then
				feedback:FireClient(player, "SkinResult", success, message)
			end
		elseif action == "UpgradeRod" then
			if not shopPrompt(player, KEEPER_PROMPT) then
				feedback:FireClient(player, "UpgradeResult", false, "Talk to Finn behind the counter to upgrade.")
				return
			end
			local success, message = upgradeRod(player, value)
			if player.Parent == Players then
				feedback:FireClient(player, "UpgradeResult", success, message)
			end
		elseif action == "EquipRod" then
			equip(player)
		else
			local character, humanoid = livingCharacter(player)
			local rod = character and character:FindFirstChildOfClass("Tool")
			if humanoid and rod and rod:GetAttribute("RodId") == "StarterRod" then
				humanoid:UnequipTools()
				player:SetAttribute("RodEquipped", false)
			end
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		if prompt.Name == KEEPER_PROMPT and shopPrompt(player, KEEPER_PROMPT) == prompt then
			feedback:FireClient(player, "OpenUpgrades")
		elseif prompt.Name == CRATE_PROMPT and shopPrompt(player, CRATE_PROMPT) == prompt then
			feedback:FireClient(player, "OpenCrates")
		elseif prompt.Name == BOBBER_PROMPT and shopPrompt(player, BOBBER_PROMPT) == prompt then
			feedback:FireClient(player, "OpenBobberCrates")
		elseif prompt.Name == SPEAR_CRATE_PROMPT and shopPrompt(player, SPEAR_CRATE_PROMPT) == prompt then
			feedback:FireClient(player, "OpenSpearCrates")
		elseif prompt.Name == SPEAR_PROMPT and shopPrompt(player, SPEAR_PROMPT) == prompt then
			task.spawn(function()
				local _, message = buySpear(player)
				notify(player, message)
			end)
		elseif prompt.Name == NET_PROMPT and shopPrompt(player, NET_PROMPT) == prompt then
			task.spawn(function()
				local _, message = buyMusselNet(player)
				notify(player, message)
			end)
		elseif prompt.Name == CAGE_PROMPT and shopPrompt(player, CAGE_PROMPT) == prompt then
			task.spawn(function()
				local _, message = buyCrabCage(player)
				notify(player, message)
			end)
		elseif prompt.Name == "RodStoreDoorPrompt" or prompt.Name == "FurnitureStoreDoorPrompt" then
			walkThroughDoor(player, prompt)
		end
	end)
	CollectionService:GetInstanceAddedSignal("FishingRodShop"):Connect(staffRodCounter)
	for _, hall in CollectionService:GetTagged("FishingRodShop") do
		staffRodCounter(hall)
	end
	Players.PlayerAdded:Connect(bindPlayer)
	Players.PlayerRemoving:Connect(function(player)
		local state = states[player]
		states[player] = nil
		if state then
			disconnect(state.connections)
			disconnect(state.characterConnections)
			disconnect(state.backpackConnections)
		end
	end)
	for _, player in Players:GetPlayers() do
		bindPlayer(player)
	end
end

return FishingService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="151">
        <Properties>
          <string name="Name">FurnitureService</string>
          <string name="Source"><![CDATA[-- Furniture bought at the plaza shop and placed in a base house from build mode, or
-- on the plot of the player's company island (site "Company", which also takes the
-- island's storage, kitchen and office kit). Clients only preview placements; every
-- purchase and move is checked against the saved profile here. Placed items are
-- rebuilt from the owner's profile, so a base or plot always shows its current
-- owner's furniture and nobody else's.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AnglerData = require(script.Parent.AnglerData)
local BoatService = require(script.Parent.BoatService)
local CompanyIslandAccess = require(script.Parent.CompanyIslandAccess)
local CargoService = require(script.Parent.CargoService)
local FishFreezer = require(script.Parent.Map.FishFreezer)
local ShopDesk = require(script.Parent.Map.ShopDesk)
local StorageRack = require(script.Parent.Map.StorageRack)
local Catalog = require(ReplicatedStorage.Shared.AnglerCatalog)
local FishModels = require(ReplicatedStorage.Shared.FishModels)
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))
local Kitchen = require(script.Parent.Map.Kitchen)
local DiningRoom = require(script.Parent.Map.DiningRoom)
local WeatherRadar = require(script.Parent.Map.WeatherRadar)
local Decorations = require(script.Parent.Map.Decorations)
local KitchenService = require(script.Parent.KitchenService)
local Furniture = require(ReplicatedStorage.Shared.FurnitureCatalog)
local Recipes = require(ReplicatedStorage.Shared.Recipes)
local CompanyIslandMap = require(script.Parent.Map.CompanyIslands)

local FurnitureService = {}
local BASE_TAG = "PlayerBase"
local SHOP_TAG = "FurnitureShop"
local OWNER_PROMPT_TAG = "ShopOwnerPrompt"
-- The shop across the street counts as home too; matches build mode on the client.
local HOME_DISTANCE = 110
-- From the quay to the far side of the plot; matches build mode on the client.
local COMPANY_DISTANCE = 150
local started = false
local requests = {}
local busy: { [Player]: boolean } = {}
local update: RemoteEvent

local function ownerOf(base: Model): Player?
	local userId = base:GetAttribute("OwnerUserId")
	return if type(userId) == "number" and userId ~= 0 then Players:GetPlayerByUserId(userId) else nil
end

local function houseOf(base: Model): (Model?, CFrame?)
	local house = base:FindFirstChild("BaseHouse")
	local frame = house and house:GetAttribute("HouseFrame")
	if house and house:IsA("Model") and typeof(frame) == "CFrame" then
		return house, frame
	end
	return nil, nil
end

local function baseOf(player: Player): Model?
	for _, base in CollectionService:GetTagged(BASE_TAG) do
		if base:GetAttribute("OwnerUserId") == player.UserId then
			return base
		end
	end
	return nil
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function near(player: Player, position: Vector3, distance: number): boolean
	local root = rootOf(player)
	return root ~= nil and (root.Position - position).Magnitude <= distance
end

local function notify(player: Player, message: string)
	if player.Parent == Players then
		update:FireClient(player, "Notice", message)
	end
end

local function atShop(player: Player, itemId: string): boolean
	local root = rootOf(player)
	if not root then
		return false
	end
	for _, hall in CollectionService:GetTagged("FurnitureShowroom") do
		if not hall:IsDescendantOf(workspace) then
			continue
		end
		local frame, size = hall:GetAttribute("InteriorFrame"), hall:GetAttribute("InteriorSize")
		if typeof(frame) ~= "CFrame" or typeof(size) ~= "Vector3" then
			continue
		end
		local p = frame:PointToObjectSpace(root.Position)
		if math.abs(p.X) > size.X / 2 or math.abs(p.Y) > size.Y / 2 or math.abs(p.Z) > size.Z / 2 then
			continue
		end
		for _, prompt in hall:GetDescendants() do
			if not prompt:IsA("ProximityPrompt") or prompt.Name ~= "BrowseFurniturePrompt" or not prompt.Enabled then
				continue
			end
			local displayItem = prompt:GetAttribute("ItemId")
			local anchor = prompt.Parent
			if
				(displayItem == nil or displayItem == itemId)
				and anchor
				and anchor:IsA("BasePart")
				and near(player, anchor.Position, prompt.MaxActivationDistance + 2)
			then
				return true
			end
		end
	end
	return false
end

local function atHome(player: Player): boolean
	local base = baseOf(player)
	if not base then
		return false
	end
	-- An if-expression keeps only the first return (the model), losing the frame.
	local _, frame = houseOf(base)
	return frame ~= nil and near(player, frame.Position, HOME_DISTANCE)
end

local function atCompany(player: Player): boolean
	local island = CompanyIslandAccess.get(player)
	local frame = island and island:GetAttribute("PlotFrame")
	return typeof(frame) == "CFrame" and near(player, frame.Position, COMPANY_DISTANCE)
end

local function state(player: Player)
	local profile = BoatService.getProfile(player)
	if not profile then
		return nil
	end
	local data = profile.Angler
	return {
		Cash = profile.Cash,
		Stock = data.FurnitureStock,
		Placed = data.Furniture,
		CompanyPlaced = data.CompanyFurniture,
		CompanyIsland = data.CompanyIsland,
		PendingWallMigration = data.FurnitureWallMigrationPending == true,
		Freezer = #data.Freezer,
		FreezerCount = AnglerData.freezerCount(data),
		Storage = #data.Storage,
		StorageCapacity = AnglerData.storageCapacity(data),
		CageStock = data.CrabCages.Stock, NetStock = data.MusselNets.Stock,
		Pantry = #data.Pantry,
		PantryCapacity = AnglerData.pantryCapacity(data),
		Unlocked = data.Paths.Unlocked,
		BaseId = player:GetAttribute("BaseId"),
	}
end

local function ownerPrompt(parent: Instance, name: string, action: string, object: string): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = 0.25
	prompt.MaxActivationDistance = 6
	prompt.RequiresLineOfSight = false
	prompt.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
	CollectionService:AddTag(prompt, OWNER_PROMPT_TAG)
	prompt.Parent = parent
	return prompt
end

local function promptAnchor(parent: Instance, cframe: CFrame): Part
	local anchor = Instance.new("Part")
	anchor.Name = "PromptAnchor"
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.Transparency, anchor.Anchored = 1, true
	anchor.CanCollide, anchor.CanQuery, anchor.CanTouch = false, false, false
	anchor.CFrame = cframe
	anchor.Parent = parent
	return anchor
end

local function key(entry): string
	return string.format("%s|%s|%s|%d|%s", entry.ItemId, tostring(entry.X), tostring(entry.Z), entry.R, entry.Key or "")
end

local function buildItem(parent: Model, houseFrame: CFrame, entry, userId: number, site: string?): Model?
	local frame = Furniture.frame(houseFrame, entry, site)
	local model
	if entry.ItemId == "CompanyPrep" then
		model = Kitchen.buildStation(parent, frame, "Prep")
		if entry.Key then
			-- CompanyIslandAccess.stations finds the bench by these; jobs save under its Key.
			model:SetAttribute("StationFrame", frame)
			KitchenService.addPrompts(model, frame, entry.Key, userId)
		end
	elseif entry.ItemId == "CompanyDesk" then
		model = CompanyIslandMap.buildDesk(parent, frame)
		local anchor = promptAnchor(model, frame * CFrame.new(0, 3.6, 2.4))
		ownerPrompt(anchor, "CompanyOfficePrompt", "Manage company", "Staff and business"):SetAttribute("OwnerUserId", userId)
	elseif entry.ItemId == "Freezer" then
		model = FishFreezer.build(parent, frame)
		local anchor = promptAnchor(model, frame * CFrame.new(0, FishFreezer.HEIGHT * 0.7, FishFreezer.DEPTH / 2))
		-- CustomerService handles every freezer prompt in a base the same way.
		ownerPrompt(anchor, "StockFreezerPrompt", "Place fish", "Freezer"):SetAttribute("OwnerUserId", userId)
	elseif entry.ItemId == "Register" then
		model = ShopDesk.build(parent, frame)
	elseif entry.ItemId == "StorageRack" then
		model = StorageRack.build(parent, frame)
		local anchor = promptAnchor(model, frame * CFrame.new(0, 3, StorageRack.DEPTH / 2 + 0.3))
		ownerPrompt(anchor, "StoreFishPrompt", "Store all fish", "Storage rack"):SetAttribute("OwnerUserId", userId)
		local take = ownerPrompt(anchor, "TakeStoredFishPrompt", "Take fish", "Storage rack")
		take.KeyboardKeyCode, take.GamepadKeyCode = Enum.KeyCode.F, Enum.KeyCode.ButtonY
		take:SetAttribute("OwnerUserId", userId)
		model.Parent = parent
	elseif entry.ItemId == "FoodCase" then
		model = Kitchen.buildCase(parent, frame)
	elseif entry.ItemId == "KitchenStorage" then
		model = Kitchen.buildStorage(parent, frame)
		local anchor = promptAnchor(model, frame * CFrame.new(0, Kitchen.TOP + 0.8, Kitchen.DEPTH / 2 + 0.3))
		local config = ownerPrompt(anchor, "KitchenStorageGuiPrompt", "Configure", "Kitchen storage")
		config.KeyboardKeyCode, config.GamepadKeyCode = Enum.KeyCode.E, Enum.KeyCode.ButtonX
		config.UIOffset = Vector2.new(0, -55)
		config:SetAttribute("OwnerUserId", userId)
		local take = ownerPrompt(anchor, "TakeKitchenFishPrompt", "Take fish", "Kitchen storage")
		take.KeyboardKeyCode, take.GamepadKeyCode = Enum.KeyCode.F, Enum.KeyCode.ButtonY
		take.UIOffset = Vector2.new(0, 55)
		take:SetAttribute("OwnerUserId", userId)
		take:SetAttribute("Available", false)
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "KitchenStorageStatus"
		billboard.Size = UDim2.fromOffset(240, 32)
		billboard.StudsOffset = Vector3.new(0, 2.2, -0.6)
		billboard.MaxDistance = 45
		billboard.Parent = anchor
		local label = Instance.new("TextLabel")
		label.Name = "Status"
		label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
		label.Font, label.TextSize, label.Text = Enum.Font.GothamBold, 15, "Fish Prep: 0/8"
		Theme.text(label)
		label.Parent = billboard
		model.Parent = parent
	elseif entry.ItemId == "DiningTable" then
		model = DiningRoom.buildTable(parent, frame)
		model.Parent = parent
	elseif entry.ItemId == "WeatherRadar" then
		model = WeatherRadar.build(parent, frame)
	elseif Decorations.has(entry.ItemId) then
		model = Decorations.build(parent, frame, entry.ItemId)
	elseif Recipes.Stations[entry.ItemId] then
		model = Kitchen.buildStation(parent, frame, entry.ItemId)
		-- KitchenService answers both prompts and keeps them in step with the cooking job.
		KitchenService.addPrompts(model, frame, entry.ItemId, userId)
	else
		return nil
	end
	model.Name = entry.ItemId
	model:SetAttribute("FurnitureKey", key(entry))
	model:SetAttribute("ItemId", entry.ItemId)
	model:SetAttribute("X", entry.X)
	model:SetAttribute("Z", entry.Z)
	model:SetAttribute("R", entry.R)
	return model
end

-- Rebuilds only what changed, so prompts and fish displays on untouched items survive.
-- `stored` is how many stored fish are left for this site's racks to show; returns
-- what is left after them.
local function syncFolder(folder: Instance, houseFrame: CFrame, owner: Player?, site: string?, stored: number): number
	local profile = owner and BoatService.getProfile(owner)
	local list = if not profile then {} elseif site == "Company" then profile.Angler.CompanyFurniture else profile.Angler.Furniture
	local wanted = {}
	for _, entry in list do
		wanted[key(entry)] = entry
	end
	local present = {}
	for _, child in folder:GetChildren() do
		local childKey = child:GetAttribute("FurnitureKey")
		if
			not wanted[childKey]
			or present[childKey]
			or child:GetAttribute("OwnerUserId") ~= (owner and owner.UserId)
		then
			child:Destroy()
		else
			present[childKey] = child
		end
	end
	for entryKey, entry in wanted do
		if not present[entryKey] and owner then
			local model = buildItem(folder, houseFrame, entry, owner.UserId, site)
			if model then
				model:SetAttribute("OwnerUserId", owner.UserId)
				present[entryKey] = model
			end
		end
	end
	-- Racks fill in placement order, eight crates each.
	local capacity = if profile then AnglerData.storageCapacity(profile.Angler) else 0
	for _, entry in list do
		local model = present[key(entry)]
		if entry.ItemId == "StorageRack" and model then
			local tools = entry.Mode == "Tools"
			StorageRack.fill(model, Furniture.frame(houseFrame, entry, site), if tools then math.min((entry.Cages or 0) + (entry.Nets or 0), StorageRack.CRATES) else math.min(stored, StorageRack.CRATES))
			if not tools then stored = math.max(0, stored - StorageRack.CRATES) end
			for _, prompt in model:GetDescendants() do
				if prompt:IsA("ProximityPrompt") then
					prompt.Enabled = not tools
					prompt.ObjectText = string.format("Storage · %d/%d fish", #profile.Angler.Storage, capacity)
				end
			end
		end
		if entry.ItemId == "KitchenStorage" and model then
			FurnitureService.refreshKitchenStorage(model, Furniture.frame(houseFrame, entry, site), if profile and profile.Angler.KitchenStorage then profile.Angler.KitchenStorage.Fish else {})
		end
	end
	return stored
end

local function sync(base: Model): number
	local owner = ownerOf(base)
	local profile = owner and BoatService.getProfile(owner)
	local stored = if profile then #profile.Angler.Storage else 0
	local house, houseFrame = houseOf(base)
	if not house or not houseFrame then
		return stored
	end
	local folder = house:FindFirstChild("Furniture")
	if not folder then
		folder = Instance.new("Model")
		folder.Name = "Furniture"
		folder.Parent = house
	end
	return syncFolder(folder, houseFrame, owner, nil, stored)
end

-- The plot of a company island; its racks show the fish the home racks can't.
function FurnitureService.syncCompany(island: Model, stored: number?)
	local folder, frame = island:FindFirstChild("PlotFurniture"), island:GetAttribute("PlotFrame")
	if not folder or typeof(frame) ~= "CFrame" then
		return
	end
	local owner = ownerOf(island)
	local profile = owner and BoatService.getProfile(owner)
	if stored == nil then
		local base = owner and baseOf(owner)
		stored = if base then sync(base) elseif profile then #profile.Angler.Storage else 0
	end
	syncFolder(folder, frame, owner, "Company", stored :: number)
end

local function syncPlayer(player: Player)
	local base = baseOf(player)
	local profile = BoatService.getProfile(player)
	local stored = if base then sync(base) elseif profile then #profile.Angler.Storage else 0
	local island = CompanyIslandAccess.get(player)
	if island then
		FurnitureService.syncCompany(island, stored)
	end
end

function FurnitureService.refreshPlayer(player: Player)
	syncPlayer(player)
end

local function transact(player: Player, transform): (boolean, string)
	if busy[player] then
		return false, "Please wait a moment and try again."
	end
	busy[player] = true
	local ok, message = BoatService.updateProgress(player, transform)
	busy[player] = nil
	if ok then
		syncPlayer(player)
	end
	return ok, message
end

-- Pre-checks the cached profile so a rejected request never costs a save.
local function run(player: Player, change): (boolean, string)
	local profile = BoatService.getProfile(player)
	if not profile then
		return false, "Your progress is still loading. Try again in a moment."
	end
	local _, reason = change(profile)
	if reason then
		return false, reason
	end
	return transact(player, function(current)
		local _, failure = change(current)
		assert(not failure, failure)
	end)
end

local function buy(player: Player, itemId: any): (boolean, string)
	local item = if type(itemId) == "string" then Furniture.Items[itemId] else nil
	if not item or item.Kit then
		return false, "That isn't for sale."
	elseif not atShop(player, itemId) then
		return false, "Step inside Harbour Home and approach a display or the counter to buy furniture."
	end
	local ok, message = run(player, function(profile)
		local locked = Furniture.locked(itemId, profile.Angler.Paths and profile.Angler.Paths.Unlocked)
		if locked then
			return nil, locked
		elseif profile.Cash < item.Price then
			return nil, string.format("You need $%d for a %s.", item.Price, string.lower(item.Name))
		end
		local data, reason = AnglerData.buyFurniture(profile.Angler, itemId)
		if not data then
			return nil, reason
		end
		profile.Cash -= item.Price
		data.Stats.CoinsSpent += item.Price
		profile.Angler = data
		return data
	end)
	if ok then
		message = item.Name .. " bought! Open build mode at home to place it."
	end
	return ok, message
end

-- nil when the player stands where they can arrange `site`, otherwise why not.
local function siteProblem(player: Player, site: string?): string?
	if site == "Company" then
		return if atCompany(player) then nil else "Go to your company island to arrange its plot."
	end
	return if atHome(player) then nil else "Go home to arrange your furniture."
end

local function place(player: Player, from: any, x: any, z: any, r: any, site: string?): (boolean, string)
	local problem = siteProblem(player, site)
	if type(from) ~= "string" and not (type(from) == "number" and from % 1 == 0) then
		return false, "That isn't furniture."
	elseif type(x) ~= "number" or type(z) ~= "number" or type(r) ~= "number" then
		return false, "That isn't a spot in your house."
	elseif problem then
		return false, problem
	end
	return run(player, function(profile)
		local data, reason = AnglerData.placeFurniture(profile.Angler, from, x, z, r, site)
		if data then
			if data.Building then
				local list = if site == "Company" then data.CompanyFurniture else data.Furniture
				local entry = list[if type(from) == "number" then from else #list]
				local blocked = require(script.Parent.BuildingService).furnitureProblem(player, entry, site, profile)
				if blocked then return nil, blocked end
			end
			profile.Angler = data
		end
		return data, reason
	end)
end

local function pickUp(player: Player, index: any, site: string?): (boolean, string)
	local problem = siteProblem(player, site)
	if problem then
		return false, problem
	end
	return run(player, function(profile)
		local data, reason = AnglerData.pickUpFurniture(profile.Angler, index, site)
		if data then
			profile.Angler = data
		end
		return data, reason
	end)
end

local function rackPrompt(player: Player, prompt: ProximityPrompt)
	local base = baseOf(player)
	if
		not ((base and prompt:IsDescendantOf(base)) or CompanyIslandAccess.ownsPrompt(player, prompt))
		or not near(player, prompt.Parent.Position, prompt.MaxActivationDistance + 2)
	then
		return
	end
	local store = prompt.Name == "StoreFishPrompt"
	local profile = BoatService.getProfile(player)
	if not profile then
		return
	elseif store then
		local carrying = CargoService.isCarrying(player, profile.Angler.Hand)
		local unlocked = 0
		for _, item in profile.Angler.Backpack do
			if not item.Locked then
				unlocked += 1
			end
		end
		if not carrying and unlocked == 0 then
			notify(
				player,
				if #profile.Angler.Backpack > 0
					then "Your backpack fish are locked. Right-click a fish to unlock it."
					else "Bring fish in your backpack or carry one to the rack."
			)
			return
		end
	end
	local moved = 0
	local ok, message = run(player, function(current)
		if store then
			local carrying = CargoService.isCarrying(player, current.Angler.Hand)
			local data, count = AnglerData.storeFish(current.Angler, carrying)
			if data then
				current.Angler = data
				moved = count
			end
			return data
		end
		local data, reason = AnglerData.takeStored(current.Angler)
		if data then
			current.Angler = data
		end
		return data, reason
	end)
	if not ok then
		notify(player, message)
		return
	end
	if not store then
		notify(player, "Took a fish off the rack. Carry it to a freezer to sell it.")
		return
	end
	-- Report fish left waiting in the backpack or still carried.
	local remaining = 0
	local current = BoatService.getProfile(player)
	if current then
		if current.Angler.Hand and CargoService.isCarrying(player, current.Angler.Hand) then
			remaining += 1
		end
		for _, item in current.Angler.Backpack do
			if not item.Locked then
				remaining += 1
			end
		end
	end
	notify(
		player,
		string.format(
			"Stored %s on your rack.%s",
			if moved == 1 then "one fish" else string.format("%d fish", moved),
			if remaining > 0 then " Some fish did not fit." else ""
		)
	)
end

function FurnitureService.refreshKitchenStorage(model: Model, frame: CFrame, fishList)
	fishList = fishList or {}
	local count = #fishList
	local anchor = model:FindFirstChild("PromptAnchor")
	if anchor then
		local take = anchor:FindFirstChild("TakeKitchenFishPrompt") :: ProximityPrompt?
		if take then
			take:SetAttribute("Available", count > 0)
			take.ObjectText = string.format("Kitchen storage (%d/8)", count)
		end
		local billboard = anchor:FindFirstChild("KitchenStorageStatus")
		local label = billboard and billboard:FindFirstChild("Status") :: TextLabel?
		if label then
			label.Text = string.format("Fish Prep: %d/%d", count, Furniture.KITCHEN_STORAGE_CAPACITY)
		end
	end
	local sig = {}
	for _, f in fishList do
		table.insert(sig, f.FishId .. ":" .. tostring(f.MadeAt or f.CaughtAt or f.Kg or 0))
	end
	local signature = table.concat(sig, "|")
	if model:GetAttribute("FishSignature") == signature then
		return
	end
	model:SetAttribute("FishSignature", signature)
	local existing = model:FindFirstChild("StorageFishDisplay")
	if existing then
		existing:Destroy()
	end
	if count == 0 then
		return
	end
	local display = Instance.new("Model")
	display.Name = "StorageFishDisplay"
	for index, record in fishList do
		if index > #Kitchen.STORAGE_SPOTS then
			break
		end
		local spot = frame * Kitchen.STORAGE_SPOTS[index]
		local fish = FishModels.create(record.FishId, record)
		if fish then
			FishModels.scaleCatch(fish, record.Kg)
			local _, size = fish:GetBoundingBox()
			local longest = math.max(size.X, size.Y, size.Z)
			if longest > 1.25 then
				fish:ScaleTo(fish:GetScale() * 1.25 / longest)
			end
			for _, part in fish:GetDescendants() do
				if part:IsA("BasePart") then
					part.Anchored = true
					part.CanCollide = false
					part.CanTouch = false
					part.CanQuery = false
				end
			end
			fish:PivotTo(spot * CFrame.Angles(0, math.pi / 2, 0))
			local _, lifted = fish:GetBoundingBox()
			fish:PivotTo(fish:GetPivot() + frame.UpVector * (lifted.Y / 2))
			fish.Parent = display
		end
	end
	display.Parent = model
end

local function takeKitchenStorageFish(player: Player, prompt: ProximityPrompt)
	if prompt:GetAttribute("OwnerUserId") ~= player.UserId then return end
	local position = (prompt.Parent :: BasePart).Position
	local reach = prompt.MaxActivationDistance + 2
	if not near(player, position, reach) then
		return
	end
	local profile = BoatService.getProfile(player)
	if not profile then
		return
	elseif profile.Angler.Hand then
		notify(player, "Your hands are already full.")
		return
	elseif not profile.Angler.KitchenStorage or #profile.Angler.KitchenStorage.Fish == 0 then
		notify(player, "Kitchen storage is empty.")
		return
	end
	local taken = nil
	local ok, message = run(player, function(current)
		local data, fish = AnglerData.takeKitchenStorageFish(current.Angler)
		if data then
			current.Angler = data
			taken = fish
		end
		return data, fish
	end)
	if ok and taken then
		local species = Catalog.Fish[taken.FishId]
		local name = if species then species.Name else taken.FishId
		notify(player, string.format("Took a %s (%s) from kitchen storage. Ready to cook!", name, species and species.Rarity or "fish"))
		CargoService.push(player)
		syncPlayer(player)
	elseif message then
		notify(player, message)
	end
end

-- A plain shopkeeper stands behind each sales counter.
local function staffCounter(top: Instance)
	local shop = top.Parent
	local frame = shop and shop:GetAttribute("KeeperFrame")
	if not shop or typeof(frame) ~= "CFrame" or shop:FindFirstChild("Shopkeeper") then
		return
	end
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = Color3.fromRGB(204, 142, 105)
	description.LeftArmColor, description.RightArmColor = description.HeadColor, description.HeadColor
	description.TorsoColor = Color3.fromRGB(64, 140, 120)
	description.LeftLegColor, description.RightLegColor = Color3.fromRGB(70, 62, 54), Color3.fromRGB(70, 62, 54)
	local ok, keeper = pcall(Players.CreateHumanoidModelFromDescription, Players, description, Enum.HumanoidRigType.R15)
	description:Destroy()
	if not ok then
		warn("[Furniture] Shopkeeper: " .. tostring(keeper))
		return
	end
	keeper.Name = "Shopkeeper"
	local humanoid = keeper:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	local root = keeper:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		root.Anchored = true
	end
	keeper:PivotTo(frame + Vector3.new(0, keeper:GetExtentsSize().Y / 2, 0))
	keeper.Parent = shop
end

local function buildPreviews(parent: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "Previews"
	local builders = {
		Freezer = FishFreezer.build,
		Register = ShopDesk.build,
		StorageRack = StorageRack.build,
		FoodCase = Kitchen.buildCase,
		KitchenStorage = Kitchen.buildStorage or function(p, f) return Kitchen.buildStation(p, f, "KitchenStorage") end,
		DiningTable = DiningRoom.buildTable,
		WeatherRadar = WeatherRadar.build,
		CompanyPrep = function(p, f) return Kitchen.buildStation(p, f, "Prep") end,
		CompanyDesk = CompanyIslandMap.buildDesk,
	}
	local ids = table.clone(Furniture.Order)
	table.move(Furniture.KitOrder, 1, #Furniture.KitOrder, #ids + 1, ids)
	for _, id in ids do
		local build = builders[id] or function(parent, frame)
			if Decorations.has(id) then
				return Decorations.build(parent, frame, id)
			end
			return Kitchen.buildStation(parent, frame, id)
		end
		local sample = build(folder, CFrame.identity)
		sample.Name, sample.Parent = id, folder
		for _, part in sample:GetDescendants() do
			if part:IsA("BasePart") then
				part.Anchored = true
				part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
			end
		end
	end
	folder.Parent = parent
end

function FurnitureService.start()
	if started then
		return
	end
	started = true
	CollectionService:GetInstanceAddedSignal(SHOP_TAG):Connect(function(top)
		task.spawn(staffCounter, top)
	end)
	for _, top in CollectionService:GetTagged(SHOP_TAG) do
		task.spawn(staffCounter, top)
	end
	local remotes = Instance.new("Folder")
	remotes.Name = "Furniture"
	local request = Instance.new("RemoteFunction")
	request.Name, request.Parent = "Request", remotes
	update = Instance.new("RemoteEvent")
	update.Name, update.Parent = "Update", remotes
	buildPreviews(remotes)
	remotes.Parent = ReplicatedStorage
	local ksRemotes = Instance.new("Folder")
	ksRemotes.Name = "KitchenStorage"
	local ksRequest = Instance.new("RemoteFunction")
	ksRequest.Name, ksRequest.Parent = "Request", ksRemotes
	ksRemotes.Parent = ReplicatedStorage
	ksRequest.OnServerInvoke = function(player, action, payload)
		local profile = BoatService.getProfile(player)
		if not profile then
			return { Ok = false, Message = "Profile still loading." }
		end
		if action == "Get" then
			local available = {
				Common = 0,
				Uncommon = 0,
				Rare = 0,
				Epic = 0,
				Legendary = 0,
				Mythical = 0,
				Exotic = 0,
				Divine = 0,
				Limited = 0,
			}
			for _, list in { profile.Angler.Freezer, profile.Angler.Storage } do
				for _, fish in list do
					local species = Catalog.Fish[fish.FishId]
					local r = species and species.Rarity or "Common"
					available[r] = (available[r] or 0) + 1
				end
			end
			return {
				Ok = true,
				Targets = profile.Angler.KitchenStorage.Targets or {},
				Fish = profile.Angler.KitchenStorage.Fish or {},
				Available = available,
			}
		elseif action == "SetTargets" then
			local movedCount = 0
			local ok, message = run(player, function(current)
				local data, err = AnglerData.setKitchenStorageTargets(current.Angler, payload)
				if not data then return nil, err end
				data, movedCount = AnglerData.stockKitchenStorageFromStock(data, Catalog.Fish)
				current.Angler = data
				return data
			end)
			if ok then
				syncPlayer(player)
				local msg = if movedCount > 0 then string.format("Moved %d fish from stock onto the prep table! Porter will also bring eligible fish.", movedCount) else "Targets updated! Porter will bring eligible catches here."
				return { Ok = true, Message = msg }
			end
			return { Ok = false, Message = message }
		end
		return { Ok = false, Message = "Unknown action." }
	end
	request.OnServerInvoke = function(player, action, a, b, c, d, e)
		if action == "Get" then
			return { Ok = true, Message = "", State = state(player) }
		end
		if os.clock() - (requests[player] or -math.huge) < 0.25 then
			return { Ok = false, Message = "Please wait a moment and try again.", State = state(player) }
		end
		requests[player] = os.clock()
		local ok, message
		if action == "Buy" then
			ok, message = buy(player, a)
		elseif action == "Place" or action == "Move" then
			ok, message = place(player, a, b, c, d, if e == "Company" then "Company" else nil)
		elseif action == "PickUp" then
			ok, message = pickUp(player, a, if b == "Company" then "Company" else nil)
		elseif action == "EditRack" then
			local site = if c == "Company" then "Company" else nil
			local problem = siteProblem(player, site)
			if problem then return { Ok = false, Message = problem, State = state(player) } end
			ok, message = run(player, function(profile)
				local data, reason = AnglerData.editRack(profile.Angler, a, b, site)
				if data then profile.Angler = data end
				return data, reason
			end)
		else
			ok, message = false, "That furniture action is unavailable."
		end
		return { Ok = ok, Message = message, State = state(player) }
	end
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		if prompt.Name == "StoreFishPrompt" or prompt.Name == "TakeStoredFishPrompt" then
			task.spawn(rackPrompt, player, prompt)
		elseif prompt.Name == "TakeKitchenFishPrompt" then
			task.spawn(takeKitchenStorageFish, player, prompt)
		end
	end)
	local function bind(player: Player)
		player:GetAttributeChangedSignal("AnglerRevision"):Connect(function()
			syncPlayer(player)
			update:FireClient(player, "State", state(player))
		end)
	end
	Players.PlayerAdded:Connect(bind)
	for _, player in Players:GetPlayers() do
		bind(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		requests[player], busy[player] = nil, nil
	end)
	local function watch(base: Instance)
		if base:IsA("Model") then
			base:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
				sync(base)
			end)
			sync(base)
		end
	end
	CollectionService:GetInstanceAddedSignal(BASE_TAG):Connect(watch)
	for _, base in CollectionService:GetTagged(BASE_TAG) do
		watch(base)
	end
end

return FurnitureService
]]></string>
        </Properties>
