        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">ShovelnoseSturgeon</string>
            <string name="Source"><![CDATA[return {
	Name = "Shovelnose Sturgeon",
	Rarity = "Epic",
	RarityDenominator = 50,
	MinKg = 0.8,
	AverageKg = 2.5,
	MaxKg = 8,
	BaseValue = 165,
