	"...#...",
	"..###..",
	"..###..",
	".#####.",
	".#####.",
	"#######",
	"#######",
	"#######",
	"#######",
	"#######",
	"#######",
	".#####.",
})

-- Long bow and narrow beam: 90 cells, about 70% of the previous hold.
local patrolHold = table.freeze({
	"...##...",
	"...##...",
	"..####..",
	"..####..",
	".######.",
	".######.",
	".######.",
	".######.",
	"########",
	"########",
	"########",
	"########",
	"########",
	"########",
	".######.",
})

