        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">StringLights</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material

	-- Two posts on square feet.
	for i, x in { -2.75, 2.75 } do
		kit.block("LightFoot" .. i, Vector3.new(0.5, 0.2, 0.5), CFrame.new(x, 0.1, 0), P.DarkWood, M.Wood)
		kit.cylinder("LightPost" .. i, 0.28, 5.5, CFrame.new(x, 2.95, 0), P.Wood, M.Wood)
		kit.ball("LightPostCap" .. i, 0.32, CFrame.new(x, 5.76, 0), P.Brass, M.Metal)
	end

	-- Sagging cable: a parabola sampled into four straight runs.
	local top, sag, half = 5.45, 0.9, 2.75
	local function cableY(x)
		local t = x / half
		return top - sag * (1 - t * t)
	end
	local xs = { -half, -half / 2, 0, half / 2, half }
	local pts = {}
	for i, x in xs do
		pts[i] = Vector3.new(x, cableY(x), 0)
	end
	for i = 1, #pts - 1 do
		kit.beam("LightCable" .. i, pts[i], pts[i + 1], 0.06, 0.06, P.Iron, M.Fabric)
	end
	-- y on the straight runs (bulbs hang from the drawn cable, not the curve).
	local function onCable(x)
		for i = 1, #pts - 1 do
			local a, b = pts[i], pts[i + 1]
			if x >= a.X and x <= b.X then
				return a.Y + (b.Y - a.Y) * (x - a.X) / (b.X - a.X)
			end
		end
		return top
	end

	local colours = {
		Color3.fromRGB(255, 90, 80),
		P.Glow,
		Color3.fromRGB(90, 210, 200),
		Color3.fromRGB(255, 230, 110),
		Color3.fromRGB(130, 220, 110),
		P.Glow,
		Color3.fromRGB(255, 120, 190),
		Color3.fromRGB(255, 170, 70),
		Color3.fromRGB(110, 170, 255),
	}
	for i = 1, 9 do
		local x = (i - 5) * 0.55
		local y = onCable(x)
		kit.cylinder("LightSocket" .. i, 0.14, 0.16, CFrame.new(x, y - 0.1, 0), P.Iron, M.Metal)
		local bulb = kit.ball("LightBulb" .. i, 0.36, CFrame.new(x, y - 0.34, 0), colours[i], M.Neon)
		if i == 5 then
			kit.light(bulb, P.Glow, 16, 1.2)
		end
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">SunLounger</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local W = kit.Material.Wood
	local XR = 1.08

	-- Frame: two long side rails and end rails.
	for _, s in { -1, 1 } do
		local side = s < 0 and "L" or "R"
		kit.block("SideRail" .. side, Vector3.new(0.18, 0.26, 5.9), CFrame.new(XR * s, 0.82, 0), P.Teak, W)
		kit.block("FootLeg" .. side, Vector3.new(0.2, 0.72, 0.22), CFrame.new(XR * s, 0.36, -2.75), P.DarkWood, W)
		kit.block("HeadLeg" .. side, Vector3.new(0.2, 0.5, 0.22), CFrame.new(XR * s, 0.58, 2.2), P.DarkWood, W)
		kit.cylinder("Wheel" .. side, 0.66, 0.14, CFrame.new((XR + 0.02) * s, 0.33, 2.2) * CFrame.Angles(0, 0, math.pi / 2), P.Iron, kit.Material.SmoothPlastic)
		-- Prop strut under the backrest.
		kit.beam("Strut" .. side, Vector3.new((XR - 0.18) * s, 0.95, 2.75), Vector3.new((XR - 0.18) * s, 1.75, 2.15), 0.1, 0.1, P.DarkWood, W)
	end
	kit.block("FootRail", Vector3.new(2.34, 0.26, 0.18), CFrame.new(0, 0.82, -2.86), P.Teak, W)
	kit.block("HeadRail", Vector3.new(2.34, 0.26, 0.18), CFrame.new(0, 0.82, 2.86), P.Teak, W)

	-- Slatted bed under the cushion.
	for i = 0, 4 do
		kit.block("Slat" .. i, Vector3.new(2.0, 0.08, 0.5), CFrame.new(0, 0.95, -2.5 + i * 0.75), P.Wood, W)
	end

	-- Leg cushion with piping band.
	kit.block("Cushion", Vector3.new(2.0, 0.28, 3.7), CFrame.new(0, 1.13, -0.95), P.Teal, kit.Material.Fabric)
	kit.block("CushionBand", Vector3.new(2.04, 0.08, 0.16), CFrame.new(0, 1.15, -2.0), P.Cream, kit.Material.Fabric)
	kit.block("CushionBand2", Vector3.new(2.04, 0.08, 0.16), CFrame.new(0, 1.15, 0.1), P.Cream, kit.Material.Fabric)

	-- Reclined backrest (about 35 degrees) hinged at the cushion's head end.
	local tilt = math.rad(35)
	local len = 1.75
	local hinge = Vector3.new(0, 0.92, 0.95)
	local dir = Vector3.new(0, math.sin(tilt), math.cos(tilt))
	local up = Vector3.new(0, math.cos(tilt), -math.sin(tilt)) -- cushion face normal
	local mid = hinge + dir * (len / 2)
	local backCf = CFrame.lookAt(mid, mid + dir, up)
	kit.block("BackFrame", Vector3.new(2.1, 0.12, len), backCf, P.Wood, W)
	kit.block("BackCushion", Vector3.new(2.0, 0.26, len - 0.1), backCf * CFrame.new(0, 0.19, 0), P.Teal, kit.Material.Fabric)
	kit.block("Pillow", Vector3.new(1.6, 0.16, 0.5), backCf * CFrame.new(0, 0.38, len / 2 - 0.45), P.Cream, kit.Material.Fabric)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Telescope</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material

	-- Tripod: three legs from a collar down to brass-capped feet
	local apex = Vector3.new(0, 2.8, 0)
	for i = 0, 2 do
		local a = math.rad(i * 120)
		local foot = Vector3.new(math.sin(a) * 0.92, 0.04, math.cos(a) * 0.92)
		local top = apex + Vector3.new(math.sin(a) * 0.12, 0, math.cos(a) * 0.12)
		kit.beam("Leg", top, foot, 0.12, 0.12, P.Wood, M.Wood)
		kit.ball("Foot", 0.16, CFrame.new(foot.X, 0.08, foot.Z), P.Brass, M.Metal)
		local mid = top:Lerp(foot, 0.45)
		kit.beam("LegClamp", mid + (top - foot).Unit * 0.06, mid - (top - foot).Unit * 0.06, 0.17, 0.17, P.Brass, M.Metal)
	end
	kit.cylinder("Collar", 0.46, 0.22, CFrame.new(0, 2.84, 0), P.DarkWood, M.Wood)
	kit.cylinder("Hub", 0.3, 0.2, CFrame.new(0, 3.04, 0), P.Brass, M.Metal)

	-- Yoke and pivot
	local pivot = Vector3.new(0, 3.32, 0.05)
	for _, side in { -1, 1 } do
		kit.block("Yoke", Vector3.new(0.06, 0.34, 0.24), CFrame.new(side * 0.22, 3.25, 0.05), P.Brass, M.Metal)
	end
	kit.cylinder("Pivot", 0.1, 0.56, CFrame.new(pivot) * CFrame.Angles(0, 0, math.pi / 2), P.Iron, M.Metal)

	-- The spyglass, tilted up toward the horizon at the front (-Z)
	local tilt = math.rad(12)
	local dir = Vector3.new(0, math.sin(tilt), -math.cos(tilt))
	local rot = CFrame.Angles(tilt - math.pi / 2, 0, 0)
	local function tube(name, d, length, t, color, material)
		kit.cylinder(name, d, length, CFrame.new(pivot + dir * t) * rot, color, material)
	end
	tube("Objective", 0.42, 0.16, 0.94, P.Brass, M.Metal)
	tube("Lens", 0.32, 0.02, 1.02, Color3.fromRGB(120, 180, 210), M.Glass)
	tube("Barrel", 0.34, 1.0, 0.36, P.Navy, M.SmoothPlastic)
	tube("BarrelBand", 0.38, 0.08, 0.02, P.Brass, M.Metal)
	tube("BarrelBand", 0.38, 0.08, 0.7, P.Brass, M.Metal)
	tube("DrawTube", 0.26, 0.5, -0.38, P.Brass, M.Metal)
	tube("DrawRing", 0.3, 0.06, -0.62, Color3.fromRGB(170, 128, 50), M.Metal)
	tube("Eyepiece", 0.18, 0.3, -0.8, P.Brass, M.Metal)
	tube("Eyecup", 0.22, 0.08, -0.97, P.Iron, M.Metal)
end
]]></string>
          </Properties>
