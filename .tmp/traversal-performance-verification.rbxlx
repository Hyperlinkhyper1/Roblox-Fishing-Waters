			Hair = { 86, 60, 40 },
			HairStyle = "Short",
			Beard = { 92, 64, 42 },
			Pieces = {
				{ Kind = "Vest", Color = { 46, 40, 36 } },
				{ Kind = "EyePatch", Color = { 20, 18, 18 } },
				{ Kind = "Bandana", Color = { 30, 30, 34 } },
			},
		},
		Greeting = "Rods! Good rods! Mostly from honest sources. Have a look.",
	},
	Bess = {
		Name = "Quartermaster Bess",
		Title = "Fish Buyer",
		Kind = "Buyer",
		Spot = "BuyerStall",
		Face = "Plaza",
		Outfit = {
			Skin = { 222, 170, 128 },
			Shirt = { 236, 230, 214 },
			Sleeves = "Long",
			Trousers = { 60, 56, 70 },
			Shoes = { 40, 34, 30 },
			Boots = { 52, 44, 38 },
			Hair = { 150, 44, 30 },
			HairStyle = "Bun",
			Pieces = {
				{ Kind = "Apron", Color = { 70, 110, 120 } },
				{ Kind = "Headscarf", Color = { 30, 60, 100 } },
				{ Kind = "Earring", Color = { 230, 196, 80 } },
			},
		},
		Greeting = "I buy fish for the whole cove. Fair prices, paid on the spot.",
	},
	Dreadbeard = {
		Name = "Dreadbeard",
		Title = "Ghost Pirate",
		Kind = "Lore",
		Spot = "Dreadbeard",
		Outfit = {
			Catalog = true,
			Skin = { 138, 176, 168 }, -- sea-green, as though the light goes through him
			Shirt = 733260904,
			Pants = 129459077,
			Hat = 16333714206,
			Beard = 119779693942379,
		},
		Greeting = "Hah! A living soul, out on my pier. Sit a while - a dead man's tale costs nothing.",
		Lore = {
			"Years ago I was the terror of these waters. Captain Dreadbeard, they called me, and every ship from here to the ice paid me tribute or fed the fishes.",
			"One storm took my ship and my crew, but it could not take my greatest prize. I hid it deep in the ocean, where the light gives up and the cold gets into your bones.",
			"The Ultimate treasure, I called it. A compass rose of solid gold, struck from the sun itself. It points not north, but to whatever your heart desires most.",
			"Many have hunted it. None have found it. The sea keeps her secrets, and a treasure like that chooses its own keeper.",
			"But you... you have the look of a lucky one. Cast your line into the deep and maybe, one cast in a million, it will find you.",
			"And if it does? Use it, sailor. That treasure can open every locked door in the world - every pass, every privilege, every gilded gate.",
		},
	},
}

PirateCove.Order = { "Hale", "Barnaby", "Tamsin", "Pip", "Ines", "Coralie", "Flint", "Bess", "Dreadbeard" }

-- Each quest giver's chain, in order. Kinds:
--   Catch         catch Count fish (any, anywhere) after accepting
--   Deliver       hand over one FishId
--   DeliverRarity hand over any fish of at least Rarity
--   DeliverMutated hand over any fish with a mutation
-- Delivered fish come from your hand first, then your backpack; locked fish are never taken.
PirateCove.Quests = {
	Hale = {
		{
			Kind = "Catch",
			Count = 10,
			Cash = 300,
			XP = 150,
			Title = "Prove Your Salt",
			Offer = "Anyone can sail in. Show me you can fish: land ten of them, anywhere you like, and come back.",
			Done = "Ten fish and still standing. You'll do.",
		},
		{
			Kind = "Deliver",
			FishId = "YellowfinTuna",
			Cash = 900,
			XP = 400,
			Title = "A Captain's Supper",
			Offer = "My crew wants a proper feast. Bring me a Yellowfin Tuna from the open water.",
			Done = "Now that is a tuna. The crew will sing about this one. Badly.",
		},
		{
			Kind = "DeliverRarity",
			Rarity = "Epic",
			Cash = 2500,
			XP = 1200,
			Title = "Legend of the Cove",
			Offer = "Last task, and the hardest. Bring me an Epic fish - or rarer. Then you're one of us.",
			Done = "Well I'll be. Welcome to the crew, Captain. The cove is yours as much as mine.",
		},
	},
	Barnaby = {
		{
			Kind = "Deliver",
			FishId = "Sardine",
			Cash = 120,
			XP = 60,
			Title = "Bait for an Old Man",
			Offer = "Out of bait again. Fetch me a Sardine, would you? My knees don't do boats any more.",
			Done = "Lovely and slimy. Just how I like 'em.",
		},
		{
			Kind = "Deliver",
			FishId = "Mackerel",
			Cash = 220,
			XP = 100,
			Title = "Mackerel Sky",
			Offer = "Mackerel sky, mackerel for tea. That's the saying. I think. Bring me one.",
			Done = "Perfect. Now if only the sky would do what the saying says.",
		},
		{
			Kind = "Catch",
			Count = 25,
			Cash = 700,
			XP = 300,
			Title = "Fifty Years of Fishing",
			Offer = "When I was your age I'd land twenty-five fish before breakfast. Let's see you match it.",
			Done = "Ha! Twenty-five. You've got the knack, right enough.",
		},
	},
	Tamsin = {
		{
			Kind = "Deliver",
			FishId = "RedSnapper",
			Cash = 180,
			XP = 80,
			Title = "Snapper Stew",
			Offer = "Tonight is snapper stew, if somebody brings me a Red Snapper. Somebody like you.",
			Done = "Into the pot it goes. Come back later for a bowl.",
		},
		{
			Kind = "Deliver",
			FishId = "Shrimp",
			Cash = 300,
			XP = 140,
			Title = "Shrimp on the Fire",
			Offer = "The crew keeps asking for grilled shrimp. Find me some Shrimp out in the open sea.",
			Done = "Oh, they're lovely. The crew will be quiet for a whole hour.",
		},
		{
			Kind = "Deliver",
			FishId = "Pufferfish",
			Cash = 450,
			XP = 220,
			Title = "A Dangerous Dish",
			Offer = "I want to try something daring. Bring me a Pufferfish. Don't worry, I know what I'm doing. Mostly.",
			Done = "Careful, careful... There. Nobody touch the spiky bits.",
		},
	},
	Pip = {
		{
			Kind = "Deliver",
			FishId = "Clownfish",
			Cash = 150,
			XP = 70,
			Title = "A Stripy Friend",
			Offer = "I want a pet fish. A Clownfish! They're the funniest fish. Can you catch me one?",
			Done = "I'm calling him Admiral. Admiral Stripes.",
		},
		{
			Kind = "Deliver",
			FishId = "LeatherBoot",
			Cash = 100,
			XP = 50,
			Title = "Treasure Hunter",
			Offer = "Real pirates collect treasure. Bring me a boot from the sea floor! Boots are treasure if you squint.",
			Done = "A real sea boot! It's the best thing I own. Don't tell Admiral Stripes.",
		},
		{
			Kind = "DeliverRarity",
			Rarity = "Uncommon",
			Cash = 350,
			XP = 160,
			Title = "Something Special",
			Offer = "Captain Hale says only good sailors catch the unusual ones. Show me an Uncommon fish or better!",
			Done = "Wow. When I'm Captain Pip, you can be my first mate.",
		},
	},
	Ines = {
		{
			Kind = "Catch",
			Count = 15,
			Cash = 350,
			XP = 160,
			Title = "Reading the Water",
			Offer = "Every catch tells me something about the currents. Land fifteen fish and I'll learn a lot.",
			Done = "Good. My charts are already better for it.",
		},
		{
			Kind = "DeliverRarity",
			Rarity = "Rare",
			Cash = 800,
			XP = 360,
			Title = "Strange Currents",
			Offer = "Rare fish follow the strange currents. Bring me a Rare fish and I can map where they run.",
			Done = "Just as I thought. The current turns east past the atoll.",
		},
		{
			Kind = "Deliver",
			FishId = "Sailfish",
			Cash = 1800,
			XP = 800,
			Title = "Fastest in the Sea",
			Offer = "Nothing crosses the sea faster than a Sailfish. Catch one and I'll know the deep-water lanes.",
			Done = "Magnificent. My map of the open sea is finally finished.",
		},
	},
	Coralie = {
		{
			Kind = "Deliver",
			FishId = "Halibut",
			Cash = 200,
			XP = 90,
			Title = "Flat on the Bottom",
			Offer = "Halibut hide flat on the sand where I dive. Catch one for me before it scares me again.",
			Done = "Ha! Not so scary up here, are you?",
		},
		{
			Kind = "DeliverMutated",
			Cash = 1200,
			XP = 500,
			Title = "A Glimmer Below",
			Offer = "Sometimes I see fish that glow, or shine with every colour. Bring me any mutated fish.",
			Done = "Look at it shimmer. Prettier than any pearl.",
		},
		{
			Kind = "Deliver",
			FishId = "Swordfish",
			Cash = 2000,
			XP = 900,
			Title = "The Sword Below",
			Offer = "A Swordfish keeps chasing me off my best pearl bed. Catch it, and the pearls are safe.",
			Done = "My pearl bed is mine again. Thank you, truly.",
		},
	},
}

-- The in-game day number at `elapsed` seconds since the DayNight epoch.
function PirateCove.day(elapsed: number): number
	return math.floor(elapsed / PirateCove.DAY_SECONDS)
end

-- Fish the galley will still buy today from a saved { Day, Count } record.
function PirateCove.salesLeft(record: { Day: number?, Count: number? }?, day: number): number
	local sold = if record and record.Day == day then record.Count or 0 else 0
	return math.max(0, PirateCove.DAILY_SALES - sold)
end

function PirateCove.salePrice(record: { Value: number }): number
	return math.max(1, math.floor(record.Value))
end

function PirateCove.quest(npcId: string, step: number?)
	local chain = PirateCove.Quests[npcId]
	return chain and chain[step or 1]
end

-- Whether a fish record satisfies a delivery quest. `rarityOf` maps a FishId to its rarity name.
function PirateCove.accepts(quest, record, rarityOf: (string) -> string?): boolean
	if quest.Kind == "Deliver" then
		return record.FishId == quest.FishId
	elseif quest.Kind == "DeliverRarity" then
		local rarity = rarityOf(record.FishId)
		return rarity ~= nil and (RARITY_ORDER[rarity] or -1) >= RARITY_ORDER[quest.Rarity]
	elseif quest.Kind == "DeliverMutated" then
		return type(record.Mutation) == "string" and record.Mutation ~= "Normal"
	end
	return false
end

-- A quest's progress line for the dialogue. `caught` is fish landed since accepting.
function PirateCove.goal(quest, caught: number?, fishName: string?): string
	if quest.Kind == "Catch" then
		return string.format("Catch %d fish (%d / %d)", quest.Count, math.min(caught or 0, quest.Count), quest.Count)
	elseif quest.Kind == "Deliver" then
		return "Bring a " .. (fishName or quest.FishId)
	elseif quest.Kind == "DeliverRarity" then
		return "Bring any " .. quest.Rarity .. " fish or rarer"
	elseif quest.Kind == "DeliverMutated" then
		return "Bring any mutated fish"
	end
	return quest.Title
end

return PirateCove
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="155">
        <Properties>
          <string name="Name">Recipes</string>
          <string name="Source"><![CDATA[-- Kitchen recipes for the Supermarket path. A dish is cooked from one carried fish
-- at a kitchen station; its value is the fish's value times the recipe's Multiplier.
-- Better recipes need a rarer fish and a bought station. Pure: no Roblox services.
local Recipes = {}

-- Same order as AnglerCatalog.Rarities (kept here so this module stays pure).
Recipes.RarityOrder = {
	Junk = 0,
	Common = 1,
	Uncommon = 2,
	Rare = 3,
	Epic = 4,
	Legendary = 5,
	Mythical = 6,
	Exotic = 7,
	Divine = 8,
	Limited = 9,
	Admin = 10,
}
-- Diners in the restaurant pay this much more than shop customers.
Recipes.RESTAURANT_MARKUP = 1.5

-- Prep benches come with the house once the Supermarket is open (FurnitureCatalog
-- PrepBench, saved under a bench key below). The others are furniture
-- (FurnitureCatalog item of the same id).
Recipes.Stations = {
	Prep = { Name = "Prep bench", BuiltIn = true },
	GrillStation = { Name = "Grill station" },
	Smoker = { Name = "Smokehouse" },
	SushiBar = { Name = "Sushi bar" },
}
-- Bench keys of the house's prep benches; each placed PrepBench saves one as its Key.
Recipes.BuiltIn = {
	Prep1 = { Station = "Prep" },
	Prep2 = { Station = "Prep" },
}
-- Separate saved keys let island benches and harbour benches cook independently.
Recipes.CompanyBuiltIn = {
	CompanyPrep1 = { Station = "Prep" },
	CompanyPrep2 = { Station = "Prep" },
}

Recipes.Order = {
	"FishFillet",
	"FishAndChips",
	"GrilledFish",
	"FishSkewers",
	"SmokedFish",
	"SushiPlatter",
	"GoldenSashimi",
}
Recipes.Items = {
	FishFillet = {
		Name = "Fish fillet",
		Station = "Prep",
		MinRarity = "Common",
		Multiplier = 1.4,
		Seconds = 6,
		Look = "Fillet",
	},
	FishAndChips = {
		Name = "Fish & chips",
		Station = "Prep",
		MinRarity = "Uncommon",
		Multiplier = 1.8,
		Seconds = 10,
		Look = "Chips",
	},
	GrilledFish = {
		Name = "Grilled fish",
		Station = "GrillStation",
		MinRarity = "Uncommon",
		Multiplier = 2.2,
		Seconds = 12,
		Look = "Grilled",
	},
	FishSkewers = {
		Name = "Fish skewers",
		Station = "GrillStation",
		MinRarity = "Rare",
		Multiplier = 2.8,
		Seconds = 15,
		Look = "Skewers",
	},
	SmokedFish = {
		Name = "Smoked fish",
		Station = "Smoker",
		MinRarity = "Rare",
		Multiplier = 3.2,
		Seconds = 20,
		Look = "Smoked",
	},
	SushiPlatter = {
		Name = "Sushi platter",
		Station = "SushiBar",
		MinRarity = "Epic",
		Multiplier = 4,
		Seconds = 25,
		Look = "Sushi",
	},
	GoldenSashimi = {
		Name = "Golden sashimi",
		Station = "SushiBar",
		MinRarity = "Legendary",
		Multiplier = 5,
		Seconds = 30,
		Look = "Sashimi",
	},
}

-- The station type behind a station key: a built-in bench key or a furniture item id.
function Recipes.stationOf(key: string): string?
	local builtIn = Recipes.BuiltIn[key] or Recipes.CompanyBuiltIn[key]
	if builtIn then
		return builtIn.Station
	end
	local station = Recipes.Stations[key]
	return if station and not station.BuiltIn then key else nil
end

-- nil when `recipeId` can be cooked at that station type from a fish of `rarity`
-- (an AnglerCatalog rarity name), otherwise a player-facing reason.
function Recipes.problem(recipeId: any, station: string, rarity: string?): string?
	local recipe = if type(recipeId) == "string" then Recipes.Items[recipeId] else nil
	if not recipe then
		return "Choose a recipe."
	elseif recipe.Station ~= station then
		return recipe.Name .. " is made at a " .. string.lower(Recipes.Stations[recipe.Station].Name) .. "."
	elseif (Recipes.RarityOrder[rarity or ""] or -1) < Recipes.RarityOrder[recipe.MinRarity] then
		return recipe.Name .. " needs a " .. recipe.MinRarity .. " fish or rarer."
	end
	return nil
end

function Recipes.value(recipeId: string, fishValue: number): number
	return math.max(1, math.floor(fishValue * Recipes.Items[recipeId].Multiplier))
end

function Recipes.dinerPrice(dishValue: number): number
	return math.max(1, math.floor(dishValue * Recipes.RESTAURANT_MARKUP))
end

return Recipes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="156">
        <Properties>
          <string name="Name">RodDynamics</string>
          <string name="Source"><![CDATA[-- Exact damped springs keep the visual rod and its hanging float stable at
-- different frame rates. Inputs are measured motion, never a looping animation.
local RodDynamics = {}

local MAX_BEND = math.rad(31)
local MAX_SWING = 0.78

function RodDynamics.new()
	return { bendX = 0, bendZ = 0, velocityX = 0, velocityZ = 0, bobX = 0, bobZ = 0, bobVelocityX = 0, bobVelocityZ = 0 }
end

function RodDynamics.reset(state)
	for key in state do
		state[key] = 0
	end
end

local function finiteClamp(value: number, limit: number): number
	if value ~= value then
		return 0
	end
	return math.clamp(value, -limit, limit)
end

local function spring(
	position: number,
	velocity: number,
	target: number,
	dt: number,
	frequency: number,
	damping: number,
	limit: number
)
	local offset = position - target
	local drag = frequency * damping
	local oscillation = frequency * math.sqrt(1 - damping * damping)
	local decay = math.exp(-drag * dt)
	local cosine, sine = math.cos(oscillation * dt), math.sin(oscillation * dt)
	local nextPosition = target + decay * (offset * cosine + (velocity + drag * offset) / oscillation * sine)
	local nextVelocity = decay
		* (velocity * cosine - (drag * velocity + frequency * frequency * offset) / oscillation * sine)
	local bounded = finiteClamp(nextPosition, limit)
	if bounded ~= nextPosition and bounded * nextVelocity > 0 then
		nextVelocity = 0
	end
	return bounded, nextVelocity
end

function RodDynamics.step(state, dt: number, target)
	if dt ~= dt or dt > 0.15 then
		RodDynamics.reset(state)
		return false
	end
	if dt <= 0 then
		return true
	end
	state.bendX, state.velocityX =
		spring(state.bendX, state.velocityX, finiteClamp(target.bendX, MAX_BEND), dt, 13, 0.82, MAX_BEND)
	state.bendZ, state.velocityZ =
		spring(state.bendZ, state.velocityZ, finiteClamp(target.bendZ, MAX_BEND), dt, 13, 0.82, MAX_BEND)
	state.bobX, state.bobVelocityX =
		spring(state.bobX, state.bobVelocityX, finiteClamp(target.bobX, MAX_SWING), dt, 5.4, 0.5, MAX_SWING)
	state.bobZ, state.bobVelocityZ =
		spring(state.bobZ, state.bobVelocityZ, finiteClamp(target.bobZ, MAX_SWING), dt, 5.4, 0.5, MAX_SWING)
	return true
end

return RodDynamics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="157">
        <Properties>
          <string name="Name">RodSkins</string>
          <string name="Source"><![CDATA[-- Rod skins won from crates at the Tide & Tackle counter. A skin restyles the
-- angler's one rod and adds base stats on top of Finn's upgrades; rarer skins
-- also raise mutation odds. Pure data and rules: the server rolls and saves,
-- CatchService applies the stats, and clients only present them. No Roblox
-- globals here, so BoatData can load it in tests.
local RodSkins = {}
RodSkins.GroupId = 772704145
RodSkins.GroupReward = "TideboundRod"

RodSkins.RarityOrder = { "Common", "Uncommon", "Rare", "Epic", "Legendary" }
RodSkins.Rarities = {
	Common = { Color = { 196, 201, 205 } },
	Uncommon = { Color = { 111, 202, 125 } },
	Rare = { Color = { 86, 156, 240 } },
	Epic = { Color = { 186, 104, 240 } },
	Legendary = { Color = { 255, 196, 64 } },
}

-- Reel adds to the reel progress per hit (0.05 = +5%), Size to the big and huge
-- fish odds (0.1 = +10%), Handling to green-zone width and green-hit progress (0.1 = +10%), Mutation to the chance of any mutation, and Astral to
-- the chance of the night-only Astral mutation after dark.
RodSkins.Skins = {
	TideboundRod = {
		Handling = 0.1,
		Name = "Tidebound Rod",
		Rarity = "Uncommon",
		Description = "A pearl-inlaid teal rod with gilded wavework. A gift for our community.",
		Reel = 0.075,
		Size = 0.075,
	},
	UmbrellaRod = {
		Handling = 0.04,
		Name = "Umbrella Rod",
		Rarity = "Common",
		Description = "A sturdy brolly with a line through the tip. Rain or shine.",
		Reel = 0.05,
		Size = 0,
	},
	BambooRod = {
		Handling = 0.12,
		Name = "Bamboo Rod",
		Rarity = "Common",
		Description = "Hand-cut cane, light and springy.",
		Reel = 0,
		Size = 0.1,
	},
	BoneRod = {
		Handling = 0.06,
		Name = "Bone Rod",
		Rarity = "Uncommon",
		Description = "Carved from something big that didn't get away.",
		Reel = 0,
		Size = 0.25,
	},
	LanternRod = {
		Handling = 0.14,
		Name = "Lantern Rod",
		Rarity = "Uncommon",
		Description = "A little lantern lights the way to the bite.",
		Reel = 0.08,
		Size = 0.1,
	},
	BaguetteRod = {
		Handling = 0.08,
		Name = "Baguette Rod",
		Rarity = "Uncommon",
		Description = "Freshly baked, surprisingly stiff. Do not eat.",
		Reel = 0.12,
		Size = 0.2,
	},
	NightRod = {
		Handling = 0.28,
		Name = "Night Rod",
		Rarity = "Epic",
		Description = "Forged under a new moon. Astral fish answer its call after dark.",
		Reel = 0.15,
		Size = 0.3,
		Astral = 0.04,
	},
	MageStaff = {
		Handling = 0.4,
		Name = "Mage Staff",
		Rarity = "Legendary",
		Description = "An old sorcerer's staff, still humming with magic.",
		Reel = 0.2,
		Size = 0.4,
		Mutation = 0.02,
	},
	PencilRod = {
		Handling = 0.1,
		Name = "Pencil Rod",
		Rarity = "Common",
		Description = "Sketch out your next big catch with a freshly sharpened tip.",
		Reel = 0.08,
		Size = 0.05,
	},
	BaseballRod = {
		Handling = 0.05,
		Name = "Baseball Rod",
		Rarity = "Common",
		Description = "A wooden bat ready to knock a catch out of the water.",
		Reel = 0.05,
		Size = 0.18,
	},
	MusketRod = {
		Handling = 0.08,
		Name = "Musket Rod",
		Rarity = "Uncommon",
		Description = "An antique musket repurposed for a different kind of trophy.",
		Reel = 0.13,
		Size = 0.2,
	},
	HoneycombRod = {
		Handling = 0.2,
		Name = "Honeycomb Rod",
		Rarity = "Rare",
		Description = "Golden honeycomb makes every catch a little sweeter.",
		Reel = 0.2,
		Size = 0.4,
	},
	StarRod = {
		Handling = 0.24,
		Name = "Star Rod",
		Rarity = "Rare",
		Description = "A golden star to wish upon before every cast.",
		Reel = 0.24,
		Size = 0.35,
	},
	SelfieStickRod = {
		Handling = 0.3,
		Name = "Selfie Stick Rod",
		Rarity = "Epic",
		Description = "Catch a fish, then catch your best angle.",
		Reel = 0.32,
		Size = 0.55,
		Mutation = 0.015,
	},
	LightsaberRod = {
		Handling = 0.45,
		Name = "Lightsaber Rod",
		Rarity = "Legendary",
		Description = "A brilliant energy blade with a fishing line. Cast with confidence.",
		Reel = 0.45,
		Size = 0.8,
		Mutation = 0.05,
	},
}

RodSkins.CrateOrder = { "TideCrate", "NoveltyCrate" }
RodSkins.Crates = {
	TideCrate = {
		Name = "Tide Crate",
		Description = "The first crate of rods from Finn's back room.",
		Price = 350,
		Odds = { Common = 0.675, Uncommon = 0.25, Rare = 0.05, Epic = 0.02, Legendary = 0.005 },
		Skins = { "UmbrellaRod", "BambooRod", "BoneRod", "LanternRod", "BaguetteRod", "NightRod", "MageStaff" },
		-- Keep the original crate's reward bands for existing players.
		Rarities = { BaguetteRod = "Rare" },
	},
	NoveltyCrate = {
		Name = "Novelty Crate",
		Description = "Everyday objects, extraordinary catches.",
		Price = 750,
		Odds = { Common = 0.675, Uncommon = 0.25, Rare = 0.05, Epic = 0.02, Legendary = 0.005 },
		Skins = {
			"PencilRod",
			"BaseballRod",
			"BaguetteRod",
			"MusketRod",
			"HoneycombRod",
			"StarRod",
			"SelfieStickRod",
			"LightsaberRod",
		},
	},
}

-- Each crate reward keeps its rolled float. Legacy copies keep baseline bonuses.
RodSkins.DefaultWear = 0.20
RodSkins.WearStates = {
	{ Name = "Factory New", Max = 0.07, Multiplier = 1.20 },
	{ Name = "Minimal Wear", Max = 0.15, Multiplier = 1.10 },
	{ Name = "Field-Tested", Max = 0.38, Multiplier = 1.00 },
	{ Name = "Well-Worn", Max = 0.45, Multiplier = 0.90 },
	{ Name = "Battle-Scarred", Max = 1.01, Multiplier = 0.80 },
}
function RodSkins.validWear(wear: any): boolean
	return type(wear) == "number" and wear >= 0 and wear <= 1
end
function RodSkins.wearState(wear: number?): string
	local value = if RodSkins.validWear(wear) then wear else RodSkins.DefaultWear
	for _, state in RodSkins.WearStates do
		if value < state.Max then
			return state.Name
		end
	end
	return "Battle-Scarred"
end
function RodSkins.wearMultiplier(wear: number?): number
	local name = RodSkins.wearState(wear)
	for _, state in RodSkins.WearStates do
		if state.Name == name then
			return state.Multiplier
		end
	end
	return 1
end

function RodSkins.rarity(skinId: string, crateId: string?): string
	local crate = crateId and RodSkins.Crates[crateId]
	return (crate and crate.Rarities and crate.Rarities[skinId]) or RodSkins.Skins[skinId].Rarity
end

function RodSkins.valid(id: any): boolean
	return type(id) == "string" and RodSkins.Skins[id] ~= nil
end

function RodSkins.validCrate(id: any): boolean
	return type(id) == "string" and RodSkins.Crates[id] ~= nil
end

-- Rolls one skin from a crate with two uniform [0, 1) picks: the first picks the
-- rarity, the second a skin of that rarity.
function RodSkins.roll(crateId: string, rarityPick: number, skinPick: number): string
	local crate = RodSkins.Crates[crateId]
	local rarity = RodSkins.RarityOrder[1]
	local remaining = rarityPick
	for _, name in RodSkins.RarityOrder do
		local odds = crate.Odds[name] or 0
		if odds > 0 then
			rarity = name
			remaining -= odds
			if remaining < 0 then
				break
			end
		end
	end
	local pool = {}
	for _, id in crate.Skins do
		if RodSkins.rarity(id, crateId) == rarity then
			table.insert(pool, id)
		end
	end
	return pool[math.clamp(math.floor(skinPick * #pool) + 1, 1, #pool)]
end

-- Chance of one specific skin from a crate.
function RodSkins.chance(crateId: string, skinId: string): number
	local crate = RodSkins.Crates[crateId]
	local rarity = RodSkins.rarity(skinId, crateId)
	local count = 0
	for _, id in crate.Skins do
		if RodSkins.rarity(id, crateId) == rarity then
			count += 1
		end
	end
	return if table.find(crate.Skins, skinId) then (crate.Odds[rarity] or 0) / count else 0
end

-- Adds a skin's stats to RodUpgrades.boosts; nil or unknown skins add nothing.
function RodSkins.apply(boosts, skinId: string?, wear: number?)
	local skin = skinId and RodSkins.Skins[skinId]
	local result = table.clone(boosts)
	result.handling = result.handling or 1
	result.mutation, result.astral = 0, 0
	if skin then
		local multiplier = RodSkins.wearMultiplier(wear)
		result.reel += (skin.Reel or 0) * multiplier
		result.handling += (skin.Handling or 0) * multiplier
		result.size += (skin.Size or 0) * multiplier
		result.mutation = (skin.Mutation or 0) * multiplier
		result.astral = (skin.Astral or 0) * multiplier
	end
	return result
end

-- Player-facing perk lines, e.g. { "+5% reel per hit", "+4% Astral chance at night" }.
local function perkLines(skinId: string, multiplier: number, maximum: number?): { string }
	local skin = RodSkins.Skins[skinId]
	local lines = {}
	local function percent(value: number): string
		return string.format("%g", math.floor(value * 1000 + 0.5) / 10)
	end
	local function bonus(value: number): string
		local minimum = percent(value * multiplier)
		return if maximum then minimum .. "–" .. percent(value * maximum) else minimum
	end
	if (skin.Reel or 0) > 0 then
		table.insert(lines, string.format("+%s%% reel per hit", bonus(skin.Reel)))
	end
	if (skin.Size or 0) > 0 then
		table.insert(lines, string.format("+%s%% big fish chance", bonus(skin.Size)))
	end
	if (skin.Astral or 0) > 0 then
		table.insert(lines, string.format("+%s%% Astral chance at night", bonus(skin.Astral)))
	end
	if (skin.Mutation or 0) > 0 then
		table.insert(lines, string.format("+%s%% mutation chance", bonus(skin.Mutation)))
	end
	if (skin.Handling or 0) > 0 then
		table.insert(lines, string.format("+%s%% handling", bonus(skin.Handling)))
	end
	return lines
end

function RodSkins.perks(skinId: string, wear: number?): { string }
	return perkLines(skinId, RodSkins.wearMultiplier(wear))
end

-- Unopened crates have no wear yet; show the full range a reward can roll.
function RodSkins.previewPerks(skinId: string): { string }
	local minimum, maximum = math.huge, -math.huge
	for _, state in RodSkins.WearStates do
		minimum = math.min(minimum, state.Multiplier)
		maximum = math.max(maximum, state.Multiplier)
	end
	return perkLines(skinId, minimum, maximum)
end

return RodSkins
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="158">
        <Properties>
          <string name="Name">RodUpgrades</string>
          <string name="Source"><![CDATA[-- Rod upgrades sold by Finn at the Tide & Tackle counter. Each stat has its own
-- level; every level costs more than the last. The server charges and saves
-- levels; FishCatch applies the boosts on both sides so the fight and the
-- server's plausibility check always agree.
local RodUpgrades = {}

RodUpgrades.Order = { "Speed", "Handling", "Strength", "Luck" }
RodUpgrades.Stats = {
	Speed = {
		Name = "Reel Speed",
		Description = "Every hit in the reel fight pulls the fish in further.",
		MaxLevel = 10,
		BasePrice = 120,
		Growth = 1.45,
	},
	Handling = {
		Name = "Handling",
		Description = "A wider green zone, and more progress per green hit means fewer hits to land a fish.",
		MaxLevel = 10,
		BasePrice = 160,
		Growth = 1.45,
	},
	Strength = {
		Name = "Line Strength",
		Description = "A tougher line hooks big and huge fish more often.",
		MaxLevel = 10,
		BasePrice = 200,
		Growth = 1.5,
	},
	Luck = {
		Name = "Rarity Luck",
		Description = "Rare, epic and legendary fish take your bait more often.",
		MaxLevel = 10,
		BasePrice = 500,
		Growth = 1.6,
	},
}

local REEL_PER_LEVEL = 0.07 -- +7% progress per hit
local HANDLING_PER_LEVEL = 0.07 -- +7% progress per green hit
local SIZE_PER_LEVEL = 0.15 -- +15% big and huge chance
local LUCK_PER_LEVEL = 0.03 -- flattens the rarity curve

function RodUpgrades.attribute(stat: string): string
	return "RodUpgrade" .. stat
end

function RodUpgrades.valid(stat: any): boolean
	return type(stat) == "string" and RodUpgrades.Stats[stat] ~= nil
end

-- Cost of buying the level after `level`, or nil once the stat is maxed.
function RodUpgrades.price(stat: string, level: number): number?
	local spec = RodUpgrades.Stats[stat]
	if not spec or level >= spec.MaxLevel then
		return nil
	end
	return math.floor(spec.BasePrice * spec.Growth ^ level / 5 + 0.5) * 5
end

-- Missing or malformed levels count as 0, so old saves and tests need no migration.
function RodUpgrades.level(levels: any, stat: string): number
	local value = type(levels) == "table" and levels[stat]
	local spec = RodUpgrades.Stats[stat]
	if type(value) ~= "number" or value % 1 ~= 0 or not spec then
		return 0
	end
	return math.clamp(value, 0, spec.MaxLevel)
end

export type Boosts = { reel: number, handling: number, size: number, luck: number }

function RodUpgrades.boosts(levels: any): Boosts
	return {
		reel = 1 + REEL_PER_LEVEL * RodUpgrades.level(levels, "Speed"),
		handling = 1 + HANDLING_PER_LEVEL * RodUpgrades.level(levels, "Handling"),
		size = 1 + SIZE_PER_LEVEL * RodUpgrades.level(levels, "Strength"),
		luck = LUCK_PER_LEVEL * RodUpgrades.level(levels, "Luck"),
	}
end

-- Short player-facing summary of what a level gives.
function RodUpgrades.effect(stat: string, level: number): string
	if stat == "Speed" then
		return string.format("+%d%% reel per hit", math.floor(REEL_PER_LEVEL * level * 100 + 0.5))
	elseif stat == "Handling" then
		return string.format("+%d%% green zone & hit progress", math.floor(HANDLING_PER_LEVEL * level * 100 + 0.5))
	elseif stat == "Strength" then
		return string.format("+%d%% big fish chance", math.floor(SIZE_PER_LEVEL * level * 100 + 0.5))
	end
	return string.format("+%d%% rare fish luck", math.floor(LUCK_PER_LEVEL * level * 100 + 0.5))
end

return RodUpgrades
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="159">
        <Properties>
          <string name="Name">SeabedCarpet</string>
          <string name="Source"><![CDATA[-- The ocean-floor carpet: one small seabed patch per grid cell (48 studs at sea,
-- 24 in the harbour lake). It used to be cloned on the server: ~60k copies and
-- ~700k parts, which took live servers past 6.5 GB and crashed them. Now the
-- server only publishes the patch templates (ReplicatedStorage.SeabedCarpet) and
-- each client builds the cells around its own camera (client/SeabedCarpet).
-- Everything here is deterministic, so every client sees the same floor.
local Biomes = require(script.Parent.Biomes)

local SeabedCarpet = {}
SeabedCarpet.FOLDER = "SeabedCarpet"
SeabedCarpet.CELL = 48
SeabedCarpet.LAKE_CELL = 24
SeabedCarpet.TEMPLATES = 24
-- Style folders, in the order the server builds them.
SeabedCarpet.STYLES = { "normal", "swamp", "tropical", "volcanic", "ice", "open" }

local TAU = math.pi * 2

export type Grid = { id: number, cell: number, min: number, max: number, lake: boolean }

-- The lake grid covers the harbour island's square, the ocean grid the whole map.
function SeabedCarpet.grids(): { Grid }
	return {
		{
			id = 1,
			cell = SeabedCarpet.LAKE_CELL,
			min = -Biomes.Normal.radius,
			max = Biomes.Normal.radius,
			lake = true,
		},
		{ id = 2, cell = SeabedCarpet.CELL, min = Biomes.OceanMin, max = Biomes.OceanMax, lake = false },
	}
end

function SeabedCarpet.encode(points: { Vector2 }): string
	local parts = table.create(#points)
	for index, point in points do
		parts[index] = string.format("%.1f,%.1f", point.X, point.Y)
	end
	return table.concat(parts, ";")
end

function SeabedCarpet.decode(text: string?): { Vector2 }
	local points = {}
	for x, z in string.gmatch(text or "", "(-?[%d%.]+),(-?[%d%.]+)") do
		table.insert(points, Vector2.new(tonumber(x) :: number, tonumber(z) :: number))
	end
	return points
end

-- Point-in-polygon test for the lake outline (X/Z as Vector2 X/Y).
function SeabedCarpet.lakeTest(outline: { Vector2 }): (Vector3) -> boolean
	if #outline < 3 then
		return function()
			return false
		end
	end
	local low, high = outline[1], outline[1]
	for _, point in outline do
		low, high = low:Min(point), high:Max(point)
	end
	return function(position: Vector3): boolean
		if position.X < low.X or position.X > high.X or position.Z < low.Y or position.Z > high.Y then
			return false
		end
		local inside = false
		local previous = outline[#outline]
		for _, point in outline do
			if
				(point.Y > position.Z) ~= (previous.Y > position.Z)
				and position.X < (previous.X - point.X) * (position.Z - point.Y) / (previous.Y - point.Y) + point.X
			then
				inside = not inside
			end
			previous = point
		end
		return inside
	end
end

function SeabedCarpet.key(grid: Grid, cx: number, cz: number): number
	return (grid.id * 1000 + cx + 500) * 1000 + cz + 500
end

-- Cells already holding a full garden (the server still builds those) stay bare.
function SeabedCarpet.occupied(grid: Grid, gardens: { Vector2 }): { [number]: boolean }
	local taken = {}
	for _, position in gardens do
		taken[SeabedCarpet.key(grid, math.floor(position.X / grid.cell), math.floor(position.Y / grid.cell))] = true
	end
	return taken
end

-- Cell indices within `radius` studs (on X/Z) of a point, clamped to the grid.
function SeabedCarpet.range(grid: Grid, x: number, z: number, radius: number): (number, number, number, number)
	local cell = grid.cell
	local first, last = math.floor(grid.min / cell), math.floor((grid.max - 1) / cell)
	return math.max(first, math.floor((x - radius) / cell)),
		math.min(last, math.floor((x + radius) / cell)),
		math.max(first, math.floor((z - radius) / cell)),
		math.min(last, math.floor((z + radius) / cell))
end

function SeabedCarpet.style(position: Vector3): string
	local biome = Biomes.at(position)
	return if biome == Biomes.OpenSea then "open" else biome.id
end

export type Sample = (x: number, z: number) -> (RaycastResult?, boolean)

-- Where the cell's patch goes. `sample(x, z)` returns the ground hit, or nil and
-- whether trying again later might succeed (ground not streamed in yet). Returns
-- the hit and the cell's Random (for the patch choice, scale and turn), or nil and
-- whether to retry.
function SeabedCarpet.plan(
	grid: Grid,
	cx: number,
	cz: number,
	seed: number,
	inLake: (Vector3) -> boolean,
	sample: Sample
): (RaycastResult?, Random?, boolean)
	local cell = grid.cell
	local rng = Random.new(seed + grid.id * 7919 + cx * 100003 + cz * 17)
	local x, z = cx * cell, cz * cell
	local retry = false
	for _ = 1, 3 do
		-- Bounded jitter leaves room between neighbouring copies.
		local px = math.clamp(x + cell * rng:NextNumber(0.25, 0.75), grid.min + 1, grid.max - 1)
		local pz = math.clamp(z + cell * rng:NextNumber(0.25, 0.75), grid.min + 1, grid.max - 1)
		local position = Vector3.new(px, Biomes.WaterLevel - 1, pz)
		if not Biomes.inOceanBounds(position) or inLake(position) ~= grid.lake then
			continue
		end
		local hit, again = sample(px, pz)
		if hit then
			return hit, rng, false
		end
		retry = retry or again
	end
	return nil, nil, retry
end

-- The patch's frame on the sampled ground: tilted onto the slope, turned at random.
function SeabedCarpet.frame(hit: RaycastResult, rng: Random): (CFrame, number, number)
	local normal = hit.Normal
	local right = normal:Cross(Vector3.zAxis).Unit
	local frame = CFrame.fromMatrix(hit.Position, right, normal, right:Cross(normal))
	local template = rng:NextInteger(1, SeabedCarpet.TEMPLATES)
	local scale = rng:NextNumber(0.9, 1.25)
	return frame * CFrame.Angles(0, rng:NextNumber(0, TAU), 0), template, scale
end

return SeabedCarpet
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="160">
        <Properties>
          <string name="Name">Seasons</string>
          <string name="Source"><![CDATA[-- The season follows the in-game calendar's months (meteorological seasons: spring is March to
-- May), so every server and client agrees on it without any replication.
local Calendar = require(script.Parent.Calendar)

local Seasons = {}

Seasons.ORDER = { "Spring", "Summer", "Autumn", "Winter" }
-- The season of each month, January first.
Seasons.OF_MONTH = {
	"Winter",
	"Winter",
	"Spring",
	"Spring",
	"Spring",
	"Summer",
	"Summer",
	"Summer",
	"Autumn",
	"Autumn",
	"Autumn",
	"Winter",
}

-- Season name and day within it (1-based) on a calendar date.
function Seasons.of(date: Calendar.Date): (string, number)
	local season = Seasons.OF_MONTH[date.Month]
	local day, month = date.Day, date.Month
	while true do
		local previous = if month == 1 then 12 else month - 1
		if Seasons.OF_MONTH[previous] ~= season then
			break
		end
		month = previous
		day += Calendar.DAYS_IN_MONTH[month]
	end
	return season, day
end

-- Season name and day within it after `elapsed` in-game seconds since the epoch.
function Seasons.at(elapsed: number): (string, number)
	return Seasons.of(Calendar.at(elapsed))
end

-- The current season. A SeasonOverride attribute on workspace pins it (admin command, Studio previews).
function Seasons.current(serverTime: number?): (string, number)
	local override = workspace:GetAttribute("SeasonOverride")
	if type(override) == "string" and table.find(Seasons.ORDER, override) then
		return override, 1
	end
	return Seasons.of(Calendar.now(serverTime))
end

return Seasons
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="161">
        <Properties>
          <string name="Name">SharkDrops</string>
          <string name="Source"><![CDATA[-- Each roll is independent; every eligible contributor gets 2 to 5 rolls.
local SharkDrops = {}
SharkDrops.Table = {
	{ FishId = "SharkMeat", Name = "Shark Meat", Weight = 60 },
	{ FishId = "SharkFin", Name = "Shark Fin", Weight = 20 },
	{ FishId = "SharkTail", Name = "Shark Tail", Weight = 12 },
	{ FishId = "SharkHead", Name = "Shark Head", Weight = 5 },
	{ FishId = "GreatWhiteTooth", Name = "Great White Tooth", Weight = 3 },
}

function SharkDrops.roll(random)
	local drops = {}
	for _ = 1, random:NextInteger(2, 5) do
		local roll = random:NextInteger(1, 100)
		for _, item in SharkDrops.Table do
			roll -= item.Weight
			if roll <= 0 then
				table.insert(drops, { FishId = item.FishId, Name = item.Name })
				break
			end
		end
	end
	return drops
end

return SharkDrops
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="162">
        <Properties>
          <string name="Name">ShopUpgrades</string>
          <string name="Source"><![CDATA[-- Shared shop upgrade prices and customer arrival settings.
local Upgrades = {}

Upgrades.SocialMediaAdvertisement = {
	Name = "Social Media Advertisement",
	Description = "Attracts more passing pedestrians and allows 2 customers per register.",
	Price = 1000,
}

Upgrades.Baskets = {
	Name = "Baskets",
	Description = "Customers can buy up to 3 items at a time.",
	Price = 2000,
}

function Upgrades.hasBaskets(data)
	return (data.Upgrades.Baskets or 0) >= 1
end

function Upgrades.hasAdvertisement(data)
	return (data.Upgrades.SocialMediaAdvertisement or 0) >= 1
end

return Upgrades
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="163">
        <Properties>
          <string name="Name">SpearSkins</string>
          <string name="Source"><![CDATA[-- Shark spear crate rewards. Colors are RGB triplets so this catalog can also
-- be used by the data and UI tests without Roblox globals.
local SpearSkins = {}

SpearSkins.RarityOrder = { "Common", "Uncommon", "Rare", "Epic", "Legendary" }
SpearSkins.Rarities = {
	Common = { Color = { 196, 201, 205 } },
	Uncommon = { Color = { 111, 202, 125 } },
	Rare = { Color = { 86, 156, 240 } },
	Epic = { Color = { 186, 104, 240 } },
	Legendary = { Color = { 255, 196, 64 } },
}

-- Damage and FireRate are fractional bonuses, scaled by the rolled wear.
-- Ordinary rewards keep the standard spear silhouette; only the two highest
-- rarities introduce a different head shape.
SpearSkins.Skins = {
	Driftwood = {
		Name = "Driftwood Spear",
		Rarity = "Common",
		Description = "A weathered sea-washed finish.",
		Shape = "Standard",
		ShaftColor = { 148, 119, 84 },
		GripColor = { 84, 65, 48 },
		TipColor = { 170, 177, 177 },
		AccentColor = { 197, 176, 131 },
		ShaftMaterial = "Wood",
		Damage = 0.05,
	},
	DeepBlue = {
		Name = "Deep Blue Spear",
		Rarity = "Common",
		Description = "Blue as the water beneath your boat.",
		Shape = "Standard",
		ShaftColor = { 48, 99, 137 },
		GripColor = { 30, 53, 72 },
		TipColor = { 175, 199, 208 },
		AccentColor = { 219, 231, 221 },
		ShaftMaterial = "SmoothPlastic",
		FireRate = 0.05,
	},
	Coral = {
		Name = "Coral Spear",
		Rarity = "Uncommon",
		Description = "A bright finish inspired by the reef.",
		Shape = "Standard",
		ShaftColor = { 222, 107, 91 },
		GripColor = { 123, 66, 61 },
		TipColor = { 230, 198, 166 },
		AccentColor = { 246, 167, 126 },
		ShaftMaterial = "SmoothPlastic",
		Damage = 0.08,
	},
	Seafoam = {
		Name = "Seafoam Spear",
		Rarity = "Uncommon",
		Description = "Pale green with a crisp sea breeze.",
		Shape = "Standard",
		ShaftColor = { 113, 194, 174 },
		GripColor = { 44, 102, 95 },
		TipColor = { 195, 226, 213 },
		AccentColor = { 227, 247, 225 },
		ShaftMaterial = "SmoothPlastic",
		FireRate = 0.08,
	},
	Obsidian = {
		Name = "Obsidian Spear",
		Rarity = "Rare",
		Description = "Dark metal with a sharp edge.",
		Shape = "Standard",
		ShaftColor = { 51, 53, 64 },
		GripColor = { 28, 27, 36 },
		TipColor = { 115, 119, 133 },
		AccentColor = { 164, 112, 219 },
		ShaftMaterial = "Slate",
		Damage = 0.12,
	},
	Storm = {
		Name = "Storm Spear",
		Rarity = "Rare",
		Description = "A flash of silver in dark water.",
		Shape = "Standard",
		ShaftColor = { 112, 132, 158 },
		GripColor = { 49, 64, 88 },
		TipColor = { 214, 225, 235 },
		AccentColor = { 145, 213, 248 },
		ShaftMaterial = "Metal",
		FireRate = 0.12,
	},
	ReefTrident = {
		Name = "Reef Trident",
		Rarity = "Epic",
		Description = "Three points forged for the open sea.",
		Shape = "Trident",
		ShaftColor = { 36, 139, 137 },
		GripColor = { 29, 77, 76 },
		TipColor = { 120, 222, 207 },
		AccentColor = { 236, 204, 131 },
		ShaftMaterial = "Metal",
		Damage = 0.16,
	},
	GoldenHarpoon = {
		Name = "Golden Harpoon",
		Rarity = "Legendary",
		Description = "A gilded harpoon fit for a shark hunter.",
		Shape = "Harpoon",
		ShaftColor = { 176, 130, 49 },
		GripColor = { 83, 57, 31 },
		TipColor = { 255, 216, 111 },
		AccentColor = { 255, 237, 174 },
		ShaftMaterial = "Metal",
		FireRate = 0.20,
	},
}

SpearSkins.CrateOrder = { "SpearCrate" }
SpearSkins.Crates = {
	SpearCrate = {
		Name = "Spear Crate",
		Description = "Sea-inspired spear finishes for shark hunters.",
		Price = 350,
		Odds = { Common = 0.675, Uncommon = 0.25, Rare = 0.05, Epic = 0.02, Legendary = 0.005 },
		Skins = { "Driftwood", "DeepBlue", "Coral", "Seafoam", "Obsidian", "Storm", "ReefTrident", "GoldenHarpoon" },
	},
}

-- Match rod wear bands exactly. Wear is rolled per copy and stays fixed.
SpearSkins.DefaultWear = 0.20
SpearSkins.WearStates = {
	{ Name = "Factory New", Max = 0.07, Multiplier = 1.20 },
	{ Name = "Minimal Wear", Max = 0.15, Multiplier = 1.10 },
	{ Name = "Field-Tested", Max = 0.38, Multiplier = 1.00 },
	{ Name = "Well-Worn", Max = 0.45, Multiplier = 0.90 },
	{ Name = "Battle-Scarred", Max = 1.01, Multiplier = 0.80 },
}

function SpearSkins.validWear(wear: any): boolean
	return type(wear) == "number" and wear >= 0 and wear <= 1
end

function SpearSkins.wearState(wear: number?): string
	local value = if SpearSkins.validWear(wear) then wear else SpearSkins.DefaultWear
	for _, state in SpearSkins.WearStates do
		if value < state.Max then
			return state.Name
		end
	end
	return "Battle-Scarred"
end

function SpearSkins.wearMultiplier(wear: number?): number
	local name = SpearSkins.wearState(wear)
	for _, state in SpearSkins.WearStates do
		if state.Name == name then
			return state.Multiplier
		end
	end
	return 1
end

function SpearSkins.valid(id: any): boolean
	return type(id) == "string" and SpearSkins.Skins[id] ~= nil
end

function SpearSkins.validCrate(id: any): boolean
	return type(id) == "string" and SpearSkins.Crates[id] ~= nil
end

function SpearSkins.rarity(skinId: string, _crateId: string?): string
	return SpearSkins.Skins[skinId].Rarity
end

function SpearSkins.roll(crateId: string, rarityPick: number, skinPick: number): string
	local crate = SpearSkins.Crates[crateId]
	local rarity = SpearSkins.RarityOrder[1]
	local remaining = rarityPick
	for _, name in SpearSkins.RarityOrder do
		local odds = crate.Odds[name] or 0
		if odds > 0 then
			rarity = name
			remaining -= odds
			if remaining < 0 then
				break
			end
		end
	end
	local pool = {}
	for _, id in crate.Skins do
		if SpearSkins.rarity(id, crateId) == rarity then
			table.insert(pool, id)
		end
	end
	return pool[math.clamp(math.floor(skinPick * #pool) + 1, 1, #pool)]
end

function SpearSkins.chance(crateId: string, skinId: string): number
	local crate = SpearSkins.Crates[crateId]
	if not table.find(crate.Skins, skinId) then
		return 0
	end
	local rarity = SpearSkins.rarity(skinId, crateId)
	local count = 0
	for _, id in crate.Skins do
		if SpearSkins.rarity(id, crateId) == rarity then
			count += 1
		end
	end
	return (crate.Odds[rarity] or 0) / count
end

function SpearSkins.boosts(skinId: string?, wear: number?)
	local skin = skinId and SpearSkins.Skins[skinId]
	local multiplier = SpearSkins.wearMultiplier(wear)
	return {
		damage = if skin then (skin.Damage or 0) * multiplier else 0,
		fireRate = if skin then (skin.FireRate or 0) * multiplier else 0,
	}
end

function SpearSkins.perks(skinId: string, wear: number?): { string }
	local boost = SpearSkins.boosts(skinId, wear)
	local lines = {}
	local function percent(value: number): string
		return string.format("%g", math.floor(value * 1000 + 0.5) / 10)
	end
	if boost.damage > 0 then
		table.insert(lines, string.format("+%s%% shark damage", percent(boost.damage)))
	end
	if boost.fireRate > 0 then
		table.insert(lines, string.format("+%s%% fire rate", percent(boost.fireRate)))
	end
	return lines
end

return SpearSkins
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="164">
        <Properties>
          <string name="Name">Spears</string>
          <string name="Source"><![CDATA[-- Rules and the replicated hotbar tool for the shark-hunting spear.
local Spears = {}
Spears.PRICE = 250
Spears.ID = "BasicSpear"

function Spears.buyProblem(profile): string?
	if profile.OwnedSpears[Spears.ID] then
		return "You already own a spear. Find it in your hotbar."
	elseif profile.Cash < Spears.PRICE then
		return string.format("You need $%d for a spear.", Spears.PRICE)
	end
	return nil
end

function Spears.buy(profile)
	local problem = Spears.buyProblem(profile)
	assert(problem == nil, problem)
	profile.Cash -= Spears.PRICE
	profile.Angler.Stats.CoinsSpent += Spears.PRICE
	profile.OwnedSpears[Spears.ID] = true
end

-- Optional skins restyle the same spear; the server owns the equipped skin and stats.
function Spears.build(skinId: string?, wear: number?): Tool
	local SpearSkins = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").SpearSkins)
	local skin = skinId and SpearSkins.Skins[skinId]
	local function color(rgb, fallback)
		return if rgb then Color3.fromRGB(rgb[1], rgb[2], rgb[3]) else fallback
	end
	local tool = Instance.new("Tool")
	tool.Name = "Spear"
	tool.ToolTip = "Attack sharks in the sea."
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("SpearId", Spears.ID)
	if skin then
		tool:SetAttribute("SpearSkin", skinId)
		tool:SetAttribute("SpearSkinWear", wear)
	end
	local shaftColor = color(skin and skin.ShaftColor, Color3.fromRGB(119, 82, 46))
	local tipColor = color(skin and skin.TipColor, Color3.fromRGB(155, 174, 174))
	local gripColor = color(skin and skin.GripColor, Color3.fromRGB(77, 58, 41))
	local accent = color(skin and skin.AccentColor, Color3.fromRGB(181, 147, 92))
	local shaftMaterial = if skin and skin.ShaftMaterial then Enum.Material[skin.ShaftMaterial] else Enum.Material.Wood
	local wearValue = if SpearSkins.validWear(wear) then wear else SpearSkins.DefaultWear
	-- A restrained patina keeps the palette legible at every wear level.
	local patina = Color3.fromRGB(103, 100, 91)
	shaftColor = shaftColor:Lerp(patina, wearValue * 0.16)
	tipColor = tipColor:Lerp(patina, wearValue * 0.22)
	local edgeColor = tipColor:Lerp(Color3.fromRGB(245, 248, 239), 0.3)
	local metal = Enum.Material.Metal
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.25, 4.5, 0.25)
	-- Preserve the original grip frame and length; visible geometry is welded
	-- around this root so combat thrusts and inventory previews share one model.
	handle.Transparency = 1
	handle.CFrame = CFrame.new()
	handle.CanCollide, handle.CanTouch, handle.CanQuery, handle.Massless = false, false, false, true
	handle.Parent = tool
	local function piece(name, size, offset, tint, material, className)
		local part = Instance.new(className or "Part")
		part.Name, part.Size, part.Color, part.Material = name, size, tint, material
		part.CanCollide, part.CanTouch, part.CanQuery, part.Massless = false, false, false, true
		part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		part.CastShadow = false
		if material == metal then
			part.Reflectance = 0.06 * (1 - wearValue)
		end
		part.CFrame = handle.CFrame * offset
		part.Parent = tool
		local weld = Instance.new("WeldConstraint")
		weld.Part0, weld.Part1, weld.Parent = handle, part, handle
		return part
	end
	local function cylinder(name, length, diameter, frame, tint, material)
		local part = piece(name, Vector3.new(length, diameter, diameter),
			frame * CFrame.Angles(0, 0, math.pi / 2), tint, material or metal)
		part.Shape = Enum.PartType.Cylinder
		return part
	end
	local function band(name, y, diameter, tint, length)
		return cylinder(name, length or 0.07, diameter, CFrame.new(0, y, 0), tint)
	end
	local function link(name, a, b, diameter, tint)
		local up = (b - a).Unit
		local right = up:Cross(Vector3.new(0, 0, 1)).Unit
		cylinder(name, (b - a).Magnitude, diameter,
			CFrame.fromMatrix((a + b) / 2, right, up, right:Cross(up)), tint)
	end
	-- Opposed wedges meet at the centerline: a true point from both sides,
	-- with a shorter reverse taper at the socket and a raised central facet.
	local function blade(name, frame, width, upper, lower, depth, tint)
		for _, half in { { upper, 1 }, { lower, -1 } } do
			local height, direction = half[1], half[2]
			for _, side in { -1, 1 } do
				piece(name, Vector3.new(depth, height, width / 2),
					frame * CFrame.Angles(0, 0, if direction == 1 then 0 else math.pi)
						* CFrame.new(side * width / 4, height / 2, 0)
						* CFrame.Angles(0, -side * math.pi / 2, 0),
					tint, metal, "WedgePart")
			end
		end
	end
	local function facetedBlade(name, frame, width, upper, lower, depth)
		blade(name, frame, width, upper, lower, depth, edgeColor)
		blade(name .. "Ridge", frame, width * 0.36, upper * 0.93, lower * 0.92, depth + 0.035, tipColor)
	end

	cylinder("Shaft", 4.45, 0.21, CFrame.new(0, 0, 0), shaftColor, shaftMaterial)
	cylinder("Grip", 1.1, 0.27, CFrame.new(0, -0.55, 0), gripColor, Enum.Material.Fabric)
	for i = 0, 6 do
		cylinder("GripWrap", 0.035, 0.287,
			CFrame.new(0, -1.01 + i * 0.15, 0) * CFrame.Angles(0, 0, math.rad(11)),
			gripColor:Lerp(accent, 0.3), Enum.Material.Fabric)
	end
	band("GripHeel", -1.14, 0.3, accent)
	band("GripCrown", 0.04, 0.3, accent)
	band("ButtCap", -2.2, 0.26, tipColor, 0.16)
	band("ButtRim", -2.11, 0.275, accent, 0.045)
	cylinder("HeadSocket", 0.4, 0.285, CFrame.new(0, 2.15, 0), tipColor)
	band("SocketRim", 1.96, 0.31, accent)
	band("SocketCrown", 2.31, 0.31, accent)

	local shape = skin and skin.Shape or "Standard"
	if shape == "Trident" then
		facetedBlade("Spearhead", CFrame.new(0, 2.6, 0), 0.35, 0.83, 0.28, 0.15)
		for _, side in { -1, 1 } do
			link("TridentShoulder", Vector3.new(0, 2.18, 0), Vector3.new(side * 0.47, 2.3, 0), 0.17, tipColor)
			link("TridentArm", Vector3.new(side * 0.47, 2.3, 0), Vector3.new(side * 0.63, 2.6, 0), 0.15, tipColor)
			facetedBlade("Prong", CFrame.new(side * 0.63, 2.73, 0), 0.26, 0.53, 0.22, 0.13)
		end
	elseif shape == "Harpoon" then
		facetedBlade("Spearhead", CFrame.new(0, 2.66, 0), 0.42, 0.77, 0.32, 0.18)
		for _, side in { -1, 1 } do
			-- Swept, backward-facing barbs grow out of the main blade.
			blade("HarpoonBarb", CFrame.new(side * 0.23, 2.62, 0)
				* CFrame.Angles(0, 0, math.rad(-side * 155)), 0.23, 0.53, 0.14, 0.16, tipColor)
		end
	else
		facetedBlade("Spearhead", CFrame.new(0, 2.62, 0), 0.53, 0.8, 0.3, 0.14)
	end

	if skinId == "Driftwood" or not skin then
		for i = 0, 3 do
			cylinder("SocketLashing", 0.045, 0.32, CFrame.new(0, 1.96 + i * 0.085, 0), accent, Enum.Material.Fabric)
		end
	elseif skinId == "DeepBlue" then
		for _, y in { 0.36, 0.51, 1.55 } do band("NauticalStripe", y, 0.23, accent) end
	elseif skinId == "Coral" then
		for _, side in { -1, 1 } do
			link("CoralBranch", Vector3.new(0, 1.62, 0), Vector3.new(side * 0.23, 1.82, 0), 0.085, accent)
			link("CoralTwig", Vector3.new(side * 0.23, 1.82, 0), Vector3.new(side * 0.27, 2.02, 0), 0.065, accent)
		end
	elseif skinId == "Seafoam" then
		for i = 0, 4 do
			band("FoamRing", 0.65 + i * 0.18, 0.24 + (i % 2) * 0.025, accent, 0.035)
		end
	elseif skinId == "Obsidian" then
		-- Dark facets with violet seams on both faces of the blade.
		for _, face in { -1, 1 } do
			piece("ObsidianSeam", Vector3.new(0.026, 0.43, 0.025),
				CFrame.new(0, 2.78, face * 0.107) * CFrame.Angles(0, 0, -0.16), accent, Enum.Material.Neon)
		end
		band("ObsidianCollar", 1.76, 0.27, accent, 0.12)
	elseif skinId == "Storm" then
		for _, face in { -1, 1 } do
			for i = 0, 2 do
				piece("LightningInlay", Vector3.new(0.04, 0.24, 0.025),
					CFrame.new(if i == 1 then 0.035 else 0, 1.05 + i * 0.19, face * 0.113)
						* CFrame.Angles(0, 0, if i == 1 then -0.55 else 0.4), accent, Enum.Material.Neon)
			end
		end
	elseif shape == "Trident" then
		for _, face in { -1, 1 } do
			local gem = piece("ReefPearl", Vector3.new(0.2, 0.25, 0.12), CFrame.new(0, 2.2, face * 0.12), accent, Enum.Material.SmoothPlastic)
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = gem
		end
		for _, y in { 0.38, 1.45, 1.62 } do band("ReefFiligree", y, 0.25, accent, 0.045) end
	elseif shape == "Harpoon" then
		for _, y in { 0.34, 0.47, 1.56, 1.69 } do band("GildedBand", y, 0.26, accent, 0.055) end
		for _, face in { -1, 1 } do
			blade("HarpoonCrest", CFrame.new(0, 2.14, face * 0.16), 0.15, 0.13, 0.13, 0.04, accent)
		end
	end
	game:GetService("CollectionService"):AddTag(tool, "Spear")
	return tool
end

return Spears
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="165">
        <Properties>
          <string name="Name">StaffCatalog</string>
          <string name="Source"><![CDATA[-- One permanent hire per role; prices are charged by the server once.
local Staff = {
	Order = { "Seller", "Porter", "Fisherman", "RestaurantChef", "CompanyChef" },
	Roles = {
		Seller = {
			Name = "Seller",
			Price = 250,
			Description = "Serves customers at your register and collects payment automatically.",
		},
		Porter = {
			Name = "Porter",
			Price = 400,
			Description = "Carries fish from docked boats to your freezer or storage, and restocks the freezer. "
				.. "At level 2 he collects crab cages, and at level 3 mussel nets.",
		},
		-- Requires names the Paths stage that unlocks hiring.
		Fisherman = {
			Name = "Fisherman",
			Price = 6000,
			Requires = "Company",
			Description = "Takes the boat you assign onto the water and fishes on his own. "
				.. "He moors beside your dock when the hold is full; your porter unloads the catch.",
		},
		RestaurantChef = {
			Name = "Restaurant Chef",
			Price = 6000,
			Requires = "Restaurant",
			Description = "Cooks your chosen recipe using fish from kitchen storage. Dishes go to the kitchen pass for diners and shop customers.",
		},
		CompanyChef = {
			Name = "Company Chef",
			Price = 6000,
			Requires = "Company",
			Description = "Cooks your chosen recipe using fish from kitchen storage. Dishes go to the kitchen pass for shop customers and diners.",
		},
	},
}

Staff.PorterUpgradeOrder = { "PorterSpeed", "PorterCapacity" }
Staff.PorterUpgrades = {
	PorterSpeed = {
		Name = "Speed",
		Unit = "studs/sec",
		Values = { 16, 20, 24, 28, 32 },
		Prices = { 120, 300, 700, 1500 },
	},
	PorterCapacity = {
		Name = "Carry Capacity",
		Unit = "fish/trip",
		Values = { 1, 2, 3, 4, 5 },
		Prices = { 120, 300, 700, 1500 },
	},
}

function Staff.porterLevel(data, id: string): number
	local upgrade = Staff.PorterUpgrades[id]
	local level = data.Upgrades and data.Upgrades[id] or 0
	return math.clamp(math.floor(level), 0, #upgrade.Prices)
end

Staff.PorterLevelPrices = { 300, 700, 1500 }
function Staff.workerLevel(data, role: string): number
	if role ~= "Porter" then return 1 end
	return math.clamp(1 + (data.Upgrades.PorterLevel or 0), 1, 4)
end

function Staff.porterStats(data): (number, number)
	return Staff.PorterUpgrades.PorterSpeed.Values[Staff.porterLevel(data, "PorterSpeed") + 1],
		math.max(3, Staff.PorterUpgrades.PorterCapacity.Values[Staff.porterLevel(data, "PorterCapacity") + 1])
end

-- Fixed Marketplace uniforms keep each job recognizable. Account avatars can
-- change independently of the game and bring unrelated logos or body packages.
-- Asset IDs are catalog items, not clothing-template image IDs.
local OUTFITS = {
	Seller = {
		Shirt = 382578523, -- Apron: white shirt with a dark bib apron
		Pants = 129459077, -- Black Slacks, including black shoes
		Hair = "376548738", -- Brown Charmer Hair
		Hat = "",
		Skin = Color3.fromRGB(224, 173, 132),
	},
	Porter = {
		Shirt = 6500613508, -- Mechanic Coveralls +
		Pants = 6500616492, -- Mechanic Coveralls -, matching navy trousers/boots
		Hair = "",
		Hat = "9667880157", -- Hard Hat
		Skin = Color3.fromRGB(157, 105, 74),
	},
	Fisherman = {
		Shirt = 733260904, -- Fisherman Shirt
		Pants = 129459077, -- Black Slacks, including black shoes
		Hair = "",
		Hat = "10714423462", -- Green Fisherman Hat
		Skin = Color3.fromRGB(198, 140, 104),
	},
	RestaurantChef = {
		Shirt = 44054130, -- Chef Shirt
		Pants = 129459077,
		Hair = "",
		Hat = "1560402166", -- Chef de Cuisine Hat
		Skin = Color3.fromRGB(224, 173, 132),
	},
	CompanyChef = {
		Shirt = 44054130, -- Chef Shirt
		Pants = 129459077,
		Hair = "",
		Hat = "1560402166", -- Chef de Cuisine Hat
		Skin = Color3.fromRGB(157, 105, 74),
	},
}

function Staff.description(role: string): HumanoidDescription
	assert(Staff.Roles[role], "Unknown staff role")
	local outfit = OUTFITS[role]
	local description = Instance.new("HumanoidDescription")
	description.Shirt, description.Pants = outfit.Shirt, outfit.Pants
	description.HairAccessory, description.HatAccessory = outfit.Hair, outfit.Hat
	description.HeadColor, description.TorsoColor = outfit.Skin, outfit.Skin
	description.LeftArmColor, description.RightArmColor = outfit.Skin, outfit.Skin
	description.LeftLegColor, description.RightLegColor = outfit.Skin, outfit.Skin
	-- Standard R15 joints with classic proportions for walking and carrying fish.
	description.BodyTypeScale, description.ProportionScale = 0, 0
	description.HeightScale, description.WidthScale, description.DepthScale = 1, 1, 1
	description.HeadScale = 1
	return description
end

-- Use the engine's smile instead of a retired Marketplace face or a face mask.
function Staff.finishModel(model: Model)
	local head = model:FindFirstChild("Head")
	if not head then
		return
	end
	local face = head:FindFirstChild("face")
	if not face then
		face = Instance.new("Decal")
		face.Name, face.Parent = "face", head
	end
	if face:IsA("Decal") then
		face.Face = Enum.NormalId.Front
		face.Texture = "rbxasset://textures/face.png"
	end
end

return Staff
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="166">
        <Properties>
          <string name="Name">Stocks</string>
          <string name="Source"><![CDATA[-- The office PC's stock market (Harbour Exchange): the listed companies and the pure portfolio
-- rules the server runs inside UpdateAsync. Prices themselves are computed only on the server
-- (StockPrices, with a private salt) so nobody can read future prices out of this module.
--
-- Time is the shared in-game calendar (DayNight.elapsed): one in-game day is 24 real minutes,
-- so a dividend week is 7 in-game days = 168 real minutes.
local Stocks = {}

-- Real seconds between price ticks.
Stocks.TICK_SECONDS = 5
-- Real seconds in one in-game day (DayNight.SECONDS_PER_HOUR * 24).
Stocks.DAY_SECONDS = 24 * 60
Stocks.WEEK_DAYS = 7
Stocks.WEEK_SECONDS = Stocks.DAY_SECONDS * Stocks.WEEK_DAYS
-- In-game seconds per real second (an in-game minute passes every real second).
Stocks.GAME_SPEED = 60

-- Broker commission on every order.
Stocks.FEE_RATE = 0.0025
Stocks.MIN_FEE = 1
Stocks.MAX_ORDER = 10000
Stocks.MAX_SHARES = 1000000
-- Weeks that passed while you were away pay out at most this many times on your return.
Stocks.MAX_BACKPAY = 4
Stocks.HISTORY_LENGTH = 8

-- Chart ranges: how many ticks each covers and the spacing of the points sent for it.
Stocks.RANGES = {
	Live = { Ticks = 60, Step = 1, Label = "LIVE" },
	Day = { Ticks = 288, Step = 4, Label = "DAY" },
	Week = { Ticks = 2016, Step = 28, Label = "WEEK" },
}
Stocks.RANGE_ORDER = { "Live", "Day", "Week" }

-- Base is the price the stock swings around, Vol how far it swings (log scale), Yield the share
-- of its price paid as a dividend every in-game week. Prices are game prices, loosely real.
Stocks.Companies = {
	{
		Ticker = "AAPL",
		Name = "Apple Inc.",
		Exchange = "NASDAQ",
		Sector = "Technology",
		About = "iPhones, Macs and services",
		Base = 230,
		Vol = 0.22,
		Yield = 0.004,
	},
	{
		Ticker = "MSFT",
		Name = "Microsoft",
		Exchange = "NASDAQ",
		Sector = "Technology",
		About = "Windows, Office and Azure cloud",
		Base = 420,
		Vol = 0.2,
		Yield = 0.005,
	},
	{
		Ticker = "NVDA",
		Name = "NVIDIA",
		Exchange = "NASDAQ",
		Sector = "Semiconductors",
		About = "Graphics chips and AI accelerators",
		Base = 180,
		Vol = 0.38,
		Yield = 0.002,
	},
	{
		Ticker = "AMZN",
		Name = "Amazon.com",
		Exchange = "NASDAQ",
		Sector = "Retail & cloud",
		About = "Online store and AWS",
		Base = 200,
		Vol = 0.28,
		Yield = 0.002,
	},
	{
		Ticker = "TSLA",
		Name = "Tesla",
		Exchange = "NASDAQ",
		Sector = "Automotive",
		About = "Electric cars and batteries",
		Base = 250,
		Vol = 0.45,
		Yield = 0.001,
	},
	{
		Ticker = "RBLX",
		Name = "Roblox Corp.",
		Exchange = "NYSE",
		Sector = "Gaming",
		About = "The platform you are playing on",
		Base = 60,
		Vol = 0.42,
		Yield = 0.002,
	},
	{
		Ticker = "JPM",
		Name = "JPMorgan Chase",
		Exchange = "NYSE",
		Sector = "Banking",
		About = "America's largest bank",
		Base = 240,
		Vol = 0.18,
		Yield = 0.009,
	},
	{
		Ticker = "KO",
		Name = "Coca-Cola",
		Exchange = "NYSE",
		Sector = "Beverages",
		About = "Soft drinks sold everywhere",
		Base = 68,
		Vol = 0.1,
		Yield = 0.012,
	},
	{
		Ticker = "MCD",
		Name = "McDonald's",
		Exchange = "NYSE",
		Sector = "Restaurants",
		About = "Burgers, fries and franchises",
		Base = 290,
		Vol = 0.12,
		Yield = 0.01,
	},
	{
		Ticker = "DIS",
		Name = "Walt Disney",
		Exchange = "NYSE",
		Sector = "Entertainment",
		About = "Films, parks and cruise ships",
		Base = 110,
		Vol = 0.24,
		Yield = 0.006,
	},
	{
		Ticker = "SHEL",
		Name = "Shell plc",
		Exchange = "NYSE",
		Sector = "Energy",
		About = "Oil, gas and marine fuel",
		Base = 70,
		Vol = 0.22,
		Yield = 0.014,
	},
	{
		Ticker = "CCL",
		Name = "Carnival Corp.",
		Exchange = "NYSE",
		Sector = "Cruise lines",
		About = "Cruise ships, like the ones in the city port",
		Base = 24,
		Vol = 0.4,
		Yield = 0.005,
	},
	{
		Ticker = "BC",
		Name = "Brunswick",
		Exchange = "NYSE",
		Sector = "Boats & engines",
		About = "Mercury outboards, Sea Ray and Boston Whaler",
		Base = 65,
		Vol = 0.3,
		Yield = 0.008,
	},
	{
		Ticker = "AMKBY",
		Name = "A.P. Moller-Maersk",
		Exchange = "OTC",
		Sector = "Shipping",
		About = "Container ships and ports",
		Base = 9,
		Vol = 0.32,
		Yield = 0.016,
	},
	{
		Ticker = "MHGVY",
		Name = "Mowi ASA",
		Exchange = "OTC",
		Sector = "Seafood",
		About = "The world's biggest salmon farmer",
		Base = 18,
		Vol = 0.2,
		Yield = 0.018,
	},
	{
		Ticker = "SMNNY",
		Name = "Shimano",
		Exchange = "OTC",
		Sector = "Fishing & cycling",
		About = "Fishing reels, rods and bike parts",
		Base = 14,
		Vol = 0.24,
		Yield = 0.007,
	},
}

Stocks.byTicker = {}
for index, company in Stocks.Companies do
	company.Index = index
	Stocks.byTicker[company.Ticker] = company
end

function Stocks.tickAt(elapsed: number): number
	return math.floor(elapsed / Stocks.TICK_SECONDS)
end

function Stocks.dayAt(elapsed: number): number
	return math.floor(elapsed / Stocks.DAY_SECONDS)
end

-- The dividend week `elapsed` falls in. Week n pays out at its start, weekStart(n).
function Stocks.weekAt(elapsed: number): number
	return math.floor(elapsed / Stocks.WEEK_SECONDS)
end

function Stocks.weekStart(week: number): number
	return week * Stocks.WEEK_SECONDS
end

-- First tick of the in-game day `elapsed` falls in (the day's opening price).
function Stocks.dayOpenTick(elapsed: number): number
	return math.ceil(Stocks.dayAt(elapsed) * Stocks.DAY_SECONDS / Stocks.TICK_SECONDS)
end

function Stocks.weekTick(week: number): number
	return math.ceil(Stocks.weekStart(week) / Stocks.TICK_SECONDS)
end

function Stocks.fee(amount: number): number
	return math.max(Stocks.MIN_FEE, math.ceil(amount * Stocks.FEE_RATE))
end

function Stocks.buyCost(price: number, shares: number): (number, number)
	local gross = math.ceil(price * shares - 1e-9)
	local fee = Stocks.fee(gross)
	return gross + fee, fee
end

function Stocks.sellProceeds(price: number, shares: number): (number, number)
	local gross = math.floor(price * shares + 1e-9)
	local fee = math.min(gross, Stocks.fee(gross))
	return gross - fee, fee
end

-- Most whole shares `cash` buys at `price`, fee included.
function Stocks.affordable(price: number, cash: number): number
	if price <= 0 then
		return 0
	end
	local shares = math.min(Stocks.MAX_ORDER, math.floor(cash / (price * (1 + Stocks.FEE_RATE))))
	while shares > 0 and Stocks.buyCost(price, shares) > cash do
		shares -= 1
	end
	return math.max(shares, 0)
end

local function wholeNumber(value: any, max: number): boolean
	return type(value) == "number" and value >= 0 and value <= max and value % 1 == 0
end

-- A saved portfolio, normalized. Unknown tickers and malformed entries are dropped rather than
-- failing the profile, the same as retired rod skins.
export type Portfolio = {
	Holdings: { [string]: { Shares: number, Cost: number } },
	Week: number?,
	Paid: number,
	History: { { Week: number, Amount: number } },
}

function Stocks.decode(raw: any): Portfolio
	local portfolio: Portfolio = { Holdings = {}, Week = nil, Paid = 0, History = {} }
	if type(raw) ~= "table" then
		return portfolio
	end
	if type(raw.Holdings) == "table" then
		for ticker, holding in raw.Holdings do
			if
				type(ticker) == "string"
				and Stocks.byTicker[ticker]
				and type(holding) == "table"
				and wholeNumber(holding.Shares, Stocks.MAX_SHARES)
				and holding.Shares > 0
				and wholeNumber(holding.Cost, 2 ^ 53 - 1)
			then
				portfolio.Holdings[ticker] = { Shares = holding.Shares, Cost = holding.Cost }
			end
		end
	end
	if wholeNumber(raw.Week, 2 ^ 31) then
		portfolio.Week = raw.Week
	end
	if wholeNumber(raw.Paid, 2 ^ 53 - 1) then
		portfolio.Paid = raw.Paid
	end
	if type(raw.History) == "table" then
		for _, entry in raw.History do
			if
				type(entry) == "table"
				and wholeNumber(entry.Week, 2 ^ 31)
				and wholeNumber(entry.Amount, 2 ^ 53 - 1)
				and #portfolio.History < Stocks.HISTORY_LENGTH
			then
				table.insert(portfolio.History, { Week = entry.Week, Amount = entry.Amount })
			end
		end
	end
	return portfolio
end

function Stocks.hasHoldings(portfolio: Portfolio): boolean
	return next(portfolio.Holdings) ~= nil
end

-- Pays every dividend week that started since the portfolio was last settled, at the shares held
-- now (trades always settle first, so those were the shares held at each payout). `priceAt(ticker,
-- week)` is the price at that week's opening tick. Returns the cash earned and the weeks paid.
function Stocks.settle(portfolio: Portfolio, week: number, priceAt: (string, number) -> number): (number, number)
	local last = portfolio.Week
	portfolio.Week = math.max(last or week, week)
	if last == nil or week <= last or not Stocks.hasHoldings(portfolio) then
		return 0, 0
	end
	local first = math.max(last + 1, week - Stocks.MAX_BACKPAY + 1)
	local total = 0
	for payWeek = first, week do
		local amount = 0
		for ticker, holding in portfolio.Holdings do
			amount += holding.Shares * priceAt(ticker, payWeek) * Stocks.byTicker[ticker].Yield
		end
		amount = math.floor(amount)
		if amount > 0 then
			table.insert(portfolio.History, 1, { Week = payWeek, Amount = amount })
			total += amount
		end
	end
	while #portfolio.History > Stocks.HISTORY_LENGTH do
		table.remove(portfolio.History)
	end
	portfolio.Paid += total
	return total, week - first + 1
end

-- What a week's payout would be at `prices` (ticker -> price), for the app's estimate.
function Stocks.estimate(portfolio: Portfolio, prices: { [string]: number }): number
	local amount = 0
	for ticker, holding in portfolio.Holdings do
		amount += holding.Shares * (prices[ticker] or 0) * Stocks.byTicker[ticker].Yield
	end
	return math.floor(amount)
end

-- Buys `shares` whole shares. Returns the result code, the new cash and the cost paid.
function Stocks.buy(
	portfolio: Portfolio,
	cash: number,
	ticker: string,
	price: number,
	shares: number
): (string, number, number)
	if not Stocks.byTicker[ticker] then
		return "UnknownStock", cash, 0
	elseif type(shares) ~= "number" or shares % 1 ~= 0 or shares < 1 or shares > Stocks.MAX_ORDER then
		return "InvalidAmount", cash, 0
	end
	local holding = portfolio.Holdings[ticker]
	if (holding and holding.Shares or 0) + shares > Stocks.MAX_SHARES then
		return "TooMany", cash, 0
	end
	local cost = Stocks.buyCost(price, shares)
	if cost > cash then
		return "InsufficientFunds", cash, cost
	end
	if holding then
		holding.Shares += shares
		holding.Cost += cost
	else
		portfolio.Holdings[ticker] = { Shares = shares, Cost = cost }
	end
	return "Bought", cash - cost, cost
end

-- Sells `shares` shares. The cost basis shrinks in proportion. Returns code, new cash, proceeds.
function Stocks.sell(
	portfolio: Portfolio,
	cash: number,
	ticker: string,
	price: number,
	shares: number
): (string, number, number)
	local holding = portfolio.Holdings[ticker]
	if not Stocks.byTicker[ticker] then
		return "UnknownStock", cash, 0
	elseif type(shares) ~= "number" or shares % 1 ~= 0 or shares < 1 then
		return "InvalidAmount", cash, 0
	elseif not holding or holding.Shares < shares then
		return "NotEnoughShares", cash, 0
	end
	local proceeds = Stocks.sellProceeds(price, shares)
	if shares == holding.Shares then
		portfolio.Holdings[ticker] = nil
	else
		holding.Cost -= math.floor(holding.Cost * shares / holding.Shares)
		holding.Shares -= shares
	end
	return "Sold", cash + proceeds, proceeds
end

function Stocks.money(amount: number): string
	local negative = amount < 0
	local whole = math.floor(math.abs(amount) + 0.5)
	local text = tostring(whole):reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if text:sub(1, 1) == "," then
		text = text:sub(2)
	end
	return (if negative then "-$" else "$") .. text
end

function Stocks.price(amount: number): string
	if amount >= 1000 then
		return Stocks.money(amount)
	end
	return string.format("$%.2f", amount)
end

return Stocks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="167">
        <Properties>
          <string name="Name">TrawlerNet</string>
          <string name="Source"><![CDATA[-- Pure catch rules for the trawler's purchased stern net. The net only lands
-- common fish and the occasional uncommon one, so the rarity tiers above
-- Uncommon are filtered out before the roll. Shared by the server (which rolls
-- and awards) and the saved-data tests (which drive it with fixed RNG values).
local FishCatch = if script then require(script.Parent.FishCatch) else require("./FishCatch")

local TrawlerNet = {}

TrawlerNet.MinSpeed = 6 -- studs/s: the hull must be underway for the net to fish
TrawlerNet.MinSeconds = 2.8
TrawlerNet.MaxSeconds = 5.2
TrawlerNet.UncommonChance = 0.2

-- Common and uncommon species in a catch pool, in catalog order.
function TrawlerNet.candidates(pool, species)
	local common, uncommon = {}, {}
	for _, id in pool.Fish or {} do
		local fish = species[id]
		if fish then
			if fish.Rarity == "Common" then
				table.insert(common, id)
			elseif fish.Rarity == "Uncommon" then
				table.insert(uncommon, id)
			end
		end
	end
	return common, uncommon
end

-- One species from the pool: uncommon with UncommonChance, common otherwise.
-- A pool with no common fish still falls back to the uncommon ones.
function TrawlerNet.pickSpecies(pool, species, rng: () -> number): string?
	local common, uncommon = TrawlerNet.candidates(pool, species)
	local bag = if #uncommon > 0 and rng() < TrawlerNet.UncommonChance
		then uncommon
		elseif #common > 0 then common
		else uncommon
	if #bag == 0 then
		return nil
	end
	return bag[math.floor(rng() * #bag) + 1]
end

-- A net catch is an ordinary fish record, but it never enters the hand or the
-- backpack. `rarities` supplies the difficulty tier for a plausible record.
function TrawlerNet.roll(pool, species, rarities, rng: () -> number)
	local id = TrawlerNet.pickSpecies(pool, species, rng)
	if not id then
		return nil
	end
	local fish = species[id]
	local kg, size = FishCatch.rollWeight(fish, rng)
	local relative = kg / fish.AverageKg
	return {
		FishId = id,
		Kg = kg,
		Size = size,
		Value = FishCatch.value(fish, kg, size),
		Relative = relative,
		Difficulty = FishCatch.difficulty(fish, rarities, relative),
	}
end

-- Seconds until the next net catch.
function TrawlerNet.nextInterval(rng: () -> number): number
	return TrawlerNet.MinSeconds + (TrawlerNet.MaxSeconds - TrawlerNet.MinSeconds) * rng()
end

return TrawlerNet
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="168">
        <Properties>
          <string name="Name">Tutorial</string>
          <string name="Source"><![CDATA[-- The island tutorial: a chain of locals round the plaza who each explain one part of the game.
-- Pure data, so the server, the client and the tests read the same table. Spots are plaza-local
-- (x, z) offsets from the fountain, or offsets from a shop's door/counter when Anchor names one;
-- the server tries each spot in order and keeps the first that is clear of props.

local Tutorial = {}

-- $ granted once, the first time an angler finishes the tour.
Tutorial.REWARD = 250
-- How close the server requires a player to stand to the guide they finished talking to.
Tutorial.TALK_RANGE = 18

-- Each guide is dressed for their job in a small Mediterranean harbour town: linen, stripes,
-- straw hats and work aprons, built from parts by the server (GuideCostume), so nothing depends on
-- the Marketplace. Colours are { r, g, b } because this module also loads outside Roblox.
-- Sleeves: "Long", "Short" or "None". Hair: "Short", "Bun", "Ponytail" or "Bald". Shins/Hands
-- default to the trousers/skin; Boots and Gloves colour them. Pieces are GuideCostume kinds.
Tutorial.Npcs = {
	Wren = {
		Name = "Captain Wren",
		Title = "Harbourmaster",
		Outfit = {
			Skin = { 214, 160, 118 },
			Shirt = { 33, 46, 82 }, -- navy reefer jacket
			Sleeves = "Long",
			Trousers = { 33, 46, 82 },
			Shoes = { 28, 26, 26 },
			Hair = { 196, 196, 192 },
			HairStyle = "Short",
			Beard = { 206, 206, 202 },
			Pieces = {
				{ Kind = "ShirtFront", Color = { 244, 242, 234 }, Buttons = { 212, 172, 70 } },
				{ Kind = "Neckerchief", Color = { 24, 24, 30 } },
				{ Kind = "CaptainCap", Color = { 248, 248, 244 }, Band = { 24, 24, 30 }, Badge = { 212, 172, 70 } },
			},
		},
		Where = "by the fountain",
		Spots = { { 0, 26 }, { 9, 26 }, { -9, 26 }, { 0, -26 } },
		Face = { 0, 0 },
	},
	Pike = {
		Name = "Old Pike",
		Title = "Angler",
		Outfit = {
			Skin = { 186, 128, 88 }, -- years of sun
			Shirt = { 232, 222, 196 }, -- faded linen
			Sleeves = "Short",
			Trousers = { 150, 132, 96 },
			Shoes = { 92, 62, 40 },
			Boots = { 74, 64, 52 },
			Hair = { 222, 220, 214 },
			HairStyle = "Short",
			Beard = { 230, 228, 222 },
			Pieces = {
				{ Kind = "Vest", Color = { 104, 112, 74 } }, -- olive fishing vest
				{ Kind = "StrawHat", Color = { 222, 192, 128 }, Band = { 52, 72, 110 } },
			},
		},
		Where = "on the promenade by the bay",
		Spots = { { 17, 46 }, { 26, 45 }, { 17, 40 } },
		Face = { 17, 0 },
	},
	Juno = {
		Name = "Juno",
		Title = "Pack Trader",
		Outfit = {
			Skin = { 160, 108, 74 },
			Shirt = { 186, 92, 58 }, -- terracotta linen
			Sleeves = "Long",
			Trousers = { 214, 196, 160 },
			Shoes = { 120, 78, 44 }, -- leather sandals
			Hair = { 40, 28, 22 },
			HairStyle = "Short", -- tucked under the scarf
			Pieces = {
				{ Kind = "Headscarf", Color = { 226, 168, 52 } },
				{ Kind = "Belt", Color = { 96, 62, 36 } },
				{ Kind = "Satchel", Color = { 132, 84, 46 } },
			},
		},
		Where = "beside the backpack stall",
		-- Counter space: +z is the customers' side of the counter
		Anchor = "BackpackCounter",
		Spots = { { -7, 3 }, { 7, 3 }, { -7, 6 } },
		Fallback = { { 36, -26 } },
		Face = { 0, 12 },
	},
	Marlo = {
		Name = "Marlo",
		Title = "Fishmonger",
		Outfit = {
			Skin = { 222, 170, 128 },
			Shirt = { 246, 244, 236 }, -- Breton marinière
			Sleeves = "Short",
			Trousers = { 44, 50, 62 },
			Shoes = { 30, 30, 30 },
			Boots = { 236, 236, 230 }, -- white market wellies
			Hair = { 58, 40, 30 },
			HairStyle = "Short",
			Pieces = {
				{ Kind = "Stripes", Color = { 30, 52, 112 } },
				{ Kind = "Apron", Color = { 70, 120, 140 } }, -- rubberised fish apron
				{ Kind = "FlatCap", Color = { 72, 66, 58 } },
			},
		},
		Where = "at the market stalls",
		Spots = { { 36, 0 }, { 36, 12 }, { 34, -12 } },
		Face = { 0, 0 },
	},
	Rosa = {
		Name = "Rosa",
		Title = "Tackle Hand",
		Outfit = {
			Skin = { 204, 148, 104 },
			Shirt = { 128, 146, 106 }, -- sage work shirt
			Sleeves = "Short",
			Trousers = { 196, 182, 150 },
			Shoes = { 238, 236, 228 }, -- canvas deck shoes
			Hair = { 86, 46, 28 },
			HairStyle = "Ponytail",
			Pieces = {
				{ Kind = "Apron", Color = { 62, 86, 128 }, Pockets = true }, -- denim tackle apron
				{ Kind = "Neckerchief", Color = { 196, 52, 44 } },
			},
		},
		Where = "outside Tide & Tackle",
		-- Door space: -z faces out of the door, +x is away from the chalkboard
		Anchor = "RodShopDoor",
		Spots = { { -4.5, -1 }, { -4.5, -3 }, { 4.5, -4 } },
		Fallback = { { -34, 30 } },
		Face = { 0, -12 },
	},
	Tess = {
		Name = "Tess",
		Title = "Dockhand",
		Outfit = {
			Skin = { 176, 120, 82 },
			Shirt = { 240, 238, 230 }, -- white vest top
			Sleeves = "None",
			Trousers = { 46, 72, 112 }, -- work dungarees
			Shoes = { 30, 30, 30 },
			Boots = { 226, 176, 40 }, -- yellow deck boots
			Gloves = { 138, 96, 58 },
			Hair = { 46, 30, 22 },
			HairStyle = "Ponytail",
			Pieces = {
				{ Kind = "Dungarees", Color = { 46, 72, 112 } },
				{ Kind = "Bandana", Color = { 196, 52, 44 } },
				{ Kind = "Rope", Color = { 196, 168, 116 } },
			},
		},
		Where = "on the promenade in front of the Drydock",
		Spots = { { -5, 47 }, { -16, 46 }, { 5, 44 } },
		Face = { -5, 0 },
	},
	Hugo = {
		Name = "Hugo",
		Title = "Decorator",
		Outfit = {
			Skin = { 226, 176, 136 },
			Shirt = { 168, 196, 220 }, -- pale blue linen
			Sleeves = "Short",
			Trousers = { 226, 214, 186 }, -- cream chinos
			Shoes = { 152, 98, 56 }, -- tan loafers
			Hair = { 64, 44, 32 },
			HairStyle = "Short",
			Pieces = {
				{ Kind = "Neckerchief", Color = { 214, 160, 48 } },
				{ Kind = "Belt", Color = { 120, 76, 44 } },
				{ Kind = "Panama", Color = { 238, 228, 202 }, Band = { 40, 40, 44 } },
				{ Kind = "Pencil", Color = { 236, 196, 52 } },
			},
		},
		Where = "outside Harbour Home",
		Anchor = "FurnitureShopDoor",
		Spots = { { -4.5, -1 }, { 4.5, -1 }, { -4.5, -3 } },
		Fallback = { { 34, 32 } },
		Face = { 0, -12 },
	},
}

Tutorial.Order = { "Wren", "Pike", "Juno", "Marlo", "Rosa", "Tess", "Hugo" }

-- One step per conversation, in order. Lines are pages of one dialogue; Goal is the tracker text.
Tutorial.Steps = {
	{
		Npc = "Wren",
		Goal = "Talk to Captain Wren by the plaza fountain",
		Lines = {
			"Ahoy, and welcome to the harbour! I'm Captain Wren. One of the docks along the shore is yours while you're here - your own shop and jetty included.",
			"The trade is simple: catch fish, sell them from your shop, and grow that little stall into a real business.",
			"My friends around the island each know one part of the job. Follow the yellow arrow and have a chat with each of them.",
			"First up is Old Pike on the promenade by the bay. Nobody on this island knows fishing better.",
		},
	},
	{
		Npc = "Pike",
		Goal = "Learn to fish from Old Pike on the promenade",
		Lines = {
			"So you want to fish? Stand at the water's edge - your own jetty is perfect - and get your rod out.",
			"Hold click to charge your cast and let go to throw. On a phone, hold the screen. The longer you hold, the further it flies.",
			"When a fish bites, click to start reeling. Then pull - press F or the Pull button - whenever the needle sits in the green. Pull in the red and the line goes slack.",
			"Deeper, stranger waters hold rarer fish, and storms bring out odd mutations. Juno at the backpack stall can tell you where your catch goes.",
		},
	},
	{
		Npc = "Juno",
		Goal = "Ask Juno about your catch at the backpack stall",
		Lines = {
			"Hi! Every fish you land goes into your backpack, and every backpack has a set number of tiles.",
			"Press C to open your hold. Click a fish to pick it up, press R to turn it, and click a free spot to pack it in. Big fish take more room!",
			"When your pack is full, bigger backpacks from my stall hold far more. Have a look whenever you've saved some coins.",
			"Full backpack? Then it's time to sell. Marlo at the market stalls will show you how.",
		},
	},
	{
		Npc = "Marlo",
		Goal = "Learn how to sell fish from Marlo at the market",
		Lines = {
			"Coins come from your own shop, back at your dock. Walk up to your freezer and use Place fish to put your catch on ice.",
			"Customers wander in and pick fish from the freezer. Walk over and use Sell to take their money.",
			"Later you can hire a seller to serve customers for you, and a porter to carry fish from your boat. Open the menu, go to Home and look under Workers.",
			"Your gear matters too. Rosa outside Tide & Tackle knows all about rods.",
		},
	},
	{
		Npc = "Rosa",
		Goal = "Visit Rosa outside Tide & Tackle",
		Lines = {
			"Welcome to Tide & Tackle! Inside, Finn at the counter upgrades your rod so it casts further and hooks bigger fish.",
			"There are rod crates in there too. Open one for a chance at a rare rod skin.",
			"Crab cages and mussel nets go out on the water and catch by themselves. Come back later and pull them up.",
			"And if you head out to deep water, take a shark spear. For boats, though, you'll want Tess by the Drydock.",
		},
	},
	{
		Npc = "Tess",
		Goal = "Ask Tess about boats in front of the Drydock",
		Lines = {
			"Boats take you to the far islands, where the rare fish live. Your free rowboat waits at your own dock - use Choose boat there to launch it.",
			"Mara inside the Drydock sells faster, bigger boats. A boat has its own cargo hold, so you can keep fishing long after your backpack is full.",
			"Hit rocks and your hull takes damage. Sail into the Drydock and use Lift & refit to repair it, or to upgrade and repaint it.",
			"Keep an eye on the weather radar before a long trip. Once you're earning, see Hugo outside Harbour Home about making your shop look the part.",
		},
	},
	{
		Npc = "Hugo",
		Goal = "Meet Hugo outside Harbour Home",
		Lines = {
			"Harbour Home sells furniture for your shop: freezers, shelves, tables and more. Some furniture even lets you store more fish.",
			"At your own shop, press B for build mode. Pick an item, move it with WASD or the mouse, turn it with R and click to place it.",
			"A busy, good-looking shop brings in more customers. Now go and tell Captain Wren how you got on!",
		},
	},
	{
		Npc = "Wren",
		Goal = "Report back to Captain Wren at the fountain",
		Lines = {
			"Back already? Then you know the ropes: fish, pack your catch, sell it at your shop, and spend the coins on better gear.",
			"Open the menu, go to Home and look at Paths. Finish a stage's goals and your fish shop grows into a supermarket, and later a restaurant or a fishing company.",
			"Press M for the map whenever you're lost. My friends stay where they are, so come back for a chat any time.",
			"First time round? Then here's a little something to get you started. And if you ever want the tour again, just type /tutorial in chat. Fair winds!",
		},
	},
}

function Tutorial.step(index: number)
	return Tutorial.Steps[index]
end

-- What a guide says when the player talks to them: the current step's lines when it is their turn,
-- otherwise their own last lesson (so they repeat their advice once the tour has moved on).
function Tutorial.dialogue(npcId: string, stepIndex: number?, done: boolean?): ({ string }, boolean)
	local current = stepIndex and not done and Tutorial.Steps[stepIndex]
	if current and current.Npc == npcId then
		return current.Lines, true
	end
	local fallback
	for index, step in Tutorial.Steps do
		if step.Npc == npcId then
			-- A guide who appears twice keeps their welcome until the tour reaches their later step.
			if fallback == nil or done or (stepIndex ~= nil and index <= stepIndex) then
				fallback = step.Lines
			end
		end
	end
	return fallback or {}, false
end

-- The step a "finished talking" request moves to, or nil if it is not that guide's turn.
function Tutorial.advance(stepIndex: number, done: boolean, npcId: string): (number?, boolean)
	local current = not done and Tutorial.Steps[stepIndex]
	if not current or current.Npc ~= npcId then
		return nil, done
	end
	if stepIndex >= #Tutorial.Steps then
		return stepIndex, true
	end
	return stepIndex + 1, false
end

return Tutorial
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="169">
        <Properties>
          <string name="Name">Weather</string>
          <string name="Source"><![CDATA[-- One server clock drives weather, visible swells and boat buoyancy on every client.
local Weather = {}

export type State = {
	kind: string,
	rain: number,
	storm: number,
	fog: number,
	cloudCover: number,
	windSpeed: number,
	windDirection: Vector3,
	waveAmplitude: number,
	rainPotential: number,
	stormPotential: number,
	cloudPotential: number,
	windPotential: number,
	uniform: boolean,
	systems: { any },
	supercell: Supercell?,
}

-- One rotating storm cell. Positions are on the water plane (Y = 0).
export type Supercell = { position: Vector3, motion: Vector3, strength: number, forced: boolean }
export type Tornado = { id: number, position: Vector3, radius: number, strength: number, age: number, duration: number }

Weather.Presets = {
	Clear = { rain = 0, storm = 0, fog = 0, cloudCover = 0, windSpeed = 6 },
	-- Calm marine fog: no precipitation, with a low stratus deck above the mist.
	Foggy = { rain = 0, storm = 0, fog = 1, cloudCover = 0.9, windSpeed = 4 },
	LightRain = { rain = 0.24, storm = 0, fog = 0, cloudCover = 0.5, windSpeed = 18 },
	Rain = { rain = 0.62, storm = 0, fog = 0, cloudCover = 0.8, windSpeed = 32 },
	Storm = { rain = 1, storm = 1, fog = 0, cloudCover = 1, windSpeed = 52 },
	-- The gloomy weather around a forced supercell; the cell itself (Weather.supercell)
	-- brings the extreme wind and tornadoes. Natural supercells are rare forecast events.
	Supercell = { rain = 0.5, storm = 0.35, fog = 0, cloudCover = 0.95, windSpeed = 34 },
	-- Admin-only event: deliberately absent from the automatic forecast.
	BlackHole = { rain = 0.28, storm = 0, fog = 0, cloudCover = 1, windSpeed = 26 },
}

-- A full front passes over the islands, with a twenty-second blend at each change.
Weather.Schedule = {
	{ kind = "Clear", duration = 150 },
	{ kind = "LightRain", duration = 150 },
	{ kind = "Rain", duration = 180 },
	{ kind = "Storm", duration = 150 },
	{ kind = "Rain", duration = 120 },
	{ kind = "LightRain", duration = 120 },
	{ kind = "Foggy", duration = 180 },
	{ kind = "Clear", duration = 150 },
}
Weather.TransitionSeconds = 20
-- Exposed storm cores have up to nine studs of crest-to-trough swell.
-- The lake shelter and boat dry-floor clearance keep harbour travel manageable.
Weather.MaxWaveAmplitude = 4.5
Weather.RadarHalfSize = 5200
Weather.BlackHoleRadius = 250
Weather.RadarResolution = 29
Weather.CycleSeconds = 0
for _, stage in Weather.Schedule do
	Weather.CycleSeconds += stage.duration
end

-- About one forecast cycle in six grows a supercell, alive from the stage before
-- the storm to the stage after it. Within SupercellThreshold of its local cover
-- you are "under" it: windy catches and the Supercell weather kind.
Weather.SupercellChance = 1 / 6
Weather.SupercellRadius = 950
Weather.SupercellCoreRadius = 420
Weather.SupercellThreshold = 0.38
Weather.SupercellSpeed = 9
Weather.ForcedSupercellOrbit = 380
Weather.ForcedSupercellPeriod = 900
-- Each interval may drop one tornado from the cell's rear flank. Boats inside
-- TornadoReach funnel radii are thrown.
Weather.TornadoInterval = 45
Weather.TornadoChance = 0.55
Weather.ForcedTornadoChance = 0.85
Weather.TornadoReach = 2.4
local cycleTime = 0
for index, stage in Weather.Schedule do
	if stage.kind == "Storm" then
		Weather.SupercellWindow = {
			cycleTime - Weather.Schedule[index - 1].duration,
			cycleTime + stage.duration + Weather.Schedule[index + 1].duration,
		}
		break
	end
	cycleTime += stage.duration
end

local TAU = math.pi * 2
local function smoothstep(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

-- Integer-only mixing: the server and every client must agree exactly on whether
-- a supercell or tornado exists, which math.sin-based hashes can't promise.
local function hash(a: number, b: number, c: number): number
	local h = 2166136
	for _, value in { a, b, c } do
		h = (h * 31 + math.floor(value) % 1000003) % 2147483647
		h = (h * 48271) % 2147483647
	end
	return h / 2147483647
end

-- Harbour.BAY, SCALE and SKETCH_CENTER define the real lake/bay, rather than a
-- circle that would also shelter the sea on the other side of the island.
-- scripts/check-weather.mjs guards these coordinates against map changes.
Weather.BaySketch = {
	{ 350, 1555 },
	{ 450, 1553 },
	{ 550, 1565 },
	{ 650, 1598 },
	{ 760, 1640 },
	{ 850, 1640 },
	{ 950, 1620 },
	{ 1030, 1630 },
	{ 1100, 1668 },
	{ 1170, 1690 },
	{ 1240, 1660 },
	{ 1305, 1585 },
	{ 1345, 1480 },
	{ 1362, 1360 },
	{ 1348, 1262 },
	{ 1290, 1182 },
	{ 1200, 1122 },
	{ 1105, 1090 },
	{ 1045, 1050 },
	{ 1012, 980 },
	{ 985, 902 },
	{ 940, 852 },
	{ 870, 818 },
	{ 760, 820 },
	{ 685, 850 },
	{ 652, 905 },
	{ 663, 1000 },
	{ 680, 1118 },
	{ 660, 1190 },
	{ 600, 1255 },
	{ 520, 1300 },
}
Weather.MouthSketch = { { 290, 1565 }, { 430, 1340 } }
local function sketchPoint(p: { number }): Vector3
	return Vector3.new((p[1] - 870) * 0.85, 0, (p[2] - 1330) * 0.85)
end
local bay = { sketchPoint(Weather.MouthSketch[1]) }
for _, p in Weather.BaySketch do
	table.insert(bay, sketchPoint(p))
end
table.insert(bay, sketchPoint(Weather.MouthSketch[2]))

-- True inside the main island's lake/bay outline, mouth included.
function Weather.inLake(position: Vector3): boolean
	-- Main island is centered on Biomes.Normal.center (0, 0).
	if position.X < -620 or position.X > 530 or position.Z < -560 or position.Z > 400 then
		return false
	end
	local inside = false
	local j = #bay
	for i, a in bay do
		local b = bay[j]
		if
			(a.Z > position.Z) ~= (b.Z > position.Z)
			and position.X < (b.X - a.X) * (position.Z - a.Z) / (b.Z - a.Z) + a.X
		then
			inside = not inside
		end
		j = i
	end
	return inside
end

function Weather.lakeExposure(position: Vector3): number
	-- Keep the field continuous just outside the bay too. A ribbon spans several
	-- samples: a hard polygon cutoff made its ends and normals jump at headlands.
	if position.X < -660 or position.X > 570 or position.Z < -600 or position.Z > 440 then
		return 1
	end
	-- Blend through the western mouth; the inner lake only receives short ripples.
	local mouthA, mouthB = bay[1], bay[#bay]
	local mouth = mouthB - mouthA
	local relative = Vector3.new(position.X, 0, position.Z) - mouthA
	local nearest = mouthA + mouth * math.clamp(relative:Dot(mouth) / mouth:Dot(mouth), 0, 1)
	local distance = (Vector3.new(position.X, 0, position.Z) - nearest).Magnitude
	local shelter = 0.82 * smoothstep(distance / 220)
	if not Weather.inLake(position) then
		local boundaryDistanceSquared = math.huge
		local previous = bay[#bay]
		for _, current in bay do
			local dx, dz = current.X - previous.X, current.Z - previous.Z
			local x, z = position.X - previous.X, position.Z - previous.Z
			local t = math.clamp((x * dx + z * dz) / (dx * dx + dz * dz), 0, 1)
			x, z = x - dx * t, z - dz * t
			boundaryDistanceSquared = math.min(boundaryDistanceSquared, x * x + z * z)
			previous = current
		end
		shelter *= 1 - smoothstep(math.sqrt(boundaryDistanceSquared) / 40)
	end
	return 1 - shelter
end

-- Broad rain bands contain compact storm cores. Their paths never wrap across
-- the map: slow orbital drift and growth let fronts arrive and fade smoothly.
function Weather.getSystems(time: number)
	local seed = workspace:GetAttribute("WeatherSeed") or 1847
	local epoch = workspace:GetAttribute("WeatherEpoch") or time
	local elapsed = time - epoch
	local systems = {}
	for index = 1, 5 do
		local phase = seed * 0.017 + index * 2.39996
		local age = elapsed * (0.00065 + index * 0.00008)
		local angle = phase * 0.31
		table.insert(systems, {
			x = math.sin(phase + age) * 3900,
			z = math.cos(phase * 1.3 + age * 0.83) * 3900,
			cosine = math.cos(angle),
			sine = math.sin(angle),
			radiusX = if index == 1 then 4200 else 1200 + index * 180,
			radiusZ = if index == 1 then 850 else 950 + index * 100,
			strength = 0.72 + 0.28 * math.sin(phase + age * 1.7) ^ 2,
		})
	end
	return systems
end

local function validPoint(position: any): boolean
	return typeof(position) == "Vector3"
		and position.X == position.X
		and position.Y == position.Y
		and position.Z == position.Z
		and math.abs(position.X) <= Weather.RadarHalfSize
		and math.abs(position.Z) <= Weather.RadarHalfSize
		and math.abs(position.Y) <= 10000
end

-- Supercells move slightly right of the steering wind, like real right-movers.
-- A forced (admin) cell instead circles the spot it was summoned at, so it stays
-- in view. Any other override clears the sky of natural cells.
function Weather.supercell(serverTime: number?): Supercell?
	local time = serverTime or workspace:GetServerTimeNow()
	local override = workspace:GetAttribute("WeatherOverride")
	if override == "Supercell" then
		local anchor = workspace:GetAttribute("SupercellPosition")
		if not validPoint(anchor) then
			anchor = Vector3.new(0, 0, 0)
		end
		local since = workspace:GetAttribute("SupercellSince")
		if type(since) ~= "number" or since ~= since then
			since = workspace:GetAttribute("WeatherEpoch") or time
		end
		local age = math.max(0, time - since)
		local turn = age * TAU / Weather.ForcedSupercellPeriod
		local orbit = Weather.ForcedSupercellOrbit
		local speed = orbit * TAU / Weather.ForcedSupercellPeriod
		return {
			position = Vector3.new(anchor.X + math.cos(turn) * orbit, 0, anchor.Z + math.sin(turn) * orbit),
			motion = Vector3.new(-math.sin(turn) * speed, 0, math.cos(turn) * speed),
			strength = smoothstep(age / 20),
			forced = true,
		}
	elseif type(override) == "string" and Weather.Presets[override] then
		return nil
	end
	local seed = workspace:GetAttribute("WeatherSeed") or 1847
	local epoch = workspace:GetAttribute("WeatherEpoch") or time
	local elapsed = math.max(0, time - epoch)
	local cycle = math.floor(elapsed / Weather.CycleSeconds)
	local t = elapsed - cycle * Weather.CycleSeconds
	local window = Weather.SupercellWindow
	if t <= window[1] or t >= window[2] or hash(seed, cycle, 1) >= Weather.SupercellChance then
		return nil
	end
	-- Each cell's track crosses a random point within reach of the islands.
	local target = Vector3.new((hash(seed, cycle, 2) * 2 - 1) * 1800, 0, (hash(seed, cycle, 3) * 2 - 1) * 1800)
	local angle = (seed % 360) * math.pi / 180 + 0.35
	local motion = Vector3.new(math.cos(angle), 0, math.sin(angle)) * Weather.SupercellSpeed
	local ramp = 60
	return {
		position = target + motion * (t - (window[1] + window[2]) / 2),
		motion = motion,
		strength = smoothstep((t - window[1]) / ramp) * smoothstep((window[2] - t) / ramp),
		forced = false,
	}
end

-- How strongly the cell covers a point, from 0 to its strength.
function Weather.supercellCover(position: Vector3, cell: Supercell?): number
	if not cell then
		return 0
	end
	local dx, dz = position.X - cell.position.X, position.Z - cell.position.Z
	return math.exp(-(dx * dx + dz * dz) / Weather.SupercellRadius ^ 2 * 2.2) * cell.strength
end

-- Tornadoes touch down behind and right of the cell's motion (its rear-flank
-- downdraft) and travel with it, wandering a little. Fully deterministic, so the
-- server flings boats exactly where every client draws a funnel.
function Weather.tornadoes(serverTime: number?): { Tornado }
	local time = serverTime or workspace:GetServerTimeNow()
	local list = {}
	local cell = Weather.supercell(time)
	if not cell then
		return list
	end
	local seed = workspace:GetAttribute("WeatherSeed") or 1847
	local bucket = math.floor(time / Weather.TornadoInterval)
	-- A tornado starts within ten seconds of its interval and lasts under 40, so
	-- only this interval's and the previous one's can be on the ground.
	for id = bucket - 1, bucket do
		local start = id * Weather.TornadoInterval + hash(seed, id, 8) * 10
		local duration = 24 + hash(seed, id, 9) * 14
		local age = time - start
		if age < 0 or age > duration then
			continue
		end
		local birth = Weather.supercell(start)
		local chance = if birth and birth.forced then Weather.ForcedTornadoChance else Weather.TornadoChance
		if not birth or birth.strength < 0.7 or cell.strength < 0.3 or hash(seed, id, 7) >= chance then
			continue
		end
		local speed = math.sqrt(cell.motion.X ^ 2 + cell.motion.Z ^ 2)
		local fx, fz = if speed > 0 then cell.motion.X / speed else 1, if speed > 0 then cell.motion.Z / speed else 0
		local wander = hash(seed, id, 10) * TAU + age * 0.22
		local core = Weather.SupercellCoreRadius
		table.insert(list, {
			id = id,
			position = Vector3.new(
				cell.position.X + (-fx * 0.35 - fz * 0.3) * core + math.cos(wander) * 60,
				0,
				cell.position.Z + (-fz * 0.35 + fx * 0.3) * core + math.sin(wander) * 60
			),
			radius = 22 + hash(seed, id, 11) * 20,
			strength = smoothstep(age / 6) * smoothstep((duration - age) / 6) * math.min(1, cell.strength / 0.7),
			age = age,
			duration = duration,
		})
	end
	return list
end

local function localConditions(position: Vector3, state: State): (number, number, number, number)
	local coverage, core = 0, 0
	for _, system in state.systems do
		local dx, dz = position.X - system.x, position.Z - system.z
		local u = (dx * system.cosine + dz * system.sine) / system.radiusX
		local v = (-dx * system.sine + dz * system.cosine) / system.radiusZ
		local distance = u * u + v * v
		coverage = math.max(coverage, math.exp(-distance * 1.2) * system.strength)
		core = math.max(core, math.exp(-distance * 4.5) * system.strength)
	end
	local rain = state.rainPotential * smoothstep(coverage / 0.85)
	local storm = math.max(state.stormPotential, state.rainPotential * 0.75) * smoothstep(core / 0.85)
	local cloud = math.clamp(state.cloudPotential * (0.2 + coverage * 0.8), 0, 1)
	local wind = 6 + (state.windPotential - 6) * (0.16 + coverage * 0.5 + core * 0.34)
	-- An explicit preset must reach the player, wave samples and radar alike.
	-- Only the automatic forecast is weakened by gaps between regional fronts.
	if state.uniform then
		rain, storm, cloud, wind = state.rainPotential, state.stormPotential, state.cloudPotential, state.windPotential
	end
	local cell = Weather.supercellCover(position, state.supercell)
	if cell > 0 then
		rain = math.max(rain, cell * 0.95)
		storm = math.max(storm, math.min(1, cell * 1.3))
		cloud = math.max(cloud, math.min(1, cell * 1.6))
		wind = math.max(wind, 6 + 58 * cell)
	end
	-- Falling rain needs a continuous cloud deck, including light rain at night.
	cloud = math.max(cloud, smoothstep(rain / 0.08))
	return rain, storm, cloud, wind
end
Weather.localConditions = localConditions

local function waveAmplitude(wind: number): number
	return 0.3 + (Weather.MaxWaveAmplitude - 0.3) * math.clamp(wind / 52, 0, 1) ^ 1.65
end

-- Only the authenticated dashboard bridge supplies an event center. A bare
-- weather override cannot activate an event or grant event mutations.
function Weather.blackHolePosition(): Vector3?
	if workspace:GetAttribute("WeatherOverride") ~= "BlackHole" then
		return nil
	end
	local position = workspace:GetAttribute("BlackHolePosition")
	if not validPoint(position) then
		return nil
	end
	return position
end

-- Catches use their server-validated fishing position, never the player's
-- camera or a client-reported mutation flag. Distance is across the surface.
-- Under a supercell, FishMutations.roll decides whether the catch turns windy.
function Weather.mutationContext(position: Vector3, serverTime: number?)
	local center = Weather.blackHolePosition()
	if not center then
		if Weather.supercellCover(position, Weather.supercell(serverTime)) >= Weather.SupercellThreshold then
			return { windy = true }
		end
		return nil
	end
	local dx, dz = position.X - center.X, position.Z - center.Z
	return { corrupted = true, voidTouched = dx * dx + dz * dz <= Weather.BlackHoleRadius ^ 2 }
end

function Weather.getState(serverTime: number?, position: Vector3?): State
	local time = serverTime or workspace:GetServerTimeNow()
	local epoch = workspace:GetAttribute("WeatherEpoch") or time
	local seed = workspace:GetAttribute("WeatherSeed") or 1847
	local elapsed = math.max(0, time - epoch) % Weather.CycleSeconds
	local index = 1
	while elapsed >= Weather.Schedule[index].duration and index < #Weather.Schedule do
		elapsed -= Weather.Schedule[index].duration
		index += 1
	end
	local stage = Weather.Schedule[index]
	local previous = Weather.Schedule[if index == 1 then #Weather.Schedule else index - 1]
	local target, from = Weather.Presets[stage.kind], Weather.Presets[previous.kind]
	local blend = smoothstep(elapsed / Weather.TransitionSeconds)
	-- Server-only attribute is also useful for Studio weather previews.
	local override = workspace:GetAttribute("WeatherOverride")
	if override == "BlackHole" and not Weather.blackHolePosition() then
		override = nil
	end
	if type(override) == "string" and Weather.Presets[override] then
		target, from, blend = Weather.Presets[override], Weather.Presets[override], 1
	end
	local function mix(key: string): number
		return from[key] + (target[key] - from[key]) * blend
	end
	local gust = 0.94 + 0.06 * math.sin(time * 0.47 + seed)
	local wind = mix("windSpeed") * gust
	local angle = (seed % 360) * math.pi / 180
	local supercell = Weather.supercell(time)
	local state = {
		kind = if type(override) == "string" and Weather.Presets[override] then override else stage.kind,
		rain = mix("rain"),
		storm = mix("storm"),
		fog = mix("fog"),
		cloudCover = mix("cloudCover"),
		windSpeed = wind,
		windDirection = Vector3.new(math.cos(angle), 0, math.sin(angle)),
		-- Even a calm sea keeps a gentle, visible swell under idle hulls.
		waveAmplitude = waveAmplitude(wind),
		rainPotential = mix("rain"),
		stormPotential = mix("storm"),
		cloudPotential = mix("cloudCover"),
		windPotential = wind,
		uniform = type(override) == "string" and Weather.Presets[override] ~= nil,
		systems = Weather.getSystems(time),
		supercell = supercell,
	}
	if position then
		state.rain, state.storm, state.cloudCover, state.windSpeed = localConditions(position, state)
		state.waveAmplitude = waveAmplitude(state.windSpeed) * Weather.lakeExposure(position) ^ 2
		state.kind = if state.uniform
			then override
			elseif Weather.supercellCover(position, supercell) >= Weather.SupercellThreshold then "Supercell"
			elseif state.storm > 0.38 then "Storm"
			elseif state.rain > 0.4 then "Rain"
			elseif state.rain > 0.06 then "LightRain"
			elseif state.fog > 0.35 then "Foggy"
			else "Clear"
	end
	return state
end

-- Fixed frequencies preserve phase when the wind strength changes. Three crossing
-- swells avoid identical, mechanical bobbing for every boat. Weights sum to one.
Weather.components = {
	{ weight = 0.62, wavelength = 110, speed = 12, angle = 0, phase = 0 },
	{ weight = 0.26, wavelength = 65, speed = 8, angle = 0.5, phase = 1.8 },
	{ weight = 0.12, wavelength = 34, speed = 5, angle = -0.7, phase = 4.1 },
}

-- The unit swell (weights sum to one) and its exact slope along X and Z.
local function swell(x: number, z: number, time: number, direction: Vector3): (number, number, number)
	local height, dx, dz = 0, 0, 0
	for _, wave in Weather.components do
		local cosine, sine = math.cos(wave.angle), math.sin(wave.angle)
		local wx = direction.X * cosine - direction.Z * sine
		local wz = direction.X * sine + direction.Z * cosine
		local k = TAU / wave.wavelength
		local phase = k * (x * wx + z * wz - time * wave.speed) + wave.phase
		height += math.sin(phase) * wave.weight
		local slope = math.cos(phase) * wave.weight * k
		dx += slope * wx
		dz += slope * wz
	end
	return height, dx, dz
end
-- The client swell mesh caches each vertex's amplitude and evaluates only this.
Weather.swell = swell

-- Swell height where the regional wind already gave `base` (the open-sea amplitude).
-- The wind field changes over kilometres, so nearby points of one hull or crest share it.
local function shelteredHeight(position: Vector3, time: number, state: State, base: number): number
	return swell(position.X, position.Z, time, state.windDirection) * base * Weather.lakeExposure(position) ^ 2
end

local function heightAt(position: Vector3, time: number, state: State): (number, number)
	local _, _, _, wind = localConditions(position, state)
	local amplitude = waveAmplitude(wind) * Weather.lakeExposure(position) ^ 2
	return swell(position.X, position.Z, time, state.windDirection) * amplitude, amplitude
end

-- Height is an offset from Biomes.WaterLevel. The normal combines the exact swell
-- slope with the smooth shelter gradient at the mouth of the lake. One weather
-- lookup per sample: a finite difference cost five, and every boat and crest
-- samples each frame.
function Weather.sample(position: Vector3, time: number, state: State?)
	local current = state or Weather.getState(time)
	local _, _, _, wind = localConditions(position, current)
	local base = waveAmplitude(wind)
	local exposure = Weather.lakeExposure(position) ^ 2
	local amplitude = base * exposure
	local unit, sx, sz = swell(position.X, position.Z, time, current.windDirection)
	local ex = (
		Weather.lakeExposure(position + Vector3.new(1, 0, 0)) ^ 2
		- Weather.lakeExposure(position - Vector3.new(1, 0, 0)) ^ 2
	) / 2
	local ez = (
		Weather.lakeExposure(position + Vector3.new(0, 0, 1)) ^ 2
		- Weather.lakeExposure(position - Vector3.new(0, 0, 1)) ^ 2
	) / 2
	local dx = amplitude * sx + unit * base * ex
	local dz = amplitude * sz + unit * base * ez
	return {
		height = unit * amplitude,
		amplitude = amplitude,
		normal = Vector3.new(-dx, 1, -dz).Unit,
		pitch = math.atan(dz),
		roll = -math.atan(dx),
	}
end

-- The surface a hull of the given half extents rests on: the plane through its
-- bow, stern and both beams, at their mean height with the center. A point
-- sample made long hulls pitch through every short crest and bury their bows;
-- averaging across the hull lets it ride the swells longer than itself and skim
-- the shorter chop. `forward` is the horizontal heading. A `floor` offset holds
-- each point at or above it: Terrain's flat water covers the swell's troughs,
-- so a hull resting on the visible surface sits level there instead of pitching.
function Weather.hullSample(
	position: Vector3,
	forward: Vector3,
	halfLength: number,
	halfBeam: number,
	time: number,
	state: State?,
	floor: number?
)
	local current = state or Weather.getState(time)
	local _, _, _, wind = localConditions(position, current)
	local base = waveAmplitude(wind)
	local lowest = floor or -math.huge
	local function pointHeight(point: Vector3): number
		return math.max(lowest, shelteredHeight(point, time, current, base))
	end
	forward = Vector3.new(forward.X, 0, forward.Z)
	forward = if forward.Magnitude > 1e-6 then forward.Unit else Vector3.new(0, 0, 1)
	local right = Vector3.new(-forward.Z, 0, forward.X)
	local center = pointHeight(position)
	local bow = pointHeight(position + forward * halfLength)
	local stern = pointHeight(position - forward * halfLength)
	local starboard = pointHeight(position + right * halfBeam)
	local port = pointHeight(position - right * halfBeam)
	local alongSlope = (bow - stern) / (2 * halfLength)
	local acrossSlope = (starboard - port) / (2 * halfBeam)
	return {
		height = (center * 2 + bow + stern + starboard + port) / 6,
		amplitude = base * Weather.lakeExposure(position) ^ 2,
		normal = (Vector3.new(0, 1, 0) - forward * alongSlope - right * acrossSlope).Unit,
	}
end

-- Cheap height-only variant for the many points in a visible crest.
Weather.heightAt = heightAt

-- A compact measured grid, row-major from northwest to southeast. The admin
-- radar displays these samples instead of inventing its own weather shapes.
function Weather.radar(time: number)
	local state = Weather.getState(time)
	local cells = {}
	local peakRain, peakStorm, peakWind, peakWave = 0, 0, 0, 0
	local function rounded(value: number): number
		return math.round(value * 100) / 100
	end
	for row = 0, Weather.RadarResolution - 1 do
		for column = 0, Weather.RadarResolution - 1 do
			local position = Vector3.new(
				-Weather.RadarHalfSize + column * Weather.RadarHalfSize * 2 / (Weather.RadarResolution - 1),
				0,
				-Weather.RadarHalfSize + row * Weather.RadarHalfSize * 2 / (Weather.RadarResolution - 1)
			)
			local rain, storm, _, wind = localConditions(position, state)
			local amplitude = waveAmplitude(wind) * Weather.lakeExposure(position) ^ 2
			table.insert(cells, { rounded(rain), rounded(storm), rounded(wind), rounded(amplitude) })
			peakRain, peakStorm = math.max(peakRain, rain), math.max(peakStorm, storm)
			peakWind, peakWave = math.max(peakWind, wind), math.max(peakWave, amplitude)
		end
	end
	return {
		version = 1,
		resolution = Weather.RadarResolution,
		halfSize = Weather.RadarHalfSize,
		cells = cells,
		peakRain = rounded(peakRain),
		peakStorm = rounded(peakStorm),
		peakWind = rounded(peakWind),
		peakWave = rounded(peakWave),
	}
end

-- Parked hulls stay anchored on the server. This world-space transform carries a
-- hull from the pose it parked in (at parkedAt) to the same swell's pose now, so
-- every client bobs it identically and the server can release it without a snap.
function Weather.parkedOffset(
	rest: CFrame,
	parkedAt: number,
	now: number,
	floorHeight: number?,
	halfBeam: number?,
	halfLength: number?,
	waterlineOffset: Vector3?
): CFrame
	local from = Weather.sample(rest.Position, parkedAt)
	local to = Weather.sample(rest.Position, now)
	-- Match the driven hull's dry-floor clamp even while it is anchored.
	local function dryHeight(sample): number
		if not floorHeight or not halfBeam or not halfLength then
			return sample.height
		end
		local normal = sample.normal
		local forward = (rest.LookVector - normal * rest.LookVector:Dot(normal)).Unit
		local right = forward:Cross(normal).Unit
		local lowestFloor = floorHeight * normal.Y - math.abs(right.Y) * halfBeam - math.abs(forward.Y) * halfLength
		return math.max(sample.height, 0.35 - lowestFloor)
	end
	local axis = from.normal:Cross(to.normal)
	local tilt = if axis.Magnitude > 1e-6
		then CFrame.fromAxisAngle(axis.Unit, math.acos(math.clamp(from.normal:Dot(to.normal), -1, 1)))
		else CFrame.identity
	local pivot = rest.Position
	local offset = CFrame.new(pivot + Vector3.new(0, dryHeight(to) - dryHeight(from), 0)) * tilt * CFrame.new(-pivot)
	if floorHeight and halfBeam and halfLength and waterlineOffset then
		-- A newly launched hull may start level rather than at the sampled wave
		-- pose. Clamp its actual transformed deck as well as the relative swell.
		local pose = offset * rest
		local center = pose:PointToWorldSpace(Vector3.new(0, floorHeight, 0) - waterlineOffset)
		local lowest = center.Y - math.abs(pose.RightVector.Y) * halfBeam - math.abs(pose.LookVector.Y) * halfLength
		offset = CFrame.new(0, math.max(0, 0.35 - lowest), 0) * offset
	end
	return offset
end

return Weather
