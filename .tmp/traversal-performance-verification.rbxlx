		-- The skirt pivots on its air cushion, so it turns slowly even at rest.
		IdleSteering = 0.4,
		MaxBankAngle = 6,
		EngineSoundId = "rbxassetid://6667206432",
		Length = 22,
		Beam = 10.4,
		Seats = 3,
