        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">Herring</string>
            <string name="Source"><![CDATA[return {
	Name = "Herring",
	Rarity = "Uncommon",
	RarityDenominator = 9,
	MinKg = 0.1,
	AverageKg = 0.25,
	MaxKg = 0.9,
