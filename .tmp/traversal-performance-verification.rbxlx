    <Item class="ModuleScript" referent="2">
      <Properties>
        <string name="Name">FishSkeletonGeometry</string>
        <string name="Source"><![CDATA[-- Mirrors assets/ui/fish-skeleton.svg in a 120 x 72 canvas.
-- Path2D tangents are offsets from each knot, not absolute control points.
-- Stroke-only geometry keeps every interior transparent and needs no asset download.
return {
	width = 120,
	height = 72,
	paths = {
		{
			name = "Tail",
			thickness = 2.6,
			closed = true,
			points = {
				{ x = 24, y = 44, leftx = -4, lefty = 5, rightx = -5, righty = -1 },
				{ x = 7, y = 34, leftx = 6, lefty = 2, rightx = 0, righty = 0 },
				{ x = 11, y = 45, leftx = 0, lefty = 0, rightx = 0, righty = 0 },
				{ x = 7, y = 57, leftx = 0, lefty = 0, rightx = 7, righty = -2 },
			},
		},
		{
			name = "Backbone",
			thickness = 2.6,
			closed = false,
			points = {
				{ x = 24, y = 44, leftx = 0, lefty = 0, rightx = 18, righty = 5 },
				{ x = 88, y = 29, leftx = -30, lefty = -2, rightx = 0, righty = 0 },
			},
		},
		{
			name = "Rib1Upper",
			thickness = 2.3,
			closed = false,
			points = {
				{ x = 32.02, y = 44.6, leftx = 0, lefty = 0, rightx = -2.22, righty = -2.8 },
				{ x = 30.4, y = 34.3, leftx = -1.4, lefty = 3.5, rightx = 0, righty = 0 },
			},
		},
		{
			name = "Rib1Lower",
			thickness = 2.3,
			closed = false,
			points = {
				{ x = 32.02, y = 44.6, leftx = 0, lefty = 0, rightx = 0.48, righty = 4.4 },
				{ x = 39, y = 53.8, leftx = -3.7, lefty = -1.2, rightx = 0, righty = 0 },
			},
		},
		{
			name = "Rib2Upper",
			thickness = 2.3,
			closed = false,
			points = {
				{ x = 41.19, y = 42.18, leftx = 0, lefty = 0, rightx = -3.69, righty = -3.88 },
				{ x = 36, y = 26.8, leftx = -0.9, lefty = 4.9, rightx = 0, righty = 0 },
			},
		},
		{
			name = "Rib2Lower",
			thickness = 2.3,
			closed = false,
			points = {
				{ x = 41.19, y = 42.18, leftx = 0, lefty = 0, rightx = 0.91, righty = 6.02 },
				{ x = 52.6, y = 55.2, leftx = -5.4, lefty = -1.2, rightx = 0, righty = 0 },
			},
		},
		{
			name = "Rib3Upper",
			thickness = 2.3,
			closed = false,
			points = {
				{ x = 50.9, y = 37.9, leftx = 0, lefty = 0, rightx = -4.4, righty = -4.5 },
				{ x = 46.3, y = 20.1, leftx = -1.9, lefty = 5.1, rightx = 0, righty = 0 },
			},
		},
		{
			name = "Rib3Lower",
			thickness = 2.3,
			closed = false,
			points = {
				{ x = 50.9, y = 37.9, leftx = 0, lefty = 0, rightx = 2.2, righty = 6.5 },
				{ x = 66, y = 50.6, leftx = -6, lefty = -0.5, rightx = 0, righty = 0 },
			},
		},
		{
			name = "Rib4Upper",
			thickness = 2.3,
			closed = false,
			points = {
				{ x = 61.63, y = 33.28, leftx = 0, lefty = 0, rightx = -4.83, righty = -4.38 },
				{ x = 57.1, y = 15.8, leftx = -2.6, lefty = 5.3, rightx = 0, righty = 0 },
			},
		},
		{
			name = "Rib4Lower",
			thickness = 2.3,
			closed = false,
			points = {
				{ x = 61.63, y = 33.28, leftx = 0, lefty = 0, rightx = 3.37, righty = 6.42 },
				{ x = 78.2, y = 44.6, leftx = -5.7, lefty = 0.2, rightx = 0, righty = 0 },
			},
		},
		{
			name = "Rib5Upper",
			thickness = 2.3,
			closed = false,
			points = {
				{ x = 72.31, y = 30.11, leftx = 0, lefty = 0, rightx = -4.21, righty = -3.81 },
				{ x = 69.7, y = 16.4, leftx = -3.2, lefty = 3.9, rightx = 0, righty = 0 },
			},
		},
		{
			name = "Rib5Lower",
			thickness = 2.3,
			closed = false,
			points = {
				{ x = 72.31, y = 30.11, leftx = 0, lefty = 0, rightx = 3.09, righty = 5.19 },
				{ x = 87, y = 37.2, leftx = -5.5, lefty = 1.4, rightx = 0, righty = 0 },
			},
		},
		{
			name = "Skull",
			thickness = 2.5,
			closed = true,
			points = {
				{ x = 88, y = 29, leftx = 0, lefty = 2, rightx = 2, righty = -8 },
				{ x = 103, y = 19, leftx = -7, lefty = -2, rightx = 6, righty = 2 },
				{ x = 114, y = 29, leftx = -1, lefty = -4, rightx = 0, righty = 0 },
				{ x = 107, y = 30, leftx = 0, lefty = 0, rightx = 0, righty = 0 },
				{ x = 112, y = 35, leftx = 0, lefty = 0, rightx = -7, righty = 4 },
				{ x = 89, y = 35, leftx = 8, lefty = 5, rightx = -1, righty = -2 },
			},
		},
		{
			name = "Eye",
			thickness = 1.8,
			closed = true,
			points = {
				{ x = 103.5, y = 26, leftx = 0, lefty = -1.38, rightx = 0, righty = 1.38 },
				{ x = 101, y = 28.5, leftx = 1.38, lefty = 0, rightx = -1.38, righty = 0 },
				{ x = 98.5, y = 26, leftx = 0, lefty = 1.38, rightx = 0, righty = -1.38 },
				{ x = 101, y = 23.5, leftx = -1.38, lefty = 0, rightx = 1.38, righty = 0 },
			},
		},
	},
}
]]></string>
      </Properties>
    </Item>
    <Item class="LocalScript" referent="3">
      <Properties>
        <string name="Name">Loading</string>
        <string name="Source"><![CDATA[-- Native-vector ReplicatedFirst screen using the shared game UI theme. Startup readiness stays tied to
-- the completed harbour, initialized gear and solid ground at the assigned dock.
local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Theme = require(script.Parent:WaitForChild("UITheme"))
local FishSkeletonGeometry = require(script.Parent:WaitForChild("FishSkeletonGeometry"))

local player = Players.LocalPlayer
local startedAt = os.clock()
local white = Theme.Colors.Text
local muted = Theme.Colors.Muted

local gui = Instance.new("ScreenGui")
gui.Name = "FishingWatersLoading"
gui.IgnoreGuiInset = true
gui.DisplayOrder = 1000
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local screen = Instance.new("Frame")
screen.Name = "Screen"
screen.Size = UDim2.fromScale(1, 1)
screen.BackgroundColor3 = Theme.Colors.Window
screen.BorderSizePixel = 0
screen.Active = true
screen.ClipsDescendants = true
screen.Parent = gui

local function label(parent: Instance, name: string, text: string, size: number, color: Color3): TextLabel
	local item = Instance.new("TextLabel")
	item.Name = name
	item.AnchorPoint = Vector2.new(0.5, 0.5)
	item.Size = UDim2.new(1, 0, 0, 32)
	item.BackgroundTransparency = 1
	Theme.text(item, color)
	item.Text = text
	item.TextColor3 = color
	item.TextSize = size
	item.TextXAlignment = Enum.TextXAlignment.Center
	item.Parent = parent
	return item
end

local content = Instance.new("Frame")
content.Name = "Content"
content.AnchorPoint = Vector2.new(0.5, 0.5)
content.Position = UDim2.fromScale(0.5, 0.45)
content.Size = UDim2.new(1, -48, 0, 280)
local contentBounds = Instance.new("UISizeConstraint")
contentBounds.MaxSize = Vector2.new(720, 280)
contentBounds.Parent = content
Theme.window(content)
content.Parent = screen

-- Draw the SVG's cubic curves natively so the mark stays crisp and appears
-- immediately. The editable SVG lives in assets/ui/fish-skeleton.svg.
local mark = Instance.new("Frame")
mark.Name = "FishSkeletonMark"
mark.AnchorPoint = Vector2.new(0.5, 0.5)
mark.Size = UDim2.fromOffset(FishSkeletonGeometry.width, FishSkeletonGeometry.height)
mark.BackgroundTransparency = 1
mark.Parent = content
local markScale = Instance.new("UIScale")
markScale.Parent = mark

for _, shape in FishSkeletonGeometry.paths do
	local path = Instance.new("Path2D")
	path.Name = shape.name
	path.Color3 = white
	path.Thickness = shape.thickness
	path.Closed = shape.closed
	path.Visible = true
	local points = {}
	for _, point in shape.points do
		table.insert(
			points,
			Path2DControlPoint.new(
				UDim2.fromOffset(point.x, point.y),
				UDim2.fromOffset(point.leftx, point.lefty),
				UDim2.fromOffset(point.rightx, point.righty)
			)
		)
	end
	path:SetControlPoints(points)
	path.Parent = mark
end

local title = label(content, "Title", "Fishing Waters", 56, white)
title.Font = Enum.Font.GothamBold
local status = label(content, "Status", "Loading the waters...", 18, muted)
Theme.text(status, muted)

-- Progress reflects startup milestones rather than an estimated download percentage.
local progressTrack = Instance.new("Frame")
progressTrack.Name = "ProgressTrack"
progressTrack.AnchorPoint = Vector2.new(0.5, 0.5)
progressTrack.Size = UDim2.new(1, -96, 0, 8)
progressTrack.BackgroundColor3 = muted
progressTrack.BackgroundTransparency = 0.75
progressTrack.BorderSizePixel = 0
progressTrack.ClipsDescendants = true
progressTrack.Parent = content
local trackBounds = Instance.new("UISizeConstraint")
trackBounds.MaxSize = Vector2.new(360, 8)
trackBounds.Parent = progressTrack
local trackCorner = Instance.new("UICorner")
trackCorner.CornerRadius = UDim.new(1, 0)
trackCorner.Parent = progressTrack

local progressFill = Instance.new("Frame")
progressFill.Name = "ProgressFill"
progressFill.Size = UDim2.fromScale(0, 1)
progressFill.BackgroundColor3 = white
progressFill.BorderSizePixel = 0
progressFill.Parent = progressTrack
local fillCorner = Instance.new("UICorner")
fillCorner.CornerRadius = UDim.new(1, 0)
fillCorner.Parent = progressFill

local detail = label(screen, "Detail", "Your starter rod is already in your inventory. Equip it to start fishing.", 15, muted)
detail.Position = UDim2.fromScale(0.5, 0.855)
detail.Size = UDim2.new(1, -64, 0, 64)
detail.TextWrapped = true

-- The fallback appears only when gear startup is slow or fails and the dock is safe.
local continue = Instance.new("TextButton")
continue.Name = "Continue"
continue.AnchorPoint = Vector2.new(0.5, 0.5)
continue.Size = UDim2.fromOffset(220, 34)
continue.BackgroundTransparency = 1
continue.Font = Enum.Font.SourceSans
continue.Text = "Enter harbour →"
continue.TextSize = 17
continue.TextColor3 = white
continue.Visible = false
continue.Parent = screen
Theme.button(continue, "Selected")

local function resize()
	local width, height = screen.AbsoluteSize.X, screen.AbsoluteSize.Y
	local spacing = math.min(1, height / 600)
	content.Size = UDim2.new(1, -48, 0, 280 * spacing)
	mark.Position = UDim2.new(0.5, 0, 0, 32 * spacing)
	markScale.Scale = spacing * 0.85
	title.Position = UDim2.new(0.5, 0, 0, 111 * spacing)
	title.Size = UDim2.new(1, -36, 0, 72 * spacing)
	title.TextSize = math.clamp(math.min(width / 13, height / 13), 24, 48)
	status.Position = UDim2.new(0.5, 0, 0, 179 * spacing)
	status.TextSize = if width < 600 then 17 else 18
	progressTrack.Position = UDim2.new(0.5, 0, 0, 214 * spacing)
	detail.TextSize = if width < 600 then 14 else 15
	continue.Position = UDim2.new(0.5, 0, 0.45, 158 * spacing)
end

local resizeConnection = screen:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
gui.Parent = player:WaitForChild("PlayerGui")
resize()
ReplicatedFirst:RemoveDefaultLoadingScreen()

local dismissed = false
local continueConnection = continue.Activated:Connect(function()
	if continue.Visible then
		dismissed = true
	end
end)
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
groundParams.IgnoreWater = true
groundParams.RespectCanCollide = true
local tips = {
	"Your starter rod is already in your inventory. Equip it to start fishing.",
	"New anglers can launch their starter rowboat from the boat stand at their dock.",
	"Take a boat out and find a new stretch of shoreline.",
}

local progress = 0
while not dismissed do
	local elapsed = os.clock() - startedAt
	local connected = game:IsLoaded()
	local worldReady = ReplicatedStorage:GetAttribute("FishingWatersWorldReady") == true
	local clientReady = player:GetAttribute("FishingWatersClientReady") == true
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local alive = root and humanoid and humanoid.Health > 0
	local ground = false
	if alive and worldReady and player:GetAttribute("FishingWatersSpawnReady") == true then
		groundParams.FilterDescendantsInstances = { character }
		-- Observe actual collidable ground at the assigned spawn instead of
		-- adding a serial streaming request that doesn't prove it arrived.
		ground = workspace:Raycast(
			(root :: BasePart).Position + Vector3.new(0, 2, 0),
			Vector3.new(0, -32, 0),
			groundParams
		) ~= nil
	end
	local safeToEnter = connected and worldReady and alive and ground
	local targetProgress = if not connected then 0.08
		elseif not worldReady then 0.3
		elseif not alive or not ground then 0.6
		elseif not clientReady then 0.85
		else 1
	-- Keep the bar moving forward if readiness briefly fluctuates.
	progress = math.max(progress, targetProgress)
	progressFill.Size = UDim2.fromScale(progress, 1)
	local failed = player:GetAttribute("FishingWatersClientError") == true
	local serverFailed = ReplicatedStorage:GetAttribute("FishingWatersStartupError") == true
	if not connected then
		status.Text = "Connecting to the waters..."
	elseif not worldReady then
		local stage = ReplicatedStorage:GetAttribute("FishingWatersLoadStage")
		status.Text = (if type(stage) == "string" then stage else "Preparing the harbour") .. "..."
	elseif not alive or not ground then
		status.Text = "Finding your dock..."
	elseif not clientReady then
		status.Text = "Loading your fishing gear..."
	else
		status.Text = "Ready."
	end
	continue.Visible = safeToEnter and (failed or elapsed >= 12)
	detail.Text = tips[math.floor(elapsed / 8) % #tips + 1]
	if serverFailed then
		status.Text = "The harbour couldn't start"
		detail.Text = "Please use the Roblox menu to leave and rejoin."
		continue.Visible = false
	elseif failed then
		detail.Text = if safeToEnter
			then "Some gear couldn't load. Enter the harbour, or rejoin to retry."
			else "Some gear couldn't load. Waiting for a safe place to arrive."
	elseif elapsed >= 15 then
		detail.Text = if safeToEnter
			then "Your dock is ready. You can enter while your gear finishes."
			else "Still preparing your arrival. Thanks for hanging in there."
	end
	if safeToEnter and clientReady and not serverFailed then
		break
	end
	task.wait(0.1)
end

player:SetAttribute("FishingWatersLoadingSeconds", os.clock() - startedAt)
continueConnection:Disconnect()
resizeConnection:Disconnect()
-- Fade ordinary UI objects individually; no full-screen offscreen texture.
for _, item in gui:GetDescendants() do
	if item:IsA("GuiObject") then
		local properties = { BackgroundTransparency = 1 }
		if item:IsA("TextLabel") or item:IsA("TextButton") then
			properties.TextTransparency = 1
			properties.TextStrokeTransparency = 1
		end
		TweenService:Create(item, TweenInfo.new(0.25), properties):Play()
	elseif item:IsA("Path2D") then
		TweenService:Create(item, TweenInfo.new(0.25), { Thickness = 0 }):Play()
	elseif item:IsA("UIStroke") then
		TweenService:Create(item, TweenInfo.new(0.25), { Transparency = 1 }):Play()
	end
end
task.wait(0.25)
gui:Destroy()
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="4">
      <Properties>
        <string name="Name">UITheme</string>
        <string name="Source"><![CDATA[-- Shared by startup and gameplay UI. Kept in ReplicatedFirst so loading never
-- waits for the world or ReplicatedStorage before drawing its first frame.
local Theme = {}

Theme.Colors = {
	Window = Color3.fromRGB(51, 51, 51),
	Panel = Color3.fromRGB(62, 62, 62),
	Inset = Color3.fromRGB(29, 29, 29),
	Border = Color3.fromRGB(151, 151, 151),
	Text = Color3.fromRGB(245, 245, 245),
	Muted = Color3.fromRGB(215, 215, 215),
	Blue = Color3.fromRGB(56, 133, 193),
	Green = Color3.fromRGB(111, 202, 125),
	Black = Color3.fromRGB(0, 0, 0),
}

local finishes = {
	Normal = { Color3.fromRGB(147, 147, 147), Color3.fromRGB(87, 87, 87) },
	Selected = { Color3.fromRGB(82, 163, 229), Color3.fromRGB(39, 88, 128) },
	Danger = { Color3.fromRGB(238, 107, 111), Color3.fromRGB(131, 58, 61) },
	Disabled = { Color3.fromRGB(85, 85, 85), Color3.fromRGB(58, 58, 58) },
}

local function component(parent: Instance, class: string, name: string): any
	local item = parent:FindFirstChild(name)
	if not item then
		item = Instance.new(class)
		item.Name = name
		item.Parent = parent
	end
	return item
end

function Theme.corner(item: GuiObject, radius: number)
	local corner = item:FindFirstChildOfClass("UICorner") or component(item, "UICorner", "ThemeCorner")
	corner.CornerRadius = UDim.new(0, radius)
end

function Theme.text(item: any, color: Color3?)
	item.Font = Enum.Font.GothamBold
	item.TextColor3 = color or Theme.Colors.Text
	item.TextStrokeColor3 = Theme.Colors.Black
	item.TextStrokeTransparency = 0
end

function Theme.panel(item: GuiObject, inset: boolean?, radius: number?)
	item.BackgroundColor3 = if inset then Theme.Colors.Inset else Theme.Colors.Panel
	item.BackgroundTransparency = 0
	item.BorderSizePixel = 0
	Theme.corner(item, radius or 2)
	local border = component(item, "UIStroke", "ThemeBorder")
	border.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	border.Color = Theme.Colors.Border
	border.Thickness = 1
	border.Transparency = 0.35
end

-- Reapplying a state updates the existing finish, so tab changes and replicated
-- inventory updates cannot leave a stale gold fill or create duplicate strokes.
function Theme.button(item: TextButton, state: string?)
	local finish = finishes[state or "Normal"] or finishes.Normal
	Theme.panel(item, false, 10)
	item.BackgroundColor3 = finish[2]
	-- A gradient on the TextButton itself would also tint its text and outline.
	-- Keep the face and caption separate, while retaining native button input/Text.
	local face = component(item, "Frame", "ThemeFace")
	face.Size = UDim2.fromScale(1, 1)
	face.BackgroundColor3 = Color3.new(1, 1, 1)
	face.BorderSizePixel = 0
	face.Active = false
	Theme.corner(face, 10)
	local gradient = component(face, "UIGradient", "ThemeFinish")
	gradient.Rotation = 90
	if face:GetAttribute("Finish") ~= (state or "Normal") then
		gradient.Color = ColorSequence.new(finish[1], finish[2])
		face:SetAttribute("Finish", state or "Normal")
	end
	local caption = item:FindFirstChild("ThemeCaption")
	if not caption then
		caption = component(item, "TextLabel", "ThemeCaption")
		caption.BackgroundTransparency = 1
		caption.Size = UDim2.new(1, -8, 1, -4)
		caption.Position = UDim2.fromOffset(4, 2)
		caption.Active = false
		local function sync()
			for _, property in
				{
					"Text",
					"TextSize",
					"TextWrapped",
					"TextScaled",
					"TextXAlignment",
					"TextYAlignment",
					"RichText",
					"TextTruncate",
				}
			do
				caption[property] = item[property]
			end
			face.ZIndex = item.ZIndex
			caption.ZIndex = item.ZIndex + 1
		end
		for _, property in
			{
				"Text",
				"TextSize",
				"TextWrapped",
				"TextScaled",
				"TextXAlignment",
				"TextYAlignment",
				"RichText",
				"TextTruncate",
				"ZIndex",
			}
		do
			item:GetPropertyChangedSignal(property):Connect(sync)
		end
		sync()
	end
	Theme.text(caption, if state == "Disabled" then Theme.Colors.Muted else Theme.Colors.Text)
	item.TextTransparency = 1
	item.TextStrokeTransparency = 1
	local border = component(item, "UIStroke", "ThemeBorder")
	border.Transparency = 0
	item.AutoButtonColor = state ~= "Disabled"
	-- A button restyled away from glass (the shared close box) drops its glass lift.
	item:SetAttribute("GlassState", nil)
	local drop = item:FindFirstChild("ThemeDrop")
	if drop then
		drop.BackgroundTransparency = 1
	end
end

function Theme.window(item: GuiObject)
	Theme.panel(item, false, 12)
	item.BackgroundColor3 = Theme.Colors.Window
	local border = component(item, "UIStroke", "ThemeBorder")
	border.Thickness = 2
	border.Transparency = 0
	local rim = component(item, "Frame", "ThemeInnerRim")
	rim.Position = UDim2.fromOffset(6, 6)
	rim.Size = UDim2.new(1, -12, 1, -12)
	rim.BackgroundTransparency = 1
	rim.BorderSizePixel = 0
	Theme.corner(rim, 8)
	local line = component(rim, "UIStroke", "ThemeBorder")
	line.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	line.Color = Theme.Colors.Border
	line.Thickness = 1
	line.Transparency = 0.25
	for index, point in { Vector2.new(0, 0), Vector2.new(1, 0), Vector2.new(0, 1), Vector2.new(1, 1) } do
		local bolt = component(item, "Frame", "ThemeBolt" .. index)
		bolt.AnchorPoint = point
		bolt.Position = UDim2.new(point.X, if point.X == 0 then 6 else -6, point.Y, if point.Y == 0 then 6 else -6)
		bolt.Size = UDim2.fromOffset(6, 6)
		bolt.BackgroundColor3 = Theme.Colors.Border
		bolt.BorderSizePixel = 0
		Theme.corner(bolt, 3)
	end
end

function Theme.scroll(item: ScrollingFrame)
	item.ScrollBarThickness = 10
	item.ScrollBarImageColor3 = Theme.Colors.Inset
	item.ScrollBarImageTransparency = 0
	item.BorderSizePixel = 0
end

-- The collection menus use smoked glass, with a quiet woven/grid finish.
-- Native GUI geometry avoids an external texture download on first open.
function Theme.glassPanel(item: GuiObject, inset: boolean?)
	Theme.panel(item, inset, 1)
	item.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
	item.BackgroundTransparency = if inset then 0.38 else 0.52
	item.ThemeBorder.Color = Color3.fromRGB(122, 122, 122)
	item.ThemeBorder.Transparency = 0.65
end

-- Glass buttons are opaque, rounded and raised on a drop shadow so they never read
-- as the flat, translucent glass panels around them. Blue marks the active or
-- primary choice; disabled buttons lose their lift and colour.
local glassFinishes = {
	Normal = { Color3.fromRGB(84, 87, 92), Color3.fromRGB(40, 42, 46), Color3.fromRGB(150, 154, 160) },
	Selected = { Color3.fromRGB(86, 168, 234), Color3.fromRGB(32, 94, 146), Color3.fromRGB(168, 216, 252) },
	Danger = { Color3.fromRGB(196, 64, 69), Color3.fromRGB(104, 28, 32), Color3.fromRGB(246, 128, 132) },
	Disabled = { Color3.fromRGB(44, 44, 46), Color3.fromRGB(32, 32, 34), Color3.fromRGB(78, 78, 82) },
}

local function paintGlassButton(item: TextButton, hovered: boolean)
	local state = item:GetAttribute("GlassState")
	if not state then
		return
	end
	local finish = glassFinishes[state] or glassFinishes.Normal
	local disabled = state == "Disabled"
	local lift = hovered and not disabled
	local face = item.ThemeFace
	face.BackgroundTransparency = if disabled then 0.35 else 0
	face.ThemeFinish.Color = ColorSequence.new(
		if lift then finish[1]:Lerp(Color3.new(1, 1, 1), 0.12) else finish[1],
		finish[2]
	)
	item.ThemeBorder.Color = if lift then finish[3]:Lerp(Color3.new(1, 1, 1), 0.4) else finish[3]
	item.ThemeBorder.Transparency = if disabled then 0.5 elseif lift then 0 else 0.2
	item.ThemeBorder.Thickness = if lift then 2 else 1
	local drop = item:FindFirstChild("ThemeDrop")
	if drop then
		drop.BackgroundTransparency = if disabled then 1 else 0.45
		drop.ZIndex = item.ZIndex - 1
	end
end

function Theme.glassButton(item: TextButton, state: string?)
	Theme.button(item, state)
	local disabled = state == "Disabled"
	Theme.corner(item, 6)
	Theme.corner(item.ThemeFace, 6)
	item.BackgroundColor3 = Color3.new()
	item.BackgroundTransparency = 1
	item:SetAttribute("GlassState", state or "Normal")
	local drop = component(item, "Frame", "ThemeDrop")
	drop.Position = UDim2.fromOffset(0, 3)
	drop.Size = UDim2.fromScale(1, 1)
	drop.BackgroundColor3 = Color3.new()
	drop.BorderSizePixel = 0
	drop.Active = false
	Theme.corner(drop, 6)
	if not item:GetAttribute("GlassHover") then
		item:SetAttribute("GlassHover", true)
		local hovered, focused = false, false
		local function update()
			paintGlassButton(item, hovered or focused)
		end
		item.MouseEnter:Connect(function()
			hovered = true
			update()
		end)
		item.MouseLeave:Connect(function()
			hovered = false
			update()
		end)
		item.SelectionGained:Connect(function()
			focused = true
			update()
		end)
		item.SelectionLost:Connect(function()
			focused = false
			update()
		end)
	end
	paintGlassButton(item, false)
	Theme.text(item.ThemeCaption, if disabled then Color3.fromRGB(140, 140, 140) else Theme.Colors.Text)
end

function Theme.glassWindow(item: GuiObject)
	Theme.glassPanel(item)
	item.BackgroundTransparency = 0.2
	item.ThemeBorder.Transparency = 0.25
	item.ThemeBorder.Thickness = 1
	local rim = item:FindFirstChild("ThemeInnerRim")
	if rim then
		Theme.corner(rim, 1)
		rim.ThemeBorder.Transparency = 0.78
	end
	local texture = item:FindFirstChild("GlassTexture")
	if texture then
		texture.Visible = true
		return
	end
	texture = component(item, "Frame", "GlassTexture")
	texture.Size = UDim2.fromScale(1, 1)
	texture.BackgroundTransparency = 1
	texture.BorderSizePixel = 0
	texture.ClipsDescendants = true
	texture.Active = false
	-- Draw behind the content, including the empty shop/loading states.
	texture.ZIndex = 0
	local function mark(name, position, size, transparency)
		local line = Instance.new("Frame")
		line.Name = name
		line.BackgroundColor3 = Color3.fromRGB(172, 172, 172)
		line.BackgroundTransparency = transparency
		line.BorderSizePixel = 0
		line.Position, line.Size = position, size
		line.Active = false
		line.ZIndex = 0
		line.Parent = texture
	end
	for index = 1, 36 do
		mark("WeaveVertical" .. index, UDim2.new(0, index * 28, 0, 0), UDim2.new(0, 1, 1, 0), 0.97)
	end
	for index = 1, 24 do
		mark("WeaveHorizontal" .. index, UDim2.new(0, 0, 0, index * 28), UDim2.new(1, 0, 0, 1), 0.97)
	end
	for index = 1, 48 do
		mark(
			"Grain" .. index,
			UDim2.fromScale(((index * 37) % 97) / 100, ((index * 61) % 97) / 100),
			UDim2.fromOffset(1 + index % 3, 1),
			0.91
		)
	end
	mark("HeaderRule", UDim2.fromOffset(0, 91), UDim2.new(1, 0, 0, 1), 0.7)
end

return Theme
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ReplicatedStorage" referent="5">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="6">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Aboard</string>
          <string name="Source"><![CDATA[-- Whether a character is on a boat: sitting in one of its seats or standing on
-- its deck (a short ray down from the root hits the hull). The server uses it to
-- allow cargo moves and the client to show the cargo hold, so both agree.
local DECK_REACH = 8

return function(character: Model?, boat: Model?): boolean
	if not character or not boat or not boat.Parent then
		return false
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return false
	end
	local seat = humanoid.SeatPart
	if seat and seat:IsDescendantOf(boat) then
		return true
	end
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Include
	parameters.FilterDescendantsInstances = { boat }
	return workspace:Raycast(root.Position, Vector3.new(0, -DECK_REACH, 0), parameters) ~= nil
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Admin</string>
          <string name="Source"><![CDATA[-- The one place admin accounts are listed. Every admin command and admin-only
-- server function checks a player through Admin.isAdmin.
local Admin = {}

Admin.UserIds = table.freeze({
	[2541746813] = true, -- hyperlinkhyper
})

function Admin.isAdmin(player: Player?): boolean
	return player ~= nil and Admin.UserIds[player.UserId] == true
end

return table.freeze(Admin)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">AnglerCatalog</string>
          <string name="Source"><![CDATA[-- The bestiary and journal read this registry. Species live one per module in
-- Shared.Fish (format in Shared.FishSpecies); this turns them into Catalog.Fish
-- and fills the pools each one names.
local FishSpecies = require(script.Parent.FishSpecies)

local Catalog = {}

-- Ordered tiers. XP is awarded per landed fish; Difficulty starts the reel minigame.
Catalog.Rarities = {
	Junk = { Name = "Junk", Order = 0, Color = Color3.fromRGB(157, 133, 104), Difficulty = 0.05, XP = 5 },
	Common = { Name = "Common", Order = 1, Color = Color3.fromRGB(196, 196, 196), Difficulty = 0.12, XP = 50 },
	Uncommon = { Name = "Uncommon", Order = 2, Color = Color3.fromRGB(111, 202, 125), Difficulty = 0.3, XP = 100 },
	Rare = { Name = "Rare", Order = 3, Color = Color3.fromRGB(82, 163, 229), Difficulty = 0.48, XP = 200 },
	Epic = { Name = "Epic", Order = 4, Color = Color3.fromRGB(176, 108, 230), Difficulty = 0.58, XP = 400 },
	Legendary = { Name = "Legendary", Order = 5, Color = Color3.fromRGB(240, 176, 64), Difficulty = 0.66, XP = 800 },
	Mythical = { Name = "Mythical", Order = 6, Color = Color3.fromRGB(232, 62, 92), Difficulty = 0.66, XP = 1600 },
	Exotic = { Name = "Exotic", Order = 7, Color = Color3.fromRGB(52, 222, 196), Difficulty = 0.66, XP = 3200 },
	Divine = { Name = "Divine", Order = 8, Color = Color3.fromRGB(255, 242, 178), Difficulty = 0.66, XP = 6400 },
	-- Limited species skip the weighted draw: they only bite while the admin
	-- dashboard has them switched on, at the chance set there (FishCatch.limited).
	Limited = { Name = "Limited", Order = 9, Color = Color3.fromRGB(255, 84, 214), Difficulty = 0.66, XP = 2500 },
	-- The rarest tier by far: a handful of things that should not exist.
	Admin = { Name = "Admin", Order = 10, Color = Color3.fromRGB(255, 28, 28), Difficulty = 0.66, XP = 25600 },
	-- Beyond the dashboard's reach: one rod-only catch, one in a million.
	Secret = { Name = "Secret", Order = 11, Color = Color3.fromRGB(255, 210, 92), Difficulty = 0.66, XP = 1000000 },
}

-- Junk uses the same carrying, cargo and selling path as other catches.
Catalog.Fish = {}
for id, fish in FishSpecies do
	assert(Catalog.Rarities[fish.Rarity], id .. " has an unknown rarity")
	local requires = fish.Requires
	Catalog.Fish[id] = {
		Name = fish.Name,
		Image = fish.Image or "",
		Rarity = fish.Rarity,
		CatchXP = Catalog.Rarities[fish.Rarity].XP,
		RarityDenominator = fish.RarityDenominator,
		MinKg = fish.MinKg,
		AverageKg = fish.AverageKg,
		MaxKg = fish.MaxKg,
		BaseValue = fish.BaseValue,
		Fight = fish.Fight or 0,
		Shapes = fish.Shapes,
		Seasons = fish.Seasons,
		Requires = if type(requires) == "string" then { requires } else requires,
		DropOnly = fish.DropOnly,
		Secret = fish.Secret == true,
	}
end

-- The sheltered bay and surrounding Gullhaven Sound share one pool. Other
-- casts use the pool for the biome under the bobber. Biome pools
-- inherit every Open Sea species, so a biome with few or no species of its own
-- still fishes like the open sea. Species join pools through their Pools list.
local JUNK = { "WoodenBranch", "LeatherBoot", "Seaweed" }
Catalog.Pools = {
	MainLake = { Name = "Gullhaven Sound", Area = "lake", Inherits = "OpenSea", Junk = JUNK },
	OpenSea = { Name = "Open Sea", Area = "open", Junk = JUNK },
	SoddenMire = { Name = "The Sodden Mire", Area = "swamp", Inherits = "OpenSea", Junk = JUNK },
	CoralShallows = { Name = "Coral Shallows", Area = "tropical", Inherits = "OpenSea", Junk = JUNK },
	CinderIsles = { Name = "Cinder Isles", Area = "volcanic", Inherits = "OpenSea", Junk = JUNK },
	FrostmereExpanse = { Name = "Frostmere Expanse", Area = "ice", Inherits = "OpenSea", Junk = JUNK },
}
Catalog.DefaultPool = "MainLake"

-- Commoner species first, then by id, so pool order never depends on file order.
local ids = {}
for id in FishSpecies do
	table.insert(ids, id)
end
table.sort(ids, function(a, b)
	local fa, fb = FishSpecies[a], FishSpecies[b]
	local ra, rb = Catalog.Rarities[fa.Rarity].Order, Catalog.Rarities[fb.Rarity].Order
	if ra ~= rb then
		return ra < rb
	end
	return a < b
end)
for _, pool in Catalog.Pools do
	pool.Own = {}
end
for _, id in ids do
	for _, poolId in FishSpecies[id].Pools or {} do
		local pool = Catalog.Pools[poolId]
		assert(pool, id .. " names unknown pool " .. poolId)
		table.insert(pool.Own, id)
	end
end
-- Fish is what bites: a pool's own species plus any it inherits.
for _, pool in Catalog.Pools do
	local fish = table.clone(pool.Own)
	local parent = pool.Inherits and Catalog.Pools[pool.Inherits]
	for _, id in if parent then parent.Own else {} do
		if not table.find(fish, id) then
			table.insert(fish, id)
		end
	end
	pool.Fish = fish
end

-- The pool for an area: "lake", or a Shared.Biomes id (CatchConditions.area).
function Catalog.poolAt(area: string?)
	if area == "normal" then
		return Catalog.Pools.MainLake
	end
	for _, pool in Catalog.Pools do
		if pool.Area == area then
			return pool
		end
	end
	return Catalog.Pools.OpenSea
end

-- Every key FishMutations can roll. RarityMultiplier is one over the key's
-- chance per catch (at night for Astral); scripts/fish-mutations.luau keeps
-- them in step with the roll odds.
Catalog.Mutations = {
	Normal = { Name = "Normal", RarityMultiplier = 1 },
	Neon = { Name = "Neon", RarityMultiplier = 145 },
	Albino = { Name = "Albino", RarityMultiplier = 333 },
	Rainbow = { Name = "Rainbow", RarityMultiplier = 667 },
	Astral = { Name = "Astral", RarityMultiplier = 1307 },
	Corrupted = { Name = "Corrupted", RarityMultiplier = 429 },
	["Neon+Albino"] = { Name = "Neon Albino", RarityMultiplier = 1111 },
	["Rainbow+Neon"] = { Name = "Rainbow Neon", RarityMultiplier = 1667 },
	["Astral+Rainbow"] = { Name = "Astral Rainbow", RarityMultiplier = 7407 },
	["Corrupted+Neon"] = { Name = "Corrupted Neon", RarityMultiplier = 1304 },
	["Corrupted+Albino"] = { Name = "Corrupted Albino", RarityMultiplier = 3000 },
	["Corrupted+Rainbow"] = { Name = "Corrupted Rainbow", RarityMultiplier = 6000 },
	["Corrupted+Astral"] = { Name = "Corrupted Astral", RarityMultiplier = 11765 },
	["Corrupted+Neon+Albino"] = { Name = "Corrupted Neon Albino", RarityMultiplier = 10000 },
	["Corrupted+Rainbow+Neon"] = { Name = "Corrupted Rainbow Neon", RarityMultiplier = 15000 },
	["Corrupted+Astral+Rainbow"] = { Name = "Corrupted Astral Rainbow", RarityMultiplier = 66667 },
	-- Guaranteed event traits have no natural encounter odds or added rarity score.
	VoidTouched = { Name = "Void Touched", RarityMultiplier = 1, EventOnly = true },
	["VoidTouched+Astral"] = { Name = "Void Touched Astral", RarityMultiplier = 1, EventOnly = true },
	["VoidTouched+Astral+Rainbow"] = { Name = "Void Touched Astral Rainbow", RarityMultiplier = 1, EventOnly = true },
	["VoidTouched+Neon"] = { Name = "Void Touched Neon", RarityMultiplier = 1, EventOnly = true },
	["VoidTouched+Albino"] = { Name = "Void Touched Albino", RarityMultiplier = 1, EventOnly = true },
	["VoidTouched+Rainbow"] = { Name = "Void Touched Rainbow", RarityMultiplier = 1, EventOnly = true },
	["VoidTouched+Neon+Albino"] = { Name = "Void Touched Neon Albino", RarityMultiplier = 1, EventOnly = true },
	["VoidTouched+Rainbow+Neon"] = { Name = "Void Touched Rainbow Neon", RarityMultiplier = 1, EventOnly = true },
	["Corrupted+VoidTouched"] = { Name = "Corrupted Void Touched", RarityMultiplier = 1, EventOnly = true },
	["Corrupted+VoidTouched+Astral"] = {
		Name = "Corrupted Void Touched Astral",
		RarityMultiplier = 1,
		EventOnly = true,
	},
	["Corrupted+VoidTouched+Astral+Rainbow"] = {
		Name = "Corrupted Void Touched Astral Rainbow",
		RarityMultiplier = 1,
		EventOnly = true,
	},
	["Corrupted+VoidTouched+Neon"] = { Name = "Corrupted Void Touched Neon", RarityMultiplier = 1, EventOnly = true },
	["Corrupted+VoidTouched+Albino"] = {
		Name = "Corrupted Void Touched Albino",
		RarityMultiplier = 1,
		EventOnly = true,
	},
	["Corrupted+VoidTouched+Rainbow"] = {
		Name = "Corrupted Void Touched Rainbow",
		RarityMultiplier = 1,
		EventOnly = true,
	},
	["Corrupted+VoidTouched+Neon+Albino"] = {
		Name = "Corrupted Void Touched Neon Albino",
		RarityMultiplier = 1,
		EventOnly = true,
	},
	["Corrupted+VoidTouched+Rainbow+Neon"] = {
		Name = "Corrupted Void Touched Rainbow Neon",
		RarityMultiplier = 1,
		EventOnly = true,
	},
}
-- Windy (fishing under a supercell) joins every natural key, after any
-- corruption, matching FishMutations.key order and label.
local windy = { Windy = { Name = "Windy", RarityMultiplier = 1, EventOnly = true } }
for key, entry in Catalog.Mutations do
	if key ~= "Normal" and not entry.EventOnly then
		local rest, restName = key:match("^Corrupted%+(.+)$"), entry.Name:match("^Corrupted (.+)$")
		local windyKey = if key == "Corrupted"
			then "Corrupted+Windy"
			elseif rest then "Corrupted+Windy+" .. rest
			else "Windy+" .. key
		local name = if key == "Corrupted"
			then "Corrupted Windy"
			elseif restName then "Corrupted Windy " .. restName
			else "Windy " .. entry.Name
		windy[windyKey] = { Name = name, RarityMultiplier = 1, EventOnly = true }
	end
end
for key, entry in windy do
	Catalog.Mutations[key] = entry
end
-- Special finishes and their event variants are valid saved catch keys.
for _, special in {
 { "Ascended", "Ascended", 10000 }, { "Floral", "Floral", 200 }, { "Snowy", "Snowy", 200 },
 { "Tryhard", "Tryhard", 10000 }, { "JackOFish", "Jack O' Fish", 20 }, { "JacksPet", "Jack's Pet", 500 },
 { "ZeusStruck", "Zeus Struck", 150 }, { "Nightmare", "Nightmare", 30 }, { "Obsidian", "Obsidian", 30 }, { "Gusty", "Gusty", 100 },
} do
 Catalog.Mutations[special[1]] = { Name = special[2], RarityMultiplier = special[3] }
 for _, prefix in { { "Windy+", "Windy " }, { "Corrupted+", "Corrupted " }, { "Corrupted+VoidTouched+", "Corrupted Void Touched " } } do
  Catalog.Mutations[prefix[1] .. special[1]] = { Name = prefix[2] .. special[2], RarityMultiplier = 1, EventOnly = true }
 end
end
Catalog.Equipment = {
	StarterRod = {
		Name = "Starter fishing rod",
		Kind = "Fishing rod",
		Description = "Your first companion on the water.",
	},
}
-- Titles are awarded by server gameplay, never by the menu client.
Catalog.Titles = {}
return Catalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Areas</string>
          <string name="Source"><![CDATA[-- Named places the client announces with a big "now entering" banner (client AreaBanner):
-- the five biomes, the open water between them, and landmarks inside them (Pirate Cove,
-- the Modern City). Positions are X/Z only, so this stays a cheap per-tick lookup.

local Biomes = require(script.Parent.Biomes)
local PirateCove = require(script.Parent.PirateCove)

export type Area = {
	id: string,
	name: string,
	subtitle: string,
	accent: Color3,
	center: Vector2,
	radius: number, -- 0 = everywhere nothing else claims (open water)
	parent: string?, -- landmarks: the area they sit in; leaving one back into it stays quiet
}

local Areas = {}

-- Stay in an area until this far past its edge (fraction of its radius), so sailing along a
-- boundary never flickers the banner.
Areas.LEAVE_MARGIN = 1.1

local rgb = Color3.fromRGB

local BIOME_STYLE = {
	normal = { subtitle = "Home waters", accent = rgb(150, 196, 226) },
	swamp = { subtitle = "Murky marsh waters", accent = rgb(196, 182, 104) },
	tropical = { subtitle = "Warm lagoon waters", accent = rgb(110, 222, 214) },
	volcanic = { subtitle = "Ash and ember waters", accent = rgb(255, 136, 92) },
	ice = { subtitle = "Frozen northern waters", accent = rgb(196, 230, 255) },
	open = { subtitle = "The deep open sea", accent = rgb(120, 160, 205) },
}

local byBiome: { [string]: Area } = {}
for _, biome in Biomes.list do
	local style = BIOME_STYLE[biome.id]
	byBiome[biome.id] = {
		id = biome.id,
		name = biome.name,
		subtitle = style.subtitle,
		accent = style.accent,
		center = biome.center,
		radius = biome.radius,
	}
end
byBiome.open = {
	id = "open",
	name = Biomes.OpenSea.name,
	subtitle = BIOME_STYLE.open.subtitle,
	accent = BIOME_STYLE.open.accent,
	center = Biomes.OpenSea.center,
	radius = 0,
}
Areas.Biomes = byBiome

-- Checked before biomes, so a landmark wins inside the biome that holds it.
Areas.Landmarks = {
	{
		id = "piratecove",
		name = PirateCove.NAME,
		subtitle = "Coral Shallows",
		accent = rgb(240, 196, 110),
		center = Vector2.new(PirateCove.CENTER[1], PirateCove.CENTER[2]),
		-- The island plus its anchorage.
		radius = PirateCove.RADIUS + 90,
		parent = "tropical",
	},
	{
		id = "city",
		name = "Modern City",
		subtitle = "The mainland",
		accent = rgb(230, 222, 200),
		-- ModernCity's CENTER; the coast and lighthouse reach ~1,700 studs out.
		center = Vector2.new(7000, 7000),
		radius = 1800,
		parent = "open",
	},
} :: { Area }

-- Fraction of an area's radius a point is from its centre (0 = centre, 1 = edge).
function Areas.depthIn(area: Area, position: Vector3): number
	if area.radius <= 0 then
		return math.huge
	end
	local dx, dz = position.X - area.center.X, position.Z - area.center.Y
	return math.sqrt(dx * dx + dz * dz) / area.radius
end

-- The area at `position`, given the one the player was last in (for hysteresis).
function Areas.at(position: Vector3, current: Area?): Area
	for _, landmark in Areas.Landmarks do
		local limit = if landmark == current then Areas.LEAVE_MARGIN else 1
		if Areas.depthIn(landmark, position) < limit then
			return landmark
		end
	end
	if
		current
		and current.radius > 0
		and not current.parent
		and Areas.depthIn(current, position) < Areas.LEAVE_MARGIN
	then
		return current
	end
	return byBiome[Biomes.at(position).id] or byBiome.open
end

-- Whether moving from `previous` into `area` deserves a banner. Stepping off a landmark back
-- into the water around it (Pirate Cove -> Coral Shallows) is not news.
function Areas.announces(previous: Area?, area: Area): boolean
	if previous == area then
		return false
	end
	return not (previous and previous.parent == area.id)
end

return Areas
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">AvatarLite</string>
          <string name="Source"><![CDATA[-- Cheaper copies of real players' avatars for crowds (townsfolk, shop customers).
--
-- Random accounts often wear layered clothing (3D jackets, shirts, shoes). Every layered
-- item runs a wrap deformer per rig: its cage meshes are fetched and the clothing mesh is
-- deformed and kept per instance. Dozens of townsfolk made that a large share of client
-- memory and frame time, and failed fetches spammed "Wrap-deformer fetching meshes
-- resulted in error". Crowds keep classic Shirt/Pants and rigid accessories (hair, hats)
-- and drop the layered items.
local AvatarLite = {}

-- Rigid accessories kept per crowd avatar; hair and hats come first in GetAccessories order.
AvatarLite.MAX_ACCESSORIES = 6

-- Pure filter over GetAccessories entries, kept separate so it can be tested without Roblox.
function AvatarLite.filter(accessories: { any }, limit: number?): { any }
	local kept = {}
	local cap = limit or AvatarLite.MAX_ACCESSORIES
	for _, accessory in accessories do
		if #kept >= cap then
			break
		end
		if not accessory.IsLayered then
			table.insert(kept, accessory)
		end
	end
	return kept
end

-- Strips layered clothing from `description` in place and returns it.
function AvatarLite.strip(description: HumanoidDescription): HumanoidDescription
	pcall(function()
		local accessories = description:GetAccessories(true)
		local kept = AvatarLite.filter(accessories)
		if #kept ~= #accessories then
			description:SetAccessories(kept, true)
		end
	end)
	return description
end

-- Removes any layered clothing left on a rig built for a crowd, and the body cages that only
-- layered clothing needs. strip() can fail quietly (its call is guarded), and the client log
-- still showed "Wrap-deformer fetching meshes resulted in error" every few seconds, each one
-- a mesh fetch and deformer setup on the frame. Call on a built model before parenting it.
function AvatarLite.stripModel(model: Instance)
	for _, item in model:GetDescendants() do
		if item:IsA("WrapLayer") then
			local accessory = item:FindFirstAncestorWhichIsA("Accessory")
			if accessory and accessory:IsDescendantOf(model) then
				accessory:Destroy()
			else
				item:Destroy()
			end
		end
	end
	for _, item in model:GetDescendants() do
		if item:IsA("WrapTarget") then
			item:Destroy()
		end
	end
	return model
end

return AvatarLite
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">BackpackCatalog</string>
          <string name="Source"><![CDATA[-- Upgrade masks grow without removing any cell from the previous tier.
local Catalog = {
	Order = {
		"Starter",
		"Satchel",
		"Tackle",
		"Creel",
		"Cooler",
		"Beacon",
		"Angler",
		"Reef",
		"Explorer",
		"Treasure",
		"Expedition",
		"Diving",
		"Storm",
		"Lunar",
		"Abyss",
	},
	Items = {
		Starter = {
			Name = "Burlap pouch",
			Price = 0,
			Description = "A tied canvas pouch for your first catches.",
			Hold = { "##", "##" },
		},
		Satchel = {
			Name = "Leather satchel",
			Price = 100,
			Description = "A stitched shoulder satchel with a brass clasp.",
			Hold = { "##", "##", "##" },
		},
		Tackle = {
			Name = "Tackle box",
			Price = 250,
			Description = "A red steel tackle case with twin latches.",
			Hold = { "##", "##", "##", "##" },
		},
		Creel = {
			Name = "Wicker creel",
			Price = 450,
			Description = "A woven fishing basket with a wooden lid.",
			Hold = { "###", "###", "###", "###" },
		},
		Cooler = {
			Name = "Ice cooler",
			Price = 900,
			Description = "An insulated blue cooler for a longer trip.",
			Hold = { "####", "####", "####", "####" },
		},
		Beacon = {
			Name = "Beacon lantern",
			Price = 1600,
			Description = "A brass harbour lantern with a warm glass core.",
			Hold = { "####", "####", "####", "####", "####" },
		},
		Angler = {
			Name = "Angler backpack",
			Price = 2500,
			Description = "A green field pack with rod tubes and side pockets.",
			Hold = { "####", "####", "####", "####", "####", "####" },
		},
		Reef = {
			Name = "Reef aquarium",
			Price = 4000,
			Description = "A round reef tank with coral and a tiny fish.",
			Hold = { "#####", "#####", "#####", "#####", "#####", "#####" },
		},
		Explorer = {
			Name = "Explorer rolltop",
			Price = 6500,
			Description = "A waxed rolltop with a compass and orange straps.",
			Hold = { "######", "######", "######", "######", "######", "######" },
		},
		Treasure = {
			Name = "Treasure chest",
			Price = 10000,
			Description = "A sea-worn chest filled with gold and gems.",
			Hold = { "######", "######", "######", "######", "######", "######", "######" },
		},
		Expedition = {
			Name = "Expedition pack",
			Price = 16000,
			Description = "A trail pack with a bedroll and hanging mug.",
			Hold = { "######", "######", "######", "######", "######", "######", "######", "######" },
		},
		Diving = {
			Name = "Diving rig",
			Price = 25000,
			Description = "Twin air cylinders in a deep-sea harness.",
			Hold = { "#######", "#######", "#######", "#######", "#######", "#######", "#######", "#######" },
		},
		Storm = {
			Name = "Storm battery",
			Price = 40000,
			Description = "A storm-powered coil with electric blue fins.",
			Hold = { "########", "########", "########", "########", "########", "########", "########", "########" },
		},
		Lunar = {
			Name = "Lunar observatory",
			Price = 65000,
			Description = "A moonstone pod carrying a small brass telescope.",
			Hold = {
				"########",
				"########",
				"########",
				"########",
				"########",
				"########",
				"########",
				"########",
				"########",
			},
		},
		-- Black Hole Backpack gamepass (999 Robux). Not sold for cash and not in
		-- Order: owning the pass replaces whatever pack is saved (layoutFor).
		-- The rows retain the legacy shape; the Infinite flag on the mask
		-- makes Cargo.capacity unlimited.
		BlackHole = {
			Name = "Black hole backpack",
			Price = 0,
			Gamepass = "BlackHoleBackpack",
			Description = "A captive singularity in a containment harness. Infinite fish storage.",
			Hold = table.freeze(setmetatable({
				"##########",
				"##########",
				"##########",
				"##########",
				"##########",
				"##########",
				"##########",
				"##########",
				"##########",
				"##########",
			}, { __index = { Infinite = true } })),
		},
		Abyss = {
			Name = "Abyss reactor",
			Price = 100000,
			Description = "A dark pressure vessel glowing with abyssal energy.",
			Hold = {
				"########",
				"########",
				"########",
				"########",
				"########",
				"########",
				"########",
				"########",
				"########",
				"########",
			},
		},
	},
}

function Catalog.rank(id): number
	return table.find(Catalog.Order, id) or 0
end

-- The id a player actually carries: the gamepass pack overrides the saved one.
-- The server sets OwnsBlackHoleBackpack, so clients read the same answer.
function Catalog.carriedId(player: Player?, savedId: string?): string
	if player and player:GetAttribute("OwnsBlackHoleBackpack") == true then
		return "BlackHole"
	end
	return if savedId and Catalog.Items[savedId] and not Catalog.Items[savedId].Gamepass then savedId else "Starter"
end

function Catalog.layoutFor(player: Player?, savedId: string?)
	return Catalog.Items[Catalog.carriedId(player, savedId)]
end

return Catalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">BackpackModels</string>
          <string name="Source"><![CDATA[-- One set of low-poly builders for worn packs, store displays, and 3D previews.
-- Local +Z faces away from the wearer's back. Preview/display parts stay anchored.
local Backpacks = require(script.Parent.BackpackCatalog)
local Models = {}
local rgb = Color3.fromRGB
local V, F = Vector3.new, CFrame.new
local M = Enum.Material
local leather, brass, steel = rgb(78, 52, 35), rgb(194, 153, 69), rgb(47, 58, 66)

function Models.create(id: string): Model
	if not Backpacks.Items[id] then
		id = "Starter"
	end
	local model = Instance.new("Model")
	model.Name = "Backpack_" .. id
	model:SetAttribute("BackpackId", id)
	-- Parts go into the model, or into the rig group being built (rigGroup).
	local into: Instance = model
	local function part(name, size, frame, color, material, shape, alpha)
		local p = Instance.new("Part")
		p.Name, p.Size, p.CFrame = name, size, frame
		p.Color, p.Material = color, material or M.SmoothPlastic
		p.Anchored, p.Massless = true, true
		p.CanCollide, p.CanTouch, p.CanQuery = false, false, false
		p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		if shape then
			p.Shape = shape
		end
		p.Transparency = alpha or 0
		p.Parent = into
		return p
	end
	-- A child Model whose PrimaryPart is an invisible pivot at `frame`. Worn
	-- packs joint the pivot to the handle with a Motor6D named after the group
	-- and weld the group's parts to the pivot, so a client can move the group
	-- by changing that one joint.
	local function rigGroup(name: string, frame: CFrame, build: (CFrame) -> ())
		local group = Instance.new("Model")
		group.Name = name
		group.Parent = into
		local previous = into
		into = group
		group.PrimaryPart = part("RigPivot", V(0.05, 0.05, 0.05), frame, steel, M.SmoothPlastic, nil, 1)
		build(frame)
		into = previous
	end
	local function ball(name, size, frame, color, material, alpha)
		return part(name, size, frame, color, material, Enum.PartType.Ball, alpha)
	end
	local function cylinder(name, radius, height, frame, color, material, alpha)
		return part(
			name,
			V(height, radius * 2, radius * 2),
			frame * CFrame.Angles(0, 0, math.pi / 2),
			color,
			material,
			Enum.PartType.Cylinder,
			alpha
		)
	end
	local function ring(name, radius, frame, color, thickness, material)
		-- Eight straight segments make a deliberate polygonal hoop.
		local width = thickness or 0.09
		for i = 0, 7 do
			part(
				name,
				V(radius * 0.84, width, width),
				frame * CFrame.Angles(0, 0, i * math.pi / 4) * F(0, radius, 0),
				color,
				material or M.Metal
			)
		end
	end
	-- Rounded outlines made from primitives keep every design asset-free.
	local function panel(name, size, frame, color, material, radius)
		local r = radius or math.min(size.X, size.Y) * 0.16
		part(name, V(size.X - r * 2, size.Y, size.Z), frame, color, material)
		part(name, V(size.X, size.Y - r * 2, size.Z), frame, color, material)
		for _, x in { -1, 1 } do
			for _, y in { -1, 1 } do
				cylinder(
					name,
					r,
					size.Z,
					frame * F(x * (size.X / 2 - r), y * (size.Y / 2 - r), 0) * CFrame.Angles(math.pi / 2, 0, 0),
					color,
					material
				)
			end
		end
	end
	local function buckle(frame, width)
		local w = width or 0.25
		for _, side in { -1, 1 } do
			part("BuckleFrame", V(0.045, w, 0.065), frame * F(side * w / 2, 0, 0), brass, M.Metal)
			part("BuckleFrame", V(w, 0.045, 0.065), frame * F(0, side * w / 2, 0), brass, M.Metal)
		end
		part("BuckleTongue", V(0.035, w * 0.75, 0.08), frame, brass, M.Metal)
	end
	local function carryHandle(frame, width, color)
		part("CarryGrip", V(width, 0.12, 0.16), frame * F(0, 0.18, 0), color, M.Fabric)
		for _, side in { -1, 1 } do
			part("HandleMount", V(0.12, 0.24, 0.16), frame * F(side * (width / 2 - 0.06), 0.02, 0), color, M.Fabric)
		end
	end
	local function rivet(x, y, z)
		cylinder("Rivet", 0.045, 0.045, F(x, y, z) * CFrame.Angles(math.pi / 2, 0, 0), brass, M.Metal)
	end
	local handle = part("Handle", V(0.12, 0.12, 0.12), F(), steel, M.SmoothPlastic, nil, 1)
	model.PrimaryPart = handle
	-- Every design has a harness on its inner face.
	for _, side in { -1, 1 } do
		part(
			"ShoulderStrap",
			V(0.22, 1.15, 0.14),
			F(side * 0.5, 0.25, -0.56) * CFrame.Angles(0, 0, side * -0.12),
			leather,
			M.Fabric
		)
		part("StrapTail", V(0.14, 0.65, 0.1), F(side * 0.54, -0.62, -0.54), leather, M.Fabric)
		part("StrapAdjuster", V(0.23, 0.13, 0.12), F(side * 0.54, -0.38, -0.59), steel, M.Metal)
	end
	if id == "Starter" then
		local canvas, fold = rgb(153, 115, 70), rgb(140, 102, 60)
		local rope, thread = rgb(222, 196, 145), rgb(235, 211, 166)
		-- Overlapping soft volumes give the sack a heavy belly and pinched shoulders.
		ball("CanvasPouch", V(1.62, 1.75, 0.98), F(0, -0.24, 0), canvas, M.Fabric)
		ball("CanvasShoulders", V(1.16, 1.12, 0.77), F(0, 0.28, 0), canvas, M.Fabric)
		ball("GatheredNeck", V(0.65, 0.5, 0.51), F(0, 0.69, 0), fold, M.Fabric)
		-- A recessed mouth and splayed pleats replace the solid rectangular top.
		ball("MouthInset", V(0.5, 0.055, 0.36), F(0, 1.025, 0), rgb(92, 65, 39), M.Fabric)
		for i = 0, 7 do
			local angle = i * math.pi / 4
			local x, z = math.cos(angle), math.sin(angle)
			ball(
				"MouthPleat",
				V(0.2, 0.43, 0.18),
				F(x * 0.27, 0.9 + 0.025 * x, z * 0.2) * CFrame.Angles(z * 0.25, -angle, -x * 0.25),
				if i % 2 == 0 then rgb(171, 132, 84) else canvas,
				M.Fabric
			)
		end
		for _, side in { -1, 1 } do
			ball(
				"CanvasFold",
				V(0.15, 0.76, 0.11),
				F(side * 0.37, 0.32, 0.29) * CFrame.Angles(-0.22, 0, side * 0.36),
				fold,
				M.Fabric
			)
			ball(
				"LowerFold",
				V(0.12, 0.42, 0.09),
				F(side * 0.5, -0.65, 0.25) * CFrame.Angles(0.3, side * 0.4, side * -0.4),
				fold,
				M.Fabric
			)
		end
		-- Short round rope segments form a continuous cinch, open bow loops and tails.
		local function cord(name, points, width)
			for i = 1, #points - 1 do
				local a, b = points[i], points[i + 1]
				cylinder(
					name,
					width / 2,
					(b - a).Magnitude + width * 0.3,
					CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(math.pi / 2, 0, 0),
					rope,
					M.Fabric
				)
			end
		end
		local cinch = {}
		for i = 0, 12 do
			local angle = i * math.pi / 6
			table.insert(cinch, V(math.cos(angle) * 0.34, 0.67, math.sin(angle) * 0.27))
		end
		cord("RopeCinch", cinch, 0.065)
		for _, side in { -1, 1 } do
			cord("RopeBow", {
				V(0, 0.67, 0.33),
				V(side * 0.23, 0.83, 0.37),
				V(side * 0.42, 0.85, 0.39),
				V(side * 0.49, 0.74, 0.4),
				V(side * 0.36, 0.65, 0.4),
				V(side * 0.16, 0.64, 0.37),
				V(0, 0.67, 0.33),
			}, 0.06)
			local tip = V(side * 0.25, if side == -1 then 0.09 else 0.18, 0.49)
			cord("RopeTail", {
				V(side * 0.04, 0.65, 0.35),
				V(side * 0.14, 0.47, 0.43),
				V(side * 0.17, 0.27, 0.48),
				tip,
			}, 0.06)
			ball("RopeEnd", V(0.085, 0.1, 0.08), F(tip), rope, M.Fabric)
		end
		ball("RopeKnot", V(0.2, 0.15, 0.14), F(0, 0.67, 0.37), thread, M.Fabric)
		local patch = F(0.23, -0.44, 0.456) * CFrame.Angles(0.1, 0.14, -0.14)
		panel("CanvasPatch", V(0.42, 0.36, 0.045), patch, rgb(184, 145, 91), M.Fabric, 0.045)
		for _, side in { -1, 1 } do
			for i = -1, 1 do
				part("PatchStitch", V(0.07, 0.022, 0.025), patch * F(side * 0.18, i * 0.1, 0.03), thread, M.Fabric)
				part("PatchStitch", V(0.022, 0.07, 0.025), patch * F(i * 0.12, side * 0.15, 0.03), thread, M.Fabric)
			end
			-- Curved side seams follow the rounded pouch instead of floating above it.
			local seam = {}
			for i = 0, 8 do
				local angle = -1.12 + i * 0.26
				table.insert(
					seam,
					V(side * 0.7 * math.cos(angle), -0.24 + 0.88 * math.sin(angle), 0.25 * math.cos(angle))
				)
			end
			cord("CanvasSeam", seam, 0.025)
		end
	elseif id == "Satchel" then
		panel("LeatherPiping", V(1.73, 1.73, 0.77), F(0, -0.1, 0), leather, M.Fabric)
		panel("LeatherCase", V(1.65, 1.65, 0.79), F(0, -0.1, 0), rgb(119, 70, 40), M.Fabric)
		panel("Flap", V(1.74, 0.7, 0.15), F(0, 0.5, 0.46), rgb(155, 95, 53), M.Fabric)
		part("ClaspStrap", V(0.19, 0.8, 0.07), F(0, 0.22, 0.57), leather, M.Fabric)
		buckle(F(0, 0.13, 0.64), 0.27)
		carryHandle(F(0, 0.85, 0), 0.65, leather)
		for _, side in { -1, 1 } do
			part("Stitching", V(0.035, 1.38, 0.03), F(side * 0.73, -0.13, 0.4), rgb(226, 190, 126), M.Fabric)
		end
		part("BottomStitching", V(1.4, 0.035, 0.03), F(0, -0.82, 0.41), rgb(226, 190, 126), M.Fabric)
		rivet(-0.69, 0.67, 0.56)
		rivet(0.69, 0.67, 0.56)
	elseif id == "Tackle" then
		panel("SteelCase", V(1.9, 1.4, 0.9), F(0, -0.12, 0), rgb(158, 57, 48), M.Metal, 0.12)
		part("LidGasket", V(1.94, 0.06, 0.94), F(0, 0.51, 0), steel, M.SmoothPlastic)
		panel("Lid", V(1.98, 0.24, 0.98), F(0, 0.65, 0), rgb(196, 73, 57), M.Metal, 0.09)
		part("CarryHandle", V(0.85, 0.12, 0.12), F(0, 0.96, 0), steel, M.Metal)
		for _, side in { -1, 1 } do
			part("HandleMount", V(0.1, 0.3, 0.12), F(side * 0.37, 0.85, 0), steel, M.Metal)
			part("Latch", V(0.19, 0.4, 0.12), F(side * 0.6, 0.35, 0.53), brass, M.Metal)
			part("CornerGuard", V(0.16, 1.4, 0.94), F(side * 0.91, -0.12, 0), steel, M.Metal)
			rivet(side * 0.9, -0.65, 0.5)
			rivet(side * 0.6, 0.37, 0.61)
		end
		panel("TackleBadge", V(0.6, 0.28, 0.06), F(0, -0.03, 0.48), rgb(238, 220, 172), M.Metal, 0.04)
		for _, y in { -0.4, -0.57 } do
			part("PressedRib", V(1.25, 0.045, 0.06), F(0, y, 0.47), rgb(119, 42, 38), M.Metal)
		end
	elseif id == "Creel" then
		panel("Basket", V(1.8, 1.65, 0.95), F(0, -0.12, 0), rgb(163, 123, 62), M.Wood, 0.2)
		for y = -0.8, 0.6, 0.2 do
			part("WickerWeft", V(1.88, 0.07, 1.01), F(0, y, 0), rgb(215, 177, 104), M.Wood)
		end
		for x = -0.8, 0.8, 0.2 do
			part("WickerWarp", V(0.07, 1.6, 0.06), F(x, -0.12, 0.53), rgb(115, 80, 39), M.Wood)
		end
		for _, side in { -1, 1 } do
			for _, z in { -0.3, 0, 0.3 } do
				part("SideWeave", V(0.055, 1.4, 0.07), F(side * 0.92, -0.1, z), rgb(115, 80, 39), M.Wood)
			end
		end
		part("BasketRim", V(1.94, 0.16, 1.04), F(0, 0.67, 0), rgb(92, 63, 34), M.Wood)
		panel("WoodenLid", V(1.96, 0.17, 1.06), F(0, 0.8, 0), rgb(104, 73, 39), M.WoodPlanks, 0.06)
		part("LidStrap", V(0.2, 0.65, 0.1), F(0, 0.45, 0.59), leather, M.Fabric)
		buckle(F(0, 0.3, 0.66), 0.24)
		carryHandle(F(0, 0.98, 0), 0.6, leather)
	elseif id == "Cooler" then
		panel("InsulatedBody", V(1.85, 1.65, 0.95), F(0, -0.15, 0), rgb(55, 139, 182), M.SmoothPlastic, 0.16)
		panel("WhiteLid", V(2, 0.25, 1.08), F(0, 0.8, 0), rgb(226, 239, 233), M.SmoothPlastic, 0.09)
		part("LidSeam", V(1.96, 0.07, 1.04), F(0, 0.64, 0), steel, M.SmoothPlastic)
		for _, side in { -1, 1 } do
			part("SideHandle", V(0.14, 0.55, 0.48), F(side * 1.01, 0.25, 0), rgb(229, 238, 235), M.SmoothPlastic)
		end
		panel("CoolerFoot", V(1.9, 0.21, 1), F(0, -0.93, 0), rgb(30, 83, 110), M.SmoothPlastic, 0.08)
		for _, side in { -1, 1 } do
			part("LidLatch", V(0.19, 0.35, 0.12), F(side * 0.64, 0.54, 0.56), rgb(230, 238, 231), M.SmoothPlastic)
			part("MouldedRib", V(0.07, 0.8, 0.055), F(side * 0.65, -0.2, 0.49), rgb(79, 164, 200), M.SmoothPlastic)
		end
		cylinder(
			"EmblemInset",
			0.38,
			0.055,
			F(0, -0.12, 0.51) * CFrame.Angles(math.pi / 2, 0, 0),
			rgb(37, 109, 151),
			M.SmoothPlastic
		)
		for i = 0, 2 do
			part(
				"SnowflakeArm",
				V(0.055, 0.53, 0.04),
				F(0, -0.12, 0.56) * CFrame.Angles(0, 0, i * math.pi / 3),
				rgb(231, 246, 255),
				M.SmoothPlastic
			)
		end
		cylinder("DrainPlug", 0.075, 0.08, F(0.72, -0.73, 0.52) * CFrame.Angles(math.pi / 2, 0, 0), steel, M.Metal)
	elseif id == "Beacon" then
		cylinder("LanternBase", 0.76, 0.22, F(0, -0.95, 0), brass, M.Metal)
		cylinder("LanternCap", 0.83, 0.2, F(0, 0.92, 0), steel, M.Metal)
		cylinder("LanternCrown", 0.42, 0.3, F(0, 1.15, 0), brass, M.Metal)
		cylinder("LanternGlass", 0.57, 1.55, F(), rgb(239, 202, 128), M.Glass, 0.72)
		cylinder("WarmCore", 0.24, 1.1, F(0, -0.08, 0), rgb(255, 216, 123), M.Neon)
		cylinder("Burner", 0.34, 0.18, F(0, -0.71, 0), steel, M.Metal)
		cylinder("CapStep", 0.65, 0.14, F(0, 1.07, 0), brass, M.Metal)
