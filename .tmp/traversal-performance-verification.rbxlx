		-- Twin azimuth thrusters turn it on the spot.
		IdleSteering = 0.8,
		MaxBankAngle = 8,
		EngineSoundId = "rbxassetid://6667206432",
		Length = 30,
		Beam = 13.4,
		Seats = 3,
		DriverSeat = "HelmSeat",
		Hold = fishingHold,
		StarterParts = table.freeze({
			table.freeze({ PartId = "Engine", X = 3, Y = 11, R = 0 }),
			table.freeze({ PartId = "Lantern", X = 4, Y = 1, R = 0 }),
		}),
	}),
})
]]></string>
