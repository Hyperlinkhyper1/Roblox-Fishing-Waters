        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Binnacle</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material

	-- Plinth and pedestal
	kit.block("Plinth", Vector3.new(1.3, 0.2, 1.3), CFrame.new(0, 0.1, 0), P.DarkWood, M.Wood)
	kit.cylinder("Foot", 1.0, 0.22, CFrame.new(0, 0.31, 0), P.Teak, M.Wood)
	kit.cylinder("FootRing", 0.82, 0.12, CFrame.new(0, 0.48, 0), P.Brass, M.Metal)
	kit.cylinder("Column", 0.62, 1.86, CFrame.new(0, 1.47, 0), P.Teak, M.Wood)
	kit.cylinder("ColumnBand", 0.66, 0.08, CFrame.new(0, 1.0, 0), P.Brass, M.Metal)
	kit.cylinder("ColumnBand", 0.66, 0.08, CFrame.new(0, 2.0, 0), P.Brass, M.Metal)
	kit.cylinder("Neck", 0.84, 0.16, CFrame.new(0, 2.48, 0), P.DarkWood, M.Wood)

	-- Flinders bar on the front of the column
	kit.cylinder("FlindersBar", 0.16, 0.9, CFrame.new(0, 1.5, -0.36), P.Brass, M.Metal)
	kit.ball("FlindersCap", 0.18, CFrame.new(0, 1.95, -0.36), P.Brass, M.Metal)

	-- Compass bowl, card and glass dome with a hood
	kit.cylinder("CompassHousing", 0.8, 0.34, CFrame.new(0, 2.73, 0), P.Brass, M.Metal)
	kit.cylinder("CompassRim", 0.86, 0.06, CFrame.new(0, 2.92, 0), Color3.fromRGB(170, 128, 50), M.Metal)
	kit.cylinder("Card", 0.66, 0.04, CFrame.new(0, 2.94, 0), P.Cream, M.SmoothPlastic)
	kit.block("Needle", Vector3.new(0.06, 0.02, 0.5), CFrame.new(0, 2.97, 0), P.Red, M.SmoothPlastic)
	kit.ball("Dome", 0.7, CFrame.new(0, 2.94, 0), Color3.fromRGB(170, 210, 225), M.Glass)
	kit.cylinder("HoodRing", 0.4, 0.08, CFrame.new(0, 3.3, 0), P.Brass, M.Metal)
	kit.ball("Finial", 0.2, CFrame.new(0, 3.42, 0), P.Brass, M.Metal)

	-- Brass correcting spheres on arms
	for _, side in { -1, 1 } do
		kit.block("SphereArm", Vector3.new(0.36, 0.08, 0.14), CFrame.new(side * 0.52, 2.6, 0), P.Brass, M.Metal)
		kit.ball("Corrector", 0.42, CFrame.new(side * 0.58, 2.6, 0), P.Brass, M.Metal)
	end

	-- Small binnacle lamp glowing on the side of the bowl
	local lamp = kit.ball("Lamp", 0.12, CFrame.new(0, 2.78, -0.42), P.Glow, M.Neon)
	kit.light(lamp, P.Glow, 6, 0.8)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">BistroSet</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material
	local iron = Color3.fromRGB(38, 40, 44)

	-- Little round café table with a marble top.
	kit.cylinder("TableTop", 1.9, 0.1, CFrame.new(0, 2.35, 0), Color3.fromRGB(232, 228, 220), M.Marble)
	kit.cylinder("TableRim", 1.96, 0.06, CFrame.new(0, 2.28, 0), iron, M.Metal)
	kit.cylinder("TableColumn", 0.16, 2.2, CFrame.new(0, 1.15, 0), iron, M.Metal)
	kit.ball("TableKnot", 0.32, CFrame.new(0, 0.9, 0), iron, M.Metal)
	kit.cylinder("TableFoot", 1.0, 0.1, CFrame.new(0, 0.05, 0), iron, M.Metal)

	-- A tiny vase with a flower.
	kit.cylinder("Vase", 0.2, 0.3, CFrame.new(0.2, 2.55, 0.15), P.Teal, M.Glass)
	kit.ball("Flower", 0.22, CFrame.new(0.2, 2.8, 0.15), P.Red, M.SmoothPlastic)
	kit.cylinder("Saucer", 0.36, 0.03, CFrame.new(-0.35, 2.415, -0.2), P.White, M.SmoothPlastic)
	kit.cylinder("Cup", 0.2, 0.18, CFrame.new(-0.35, 2.52, -0.2), P.White, M.SmoothPlastic)

	-- Two matching chairs facing the table from left and right.
	local function chair(tag, s)
		local cx = 1.6 * s
		kit.cylinder(tag .. "Pan", 1.1, 0.08, CFrame.new(cx, 1.42, 0), iron, M.Metal)
		kit.cylinder(tag .. "Cushion", 1.0, 0.12, CFrame.new(cx, 1.52, 0), P.Red, M.Fabric)
		for i, c in { { -1, -1 }, { -1, 1 }, { 1, -1 }, { 1, 1 } } do
			local top = Vector3.new(cx + c[1] * 0.3, 1.4, c[2] * 0.3)
			local foot = Vector3.new(cx + c[1] * 0.45, 0.02, c[2] * 0.45)
			kit.beam(tag .. "Leg" .. i, top, foot, 0.08, 0.08, iron, M.Metal)
		end
		-- Back on the outer side, leaning out slightly.
		local bx = cx + 0.48 * s
		kit.beam(tag .. "BackPostA", Vector3.new(bx, 1.45, -0.35), Vector3.new(bx + 0.1 * s, 3.1, -0.38), 0.08, 0.08, iron, M.Metal)
		kit.beam(tag .. "BackPostB", Vector3.new(bx, 1.45, 0.35), Vector3.new(bx + 0.1 * s, 3.1, 0.38), 0.08, 0.08, iron, M.Metal)
		kit.block(tag .. "BackRail", Vector3.new(0.1, 0.32, 0.86), CFrame.new(bx + 0.09 * s, 2.92, 0) * CFrame.Angles(0, 0, -0.06 * s), P.Red, M.SmoothPlastic)
		kit.block(tag .. "BackBand", Vector3.new(0.06, 0.08, 0.74), CFrame.new(bx + 0.05 * s, 2.3, 0), iron, M.Metal)
	end
	chair("Left", -1)
	chair("Right", 1)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">CaptainsTable</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material
	local varnish = Color3.fromRGB(122, 74, 40)

	-- Top: varnished round slab with a brass edge band.
	kit.cylinder("Tabletop", 3.9, 0.18, CFrame.new(0, 2.61, 0), varnish, M.Wood)
	kit.cylinder("TopBand", 3.96, 0.08, CFrame.new(0, 2.5, 0), P.Brass, M.Metal)
	kit.cylinder("Apron", 3.2, 0.14, CFrame.new(0, 2.4, 0), P.DarkWood, M.Wood)

	-- Chart pinned on top, slightly askew.
	local chartFrame = CFrame.new(0.05, 2.715, 0.05) * CFrame.Angles(0, math.rad(12), 0)
	kit.block("Chart", Vector3.new(2.2, 0.03, 1.5), chartFrame, P.Cream, M.SmoothPlastic)
	kit.block("ChartSea", Vector3.new(1.0, 0.012, 1.3), chartFrame * CFrame.new(-0.5, 0.02, 0), Color3.fromRGB(150, 196, 214), M.SmoothPlastic)
	kit.block("ChartIsle", Vector3.new(0.4, 0.016, 0.3), chartFrame * CFrame.new(0.55, 0.022, 0.3), Color3.fromRGB(198, 178, 120), M.SmoothPlastic)
	kit.beam("ChartRouteA", (chartFrame * CFrame.new(-0.8, 0.035, -0.45)).Position, (chartFrame * CFrame.new(-0.05, 0.035, 0.05)).Position, 0.04, 0.012, P.Red, M.SmoothPlastic)
	kit.beam("ChartRouteB", (chartFrame * CFrame.new(-0.05, 0.035, 0.05)).Position, (chartFrame * CFrame.new(0.5, 0.035, 0.3)).Position, 0.04, 0.012, P.Red, M.SmoothPlastic)
	for i, c in { { -1.02, -0.67 }, { 1.02, -0.67 }, { -1.02, 0.67 }, { 1.02, 0.67 } } do
		kit.ball("ChartPin" .. i, 0.12, chartFrame * CFrame.new(c[1], 0.04, c[2]), P.Brass, M.Metal)
	end
	-- Brass dividers lying beside the chart.
	kit.beam("DividerA", Vector3.new(-1.1, 2.73, -0.95), Vector3.new(-0.55, 2.73, -1.35), 0.05, 0.03, P.Brass, M.Metal)
	kit.beam("DividerB", Vector3.new(-1.1, 2.73, -0.95), Vector3.new(-0.45, 2.73, -1.15), 0.05, 0.03, P.Brass, M.Metal)

	-- Heavy turned pedestal.
	kit.cylinder("PedestalCollar", 0.9, 0.2, CFrame.new(0, 2.25, 0), P.DarkWood, M.Wood)
	kit.cylinder("PedestalColumn", 0.55, 1.75, CFrame.new(0, 1.3, 0), varnish, M.Wood)
	kit.ball("PedestalBulb", 0.95, CFrame.new(0, 1.0, 0), varnish, M.Wood)
	kit.cylinder("PedestalRing", 0.7, 0.1, CFrame.new(0, 1.65, 0), P.Brass, M.Metal)
	kit.cylinder("PedestalBase", 1.15, 0.45, CFrame.new(0, 0.42, 0), P.DarkWood, M.Wood)

	-- Four splayed claw feet.
	for i = 1, 4 do
		local yaw = CFrame.Angles(0, math.rad(45 + 90 * (i - 1)), 0)
		kit.block("Foot" .. i, Vector3.new(0.38, 0.32, 1.25), yaw * CFrame.new(0, 0.2, -0.95), P.DarkWood, M.Wood)
		kit.ball("FootToe" .. i, 0.3, yaw * CFrame.new(0, 0.15, -1.55), P.Brass, M.Metal)
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">CargoCrates</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material
	local pine = Color3.fromRGB(196, 150, 96)
	local pine2 = Color3.fromRGB(170, 124, 76)
	local batten = Color3.fromRGB(120, 82, 48)
	local strap = Color3.fromRGB(226, 118, 34)

	-- pallet
	kit.block("PalletDeck", Vector3.new(3.5, 0.12, 3.5), CFrame.new(0, 0.24, 0), P.Wood, M.WoodPlanks)
	for _, z in { -1.45, 0, 1.45 } do
		kit.block("PalletRunner", Vector3.new(3.5, 0.18, 0.4), CFrame.new(0, 0.09, z), P.DarkWood, M.Wood)
	end

	-- bottom row: two long crates
	kit.block("CrateLeft", Vector3.new(1.7, 1.5, 3.2), CFrame.new(-0.87, 1.05, 0), pine, M.WoodPlanks)
	kit.block("CrateRight", Vector3.new(1.7, 1.5, 3.2), CFrame.new(0.87, 1.05, 0), pine2, M.WoodPlanks)
	-- left crate front battens + stencil
	kit.block("Batten", Vector3.new(0.16, 1.5, 0.06), CFrame.new(-1.64, 1.05, -1.62), batten, M.Wood)
	kit.block("Batten", Vector3.new(0.16, 1.5, 0.06), CFrame.new(-0.1, 1.05, -1.62), batten, M.Wood)
	kit.block("Stencil", Vector3.new(0.7, 0.36, 0.03), CFrame.new(-1.1, 1.25, -1.615), P.Red, M.SmoothPlastic)
	kit.block("StencilBar", Vector3.new(0.7, 0.08, 0.03), CFrame.new(-1.1, 0.88, -1.615), P.Red, M.SmoothPlastic)
	-- right crate: X-braced front + navy stencil
	kit.beam("Brace", Vector3.new(0.12, 0.42, -1.63), Vector3.new(1.62, 1.68, -1.63), 0.14, 0.05, batten, M.Wood)
	kit.beam("Brace", Vector3.new(0.12, 1.68, -1.63), Vector3.new(1.62, 0.42, -1.63), 0.14, 0.05, batten, M.Wood)
	kit.block("Stencil", Vector3.new(1.1, 0.24, 0.03), CFrame.new(-0.87, 1.6, 1.615), P.Navy, M.SmoothPlastic)
	kit.block("SideStencil", Vector3.new(0.03, 0.5, 1.4), CFrame.new(1.735, 1.1, 0), P.Navy, M.SmoothPlastic)

	-- top crate
	kit.block("CrateTop", Vector3.new(2.2, 1.3, 2.0), CFrame.new(-0.45, 2.45, 0.2), pine, M.WoodPlanks)
	kit.block("TopStencil", Vector3.new(0.7, 0.5, 0.03), CFrame.new(-1.0, 2.5, -0.815), P.Navy, M.SmoothPlastic)
	kit.block("TopLid", Vector3.new(2.26, 0.1, 2.06), CFrame.new(-0.45, 3.13, 0.2), batten, M.Wood)

	-- small crate, slightly turned
	local small = CFrame.new(1.22, 2.2, -0.8) * CFrame.Angles(0, 0.25, 0)
	kit.block("CrateSmall", Vector3.new(0.9, 0.8, 0.9), small, P.Cream, M.WoodPlanks)
	kit.block("SmallStencil", Vector3.new(0.5, 0.2, 0.03), small * CFrame.new(0, 0.05, -0.465), P.Red, M.SmoothPlastic)

	-- cargo strap over the top crate, down to the pallet front and back
	local x = -0.45
	local w, t = 0.32, 0.05
	kit.block("StrapTop", Vector3.new(w, t, 2.12), CFrame.new(x, 3.205, 0.2), strap, M.Fabric)
	kit.block("StrapFrontHigh", Vector3.new(w, 1.42, t), CFrame.new(x, 2.5, -0.83), strap, M.Fabric)
	kit.block("StrapFrontStep", Vector3.new(w, t, 0.86), CFrame.new(x, 1.825, -1.23), strap, M.Fabric)
	kit.block("StrapFrontLow", Vector3.new(w, 1.56, t), CFrame.new(x, 1.06, -1.635), strap, M.Fabric)
	kit.block("StrapBackHigh", Vector3.new(w, 1.42, t), CFrame.new(x, 2.5, 1.23), strap, M.Fabric)
	kit.block("StrapBackStep", Vector3.new(w, t, 0.42), CFrame.new(x, 1.825, 1.42), strap, M.Fabric)
	kit.block("StrapBackLow", Vector3.new(w, 1.56, t), CFrame.new(x, 1.06, 1.635), strap, M.Fabric)
	kit.block("Buckle", Vector3.new(0.4, 0.3, 0.08), CFrame.new(x, 1.2, -1.67), P.Steel, M.Metal)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">CoffeeTable</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material

	-- Low top with a darker edge frame (surface at y 1.06, leaving room for drinks).
	kit.block("TopFrame", Vector3.new(3.6, 0.12, 2.2), CFrame.new(0, 0.95, 0), P.DarkWood, M.Wood)
	kit.block("TopPanel", Vector3.new(3.3, 0.06, 1.9), CFrame.new(0, 1.03, 0), P.Teak, M.WoodPlanks)
	kit.block("ApronFront", Vector3.new(3.0, 0.18, 0.08), CFrame.new(0, 0.8, -0.88), P.DarkWood, M.Wood)
	kit.block("ApronBack", Vector3.new(3.0, 0.18, 0.08), CFrame.new(0, 0.8, 0.88), P.DarkWood, M.Wood)

	-- Legs.
	for i, c in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
		kit.block("Leg" .. i, Vector3.new(0.22, 0.89, 0.22), CFrame.new(c[1] * 1.6, 0.445, c[2] * 0.9), P.DarkWood, M.Wood)
	end

	-- Lower shelf.
	kit.block("Shelf", Vector3.new(3.2, 0.08, 1.8), CFrame.new(0, 0.22, 0), P.Teak, M.WoodPlanks)

	-- Tackle magazines on the shelf.
	kit.block("MagazineA", Vector3.new(0.75, 0.05, 1.0), CFrame.new(-0.8, 0.285, 0.1) * CFrame.Angles(0, 0.15, 0), P.Navy, M.SmoothPlastic)
	kit.block("MagazineB", Vector3.new(0.75, 0.05, 1.0), CFrame.new(-0.75, 0.335, 0.05) * CFrame.Angles(0, -0.2, 0), P.Red, M.SmoothPlastic)
	kit.block("MagazineC", Vector3.new(0.75, 0.05, 1.0), CFrame.new(-0.82, 0.385, 0.08) * CFrame.Angles(0, 0.05, 0), P.Cream, M.SmoothPlastic)
	-- Tackle box.
	kit.block("TackleBox", Vector3.new(0.9, 0.3, 0.55), CFrame.new(0.75, 0.41, 0.1), P.Green, M.SmoothPlastic)
	kit.block("TackleLid", Vector3.new(0.94, 0.07, 0.59), CFrame.new(0.75, 0.595, 0.1), Color3.fromRGB(52, 104, 56), M.SmoothPlastic)
	kit.block("TackleHandle", Vector3.new(0.3, 0.05, 0.08), CFrame.new(0.75, 0.655, 0.1), P.Steel, M.Metal)

	-- Drinks and a magazine on top.
	kit.cylinder("Mug", 0.28, 0.27, CFrame.new(0.9, 1.195, -0.35), P.White, M.SmoothPlastic)
	kit.cylinder("Coffee", 0.22, 0.02, CFrame.new(0.9, 1.325, -0.35), Color3.fromRGB(70, 42, 24), M.SmoothPlastic)
	kit.block("MugHandle", Vector3.new(0.08, 0.15, 0.05), CFrame.new(1.08, 1.2, -0.35), P.White, M.SmoothPlastic)
	kit.block("TopMagazine", Vector3.new(0.8, 0.04, 1.05), CFrame.new(-0.7, 1.08, 0.05) * CFrame.Angles(0, -0.25, 0), P.Teal, M.SmoothPlastic)
	kit.cylinder("Bottle", 0.18, 0.3, CFrame.new(0.35, 1.21, 0.45), Color3.fromRGB(60, 120, 70), M.Glass)
	kit.cylinder("BottleNeck", 0.08, 0.04, CFrame.new(0.35, 1.38, 0.45), Color3.fromRGB(60, 120, 70), M.Glass)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">DeckBench</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local W = kit.Material.Wood
	local XL = 2.22
	local ZF, ZB = -0.62, 0.66
	local L = 0.22

	for _, s in { -1, 1 } do
		local side = s < 0 and "L" or "R"
		local x = XL * s
		-- Front leg runs up to the armrest, back leg becomes the backrest post.
		kit.block("FrontLeg" .. side, Vector3.new(L, 1.85, L), CFrame.new(x, 0.12 + 1.85 / 2, ZF), P.Teak, W)
		kit.block("BackPost" .. side, Vector3.new(L, 2.6, L), CFrame.new(x, 0.12 + 1.3, ZB), P.Teak, W)
		kit.block("FootCapF" .. side, Vector3.new(0.27, 0.12, 0.27), CFrame.new(x, 0.06, ZF), P.Brass, kit.Material.Metal)
		kit.block("FootCapB" .. side, Vector3.new(0.27, 0.12, 0.27), CFrame.new(x, 0.06, ZB), P.Brass, kit.Material.Metal)
		kit.ball("PostKnob" .. side, 0.3, CFrame.new(x, 2.84, ZB), P.Brass, kit.Material.Metal)
		kit.block("Armrest" .. side, Vector3.new(0.3, 0.12, 1.65), CFrame.new(x, 2.03, -0.02), P.Teak, W)
		kit.block("SideApron" .. side, Vector3.new(0.14, 0.2, ZB - ZF), CFrame.new(x, 1.22, (ZF + ZB) / 2), P.DarkWood, W)
	end

	-- Aprons and stretcher.
	kit.block("FrontApron", Vector3.new(XL * 2 - L, 0.2, 0.12), CFrame.new(0, 1.22, ZF), P.DarkWood, W)
	kit.block("BackApron", Vector3.new(XL * 2 - L, 0.2, 0.12), CFrame.new(0, 1.22, ZB), P.DarkWood, W)
	kit.block("Stretcher", Vector3.new(XL * 2 - L, 0.12, 0.12), CFrame.new(0, 0.45, (ZF + ZB) / 2), P.DarkWood, W)

	-- Seat slats.
	for i = 0, 3 do
		kit.block("BenchSlat" .. i, Vector3.new(XL * 2 - L, 0.12, 0.28), CFrame.new(0, 1.38, -0.6 + i * 0.37), P.Teak, W)
	end

	-- Backrest slats, leaning back slightly between the posts.
	for i = 0, 2 do
		local y = 1.75 + i * 0.36
		kit.block("BackSlat" .. i, Vector3.new(XL * 2 - L, 0.26, 0.08), CFrame.new(0, y, ZB - 0.1 + i * 0.03) * CFrame.Angles(math.rad(-8), 0, 0), P.Teak, W)
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">DeckChair</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local W = kit.Material.Wood
	local R = 0.14 -- rail thickness
	local XR = 0.95 -- rail centre line

	-- Pivot points (side view, y/z)
	local backFoot = Vector3.new(0, 0.08, -0.15)
	local backTop = Vector3.new(0, 3.08, 1.5)
	local frontFoot = Vector3.new(0, 0.08, -1.6)
	local frontTop = Vector3.new(0, 1.42, -1.25)
	local seatBack = Vector3.new(0, 1.12, 0.5)
	local propFoot = Vector3.new(0, 0.08, 1.58)
	local propTop = Vector3.new(0, 1.08, 0.62)

	for _, s in { -1, 1 } do
		local x = Vector3.new(XR * s, 0, 0)
		local side = s < 0 and "L" or "R"
		kit.beam("BackRail" .. side, backFoot + x, backTop + x, R, R, P.Teak, W)
		kit.beam("FrontLeg" .. side, frontFoot + x, frontTop + x, R, R, P.Teak, W)
		kit.beam("SideRail" .. side, frontTop + x, seatBack + x, R, R, P.Teak, W)
		kit.beam("PropLeg" .. side, propFoot + x, propTop + x, R, R, P.Teak, W)
		kit.cylinder("Hinge" .. side, 0.12, 0.08, CFrame.new(XR * s + 0.1 * s, 1.1, 0.56) * CFrame.Angles(0, 0, math.pi / 2), P.Brass, kit.Material.Metal)
	end

	local function crossbar(name, pos, d)
		kit.cylinder(name, d, XR * 2 + R, CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2), P.DarkWood, W)
	end
	crossbar("TopBar", backTop - Vector3.new(0, 0.02, 0.03), 0.13)
	crossbar("FrontBar", frontTop, 0.13)
	crossbar("FrontStretcher", Vector3.new(0, 0.45, -1.5), 0.1)
	crossbar("RearStretcher", Vector3.new(0, 0.42, 1.4), 0.1)

	-- Striped canvas sling sagging from the top bar to the front bar.
	local top = Vector3.new(0, 3.0, 1.42)
	local sag = Vector3.new(0, 0.82, 0.05)
	local front = Vector3.new(0, 1.42, -1.16)
	local stripes = { P.Red, P.Cream, P.Red }
	for i, c in stripes do
		local o = Vector3.new((i - 2) * 0.56, 0, 0)
		kit.beam("SlingBack" .. i, top + o, sag + o, 0.56, 0.05, c, kit.Material.Fabric)
		kit.beam("SlingSeat" .. i, sag + o, front + o, 0.56, 0.05, c, kit.Material.Fabric)
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">DeckTorch</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material
	local bamboo = Color3.fromRGB(204, 178, 104)
	local node = Color3.fromRGB(160, 132, 70)

	-- Heavy wooden foot with three splayed bamboo braces.
	kit.cylinder("TorchFoot", 0.95, 0.2, CFrame.new(0, 0.1, 0), P.DarkWood, M.Wood)
	for i = 0, 2 do
		local a = i * math.pi * 2 / 3
		local out = Vector3.new(math.sin(a), 0, -math.cos(a))
		kit.beam("TorchBrace" .. i, out * 0.36 + Vector3.new(0, 0.2, 0), Vector3.new(0, 1.1, 0) + out * 0.08, 0.09, 0.09, node, M.Wood)
	end

	-- Bamboo pole in segments.
	kit.cylinder("TorchPole", 0.22, 4.1, CFrame.new(0, 2.25, 0), bamboo, M.Wood)
	for i, y in { 1.3, 2.4, 3.4 } do
		kit.cylinder("TorchNode" .. i, 0.28, 0.08, CFrame.new(0, y, 0), node, M.Wood)
	end
	kit.cylinder("TorchLashing", 0.3, 0.22, CFrame.new(0, 4.12, 0), P.Rope, M.Fabric)

	-- Woven canister cup.
	kit.cylinder("TorchCupNeck", 0.34, 0.2, CFrame.new(0, 4.34, 0), P.Rope, M.Fabric)
	kit.cylinder("TorchCup", 0.54, 0.46, CFrame.new(0, 4.66, 0), Color3.fromRGB(176, 140, 86), M.Fabric)
	kit.cylinder("TorchCupWeave", 0.58, 0.07, CFrame.new(0, 4.6, 0), P.DarkWood, M.Fabric)
	kit.cylinder("TorchRim", 0.6, 0.07, CFrame.new(0, 4.9, 0), P.Iron, M.Metal)
	kit.cylinder("TorchWick", 0.14, 0.12, CFrame.new(0, 4.98, 0), P.Iron, M.Metal)

	-- Flame.
	local flame = kit.ball("TorchFlame", 0.34, CFrame.new(0, 5.15, 0), P.Flame, M.Neon)
	kit.ball("TorchFlameTip", 0.2, CFrame.new(0, 5.36, 0), P.Glow, M.Neon)
	kit.light(flame, P.Flame, 14, 1.5)
	kit.fire(flame, P.Flame, 1.5)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">FightingChair</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material
	local up = CFrame.Angles(0, 0, math.pi / 2) -- cylinder axis along X

	-- Pedestal on a bolted deck plate
	kit.cylinder("BasePlate", 1.7, 0.16, CFrame.new(0, 0.08, 0.45), P.Steel, M.DiamondPlate)
	kit.cylinder("Pedestal", 0.6, 1.5, CFrame.new(0, 0.9, 0.45), P.Steel, M.Metal)
	kit.cylinder("SwivelCollar", 0.95, 0.18, CFrame.new(0, 1.65, 0.45), P.Iron, M.Metal)

	-- Chair pan and cushion
	kit.block("ChairPan", Vector3.new(2.2, 0.22, 1.8), CFrame.new(0, 1.85, 0.4), P.Teak, M.Wood)
	kit.block("Cushion", Vector3.new(1.9, 0.28, 1.6), CFrame.new(0, 2.1, 0.38), P.White, M.Fabric)
	kit.block("CushionPiping", Vector3.new(1.95, 0.08, 0.08), CFrame.new(0, 2.1, -0.43), P.Navy, M.Fabric)

	-- Reclined backrest
	local back = CFrame.new(0, 3.0, 1.42) * CFrame.Angles(0.12, 0, 0)
	kit.block("Backrest", Vector3.new(2.2, 2.0, 0.24), back, P.Teak, M.Wood)
	kit.block("BackCushion", Vector3.new(1.9, 1.7, 0.2), back * CFrame.new(0, 0.02, -0.22), P.White, M.Fabric)
	kit.block("BackStripe", Vector3.new(0.35, 1.72, 0.04), back * CFrame.new(0, 0.02, -0.34), P.Navy, M.Fabric)
	kit.cylinder("HeadRoll", 0.34, 2.2, back * CFrame.new(0, 1.0, 0) * up, P.Teak, M.Wood)

	-- Armrests
	for _, s in { -1, 1 } do
		local x = 1.2 * s
		kit.block(s < 0 and "ArmLeft" or "ArmRight", Vector3.new(0.3, 0.14, 1.55), CFrame.new(x, 2.75, 0.4), P.Teak, M.Wood)
		kit.block(s < 0 and "ArmPostLeft" or "ArmPostRight", Vector3.new(0.14, 0.75, 0.14), CFrame.new(x, 2.3, -0.2), P.Steel, M.Metal)
		kit.block(s < 0 and "ArmPadLeft" or "ArmPadRight", Vector3.new(0.24, 0.08, 1.0), CFrame.new(x, 2.86, 0.3), P.Navy, M.Fabric)
	end

	-- Rod gimbal between the knees
	kit.block("GimbalMount", Vector3.new(0.3, 0.2, 0.3), CFrame.new(0, 1.85, -0.62), P.Steel, M.Metal)
	kit.cylinder("Gimbal", 0.34, 0.45, CFrame.new(0, 2.05, -0.68) * CFrame.Angles(-0.4, 0, 0), P.Brass, M.Metal)
	kit.cylinder("GimbalPin", 0.08, 0.42, CFrame.new(0, 2.12, -0.71) * up, P.Iron, M.Metal)

	-- Footrest out front
	kit.beam("FootStrut", Vector3.new(0, 1.15, 0.2), Vector3.new(0, 0.62, -1.4), 0.18, 0.18, P.Steel, M.Metal)
	local plate = CFrame.new(0, 0.62, -1.48) * CFrame.Angles(-0.45, 0, 0)
	kit.block("Footplate", Vector3.new(1.6, 0.1, 0.5), plate, P.Teak, M.WoodPlanks)
	kit.block("FootLip", Vector3.new(1.6, 0.18, 0.08), plate * CFrame.new(0, 0.09, -0.22), P.Steel, M.Metal)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">FirePit</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material

	-- Stone pad on the deck.
	kit.cylinder("Pad", 3.0, 0.12, CFrame.new(0, 0.06, 0), P.Stone, M.Slate)

	-- Ring of eight stones, alternating shade and height.
	for i = 0, 7 do
		local a = i * math.pi / 4 + math.pi / 8
		local h = (i % 2 == 0) and 0.62 or 0.52
		local p = Vector3.new(math.cos(a) * 1.18, 0.12 + h / 2, math.sin(a) * 1.18)
		local color = (i % 2 == 0) and Color3.fromRGB(125, 120, 112) or Color3.fromRGB(95, 92, 88)
		kit.block("Stone", Vector3.new(0.92, h, 0.5), CFrame.lookAt(p, Vector3.new(0, p.Y, 0)), color, M.Cobblestone)
	end

	-- Iron fire bowl inside the ring.
	kit.cylinder("Basin", 1.75, 0.4, CFrame.new(0, 0.32, 0), P.Iron, M.Metal)
	kit.cylinder("BasinRim", 1.85, 0.08, CFrame.new(0, 0.54, 0), Color3.fromRGB(60, 58, 60), M.Metal)

	-- Glowing embers and a few coals.
	local embers = kit.cylinder("Embers", 1.5, 0.08, CFrame.new(0, 0.56, 0), P.Flame, M.Neon)
	kit.light(embers, P.Flame, 12, 2)
	kit.fire(embers, P.Flame, 2.5)
	kit.ball("Coal", 0.3, CFrame.new(0.45, 0.62, 0.2), Color3.fromRGB(35, 30, 30), M.Basalt)
	kit.ball("Coal", 0.26, CFrame.new(-0.4, 0.62, 0.35), Color3.fromRGB(35, 30, 30), M.Basalt)
	kit.ball("Coal", 0.28, CFrame.new(-0.1, 0.62, -0.5), Color3.fromRGB(35, 30, 30), M.Basalt)

	-- Teepee of four logs.
	local apex = Vector3.new(0, 1.35, 0)
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		local foot = Vector3.new(math.cos(a) * 0.62, 0.62, math.sin(a) * 0.62)
		kit.beam("Log", foot, apex, 0.2, 0.2, P.DarkWood, M.Wood)
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Flagpole</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material
	local px = -1.55

	-- Stepped timber base with a brass collar
	kit.block("Base", Vector3.new(0.86, 0.3, 0.9), CFrame.new(px, 0.15, 0), P.DarkWood, M.WoodPlanks)
	kit.block("BaseStep", Vector3.new(0.64, 0.28, 0.66), CFrame.new(px, 0.44, 0), P.Teak, M.Wood)
	kit.cylinder("Collar", 0.36, 0.2, CFrame.new(px, 0.68, 0), P.Brass, M.Metal)

	-- Pole, truck and gilded finial
	kit.cylinder("Pole", 0.2, 9.0, CFrame.new(px, 5.1, 0), P.White, M.SmoothPlastic)
	kit.cylinder("Truck", 0.3, 0.16, CFrame.new(px, 9.62, 0), P.Brass, M.Metal)
	kit.ball("Finial", 0.34, CFrame.new(px, 9.82, 0), P.Brass, M.Metal)

	-- Halyard down the pole to a cleat
	kit.block("Halyard", Vector3.new(0.04, 7.9, 0.04), CFrame.new(px + 0.13, 5.4, 0.1), P.Rope, M.Fabric)
	kit.block("Cleat", Vector3.new(0.08, 0.36, 0.1), CFrame.new(px + 0.13, 1.45, 0.1), P.Brass, M.Metal)

	-- Flag: three bands across X, in three panels zig-zagging so it reads as waving
	local xs = { px + 0.11, -0.36, 0.77, 1.92 }
	local zs = { 0, 0.16, -0.12, 0.14 }
	local bands = {
		{ y = 9.15, color = P.Red },
		{ y = 8.45, color = P.Cream },
		{ y = 7.75, color = P.Navy },
	}
	for i = 1, 3 do
		local drop = (i - 1) * 0.06
		for b, band in bands do
			local a = Vector3.new(xs[i], band.y - drop, zs[i])
			local c = Vector3.new(xs[i + 1], band.y - drop - 0.06, zs[i + 1])
			kit.beam("Flag" .. i .. "_" .. b, a, c, 0.06, 0.7, band.color, M.Fabric)
		end
	end
	-- Brass star emblem on the hoist side of the cream band
	kit.block("Emblem", Vector3.new(0.34, 0.34, 0.08), CFrame.new(-0.9, 8.42, 0.08) * CFrame.Angles(0, -0.14, math.pi / 4), P.Brass, M.Metal)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">FlowerBarrel</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material

	-- Half barrel with iron hoops
	kit.cylinder("BarrelBody", 1.85, 1.15, CFrame.new(0, 0.575, 0), P.Wood, M.WoodPlanks)
	kit.cylinder("BarrelHoopLow", 1.94, 0.12, CFrame.new(0, 0.22, 0), P.Iron, M.Metal)
	kit.cylinder("BarrelHoopHigh", 1.94, 0.12, CFrame.new(0, 0.95, 0), P.Iron, M.Metal)
	kit.cylinder("BarrelRim", 1.9, 0.08, CFrame.new(0, 1.15, 0), P.DarkWood, M.Wood)

	-- Foliage mound spilling over the rim
	kit.ball("Foliage", 1.45, CFrame.new(0, 1.22, 0), P.Green, M.LeafyGrass)
	local crown = Vector3.new(0.05, 1.75, 0.05)
	kit.ball("FoliageTop", 0.9, CFrame.new(crown), P.Leaf, M.LeafyGrass)

	local red = Color3.fromRGB(220, 50, 60)
	local yellow = Color3.fromRGB(250, 205, 60)
	local pink = Color3.fromRGB(240, 120, 180)
	local white = Color3.fromRGB(246, 244, 236)
	local purple = Color3.fromRGB(150, 90, 200)
	local orange = Color3.fromRGB(250, 140, 50)
	local colors = { red, yellow, pink, white, purple, orange }

	-- Ring of blooms around and over the rim (some drooping down the side)
	local ring = 9
	for i = 1, ring do
		local ang = (i - 1) / ring * math.pi * 2 + 0.2
		local y = 1.28 + ((i % 3) - 1) * 0.1
		local cf = CFrame.new(math.cos(ang) * 0.8, y, math.sin(ang) * 0.8)
		kit.ball("Bloom" .. i, 0.38, cf, colors[(i - 1) % #colors + 1], M.Fabric)
	end

	-- Blooms sitting on the crown of the mound
	local topColors = { pink, white, red, yellow, purple }
	for i = 1, 5 do
		local ang = (i - 1) / 5 * math.pi * 2 + 0.9
		local elev = if i % 2 == 0 then 0.75 else 0.35
		local dir = Vector3.new(math.cos(ang) * math.cos(elev), math.sin(elev), math.sin(ang) * math.cos(elev))
		kit.ball("TopBloom" .. i, 0.34, CFrame.new(crown + dir * 0.47), topColors[i], M.Fabric)
	end

	-- Two tall daisies poking up
	local stem = Color3.fromRGB(70, 130, 60)
	local tall = {
		{ Vector3.new(-0.15, 2.0, -0.1), Vector3.new(-0.3, 2.42, -0.25), yellow },
		{ Vector3.new(0.25, 2.0, 0.05), Vector3.new(0.38, 2.38, -0.05), pink },
	}
	for i, t in tall do
		kit.beam("TallStem" .. i, t[1], t[2], 0.06, 0.06, stem, M.Grass)
		local head = CFrame.new(t[2] + Vector3.new(0, 0.04, 0)) * CFrame.Angles(-0.35, 0, 0)
		kit.cylinder("TallPetals" .. i, 0.4, 0.06, head, t[3], M.Fabric)
		kit.ball("TallCentre" .. i, 0.14, head * CFrame.new(0, 0.05, 0), Color3.fromRGB(120, 72, 30), M.SmoothPlastic)
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Hammock</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material
	local stripeA = P.Canvas
	local stripeB = P.Teal

	-- Base rail and the two cross feet.
	kit.block("BaseRail", Vector3.new(6.4, 0.3, 0.4), CFrame.new(0, 0.15, 0), P.Teak, M.Wood)
	for _, s in { -1, 1 } do
		kit.block("Foot" .. (s < 0 and "L" or "R"), Vector3.new(0.45, 0.25, 2.5), CFrame.new(s * 2.9, 0.125, 0), P.DarkWood, M.Wood)
		for _, z in { -1, 1 } do
			kit.block("FootCap" .. s .. z, Vector3.new(0.5, 0.1, 0.3), CFrame.new(s * 2.9, 0.3, z * 1.05), P.Teak, M.Wood)
		end
	end

	-- Curved arms: three beam segments rising outward to each tip.
	local arc = {
		Vector3.new(2.6, 0.25, 0),
		Vector3.new(3.35, 1.25, 0),
		Vector3.new(3.75, 2.4, 0),
		Vector3.new(3.75, 3.35, 0),
	}
	for _, s in { -1, 1 } do
		for i = 1, 3 do
			local a = arc[i] * Vector3.new(s, 1, 1)
			local b = arc[i + 1] * Vector3.new(s, 1, 1)
			kit.beam("Arm" .. s .. i, a, b, 0.32, 0.32, P.Teak, M.Wood)
		end
	end

	-- Spreader bars and the ropes up to the arm tips.
	local tipY = 3.3
	local barX, barY = 2.75, 2.35
	for _, s in { -1, 1 } do
		kit.block("Spreader" .. s, Vector3.new(0.14, 0.14, 1.9), CFrame.new(s * barX, barY, 0), P.DarkWood, M.Wood)
		for _, z in { -0.85, 0.85 } do
			kit.beam("Rope" .. s .. z, Vector3.new(s * barX, barY, z), Vector3.new(s * 3.7, tipY, 0), 0.06, 0.06, P.Rope, M.Fabric)
		end
	end

	-- Sagging striped bed.
	local pts = {}
	local n = 6
	for i = 0, n do
		local t = i / n
		local x = -barX + t * barX * 2
		local y = barY - 1.05 * (1 - (2 * t - 1) ^ 2)
		pts[i] = Vector3.new(x, y, 0)
	end
	for i = 1, n do
		kit.beam("Bed" .. i, pts[i - 1], pts[i], 1.8, 0.1, i % 2 == 0 and stripeB or stripeA, M.Fabric)
	end

	-- A pillow at the left end.
	kit.block("Pillow", Vector3.new(0.7, 0.28, 1.2), CFrame.new(-1.95, 1.95, 0) * CFrame.Angles(0, 0, math.rad(-30)), P.White, M.Fabric)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">HerbBox</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material

	local paint = Color3.fromRGB(58, 120, 128)
	local soil = Color3.fromRGB(70, 48, 32)

	-- Little feet
	kit.block("BoxFootLeft", Vector3.new(0.3, 0.12, 1.1), CFrame.new(-1.45, 0.06, 0), P.DarkWood, M.Wood)
	kit.block("BoxFootRight", Vector3.new(0.3, 0.12, 1.1), CFrame.new(1.45, 0.06, 0), P.DarkWood, M.Wood)

	-- Window box body
	kit.block("BoxFront", Vector3.new(3.5, 0.72, 0.12), CFrame.new(0, 0.48, -0.6), paint, M.WoodPlanks)
	kit.block("BoxBack", Vector3.new(3.5, 0.72, 0.12), CFrame.new(0, 0.48, 0.6), paint, M.WoodPlanks)
	kit.block("BoxEndLeft", Vector3.new(0.12, 0.72, 1.08), CFrame.new(-1.69, 0.48, 0), paint, M.WoodPlanks)
	kit.block("BoxEndRight", Vector3.new(0.12, 0.72, 1.08), CFrame.new(1.69, 0.48, 0), paint, M.WoodPlanks)
	kit.block("BoxTrim", Vector3.new(3.58, 0.1, 0.16), CFrame.new(0, 0.86, -0.62), P.Cream, M.Wood)
	kit.block("BoxSoil", Vector3.new(3.28, 0.1, 1.08), CFrame.new(0, 0.74, 0), soil, M.Grass)

	-- Basil: big round leaves
	local basil = Color3.fromRGB(84, 168, 64)
	kit.ball("Basil1", 0.55, CFrame.new(-1.25, 1.0, -0.1), basil, M.LeafyGrass)
	kit.ball("Basil2", 0.45, CFrame.new(-0.95, 1.08, 0.18), basil, M.LeafyGrass)
	kit.ball("Basil3", 0.4, CFrame.new(-1.3, 1.25, 0.2), Color3.fromRGB(104, 184, 76), M.LeafyGrass)

	-- Rosemary: thin dark upright sprigs
	local rosemary = Color3.fromRGB(56, 96, 70)
	local sprigs = {
		{ Vector3.new(-0.55, 0.78, 0), Vector3.new(-0.68, 1.5, -0.15) },
		{ Vector3.new(-0.45, 0.78, 0.1), Vector3.new(-0.42, 1.55, 0.2) },
		{ Vector3.new(-0.35, 0.78, -0.05), Vector3.new(-0.15, 1.4, -0.2) },
		{ Vector3.new(-0.5, 0.78, -0.1), Vector3.new(-0.3, 1.3, 0.3) },
	}
	for i, s in sprigs do
		kit.beam("Rosemary" .. i, s[1], s[2], 0.12, 0.12, rosemary, M.LeafyGrass)
	end

	-- Chives with purple flower heads
	local chive = Color3.fromRGB(74, 150, 60)
	local stalks = {
		Vector3.new(0.3, 0, -0.15),
		Vector3.new(0.45, 0, 0.12),
		Vector3.new(0.6, 0, -0.1),
		Vector3.new(0.75, 0, 0.15),
	}
	for i, s in stalks do
		local h = 0.55 + (i % 2) * 0.15
		kit.cylinder("Chive" .. i, 0.07, h, CFrame.new(s.X, 0.78 + h / 2, s.Z), chive, M.Grass)
	end
	local lilac = Color3.fromRGB(170, 110, 200)
	kit.ball("ChiveFlower1", 0.2, CFrame.new(0.3, 1.41, -0.15), lilac, M.Fabric)
	kit.ball("ChiveFlower2", 0.2, CFrame.new(0.6, 1.41, -0.1), lilac, M.Fabric)

	-- Parsley: frilly dark mound
	local parsley = Color3.fromRGB(46, 128, 52)
	kit.ball("Parsley1", 0.45, CFrame.new(1.2, 0.98, -0.12), parsley, M.Grass)
	kit.ball("Parsley2", 0.4, CFrame.new(1.42, 1.02, 0.15), parsley, M.Grass)
	kit.ball("Parsley3", 0.35, CFrame.new(1.05, 1.08, 0.2), Color3.fromRGB(60, 140, 60), M.Grass)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">HotTub</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material
	local aqua = Color3.fromRGB(70, 200, 215)
	local glow = Color3.fromRGB(120, 235, 255)

	-- Dark plinth under the octagonal tub.
	kit.cylinder("Plinth", 5.6, 0.2, CFrame.new(0, 0.1, 0), P.DarkWood, M.WoodPlanks)

	-- Eight stave walls and eight rim boards around an octagon.
	for i = 0, 7 do
		local a = i * math.pi / 4
		local dir = Vector3.new(math.sin(a), 0, -math.cos(a))
		local wallPos = dir * 2.55 + Vector3.new(0, 1.25, 0)
		kit.block("Wall", Vector3.new(2.3, 2.1, 0.4), CFrame.lookAt(wallPos, Vector3.new(0, wallPos.Y, 0)), P.Teak, M.WoodPlanks)
		local rimPos = dir * 2.5 + Vector3.new(0, 2.4, 0)
		kit.block("Rim", Vector3.new(2.35, 0.2, 0.55), CFrame.lookAt(rimPos, Vector3.new(0, rimPos.Y, 0)), P.Wood, M.Wood)
	end


	-- Water surface with a glowing centre from the underwater lights.
	local water = kit.cylinder("Water", 4.8, 0.1, CFrame.new(0, 2.05, 0), aqua, M.Glass)
	kit.cylinder("WaterGlow", 2.6, 0.04, CFrame.new(0, 2.11, 0), glow, M.Neon)
	kit.light(water, glow, 12, 1.6)

	-- Underwater lamps peeking at the waterline on four staves.
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		local p = Vector3.new(math.sin(a), 0, -math.cos(a)) * 2.28 + Vector3.new(0, 2.08, 0)
		kit.ball("Lamp", 0.32, CFrame.new(p), glow, M.Neon)
	end

	-- Front step.
	kit.block("Step", Vector3.new(1.8, 0.5, 0.26), CFrame.new(0, 0.45, -2.86), P.Wood, M.WoodPlanks)

	-- Folded towel on the rim.
	kit.block("Towel", Vector3.new(0.9, 0.14, 0.5), CFrame.new(1.4, 2.57, 1.95) * CFrame.Angles(0, math.rad(-45), 0), P.White, M.Fabric)

	-- Low wisps of steam.
	kit.ball("Steam", 0.7, CFrame.new(-0.6, 2.2, 0.3), Color3.fromRGB(235, 245, 248), M.SmoothPlastic)
	kit.ball("Steam", 0.5, CFrame.new(0.5, 2.25, -0.5), Color3.fromRGB(235, 245, 248), M.SmoothPlastic)
	kit.ball("Steam", 0.4, CFrame.new(0.2, 2.35, 0.7), Color3.fromRGB(235, 245, 248), M.SmoothPlastic)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Jukebox</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material
	local chrome = Color3.fromRGB(205, 210, 220)
	local body = Color3.fromRGB(120, 30, 40)
	local neonPink = Color3.fromRGB(255, 80, 170)
	local neonAmber = Color3.fromRGB(255, 170, 60)

	-- Base and cabinet with a rounded (arched) top.
	kit.block("Plinth", Vector3.new(2.2, 0.2, 1.6), CFrame.new(0, 0.1, 0), chrome, M.Metal)
	kit.block("Cabinet", Vector3.new(2.0, 3.2, 1.3), CFrame.new(0, 1.8, 0), body, M.Wood)
	kit.cylinder("Crown", 2.0, 1.3, CFrame.new(0, 3.4, 0) * CFrame.Angles(math.pi / 2, 0, 0), body, M.Wood)

	-- Neon arch ring and the record window inside it.
	local arch = kit.cylinder("Arch", 2.0, 0.08, CFrame.new(0, 3.4, -0.69) * CFrame.Angles(math.pi / 2, 0, 0), neonPink, M.Neon)
	kit.light(arch, neonPink, 10, 1.4)
	kit.cylinder("Window", 1.5, 0.03, CFrame.new(0, 3.4, -0.745) * CFrame.Angles(math.pi / 2, 0, 0), Color3.fromRGB(40, 50, 70), M.Glass)
	kit.cylinder("Record", 0.74, 0.02, CFrame.new(0, 3.74, -0.77) * CFrame.Angles(math.pi / 2, 0, 0), Color3.fromRGB(20, 20, 24), M.SmoothPlastic)
	kit.cylinder("Label", 0.24, 0.01, CFrame.new(0, 3.74, -0.785) * CFrame.Angles(math.pi / 2, 0, 0), P.Red, M.SmoothPlastic)

	-- Front panel hides the lower half of the arch so the top reads as a dome.
	kit.block("FrontPanel", Vector3.new(2.2, 3.2, 0.1), CFrame.new(0, 1.8, -0.75), body, M.Wood)
	kit.block("Trim", Vector3.new(2.2, 0.08, 0.12), CFrame.new(0, 3.38, -0.75), chrome, M.Metal)

	-- Neon side tubes.
	kit.cylinder("Tube", 0.12, 3.0, CFrame.new(-0.98, 1.85, -0.795), neonAmber, M.Neon)
	kit.cylinder("Tube", 0.12, 3.0, CFrame.new(0.98, 1.85, -0.795), neonAmber, M.Neon)

	-- Song selector panel with buttons.
	kit.block("Selector", Vector3.new(1.4, 0.6, 0.03), CFrame.new(0, 2.75, -0.815), P.Cream, M.SmoothPlastic)
	local buttonColors = { P.Red, neonAmber, P.Teal, P.Green, neonPink }
	for i, c in ipairs(buttonColors) do
		kit.block("Button", Vector3.new(0.18, 0.14, 0.02), CFrame.new(-0.5 + (i - 1) * 0.25, 2.62, -0.84), c, M.SmoothPlastic)
	end
	kit.block("TitleStrip", Vector3.new(1.1, 0.16, 0.02), CFrame.new(0, 2.88, -0.84), neonAmber, M.Neon)

	-- Chrome speaker grille with bars.
	kit.block("Grille", Vector3.new(1.4, 1.2, 0.03), CFrame.new(0, 1.2, -0.815), Color3.fromRGB(45, 40, 45), M.Fabric)
	for i = 0, 3 do
		kit.block("GrilleBar", Vector3.new(1.4, 0.07, 0.02), CFrame.new(0, 0.75 + i * 0.3, -0.84), chrome, M.Metal)
	end
	kit.block("CoinSlot", Vector3.new(0.3, 0.12, 0.02), CFrame.new(0, 2.15, -0.81), chrome, M.Metal)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">KettleGrill</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material
	local enamel = Color3.fromRGB(32, 32, 36)
	local zc = -0.12 -- bowl centre sits a touch forward so the open lid has room behind
	local rimY = 1.7

	-- Three splayed legs with little feet, plus the ash tray between them.
	for i = 0, 2 do
		local a = math.rad(90 + i * 120)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local top = Vector3.new(0, 1.1, zc) + dir * 0.45
		local foot = Vector3.new(0, 0.08, zc) + dir * 0.85
		kit.beam("GrillLeg" .. i, top, foot, 0.12, 0.12, P.Steel, M.Metal)
		kit.cylinder("GrillFoot" .. i, 0.26, 0.16, CFrame.new(foot.X, 0.08, foot.Z), enamel, M.SmoothPlastic)
	end
	kit.cylinder("AshTray", 1.0, 0.06, CFrame.new(0, 0.45, zc), P.Steel, M.Metal)

	-- Rounded kettle bowl from stacked discs.
	kit.cylinder("KettleBase", 0.9, 0.22, CFrame.new(0, rimY - 0.63, zc), enamel, M.SmoothPlastic)
	kit.cylinder("KettleLow", 1.45, 0.25, CFrame.new(0, rimY - 0.45, zc), enamel, M.SmoothPlastic)
	kit.cylinder("KettleMid", 1.75, 0.25, CFrame.new(0, rimY - 0.25, zc), enamel, M.SmoothPlastic)
	kit.cylinder("KettleRim", 1.85, 0.18, CFrame.new(0, rimY - 0.09, zc), enamel, M.SmoothPlastic)

	-- Glowing coals and the cooking grate.
	local coals = kit.cylinder("Coals", 1.6, 0.06, CFrame.new(0, rimY - 0.12, zc), P.Flame, M.Neon)
	kit.light(coals, Color3.fromRGB(255, 130, 50), 10, 1.4)
	kit.fire(coals, P.Flame, 1)
	for i = -2, 2 do
		local half = math.sqrt(math.max(0.85 ^ 2 - (i * 0.32) ^ 2, 0.05))
		kit.block("GrateBar" .. i, Vector3.new(0.05, 0.05, half * 2), CFrame.new(i * 0.32, rimY + 0.02, zc), P.Steel, M.Metal)
	end
	kit.block("Sausage", Vector3.new(0.5, 0.14, 0.14), CFrame.new(-0.15, rimY + 0.11, zc - 0.25), Color3.fromRGB(150, 70, 45), M.SmoothPlastic)
	kit.block("Burger", Vector3.new(0.38, 0.1, 0.38), CFrame.new(0.3, rimY + 0.09, zc + 0.15), Color3.fromRGB(95, 55, 35), M.SmoothPlastic)

	-- Domed lid propped open on a back hinge.
	local hingeZ = zc + 0.9
	local lid = CFrame.new(0, rimY, hingeZ) * CFrame.Angles(math.rad(55), 0, 0) * CFrame.new(0, 0, -0.9)
	kit.cylinder("LidRim", 1.85, 0.16, lid * CFrame.new(0, 0.08, 0), enamel, M.SmoothPlastic)
	kit.cylinder("LidMid", 1.5, 0.22, lid * CFrame.new(0, 0.27, 0), enamel, M.SmoothPlastic)
	kit.cylinder("LidTop", 0.95, 0.16, lid * CFrame.new(0, 0.45, 0), enamel, M.SmoothPlastic)
	kit.cylinder("LidVent", 0.35, 0.06, lid * CFrame.new(0, 0.55, 0), P.Steel, M.Metal)
	kit.block("LidHandle", Vector3.new(0.5, 0.1, 0.12), lid * CFrame.new(0, 0.5, -0.7), P.DarkWood, M.Wood)

	-- Front handle on the bowl.
	kit.block("KettleHandle", Vector3.new(0.6, 0.1, 0.12), CFrame.new(0, rimY - 0.2, zc - 0.98), P.DarkWood, M.Wood)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">LifeRingPost</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material

	-- Foot and post
	kit.block("Foot", Vector3.new(1.2, 0.18, 0.76), CFrame.new(0, 0.09, 0), P.DarkWood, M.WoodPlanks)
	kit.block("Post", Vector3.new(0.3, 3.62, 0.3), CFrame.new(0, 1.99, 0.12), P.Teak, M.Wood)
	kit.block("Cap", Vector3.new(0.4, 0.14, 0.4), CFrame.new(0, 3.87, 0.12), P.DarkWood, M.Wood)
	kit.block("Peg", Vector3.new(0.1, 0.1, 0.34), CFrame.new(0, 3.34, -0.12), P.Brass, M.Metal)

	-- The ring: 12 segments in bands of two, red / white
	local cy, cz, r = 2.52, -0.17, 0.66
	local n = 12
	for i = 0, n - 1 do
		local t0 = i / n * math.pi * 2
		local t1 = (i + 1) / n * math.pi * 2
		local a = Vector3.new(math.cos(t0) * r, cy + math.sin(t0) * r, cz)
		local b = Vector3.new(math.cos(t1) * r, cy + math.sin(t1) * r, cz)
		local dir = (b - a).Unit * 0.03
		local color = (math.floor(i / 2) % 2 == 0) and P.Red or P.White
		kit.beam("Ring" .. i, a - dir, b + dir, 0.24, 0.24, color, M.SmoothPlastic)
	end

	-- Grab line looped over the peg
	kit.beam("Line", Vector3.new(-0.04, 3.32, -0.24), Vector3.new(-0.2, 3.12, -0.24), 0.05, 0.05, P.Rope, M.Fabric)
	kit.beam("Line2", Vector3.new(0.04, 3.32, -0.24), Vector3.new(0.2, 3.12, -0.24), 0.05, 0.05, P.Rope, M.Fabric)

	-- Small navy name plate under the ring
	kit.block("Plate", Vector3.new(0.5, 0.26, 0.04), CFrame.new(0, 1.3, -0.05), P.Navy, M.SmoothPlastic)
	kit.block("PlateStripe", Vector3.new(0.36, 0.05, 0.02), CFrame.new(0, 1.3, -0.08), P.Brass, M.Metal)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">PalmPlanter</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material

	-- Wooden tub with brass bands
	kit.block("PlanterBase", Vector3.new(1.9, 0.2, 1.9), CFrame.new(0, 0.1, 0), P.DarkWood, M.Wood)
	kit.block("PlanterTub", Vector3.new(1.75, 1.3, 1.75), CFrame.new(0, 0.85, 0), P.Teak, M.WoodPlanks)
	kit.block("PlanterBandLow", Vector3.new(1.82, 0.12, 1.82), CFrame.new(0, 0.5, 0), P.Brass, M.Metal)
	kit.block("PlanterBandHigh", Vector3.new(1.82, 0.12, 1.82), CFrame.new(0, 1.2, 0), P.Brass, M.Metal)
	kit.block("PlanterRim", Vector3.new(1.95, 0.14, 1.95), CFrame.new(0, 1.55, 0), P.DarkWood, M.Wood)
	kit.block("PlanterSoil", Vector3.new(1.6, 0.06, 1.6), CFrame.new(0, 1.6, 0), Color3.fromRGB(70, 48, 32), M.Grass)

	-- Segmented, slightly curving trunk
	local bark = { Color3.fromRGB(134, 98, 62), Color3.fromRGB(112, 80, 50) }
	local base = Vector3.new(0, 1.6, 0)
	local top = Vector3.new(0.25, 5.7, 0.05)
	local segments = 4
	local function at(t)
		local p = base:Lerp(top, t)
		return p - Vector3.new(math.sin(t * math.pi) * 0.15, 0, 0)
	end
	for i = 1, segments do
		local a = at((i - 1) / segments)
		local b = at(i / segments)
		local d = 0.55 - i * 0.06
		local mid = (a + b) / 2
		local cf = CFrame.lookAt(mid, b) * CFrame.Angles(-math.pi / 2, 0, 0)
		kit.cylinder("PalmTrunk" .. i, d, (b - a).Magnitude + 0.08, cf, bark[(i % 2) + 1], M.Wood)
	end

	-- Crown and coconuts
	kit.ball("PalmCrown", 0.5, CFrame.new(top), Color3.fromRGB(96, 74, 44), M.Wood)
	local nut = Color3.fromRGB(92, 64, 36)
	for i, ang in { 0.4, 2.5, 4.4 } do
		local off = Vector3.new(math.cos(ang) * 0.24, -0.22 - (i % 2) * 0.06, math.sin(ang) * 0.24)
		kit.ball("Coconut" .. i, 0.3, CFrame.new(top + off), nut, M.SmoothPlastic)
	end

	-- Drooping fronds: two beams each, up-and-out then down
	local fronds = 7
	for i = 1, fronds do
		local ang = (i - 1) / fronds * math.pi * 2 + 0.3
		local dir = Vector3.new(math.cos(ang), 0, math.sin(ang))
		local start = top + Vector3.new(0, 0.1, 0)
		local midH = 6.45 + (i % 2) * 0.2
		local tipH = 5.75 + (i % 3) * 0.2
		local mid = Vector3.new(dir.X * 0.85 + top.X * 0.4, midH, dir.Z * 0.85)
		local tip = Vector3.new(dir.X * 1.4, tipH, dir.Z * 1.4)
		local col = if i % 2 == 0 then P.Leaf else P.Green
		kit.beam("PalmFrond" .. i .. "a", start, mid, 0.5, 0.08, col, M.LeafyGrass)
		kit.beam("PalmFrond" .. i .. "b", mid, tip, 0.3, 0.08, col, M.LeafyGrass)
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Parasol</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material

	-- Weighted base.
	kit.cylinder("BaseWeight", 1.4, 0.3, CFrame.new(0, 0.15, 0), P.Stone, M.Concrete)
	kit.cylinder("BaseCap", 0.9, 0.2, CFrame.new(0, 0.4, 0), P.Iron, M.Metal)
	kit.cylinder("BaseCollar", 0.3, 0.4, CFrame.new(0, 0.7, 0), P.Iron, M.Metal)

	-- Pole with a crank.
	kit.cylinder("Pole", 0.16, 5.5, CFrame.new(0, 0.5 + 2.75, 0), P.White, M.SmoothPlastic)
	kit.cylinder("PoleJoint", 0.26, 0.2, CFrame.new(0, 3.0, 0), P.Steel, M.Metal)
	kit.block("Crank", Vector3.new(0.35, 0.06, 0.06), CFrame.new(0.2, 3.0, 0), P.Steel, M.Metal)

	-- Striped octagonal canopy: each slice is two flat right-triangle wedges
	-- (apex -> edge midpoint -> corner), so the stripes meet cleanly.
	local panels = 8
	local apothem = 2.4
	local drop = 0.95
	local topY = 5.72
	local half = apothem * math.tan(math.pi / panels)
	local thick = 0.08
	local apex = Vector3.new(0, topY, 0)
	for i = 0, panels - 1 do
		local th = i * 2 * math.pi / panels
		local u = Vector3.new(math.cos(th), 0, math.sin(th))
		local w = Vector3.new(-math.sin(th), 0, math.cos(th))
		local mid = u * apothem + Vector3.new(0, topY - drop, 0)
		local z = (mid - apex).Unit
		local len = (mid - apex).Magnitude
		for _, s in { -1, 1 } do
			local y = w * s
			local x = y:Cross(z)
			local c = apex + y * (half / 2) + z * (len / 2) + Vector3.new(0, -thick / 2, 0)
			kit.wedge(
				"Canopy" .. i .. (s < 0 and "a" or "b"),
				Vector3.new(thick, half, len),
				CFrame.new(c.X, c.Y, c.Z, x.X, y.X, z.X, x.Y, y.Y, z.Y, x.Z, y.Z, z.Z),
				i % 2 == 0 and P.Red or P.White,
				M.Fabric
			)
		end
	end
	kit.cylinder("Hub", 0.4, 0.2, CFrame.new(0, topY - drop - 0.05, 0), P.Steel, M.Metal)
	kit.ball("Finial", 0.25, CFrame.new(0, 5.86, 0), P.Brass, M.Metal)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">RodRack</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material
	local side = CFrame.Angles(0, 0, math.pi / 2) -- cylinder axis along X

	-- Wooden frame
	kit.block("Base", Vector3.new(3.6, 0.45, 1.1), CFrame.new(0, 0.225, 0), P.Teak, M.Wood)
	kit.block("BaseTrim", Vector3.new(3.3, 0.1, 0.9), CFrame.new(0, 0.5, 0), P.DarkWood, M.Wood)
	kit.block("PostLeft", Vector3.new(0.25, 4.0, 0.3), CFrame.new(-1.65, 2.45, 0.35), P.Teak, M.Wood)
	kit.block("PostRight", Vector3.new(0.25, 4.0, 0.3), CFrame.new(1.65, 2.45, 0.35), P.Teak, M.Wood)
	kit.block("HoldRail", Vector3.new(3.55, 0.22, 0.55), CFrame.new(0, 3.4, 0.1), P.Teak, M.Wood)
	kit.block("TopCap", Vector3.new(3.6, 0.14, 0.4), CFrame.new(0, 4.52, 0.35), P.DarkWood, M.Wood)
	kit.block("Plaque", Vector3.new(0.8, 0.22, 0.04), CFrame.new(0, 0.24, -0.57), P.Brass, M.Metal)

	-- Five rods standing in the rack
	local rods = {
		{ x = -1.2, tip = 4.95, blank = P.Navy, grip = P.Rope },
		{ x = -0.6, tip = 4.7, blank = P.Red, grip = P.Iron },
		{ x = 0, tip = 4.9, blank = P.Teal, grip = P.Rope },
		{ x = 0.6, tip = 4.65, blank = P.Green, grip = P.Iron },
		{ x = 1.2, tip = 4.85, blank = P.Brass, grip = P.Rope },
	}
	for i, r in rods do
		kit.cylinder("Grip" .. i, 0.2, 1.0, CFrame.new(r.x, 1.05, 0.1), r.grip, M.Fabric)
		kit.beam("Blank" .. i, Vector3.new(r.x, 1.55, 0.1), Vector3.new(r.x, r.tip, 0.1), 0.08, 0.08, r.blank, M.SmoothPlastic)
		kit.cylinder("Reel" .. i, 0.36, 0.16, CFrame.new(r.x, 1.75, -0.12) * side, P.Steel, M.Metal)
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">SeaChest</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material
	local band = Color3.fromRGB(46, 48, 52)
	local wood = Color3.fromRGB(120, 72, 40)
	local lidWood = Color3.fromRGB(96, 56, 30)

	-- feet
	for _, x in { -1.2, 1.2 } do
		for _, z in { -0.62, 0.62 } do
			kit.block("Foot", Vector3.new(0.34, 0.14, 0.34), CFrame.new(x, 0.07, z), P.DarkWood, M.Wood)
		end
	end

	-- body and lid
	kit.block("Body", Vector3.new(2.7, 1.22, 1.56), CFrame.new(0, 0.75, 0), wood, M.WoodPlanks)
	kit.block("Plinth", Vector3.new(2.8, 0.14, 1.66), CFrame.new(0, 0.21, 0), lidWood, M.Wood)
	kit.block("LidRim", Vector3.new(2.84, 0.2, 1.68), CFrame.new(0, 1.46, 0), lidWood, M.Wood)
	local dome = CFrame.new(0, 1.42, 0) * CFrame.Angles(0, 0, math.pi / 2)
	kit.cylinder("LidDome", 1.5, 2.8, dome, wood, M.WoodPlanks)

	-- iron bands: two straps round body + dome, one round the waist
	for _, x in { -0.92, 0.92 } do
		kit.block("Strap", Vector3.new(0.18, 1.22, 1.64), CFrame.new(x, 0.75, 0), band, M.Metal)
		kit.block("RimStrap", Vector3.new(0.18, 0.22, 1.72), CFrame.new(x, 1.46, 0), band, M.Metal)
		kit.cylinder("DomeStrap", 1.56, 0.18, CFrame.new(x, 1.42, 0) * CFrame.Angles(0, 0, math.pi / 2), band, M.Metal)
	end
	-- corner caps on the end edges
	for _, x in { -1.31, 1.31 } do
		for _, z in { -0.76, 0.76 } do
			kit.block("CornerBand", Vector3.new(0.12, 1.22, 0.1), CFrame.new(x, 0.75, z), band, M.Metal)
		end
	end

	-- heavy brass lock on the front
	kit.block("LockPlate", Vector3.new(0.5, 0.56, 0.08), CFrame.new(0, 1.2, -0.82), P.Brass, M.Metal)
	kit.block("Keyhole", Vector3.new(0.08, 0.16, 0.04), CFrame.new(0, 1.12, -0.87), Color3.fromRGB(20, 20, 22), M.SmoothPlastic)
	kit.block("Hasp", Vector3.new(0.24, 0.36, 0.08), CFrame.new(0, 1.62, -0.78), P.Brass, M.Metal)
	kit.cylinder("Padlock", 0.32, 0.14, CFrame.new(0, 1.36, -0.88) * CFrame.Angles(math.pi / 2, 0, 0), P.Brass, M.Metal)

	-- carry handles on the ends
	for _, s in { -1, 1 } do
		kit.block("HandleBracket", Vector3.new(0.1, 0.18, 0.12), CFrame.new(s * 1.4, 1.0, -0.3), band, M.Metal)
		kit.block("HandleBracket", Vector3.new(0.1, 0.18, 0.12), CFrame.new(s * 1.4, 1.0, 0.3), band, M.Metal)
		kit.block("Handle", Vector3.new(0.1, 0.1, 0.72), CFrame.new(s * 1.46, 0.92, 0), band, M.Metal)
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">ShipBell</string>
            <string name="Source"><![CDATA[return function(kit)
	local P = kit.Palette
	local M = kit.Material

	-- Base plank and a raised plinth
	kit.block("Base", Vector3.new(1.8, 0.2, 1.4), CFrame.new(0, 0.1, 0), P.DarkWood, M.Wood)
	kit.block("Plinth", Vector3.new(1.5, 0.12, 1.0), CFrame.new(0, 0.26, 0), P.Teak, M.Wood)

	-- Uprights with corner braces
	for _, side in { -1, 1 } do
		kit.block("Post", Vector3.new(0.24, 3.5, 0.3), CFrame.new(side * 0.72, 2.07, 0), P.Wood, M.Wood)
		kit.wedge(
			"Brace",
			Vector3.new(0.18, 0.55, 0.4),
			CFrame.new(side * 0.4, 0.595, 0) * CFrame.Angles(0, side * math.pi / 2, 0),
			P.Wood,
			M.Wood
		)
		kit.wedge(
			"TopBrace",
			Vector3.new(0.18, 0.4, 0.3),
			CFrame.new(side * 0.45, 3.42, 0) * CFrame.Angles(math.pi, side * math.pi / 2, 0),
			P.Wood,
			M.Wood
		)
	end

	-- Crossbeam and cap
	kit.block("Crossbeam", Vector3.new(1.8, 0.3, 0.36), CFrame.new(0, 3.77, 0), P.DarkWood, M.Wood)
	kit.block("Cap", Vector3.new(1.8, 0.08, 0.46), CFrame.new(0, 3.96, 0), P.Teak, M.Wood)

	-- Brass hanger
	kit.block("Hanger", Vector3.new(0.34, 0.16, 0.26), CFrame.new(0, 3.54, 0), P.Brass, M.Metal)
	kit.cylinder("Yoke", 0.12, 0.2, CFrame.new(0, 3.38, 0), P.Iron, M.Metal)

	-- The bell: crown, shoulder, waist and flared lip
	kit.cylinder("Crown", 0.36, 0.14, CFrame.new(0, 3.24, 0), P.Brass, M.Metal)
	kit.ball("Shoulder", 0.66, CFrame.new(0, 3.0, 0), P.Brass, M.Metal)
	kit.cylinder("Waist", 0.7, 0.5, CFrame.new(0, 2.78, 0), P.Brass, M.Metal)
	kit.cylinder("Flare", 0.86, 0.16, CFrame.new(0, 2.47, 0), P.Brass, M.Metal)
	kit.cylinder("Lip", 0.98, 0.08, CFrame.new(0, 2.36, 0), P.Brass, M.Metal)
	kit.cylinder("Band", 0.74, 0.05, CFrame.new(0, 2.92, 0), Color3.fromRGB(170, 128, 50), M.Metal)

	-- Clapper and bell rope
	kit.ball("Clapper", 0.2, CFrame.new(0, 2.22, 0), P.Iron, M.Metal)
	kit.cylinder("BellRope", 0.08, 0.95, CFrame.new(0, 1.66, 0), P.Rope, M.Fabric)
	kit.ball("RopeKnot", 0.16, CFrame.new(0, 1.16, 0), P.Rope, M.Fabric)
	kit.cylinder("Tassel", 0.12, 0.22, CFrame.new(0, 0.98, 0), P.Red, M.Fabric)

	-- Name plate on the front of the plinth
	kit.block("Nameplate", Vector3.new(0.6, 0.1, 0.03), CFrame.new(0, 0.26, -0.515), P.Brass, M.Metal)
end
]]></string>
