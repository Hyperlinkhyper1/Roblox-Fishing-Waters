        <Item class="ModuleScript" referent="226">
          <Properties>
            <string name="Name">FurnitureShop</string>
            <string name="Source"><![CDATA[-- Harbour Home's plaza door leads to a furnished showroom away from the map.
-- Every catalogue item stands full-size on a plinth facing its aisle, and the
-- indoor service desk sells the whole list. Versioned builders upgrade saved
-- storefronts and restore door links and shop tags.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Furniture = require(ReplicatedStorage.Shared.FurnitureCatalog)
local DiningRoom = require(script.Parent.DiningRoom)
local FishFreezer = require(script.Parent.FishFreezer)
local Kitchen = require(script.Parent.Kitchen)
local PlazaHouses = require(script.Parent.PlazaHouses)
local Props = require(script.Parent.Props)
local ShopDesk = require(script.Parent.ShopDesk)
local StorageRack = require(script.Parent.StorageRack)
local WeatherRadar = require(script.Parent.WeatherRadar)

local FurnitureShop = {}
local LAYOUT_VERSION = 2
local INTERIOR_VERSION = 6
local ORIGIN = CFrame.new(6700, 300, 160)
local W, D, H = 64, 60, 18
local rgb = Color3.fromRGB
local M = Enum.Material
local CREAM = rgb(255, 245, 213)
local TEAL = rgb(64, 140, 120)
local WOOD = rgb(150, 104, 64)
local GOLD = rgb(200, 152, 74)
local RUG = rgb(122, 66, 48)
local LINEN = rgb(236, 226, 204)
local LEAF = rgb(64, 118, 66)
local POT = rgb(164, 96, 62)
local SHADE = rgb(102, 70, 44)

local function interiors(): Instance
	local folder = workspace:FindFirstChild("Interiors")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name, folder.Parent = "Interiors", workspace
	end
	return folder
end

local function doorPrompt(door: BasePart, action: string, destination: CFrame)
	local prompt = door:FindFirstChild("FurnitureStoreDoorPrompt") :: ProximityPrompt?
	if not prompt then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = "FurnitureStoreDoorPrompt"
		prompt.ObjectText = "Harbour Home"
		prompt.MaxActivationDistance = 9
		prompt.RequiresLineOfSight = false
		prompt.HoldDuration = 0
		prompt.Parent = door
	end
	local p = prompt :: ProximityPrompt
	p.ActionText = action
	p:SetAttribute("TeleportTo", destination)
end

local function restoreTags(hall: Model)
	CollectionService:AddTag(hall, "FurnitureShowroom")
	local top = hall:FindFirstChild("CounterTop")
	if top then CollectionService:AddTag(top, "FurnitureShop") end
end

-- The same builders that furnish a player's house, so displays match the goods.
local function buildSample(id: string, parent: Instance, frame: CFrame): Model
	if id == "Freezer" then
		return FishFreezer.build(parent, frame)
	elseif id == "Register" then
		return ShopDesk.build(parent, frame)
	elseif id == "StorageRack" then
		local sample = StorageRack.build(parent, frame)
		StorageRack.fill(sample, frame, StorageRack.CRATES)
		return sample
	elseif id == "FoodCase" then
		return Kitchen.buildCase(parent, frame)
	elseif id == "FoodShelf" then
		return Kitchen.buildShelf(parent, frame)
	elseif id == "KitchenStorage" then
		return Kitchen.buildStorage(parent, frame)
	elseif id == "DiningTable" then
		return DiningRoom.buildTable(parent, frame)
	elseif id == "WeatherRadar" then
		return WeatherRadar.build(parent, frame)
	end
	return Kitchen.buildStation(parent, frame, id)
end

-- Where each item stands in the showroom. `side` names the wall it lines:
-- left/right displays face the side aisles, back displays face the centre.
-- `turn` swings the item's customer side toward that aisle.
local DISPLAYS = {
	-- Left wall: the cooking line.
	{ id = "GrillStation", side = "left", x = -27, z = -6, turn = math.pi / 2, plinth = Vector3.new(6, 0.3, 9.6) },
	{ id = "Smoker", side = "left", x = -27, z = 4, turn = math.pi / 2, plinth = Vector3.new(6, 0.3, 9.6) },
	{ id = "SushiBar", side = "left", x = -27, z = 14, turn = math.pi / 2, plinth = Vector3.new(6, 0.3, 9.6) },
	-- Right wall: the shop floor and storage.
	{ id = "Freezer", side = "right", x = 27, z = -7, turn = -math.pi / 2, plinth = Vector3.new(6, 0.3, 9.6) },
	{ id = "FoodCase", side = "right", x = 27, z = 4, turn = -math.pi / 2, plinth = Vector3.new(6, 0.3, 9.6) },
	{ id = "StorageRack", side = "right", x = 27, z = 14, turn = -math.pi / 2, plinth = Vector3.new(8, 0.3, 6.25) },
	-- By the entrance, between the corner plant and the freezer: the one outdoor piece.
	{ id = "WeatherRadar", side = "right", x = 27, z = -18, turn = -math.pi / 2, plinth = Vector3.new(5.5, 0.3, 5.5) },
	-- Back wall: the sales row under the welcome sign.
	{ id = "KitchenStorage", side = "back", x = -12, z = 24, turn = math.pi, plinth = Vector3.new(9.6, 0.3, 6) },
	{ id = "Register", side = "back", x = 0, z = 24, turn = 0, plinth = Vector3.new(9, 0.3, 7) },
	{ id = "DiningTable", side = "back", x = 12, z = 24, turn = math.pi, plinth = Vector3.new(5.5, 0.3, 9.6) },
}

local function ensureInterior(): Model
	local folder = interiors()
	local existing = folder:FindFirstChild("FurnitureStoreInterior")
	if existing and existing:IsA("Model") and existing:GetAttribute("LayoutVersion") == INTERIOR_VERSION then
		restoreTags(existing)
		return existing
	elseif existing then
		existing:Destroy()
	end
	local hall = Instance.new("Model")
	hall.Name = "FurnitureStoreInterior"
	hall.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	hall:SetAttribute("LayoutVersion", INTERIOR_VERSION)
	hall:SetAttribute("InteriorFrame", ORIGIN * CFrame.new(0, H / 2, 0))
	hall:SetAttribute("InteriorSize", Vector3.new(W, H, D))
	hall:SetAttribute("ArrivalFrame", ORIGIN * CFrame.new(0, 3.2, -D / 2 + 5) * CFrame.Angles(0, math.pi, 0))
	local function part(name: string, size: Vector3, frame: CFrame, color: Color3, material: Enum.Material): Part
		local p = Props.part(hall, size, ORIGIN * frame, color, material)
		p.Name = name
		return p
	end
	local function sign(name: string, size: Vector3, frame: CFrame, text: string, color: Color3): Part
		local p = part(name, size, frame, color, M.Wood)
		p.CanCollide = false
		PlazaHouses.boardText(p, text, Enum.NormalId.Front)
		return p
	end

	-- Shell: warm plaster over teal wainscot, an oak floor and trimmed ceiling.
	part("Floor", Vector3.new(W + 2, 1, D + 2), CFrame.new(0, -0.5, 0), WOOD, M.WoodPlanks)
	part("Ceiling", Vector3.new(W + 2, 1, D + 2), CFrame.new(0, H + 0.5, 0), rgb(244, 234, 210), M.Plaster)
	for _, side in { -1, 1 } do
		part("SideWall", Vector3.new(1, H, D + 2), CFrame.new(side * (W / 2 + 0.5), H / 2, 0), rgb(244, 234, 210), M.Plaster)
		part("EndWall", Vector3.new(W, H, 1), CFrame.new(0, H / 2, side * (D / 2 + 0.5)), rgb(225, 189, 155), M.Plaster)
		part("Wainscot", Vector3.new(0.2, 3, D), CFrame.new(side * (W / 2 - 0.1), 1.5, 0), TEAL, M.WoodPlanks)
		part("Skirting", Vector3.new(W, 0.4, 0.25), CFrame.new(0, 0.2, side * (D / 2 - 0.1)), TEAL, M.Wood)
		part("WainscotCap", Vector3.new(0.35, 0.18, D), CFrame.new(side * (W / 2 - 0.22), 3.06, 0), GOLD, M.Wood)
		part("CrownTrim", Vector3.new(0.45, 0.7, D), CFrame.new(side * (W / 2 - 0.25), H - 0.6, 0), CREAM, M.Wood)
		part("CrownTrim", Vector3.new(W, 0.7, 0.45), CFrame.new(0, H - 0.6, side * (D / 2 - 0.25)), CREAM, M.Wood)
	end
	-- Coffered ceiling: transverse beams carry the lanterns, long beams between.
	for _, z in { -22, -8, 6, 20 } do
		part("CeilingBeam", Vector3.new(W, 0.7, 0.7), CFrame.new(0, H - 0.4, z), WOOD, M.Wood)
		for _, x in { -20, 0, 20 } do
			local lamp = Props.lantern(hall, ORIGIN * CFrame.new(x, H - 2.5, z), 22, 0.8)
			for _, piece in lamp:GetChildren() do
				if piece:IsA("BasePart") then piece.CanCollide = false end
			end
		end
	end
	for _, x in { -22, 0, 22 } do
		part("CeilingBeam", Vector3.new(0.7, 0.7, D), CFrame.new(x, H - 0.4, 0), WOOD, M.Wood)
	end
	-- Lower lanterns over the entrance, the sales counter and the back row.
	for _, spot in { Vector3.new(-24, 11, -20), Vector3.new(0, 13.5, -25), Vector3.new(0, 13.5, 24) } do
		local lamp = Props.lantern(hall, ORIGIN * CFrame.new(spot), 18, 0.8)
		for _, piece in lamp:GetChildren() do
			if piece:IsA("BasePart") then piece.CanCollide = false end
		end
	end
	-- Side windows light the aisles; back windows flank the welcome sign and
	-- wear linen curtains.
	for _, side in { -1, 1 } do
		for _, z in { -26, -16 } do
			part("WindowFrame", Vector3.new(0.3, 7, 6), CFrame.new(side * (W / 2 - 0.25), 10, z), TEAL, M.Wood)
			local pane = part("WindowLight", Vector3.new(0.1, 6, 5), CFrame.new(side * (W / 2 - 0.45), 10, z), CREAM, M.Neon)
			pane.CanCollide = false
			Props.light(pane, CREAM, 14, 0.35)
			for _, dz in { -3.2, 3.2 } do
				local curtain = part("Curtain", Vector3.new(0.15, 7.5, 1.25), CFrame.new(side * (W / 2 - 0.65), 9.7, z + dz), LINEN, M.Fabric)
				curtain.CanCollide = false
			end
		end
		local x = side * 25
		part("WindowFrame", Vector3.new(6, 7, 0.3), CFrame.new(x, 10, D / 2 - 0.25), TEAL, M.Wood)
		local pane = part("WindowLight", Vector3.new(5, 6, 0.1), CFrame.new(x, 10, D / 2 - 0.45), CREAM, M.Neon)
		pane.CanCollide = false
		Props.light(pane, CREAM, 14, 0.35)
		for _, dx in { -3.3, 3.3 } do
			local curtain = part("Curtain", Vector3.new(1.5, 7.5, 0.15), CFrame.new(x + dx, 9.4, D / 2 - 0.65), LINEN, M.Fabric)
			curtain.CanCollide = false
		end
	end
	sign("WelcomeSign", Vector3.new(24, 2.5, 0.2), CFrame.new(0, 14, D / 2 - 0.3), "HARBOUR HOME", TEAL)
	sign("ShowroomGuide", Vector3.new(26, 1.5, 0.2), CFrame.new(0, 11.5, D / 2 - 0.3), "Browse a display · Buy here · Place at home", SHADE)
	part("ExitDoor", Vector3.new(4, 8, 0.3), CFrame.new(0, 4, -D / 2 + 0.2), rgb(60, 98, 130), M.WoodPlanks)
	sign("ExitSign", Vector3.new(6, 1.3, 0.2), CFrame.new(0, 9.5, -D / 2 + 0.4) * CFrame.Angles(0, math.pi, 0), "EXIT · PLAZA", TEAL)
	-- Framed art flanks the exit; timber columns and an arch frame the doorway.
	for _, side in { -1, 1 } do
		local frame = part("ArtFrame", Vector3.new(7, 4.5, 0.2), CFrame.new(side * 12, 6, -D / 2 + 0.15), GOLD, M.Wood)
		frame.CanCollide = false
		local canvas = part("ArtCanvas", Vector3.new(6, 3.5, 0.12), CFrame.new(side * 12, 6, -D / 2 + 0.3), TEAL, M.SmoothPlastic)
		canvas.CanCollide = false
		local horizon = part("ArtHorizon", Vector3.new(5.6, 0.65, 0.08), CFrame.new(side * 12, 5.25, -D / 2 + 0.39), rgb(157, 192, 168), M.SmoothPlastic)
		horizon.CanCollide = false
		local sun = part("ArtSun", Vector3.new(0.9, 0.9, 0.08), CFrame.new(side * 12 + 1.4, 6.7, -D / 2 + 0.39), CREAM, M.SmoothPlastic)
		sun.CanCollide = false
		part("DoorColumn", Vector3.new(1.3, 12, 1.3), CFrame.new(side * 5, 6, -D / 2 + 0.8), CREAM, M.Wood)
		part("DoorColumnCap", Vector3.new(1.7, 0.5, 1.7), CFrame.new(side * 5, 12.25, -D / 2 + 0.8), WOOD, M.Wood)
		part("DoorColumnBase", Vector3.new(1.7, 0.6, 1.7), CFrame.new(side * 5, 0.3, -D / 2 + 0.8), WOOD, M.Wood)
	end
	part("DoorArch", Vector3.new(12.3, 1.2, 1.3), CFrame.new(0, 13, -D / 2 + 0.8), WOOD, M.Wood)
	-- Runner rugs warm the aisles; none of it blocks a walking avatar.
	local function rug(name: string, size: Vector3, at: Vector3, color: Color3)
		local carpet = part(name, size, CFrame.new(at), color, M.Fabric)
		carpet.CanCollide = false
	end
	rug("CentreRunnerTrim", Vector3.new(7.8, 0.06, 43.8), Vector3.new(0, 0.03, -3), GOLD)
	rug("CentreRunner", Vector3.new(7, 0.08, 43), Vector3.new(0, 0.05, -3), RUG)
	for _, x in { -18, 18 } do
		rug("AisleRunnerTrim", Vector3.new(4.8, 0.06, 32.8), Vector3.new(x, 0.03, 1), LINEN)
		rug("AisleRunner", Vector3.new(4, 0.08, 32), Vector3.new(x, 0.05, 1), TEAL)
	end
	rug("EntryMat", Vector3.new(6, 0.08, 2.5), Vector3.new(0, 0.05, -D / 2 + 2), TEAL)
	-- Potted greenery softens the entrance and the back corners.
	local rng = Random.new(90210)
	local function plant(x: number, z: number)
		local m = Instance.new("Model")
		m.Name = "PottedPlant"
		local function at(dx: number, y: number, dz: number): Vector3
			return (ORIGIN * CFrame.new(x + dx, y, z + dz)).Position
		end
		Props.cylinder(m, at(0, 0.85, 0), 1.7, 2.2, POT, M.SmoothPlastic)
		Props.cylinder(m, at(0, 1.78, 0), 0.25, 2, rgb(70, 52, 40), M.Ground)
		Props.beam(m, at(0, 1.9, 0), at(0, 3.1, 0), 0.35, rgb(92, 70, 48), 0.35, M.Wood)
		for _, offset in {
			Vector3.new(0, 3.1, 0),
			Vector3.new(0.9, 2.7, 0.4),
			Vector3.new(-0.8, 2.8, -0.5),
			Vector3.new(0.2, 2.6, -0.9),
		} do
			Props.blob(m, at(offset.X, offset.Y, offset.Z), Vector3.new(2.4, 1.1, 1.6), rng, LEAF, M.LeafyGrass)
		end
		for _, piece in m:GetDescendants() do
			if piece:IsA("BasePart") then piece.CanCollide = false end
		end
		m.Parent = hall
	end
	for _, spot in { Vector2.new(-8, -26), Vector2.new(8, -26), Vector2.new(-30, 23), Vector2.new(30, 23) } do
		plant(spot.X, spot.Y)
	end
	-- A little upholstered bench makes the entrance feel like a home, while
	-- leaving the centre and both browsing aisles clear.
	part("WelcomeBench", Vector3.new(7, 0.45, 2.6), CFrame.new(16, 1.55, -27), WOOD, M.Wood)
	part("BenchCushion", Vector3.new(6.7, 0.45, 2.35), CFrame.new(16, 2, -27), LINEN, M.Fabric)
	part("BenchBack", Vector3.new(7, 2.3, 0.35), CFrame.new(16, 2.8, -28.1), WOOD, M.Wood)
	for _, x in { 13.1, 18.9 } do
		for _, z in { -27.9, -26.1 } do
			part("BenchLeg", Vector3.new(0.45, 1.4, 0.45), CFrame.new(x, 0.7, z), WOOD, M.Wood)
		end
	end
	for _, x in { 14, 18 } do
		local cushion = part("BenchPillow", Vector3.new(1.5, 1.2, 0.55), CFrame.new(x, 2.9, -27.75), TEAL, M.Fabric)
		cushion.CanCollide = false
	end

	-- Two room sets turn the middle of the shop into a showroom. The main
	-- runner and the side aisles remain open all the way around the sets.
	for _, x in { -10, 10 } do
		rug("RoomSetRug", Vector3.new(8, 0.08, 14), Vector3.new(x, 0.05, 4), if x < 0 then LINEN else rgb(194, 210, 190))
		part("RoomDivider", Vector3.new(8, 8, 0.35), CFrame.new(x, 4, 11), if x < 0 then rgb(210, 181, 153) else rgb(187, 207, 189), M.WoodPlanks)
		part("RoomDividerCap", Vector3.new(8.2, 0.25, 0.5), CFrame.new(x, 8.1, 11), WOOD, M.Wood)
	end
	-- A small lounge with a sofa, coffee table and dressed shelves.
	part("ShowroomSofaBase", Vector3.new(6.5, 1, 2.7), CFrame.new(-10, 1.1, -1), rgb(183, 154, 126), M.Fabric)
	part("ShowroomSofaBack", Vector3.new(6.5, 2.3, 0.65), CFrame.new(-10, 2.3, -2), rgb(183, 154, 126), M.Fabric)
	for _, x in { -13, -7 } do
		part("ShowroomSofaArm", Vector3.new(0.55, 1.5, 2.7), CFrame.new(x, 1.9, -1), rgb(183, 154, 126), M.Fabric)
	end
	for _, x in { -11.8, -8.2 } do
		local pillow = part("ShowroomPillow", Vector3.new(1.4, 1.2, 0.45), CFrame.new(x, 2.45, -1.55), TEAL, M.Fabric)
		pillow.CanCollide = false
	end
	part("CoffeeTableTop", Vector3.new(4.5, 0.3, 2.2), CFrame.new(-10, 1.7, 3.2), WOOD, M.Wood)
	for _, x in { -11.8, -8.2 } do
		for _, z in { 2.5, 3.9 } do
			part("CoffeeTableLeg", Vector3.new(0.3, 1.55, 0.3), CFrame.new(x, 0.78, z), SHADE, M.Wood)
		end
	end
	local book = part("ShowroomBook", Vector3.new(1.2, 0.16, 0.9), CFrame.new(-10.5, 1.93, 3.2), TEAL, M.SmoothPlastic)
	book.CanCollide = false
	for _, y in { 2.3, 4.4, 6.5 } do
		part("ShowroomShelf", Vector3.new(6.5, 0.22, 1.1), CFrame.new(-10, y, 10.25), WOOD, M.Wood)
		for _, x in { -12, -10, -8 } do
			local box = part("ShelfBox", Vector3.new(1.1, 1.2, 0.8), CFrame.new(x, y + 0.7, 10.2), if x == -10 then TEAL else LINEN, M.Fabric)
			box.CanCollide = false
		end
	end
	-- A dining vignette and stocked shelving suggest how pieces can be used
	-- together, while the actual catalogue samples remain on their plinths.
	part("ShowroomTableTop", Vector3.new(5.5, 0.35, 3.2), CFrame.new(10, 2.6, 2.5), WOOD, M.Wood)
	for _, x in { 7.8, 12.2 } do
		for _, z in { 1.3, 3.7 } do
			part("ShowroomTableLeg", Vector3.new(0.45, 2.4, 0.45), CFrame.new(x, 1.2, z), SHADE, M.Wood)
		end
	end
	for _, z in { -0.4, 5.4 } do
		part("ShowroomSeat", Vector3.new(3.6, 0.4, 1.1), CFrame.new(10, 1.35, z), TEAL, M.Wood)
		for _, x in { 8.5, 11.5 } do
			part("ShowroomSeatLeg", Vector3.new(0.35, 1.2, 0.35), CFrame.new(x, 0.6, z), WOOD, M.Wood)
		end
	end
	for _, y in { 2.3, 4.4, 6.5 } do
		part("ShowroomShelf", Vector3.new(6.5, 0.22, 1.1), CFrame.new(10, y, 10.25), WOOD, M.Wood)
		for _, x in { 8, 10, 12 } do
			local basket = part("ShelfBasket", Vector3.new(1.3, 0.8, 0.8), CFrame.new(x, y + 0.5, 10.2), if x == 10 then POT else LINEN, M.Fabric)
			basket.CanCollide = false
		end
	end
	sign("RoomSetSign", Vector3.new(7, 1.3, 0.15), CFrame.new(-10, 9.2, 10.9), "A COSY CORNER", TEAL)
	sign("RoomSetSign", Vector3.new(7, 1.3, 0.15), CFrame.new(10, 9.2, 10.9), "GATHER & DINE", TEAL)
	sign("ShowroomRouteSign", Vector3.new(13, 1.5, 0.2), CFrame.new(0, 13, -11), "SHOWROOM  ·  FOLLOW THE AISLES", TEAL)
	sign("ShowroomRouteSign", Vector3.new(12, 1.5, 0.2), CFrame.new(0, 13, 15), "MORE IDEAS AHEAD", TEAL)
	for _, x in { -13, -7, 7, 13 } do
		local support = part("RoomSignSupport", Vector3.new(0.16, 0.55, 0.16), CFrame.new(x, 8.4, 10.9), WOOD, M.Wood)
		support.CanCollide = false
	end
	for _, z in { -11, 15 } do
		for _, x in { -5, 5 } do
			local hanger = part("RouteSignHanger", Vector3.new(0.12, 4.1, 0.12), CFrame.new(x, 15.8, z), SHADE, M.Metal)
			hanger.CanCollide = false
		end
	end
	sign("ZoneSign", Vector3.new(12, 2, 0.15), CFrame.new(-(W / 2 - 0.65), 11.8, 8) * CFrame.Angles(0, -math.pi / 2, 0), "COOKING & KITCHEN", TEAL)
	sign("ZoneSign", Vector3.new(12, 2, 0.15), CFrame.new(W / 2 - 0.65, 11.8, 8) * CFrame.Angles(0, math.pi / 2, 0), "SHOP FLOOR & STORAGE", TEAL)

	-- Full-size examples of every catalogue item, each on a plinth facing the
	-- aisle where its customers stand.
	for _, spec in DISPLAYS do
		local item = Furniture.Items[spec.id]
		local display = Instance.new("Model")
		display.Name = spec.id .. "Display"
		display:SetAttribute("ItemId", spec.id)
		local plinth = part("DisplayPlinth", spec.plinth, CFrame.new(spec.x, 0.15, spec.z), rgb(224, 207, 174), M.Limestone)
		plinth.Parent = display
		local trim = part("PlinthTrim", Vector3.new(spec.plinth.X + 0.3, 0.1, spec.plinth.Z + 0.3), CFrame.new(spec.x, 0.32, spec.z), GOLD, M.Wood)
		trim.Parent = display
		local sample = buildSample(spec.id, display, ORIGIN * CFrame.new(spec.x, 0.37, spec.z) * CFrame.Angles(0, spec.turn, 0))
		sample.Name = "Sample" .. spec.id
		sample.Parent = display
		-- The price board stands at the plinth's aisle edge; the description
		-- hangs on the wall above the display.
		local labelFrame, detailFrame, detailSize, customer
		if spec.side == "left" then
			labelFrame = CFrame.new(spec.x + 4.45, 1.9, spec.z) * CFrame.Angles(0, -math.pi / 2, 0)
			detailFrame = CFrame.new(-(W / 2 - 0.65), 8.8, spec.z) * CFrame.Angles(0, -math.pi / 2, 0)
			detailSize = Vector3.new(spec.plinth.Z, 2.8, 0.15)
			customer = Vector3.new(spec.x + 8, 3.2, spec.z)
		elseif spec.side == "right" then
			labelFrame = CFrame.new(spec.x - 4.45, 1.9, spec.z) * CFrame.Angles(0, math.pi / 2, 0)
			detailFrame = CFrame.new(W / 2 - 0.65, 8.8, spec.z) * CFrame.Angles(0, math.pi / 2, 0)
			detailSize = Vector3.new(spec.plinth.Z, 2.8, 0.15)
			customer = Vector3.new(spec.x - 8, 3.2, spec.z)
		else
			labelFrame = CFrame.new(spec.x, 1.9, spec.z - 3.8)
			detailFrame = CFrame.new(spec.x, 8.8, D / 2 - 0.4)
			detailSize = Vector3.new(spec.plinth.X, 2.8, 0.15)
			customer = Vector3.new(spec.x, 3.2, spec.z - 6.5)
		end
		display:SetAttribute("CustomerSpot", customer)
		local labelSize = Vector3.new(math.min(spec.plinth.X, spec.plinth.Z) - 0.5, 2.2, 0.2)
		local backing = part(
			"PriceFrame",
			Vector3.new(labelSize.X + 0.5, labelSize.Y + 0.5, 0.12),
			labelFrame * CFrame.new(0, 0, 0.06),
			GOLD,
			M.Metal
		)
		backing.CanCollide = false
		backing.Parent = display
		local label = sign("PriceLabel", labelSize, labelFrame, string.format("%s\n$%d", item.Name, item.Price), SHADE)
		label.Parent = display
		label:SetAttribute("ItemId", spec.id)
		sign("DisplayDetails", detailSize, detailFrame, item.Description, TEAL).Parent = display
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "BrowseFurniturePrompt"
		prompt.ActionText = "View · $" .. item.Price
		prompt.ObjectText = item.Name
		prompt.MaxActivationDistance = 7
		prompt.RequiresLineOfSight = false
		prompt.HoldDuration = 0
		prompt:SetAttribute("ItemId", spec.id)
		prompt.Parent = label
		display.Parent = hall
	end

	-- An indoor service desk also offers the whole catalogue.
	local counterFrame = ORIGIN * CFrame.new(-24, 0, -20)
	local counter = ShopDesk.build(hall, counterFrame)
	counter.Name = "SalesCounter"
	local top = part("CounterTop", Vector3.new(ShopDesk.WIDTH, 0.2, ShopDesk.DEPTH), CFrame.new(-24, ShopDesk.HEIGHT + 0.1, -20), WOOD, M.Wood)
	top.Transparency, top.CanCollide, top.CanQuery, top.CanTouch = 1, false, false, false
	local browse = Instance.new("ProximityPrompt")
	browse.Name, browse.ActionText, browse.ObjectText = "BrowseFurniturePrompt", "Browse furniture", "Harbour Home"
	browse.MaxActivationDistance, browse.RequiresLineOfSight, browse.HoldDuration = 7, false, 0
	browse.Parent = top
	hall:SetAttribute("KeeperFrame", counterFrame * CFrame.new(0, 0, ShopDesk.DEPTH / 2 + 1.3))
	sign("ServiceSign", Vector3.new(10, 2, 0.2), CFrame.new(-24, 8, -D / 2 + 0.4) * CFrame.Angles(0, math.pi, 0), "Need a hand?\nBrowse at the counter", TEAL)
	-- Tag after parenting so listeners inspect the finished showroom.
	hall.Parent = folder
	restoreTags(hall)
	return hall
end

function FurnitureShop.build(plaza: Model, plazaFrame: CFrame): Model
	local hall = ensureInterior()
	local existing = plaza:FindFirstChild("FurnitureShop")
	local shop: Model
	if existing and existing:IsA("Model") and existing:GetAttribute("LayoutVersion") == LAYOUT_VERSION then
		shop = existing
	else
		if existing then existing:Destroy() end
		local base = plazaFrame * CFrame.new(45, 0, 38) * CFrame.Angles(0, -math.pi / 2, 0)
		local doorFace, leaf
		shop, doorFace, leaf = PlazaHouses.house(plaza, base, {
			width = 18, depth = 18, stories = 2,
			lower = rgb(236, 160, 96), upper = rgb(244, 234, 210), trim = rgb(250, 242, 224),
			shutter = TEAL, roof = rgb(152, 72, 46), door = rgb(60, 98, 130), balcony = true,
			shop = "HARBOUR HOME", blade = "FURNITURE", signColor = CREAM, doorSide = 1,
		}, Random.new(5150))
		shop.Name = "FurnitureShop"
		shop:SetAttribute("LayoutVersion", LAYOUT_VERSION)
		leaf.Name = "StreetDoor"
		shop:SetAttribute("ExitFrame", doorFace * CFrame.new(0, 3.2, 4.5) * CFrame.Angles(0, math.pi, 0))
		for _, prop in plaza:GetChildren() do
			local reach = if prop.Name == "Palm" then 10 elseif prop.Name == "Planter" then 4 else nil
			local trunk = reach and prop:IsA("Model") and prop:FindFirstChildWhichIsA("BasePart", true)
			if trunk then
				local p = base:PointToObjectSpace(trunk.Position)
				local dx, dz = math.max(math.abs(p.X) - 9.4, 0), math.max(math.abs(p.Z) - 15, 0)
				if dx * dx + dz * dz < reach * reach then prop:Destroy() end
			end
		end
		local board = Props.part(shop, Vector3.new(2.8, 3.6, 0.2), doorFace * CFrame.new(-5, 1.8, 4), rgb(36, 44, 40), M.Slate)
		board.CanCollide = false
		PlazaHouses.boardText(board, "FREEZERS\nCOUNTERS\nRACKS\ninside", Enum.NormalId.Back)
	end
	local leaf = shop:FindFirstChild("StreetDoor", true)
	local exit = hall:FindFirstChild("ExitDoor")
	if leaf and leaf:IsA("BasePart") then doorPrompt(leaf, "Enter", hall:GetAttribute("ArrivalFrame")) end
	if exit and exit:IsA("BasePart") then doorPrompt(exit, "Leave", shop:GetAttribute("ExitFrame")) end
	return shop
end

-- Startup repairs scan the whole map (city and islands included) before anyone spawns. Yield a
-- frame every 50 ms so the startup thread stays inside Roblox's ~10 s script timeout.
local breatheAt = os.clock()
local function breathe()
	if task and os.clock() - breatheAt > 0.05 then
		task.wait()
		breatheAt = os.clock()
	end
end

function FurnitureShop.ensure(root: Instance)
	for _, plaza in root:GetDescendants() do
		breathe()
		if plaza:IsA("Model") and plaza.Name == "Plaza" then
			local frame = PlazaHouses.pavingFrame(plaza)
			if frame then FurnitureShop.build(plaza, frame) end
		end
	end
end

return FurnitureShop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="227">
          <Properties>
            <string name="Name">Harbour</string>
            <string name="Source"><![CDATA[-- The home island: a horseshoe of land wrapped around a sheltered bay that opens to the west.
-- Player bases line the bay shore (a quay plot with two piers each), a Mediterranean village of
-- whitewashed cube houses, pastel townhouses and villas rings them around a piazza, windmills and a
-- chapel crown the hills, and a lighthouse stands on the southern headland at the bay mouth.
-- The coastline is traced from the concept sketch in pixel coordinates and scaled into the world.

local CollectionService = game:GetService("CollectionService")

local BaseHouse = require(script.Parent.BaseHouse)
local BeachDetails = require(script.Parent.BeachDetails)
local Drydock = require(script.Parent.Drydock)
local FurnitureShop = require(script.Parent.FurnitureShop)
local BackpackShop = require(script.Parent.BackpackShop)
local Islands = require(script.Parent.Islands)
local LowPoly = require(script.Parent.LowPoly)
local Med = require(script.Parent.Mediterranean)
local MetroStations = require(script.Parent.MetroStations)
local PlazaHouses = require(script.Parent.PlazaHouses)
local Props = require(script.Parent.Props)
local RodShop = require(script.Parent.RodShop)
local Seabed = require(script.Parent.Seabed)

local Harbour = {}

local rgb = Color3.fromRGB
local pick = Props.pick
local M = Enum.Material
local TAU = math.pi * 2

local SCALE = 1 -- studs per sketch pixel; room for fifteen waterfront plots
local ORIGINAL_SCALE = 0.85
local SKETCH_CENTER = Vector2.new(870, 1330) -- reference point of the original harbour sketch
local CELL = 16 -- ground mesh resolution
local SEABED_RUN = 128 -- continuous underwater descent from shore to the deep floor
local GROUND_MARGIN = SEABED_RUN + CELL
local LAND = 5 -- height of the flat village ground
local ROAD_OFFSET = 95 -- how far inland the ring road runs from the bay shore
local ROAD_WIDTH = 16
local LANE_OFFSET = 40 -- how far behind the ring road the back lane runs, past the first row of houses
local LANE_WIDTH = 10
local VILLAGE_BAND = 165 -- land closer than this to the bay stays flat; further inland rises into hills and cliffs
local PLAZA_HALF = 60 -- the piazza is a square this far from its centre to each edge

-- Roughly how far the island reaches from its center, for keeping other islands away.
Harbour.FOOTPRINT = 1000
Harbour.BASE_TAG = "PlayerBase"
Harbour.LAYOUT_VERSION = 1

-- Sea-facing coast, clockwise from the tip of the western arm round to the southern headland.
-- The north and east shores bulge past the sketch so the piazza and the eastern bases
-- keep room for the road and a row or two of houses behind them.
local OUTER = {
	{ 430, 1340 },
	{ 372, 1290 },
	{ 330, 1200 },
	{ 312, 1090 },
	{ 318, 970 },
	{ 345, 860 },
	{ 395, 760 },
	{ 448, 672 },
	{ 528, 588 },
	{ 640, 515 },
	{ 780, 473 },
	{ 950, 477 },
	{ 1120, 510 },
	{ 1270, 552 },
	{ 1365, 600 },
	{ 1430, 680 },
	{ 1505, 790 },
	{ 1565, 945 },
	{ 1610, 1120 },
	{ 1632, 1320 },
	{ 1615, 1520 },
	{ 1560, 1712 },
	{ 1465, 1880 },
	{ 1325, 2018 },
	{ 1150, 2098 },
	{ 950, 2130 },
	{ 760, 2140 },
	{ 580, 2110 },
	{ 430, 2050 },
	{ 320, 1960 },
	{ 262, 1850 },
	{ 250, 1740 },
	{ 265, 1640 },
	{ 290, 1565 },
}

-- Bay shore, from the southern headland round the inner bay and back to the western arm.
local BAY = {
	{ 350, 1555 },
	{ 450, 1553 },
	{ 550, 1565 },
	{ 650, 1598 },
	{ 760, 1640 },
	{ 850, 1640 },
	{ 950, 1620 },
	{ 1030, 1630 },
	{ 1100, 1668 },
	{ 1170, 1690 },
	{ 1240, 1660 },
	{ 1305, 1585 },
	{ 1345, 1480 },
	{ 1362, 1360 },
	{ 1348, 1262 },
	{ 1290, 1182 },
	{ 1200, 1122 },
	{ 1105, 1090 },
	{ 1045, 1050 },
	{ 1012, 980 },
	{ 985, 902 },
	{ 940, 852 },
	{ 870, 818 },
	{ 760, 820 },
	{ 685, 850 },
	{ 652, 905 },
	{ 663, 1000 },
	{ 680, 1118 },
	{ 660, 1190 },
	{ 600, 1255 },
	{ 520, 1300 },
}

-- Keep the first six IDs and fill the unused waterfront, leaving the bathing
-- beach, repair channel and western shipping entrance clear.
local BASES = {
	{ 668, 1030 }, { 1000, 950 }, { 1150, 1105 },
	{ 1360, 1330 }, { 1340, 1500 }, { 880, 1638 },
	{ 663, 1150 }, { 550, 1280 }, { 1070, 1065 },
	{ 1290, 1182 }, { 450, 1553 }, { 600, 1580 },
	{ 735, 1630 }, { 1040, 1640 }, { 1200, 1680 },
}
Harbour.BASE_COUNT = #BASES
local LIGHTHOUSE = { 360, 1640 }
-- The bathing beach round the head of the bay, between the first two bases.
local BEACH = { { 660, 975 }, { 652, 905 }, { 685, 850 }, { 760, 820 }, { 870, 818 }, { 940, 852 }, { 985, 902 } }
local BEACH_WIDTH = 42 -- dry sand from the waterline up to the foot of the dunes
local BEACH_FADE = 45 -- the beach blends back into the normal shore over this much coastline at each end
-- Set back from the bay so the ring road runs along the piazza's southern side; the drydock
-- slipway needs the bay about 130 studs south of the centre, so move this with SCALE.
local PLAZA = { 870, 665 }

-- Sun-baked Mediterranean ground: dry grass, maquis on the hills, pale limestone cliffs
local GRASS = rgb(146, 148, 90)
local HILL = rgb(116, 124, 74)
local SAND = rgb(224, 208, 166)
local BEACH_SAND = rgb(242, 228, 188)
local WET_SAND = rgb(196, 176, 136)
local DUNE_GRASS = { rgb(150, 156, 92), rgb(170, 168, 104), rgb(126, 140, 80) }
local BEACH_COLORS = { rgb(214, 64, 56), rgb(40, 120, 196), rgb(240, 186, 52), rgb(40, 156, 140), rgb(226, 112, 150) }
local ROCK = rgb(186, 176, 156)
local ROAD = rgb(204, 192, 168)
local DIRT = rgb(178, 140, 98)
local PAVING = rgb(228, 216, 194)
local PAVING_DARK = rgb(176, 160, 134)
local QUAY = rgb(150, 140, 126)
local DECK = rgb(132, 102, 74)

local ACCENTS = {
	rgb(60, 110, 170),
	rgb(180, 60, 50),
	rgb(70, 140, 80),
	rgb(220, 180, 60),
	rgb(130, 80, 160),
	rgb(220, 120, 50),
}
local MAQUIS = { rgb(92, 110, 64), rgb(110, 120, 70), rgb(78, 98, 60) }
local BOATS = { rgb(36, 92, 168), rgb(190, 60, 50), rgb(60, 140, 90), rgb(230, 180, 60), rgb(40, 140, 160) }

type Shape = {
	coast: { Vector2 },
	bayShore: { Vector2 },
	beach: { Vector2 },
	beachLength: number,
	center: Vector2,
	flats: { Spot }, -- areas kept level even past the village band
	toWorld: ({ number }) -> Vector2,
}
type Spot = { position: Vector2, radius: number }
type RoadPoint = { position: Vector2, inland: Vector2 }
type Street = { RoadPoint } -- an unbroken run of street, in order

----------------------------------------------------------------------------------------------------
-- Geometry

local function smoothstep(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

local function segmentDistance(p: Vector2, a: Vector2, b: Vector2): (number, Vector2)
	local ab = b - a
	local t = math.clamp((p - a):Dot(ab) / ab:Dot(ab), 0, 1)
	local q = a + ab * t
	return (p - q).Magnitude, q
end

local function isInside(poly: { Vector2 }, p: Vector2): boolean
	local inside = false
	local j = #poly
	for i = 1, #poly do
		local a, b = poly[i], poly[j]
		if (a.Y > p.Y) ~= (b.Y > p.Y) and p.X < (b.X - a.X) * (p.Y - a.Y) / (b.Y - a.Y) + a.X then
			inside = not inside
		end
		j = i
	end
	return inside
end

-- Nearest point on a polyline and the segment direction there.
local function nearestOnLine(line: { Vector2 }, p: Vector2): (number, Vector2, Vector2)
	local best, point, tangent = math.huge, p, Vector2.new(1, 0)
	for i = 1, #line - 1 do
		local dist, q = segmentDistance(p, line[i], line[i + 1])
		if dist < best then
			best, point, tangent = dist, q, (line[i + 1] - line[i]).Unit
		end
	end
	return best, point, tangent
end

-- Signed distance to the coast: positive on land, negative at sea.
local function coastDistance(shape: Shape, p: Vector2): number
	local coast = shape.coast
	local best = math.huge
	local j = #coast
	for i = 1, #coast do
		best = math.min(best, (segmentDistance(p, coast[j], coast[i])))
		j = i
	end
	return if isInside(coast, p) then best else -best
end

-- How much `p` belongs to the bathing beach: 1 along its middle, fading out at both ends and away
-- from the shore.
local function beachWeight(shape: Shape, p: Vector2): number
	local line = shape.beach
	local best, along, walked = math.huge, 0, 0
	for i = 1, #line - 1 do
		local a, b = line[i], line[i + 1]
		local dist, q = segmentDistance(p, a, b)
		if dist < best then
			best, along = dist, walked + (q - a).Magnitude
		end
		walked += (b - a).Magnitude
	end
	return smoothstep(along / BEACH_FADE)
		* smoothstep((walked - along) / BEACH_FADE)
		* (1 - smoothstep((best - 100) / 40))
end

local function beachWidthAt(p: Vector2): number
	return BEACH_WIDTH + math.noise(p.X / 42, p.Y / 42, 3.7) * 10
end

local function heightAt(shape: Shape, p: Vector2): number
	-- Water must extend beneath the original lift and out through its slipway.
	-- Keep the channel's sloping banks underneath the existing quay walls.
	local plaza = shape.toWorld(PLAZA)
	local dx, dz = math.abs(p.X - plaza.X), p.Y - plaza.Y
	if dx < 25 and dz > 108 and dz < 238 then
		local bank = math.clamp((25 - dx) / 8, 0, 1)
		local ends = math.min(math.clamp((dz - 108) / 8, 0, 1), math.clamp((238 - dz) / 8, 0, 1))
		if bank * ends >= 1 then
			return -18
		end
	end
	local d = coastDistance(shape, p)
	local beach = beachWeight(shape, p)
	if d <= 0 then
		return Seabed.height(-d, SEABED_RUN)
	end

	local h = LAND
	if d < 10 then
		h = 1.5 * d / 10
	elseif d < 24 then
		h = 1.5 + (LAND - 1.5) * smoothstep((d - 10) / 14)
	end
	if beach > 0 then
		-- A wide, nearly flat strand, then a low dune up to the village
		local width = beachWidthAt(p)
		local sand = if d < width then 2 * d / width else 2 + (LAND - 2) * smoothstep((d - width) / 16)
		-- Small wind-shaped undulations fade out before the level village ground.
		sand += math.noise(p.X / 19, p.Y / 19, 2.4) * 0.24 * smoothstep(d / 10) * (1 - smoothstep((d - width) / 12))
		h += (sand - h) * beach
	end

	-- Away from the bay the land climbs: cliffs along the open-sea coast, wooded hills inland
	local inland = smoothstep(((nearestOnLine(shape.bayShore, p)) - VILLAGE_BAND) / 65)
	for _, f in shape.flats do
		inland *= smoothstep(((p - f.position).Magnitude - f.radius) / 40)
	end
	if inland <= 0 then
		return h
	end
	local cliff = smoothstep((d - 3) / 12)
	local hill = smoothstep((d - 60) / 80)
	local noise = math.clamp(math.noise(p.X / 190, p.Y / 190, 7.3) + 0.5, 0, 1)
	return h + inland * (cliff * 12 + hill * (8 + 34 * noise))
end

local function makeShape(center: Vector2): Shape
	local function toWorld(p: { number }): Vector2
		-- Grow around the plaza so shops, metro dry pockets and the public spawn
		-- retain their world positions while the waterfront gains space.
		local plaza = Vector2.new(PLAZA[1], PLAZA[2])
		return center + (plaza - SKETCH_CENTER) * ORIGINAL_SCALE + (Vector2.new(p[1], p[2]) - plaza) * SCALE
	end
	local flats = { { position = toWorld(PLAZA), radius = PLAZA_HALF * 1.6 } }
	local coast, bayShore = {}, { toWorld(OUTER[#OUTER]) }
	for _, p in OUTER do
		table.insert(coast, toWorld(p))
	end
	for i, p in BAY do
		local a = toWorld(p)
		table.insert(coast, a)
		table.insert(bayShore, a)
		if i >= 20 and i <= 27 then
			-- The bathing cove follows one shared curve for land, props and surf.
			-- Keep the sketch's main anchors, rounding the long straight beach edges.
			local prev, b, nxt = toWorld(BAY[i - 1]), toWorld(BAY[i + 1]), toWorld(BAY[i + 2])
			local steps = math.ceil((b - a).Magnitude / 8)
			for k = 1, steps - 1 do
				local t = k / steps
				local q = (
					a * 2
					+ (b - prev) * t
					+ (prev * 2 - a * 5 + b * 4 - nxt) * t * t
					+ (-prev + a * 3 - b * 3 + nxt) * t * t * t
				) * 0.5
				table.insert(coast, q)
				table.insert(bayShore, q)
			end
		end
	end
	table.insert(bayShore, toWorld(OUTER[1]))
	local function coordinate(p: Vector2): (number, Vector2)
		local best, index, point = math.huge, 1, p
		for i = 1, #bayShore - 1 do
			local a, b = bayShore[i], bayShore[i + 1]
			local distance, q = segmentDistance(p, a, b)
			if distance < best then
				best, index, point = distance, i + (q - a).Magnitude / (b - a).Magnitude, q
			end
		end
		return index, point
	end
	local first, a = coordinate(toWorld(BEACH[1]))
	local last, b = coordinate(toWorld(BEACH[#BEACH]))
	local beach = { a }
	for i = math.ceil(first) - 1, math.floor(last) + 1, -1 do
		table.insert(beach, bayShore[i])
	end
	table.insert(beach, b)
	local beachLength = 0
	for i = 2, #beach do
		beachLength += (beach[i] - beach[i - 1]).Magnitude
	end
	return {
		coast = coast,
		bayShore = bayShore,
		beach = beach,
		beachLength = beachLength,
		center = center,
		flats = flats,
		toWorld = toWorld,
	}
end

-- Nearest point on the bay shore and the direction out over the water from it.
local function shoreAt(shape: Shape, p: Vector2): (Vector2, Vector2)
	local _, point, tangent = nearestOnLine(shape.bayShore, p)
	local normal = Vector2.new(-tangent.Y, tangent.X)
	if isInside(shape.coast, point + normal * 10) then
		normal = -normal
	end
	return point, normal
end

local function isFree(spots: { Spot }, p: Vector2, radius: number): boolean
	for _, s in spots do
		if (s.position - p).Magnitude < s.radius + radius then
			return false
		end
	end
	return true
end

local function reserve(spots: { Spot }, p: Vector2, radius: number)
	table.insert(spots, { position = p, radius = radius })
end

local function flat(shape: Shape, p: Vector2, radius: number): boolean
	for _, o in
		{
			Vector2.zero,
			Vector2.new(radius, 0),
			Vector2.new(-radius, 0),
			Vector2.new(0, radius),
			Vector2.new(0, -radius),
		}
	do
		if heightAt(shape, p + o) ~= LAND then
			return false
		end
	end
	return true
end

local function ground(p: Vector2, lift: number?): Vector3
	return Vector3.new(p.X, LAND + (lift or 0), p.Y)
end

local function facingToward(from: Vector2, to: Vector2): number
	local dir = to - from
	return math.atan2(dir.X, dir.Y)
end

----------------------------------------------------------------------------------------------------
-- Ground mesh and seabed

local function buildGround(shape: Shape, parent: Model, rng: Random)
	local groundModel = Instance.new("Model")
	groundModel.Name = "Ground"
	groundModel:SetAttribute("DrydockChannelVersion", 1)
	groundModel.Parent = parent

	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	for _, p in shape.coast do
		minX, maxX = math.min(minX, p.X), math.max(maxX, p.X)
		minZ, maxZ = math.min(minZ, p.Y), math.max(maxZ, p.Y)
	end
	minX, minZ = minX - GROUND_MARGIN, minZ - GROUND_MARGIN
	local cols = math.ceil((maxX + GROUND_MARGIN - minX) / CELL)
	local rows = math.ceil((maxZ + GROUND_MARGIN - minZ) / CELL)

	local vertices = {}
	for i = 0, cols do
		vertices[i] = {}
		for k = 0, rows do
			local p = Vector2.new(minX + i * CELL, minZ + k * CELL)
			local h = heightAt(shape, p)
			-- Shared vertices keep every seam closed. Level village vertices stay on the
			-- grid so the merged grass slabs still meet the beach exactly.
			local amount = beachWeight(shape, p) * math.clamp((LAND - h) / 1.2, 0, 1)
			if amount > 0 then
				p += Vector2.new(
					math.clamp(math.noise(i * 1.73, k * 2.31, 11.7), -0.5, 0.5),
					math.clamp(math.noise(i * 2.17, k * 1.91, 29.3), -0.5, 0.5)
				) * CELL * 0.48 * amount
				h = heightAt(shape, p)
			end
			vertices[i][k] = Vector3.new(p.X, h, p.Y)
		end
		if i % 10 == 0 then
			task.wait()
		end
	end

	local function face(a: Vector3, b: Vector3, c: Vector3)
		local normal = (b - a):Cross(c - a).Unit
		local y = (a.Y + b.Y + c.Y) / 3
		local mid = (a + b + c) / 3
		local beach = beachWeight(shape, Vector2.new(mid.X, mid.Z))
		local color, material
		if y < LAND - 0.01 and math.abs(normal.Y) > 0.9 and beach > 0.35 then
			local wet = smoothstep((y + 0.9) / 0.9) * (1 - smoothstep(y / 1.1))
			color = BEACH_SAND:Lerp(WET_SAND, wet):Lerp(GRASS, smoothstep((y - 2.8) / 2.2))
			material = M.Sand
		elseif y < 0 then
			color, material = SAND, M.Sand
		elseif math.abs(normal.Y) < 0.72 then
			color, material = ROCK, M.Limestone
		elseif y < 2.2 then
			color, material = SAND, M.Sand
		elseif y > LAND + 6 then
			color, material = HILL, M.LeafyGrass
		else
			color, material = GRASS, M.Grass
		end
		-- Continuous, restrained sand variation avoids a checkerboard of random tiles.
		local shade = if beach > 0.1 or y < 0
			then 1 + math.noise(mid.X / 35, mid.Z / 35, 17.8) * 0.035
			else rng:NextNumber(0.94, 1.04)
		color = Color3.new(math.min(color.R * shade, 1), math.min(color.G * shade, 1), math.min(color.B * shade, 1))
		LowPoly.triangle(a, b, c, (a + b + c) / 3 - Vector3.new(0, 40, 0), color, groundModel, material)
	end

	for k = 0, rows - 1 do
		local z0 = minZ + k * CELL
		-- Flat village ground is merged into one slab per run of cells
		local runStart: number? = nil
		local function flush(endI: number)
			if runStart then
				local x0, x1 = minX + runStart * CELL, minX + endI * CELL
				Props.part(
					groundModel,
					Vector3.new(x1 - x0, 4, CELL),
					CFrame.new((x0 + x1) / 2, LAND - 2, z0 + CELL / 2),
					GRASS:Lerp(HILL, rng:NextNumber(0, 0.2)),
					M.Grass
				)
				runStart = nil
			end
		end
		for i = 0, cols - 1 do
			local a, b, c, d = vertices[i][k], vertices[i + 1][k], vertices[i][k + 1], vertices[i + 1][k + 1]
			if
				a.Y == LAND
				and b.Y == LAND
				and c.Y == LAND
				and d.Y == LAND
				and a.X == minX + i * CELL
				and a.Z == z0
				and b.X == minX + (i + 1) * CELL
				and b.Z == z0
				and c.X == minX + i * CELL
				and c.Z == z0 + CELL
				and d.X == minX + (i + 1) * CELL
				and d.Z == z0 + CELL
			then
				runStart = runStart or i
			else
				flush(i)
				if math.max(a.Y, b.Y, c.Y, d.Y) > Seabed.Floor then
					if (i + k) % 2 == 0 then
						face(a, b, c)
						face(b, d, c)
					else
						face(a, b, d)
						face(a, d, c)
					end
				end
			end
		end
		flush(cols)
		task.wait()
	end
end

----------------------------------------------------------------------------------------------------
-- Paths

local function resample(line: { Vector2 }, step: number): { Vector2 }
	local out = { line[1] }
	local carry = 0
	for i = 1, #line - 1 do
		local a, b = line[i], line[i + 1]
		local length = (b - a).Magnitude
		local t = step - carry
		while t <= length do
			table.insert(out, a:Lerp(b, t / length))
			t += step
		end
		carry = length - (t - step)
	end
	return out
end

-- Flat strip of path from `a` to `b` whose top sits `top` above the village ground, with a round
-- joint at `a` so bends join up without gaps. Overlapping pieces must never share a top height or
-- they z-fight: joints sit a step below the strips, and `raised` lets neighbouring strips alternate.
local PATH_STEP = 0.08

local function pathSegment(
	parent: Instance,
	a: Vector2,
	b: Vector2,
	width: number,
	color: Color3,
	material: Enum.Material,
	top: number,
	raised: boolean?
)
	local thickness = 0.6
	if (b - a).Magnitude > 0.5 then
		local y = top + (if raised then PATH_STEP else 0) - thickness / 2
		Props.beam(parent, ground(a, y), ground(b, y), width, color, thickness, material).CastShadow = false
	end
	local joint = Props.cylinder(parent, ground(a, top - PATH_STEP - thickness / 2), thickness, width, color, material)
	joint.CastShadow = false
end

-- Keep the base approach on the same axis as the shop door and zebra crossing.
-- Older maps have an anonymous track aimed at a sampled road point; replace
-- only the matching track pieces, leaving the surrounding village untouched.
local function ensureBaseTrack(village: Instance, base: Model)
	local house = base:FindFirstChild("BaseHouse")
	local frame = house and house:GetAttribute("HouseFrame")
	if typeof(frame) ~= "CFrame" then
		return
	end
	local name = "BaseTrack" .. tostring(base:GetAttribute("BaseId"))
	if village:FindFirstChild(name) then
		return
	end
	local start = (frame :: CFrame) * Vector3.new(0, 0, 19)
	local finish = (frame :: CFrame) * Vector3.new(0, 0, 52)
	for _, item in village:GetChildren() do
		if item:IsA("Part") and item.Material == M.Pebble and item.Color == DIRT then
			local isJoint = item.Shape == Enum.PartType.Cylinder
				and math.abs(item.Size.X - 0.6) < 0.01 and math.abs(item.Size.Y - 9) < 0.01
				and (Vector2.new(item.Position.X, item.Position.Z) - Vector2.new(start.X, start.Z)).Magnitude < 0.1
			local endA = item.CFrame * Vector3.new(0, 0, item.Size.Z / 2)
			local endB = item.CFrame * Vector3.new(0, 0, -item.Size.Z / 2)
			local isTrack = item.Shape == Enum.PartType.Block and math.abs(item.Size.X - 9) < 0.01
				and math.abs(item.Size.Y - 0.6) < 0.01
				and math.min((Vector2.new(endA.X, endA.Z) - Vector2.new(start.X, start.Z)).Magnitude,
					(Vector2.new(endB.X, endB.Z) - Vector2.new(start.X, start.Z)).Magnitude) < 0.1
			if isJoint or isTrack then
				item:Destroy()
			end
		end
	end
	local track = Instance.new("Model")
	track.Name = name
	track.Parent = village
	pathSegment(track, Vector2.new(start.X, start.Z), Vector2.new(finish.X, finish.Z), 9, DIRT, M.Pebble, 0.4)
end

-- True when the whole stretch from `a` to `b` stays on the island, back from the coast and out of
-- the keep-out spots, so a street can run along it.
local function roadClear(shape: Shape, keepOut: { Spot }, a: Vector2, b: Vector2): boolean
	local n = math.max(1, math.ceil((b - a).Magnitude / 6))
	for k = 0, n do
		local m = a:Lerp(b, k / n)
		if not (isInside(shape.coast, m) and coastDistance(shape, m) > 22 and isFree(keepOut, m, 4)) then
			return false
		end
	end
	return true
end

-- Street following the bay shore `offset` inland, as runs of points. It only breaks where it has to
-- (at the coast or a keep-out spot); runs too short to read as a street are left out.
local function buildRoad(
	shape: Shape,
	parent: Instance,
	name: string,
	keepOut: { Spot },
	offset: number,
	width: number,
	top: number
): { Street }
	local points: { RoadPoint } = {}
	for _, s in resample(shape.bayShore, 8) do
		-- Start straight inland from the shore, then settle onto the line that is exactly `offset`
		-- from the nearest shore point; that untangles the fold-backs at tight bends.
		local _, point, tangent = nearestOnLine(shape.bayShore, s)
		local inland = Vector2.new(-tangent.Y, tangent.X)
		if not isInside(shape.coast, point + inland * 10) then
			inland = -inland
		end
		local p = point + inland * offset
		for _ = 1, 4 do
			local _, q = nearestOnLine(shape.bayShore, p)
			p = q + (p - q).Unit * offset
		end
		local _, q = nearestOnLine(shape.bayShore, p)
		inland = (p - q).Unit

		if isInside(shape.coast, p) and coastDistance(shape, p) > 26 and isFree(keepOut, p, 4) then
			local last = points[#points]
			if not last then
				table.insert(points, { position = p, inland = inland })
			elseif (p - last.position).Magnitude >= 7 then
				local heading = if #points >= 2
					then (last.position - points[#points - 1].position).Unit
					else (p - last.position).Unit
				-- Points that land behind the previous one come from the inside of a bend; skip them
				if (p - last.position).Unit:Dot(heading) > -0.2 then
					table.insert(points, { position = p, inland = inland })
				end
			end
		end
	end

	-- Ease out the kinks left where fold-back points were skipped
	for _ = 1, 3 do
		local before = table.clone(points)
		for i = 2, #points - 1 do
			local a, b, c = before[i - 1].position, before[i].position, before[i + 1].position
			if (a - b).Magnitude < 30 and (c - b).Magnitude < 30 then
				points[i] = { position = b * 0.5 + (a + c) * 0.25, inland = before[i].inland }
			end
		end
	end

	-- Neighbours join whenever the whole stretch between them is clear, however far apart the
	-- skipped bend left them; a run only ends where the street has to stop.
	local runs: { Street } = {}
	local run: Street = {}
	for _, p in points do
		local last = run[#run]
		if
			last
			and not (
				(p.position - last.position).Magnitude < 120 and roadClear(shape, keepOut, last.position, p.position)
			)
		then
			table.insert(runs, run)
			run = {}
		end
		table.insert(run, p)
	end
	table.insert(runs, run)

	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	local streets: { Street } = {}
	for _, r in runs do
		local length = 0
		for i = 2, #r do
			length += (r[i].position - r[i - 1].position).Magnitude
		end
		if length < 40 then
			continue
		end
		table.insert(streets, r)
		for i, a in r do
			-- Square the inland direction to the street now that it has been smoothed
			local prev, nxt = r[math.max(i - 1, 1)].position, r[math.min(i + 1, #r)].position
			local normal = Vector2.new(prev.Y - nxt.Y, nxt.X - prev.X).Unit
			a.inland = if normal:Dot(a.inland) < 0 then -normal else normal

			local b = r[i + 1]
			pathSegment(
				model,
				a.position,
				if b then b.position else a.position,
				width,
				ROAD,
				M.Cobblestone,
				top,
				i % 2 == 0
			)
			-- Kerb stones along both edges of the main road
			if width >= ROAD_WIDTH and i % 3 == 0 then
				for _, side in { -1, 1 } do
					local kerb = a.position + a.inland * side * (width / 2 + 0.6)
					Props.part(model, Vector3.new(1.2, 0.8, 1.2), CFrame.new(ground(kerb, 0.3)), QUAY, M.Slate)
				end
			end
		end
	end
	return streets
end

local function nearestRoad(streets: { Street }, p: Vector2): RoadPoint
	local best, point = math.huge, streets[1][1]
	for _, street in streets do
		for _, r in street do
			local d = (r.position - p).Magnitude
			if d < best then
				best, point = d, r
			end
		end
	end
	return point
end

-- Keep houses off a laid path by reserving spots along it.
local function reservePath(spots: { Spot }, a: Vector2, b: Vector2, radius: number)
	local n = math.max(1, math.ceil((b - a).Magnitude / 6))
	for k = 0, n do
		reserve(spots, a:Lerp(b, k / n), radius)
	end
end

----------------------------------------------------------------------------------------------------
-- Beach: umbrellas and loungers on the sand, a lifeguard tower, cabanas and palms along the dunes,
-- boats hauled up at the waterline, surf foam and tide-line clutter, and boardwalks up to the road.

-- Waterline point `along` studs down the beach, and the direction inland from it.
local function beachFrame(shape: Shape, along: number): (Vector2, Vector2)
	local line = shape.beach
	local i = 1
	while i < #line - 1 and along > (line[i + 1] - line[i]).Magnitude do
		along -= (line[i + 1] - line[i]).Magnitude
		i += 1
	end
	local a, b = line[i], line[i + 1]
	local point, out = shoreAt(shape, a:Lerp(b, math.clamp(along / (b - a).Magnitude, 0, 1)))
	return point, -out
end

local function buildSurf(shape: Shape, island: Model, beach: Instance)
	-- Invisible shoreline samples drive the client's moving, soft-edged surf.
	-- No static foam geometry remains on the water when the waves fade out.
	local old = beach:FindFirstChild("Surf")
	if old then
		old:Destroy()
	end
	local surfModel = Instance.new("Model")
	surfModel.Name = "Surf"
	surfModel.Parent = beach
	local length = shape.beachLength
	local function surfaceAt(point: Vector2): Vector3
		return Islands.surface(island, point.X, point.Y) or Vector3.new(point.X, heightAt(shape, point), point.Y)
	end
	local start = BEACH_FADE * 0.65
	for along = start, length - start - 14, 14 do
		local a, inlandA = beachFrame(shape, along)
		local b, inlandB = beachFrame(shape, along + 13)
		local origin = (a + b) / 2
		local source = Instance.new("Part")
		source.Name = "ShoreWaveSource"
		source.Anchored = true
		source.Size = Vector3.new(1, 1, 1)
		source.CFrame = CFrame.new(origin.X, 0, origin.Y)
		source.Transparency = 1
		source.CanCollide = false
		source.CanTouch = false
		source.CanQuery = false
		source.CastShadow = false
		for index, sample in { { a, inlandA }, { b, inlandB } } do
			local point, inland = sample[1], sample[2]
			local surface = surfaceAt(point)
			local runup = surfaceAt(point + inland * 2.8)
			source:SetAttribute("Shore" .. index, Vector3.new(point.X - origin.X, 0, point.Y - origin.Y))
			source:SetAttribute("Inland" .. index, Vector3.new(inland.X, 0, inland.Y))
			source:SetAttribute("WaterHeight" .. index, math.max(0.16, surface.Y + 0.08))
			source:SetAttribute("RunupHeight" .. index, math.max(0.16, runup.Y + 0.08))
		end
		source:SetAttribute("Along", along)
		source:SetAttribute(
			"EdgeFade",
			smoothstep((along - start) / 24) * smoothstep((length - start - along - 13) / 24)
		)
		source.Parent = surfModel
		CollectionService:AddTag(source, "ShoreWaveSource")
	end
	surfModel:SetAttribute("ShoreWavesVersion", 1)
end

local function buildBeach(shape: Shape, island: Model, parent: Instance, spots: { Spot }, rng: Random)
	local model = Instance.new("Model")
	model.Name = "Beach"
	model.Parent = parent
	local length = shape.beachLength
	local function sand(p: Vector2, lift: number?): Vector3
		-- Props sit on the rendered triangles, including the gently uneven dunes.
		local surface = Islands.surface(island, p.X, p.Y)
		return (surface or Vector3.new(p.X, heightAt(shape, p), p.Y)) + Vector3.new(0, lift or 0, 0)
	end
	-- Spot `depth` studs up the beach from the waterline at `along`, and the facing out to sea there
	local function spot(along: number, depth: number): (Vector2, number)
		local point, inland = beachFrame(shape, along)
		local p = point + inland * depth
		return p, facingToward(p, p - inland)
	end

	-- Keep trees and houses off the sand
	for along = BEACH_FADE * 0.6, length - BEACH_FADE * 0.6, 12 do
		local point, inland = beachFrame(shape, along)
		reserve(spots, point + inland * 28, 26)
	end
	buildSurf(shape, island, model)

	-- Landmarks along the strand, as fractions of its length
	local tower = length * 0.5
	local net = length * 0.78
	local cabanas = { length * 0.22, length * 0.36 }
	local walks = { length * 0.3, length * 0.66 }
	local function clearWalk(along: number, radius: number): boolean
		for _, walk in walks do
			if math.abs(along - walk) < radius + 2.5 then
				return false
			end
		end
		return true
	end

	local p, facing = spot(tower, 30)
	Props.lifeguardTower(model, sand(p), facing)
	p, facing = spot(net, 26)
	Props.volleyballNet(model, sand(p), facing)

	-- Umbrella pitches: an umbrella with a lounger or two beside it and maybe a towel in front
	for along = BEACH_FADE + 8, length - BEACH_FADE - 8, 22 do
		if math.abs(along - tower) < 16 or math.abs(along - net) < 18 or not clearWalk(along, 10) then
			continue
		end
		local depth = rng:NextNumber(16, 28)
		local color = pick(rng, BEACH_COLORS)
		local point, inland = beachFrame(shape, along + rng:NextNumber(-4, 4))
		local side = Vector2.new(-inland.Y, inland.X)
		local base = point + inland * depth
		local seaward = facingToward(base, base - inland)
		Props.beachUmbrella(model, sand(base), rng, color)
		for k = 1, rng:NextInteger(1, 2) do
			local s = if k == 1 then -1 else 1
			local loungerAt = base + side * s * 3.2 + inland * 1.5
			Props.sunLounger(model, sand(loungerAt), seaward + rng:NextNumber(-0.15, 0.15), pick(rng, BEACH_COLORS))
		end
		if rng:NextNumber() < 0.55 then
			local towelAt = base - inland * rng:NextNumber(6, 9) + side * rng:NextNumber(-3, 3)
			local _, normal = Islands.surface(island, towelAt.X, towelAt.Y)
			Props.towel(
				model,
				sand(towelAt, 0.08),
				seaward + rng:NextNumber(-0.5, 0.5),
				pick(rng, BEACH_COLORS),
				normal
			)
		end
	end

	-- Changing cabanas in a row at the foot of the dunes
	for _, from in cabanas do
		for k = 0, 3 do
			local at, face = spot(from + k * 8, 46)
			Props.cabana(model, sand(at, -0.3), face, BEACH_COLORS[(k % #BEACH_COLORS) + 1])
			reserve(spots, at, 5)
		end
	end

	-- Palms and dune grass along the top of the sand
	for along = BEACH_FADE, length - BEACH_FADE, 16 do
		if not clearWalk(along, 10) then
			continue
		end
		local inCabanas = false
		for _, from in cabanas do
			inCabanas = inCabanas or (along > from - 8 and along < from + 32)
		end
		local at = spot(along + rng:NextNumber(-5, 5), rng:NextNumber(48, 55))
		if not inCabanas and rng:NextNumber() < 0.7 then
			Props.palm(model, sand(at), rng)
			reserve(spots, at, 4)
		end
		local tuft = spot(along + rng:NextNumber(-8, 8), rng:NextNumber(40, 52))
		Props.bush(model, sand(tuft, -0.6), rng, DUNE_GRASS)
	end

	-- Boardwalks from the road down over the dunes onto the sand
	for _, along in walks do
		local point, inland = beachFrame(shape, along)
		local foot, top, road = point + inland * 32, point + inland * (BEACH_WIDTH + 16), point + inland * ROAD_OFFSET
		Props.beam(model, sand(foot, 0.3), sand(top, 0.3), 4.5, DECK, 0.5, M.WoodPlanks)
		Props.beam(model, ground(top, 0.3), ground(road, 0.3), 4.5, DECK, 0.5, M.WoodPlanks)
		local side = Vector2.new(-inland.Y, inland.X)
		for _, s in { -1, 1 } do
			local edge = side * s * 2.6
			Props.fence(model, sand(foot + edge + inland * 4), sand(top + edge))
		end
		reservePath(spots, top, road, 5)
	end

	-- Boats hauled up on the sand
	for _, along in { length * 0.14, length * 0.42, length * 0.58 } do
		local at, face = spot(along, rng:NextNumber(7, 10))
		Med.boat(model, sand(at, 0.4), face + rng:NextNumber(-0.4, 0.4), rng, pick(rng, BOATS))
	end
	-- Sandcastles and loose beach balls near the water
	for _, along in { length * 0.33, length * 0.7 } do
		local at = spot(along + rng:NextNumber(-6, 6), rng:NextNumber(9, 13))
		Props.sandcastle(model, sand(at), BEACH_SAND:Lerp(WET_SAND, 0.4))
	end
	for _ = 1, 3 do
		local at = spot(rng:NextNumber(BEACH_FADE + 10, length - BEACH_FADE - 10), rng:NextNumber(12, 30))
		Props.beachBall(model, sand(at))
	end

	-- Tide line: seaweed, shells and driftwood
	for _ = 1, 14 do
		local at = spot(rng:NextNumber(BEACH_FADE, length - BEACH_FADE), rng:NextNumber(1.5, 5))
		Props.seaweed(model, sand(at), rng)
	end
	for _ = 1, 12 do
		local at = spot(rng:NextNumber(BEACH_FADE, length - BEACH_FADE), rng:NextNumber(3, 14))
		Props.shells(model, sand(at), rng)
	end
	for _ = 1, 6 do
		local at = spot(rng:NextNumber(BEACH_FADE, length - BEACH_FADE), rng:NextNumber(8, 18))
		Props.driftwood(model, sand(at), rng)
	end
	BeachDetails.build(model, rng, length, function(along: number): (Vector2, Vector2)
		return beachFrame(shape, along)
	end, sand)
end

----------------------------------------------------------------------------------------------------
-- Player bases: a stone quay plot on the shore with two piers reaching into the bay

local DOCK_DETAIL_VERSION = 2

local function ensureDockAccess(base: Model, frame: CFrame)
	local existing = base:FindFirstChild("DockAccess")
	if existing and existing:GetAttribute("LayoutVersion") == 2 then
		return
	end
	if existing then
		existing:Destroy()
	end
	-- Remove only the original raised blocks on maps saved before ramps existed.
	for _, item in base:GetChildren() do
		if item:IsA("BasePart") then
			local p = frame:PointToObjectSpace(item.Position)
			if
				(item.Size - Vector3.new(7, 2.6, 3.2)).Magnitude < 0.01
				and math.abs(math.abs(p.X) - 17) < 0.01
				and math.abs(p.Y - 3.1) < 0.01
				and math.abs(p.Z - 6.4) < 0.01
			then
				item:Destroy()
			end
		end
	end
	local access = Instance.new("Model")
	access.Name = "DockAccess"
	local wood = Color3.fromRGB(133, 96, 62)
	local worn = Color3.fromRGB(158, 122, 81)
	local dark = Color3.fromRGB(77, 55, 39)
	local iron = Color3.fromRGB(52, 50, 48)
	local rope = Color3.fromRGB(176, 150, 106)
	local rise, run, thickness = 2.7, 8, 0.4
	local length = math.sqrt(run * run + rise * rise)
	local slope = CFrame.Angles(-math.atan2(rise, run), 0, 0)
	for _, side in { -1, 1 } do
		local gangway = Instance.new("Model")
		gangway.Name = if side < 0 then "LeftGangway" else "RightGangway"
		gangway.Parent = access
		local center = frame * CFrame.new(side * 17, 4.55, 4) * slope
		local function piece(
			name: string,
			size: Vector3,
			cf: CFrame,
			color: Color3,
			material: Enum.Material,
			decorative: boolean?
		): Part
			local part = Props.part(gangway, size, cf, color, material)
			part.Name = name
			if decorative then
				part.CanCollide, part.CanQuery = false, false
			end
			return part
		end
		-- A continuous collider carries players and NPCs across the narrow plank seams.
		-- Its top still meets the pier at y=3.2 and the quay at y=5.9.
		local ramp = piece(
			"DockRamp",
			Vector3.new(7, thickness, length + 0.2),
			center * CFrame.new(0, -thickness / 2, 0),
			wood,
			M.Wood
		)
		ramp.Transparency = 1
		ramp.CastShadow = false
		local count = 10
		local pitch = (length + 0.2) / count
		for i = 1, count do
			local z = (i - (count + 1) / 2) * pitch
			piece(
				"GangwayPlank",
				Vector3.new(7, thickness, pitch - 0.035),
				center * CFrame.new(0, -thickness / 2, z),
				wood:Lerp(worn, (i % 3) * 0.2),
				M.Wood,
				true
			)
		end
		for _, edge in { -1, 1 } do
			piece(
				"Stringer",
				Vector3.new(0.5, 0.8, length + 0.3),
				center * CFrame.new(edge * 3.15, -0.7, 0),
				dark,
				M.Wood,
				true
			)
			local x = side * 17 + edge * 3.9
			for _, z in { 0.4, 7.8, 10.6 } do
				local y = 3.2 + rise * math.min(z, run) / run
				piece("RailPost", Vector3.new(0.55, 3.1, 0.55), frame * CFrame.new(x, y + 1.3, z), dark, M.Wood)
				piece("PostCap", Vector3.new(0.7, 0.12, 0.7), frame * CFrame.new(x, y + 2.91, z), worn, M.Wood, true)
				piece(
					"PostCollar",
					Vector3.new(0.57, 0.18, 0.57),
					frame * CFrame.new(x, y + 0.45, z),
					iron,
					M.Metal,
					true
				)
			end
			for _, span in { { 0.4, 7.8 }, { 7.8, 10.6 } } do
				for _, rail in { { 2.65, 0.24, wood, M.Wood, "Handrail" }, { 1.35, 0.16, rope, M.Fabric, "RopeRail" } } do
					local function at(z: number): Vector3
						return frame * Vector3.new(x, 3.2 + rise * math.min(z, run) / run + rail[1], z)
					end
					local beam = Props.beam(gangway, at(span[1]), at(span[2]), rail[2], rail[3], nil, rail[4])
					beam.Name = rail[5]
					beam.CanCollide, beam.CanQuery = false, false
				end
			end
		end
		-- A short boarded apron bridges the coloured quay lip onto the base deck.
		local landing =
			piece("QuayLanding", Vector3.new(7, 0.3, 2.8), frame * CFrame.new(side * 17, 5.76, 9.4), dark, M.Wood)
		landing.Transparency = 1
		landing.CastShadow = false
		for i = 1, 4 do
			piece(
				"LandingPlank",
				Vector3.new(7, 0.3, 0.665),
				frame * CFrame.new(side * 17, 5.76, 8 + (i - 0.5) * 0.7),
				wood:Lerp(worn, (i % 3) * 0.2),
				M.Wood,
				true
			)
		end
		for _, z in { 0.6, 6.9 } do
			local y = 3.2 + rise * z / run
			piece(
				"Bearer",
				Vector3.new(8.4, 0.55, 0.65),
				frame * CFrame.new(side * 17, y - 1.05, z),
				dark,
				M.Wood,
				true
			)
		end
	end
	access:SetAttribute("LayoutVersion", 2)
	access.Parent = base
end

-- A short stone staircase connects the quay to the shore between its two piers.
-- This is independent of the dock version so already-saved bases receive it too.
local function ensureBeachStairs(base: Model, frame: CFrame)
	if base:FindFirstChild("BeachStairs") then
		return
	end
	-- The original centre bollard sits directly in the path onto the deck.
	for _, item in base:GetChildren() do
		if item:IsA("BasePart") then
			local p = frame:PointToObjectSpace(item.Position)
			if (item.Size - Vector3.new(1.6, 1.4, 1.4)).Magnitude < 0.01
				and (p - Vector3.new(0, 6.7, 9)).Magnitude < 0.01
			then
				item:Destroy()
			end
		end
	end
	local stairs = Instance.new("Model")
	stairs.Name = "BeachStairs"
	for i = 1, 7 do
		local top = 5.9 * i / 7
		local height = top + 0.2
		local step = Props.part(
			stairs,
			Vector3.new(7, height, 1.2),
			frame * CFrame.new(0, (top - 0.2) / 2, 0.4 + (i - 0.5) * 1.2),
			QUAY,
			M.Cobblestone
		)
		step.Name = "Step"
	end
	stairs.Parent = base
end

-- The legacy post extended through the lower half of the board and obscured both faces.
local function ensureDockSign(base: Model)
	local board = base:FindFirstChild("NameBoard")
	if not board or not board:IsA("BasePart") then
		return
	end
	for _, item in base:GetChildren() do
		if not item:IsA("BasePart") then
			continue
		end
		local legacyPost = (item.Size - Vector3.new(0.6, 6, 0.6)).Magnitude < 0.01
			and (board.CFrame:PointToObjectSpace(item.Position) - Vector3.new(0, -3, 0)).Magnitude < 0.01
		if item.Name == "DockSignPost" or legacyPost then
			item.Name = "DockSignPost"
			item.Size = Vector3.new(0.6, 4.5, 0.6)
			item.CFrame = board.CFrame * CFrame.new(0, -3.75, 0)
		end
	end
end

local function buildBaseDocks(base: Model, frame: CFrame, index: number)
	-- Cosmetic variation has its own stream, so adding joinery never moves village props.
	local rng = Random.new(82417 + index * 997)
	for _, side in { -1, 1 } do
		Props.dock(base, (frame * CFrame.new(side * 17, 0, 5)).Position, frame.LookVector, 48, rng, {
			innerSide = -side,
			junctionStart = 40,
			junctionEnd = 46.8,
		})
	end
	Props.dockLink(base, frame * CFrame.new(0, 3, -38), rng)
	ensureDockAccess(base, frame)
	ensureBeachStairs(base, frame)
	base:SetAttribute("DockDetailVersion", DOCK_DETAIL_VERSION)
end

local function buildBase(
	shape: Shape,
	parent: Instance,
	index: number,
	anchor: Vector2,
	rng: Random
): (Vector2, Vector2)
	local shore, toWater = shoreAt(shape, anchor)
	local origin = Vector3.new(shore.X, 0, shore.Y)
	local forward = Vector3.new(toWater.X, 0, toWater.Y)
	local frame = CFrame.lookAt(origin, origin + forward)
	-- f: studs toward the water (negative = inland), r: studs to the right when facing the water
	local function cf(f: number, r: number, y: number): CFrame
		return frame * CFrame.new(r, y, -f)
	end
	local function at(f: number, r: number, y: number): Vector3
		return cf(f, r, y).Position
	end

	local accent = ACCENTS[(index - 1) % #ACCENTS + 1]
	local top = LAND + 0.5
	local deck = top + 0.4
	local facing = math.atan2(forward.X, forward.Z)

	local m = Instance.new("Model")
	m.Name = "Base" .. index
	m:SetAttribute("BaseId", index)
	m:SetAttribute("OwnerUserId", 0)
	m:SetAttribute("BoatDockFrame", frame)
	CollectionService:AddTag(m, Harbour.BASE_TAG)
	m.Parent = parent

	-- Stone quay with a plank deck, edged in the owner's colour
	Props.part(m, Vector3.new(58, 9, 52), cf(-34, 0, top - 4.5), QUAY, M.Cobblestone)
	Props.part(m, Vector3.new(55, 0.4, 49), cf(-34.5, 0, top + 0.2), DECK, M.WoodPlanks)
	Props.part(m, Vector3.new(58.4, 1, 1.2), cf(-8, 0, top - 0.3), accent, M.WoodPlanks)
	for _, r in { -29, 29 } do
		Props.part(m, Vector3.new(1.2, 1, 52), cf(-34, r, top - 0.3), accent, M.WoodPlanks)
	end
	-- Mooring bollards along the front
	for r = -24, 24, 12 do
		if math.abs(r) ~= 12 then
			Props.cylinder(m, at(-9, r, deck + 0.8), 1.6, 1.4, rgb(52, 50, 48), M.Metal)
		end
	end

	-- Ramps connect the quay to the two boarded piers without a jump.
	buildBaseDocks(m, frame, index)

	-- Keep the legacy prop builders' RNG draws: the beach and village share this
	-- seeded stream. BaseHouse.ensure replaces these props below, so upgrading
	-- the house does not also reshuffle the rest of the island.
	local hut = Props.fishingHut(m, at(-44, 10, deck), facing, rng, accent)
	hut.Name = "Hut"
	local pad = Props.cylinder(m, at(-26, -12, deck + 0.15), 0.3, 11, accent, M.Neon)
	pad.Name = "ClaimPad"
	-- Retain the plot reference and accent without a visible circle on the deck.
	pad.Transparency = 1
	pad.CanCollide = false
	pad.CanTouch = false
	pad.CanQuery = false
	m.PrimaryPart = pad

	-- Name board facing both ways; BaseService writes the owner's name on it
	local signPost = Props.part(m, Vector3.new(0.6, 4.5, 0.6), cf(-11, -22, deck + 2.25), rgb(78, 60, 46), M.Wood)
	signPost.Name = "DockSignPost"
	local board = Props.part(m, Vector3.new(7, 3, 0.4), cf(-11, -22, deck + 6), rgb(122, 92, 64), M.WoodPlanks)
	board.Name = "NameBoard"
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.Garamond
		label.TextScaled = true
		label.TextColor3 = rgb(245, 238, 220)
		label.Text = "Base " .. index
		label.Parent = gui
		gui.Parent = board
	end

	local flagAt = at(-56, -25, deck)
	Props.flag(m, flagAt, accent)
	Props.lampPost(m, at(-10.5, 27, deck))
	Props.lampPost(m, at(-10.5, -27, deck))
	-- Festoon lights from the flagpole to the lamps, like a little fairground over the quay
	Props.stringLights(m, flagAt + Vector3.new(0, 14, 0), at(-10.5, -27, deck + 10.6), rng)
	Props.stringLights(m, at(-10.5, -27, deck + 10.6), at(-10.5, 27, deck + 10.6), rng)
	Props.crates(m, at(-15, 22, deck), rng)
	Props.barrel(m, at(-19, 25, deck), rng)
	Props.barrel(m, at(-15.5, 25.5, deck), rng)
	Props.crabPot(m, at(-21, 18, deck), rng)
	Props.crabPot(m, at(-14, -4, deck), rng)
	Props.ropeCoil(m, at(-12, 6, deck))
	Props.fishRack(m, at(-38, -21, deck), facing + math.pi / 2, rng)
	Props.bench(m, at(-30, -24, deck), facing - math.pi / 2)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "SpawnPoint"
	spawn.Anchored = true
	spawn.Size = Vector3.new(5, 0.2, 5)
	spawn.CFrame = cf(-26, 4, deck + 0.2)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.CanQuery = false
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = m
	Drydock.ensureDock(m)
	BaseHouse.ensure(m)

	local center = at(-34, 0, 0)
	local back = at(-62, 0, 0)
	return Vector2.new(center.X, center.Z), Vector2.new(back.X, back.Z)
end

-- Each base's shop stands across the ring road from its house (BaseHouse builds it). Village
-- houses, lamps and cross streets generated over that plot are cleared afterwards, on baked maps
-- too, so the seeded stream that laid out the rest of the village is left untouched.
local SHOP_PLOT_VERSION = 1
local SHOP_PLOT = { -26.5, 60, 26.5, 84.8 } -- house-local x1, z1, x2, z2: forecourt to back eaves

-- Separating-axis test between a (possibly turned) box and the plot, in the house's floor plane.
-- `rect` overrides the plot with another house-local x1, z1, x2, z2 area.
local function overlapsShopPlot(frame: CFrame, box: CFrame, size: Vector3, rect: { number }?): boolean
	local plot = rect or SHOP_PLOT
	local center = frame:PointToObjectSpace(box.Position)
	local offset = Vector2.new(center.X - (plot[1] + plot[3]) / 2, center.Z - (plot[2] + plot[4]) / 2)
	local plotHalf = Vector2.new((plot[3] - plot[1]) / 2, (plot[4] - plot[2]) / 2)
	local reaches = {}
	for _, vector in { box.RightVector * size.X / 2, box.UpVector * size.Y / 2, box.LookVector * size.Z / 2 } do
		local flat = frame:VectorToObjectSpace(vector)
		table.insert(reaches, Vector2.new(flat.X, flat.Z))
	end
	local axes = { Vector2.new(1, 0), Vector2.new(0, 1) }
	for _, reach in reaches do
		if reach.Magnitude > 1e-3 then
			table.insert(axes, reach.Unit)
		end
	end
	for _, axis in axes do
		local boxReach = 0
		for _, reach in reaches do
			boxReach += math.abs(reach:Dot(axis))
		end
		if math.abs(offset:Dot(axis)) >= boxReach + math.abs(axis.X) * plotHalf.X + math.abs(axis.Y) * plotHalf.Y then
			return false
		end
	end
	return true
end

local function clearShopPlots(island: Instance)
	local bases = island:FindFirstChild("Bases")
	local village = island:FindFirstChild("Village")
	if island:GetAttribute("ShopPlotVersion") == SHOP_PLOT_VERSION or not bases or not village then
		return
	end
	local frames = {}
	for _, base in bases:GetChildren() do
		local house = base:FindFirstChild("BaseHouse")
		local frame = house and house:GetAttribute("HouseFrame")
		if typeof(frame) == "CFrame" then
			table.insert(frames, frame)
		end
	end
	for _, group in { village:FindFirstChild("Houses"), village:FindFirstChild("CrossStreets") } do
		for _, item in if group then group:GetChildren() else {} do
			local box, size
			if item:IsA("Model") then
				box, size = item:GetBoundingBox()
			elseif item:IsA("BasePart") then
				box, size = item.CFrame, item.Size
			else
				continue
			end
			for _, frame in frames do
				if overlapsShopPlot(frame, box, size) then
					item:Destroy()
					break
				end
			end
		end
	end
	island:SetAttribute("ShopPlotVersion", SHOP_PLOT_VERSION)
end

-- The shop plot assumes the ring road runs straight along house-local z = 52 (ROAD_OFFSET inland
-- of the dock). Where the bay shore bends the generated road drifts off that line and can run
-- through the shop (base 9). Such stretches are cut out and re-laid along z = 52, over the zebra
-- crossing, with links back to the surviving road on each side.
local SHOP_ROAD_VERSION = 1
local SHOP_ROAD_TRIGGER = { -26.5, 61.5, 26.5, 84.8 } -- road reaching the forecourt or the shop
local SHOP_ROAD_CLEAR = { -28, 43, 28, 86 } -- the road band in front of the shop plus the plot
local SHOP_ROAD_Z = 52
local SHOP_ROAD_TOP = 0.64 -- between the ring road's two strip heights, below the zebra stripes

local function textOf(item: Instance): string?
	local label = item:FindFirstChildWhichIsA("TextLabel", true)
	return label and label.Text
end

local function detourShopRoad(village: Instance, road: Instance, base: Model, frame: CFrame)
	local function toLocal(p: Vector3): Vector2
		local l = frame:PointToObjectSpace(p)
		return Vector2.new(l.X, l.Z)
	end
	local function toWorld(p: Vector2): Vector2
		local w = frame * Vector3.new(p.X, 0, p.Y)
		return Vector2.new(w.X, w.Z)
	end

	-- Cut every road piece over the shop and the band in front of it, remembering strip ends.
	local cut, kept = {}, {}
	for _, piece in road:GetChildren() do
		if not piece:IsA("Part") then
			continue
		end
		local ends = {}
		if piece.Shape == Enum.PartType.Block and math.abs(piece.Size.X - ROAD_WIDTH) < 0.01 then
			ends = { piece.CFrame * Vector3.new(0, 0, piece.Size.Z / 2), piece.CFrame * Vector3.new(0, 0, -piece.Size.Z / 2) }
		elseif piece.Shape == Enum.PartType.Cylinder and math.abs(piece.Size.Y - ROAD_WIDTH) < 0.01 then
			ends = { piece.Position }
		end
		local removed = overlapsShopPlot(frame, piece.CFrame, piece.Size, SHOP_ROAD_CLEAR)
		for _, e in ends do
			table.insert(if removed then cut else kept, toLocal(e))
		end
		if removed then
			piece:Destroy()
		end
	end
	-- Gates: where a surviving strip ended on a piece that was cut.
	local gates: { Vector2 } = {}
	for _, p in cut do
		for _, q in kept do
			if (p - q).Magnitude < 0.5 then
				local seen = false
				for _, g in gates do
					seen = seen or (g - q).Magnitude < 1
				end
				if not seen then
					table.insert(gates, q)
				end
				break
			end
		end
	end

	-- A link is clear when the whole strip stays half a road width off the shop plot.
	local function clear(a: Vector2, b: Vector2): boolean
		local steps = math.max(1, math.ceil((b - a).Magnitude))
		for k = 0, steps do
			local p = a:Lerp(b, k / steps)
			local dx = math.max(SHOP_PLOT[1] - p.X, 0, p.X - SHOP_PLOT[3])
			local dz = math.max(SHOP_PLOT[2] - p.Y, 0, p.Y - SHOP_PLOT[4])
			if dx * dx + dz * dz < (ROAD_WIDTH / 2) ^ 2 then
				return false
			end
		end
		return true
	end
	-- One gate per side: the frontier nearest the new stretch (a strip can survive just past a cut joint).
	local reach = { [-1] = SHOP_ROAD_CLEAR[3], [1] = SHOP_ROAD_CLEAR[3] }
	local nearest: { [number]: Vector2 } = {}
	for _, gate in gates do
		local side = if gate.X < 0 then -1 else 1
		local target = Vector2.new(side * reach[side], SHOP_ROAD_Z)
		if not nearest[side] or (gate - target).Magnitude < (nearest[side] - target).Magnitude then
			nearest[side] = gate
		end
	end
	local links = {}
	for side, gate in nearest do
		local x = reach[side]
		while x < 90 and not clear(gate, Vector2.new(side * x, SHOP_ROAD_Z)) do
			x += 2
		end
		reach[side] = x
		table.insert(links, { gate = gate, side = side })
	end

	local segments = {}
	local function lay(a: Vector2, b: Vector2)
		pathSegment(road, toWorld(a), toWorld(b), ROAD_WIDTH, ROAD, M.Cobblestone, SHOP_ROAD_TOP)
		table.insert(segments, { a, b })
	end
	local west, east = Vector2.new(-reach[-1], SHOP_ROAD_Z), Vector2.new(reach[1], SHOP_ROAD_Z)
	lay(west, east)
	lay(east, east)
	for _, link in links do
		lay(link.gate, Vector2.new(link.side * reach[link.side], SHOP_ROAD_Z))
	end

	-- Clear village houses and small props off the new stretch.
	local function onNewRoad(box: CFrame, size: Vector3): boolean
		for _, s in segments do
			local a, b = s[1], s[2]
			local length = (b - a).Magnitude
			local along = if length > 0.5 then (b - a).Unit else Vector2.new(1, 0)
			local mid = (a + b) / 2
			-- Express the strip as its own frame inside the house frame.
			local strip = frame * CFrame.lookAt(Vector3.new(mid.X, 0, mid.Y), Vector3.new(mid.X + along.X, 0, mid.Y + along.Y))
			local half = ROAD_WIDTH / 2
			if overlapsShopPlot(strip, box, size, { -half, -length / 2 - half, half, length / 2 + half }) then
				return true
			end
		end
		return false
	end
	local baseSign = "Base " .. tostring(base:GetAttribute("BaseId"))
	local candidates = {}
	local houses = village:FindFirstChild("Houses")
	for _, item in if houses then houses:GetChildren() else {} do
		table.insert(candidates, item)
	end
	for _, item in village:GetChildren() do
		if item:IsA("Model") and item.Name == "Signpost" and textOf(item) == baseSign then
			item:Destroy() -- re-placed beside the new junction below
		elseif item:IsA("Model") and #item:GetChildren() < 40 and string.sub(item.Name, 1, 9) ~= "BaseTrack"
			and item ~= road and item ~= houses and item.Name ~= "Lane" and item.Name ~= "CrossStreets" and item.Name ~= "Plaza" then
			table.insert(candidates, item)
		end
	end
	for _, item in candidates do
		local box, size
		if item:IsA("Model") then
			box, size = item:GetBoundingBox()
		elseif item:IsA("BasePart") then
			box, size = item.CFrame, item.Size
		else
			continue
		end
		if onNewRoad(box, size) then
			item:Destroy()
		end
	end
	local signAt = toWorld(Vector2.new(7, SHOP_ROAD_Z - ROAD_WIDTH / 2 - 2))
	Props.signpost(village, ground(signAt), facingToward(signAt, toWorld(Vector2.new(0, 19))) - math.pi / 2, { { baseSign, 0 } })
end

local function rerouteShopRoads(island: Instance)
	local bases = island:FindFirstChild("Bases")
	local village = island:FindFirstChild("Village")
	local road = village and village:FindFirstChild("Road")
	if island:GetAttribute("ShopRoadVersion") == SHOP_ROAD_VERSION or not bases or not road then
		return
	end
	for _, base in bases:GetChildren() do
		local house = base:IsA("Model") and base:FindFirstChild("BaseHouse")
		local frame = house and house:GetAttribute("HouseFrame")
		if typeof(frame) ~= "CFrame" then
			continue
		end
		for _, piece in road:GetChildren() do
			if piece:IsA("BasePart") and overlapsShopPlot(frame, piece.CFrame, piece.Size, SHOP_ROAD_TRIGGER) then
				detourShopRoad(village, road, base :: Model, frame)
				break
			end
		end
	end
	island:SetAttribute("ShopRoadVersion", SHOP_ROAD_VERSION)
end
----------------------------------------------------------------------------------------------------
-- Village

-- The piazza: a domed church and bell tower along the north side flanked by shops, a two-tier
-- fountain in the middle, a café under a pergola to the west and market stalls to the east.
-- The bay lies to the south (+Z), so the buildings face that way; the ring road crosses the south side.
local function buildPlaza(parent: Instance, center: Vector2, rng: Random)
	local model = Instance.new("Model")
	model.Name = "Plaza"
	model.Parent = parent
	local function at(x: number, z: number, lift: number?): Vector3
		return ground(center + Vector2.new(x, z), lift)
	end
	local function slab(size: Vector3, x: number, z: number, lift: number, color: Color3, material: Enum.Material)
		Props.part(model, size, CFrame.new(at(x, z, lift)), color, material).CastShadow = false
	end
	local size = PLAZA_HALF * 2
	local pavingSize = size - 4

	-- Pale limestone laid in a grid of darker bands, edged with a kerb, with a ring round the fountain
	-- The curb owns the outside faces; paving and inlays stop at its inner edge.
	slab(Vector3.new(pavingSize, 0.6, pavingSize), 0, 0, 0.5, PAVING, M.Limestone)
	for k = -2, 2 do
		-- Each crossing belongs to the north/south band. The other band butts up
		-- against it, instead of placing two differently textured faces on one plane.
		slab(Vector3.new(1.4, 0.12, pavingSize), k * 24, 0, 0.86, PAVING_DARK, M.Cobblestone)
		local from = -PLAZA_HALF + 2
		for crossing = -2, 3 do
			local edge = if crossing == 3 then PLAZA_HALF - 2 else crossing * 24 - 0.7
			slab(Vector3.new(edge - from, 0.12, 1.4), (from + edge) / 2, k * 24, 0.86, PAVING_DARK, M.Cobblestone)
			from = edge + 1.4
		end
	end
	for _, e in { -1, 1 } do
		slab(Vector3.new(size, 0.8, 2), 0, e * (PLAZA_HALF - 1), 0.64, PAVING_DARK, M.Slate)
		slab(Vector3.new(2, 0.8, size - 4), e * (PLAZA_HALF - 1), 0, 0.64, PAVING_DARK, M.Slate)
	end
	model:SetAttribute("PlazaPavingVersion", 2)
	Props.cylinder(model, at(0, 0, 0.7), 0.7, 40, PAVING_DARK, M.Cobblestone).CastShadow = false
	Props.cylinder(model, at(0, 0, 0.8), 0.7, 36, PAVING, M.Limestone).CastShadow = false
	Med.fountain(model, at(0, 0, 1.15))
	for _, offset in { Vector2.new(0, -16.5), Vector2.new(0, 16.5), Vector2.new(-16.5, 0), Vector2.new(16.5, 0) } do
		Med.pot(model, at(offset.X, offset.Y, 0.95), rng, "flowers")
	end
	for _, offset in { Vector2.new(-14, -14), Vector2.new(14, -14), Vector2.new(14, 14), Vector2.new(-14, 14) } do
		local p = center + offset
		Props.bench(model, ground(p, 0.95), facingToward(p, center))
	end

	-- North side: church, campanile and two shops, all facing the fountain
	Med.chapel(model, at(0, -40, 0.8), 0, rng, 1.5)
	Med.bellTower(model, at(-19, -47, 0.8), 0, rng)
	for _, x in { -42, 42 } do
		Med.townhouse(model, at(x, -47, 0.8), 0, rng, true)
	end
	for _, x in { -14, 14 } do
		Med.cypress(model, at(x, -24, 0.8), rng, rng:NextNumber(19, 23))
	end

	-- West: café tables under a vine-covered pergola, and a few more out in the sun
	Med.pergola(model, at(-42, -4, 0.8), 0, rng, 18, 22)
	for _, offset in { Vector2.new(-46.5, -9), Vector2.new(-37.5, -9), Vector2.new(-46.5, 2), Vector2.new(-37.5, 2) } do
		Med.cafeTable(model, at(offset.X, offset.Y, 0.8), rng)
	end
	local parasols = { rgb(36, 92, 168), rgb(180, 52, 44), rgb(56, 120, 70) }
	for i, offset in { Vector2.new(-25, -11), Vector2.new(-26, 9), Vector2.new(-24, 30) } do
		Med.cafeTable(model, at(offset.X, offset.Y, 0.8), rng, parasols[i])
	end
	for _, z in { -17, 9 } do
		Med.pot(model, at(-53, z, 0.8), rng, "lemon")
	end

	-- East: a row of market stalls facing across the square
	local canopies = { rgb(180, 52, 44), rgb(36, 92, 168), rgb(56, 120, 70), rgb(214, 160, 50) }
	for i, z in { -18, -6, 6, 18 } do
		local p = center + Vector2.new(44, z)
		Props.stall(model, ground(p, 0.8), facingToward(p, Vector2.new(center.X, p.Y)), rng, canopies[i])
		if i % 2 == 0 then
			Props.barrel(model, ground(p + Vector2.new(8, 3), 0.8), rng)
		end
	end

	-- South: a promenade of palms, benches looking out over the bay, and olive planters
	for _, x in { -34, -10, 10, 34 } do
		Props.palm(model, at(x, 52, 0.8), rng)
	end
	for _, x in { -22, 0, 22 } do
		Props.bench(model, at(x, 54, 0.8), 0)
	end
	for _, x in { -46, 46 } do
		Med.planter(model, at(x, 51, 0.8), rng, "olive")
	end

	-- Lamps round the edge with festoons strung between them and across the square
	local lamps = {}
	for _, x in { -56, 56 } do
		for _, z in { -18, 22, 56 } do
			Props.lampPost(model, at(x, z, 0.8))
			lamps[`{x},{z}`] = at(x, z, 12.4)
		end
	end
	local function festoon(a: string, b: string, sag: number?)
		Props.stringLights(model, lamps[a], lamps[b], rng, sag)
	end
	festoon("-56,-18", "-56,22")
	festoon("-56,22", "-56,56")
	festoon("56,-18", "56,22")
	festoon("56,22", "56,56")
	festoon("-56,56", "56,56", 3)
	festoon("-56,-18", "56,-18", 2)
	festoon("-56,22", "56,22", 2)
	Drydock.build(model, CFrame.new(at(0, 0, 0.8)))
	RodShop.build(model, CFrame.new(at(0, 0, 0.8)))
	FurnitureShop.build(model, CFrame.new(at(0, 0, 0.8)))
	BackpackShop.build(model, CFrame.new(at(0, 0, 0.8)))
end

local HOUSE_HALF = { cube = 14, town = 10, villa = 15, green = 9 } -- half the frontage along the street
local HOUSE_FRONT = { cube = 10, town = 9, villa = 16, green = 4 } -- how far the doorstep sits from the middle
local RING_KINDS = { { "cube", 0.4 }, { "town", 0.35 }, { "villa", 0.15 }, { "green", 0.1 } }
local LANE_KINDS = { { "cube", 0.5 }, { "town", 0.42 }, { "green", 0.08 } }

local function rollKind(kinds: { { any } }, rng: Random): string
	local roll = rng:NextNumber()
	for _, k in kinds do
		roll -= k[2]
		if roll <= 0 then
			return k[1]
		end
	end
	return kinds[#kinds][1]
end

-- Points every `step` studs along a street, each with the direction away from the bay.
local function streetFrames(street: Street, step: number): { RoadPoint }
	local frames = {}
	for i = 1, #street - 1 do
		local a, b = street[i], street[i + 1]
		local n = math.max(1, math.floor((b.position - a.position).Magnitude / step))
		for k = 0, n - 1 do
			local t = k / n
			table.insert(
				frames,
				{ position = a.position:Lerp(b.position, t), inland = a.inland:Lerp(b.inland, t).Unit }
			)
		end
	end
	return frames
end

-- One house (or a little green) at `p` with its front to the street at `toward`, and a bit of
-- life round the doorstep and sometimes a walled yard out back.
local function placeHouse(
	shape: Shape,
	model: Instance,
	kind: string,
	p: Vector2,
	toward: Vector2,
	lane: boolean,
	spots: { Spot },
	rng: Random
)
	local half = HOUSE_HALF[kind]
	local toStreet = (toward - p).Unit
	local across = Vector2.new(-toStreet.Y, toStreet.X)
	local facing = facingToward(p, toward) + rng:NextNumber(-0.04, 0.04)
	reserve(spots, p, 10)
	for _, s in { -1, 1 } do
		reserve(spots, p + across * s * (half - 5), 6)
	end

	if kind == "green" then
		if lane and rng:NextNumber() < 0.5 then
			Med.vineyard(model, ground(p), facing, rng, 16, 14)
		else
			-- A small olive green between houses
			Med.olive(model, ground(p - toStreet * 2), rng)
			Props.bench(model, ground(p + toStreet * 4), facing)
			Med.lavender(model, ground(p + across * 5), rng)
			Med.lavender(model, ground(p - across * 5), rng)
		end
		return
	end
	if kind == "cube" then
		Med.cubeHouse(model, ground(p), facing, rng)
	elseif kind == "town" then
		Med.townhouse(model, ground(p), facing, rng)
	else
		Med.villa(model, ground(p), facing, rng)
		return
	end

	local front = p + toStreet * (HOUSE_FRONT[kind] + 1)
	local extra = rng:NextNumber()
	if extra < 0.25 then
		Med.pot(model, ground(front + across * 6), rng)
		Med.pot(model, ground(front + across * 7.6), rng)
	elseif extra < 0.4 then
		Props.bench(model, ground(front - across * 6), facing)
	elseif extra < 0.5 and not lane then
		Med.cafeTable(model, ground(front + across * 7), rng)
	end
	if rng:NextNumber() < 0.35 then
		-- Walled yard out back with an olive or a lemon tree
		local yard = p - toStreet * 16
		if flat(shape, yard, 7) and isFree(spots, yard, 6) then
			reserve(spots, yard, 6)
			local corners = {
				yard + across * 7 + toStreet * 4,
				yard + across * 7 - toStreet * 4,
				yard - across * 7 - toStreet * 4,
				yard - across * 7 + toStreet * 4,
			}
			for c = 1, 3 do
				Med.stoneWall(model, ground(corners[c]), ground(corners[c + 1]), rng)
			end
			Props.part(
				model,
				Vector3.new(13, 0.4, 7),
				CFrame.new(ground(yard, 0.1)) * CFrame.Angles(0, facing, 0),
				DIRT,
				M.Ground
			)
			if rng:NextNumber() < 0.5 then
				Med.olive(model, ground(yard + across * 3), rng, 0.8)
			else
				Med.pot(model, ground(yard + across * 3), rng, "lemon")
			end
			Med.lavender(model, ground(yard - across * 3), rng)
		end
	end
end

-- A terrace of houses shoulder to shoulder along one side of a street (`side` 1 is away from the
-- bay), every door facing it. Each slot slides along until its house fits, so the row stays tight.
local function lineStreet(
	shape: Shape,
	model: Instance,
	street: Street,
	side: number,
	width: number,
	kinds: { { any } },
	spots: { Spot },
	rng: Random
)
	local last: Vector2?, lastHalf = nil, 0
	local kind = rollKind(kinds, rng)
	local gap = if kind == "town" then 0.6 else rng:NextNumber(1.5, 3.5)
	for n, f in streetFrames(street, 3) do
		local half = HOUSE_HALF[kind]
		local p = f.position + f.inland * side * (width / 2 + HOUSE_FRONT[kind] + 2)
		if last and (p - last).Magnitude < lastHalf + half + gap then
			continue
		end
		if
			isInside(shape.coast, p)
			and coastDistance(shape, p) > 30
			and flat(shape, p, half - 2)
			and isFree(spots, p, 9)
		then
			placeHouse(shape, model, kind, p, f.position, width < ROAD_WIDTH, spots, rng)
			last, lastHalf = p, half
		end
		-- Whether it fitted or not, the next slot gets a fresh roll so a big house can't stall a row
		kind = rollKind(kinds, rng)
		gap = if kind == "town" then 0.6 else rng:NextNumber(1.5, 3.5)
		if n % 40 == 0 then
			task.wait()
		end
	end
end

local function buildHouses(
	shape: Shape,
	parent: Instance,
	road: { Street },
	lanes: { Street },
	spots: { Spot },
	rng: Random
)
	local model = Instance.new("Model")
	model.Name = "Houses"
	model.Parent = parent

	-- Lamps go in first so the houses leave room for them
	local lamps = {}
	for _, street in road do
		for i, r in street do
			if i % 5 == 1 then
				local side = if i % 10 == 1 then 1 else -1
				local lampAt = r.position + r.inland * side * (ROAD_WIDTH / 2 + 1)
				Props.lampPost(model, ground(lampAt))
				reserve(spots, lampAt, 0.5)
				table.insert(lamps, ground(lampAt))
			end
		end
	end
	-- Bulbs strung across the road between some of the lamps
	for i = 1, #lamps - 1, 2 do
		local a, b = lamps[i], lamps[i + 1]
		if (a - b).Magnitude < 70 then
			Props.stringLights(model, a + Vector3.new(0, 10.6, 0), b + Vector3.new(0, 10.6, 0), rng)
		end
	end

	-- Both sides of the ring road, then the far side of each back lane; the near side of a lane is
	-- the backs of the ring road's inland row.
	for _, street in road do
		for _, side in { -1, 1 } do
			lineStreet(shape, model, street, side, ROAD_WIDTH, RING_KINDS, spots, rng)
		end
	end
	for _, street in lanes do
		lineStreet(shape, model, street, 1, LANE_WIDTH, LANE_KINDS, spots, rng)
	end
end

-- Windmills along the ridges above the village and a chapel on a hilltop, turned toward the bay
-- so they show from the water.
local function buildHilltops(shape: Shape, island: Model, spots: { Spot }, rng: Random)
	local model = Instance.new("Model")
	model.Name = "Hilltops"
	model.Parent = island
	local coast = shape.coast

	local candidates = {}
	for _ = 1, 500 do
		local p = coast[rng:NextInteger(1, #coast)]:Lerp(shape.center, rng:NextNumber(0.05, 0.5))
		if
			isInside(coast, p)
			and coastDistance(shape, p) > 40
			and (nearestOnLine(shape.bayShore, p)) > VILLAGE_BAND + 60
		then
			local spot, normal = Islands.surface(island, p.X, p.Y)
			if spot and normal and normal.Y > 0.95 then
				table.insert(candidates, spot)
			end
		end
	end
	table.sort(candidates, function(a, b)
		return a.Y > b.Y
	end)

	local built = 0
	for _, spot in candidates do
		local p = Vector2.new(spot.X, spot.Z)
		if isFree(spots, p, 70) then
			reserve(spots, p, 18)
			local facing = facingToward(p, shape.center)
			if built == 1 then
				Props.part(
					model,
					Vector3.new(24, 10, 26),
					CFrame.new(spot - Vector3.new(0, 5.5, 0)) * CFrame.Angles(0, facing, 0),
					ROCK,
					M.Limestone
				)
				Med.chapel(model, spot - Vector3.new(0, 0.8, 0), facing, rng)
				local side = Vector3.new(math.cos(facing), 0, -math.sin(facing))
				for _, s in { -1, 1 } do
					Med.cypress(model, spot + side * s * 13 - Vector3.new(0, 0.5, 0), rng)
				end
			else
				Props.cylinder(model, spot - Vector3.new(0, 4, 0), 8, 22, ROCK, M.Limestone)
				Med.windmill(model, spot - Vector3.new(0, 0.5, 0), facing, rng)
			end
			built += 1
			if built >= 4 then
				break
			end
		end
	end
end

local function buildForest(shape: Shape, island: Model, spots: { Spot }, rng: Random)
	local model = Instance.new("Model")
	model.Name = "Forest"
	model.Parent = island
	local placed = 0
	local coast = shape.coast
	for attempt = 1, 2600 do
		if placed >= 420 then
			break
		end
		local p = coast[rng:NextInteger(1, #coast)]:Lerp(shape.center, rng:NextNumber(0, 1))
			+ Vector2.new(rng:NextNumber(-100, 100), rng:NextNumber(-100, 100))
		if isInside(coast, p) and coastDistance(shape, p) > 8 and isFree(spots, p, 6) then
			local spot, normal = Islands.surface(island, p.X, p.Y)
			if spot and normal and normal.Y > 0.75 and spot.Y > 2 then
				reserve(spots, p, 5)
				local roll = rng:NextNumber()
				if spot.Y > LAND + 3 then
					-- Hills: umbrella pines and cypresses over maquis scrub
					if roll < 0.3 then
						Med.stonePine(model, spot, rng)
					elseif roll < 0.5 then
						Med.cypress(model, spot, rng)
					elseif roll < 0.65 then
						Med.olive(model, spot, rng)
					elseif roll < 0.9 then
						Props.bush(model, spot, rng, MAQUIS)
					else
						Med.lavender(model, spot, rng)
					end
				elseif roll < 0.35 then
					Med.olive(model, spot, rng)
				elseif roll < 0.5 then
					Med.cypress(model, spot, rng)
				elseif roll < 0.6 then
					Props.palm(model, spot, rng)
				elseif roll < 0.8 then
					Props.bush(model, spot, rng, MAQUIS)
				elseif roll < 0.9 then
					Med.lavender(model, spot, rng)
				else
					Props.flowers(model, spot, rng)
				end
				placed += 1
			end
		end
		if attempt % 100 == 0 then
			task.wait()
		end
	end
end

-- Painted fishing boats riding at anchor around the bay, clear of the base piers.
local function buildBoats(shape: Shape, island: Model, rng: Random, avoid: { Vector2 })
	local model = Instance.new("Model")
	model.Name = "Boats"
	model.Parent = island
	local line = shape.bayShore
	local placed: { Vector2 } = {}
	for _ = 1, 80 do
		if #placed >= 10 then
			break
		end
		local k = rng:NextInteger(1, #line - 1)
		local point, out = shoreAt(shape, line[k]:Lerp(line[k + 1], rng:NextNumber()))
		local p = point + out * rng:NextNumber(28, 90)
		local clear = coastDistance(shape, p) < -16
		for _, a in avoid do
			clear = clear and (a - p).Magnitude > 80
		end
		for _, b in placed do
			clear = clear and (b - p).Magnitude > 30
		end
		if clear then
			table.insert(placed, p)
			Med.boat(model, Vector3.new(p.X, 0, p.Y), rng:NextNumber(0, TAU), rng, pick(rng, BOATS))
		end
	end
end

----------------------------------------------------------------------------------------------------

-- Also available to charts of places baked before coast metadata was saved.
function Harbour.chartCoast(center: Vector2): { { number } }
	local coast = {}
	for _, point in makeShape(center).coast do
		table.insert(coast, { point.X, point.Y })
	end
	return coast
end

-- Close the bay's shore across its western mouth to outline the lake bottom.
function Harbour.lakeOutline(center: Vector2): { Vector2 }
	return makeShape(center).bayShore
end

function Harbour.build(parent: Instance, rng: Random, center: Vector2): CFrame
	local island = Instance.new("Model")
	island.Name = "Harbour Isle"
	island:SetAttribute("HarbourLayoutVersion", Harbour.LAYOUT_VERSION)
	island:SetAttribute("LayoutCenter", center)
	island.Parent = parent

	local shape = makeShape(center)
	local coast = {}
	for _, point in shape.coast do
		table.insert(coast, { point.X, point.Y })
	end
	island:SetAttribute("ChartCoast", game:GetService("HttpService"):JSONEncode(coast))
	buildGround(shape, island, rng)

	local village = Instance.new("Model")
	village.Name = "Village"
	village.Parent = island
	local spots: { Spot } = {}

	-- Landmarks first so the road and houses keep clear of them
	local plaza = shape.toWorld(PLAZA)
	reserve(spots, plaza, PLAZA_HALF * 1.42)
	reserve(spots, plaza + Vector2.new(0, 82), 31)
	-- Keep shore clutter clear of the rear repair basin and its water approach.
	reservePath(spots, plaza + Vector2.new(0, 104), plaza + Vector2.new(0, 198), 23)
	local lighthouse = shape.toWorld(LIGHTHOUSE)
	reserve(spots, lighthouse, 34)

	local bases = Instance.new("Folder")
	bases.Name = "Bases"
	bases.Parent = island
	local baseBacks, baseShores = {}, {}
	for index, anchor in BASES do
		local world = shape.toWorld(anchor)
		local middle, back = buildBase(shape, bases, index, world, rng)
		reserve(spots, middle, 36)
		table.insert(baseBacks, back)
		table.insert(baseShores, (shoreAt(shape, world)))
		task.wait()
	end
	buildBeach(shape, island, village, spots, rng)

	-- The road gives way to the piazza's paving where it crosses the square
	local keepOut = {
		{ position = lighthouse, radius = 26 },
		{ position = plaza, radius = PLAZA_HALF + 2 },
	}
	local road = buildRoad(shape, village, "Road", keepOut, ROAD_OFFSET, ROAD_WIDTH, 0.6)
	for _, street in road do
		for i = 2, #street do
			reservePath(spots, street[i - 1].position, street[i].position, ROAD_WIDTH / 2 + 1)
		end
	end

	-- A back lane behind the first row of houses gives the second row a street of its own to face;
	-- cross streets tie it to the ring road at each end and every block or so in between.
	local lanes = buildRoad(shape, village, "Lane", keepOut, ROAD_OFFSET + LANE_OFFSET, LANE_WIDTH, 0.45)
	local crossStreets = Instance.new("Model")
	crossStreets.Name = "CrossStreets"
	crossStreets.Parent = village
	for _, street in lanes do
		for i, r in street do
			if i > 1 then
				reservePath(spots, street[i - 1].position, r.position, LANE_WIDTH / 2 + 0.5)
			end
			if (i - 1) % 12 == 0 or i == #street then
				local joint = nearestRoad(road, r.position)
				local reach = (joint.position - r.position).Magnitude
				if reach < LANE_OFFSET + 25 and roadClear(shape, keepOut, joint.position, r.position) then
					pathSegment(crossStreets, r.position, joint.position, LANE_WIDTH, ROAD, M.Cobblestone, 0.3)
					reservePath(spots, r.position, joint.position, LANE_WIDTH / 2 + 5)
				end
			end
		end
	end

	-- Dirt tracks from each base and the lighthouse up to the road, with signposts at the junctions
	for i, back in baseBacks do
		local joint = nearestRoad(road, back)
		local base = bases:FindFirstChild("Base" .. i)
		if base and base:IsA("Model") then
			ensureBaseTrack(village, base)
			local house = base:FindFirstChild("BaseHouse")
			local frame = house and house:GetAttribute("HouseFrame")
			if typeof(frame) == "CFrame" then
				local endPoint = frame * Vector3.new(0, 0, 52)
				reservePath(spots, back, Vector2.new(endPoint.X, endPoint.Z), 11)
			end
		end
		local signAt = joint.position - joint.inland * (ROAD_WIDTH / 2 + 2)
		local side = Vector2.new(-joint.inland.Y, joint.inland.X)
		Props.signpost(
			village,
			ground(signAt + side * 7),
			facingToward(signAt, back) - math.pi / 2,
			{ { "Base " .. i, 0 } }
		)
		reserve(spots, signAt + side * 7, 2)
	end
	local toLighthouse = nearestRoad(road, lighthouse)
	local lighthouseGate = lighthouse + (toLighthouse.position - lighthouse).Unit * 17
	pathSegment(village, lighthouseGate, toLighthouse.position, 9, DIRT, M.Pebble, 0.4)
	reservePath(spots, lighthouseGate, toLighthouse.position, 11)

	buildPlaza(village, plaza, rng)
	local plazaRoad = nearestRoad(road, plaza)
	Props.signpost(
		village,
		ground(plazaRoad.position + plazaRoad.inland * -(ROAD_WIDTH / 2 + 3), 0.6),
		facingToward(plazaRoad.position, plaza) - math.pi / 2,
		{ { "Plaza", 0 }, { "Lighthouse", math.pi } }
	)

	Props.lighthouse(village, ground(lighthouse))
	local cottage = lighthouse + Vector2.new(36, 4)
	if flat(shape, cottage, 12) and isFree(spots, cottage, 14) then
		Med.cubeHouse(village, ground(cottage), facingToward(cottage, lighthouse), rng)
		reserve(spots, cottage, 16)
	end

	buildHouses(shape, village, road, lanes, spots, rng)
	buildHilltops(shape, island, spots, rng)
	buildForest(shape, island, spots, rng)
	-- The piazza's own terraces go in last, clearing any generated house or tree off their plots
	PlazaHouses.build(village:FindFirstChild("Plaza") :: Model, CFrame.new(ground(plaza, 0.8)))
	clearShopPlots(island)
	rerouteShopRoads(island)
	buildBoats(shape, island, rng, baseShores)
	Harbour.ensureLaunchClearance(island)
	Harbour.ensureBaseBoatClearance(island)
	Harbour.ensureMetro(island)

	-- Buoys marking the way into the bay
	local mouthA, mouthB = shape.toWorld(OUTER[1]), shape.toWorld(OUTER[#OUTER])
	for _, t in { 0.25, 0.75 } do
		for _, out in { 40, 190 } do
			local p = mouthA:Lerp(mouthB, t) + Vector2.new(-out, 0)
			Props.buoy(island, Vector3.new(p.X, 0, p.Y), rng)
		end
	end

	return CFrame.new(ground(plaza + Vector2.new(0, 34), 3.5))
end

-- Runs after legacy ground/shop repairs, before characters spawn on baked maps.
function Harbour.ensureMetro(root: Instance)
	local island = if root.Name == "Harbour Isle" then root else root:FindFirstChild("Harbour Isle", true)
	local village = island and island:FindFirstChild("Village")
	local plaza = village and village:FindFirstChild("Plaza")
	if not island or not plaza then return end
	local center = require(game:GetService("ReplicatedStorage").Shared.Biomes).Normal.center
	local frame = CFrame.new(ground(makeShape(center).toWorld(PLAZA), 0.92))
	-- Cutting the original paving slab must not lose the square's house anchor.
	plaza:SetAttribute("PavingFrame", CFrame.new(frame.Position.X, LAND + 0.8, frame.Position.Z))
	MetroStations.ensureHarbour(island, plaza, frame)
	local pocket = require(game:GetService("ReplicatedStorage").Shared.Biomes).DryPockets[2]
	workspace.Terrain:FillBlock(CFrame.new((pocket.min + pocket.max) / 2), pocket.max - pocket.min, M.Air)
end

-- Startup repairs scan the whole map (city and islands included) before anyone spawns. Yield a
-- frame every 50 ms so the startup thread stays inside Roblox's ~10 s script timeout.
local breatheAt = os.clock()
local function breathe()
	if task and os.clock() - breatheAt > 0.05 then
		task.wait()
		breatheAt = os.clock()
	end
end

-- Upgrade only the generated dock pieces, keeping claimed bases and their controls intact.
-- Saved Studio maps skip Map.build, so this also runs on the normal startup path.
function Harbour.ensureDocks(root: Instance)
	for _, base in root:GetDescendants() do
		breathe()
		if not base:IsA("Model") or not CollectionService:HasTag(base, Harbour.BASE_TAG) then
			continue
		end
		ensureDockSign(base)
		local frame = base:GetAttribute("BoatDockFrame")
		if typeof(frame) ~= "CFrame" then
			local spawn = base:FindFirstChild("SpawnPoint")
			if not spawn or not spawn:IsA("BasePart") then
				continue
			end
			frame = spawn.CFrame * CFrame.new(-4, -6.1, -26)
			base:SetAttribute("BoatDockFrame", frame)
		end
		ensureDockAccess(base, frame)
		ensureBeachStairs(base, frame)
		if base:GetAttribute("DockDetailVersion") == DOCK_DETAIL_VERSION then
			continue
		end
		for _, item in base:GetChildren() do
			if item:IsA("Model") and (item.Name == "Dock" or item.Name == "DockLink") then
				item:Destroy()
			elseif item:IsA("BasePart") then
				-- The legacy crosswalk and its three anonymous piles are direct base children.
				local p = frame:PointToObjectSpace(item.Position)
				local slab = (item.Size - Vector3.new(27, 0.6, 5)).Magnitude < 0.01
					and (p - Vector3.new(0, 3, -38)).Magnitude < 0.01
				local pile = (item.Size - Vector3.new(0.9, 18, 0.9)).Magnitude < 0.01
					and math.abs(p.Y + 6.4) < 0.01
					and math.abs(p.Z + 38) < 0.01
					and (math.abs(p.X) < 0.01 or math.abs(math.abs(p.X) - 8) < 0.01)
				if slab or pile then
					item:Destroy()
				end
			end
		end
		buildBaseDocks(base, frame, base:GetAttribute("BaseId") or 1)
	end
end

-- Keep every base's launch and water approach free of anchored scenery, including
-- on baked maps. Move whole boats after generation without consuming its RNG.
function Harbour.ensureBaseBoatClearance(root: Instance)
	local islands = root:GetDescendants()
	table.insert(islands, root)
	for _, island in islands do
		breathe()
		if island.Name ~= "Harbour Isle" then
			continue
		end
		local bases = island:FindFirstChild("Bases")
		local boats = island:FindFirstChild("Boats")
		if not bases or not boats then
			continue
		end
		local lanes = {}
		for _, base in bases:GetChildren() do
			local frame = base:GetAttribute("BoatDockFrame")
			if typeof(frame) == "CFrame" then
				-- BoatSpawn is 52 studs out; longer hulls move farther seaward.
				-- Leave room beyond the largest hull for sailing off the berth.
				table.insert(lanes, { frame = frame, width = 35, near = 20, far = -140 })
			end
		end
		for _, shop in island:GetDescendants() do
			breathe()
			local launch = shop.Name == "Drydock" and shop:GetAttribute("LaunchWaterFrame")
			if typeof(launch) == "CFrame" then
				table.insert(lanes, { frame = launch, width = 45, near = 55, far = -70 })
			end
		end
		local function blocksLane(position: Vector3, radius: number): boolean
			for _, lane in lanes do
				local p = lane.frame:PointToObjectSpace(position)
				if math.abs(p.X) < lane.width + radius and p.Z > lane.far - radius and p.Z < lane.near + radius then
					return true
				end
			end
			return false
		end
		local scenery = {}
		for _, boat in boats:GetChildren() do
			if boat:IsA("Model") and boat.Name == "Boat" and boat:FindFirstChildWhichIsA("BasePart", true) then
				local box, size = boat:GetBoundingBox()
				table.insert(scenery, {
					model = boat, position = box.Position,
					radius = Vector2.new(size.X, size.Z).Magnitude / 2,
				})
			end
		end
		local center = island:GetAttribute("LayoutCenter")
		if typeof(center) ~= "Vector2" then
			center = require(game:GetService("ReplicatedStorage").Shared.Biomes).Normal.center
		end
		local shape = makeShape(center)
		for _, boat in scenery do
			if not blocksLane(boat.position, boat.radius) then continue end
			local destination: Vector3? = nil
			-- Search nearby water first, checking every berth and the drydock so
			-- moving one obstruction never puts it in front of another base.
			for ring = 1, 32 do
				for step = 0, 23 do
					local angle = step * TAU / 24
					local candidate = boat.position + Vector3.new(math.cos(angle), 0, math.sin(angle)) * (ring * 24)
					if blocksLane(candidate, boat.radius) then continue end
					local flat = Vector2.new(candidate.X, candidate.Z)
					if coastDistance(shape, flat) > -(boat.radius + 16) then continue end
					local clear = true
					for _, other in scenery do
						local delta = candidate - other.position
						if other ~= boat and Vector2.new(delta.X, delta.Z).Magnitude < boat.radius + other.radius + 12 then
							clear = false
							break
						end
					end
					if clear then destination = candidate; break end
				end
				if destination then break end
			end
			if destination then
				boat.model:PivotTo(boat.model:GetPivot() + (destination - boat.position))
				boat.position = destination
			else
				warn("[Harbour] Cannot find clear water for " .. boat.model:GetFullName())
			end
		end
	end
end

-- Add the boat shop and launch points to a map already baked in Studio.
-- Move anchored scenery aside so the slipway and its water approach stay open.
function Harbour.ensureLaunchClearance(root: Instance)
	for _, shop in root:GetDescendants() do
		breathe()
		if not shop:IsA("Model") or shop.Name ~= "Drydock" then
			continue
		end
		local launch = shop:GetAttribute("LaunchWaterFrame")
		if typeof(launch) ~= "CFrame" then
			continue
		end
		for _, boat in root:GetDescendants() do
			breathe()
			if not boat:IsA("Model") or boat.Name ~= "Boat" then
				continue
			end
			local floor = boat:FindFirstChild("BoatFloor")
			if not floor then
				for _, piece in boat:GetChildren() do
					if piece:IsA("BasePart") then
						floor = piece
						break
					end
				end
			end
			if not floor or not floor:IsA("BasePart") then
				continue
			end
			local position = launch:PointToObjectSpace(floor.Position)
			if math.abs(position.X) < 45 and position.Z > -70 and position.Z < 55 then
				local side = if position.X < 0 then -1 else 1
				local offset = launch:VectorToWorldSpace(Vector3.new(side * 65 - position.X, 0, 0))
				for _, piece in boat:GetDescendants() do
					breathe()
					if piece:IsA("BasePart") then
						piece.CFrame += offset
					end
				end
			end
		end
	end
end

-- Runs before BaseService starts, while baked scenery has no live occupants.
-- Player furniture and progress are loaded afterwards onto the same base IDs.
function Harbour.ensureCapacity(root: Instance)
	local island = if root.Name == "Harbour Isle" then root else root:FindFirstChild("Harbour Isle", true)
	if not island or not island:IsA("Model") then return end
	local bases = island:FindFirstChild("Bases")
	local current = island:GetAttribute("HarbourLayoutVersion") == Harbour.LAYOUT_VERSION
		and bases and #bases:GetChildren() == Harbour.BASE_COUNT
	if current then
		for id = 1, Harbour.BASE_COUNT do
			local base = bases:FindFirstChild("Base" .. id)
			if not base or not base:IsA("Model") or base:GetAttribute("BaseId") ~= id then
				current = false
				break
			end
		end
	end
	local center = island:GetAttribute("LayoutCenter")
	if typeof(center) ~= "Vector2" then
		local shop = island:FindFirstChild("Drydock", true)
		local footprint = shop and shop:FindFirstChild("ShopFootprint")
		local plaza = footprint and Vector2.new(footprint.Position.X, footprint.Position.Z - 82)
		center = if plaza then plaza - makeShape(Vector2.zero).toWorld(PLAZA) else Vector2.zero
	end
	local changed = false
	if not current then
		local parent = island.Parent
		if not parent then return end
		local settings = require(game:GetService("ReplicatedStorage").Shared.Biomes)
		island:Destroy()
		local spawnFrame = Harbour.build(parent, Random.new(settings.Seed + 1), center)
		local spawn = root:FindFirstChild("HarbourSpawn")
		if spawn and spawn:IsA("SpawnLocation") then spawn.CFrame = spawnFrame end
		changed = true
	end
	if root:GetAttribute("HarbourRoomVersion") ~= Harbour.LAYOUT_VERSION then
		local resumed = os.clock()
		for _, scenery in root:GetDescendants() do
			if os.clock() - resumed > 0.05 then task.wait(); resumed = os.clock() end
			if not scenery:IsA("Model") or scenery.Name ~= "Island" then continue end
			local radius = scenery:GetAttribute("Radius")
			local groundMesh = scenery:FindFirstChild("Ground")
			if type(radius) == "number" and groundMesh and groundMesh:IsA("Model") then
				local bounds = groundMesh:GetBoundingBox()
				local distance = (Vector2.new(bounds.X, bounds.Z) - center).Magnitude
				if distance < Harbour.FOOTPRINT + radius * 1.35 + 80 or (radius <= 75 and distance < 2300) then
					scenery:Destroy()
					changed = true
				end
			end
		end
		root:SetAttribute("HarbourRoomVersion", Harbour.LAYOUT_VERSION)
	end
	if changed then
		-- The old shells describe the removed shore and scenery. Rebuild them
		-- through the existing deferred LOD repair after the harbour opens.
		local shells = root:FindFirstChild("Lod")
		if shells then shells:Destroy() end
	end
end

function Harbour.ensureBoating(root: Instance)
	Harbour.ensureCapacity(root)
	for _, island in root:GetDescendants() do
		breathe()
		if island:IsA("Model") and island.Name == "Harbour Isle" then
			-- Saved maps may still contain the old coastal boulders.
			local forest = island:FindFirstChild("Forest")
			if forest then
				for _, prop in forest:GetChildren() do
					if prop:IsA("Model") and prop.Name == "Boulder" then
						prop:Destroy()
					end
				end
			end
			local groundMesh = island:FindFirstChild("Ground")
			local shop = island:FindFirstChild("Drydock", true)
			local footprint = shop and shop:FindFirstChild("ShopFootprint")
			if groundMesh and groundMesh:GetAttribute("DrydockChannelVersion") ~= 1 and footprint then
				local plaza = Vector2.new(footprint.Position.X, footprint.Position.Z - 82)
				local center = plaza - makeShape(Vector2.new(0, 0)).toWorld(PLAZA)
				groundMesh:Destroy()
				buildGround(makeShape(center), island, Random.new(0))
			end
		end
	end
	Harbour.ensureDocks(root)
	Drydock.ensure(root)
	Harbour.ensureLaunchClearance(root)
	Harbour.ensureBaseBoatClearance(root)
end

-- Saved maps also receive the enterable tackle shop, its purchase counter and the furniture shop.
function Harbour.ensureFishing(root: Instance)
	RodShop.ensure(root)
	FurnitureShop.ensure(root)
	BackpackShop.ensure(root)

	PlazaHouses.ensure(root)
end

-- Saved maps keep their terrain and docks while receiving the current base house
-- and the shop across the road from it.
function Harbour.ensureBases(root: Instance)
	local islands = { root }
	for _, item in root:GetDescendants() do
		breathe()
		if item:IsA("Model") and CollectionService:HasTag(item, Harbour.BASE_TAG) then
			BaseHouse.ensure(item)
		elseif item.Name == "Harbour Isle" then
			table.insert(islands, item)
		end
	end
	for _, island in islands do
		breathe()
		clearShopPlots(island)
		rerouteShopRoads(island)
		local village, bases = island:FindFirstChild("Village"), island:FindFirstChild("Bases")
		if village and bases then
			for _, base in bases:GetChildren() do
				if base:IsA("Model") then
					ensureBaseTrack(village, base)
				end
			end
		end
	end
end

-- Saved beaches receive moving surf without rebuilding their terrain or decorations.
function Harbour.ensureSurf(root: Instance, center: Vector2)
	-- Runs after players are in, over the whole map: yield now and then to stay inside the script timeout
	local resumed = os.clock()
	for _, island in root:GetDescendants() do
		if os.clock() - resumed > 0.05 then
			task.wait()
			resumed = os.clock()
		end
		if not island:IsA("Model") or island.Name ~= "Harbour Isle" then
			continue
		end
		local village = island:FindFirstChild("Village")
		local beach = village and village:FindFirstChild("Beach")
		if beach then
			local surf = beach:FindFirstChild("Surf")
			if not surf or surf:GetAttribute("ShoreWavesVersion") ~= 1 then
				buildSurf(makeShape(center), island, beach)
			end
		end
	end
end

-- Trim legacy paving in place, preserving every plaza prop and its placement.
function Harbour.ensurePlazaPaving(root: Instance)
	for _, plaza in root:GetDescendants() do
		breathe()
		if not plaza:IsA("Model") or plaza.Name ~= "Plaza" or plaza:GetAttribute("PlazaPavingVersion") == 2 then
			continue
		end
		local size = PLAZA_HALF * 2
		local floor: BasePart? = nil
		for _, child in plaza:GetChildren() do
			if child:IsA("Part") and (child.Size - Vector3.new(size, 0.6, size)).Magnitude < 0.001 then
				floor = child
				break
			end
		end
		if not floor then
			continue
		end
		local center = floor.Position
		local half = PLAZA_HALF - 2
		floor.Size = Vector3.new(half * 2, floor.Size.Y, half * 2)
		for _, child in plaza:GetChildren() do
			if not child:IsA("Part") or child.Material ~= M.Cobblestone or math.abs(child.Size.Y - 0.12) > 0.001 then
				continue
			end
			local p, s = child.Position, child.Size
			local minX, maxX = math.max(p.X - s.X / 2, center.X - half), math.min(p.X + s.X / 2, center.X + half)
			local minZ, maxZ = math.max(p.Z - s.Z / 2, center.Z - half), math.min(p.Z + s.Z / 2, center.Z + half)
			child.Size = Vector3.new(maxX - minX, s.Y, maxZ - minZ)
			child.CFrame = CFrame.new((minX + maxX) / 2, p.Y, (minZ + maxZ) / 2)
		end
		plaza:SetAttribute("PlazaPavingVersion", 2)
	end
end
return Harbour
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="228">
          <Properties>
            <string name="Name">ImportedModel</string>
            <string name="Source"><![CDATA[-- Native geometry shared by the supplied shop fixtures.
local ImportedModel = {}
local SKIN = 0.01

local function direction(v: Vector3): Vector3
	return Vector3.new(v.X, v.Z, -v.Y)
end

function ImportedModel.build(parent: Instance, frame: CFrame, geometry, options): Model
	local Geometry = geometry
	local scale = options.width / (Geometry.boundsMax.X - Geometry.boundsMin.X)
	local origin = options.origin
		or Vector3.new(
			(Geometry.boundsMin.X + Geometry.boundsMax.X) / 2,
			(Geometry.boundsMin.Y + Geometry.boundsMax.Y) / 2,
			Geometry.boundsMin.Z
		)
	-- options.depth stretches the source's front-to-back axis (source Y) on its
	-- own, so a model can fill an exact grid footprint.
	local depthScale = if options.depth
		then options.depth / (Geometry.boundsMax.Y - Geometry.boundsMin.Y)
		else scale
	local function point(v: Vector3): Vector3
		local d = v - origin
		return Vector3.new(d.X * scale, d.Z * scale, -d.Y * depthScale)
	end
	local freezer = Instance.new("Model")
	freezer.Name = options.name
	freezer:SetAttribute("ModelVersion", options.version or 1)
	freezer:SetAttribute("SourceModel", options.sourceName)
	freezer:SetAttribute("SourceHash", Geometry.sourceHash)
	freezer:SetAttribute("SourceObjectCount", Geometry.sourceObjectCount or #Geometry.objects)
	freezer.Parent = parent

	local function part(kind: string, group: Model, size: Vector3, cf: CFrame, color: Color3): BasePart
		local finish = options.appearance and options.appearance[group.Name]
		local item = Instance.new(kind) :: BasePart
		item.Name = if kind == "Part" then "Solid" else "Surface"
		item.Size = size
		item.CFrame = frame * cf
		item.Color = if finish then finish.color else color
		item.Material = if finish then finish.material else Enum.Material.SmoothPlastic
		item.Transparency = if finish then finish.transparency or 0 else 0
		item.Reflectance = if finish then finish.reflectance or 0 else 0
		item.Anchored = true
		item.CanTouch = false
		item.CanCollide = options.canCollide ~= false
		item.TopSurface = Enum.SurfaceType.Smooth
		item.BottomSurface = Enum.SurfaceType.Smooth
		item.Parent = group
		return item
	end

	local vertices = {}
	for i, vertex in Geometry.vertices do
		vertices[i] = point(vertex)
	end
	for _, source in Geometry.objects do
		local group = Instance.new("Model")
		group.Name = source.name
		group:SetAttribute("SourceFaceCount", #source.faces)
		group:SetAttribute("SourceObject", source.sourceObject or source.name)
		-- Keep the supplied palette as metadata while allowing authored finishes.
		group:SetAttribute("SourceColor", source.color)
		group.Parent = freezer
		if source.box then
			-- Solid boxes (packaged stock) stay rigid: a depth stretch moves them
			-- with the surface they rest on but never shears them.
			local box = source.box
			local right = direction(box.right).Unit
			local back = right:Cross(direction(box.up)).Unit
			local up = back:Cross(right).Unit
			part("Part", group, box.size * scale, CFrame.fromMatrix(point(box.center), right, up, back), source.color)
			continue
		end
		local handled = {}
		for _, rectangle in source.rectangles or {} do
			local right, sourceUp = direction(rectangle.right).Unit, direction(rectangle.up).Unit
			local back = right:Cross(sourceUp).Unit
			local up = back:Cross(right).Unit
			local patch = part(
				"Part",
				group,
				Vector3.new(rectangle.size.X * scale, rectangle.size.Y * scale, SKIN),
				CFrame.fromMatrix(point(rectangle.center) - back * (SKIN / 2), right, up, back),
				source.color
			)
			patch.Name = "SurfacePatch"
			for _, faceIndex in rectangle.faces do
				handled[faceIndex] = true
			end
		end
		for faceIndex, face in source.faces do
			if handled[faceIndex] then
				continue
			end
			local a, b, c = vertices[face[1]], vertices[face[2]], vertices[face[3]]
			-- Source winding points out of the solid, including the recessed cavities.
			local cross = (b - a):Cross(c - a)
			if cross.Magnitude < 1e-12 then
				continue
			end
			local normal = cross.Unit
			local ab, ac, bc = b - a, c - a, c - b
			local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
			if abd > acd and abd > bcd then
				c, a = a, c
			elseif acd > bcd and acd > abd then
				a, b = b, a
			end
			ab, ac, bc = b - a, c - a, c - b
			local right = ac:Cross(ab).Unit
			local up, back = bc:Cross(right).Unit, bc.Unit
			local height = math.abs(ab:Dot(up))
			local shift = -normal * (SKIN / 2)
			local first, second = math.abs(ab:Dot(back)), math.abs(ac:Dot(back))
			-- Right triangles need one wedge. Skip the zero-area half instead of
			-- letting Roblox clamp it into a visible sliver.
			if first > 0.000001 then
				part(
					"WedgePart",
					group,
					Vector3.new(SKIN, math.max(height, 0.001), math.max(first, 0.001)),
					CFrame.fromMatrix((a + b) / 2 + shift, right, up, back),
					source.color
				)
			end
			if second > 0.000001 then
				part(
					"WedgePart",
					group,
					Vector3.new(SKIN, math.max(height, 0.001), math.max(second, 0.001)),
					CFrame.fromMatrix((a + c) / 2 + shift, -right, up, -back),
					source.color
				)
			end
		end
	end
	return freezer
end

return ImportedModel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="229">
          <Properties>
            <string name="Name">Islands</string>
            <string name="Source"><![CDATA[-- Faceted islands built as radial heightmaps: a center fan plus rings of quads,
-- each face coloured by its height and slope (shore, cliff or top).

local LowPoly = require(script.Parent.LowPoly)
local Seabed = require(script.Parent.Seabed)

local Islands = {}

export type Materials = { top: Enum.Material, cliff: Enum.Material, shore: Enum.Material }
export type Palette = { top: Color3, cliff: Color3, shore: Color3, materials: Materials? }

local DEFAULT_MATERIALS: Materials =
	{ top = Enum.Material.Grass, cliff = Enum.Material.Rock, shore = Enum.Material.Sand }

export type Spec = {
	position: Vector2,
	radius: number,
	height: number,
	shape: string,
	palette: Palette,
	rng: Random,
	shoreLine: number?, -- faces below this height use the shore colour
	elongation: number?,
	roughness: number?,
	seaFloor: number?, -- local biome bed; defaults to the deep sea floor
}

local TAU = math.pi * 2

-- {t, h}: t runs from 0 at the center to the outermost stop, h is a fraction of the island height.
-- Past the last stop, Seabed.slope continues the surface into the local sea floor.
local PROFILES: { [string]: { { number } } } = {
	plateau = { { 0, 1 }, { 0.45, 0.92 }, { 0.7, 0.2 }, { 0.86, 0.04 } },
	peak = { { 0, 1 }, { 0.3, 0.7 }, { 0.65, 0.22 }, { 0.86, 0.04 } },
	stack = { { 0, 1 }, { 0.55, 0.95 }, { 0.78, 0.15 }, { 0.9, 0.02 } },
	mound = { { 0, 1 }, { 0.5, 0.75 }, { 0.85, 0.15 } },
	berg = { { 0, 1 }, { 0.65, 0.97 }, { 0.78, 0.3 }, { 0.9, 0.05 } },
	volcano = { { 0, 0.42 }, { 0.14, 0.45 }, { 0.24, 1 }, { 0.5, 0.55 }, { 0.8, 0.08 }, { 0.9, 0.02 } },
	atoll = { { 0, -0.9 }, { 0.5, -0.6 }, { 0.66, 0.5 }, { 0.76, 1 }, { 0.86, 0.3 } },
}

local function profileHeight(points: { { number } }, t: number, height: number): number
	local last = points[#points]
	if t >= last[1] then
		return last[2] * height
	end
	for i = 1, #points - 1 do
		local p, q = points[i], points[i + 1]
		if t <= q[1] then
			local alpha = (t - p[1]) / (q[1] - p[1])
			return (p[2] + (q[2] - p[2]) * alpha) * height
		end
	end
	return last[2] * height
end

-- Rings land exactly on the profile's breakpoints so cliffs stay sharp; big islands get extra rings between them.
local function ringStops(points: { { number } }, radius: number): { number }
	local stops = {}
	for i = 2, #points do
		table.insert(stops, points[i][1])
	end
	if radius <= 90 then
		return stops
	end

	local step = if radius > 250 then 0.15 else 0.25
	local dense = {}
	local prev = 0
	for _, t in stops do
		local gap = t - prev
		local extra = math.floor(gap / step)
		for k = 1, extra do
			table.insert(dense, prev + gap * k / (extra + 1))
		end
		table.insert(dense, t)
		prev = t
	end
	return dense
end

function Islands.build(spec: Spec): Model
	local rng = spec.rng
	local points = PROFILES[spec.shape]
	assert(points, `Unknown island shape {spec.shape}`)

	local radius, height = spec.radius, spec.height
	local cx, cz = spec.position.X, spec.position.Y
	local palette = spec.palette
	local shoreLine = spec.shoreLine or 2.2
	local elongation = spec.elongation or rng:NextNumber(0, 0.3)
	local roughness = spec.roughness or 0.4
	local jitter = math.min(height * 0.05, 4)
	local spin = rng:NextNumber(0, TAU)
	local ox, oy, oz = rng:NextNumber(-500, 500), rng:NextNumber(-500, 500), rng:NextNumber(-500, 500)

	local model = Instance.new("Model")
	model.Name = "Island"
	model:SetAttribute("Radius", radius)
	model:SetAttribute("Height", height)
	local ground = Instance.new("Model")
	ground.Name = "Ground"
	ground.Parent = model

	local stops = ringStops(points, radius)
	local segments = math.clamp(math.floor(radius / 12) + 6, 6, 28)
	local center = Vector3.new(cx, profileHeight(points, 0, height) + rng:NextNumber(-jitter, jitter), cz)

	local rings = {}
	for i, t in stops do
		local ring = {}
		for j = 1, segments do
			local angle = (j - 1 + rng:NextNumber(-0.2, 0.2)) / segments * TAU
			local noise = math.noise(math.cos(angle) * 1.3 + ox, math.sin(angle) * 1.3 + oy, oz)
			local shape = 1 + roughness * 2 * noise + elongation * math.cos(2 * (angle - spin))
			local r = radius * t * shape * rng:NextNumber(0.95, 1.05)
			local y = profileHeight(points, t, height)
			y += rng:NextNumber(-jitter, jitter)
			ring[j] = Vector3.new(cx + math.cos(angle) * r, y, cz + math.sin(angle) * r)
		end
		rings[i] = ring
	end

	local inside = Vector3.new(cx, math.min(center.Y, 0) - radius, cz)

	local materials = palette.materials or DEFAULT_MATERIALS
	local function face(a: Vector3, b: Vector3, c: Vector3)
		local normal = (b - a):Cross(c - a).Unit
		local y = (a.Y + b.Y + c.Y) / 3
		local role = if y < 0
			then "shore"
			elseif math.abs(normal.Y) < 0.7 then "cliff"
			elseif y < shoreLine then "shore"
			else "top"
		local color = (palette :: any)[role]
		local shade = rng:NextNumber(0.93, 1.04)
		color = Color3.new(math.min(color.R * shade, 1), math.min(color.G * shade, 1), math.min(color.B * shade, 1))
		LowPoly.triangle(a, b, c, inside, color, ground, materials[role])
	end

	for j = 1, segments do
		local k = j % segments + 1
		face(center, rings[1][j], rings[1][k])
		for i = 1, #rings - 1 do
			local inner, outer = rings[i], rings[i + 1]
			face(inner[j], outer[j], outer[k])
			face(inner[j], outer[k], inner[k])
		end
	end

	Seabed.slope(
		rings[#rings],
		math.clamp(radius * 0.6, 64, 160),
		spec.seaFloor or Seabed.Floor,
		palette.shore,
		ground,
		materials.shore
	)

	-- Store the generated coast without consuming RNG or depending on streaming.
	local coast = {}
	for _, point in rings[#rings] do
		table.insert(coast, { point.X, point.Z })
	end
	model:SetAttribute("ChartCoast", game:GetService("HttpService"):JSONEncode(coast))
	model:SetAttribute("ChartAtoll", spec.shape == "atoll")
	return model
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

-- Ground position and normal on an island at (x, z), ignoring props already placed on it.
function Islands.surface(island: Model, x: number, z: number): (Vector3?, Vector3?)
	rayParams.FilterDescendantsInstances = { island:FindFirstChild("Ground") :: Instance }
	local hit = workspace:Raycast(Vector3.new(x, 1500, z), Vector3.new(0, -1600, 0), rayParams)
	if hit then
		return hit.Position, hit.Normal
	end
	return nil, nil
end

return Islands
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="230">
          <Properties>
            <string name="Name">Kitchen</string>
            <string name="Source"><![CDATA[-- Kitchen fixtures for the Supermarket path: the processing room's cooking stations,
-- the shop's food display case and the cooked dishes themselves. Local +Z is the
-- side the cook (or a customer at the case) stands on; the floor is y=0.
--
-- Placed kitchen furniture fills two grid cells end to end (FurnitureCatalog),
-- so a run of counters meets in one continuous worktop. The two built-in prep
-- benches keep their shorter BUILT_IN_WIDTH.
local Props = require(script.Parent.Props)

local Kitchen = {}
local rgb = Color3.fromRGB
local M = Enum.Material
local STEEL = rgb(186, 192, 196)
local DARK_STEEL = rgb(62, 68, 72)
local CABINET = rgb(222, 226, 226)
local BLACK = rgb(32, 32, 34)
local WOOD = rgb(148, 108, 70)
local LIGHT_WOOD = rgb(206, 170, 118)
local PLATE = rgb(244, 244, 238)
local TILE = rgb(236, 240, 238)
local GROUT = rgb(196, 202, 200)
local CHARRED = rgb(52, 40, 32)
local SALMON = rgb(240, 132, 96)

Kitchen.WIDTH = 9
Kitchen.BUILT_IN_WIDTH = 6
Kitchen.DEPTH = 2.4
Kitchen.TOP = 3.1
Kitchen.CASE_WIDTH = 9
Kitchen.CASE_DEPTH = 2.6
Kitchen.CASE_SHELF = 2.5
-- Where a cooking fish or finished dish sits, in station-local studs.
Kitchen.WORK_SPOT = CFrame.new(0.6, Kitchen.TOP + 0.02, 0.15)
-- Six dish spots under the glass of a food display case: three across, two deep.
local CASE_COLUMNS = { -2.9, 0, 2.9 }
Kitchen.CASE_SPOTS = {}
for _, z in { -0.5, 0.55 } do
	for _, x in CASE_COLUMNS do
		table.insert(Kitchen.CASE_SPOTS, CFrame.new(x, Kitchen.CASE_SHELF + 0.14, z))
	end
end
-- A plain supermarket gondola shelf: one grid cell wide, three shelves of two dishes.
Kitchen.SHELF_WIDTH = 4.4
Kitchen.SHELF_DEPTH = 2.2
Kitchen.SHELF_HEIGHT = 5.4
local SHELF_LEVELS = { 0.55, 1.85, 3.15 }
local SHELF_COLUMNS = { -1.05, 1.05 }
Kitchen.SHELF_SPOTS = {}
for _, y in SHELF_LEVELS do
	for _, x in SHELF_COLUMNS do
		table.insert(Kitchen.SHELF_SPOTS, CFrame.new(x, y + 0.1, 0.25))
	end
end
-- Eight fish spots in the iced pans of the kitchen storage counter: four across, two deep.
local STORAGE_COLUMNS = { -3.15, -1.05, 1.05, 3.15 }
Kitchen.STORAGE_SPOTS = {}
for _, z in { -0.5, 0.45 } do
	for _, x in STORAGE_COLUMNS do
		table.insert(Kitchen.STORAGE_SPOTS, CFrame.new(x, Kitchen.TOP + 0.05, z))
	end
end

local function builder(parent: Instance, name: string, frame: CFrame)
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	local function piece(
		label: string,
		size: Vector3,
		offset: CFrame,
		color: Color3,
		material: Enum.Material?,
		solid: boolean?
	): Part
		local result = Props.part(model, size, frame * offset, color, material)
		result.Name = label
		if not solid then
			result.CanCollide = false
			result.CanQuery = false
		end
		return result
	end
	-- An upright cylinder standing on `offset`'s height (its centre).
	local function round(label: string, height: number, diameter: number, offset: CFrame, color: Color3, material: Enum.Material?): Part
		local result = piece(label, Vector3.new(height, diameter, diameter), offset * CFrame.Angles(0, 0, math.pi / 2), color, material)
		result.Shape = Enum.PartType.Cylinder
		return result
	end
	local function ball(label: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?): Part
		local result = piece(label, size, offset, color, material)
		result.Shape = Enum.PartType.Ball
		return result
	end
	return model, piece, round, ball
end

-- The cabinet run every station shares: a recessed plinth, a top drawer row over
-- hinged doors, an overhanging worktop and a tiled upstand. `open` leaves the
-- doors off one end, from x = open[1] to open[2], for an open shelf bay.
local function counter(piece, width: number, top: Color3, topMaterial: Enum.Material, body: Color3, open: { number }?)
	local d, h = Kitchen.DEPTH, Kitchen.TOP
	local front = d / 2
	local face = body:Lerp(Color3.new(1, 1, 1), 0.12)
	piece("Plinth", Vector3.new(width - 0.1, 0.3, d - 0.3), CFrame.new(0, 0.15, -0.15), DARK_STEEL, M.Metal, true)
	local bays = math.max(2, math.floor(width / 1.5 + 0.5))
	local bay = (width - 0.2) / bays
	local function isOpen(x: number): boolean
		return open ~= nil and x > open[1] and x < open[2]
	end
	-- The carcass stops where the open bay starts; the bay gets a back, a floor and an end.
	local carcassEnd = width / 2
	for index = 1, bays do
		local x = -width / 2 + 0.1 + (index - 0.5) * bay
		if isOpen(x) then
			carcassEnd = x - bay / 2
			break
		end
	end
	local carcass = carcassEnd + width / 2 - 0.02
	piece("Cabinet", Vector3.new(carcass, h - 0.52, d - 0.02), CFrame.new(-width / 2 + 0.02 + carcass / 2, 0.3 + (h - 0.52) / 2, -0.01), body, M.SmoothPlastic, true)
	if carcassEnd < width / 2 then
		local bayWidth = width / 2 - carcassEnd
		local x = carcassEnd + bayWidth / 2
		local shade = body:Lerp(Color3.new(0, 0, 0), 0.45)
		piece("BayBack", Vector3.new(bayWidth, h - 0.52, 0.1), CFrame.new(x, 0.3 + (h - 0.52) / 2, -d / 2 + 0.06), shade, M.SmoothPlastic, true)
		piece("BayFloor", Vector3.new(bayWidth, 0.1, d - 0.1), CFrame.new(x, 0.35, 0), shade, M.SmoothPlastic, true)
		piece("BayEnd", Vector3.new(0.1, h - 0.52, d - 0.02), CFrame.new(width / 2 - 0.07, 0.3 + (h - 0.52) / 2, -0.01), body, M.SmoothPlastic, true)
	end
	piece("Worktop", Vector3.new(width, 0.22, d + 0.12), CFrame.new(0, h - 0.11, 0.06), top, topMaterial, true)
	piece("WorktopEdge", Vector3.new(width, 0.08, 0.04), CFrame.new(0, h - 0.18, front + 0.13), DARK_STEEL, M.Metal)
	piece("Upstand", Vector3.new(width, 0.9, 0.08), CFrame.new(0, h + 0.45, -front + 0.04), TILE, M.CeramicTiles, true)
	for _, y in { 0.3, 0.6 } do
		piece("UpstandGrout", Vector3.new(width - 0.02, 0.025, 0.02), CFrame.new(0, h + y, -front + 0.09), GROUT, M.SmoothPlastic)
	end
	piece("UpstandCap", Vector3.new(width, 0.06, 0.14), CFrame.new(0, h + 0.93, -front + 0.07), top, topMaterial)
	-- Doors and drawers in matching bays across the run.
	for index = 1, bays do
		local x = -width / 2 + 0.1 + (index - 0.5) * bay
		local inOpenBay = isOpen(x)
		piece("Drawer", Vector3.new(bay - 0.1, 0.42, 0.05), CFrame.new(x, h - 0.5, front + 0.005), face, M.SmoothPlastic)
		piece("DrawerPull", Vector3.new(math.min(0.7, bay * 0.45), 0.06, 0.06), CFrame.new(x, h - 0.5, front + 0.06), DARK_STEEL, M.Metal)
		if not inOpenBay then
			piece("CabinetDoor", Vector3.new(bay - 0.1, h - 1.25, 0.05), CFrame.new(x, 0.3 + (h - 1.25) / 2 + 0.06, front + 0.005), face, M.SmoothPlastic)
			piece("DoorPanel", Vector3.new(bay - 0.42, h - 1.65, 0.03), CFrame.new(x, 0.3 + (h - 1.25) / 2 + 0.06, front + 0.035), body, M.SmoothPlastic)
			local side = if index % 2 == 0 then -1 else 1
			piece("DoorHandle", Vector3.new(0.06, 0.55, 0.06), CFrame.new(x + side * (bay / 2 - 0.22), 1.75, front + 0.08), DARK_STEEL, M.Metal)
		end
	end
end

-- A row of hooks on the upstand with kitchen tools hanging from them.
local function utensils(piece, round, x: number, count: number)
	local back = -Kitchen.DEPTH / 2 + 0.14
	piece("UtensilRail", Vector3.new(count * 0.42 + 0.2, 0.05, 0.05), CFrame.new(x, Kitchen.TOP + 0.82, back), STEEL, M.Metal)
	for index = 1, count do
		local ux = x + (index - (count + 1) / 2) * 0.42
		piece("UtensilHandle", Vector3.new(0.05, 0.5, 0.04), CFrame.new(ux, Kitchen.TOP + 0.55, back + 0.02), DARK_STEEL, M.Metal)
		if index % 2 == 0 then
			piece("Spatula", Vector3.new(0.22, 0.22, 0.02), CFrame.new(ux, Kitchen.TOP + 0.22, back + 0.02), STEEL, M.Metal)
		else
			round("Ladle", 0.1, 0.24, CFrame.new(ux, Kitchen.TOP + 0.26, back + 0.08), STEEL, M.Metal)
		end
	end
end

function Kitchen.buildStation(parent: Instance, frame: CFrame, station: string, width: number?): Model
	if station == "KitchenStorage" then
		return Kitchen.buildStorage(parent, frame)
	end
	local w = width or Kitchen.WIDTH
	local top, back = Kitchen.TOP, -Kitchen.DEPTH / 2
	local model, piece, round, ball = builder(parent, station, frame)
	if station == "Prep" then
		counter(piece, w, STEEL, M.Metal, CABINET)
		-- A deep sink with a drainer at the left end.
		local sinkX = -w / 2 + 1.25
		piece("SinkRim", Vector3.new(1.8, 0.04, 1.6), CFrame.new(sinkX, top + 0.01, 0), STEEL, M.Metal)
		piece("SinkBasin", Vector3.new(1.5, 0.05, 1.3), CFrame.new(sinkX, top + 0.02, 0), DARK_STEEL, M.Metal)
		round("Drain", 0.02, 0.2, CFrame.new(sinkX, top + 0.05, 0), BLACK, M.Metal)
		round("Tap", 0.9, 0.12, CFrame.new(sinkX, top + 0.45, back + 0.35), STEEL, M.Metal)
		piece("Spout", Vector3.new(0.1, 0.1, 0.65), CFrame.new(sinkX, top + 0.86, back + 0.62), STEEL, M.Metal)
		for _, side in { -1, 1 } do
			round("TapHandle", 0.08, 0.16, CFrame.new(sinkX + side * 0.25, top + 0.12, back + 0.35), STEEL, M.Metal)
		end
		for index = 0, 2 do
			piece("DrainerRib", Vector3.new(0.04, 0.02, 1.2), CFrame.new(sinkX + 1.0 + index * 0.15, top + 0.01, 0), DARK_STEEL, M.Metal)
		end
		-- The board the fish is cut on, with a knife and a bowl beside it.
		piece("CuttingBoard", Vector3.new(2.2, 0.1, 1.35), CFrame.new(0.6, top + 0.05, 0.1), LIGHT_WOOD, M.Wood)
		piece("KnifeBlade", Vector3.new(0.8, 0.02, 0.14), CFrame.new(1.25, top + 0.11, 0.6) * CFrame.Angles(0, 0.2, 0), STEEL, M.Metal)
		piece("KnifeHandle", Vector3.new(0.4, 0.06, 0.1), CFrame.new(1.8, top + 0.12, 0.49) * CFrame.Angles(0, 0.2, 0), BLACK, M.SmoothPlastic)
		piece("KnifeBlock", Vector3.new(0.45, 0.65, 0.5), CFrame.new(w / 2 - 0.55, top + 0.32, back + 0.45), WOOD, M.Wood)
		for index = -1, 1 do
			piece("KnifeHilt", Vector3.new(0.07, 0.3, 0.1), CFrame.new(w / 2 - 0.55 + index * 0.12, top + 0.78, back + 0.42), BLACK, M.SmoothPlastic)
		end
		if w >= 8 then
			round("MixingBowl", 0.3, 0.8, CFrame.new(w / 2 - 1.6, top + 0.15, -0.2), STEEL, M.Metal)
			round("BowlInside", 0.02, 0.62, CFrame.new(w / 2 - 1.6, top + 0.3, -0.2), DARK_STEEL, M.Metal)
			utensils(piece, round, -0.6, 4)
			for index, color in { rgb(70, 140, 60), rgb(96, 160, 72) } do
				local x = w / 2 - 2.6 + index * 0.45
				round("HerbPot", 0.35, 0.34, CFrame.new(x, top + 0.18, back + 0.32), rgb(190, 104, 70), M.Concrete)
				ball("Herbs", Vector3.new(0.42, 0.36, 0.42), CFrame.new(x, top + 0.48, back + 0.32), color, M.Grass)
			end
		end
	elseif station == "GrillStation" then
		counter(piece, w, DARK_STEEL, M.Metal, rgb(170, 60, 44))
		-- A charcoal grill set into the worktop, its control knobs on the front.
		piece("GrillFrame", Vector3.new(3.5, 0.2, 1.95), CFrame.new(0.6, top + 0.06, 0), BLACK, M.Metal)
		local coals = piece("Coals", Vector3.new(3.2, 0.06, 1.7), CFrame.new(0.6, top + 0.12, 0), rgb(255, 120, 40), M.Neon)
		coals.Transparency = 0.25
		for bar = -4, 4 do
			piece("GrillBar", Vector3.new(0.06, 0.06, 1.75), CFrame.new(0.6 + bar * 0.36, top + 0.19, 0), DARK_STEEL, M.Metal)
		end
		piece("ControlPanel", Vector3.new(3.4, 0.42, 0.04), CFrame.new(0.6, top - 0.5, Kitchen.DEPTH / 2 + 0.1), STEEL, M.Metal)
		for index = -1, 2 do
			round("GrillKnob", 0.12, 0.22, CFrame.new(0.6 + index * 0.75 - 0.375, top - 0.5, Kitchen.DEPTH / 2 + 0.17) * CFrame.Angles(math.pi / 2, 0, 0), BLACK, M.SmoothPlastic)
		end
		-- A stainless canopy on two back posts draws the smoke up a duct.
		for _, x in { -w / 2 + 0.25, w / 2 - 0.25 } do
			piece("HoodPost", Vector3.new(0.14, 3.3, 0.14), CFrame.new(x, top + 1.65, back + 0.12), DARK_STEEL, M.Metal)
		end
		piece("Hood", Vector3.new(w - 0.3, 0.5, 1.7), CFrame.new(0, top + 3.05, -0.3), STEEL, M.Metal)
		piece("HoodLip", Vector3.new(w - 0.3, 0.12, 0.08), CFrame.new(0, top + 2.75, 0.52), DARK_STEEL, M.Metal)
		piece("HoodFilter", Vector3.new(3.6, 0.04, 1.2), CFrame.new(0.6, top + 2.78, -0.3), DARK_STEEL, M.Metal)
		piece("Duct", Vector3.new(1, 1.2, 0.9), CFrame.new(0.6, top + 3.9, -0.55), STEEL, M.Metal)
		local lamp = piece("HoodLamp", Vector3.new(0.5, 0.04, 0.3), CFrame.new(-2.6, top + 2.79, 0), rgb(255, 238, 200), M.Neon)
		local light = Instance.new("SpotLight")
		light.Face, light.Brightness, light.Range, light.Angle = Enum.NormalId.Bottom, 0.8, 8, 90
		light.Color = rgb(255, 236, 205)
		light.Parent = lamp
		-- Skewers ready on a tray, salt and pepper, tongs resting on the right.
		piece("SkewerTray", Vector3.new(1.6, 0.06, 1), CFrame.new(-2.7, top + 0.03, 0.1), STEEL, M.Metal)
		for index = -1, 1 do
			local z = 0.1 + index * 0.28
			piece("Skewer", Vector3.new(1.4, 0.03, 0.03), CFrame.new(-2.7, top + 0.12, z), LIGHT_WOOD, M.Wood)
			for chunk = -1, 1 do
				piece("SkewerChunk", Vector3.new(0.18, 0.16, 0.16), CFrame.new(-2.7 + chunk * 0.4, top + 0.13, z), if chunk == 0 then rgb(226, 84, 56) else SALMON, M.SmoothPlastic)
			end
		end
		round("Salt", 0.36, 0.16, CFrame.new(-3.9, top + 0.18, back + 0.4), PLATE, M.Glass)
		round("Pepper", 0.36, 0.16, CFrame.new(-3.65, top + 0.18, back + 0.4), BLACK, M.Glass)
		piece("Tongs", Vector3.new(0.9, 0.04, 0.08), CFrame.new(3.3, top + 0.04, 0.4) * CFrame.Angles(0, 0.35, 0), STEEL, M.Metal)
		for index = 0, 2 do
			round("Plate", 0.05, 0.9, CFrame.new(3.4, top + 0.03 + index * 0.06, -0.35), PLATE, M.SmoothPlastic)
		end
		local glow = Instance.new("PointLight")
		glow.Color, glow.Brightness, glow.Range = rgb(255, 140, 60), 0.8, 8
		glow.Parent = coals
	elseif station == "Smoker" then
		-- An open bay at the right end keeps the smoking wood to hand.
		counter(piece, w, WOOD, M.WoodPlanks, rgb(92, 70, 52), { 1.6, w / 2 })
		for row = 0, 2 do
			for index = 0, 3 - row do
				local x = 2.25 + index * 0.55 + row * 0.27
				local log = piece("Log", Vector3.new(1.9, 0.5, 0.5), CFrame.new(x, 0.62 + row * 0.44, 0.1) * CFrame.Angles(0, math.pi / 2, 0), rgb(122, 86, 56), M.Wood)
				log.Shape = Enum.PartType.Cylinder
			end
		end
		-- The smokehouse cabinet: charred planks in iron bands, a window in the door.
		local boxX = -w / 2 + 1.55
		piece("SmokeBox", Vector3.new(2.6, 2.6, 1.9), CFrame.new(boxX, top + 1.3, -0.15), CHARRED, M.WoodPlanks, true)
		for _, y in { 0.25, 2.35 } do
			piece("SmokeBand", Vector3.new(2.66, 0.12, 1.96), CFrame.new(boxX, top + y, -0.15), DARK_STEEL, M.Metal)
		end
		piece("SmokeDoor", Vector3.new(2.1, 1.85, 0.08), CFrame.new(boxX, top + 1.3, 0.83), rgb(76, 60, 46), M.Wood)
		local window = piece("SmokeWindow", Vector3.new(1, 0.6, 0.04), CFrame.new(boxX, top + 1.75, 0.88), rgb(255, 150, 70), M.Glass)
		window.Transparency = 0.3
		piece("SmokeHandle", Vector3.new(0.1, 0.5, 0.1), CFrame.new(boxX + 0.85, top + 1.2, 0.92), DARK_STEEL, M.Metal)
		round("Thermometer", 0.06, 0.42, CFrame.new(boxX - 0.6, top + 2.05, 0.89) * CFrame.Angles(math.pi / 2, 0, 0), PLATE, M.SmoothPlastic)
		piece("Needle", Vector3.new(0.03, 0.16, 0.02), CFrame.new(boxX - 0.6, top + 2.08, 0.93) * CFrame.Angles(0, 0, -0.6), rgb(210, 40, 30), M.Neon)
		piece("SmokeRoof", Vector3.new(2.9, 0.18, 2.2), CFrame.new(boxX, top + 2.69, -0.15), DARK_STEEL, M.Metal)
		round("Chimney", 2, 0.5, CFrame.new(boxX - 0.7, top + 3.7, -0.5), DARK_STEEL, M.Metal)
		piece("ChimneyCap", Vector3.new(0.85, 0.08, 0.85), CFrame.new(boxX - 0.7, top + 4.95, -0.5), BLACK, M.Metal)
		local vent = piece("Vent", Vector3.new(0.4, 0.1, 0.4), CFrame.new(boxX - 0.7, top + 4.72, -0.5), BLACK, M.Metal)
		local smoke = Instance.new("ParticleEmitter")
		smoke.Name = "Smoke"
		smoke.Color = ColorSequence.new(rgb(180, 176, 168))
		smoke.Transparency = NumberSequence.new(0.5, 1)
		smoke.Size = NumberSequence.new(0.6, 2.4)
		smoke.Lifetime = NumberRange.new(2, 3.5)
		smoke.Rate = 4
		smoke.Speed = NumberRange.new(1.5, 2.5)
		smoke.SpreadAngle = Vector2.new(12, 12)
		smoke.Parent = vent
		-- Smoked fish hang from a rail at the back of the open worktop.
		for _, x in { 0.35, w / 2 - 0.35 } do
			piece("RailPost", Vector3.new(0.12, 2.2, 0.12), CFrame.new(x, top + 1.1, back + 0.2), DARK_STEEL, M.Metal)
		end
		piece("HangingRail", Vector3.new(w / 2 - 0.5, 0.08, 0.08), CFrame.new(w / 4, top + 2.15, back + 0.2), DARK_STEEL, M.Metal)
		for index = 0, 3 do
			local x = 1.2 + index * 0.85
			piece("Hook", Vector3.new(0.03, 0.3, 0.03), CFrame.new(x, top + 1.97, back + 0.2), STEEL, M.Metal)
			piece("SmokedFish", Vector3.new(0.45, 0.95, 0.14), CFrame.new(x, top + 1.32, back + 0.2), rgb(176, 96, 44), M.SmoothPlastic)
			piece("FishTail", Vector3.new(0.4, 0.2, 0.1), CFrame.new(x, top + 0.78, back + 0.2), rgb(140, 72, 34), M.SmoothPlastic)
		end
		piece("ChipBucket", Vector3.new(0.7, 0.55, 0.7), CFrame.new(w / 2 - 0.7, top + 0.28, 0.35), rgb(110, 116, 118), M.Metal)
		piece("WoodChips", Vector3.new(0.6, 0.05, 0.6), CFrame.new(w / 2 - 0.7, top + 0.52, 0.35), rgb(170, 120, 74), M.Sand)
	elseif station == "SushiBar" then
		counter(piece, w, LIGHT_WOOD, M.Wood, rgb(70, 54, 44))
		-- A chilled glass neta case along the back shows the day's fish.
		piece("NetaBase", Vector3.new(w - 1.6, 0.35, 0.8), CFrame.new(0, top + 0.17, back + 0.55), DARK_STEEL, M.Metal)
		local glass = piece("NetaGlass", Vector3.new(w - 1.6, 0.6, 0.06), CFrame.new(0, top + 0.62, back + 0.95) * CFrame.Angles(math.rad(-18), 0, 0), rgb(205, 232, 235), M.Glass)
		glass.Transparency = 0.7
		local lid = piece("NetaTop", Vector3.new(w - 1.6, 0.05, 0.75), CFrame.new(0, top + 0.92, back + 0.55), rgb(205, 232, 235), M.Glass)
		lid.Transparency = 0.7
		for index, color in { SALMON, rgb(190, 40, 50), rgb(244, 236, 220), SALMON, rgb(240, 196, 84), rgb(190, 40, 50) } do
			piece("Neta", Vector3.new(0.9, 0.18, 0.4), CFrame.new(-3.1 + (index - 1) * 1.24, top + 0.44, back + 0.55), color, M.SmoothPlastic)
		end
		-- The chef's place: a bamboo mat, the rice tub, soy and a long knife.
		piece("BambooMat", Vector3.new(1.6, 0.05, 1.1), CFrame.new(0.6, top + 0.03, 0.4), rgb(196, 182, 120), M.Fabric)
		round("Hangiri", 0.45, 1.2, CFrame.new(-2.6, top + 0.23, 0.35), LIGHT_WOOD, M.Wood)
		round("HangiriBand", 0.08, 1.24, CFrame.new(-2.6, top + 0.33, 0.35), rgb(184, 115, 51), M.Metal)
		round("Rice", 0.04, 1.05, CFrame.new(-2.6, top + 0.45, 0.35), PLATE, M.SmoothPlastic)
		round("SoyBottle", 0.5, 0.2, CFrame.new(2.6, top + 0.25, 0.3), rgb(40, 20, 12), M.Glass)
		round("SoyCap", 0.1, 0.16, CFrame.new(2.6, top + 0.55, 0.3), rgb(200, 40, 36), M.SmoothPlastic)
		piece("GingerDish", Vector3.new(0.5, 0.05, 0.35), CFrame.new(3.3, top + 0.03, 0.35), PLATE, M.SmoothPlastic)
		ball("Ginger", Vector3.new(0.22, 0.1, 0.2), CFrame.new(3.2, top + 0.09, 0.35), rgb(246, 196, 186), M.SmoothPlastic)
		ball("Wasabi", Vector3.new(0.14, 0.1, 0.14), CFrame.new(3.45, top + 0.09, 0.35), rgb(130, 180, 70), M.SmoothPlastic)
		piece("YanagibaBlade", Vector3.new(1.2, 0.02, 0.12), CFrame.new(1.7, top + 0.05, 0.75), STEEL, M.Metal)
		piece("YanagibaHandle", Vector3.new(0.45, 0.07, 0.09), CFrame.new(2.5, top + 0.06, 0.75), LIGHT_WOOD, M.Wood)
		-- A split noren on a wooden frame, with a paper lantern at each end.
		for _, x in { -w / 2 + 0.2, w / 2 - 0.2 } do
			piece("NorenPost", Vector3.new(0.16, 3.4, 0.16), CFrame.new(x, top + 1.7, back + 0.1), LIGHT_WOOD, M.Wood)
			local lx = x - math.sign(x) * 0.15
			piece("LanternArm", Vector3.new(0.06, 0.06, 0.5), CFrame.new(lx, top + 2.15, back + 0.35), LIGHT_WOOD, M.Wood)
			local lantern = ball("Lantern", Vector3.new(0.55, 0.7, 0.55), CFrame.new(lx, top + 1.75, back + 0.55), rgb(214, 52, 40), M.Fabric)
			piece("LanternCord", Vector3.new(0.03, 0.06, 0.03), CFrame.new(lx, top + 2.12, back + 0.55), BLACK, M.Fabric)
			local glow = Instance.new("PointLight")
			glow.Color, glow.Brightness, glow.Range = rgb(255, 170, 120), 0.4, 6
			glow.Parent = lantern
		end
		piece("NorenRod", Vector3.new(w - 0.1, 0.12, 0.12), CFrame.new(0, top + 3.35, back + 0.1), LIGHT_WOOD, M.Wood)
		local panels = 5
		local panelWidth = (w - 0.8) / panels
		for index = 1, panels do
			local x = -(w - 0.8) / 2 + (index - 0.5) * panelWidth
			piece("Noren", Vector3.new(panelWidth - 0.08, 1.05, 0.04), CFrame.new(x, top + 2.75, back + 0.1), rgb(34, 52, 92), M.Fabric)
			piece("NorenCrest", Vector3.new(0.3, 0.3, 0.05), CFrame.new(x, top + 2.65, back + 0.13), PLATE, M.Fabric)
		end
	else
		error("Unknown kitchen station " .. tostring(station))
	end
	return model
end

-- A chilled prep counter holding up to 8 fish for cooking, in iced steel pans.
function Kitchen.buildStorage(parent: Instance, frame: CFrame): Model
	local model, piece, round = builder(parent, "KitchenStorage", frame)
	local w, top, front, back = Kitchen.WIDTH, Kitchen.TOP, Kitchen.DEPTH / 2, -Kitchen.DEPTH / 2
	counter(piece, w, STEEL, M.Metal, rgb(52, 60, 66))

	local ice = piece("IceBed", Vector3.new(w - 0.6, 0.06, 2.0), CFrame.new(0, top + 0.02, 0), rgb(218, 238, 245), M.Ice, true)
	ice.Transparency = 0.15
	-- One pan per pair of fish, rimmed in steel.
	for _, x in STORAGE_COLUMNS do
		piece("PanRim", Vector3.new(1.9, 0.08, 1.95), CFrame.new(x, top + 0.04, 0), STEEL, M.Metal)
		local pan = piece("PanIce", Vector3.new(1.75, 0.04, 1.8), CFrame.new(x, top + 0.07, 0), rgb(232, 246, 250), M.Ice)
		pan.Transparency = 0.1
		piece("PanDivider", Vector3.new(1.75, 0.04, 0.04), CFrame.new(x, top + 0.09, -0.025), DARK_STEEL, M.Metal)
	end
	-- A sneeze guard over the pans, and the ticket rail behind it.
	for _, x in { -w / 2 + 0.3, w / 2 - 0.3 } do
		piece("GuardPost", Vector3.new(0.08, 1.1, 0.08), CFrame.new(x, top + 0.55, back + 0.3), STEEL, M.Metal)
	end
	local guard = piece("SneezeGuard", Vector3.new(w - 0.5, 0.05, 0.9), CFrame.new(0, top + 1.08, back + 0.7) * CFrame.Angles(math.rad(-10), 0, 0), rgb(214, 236, 240), M.Glass)
	guard.Transparency = 0.75
	piece("TicketRail", Vector3.new(w - 1, 0.1, 0.05), CFrame.new(0, top + 0.75, back + 0.11), DARK_STEEL, M.Metal)
	for index = -3, 3 do
		piece("Ticket", Vector3.new(0.45, 0.5, 0.02), CFrame.new(index * 1.1, top + 0.55, back + 0.13), rgb(245, 245, 230), M.SmoothPlastic)
	end
	-- The chiller's controls and grille on the front.
	-- Between the drawer pulls, clear of the doors.
	local display = piece("TempDisplay", Vector3.new(0.6, 0.26, 0.03), CFrame.new(2.93, top - 0.5, front + 0.05), rgb(90, 220, 255), M.Neon)
	display.Transparency = 0.15
	round("TempKnob", 0.06, 0.18, CFrame.new(0, top - 0.5, front + 0.06) * CFrame.Angles(math.pi / 2, 0, 0), BLACK, M.SmoothPlastic)
	for row = 0, 1 do
		piece("GrilleSlat", Vector3.new(2.2, 0.04, 0.03), CFrame.new(0, 0.1 + row * 0.1, front - 0.28), DARK_STEEL, M.Metal)
	end

	local mist = Instance.new("ParticleEmitter")
	mist.Name = "ChillMist"
	mist.Color = ColorSequence.new(rgb(225, 242, 255))
	mist.Transparency = NumberSequence.new(0.65, 1)
	mist.Size = NumberSequence.new(0.3, 0.8)
	mist.Lifetime = NumberRange.new(1.2, 2)
	mist.Rate = 4
	mist.Speed = NumberRange.new(0.2, 0.6)
	mist.SpreadAngle = Vector2.new(180, 0)
	mist.Parent = ice

	return model
end

-- A refrigerated shop counter. Dishes are added separately at CASE_SPOTS.
function Kitchen.buildCase(parent: Instance, frame: CFrame): Model
	local model, piece = builder(parent, "FoodCase", frame)
	local w, d, shelf = Kitchen.CASE_WIDTH, Kitchen.CASE_DEPTH, Kitchen.CASE_SHELF
	local body = rgb(45, 78, 88)
	local inset = rgb(33, 59, 68)
	local glassColor = rgb(205, 232, 235)

	-- The cabinet remains the solid footprint used by furniture placement.
	-- Offset front details from the cabinet and each other to avoid coplanar faces.
	piece("CaseBase", Vector3.new(w - 0.04, shelf - 0.1, d), CFrame.new(0, (shelf - 0.1) / 2, 0), body, M.SmoothPlastic, true)
	piece("Kickplate", Vector3.new(w - 0.12, 0.25, 0.04), CFrame.new(0, 0.16, d / 2 + 0.005), DARK_STEEL, M.Metal)
	piece("FrontPanel", Vector3.new(w - 0.22, 1.58, 0.04), CFrame.new(0, 1.35, d / 2 + 0.005), inset, M.SmoothPlastic)
	for _, x in CASE_COLUMNS do
		piece("PanelInset", Vector3.new(2.6, 1.35, 0.035), CFrame.new(x, 1.35, d / 2 + 0.03), body, M.SmoothPlastic)
		-- A shallow ventilation grille in each panel makes the lower front read as a chiller.
		for row = 0, 3 do
			piece("VentSlat", Vector3.new(1.8, 0.035, 0.025), CFrame.new(x, 0.75 + row * 0.09, d / 2 + 0.065), DARK_STEEL, M.Metal)
		end
	end
	piece("CaseTrim", Vector3.new(w, 0.12, d), CFrame.new(0, shelf - 0.04, 0), STEEL, M.Metal, true)
	piece("Shelf", Vector3.new(w - 0.2, 0.08, d - 0.2), CFrame.new(0, shelf + 0.06, 0), rgb(236, 242, 238), M.SmoothPlastic)
	piece("ShelfBackLip", Vector3.new(w - 0.25, 0.1, 0.06), CFrame.new(0, shelf + 0.14, -d / 2 + 0.1), STEEL, M.Metal)
	-- A glass divider between each pair of dish columns.
	for _, x in { (CASE_COLUMNS[1] + CASE_COLUMNS[2]) / 2, (CASE_COLUMNS[2] + CASE_COLUMNS[3]) / 2 } do
		local divider = piece("Divider", Vector3.new(0.04, 1.08, d - 0.3), CFrame.new(x, shelf + 0.65, -0.05), glassColor, M.Glass)
		divider.Transparency = 0.8
	end

	-- Sloped customer-facing glass, framed at the edges, with a clear top.
	for _, x in { -w / 2 + 0.05, w / 2 - 0.05 } do
		local side = piece("SideGlass", Vector3.new(0.06, 1.12, d - 0.12), CFrame.new(x, shelf + 0.68, 0), glassColor, M.Glass, true)
		side.Transparency = 0.72
		piece("SideTopRail", Vector3.new(0.1, 0.1, d - 0.1), CFrame.new(x, shelf + 1.25, 0), STEEL, M.Metal)
		piece("FrontUpright", Vector3.new(0.1, 1.16, 0.1), CFrame.new(x, shelf + 0.68, 1.04) * CFrame.Angles(math.rad(-12), 0, 0), STEEL, M.Metal)
		piece("RearUpright", Vector3.new(0.1, 1.12, 0.1), CFrame.new(x, shelf + 0.68, -d / 2 + 0.06), STEEL, M.Metal)
	end
	local front = piece("FrontGlass", Vector3.new(w - 0.2, 1.16, 0.06), CFrame.new(0, shelf + 0.68, 1.04) * CFrame.Angles(math.rad(-12), 0, 0), glassColor, M.Glass, true)
	front.Transparency = 0.72
	local top = piece("TopGlass", Vector3.new(w - 0.2, 0.06, 2.2), CFrame.new(0, shelf + 1.25, -0.18), glassColor, M.Glass, true)
	top.Transparency = 0.72
	piece("FrontTopRail", Vector3.new(w - 0.2, 0.1, 0.1), CFrame.new(0, shelf + 1.25, 0.92), STEEL, M.Metal)
	piece("RearTopRail", Vector3.new(w - 0.2, 0.1, 0.1), CFrame.new(0, shelf + 1.25, -1.25), STEEL, M.Metal)
	piece("FrontLowerRail", Vector3.new(w - 0.2, 0.1, 0.1), CFrame.new(0, shelf + 0.11, 1.16), STEEL, M.Metal)

	-- The rear stays open for the shop's service side. Label cards are decorative;
	-- actual dish inventory remains managed by the display service.
	piece("PriceRail", Vector3.new(w - 0.15, 0.23, 0.04), CFrame.new(0, shelf - 0.2, d / 2 - 0.01), rgb(218, 180, 89), M.SmoothPlastic)
	for _, x in CASE_COLUMNS do
		piece("PriceCard", Vector3.new(0.72, 0.14, 0.025), CFrame.new(x, shelf - 0.2, d / 2 + 0.02), rgb(250, 247, 229), M.SmoothPlastic)
	end
	local lamp = piece("DisplayLamp", Vector3.new(w - 0.5, 0.04, 0.12), CFrame.new(0, shelf + 1.2, -0.94), rgb(255, 241, 205), M.Neon)
	local light = Instance.new("SurfaceLight")
	light.Face, light.Brightness, light.Range, light.Angle = Enum.NormalId.Bottom, 0.6, 3, 120
	light.Color = rgb(255, 246, 228)
	light.Parent = lamp
	-- A small sign on the top glass names the case.
	piece("CaseSign", Vector3.new(2.2, 0.45, 0.06), CFrame.new(0, shelf + 1.52, -1.2), rgb(218, 180, 89), M.SmoothPlastic)
	piece("CaseSignFace", Vector3.new(2, 0.3, 0.02), CFrame.new(0, shelf + 1.52, -1.16), rgb(45, 78, 88), M.SmoothPlastic)
	return model
end

-- An ordinary supermarket shelf unit for cooked dishes. Dishes are added separately
-- at SHELF_SPOTS; the open front (+Z) faces the shoppers.
function Kitchen.buildShelf(parent: Instance, frame: CFrame): Model
	local model, piece = builder(parent, "FoodShelf", frame)
	local w, d, h = Kitchen.SHELF_WIDTH, Kitchen.SHELF_DEPTH, Kitchen.SHELF_HEIGHT
	local white = rgb(236, 238, 236)
	local grey = rgb(196, 200, 200)
	local strip = rgb(214, 74, 58)
	local back = -d / 2

	-- The base plinth is the solid footprint; the kickplate covers its front.
	piece("Base", Vector3.new(w - 0.04, 0.4, d - 0.1), CFrame.new(0, 0.2, 0.03), grey, M.SmoothPlastic, true)
	piece("Kickplate", Vector3.new(w - 0.1, 0.34, 0.04), CFrame.new(0, 0.2, d / 2 - 0.005), DARK_STEEL, M.Metal)
	-- Two end uprights and a pegboard back panel.
	for _, x in { -w / 2 + 0.06, w / 2 - 0.06 } do
		piece("Upright", Vector3.new(0.12, h, 0.2), CFrame.new(x, h / 2, back + 0.14), white, M.Metal, true)
		piece("EndFoot", Vector3.new(0.12, 0.12, d - 0.2), CFrame.new(x, 0.46, 0.06), grey, M.Metal)
	end
	piece("BackPanel", Vector3.new(w - 0.2, h - 0.5, 0.08), CFrame.new(0, (h - 0.5) / 2 + 0.4, back + 0.08), white, M.SmoothPlastic, true)
	for row = 1, 9 do
		for column = -3, 3 do
			piece("PegHole", Vector3.new(0.06, 0.06, 0.02), CFrame.new(column * 0.55, 0.4 + row * 0.5, back + 0.13), grey, M.SmoothPlastic)
		end
	end
	-- Shelves with a red price strip along each front edge.
	for _, y in SHELF_LEVELS do
		piece("Shelf", Vector3.new(w - 0.28, 0.08, d - 0.3), CFrame.new(0, y + 0.06, 0.08), white, M.Metal)
		piece("ShelfBracket", Vector3.new(w - 0.28, 0.16, 0.06), CFrame.new(0, y - 0.04, back + 0.17), grey, M.Metal)
		piece("PriceStrip", Vector3.new(w - 0.3, 0.2, 0.04), CFrame.new(0, y + 0.02, d / 2 - 0.04), strip, M.SmoothPlastic)
		for _, x in SHELF_COLUMNS do
			piece("PriceTag", Vector3.new(0.6, 0.13, 0.02), CFrame.new(x, y + 0.02, d / 2 - 0.01), rgb(252, 250, 236), M.SmoothPlastic)
		end
	end
	piece("TopCap", Vector3.new(w, 0.1, 0.4), CFrame.new(0, h + 0.05, back + 0.2), grey, M.Metal)
	-- A header board on top reads as an aisle sign.
	piece("HeaderBoard", Vector3.new(w - 0.6, 0.6, 0.08), CFrame.new(0, h + 0.4, back + 0.2), strip, M.SmoothPlastic)
	piece("HeaderFace", Vector3.new(w - 0.9, 0.36, 0.02), CFrame.new(0, h + 0.4, back + 0.25), rgb(252, 250, 236), M.SmoothPlastic)
	return model
end

-- One cooked dish, resting with its base on `frame`'s origin. Purely decorative.
function Kitchen.buildDish(recipeId: string, look: string, frame: CFrame): Model
	local model, piece = builder(nil :: any, "Dish", frame)
	model:SetAttribute("RecipeId", recipeId)
	local function round(label: string, y: number, height: number, diameter: number, color: Color3, material: Enum.Material?, x: number?, z: number?): Part
		local part = Props.cylinder(model, (frame * CFrame.new(x or 0, y, z or 0)).Position, height, diameter, color, material)
		part.Name = label
		part.CanCollide, part.CanQuery = false, false
		return part
	end
	if look == "Sushi" or look == "Sashimi" then
		piece("ServingBoard", Vector3.new(1.5, 0.12, 0.8), CFrame.new(0, 0.06, 0), WOOD, M.Wood)
	else
		round("Plate", 0.04, 0.08, 1.35, PLATE, M.SmoothPlastic)
		round("PlateRim", 0.09, 0.03, 1.1, rgb(226, 226, 220), M.SmoothPlastic)
	end
	if look == "Fillet" then
		piece("Fillet", Vector3.new(0.85, 0.14, 0.42), CFrame.new(-0.05, 0.18, 0) * CFrame.Angles(0, 0.3, 0), rgb(240, 160, 130), M.SmoothPlastic)
		local lemon = piece("Lemon", Vector3.new(0.26, 0.26, 0.26), CFrame.new(0.4, 0.22, 0.25), rgb(246, 220, 70), M.SmoothPlastic)
		lemon.Shape = Enum.PartType.Ball
		piece("Herb", Vector3.new(0.3, 0.04, 0.15), CFrame.new(-0.35, 0.13, -0.3), rgb(70, 140, 60), M.Grass)
	elseif look == "Chips" then
		piece("BatteredFish", Vector3.new(0.75, 0.2, 0.36), CFrame.new(-0.18, 0.21, 0) * CFrame.Angles(0, -0.25, 0), rgb(214, 156, 66), M.Sand)
		for index = 1, 6 do
			piece("Chip", Vector3.new(0.45, 0.08, 0.08), CFrame.new(0.32, 0.15 + (index % 2) * 0.07, -0.3 + index * 0.1) * CFrame.Angles(0, index * 0.5, 0), rgb(240, 206, 110), M.SmoothPlastic)
		end
	elseif look == "Grilled" then
		piece("GrilledFish", Vector3.new(1, 0.22, 0.34), CFrame.new(0, 0.2, 0), rgb(158, 120, 84), M.SmoothPlastic)
		piece("Tail", Vector3.new(0.2, 0.18, 0.3), CFrame.new(-0.56, 0.2, 0) * CFrame.Angles(0, math.rad(45), 0), rgb(130, 96, 66), M.SmoothPlastic)
		for index = -1, 1 do
			piece("GrillMark", Vector3.new(0.05, 0.02, 0.32), CFrame.new(index * 0.22, 0.32, 0), BLACK, M.SmoothPlastic)
		end
	elseif look == "Skewers" then
		for _, z in { -0.18, 0.18 } do
			piece("Skewer", Vector3.new(1.2, 0.04, 0.04), CFrame.new(0, 0.2, z), LIGHT_WOOD, M.Wood)
			for index = -1, 1 do
				piece("Chunk", Vector3.new(0.2, 0.2, 0.2), CFrame.new(index * 0.3, 0.2, z), if index == 0 then rgb(226, 84, 56) else rgb(222, 170, 112), M.SmoothPlastic)
			end
		end
	elseif look == "Smoked" then
		for index = 0, 2 do
			piece("SmokedSlice", Vector3.new(0.7, 0.08, 0.3), CFrame.new(0, 0.14 + index * 0.05, -0.2 + index * 0.2) * CFrame.Angles(0, index * 0.25, 0), rgb(176, 92, 40), M.SmoothPlastic)
		end
	elseif look == "Sushi" then
		for index = 0, 5 do
			local x = -0.55 + (index % 3) * 0.55
			local z = if index < 3 then -0.18 else 0.18
			round("Nori", 0.24, 0.24, 0.3, rgb(30, 40, 30), M.SmoothPlastic, x, z)
			round("Rice", 0.37, 0.02, 0.24, PLATE, M.SmoothPlastic, x, z)
			round("Salmon", 0.385, 0.01, 0.1, rgb(240, 120, 80), M.SmoothPlastic, x, z)
		end
	elseif look == "Sashimi" then
		for index = 0, 3 do
			piece("GoldenSlice", Vector3.new(0.3, 0.1, 0.5), CFrame.new(-0.45 + index * 0.3, 0.18, 0) * CFrame.Angles(0, 0, math.rad(-20)), rgb(244, 190, 70), M.Foil)
		end
		piece("Shiso", Vector3.new(0.35, 0.03, 0.4), CFrame.new(0.55, 0.13, 0), rgb(60, 150, 70), M.Grass)
	end
	return model
end

return Kitchen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="231">
          <Properties>
            <string name="Name">Leaderboards</string>
            <string name="Source"><![CDATA[-- Six compact harbour noticeboards, arranged in pairs around the plaza.
local Boards = {}
local LAYOUT_VERSION = 3
Boards.Definitions = {
	{ Id = "Level", Title = "HIGHEST LEVEL", Unit = "LEVEL", Weekly = false },
	{ Id = "WeeklyXP", Title = "MOST XP THIS WEEK", Unit = "XP", Weekly = true },
	{ Id = "Caught", Title = "MOST FISH CAUGHT", Unit = "FISH", Weekly = false },
	{ Id = "WeeklyCaught", Title = "FISH THIS WEEK", Unit = "FISH", Weekly = true },
	{ Id = "Earned", Title = "MOST MONEY EARNED", Unit = "$", Weekly = false },
	{ Id = "WeeklyEarned", Title = "MONEY THIS WEEK", Unit = "$", Weekly = true },
}

local cream = Color3.fromRGB(244, 234, 208)
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))
local gold = Theme.Colors.Text
local function styleBoard(gui)
	local backing = gui:FindFirstChild("BoardWindow") or Instance.new("Frame")
	backing.Name = "BoardWindow"
	backing.Position = UDim2.fromOffset(3, 3)
	backing.Size = UDim2.new(1, -6, 1, -6)
	backing.ZIndex = 0
	backing.Parent = gui
	Theme.window(backing)
	local money = gui.Parent:GetAttribute("LeaderboardId")
	for _, item in gui:GetDescendants() do
		if item:IsA("TextLabel") then
			Theme.text(
				item,
				if (money == "Earned" or money == "WeeklyEarned") and string.match(item.Name, "^Score")
					then Theme.Colors.Green
					else nil
			)
		end
	end
end

local function label(parent, name, text, x, y, width, height, size, color)
	local item = Instance.new("TextLabel")
	item.Name, item.Text = name, text
	item.Position, item.Size = UDim2.fromOffset(x, y), UDim2.fromOffset(width, height)
	item.BackgroundTransparency = 1
	item.Font, item.TextSize = Enum.Font.GothamBold, size
	Theme.text(item, color)
	item.TextXAlignment = Enum.TextXAlignment.Left
	item.TextTruncate = Enum.TextTruncate.AtEnd
	item.Parent = parent
	return item
end

function Boards.build(plaza: Model, pavingFrame: CFrame)
	local existing = plaza:FindFirstChild("Leaderboards")
	if existing and existing:GetAttribute("LayoutVersion") == LAYOUT_VERSION then
		for _, gui in existing:GetDescendants() do
			if gui:IsA("SurfaceGui") and gui.Name == "Leaderboard" then
				styleBoard(gui)
			end
		end
		return existing
	end
	-- Replace older layouts on baked maps as well as new maps.
	if existing then
		existing:Destroy()
	end
	local model = Instance.new("Model")
	model.Name, model.Parent = "Leaderboards", plaza
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model:SetAttribute("LayoutVersion", LAYOUT_VERSION)
	-- Three separated pairs face into the square. All six panels stand at the
	-- same readable height, with paths between pairs and no stacked displays.
	local placements = {
		{ 22, -28, math.pi },
		{ 34, -28, math.pi },
		{ 29, -6, math.pi / 2 },
		{ 29, 6, math.pi / 2 },
		-- Keep the money pair clear of Harbour Home's southwest corner and
		-- entrance, with room for the central path and southern promenade.
		{ 10, 40, 0 },
		{ 22, 40, 0 },
	}
	for index, definition in Boards.Definitions do
		local placement = placements[index]
		local frame = pavingFrame * CFrame.new(placement[1], 0, placement[2]) * CFrame.Angles(0, placement[3], 0)
		local function part(name, size, offset, color, material)
			local p = Instance.new("Part")
			p.Name, p.Size, p.CFrame = name, size, frame * CFrame.new(offset)
			p.Anchored, p.CanTouch = true, false
			p.Color, p.Material = color, material
			p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
			p.Parent = model
			return p
		end
		for _, x in { -4.5, 4.5 } do
			part(
				"CedarPost",
				Vector3.new(0.35, 9.1, 0.5),
				Vector3.new(x, 4.55, 0),
				Color3.fromRGB(109, 77, 51),
				Enum.Material.Wood
			)
		end
		part("LimestoneCap", Vector3.new(9.6, 0.45, 1), Vector3.new(0, 9.1, 0), cream, Enum.Material.Limestone)
		local panel = part(
			definition.Id,
			Vector3.new(8.68, 7.28, 0.35),
			Vector3.new(0, 5.2, 0),
			Theme.Colors.Window,
			Enum.Material.Wood
		)
		panel:SetAttribute("LeaderboardId", definition.Id)
		local gui = Instance.new("SurfaceGui")
		gui.Name, gui.Face = "Leaderboard", Enum.NormalId.Front
		gui.SizingMode, gui.CanvasSize = Enum.SurfaceGuiSizingMode.FixedSize, Vector2.new(620, 520)
		gui.LightInfluence, gui.MaxDistance = 0, 110
		gui.Parent = panel
		styleBoard(gui)
		label(gui, "Title", definition.Title, 22, 12, 576, 36, 26, gold)
		label(
			gui,
			"Period",
			if definition.Weekly then "WEEKLY  /  MONDAY 00:00 UTC" else "ALL TIME  /  GLOBAL TOP 10",
			22,
			50,
			576,
			25,
			17
		)
		label(gui, "Columns", "#    ANGLER", 22, 88, 410, 26, 18, gold)
		local unit = label(gui, "Unit", definition.Unit, 432, 88, 166, 26, 18, gold)
		unit.TextXAlignment = Enum.TextXAlignment.Right
		local rows = Instance.new("Frame")
		rows.Name, rows.BackgroundTransparency = "Rows", 1
		rows.Position, rows.Size = UDim2.fromOffset(22, 121), UDim2.fromOffset(576, 340)
		rows.Parent = gui
		for rank = 1, 10 do
			label(
				rows,
				"Name" .. rank,
				string.format("%02d   —", rank),
				0,
				(rank - 1) * 34,
				402,
				32,
				22,
				Theme.Colors.Text
			)
			local score = label(rows, "Score" .. rank, "—", 408, (rank - 1) * 34, 168, 32, 22)
			Theme.text(score, if definition.Unit == "$" then Theme.Colors.Green else Theme.Colors.Text)
			score.TextXAlignment = Enum.TextXAlignment.Right
		end
		label(gui, "Status", "Loading rankings…", 22, 475, 576, 28, 18)
	end
	return model
end

function Boards.ensure(root: Instance)
	for _, plaza in root:GetDescendants() do
		if plaza:IsA("Model") and plaza.Name == "Plaza" then
			for _, slab in plaza:GetChildren() do
				if
					slab:IsA("BasePart")
					and slab.Size.X >= 115.9
					and slab.Size.X <= 120.1
					and math.abs(slab.Size.X - slab.Size.Z) < 0.01
					and slab.Size.Y <= 1
				then
					Boards.build(plaza, slab.CFrame * CFrame.new(0, slab.Size.Y / 2, 0))
					break
				end
			end
		end
	end
end

function Boards.render(root: Instance, id, entries, status)
	for _, panel in root:GetDescendants() do
		if panel:IsA("BasePart") and panel:GetAttribute("LeaderboardId") == id then
			local gui = panel:FindFirstChild("Leaderboard")
			if not gui then
				continue
			end
			for rank = 1, 10 do
				local entry = entries[rank]
				gui.Rows["Name" .. rank].Text = string.format("%02d   %s", rank, if entry then entry.Name else "—")
				gui.Rows["Score" .. rank].Text = if entry
					then (if id == "Earned" or id == "WeeklyEarned" then "$" else "") .. tostring(entry.Score)
					else "—"
			end
			gui.Status.Text = status
		end
	end
end

return Boards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="232">
          <Properties>
            <string name="Name">Lod</string>
            <string name="Source"><![CDATA[-- Far-away stand-ins for every island. Islands stream in piece by piece; until one has
-- arrived the client shows a coarse faceted shell instead (see client/Lod), so the whole
-- map stays on the horizon for a fraction of the parts.
--
-- Shells are shrink-wrapped from the finished geometry: spherecasts on a polar lattice over
-- the island pick up the ground and any trees or buildings, so forests read as raised canopy.

local GeometryService = game:GetService("GeometryService")

local LowPoly = require(script.Parent.LowPoly)

local Lod = {}

local TAU = math.pi * 2
local SKY = 600 -- spherecasts are capped at 1024 studs, so start low enough to reach the seabed
local WATERLINE = 0.3 -- triangles entirely below this are hidden by the sea anyway
local UNDERWATER = -4 -- coast vertices sink to here so shores slope into the water
-- The home island streams in pieces (see Lod.prepareIsland), so its shell is cut into square
-- tiles the client swaps one at a time. Tiles follow the lattice lines, so their seams close.
local TILE = 192
local TILE_STEP = 48
local REMOVALS_PER_FRAME = 32 -- avoid sending a baked shell's old parts to clients all at once

type Sample = { position: Vector3, color: Color3?, material: Enum.Material? }

local function halfExtent(part: BasePart): Vector3
	local frame, size = part.CFrame, part.Size / 2
	local right, up, back = frame.RightVector, frame.UpVector, frame.LookVector
	return Vector3.new(
		math.abs(right.X) * size.X + math.abs(up.X) * size.Y + math.abs(back.X) * size.Z,
		math.abs(right.Y) * size.X + math.abs(up.Y) * size.Y + math.abs(back.Y) * size.Z,
		math.abs(right.Z) * size.X + math.abs(up.Z) * size.Y + math.abs(back.Z) * size.Z
	)
end

-- Every tile a part's footprint overlaps; client/Lod keys the parts it receives the same way.
local function tileKeys(part: BasePart, originX: number, originZ: number, callback: (string) -> ())
	local half, p = halfExtent(part), part.Position
	for x = math.floor((p.X - half.X - originX) / TILE), math.floor((p.X + half.X - originX) / TILE) do
		for z = math.floor((p.Z - half.Z - originZ) / TILE), math.floor((p.Z + half.Z - originZ) / TILE) do
			callback(x .. "," .. z)
		end
	end
end

-- LodRadial marks a mainland (added after the bake, like Pirate Cove) that is still an ordinary
-- radial island at a distance rather than a tiled block city.
local function tiled(island: Model): boolean
	return island.Name == "Harbour Isle"
		or (island:GetAttribute("LodRoot") == true and island:GetAttribute("LodRadial") ~= true)
end

-- How many ground parts the client has to receive before an untiled shell gives way
local function groundCount(island: Model): number
	local ground = island:FindFirstChild("Ground")
	local count = 0
	for _, d in if ground then ground:GetDescendants() else {} do
		if d:IsA("BasePart") then
			count += 1
		end
	end
	return count
end

-- Ground parts under each tile of a tiled shell, so the client can tell when a tile's real ground is in
local function countTiles(model: Instance, island: Model)
	local originX, originZ = model:GetAttribute("TileOriginX") or 0, model:GetAttribute("TileOriginZ") or 0
	local counts: { [string]: number } = {}
	local ground = island:FindFirstChild("Ground")
	for _, d in if ground then ground:GetDescendants() else {} do
		if d:IsA("BasePart") then
			tileKeys(d, originX, originZ, function(key)
				counts[key] = (counts[key] or 0) + 1
			end)
		end
	end
	for _, tile in model:GetChildren() do
		local count = counts[tile.Name] or 0
		if tile:GetAttribute("Ground") ~= count then
			tile:SetAttribute("Ground", count)
		end
	end
end

local function opaqueParts(model: Model): { BasePart }
	local parts = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Transparency < 0.5 and d.Material ~= Enum.Material.Neon then
			if d.Position.Y + halfExtent(d).Y > UNDERWATER then
				table.insert(parts, d)
			end
		end
	end
	return parts
end

local function sample(params: RaycastParams, x: number, z: number, radius: number): Sample
	local hit = workspace:Spherecast(Vector3.new(x, SKY, z), radius, Vector3.new(0, -1000, 0), params)
	if hit and hit.Position.Y > UNDERWATER then
		local p = hit.Instance :: BasePart
		return { position = Vector3.new(x, hit.Position.Y, z), color = p.Color, material = p.Material }
	end
	return { position = Vector3.new(x, UNDERWATER, z) }
end

local function face(a: Sample, b: Sample, c: Sample, parent: Instance)
	local pa, pb, pc = a.position, b.position, c.position
	local top = a
	for _, s in { b, c } do
		if s.position.Y > top.position.Y then
			top = s
		end
	end
	if top.position.Y < WATERLINE or not top.material then
		return
	end

	local r, g, bl, n = 0, 0, 0, 0
	for _, s in { a, b, c } do
		if s.color then
			r, g, bl, n = r + s.color.R, g + s.color.G, bl + s.color.B, n + 1
		end
	end
	local centroid = (pa + pb + pc) / 3
	LowPoly.triangle(
		pa,
		pb,
		pc,
		centroid - Vector3.new(0, 100, 0),
		Color3.new(r / n, g / n, bl / n),
		parent,
		top.material
	)
end

local function bounds(parts: { BasePart }): (number, number, number, number)
	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	for _, part in parts do
		local half = halfExtent(part)
		minX, maxX = math.min(minX, part.Position.X - half.X), math.max(maxX, part.Position.X + half.X)
		minZ, maxZ = math.min(minZ, part.Position.Z - half.Z), math.max(maxZ, part.Position.Z + half.Z)
	end
	return minX, maxX, minZ, maxZ
end

local function inert(model: Model)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
		end
	end
end

local function radialShell(model: Model, parts: { BasePart })
	local minX, maxX, minZ, maxZ = bounds(parts)
	local cx, cz = (minX + maxX) / 2, (minZ + maxZ) / 2
	local extent = math.max(maxX - minX, maxZ - minZ) / 2

	-- Coarser than the real thing on both axes; small rocks collapse to a single cone.
	local segments = math.clamp(math.round(extent / 14), 5, 24)
	local rings = math.clamp(math.round(extent / 70), 1, 6)
	local spacing = extent / rings

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = parts
	local radius = math.clamp(spacing * 0.35, 2, 16)

	local center = sample(params, cx, cz, radius)
	local lattice: { { Sample } } = {}
	for i = 1, rings do
		local ring = {}
		local r = spacing * i
		for j = 1, segments do
			-- Alternate rings are half a step out of phase so the facets don't line up into spokes
			local angle = (j - 1 + (i % 2) * 0.5) / segments * TAU
			ring[j] = sample(params, cx + math.cos(angle) * r, cz + math.sin(angle) * r, radius)
		end
		lattice[i] = ring
	end

	for j = 1, segments do
		local k = j % segments + 1
		face(center, lattice[1][j], lattice[1][k], model)
		for i = 1, rings - 1 do
			local inner, outer = lattice[i], lattice[i + 1]
			-- Whichever ring is half a step ahead decides which way the strip's diagonals lean
			if i % 2 == 0 then
				face(inner[j], outer[j], inner[k], model)
				face(inner[k], outer[j], outer[k], model)
			else
				face(inner[j], outer[j], outer[k], model)
				face(inner[j], outer[k], inner[k], model)
			end
		end
	end
end

-- A square lattice cut into tiles. Each tile records how many ground parts lie under it,
-- so the client can tell when enough of the real ground has streamed in to replace it.
local function tiledShell(model: Model, island: Model, parts: { BasePart })
	local minX, maxX, minZ, maxZ = bounds(parts)
	local originX, originZ = math.floor(minX / TILE) * TILE, math.floor(minZ / TILE) * TILE
	model:SetAttribute("TileSize", TILE)
	model:SetAttribute("TileOriginX", originX)
	model:SetAttribute("TileOriginZ", originZ)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = parts
	local radius = math.clamp(TILE_STEP * 0.35, 2, 16)

	local cols, rows = math.ceil((maxX - originX) / TILE_STEP), math.ceil((maxZ - originZ) / TILE_STEP)
	local lattice: { { Sample } } = {}
	for i = 0, cols do
		local column = {}
		for k = 0, rows do
			column[k] = sample(params, originX + i * TILE_STEP, originZ + k * TILE_STEP, radius)
		end
		lattice[i] = column
		if i % 8 == 0 then
			task.wait()
		end
	end

	local per = TILE // TILE_STEP
	local tiles: { [string]: Model } = {}
	for i = 0, cols - 1 do
		for k = 0, rows - 1 do
			local key = (i // per) .. "," .. (k // per)
			local tile = tiles[key]
			if not tile then
				tile = Instance.new("Model")
				tile.Name = key
				tile.Parent = model
				tiles[key] = tile
			end
			local a, b, c, d = lattice[i][k], lattice[i + 1][k], lattice[i][k + 1], lattice[i + 1][k + 1]
			if (i + k) % 2 == 0 then
				face(a, b, c, tile)
				face(b, d, c, tile)
			else
				face(a, b, d, tile)
				face(a, d, c, tile)
			end
		end
	end

	for _, tile in tiles do
		if #tile:GetChildren() == 0 then
			tile:Destroy()
		end
	end
	countTiles(model, island)
end

-- A city reads from afar by its blocks, which a heightfield melts into lumps. So every model
-- marked with a LodColor (a building, a ship) becomes one plain box, parts marked LodKeep (crane
-- booms, tanks) are copied as they are, and so are the big flat parts (land, quays, streets),
-- which keeps the real coastline. Tiles still follow the ground under them, as above.
local BLOCK_GROUND = 60 -- loose parts at least this long are copied into the shell

-- Whether the instance or a model above it (below Ground) carries the attribute
local function marked(instance: Instance, ground: Instance, attribute: string): boolean
	local current: Instance? = instance
	while current and current ~= ground do
		if current:GetAttribute(attribute) ~= nil then
			return true
		end
		current = current.Parent
	end
	return false
end

local function boxed(part: BasePart, ground: Instance): boolean
	return part.Parent ~= nil and marked(part.Parent, ground, "LodColor")
end

local function blockShell(model: Model, island: Model)
	local ground = island:FindFirstChild("Ground")
	local items: { BasePart } = {}
	-- A whole city: yield now and then to stay inside the script timeout (the shell is unparented)
	local resumed = os.clock()
	for _, d in if ground then ground:GetDescendants() else {} do
		if os.clock() - resumed > 0.05 then
			task.wait()
			resumed = os.clock()
		end
		-- LodSkip leaves out a part, or a whole model such as rooms below ground
		if marked(d, ground :: Instance, "LodSkip") then
			continue
		elseif d:IsA("Model") then
			local color = d:GetAttribute("LodColor")
			if typeof(color) == "Color3" and d:FindFirstChildWhichIsA("BasePart", true) then
				local frame, size = d:GetBoundingBox()
				local box = Instance.new("Part")
				box.Size = size
				box.CFrame = frame
				box.Color = color
				box.Material = Enum.Material.SmoothPlastic
				box.Anchored = true
				table.insert(items, box)
			end
		elseif d:IsA("BasePart") and d.Transparency < 0.5 then
			local size = d.Size
			local long = math.max(size.X, size.Y, size.Z) >= BLOCK_GROUND
			if d:GetAttribute("LodKeep") or (long and not boxed(d, ground :: Instance)) then
				local copy = d:Clone()
				copy:ClearAllChildren()
				table.insert(items, copy)
			end
		end
	end
	if #items == 0 then
		return
	end
	local minX, _, minZ = bounds(items)
	local originX, originZ = math.floor(minX / TILE) * TILE, math.floor(minZ / TILE) * TILE
	model:SetAttribute("TileSize", TILE)
	model:SetAttribute("TileOriginX", originX)
	model:SetAttribute("TileOriginZ", originZ)
	local tiles: { [string]: Model } = {}
	for _, item in items do
		local p = item.Position
		local key = math.floor((p.X - originX) / TILE) .. "," .. math.floor((p.Z - originZ) / TILE)
		local tile = tiles[key]
		if not tile then
			tile = Instance.new("Model")
			tile.Name = key
			tile.Parent = model
			tiles[key] = tile
		end
		item.Parent = tile
	end
	countTiles(model, island)
end

-- Built unparented: it only goes into the world once merged (see merge).
local function shell(island: Model): Model
	local model = Instance.new("Model")
	model.Name = tostring(island:GetAttribute("LodId"))
	model:SetAttribute("LodStamp", island:GetAttribute("LodStamp"))
	-- Offshore slopes can be much wider than a small rock. Build its distant
	-- silhouette from the visible island rather than its submerged footprint.
	local parts = opaqueParts(island)
	if island:GetAttribute("LodRoot") and not island:GetAttribute("LodRadial") then
		blockShell(model, island)
		inert(model)
	elseif #parts > 0 then
		if tiled(island) then
			tiledShell(model, island, parts)
		else
			radialShell(model, parts)
			model:SetAttribute("Ground", groundCount(island))
		end
		inert(model)
	end
	return model
end

-- Welds a shell's wedges into one union. The renderer stops drawing small parts on the horizon
-- whenever graphics quality steps down (automatic quality does that on every frame-rate dip),
-- which blinked whole shells out of the sea; a single island-sized part survives that culling.
-- GeometryService works on unparented parts, so new shells replicate as finished unions
-- instead of thousands of wedges that every client receives only to drop them again.
local function merge(model: Instance)
	local parts = {}
	for _, d in model:GetChildren() do
		if d:IsA("BasePart") then
			table.insert(parts, d)
		end
	end
	if #parts < 2 then
		return
	end
	local others = table.move(parts, 2, #parts, 1, {})
	local ok, result = pcall(GeometryService.UnionAsync, GeometryService, parts[1], others, {
		CollisionFidelity = Enum.CollisionFidelity.Box,
		RenderFidelity = Enum.RenderFidelity.Precise,
		SplitApart = false,
	})
	if not ok or not result[1] then
		-- The loose wedges still work as a shell, just one that culls more eagerly
		warn(string.format("[Lod] Could not merge shell %s: %s", model.Name, tostring(result)))
		return
	end
	local union = result[1] :: BasePart
	union.Name = "Shell"
	union.Anchored = true
	union.CanCollide = false
	union.CanQuery = false
	union.CanTouch = false
	union.CastShadow = false
	union.Parent = model
	local replicated = model:IsDescendantOf(workspace)
	for index, part in parts do
		part:Destroy()
		-- Old baked shells can already be visible when this migration runs. Spread
		-- their replicated removals across frames; new, unparented shells need no delay.
		if replicated and index % REMOVALS_PER_FRAME == 0 and index < #parts then
			task.wait()
		end
	end
end

local function mergeShell(model: Instance)
	if model:GetAttribute("TileSize") then
		for _, tile in model:GetChildren() do
			merge(tile)
			task.wait()
		end
	else
		merge(model)
	end
end

local function mergeAll(container: Instance)
	for _, model in container:GetChildren() do
		mergeShell(model)
		task.wait()
	end
end

-- Islands are the models directly inside each biome folder that have a Ground mesh, then any
-- mainland (the city) marked LodRoot directly in the map. Mainlands come last, so the ids
-- handed out by index stay what they were for every island.
local function islands(root: Instance): { Model }
	local found = {}
	for _, folder in root:GetChildren() do
		if folder:IsA("Folder") then
			for _, child in folder:GetChildren() do
				if child:IsA("Model") and child:FindFirstChild("Ground") then
					table.insert(found, child)
				end
			end
		end
	end
	for _, child in root:GetChildren() do
		if child:IsA("Model") and child:GetAttribute("LodRoot") and child:FindFirstChild("Ground") then
			table.insert(found, child)
		end
	end
	return found
end

-- Every island is cut into pieces that stream in one at a time and are then pinned for the
-- player they reached (see Lod.serve), so once an island is drawn it never streams back out
-- and reloads. Plain streaming couldn't promise that: with StreamOutBehavior LowMemory the
-- client throws out everything past StreamingMinRadius whenever the device runs short of
-- memory, which reloaded the harbour over and over. Pinning a whole island instead meant
-- it arrived as one atomic unit, thousands of wedges created in a single frame, which froze
-- the game every time one came into range. A piece is small enough to arrive without a hitch.
-- PersistentPerPlayer behaves as Atomic until the server adds the player, then as Persistent.
local PIECE_TAG = "LodPiece"
local PIECE_PARTS = 200 -- models up to this size stream in as one piece; bigger ones are split
local CHUNK = 96 -- loose ground wedges are regrouped into square chunks this wide
local PIN_BATCH = 500 -- most pieces one request may pin

local pieces: { [number]: Model } = {}
local pieceIds: { [Model]: number } = {}
local split: { [Model]: boolean } = {}
local lastId = 0

-- Ids are handed out afresh every server start; ones baked into a saved map are replaced.
local function addPiece(model: Model)
	if pieceIds[model] then
		return
	end
	lastId += 1
	local id = lastId
	pieces[id] = model
	pieceIds[model] = id
	model.ModelStreamingMode = Enum.ModelStreamingMode.PersistentPerPlayer
	model:SetAttribute("PieceId", id)
	model:AddTag(PIECE_TAG)
end

-- BaseParts under a model, or nil when it holds a model that streams by rules of its own
local function plainParts(model: Model, pause: (() -> ())?): number?
	local count = 0
	for _, d in model:GetDescendants() do
		if pause then
			pause()
		end
		if d:IsA("BasePart") then
			count += 1
		elseif d:IsA("Model") and d.ModelStreamingMode ~= Enum.ModelStreamingMode.Default then
			return nil
		end
	end
	return count
end

-- Ground is thousands of anonymous wedges loose in one model (and its seabed slope), so it
-- is regrouped by position. Nothing looks ground wedges up by name.
local function chunkGround(container: Instance, pause: (() -> ())?)
	local chunks: { [string]: Model } = {}
	for _, child in container:GetChildren() do
		if pause then
			pause()
		end
		if child:IsA("BasePart") then
			local key = math.floor(child.Position.X / CHUNK) .. "," .. math.floor(child.Position.Z / CHUNK)
			local chunk = chunks[key]
			if not chunk then
				chunk = Instance.new("Model")
				chunk.Name = "GroundChunk"
				addPiece(chunk)
				chunks[key] = chunk
			end
			child.Parent = chunk
		elseif child:IsA("Model") then
			if child:HasTag(PIECE_TAG) then
				addPiece(child)
			else
				chunkGround(child, pause)
			end
		end
	end
	for _, chunk in chunks do
		chunk.Parent = container
	end
end

-- A player base is too big for one piece, but splitting it left its quay, deck and other loose
-- parts streaming normally, and the code that finds them by name under the base stops it
-- being regrouped. So a base is pinned whole; pieces baked inside one by older maps go back
-- to plain models, or their stale ids would pin the wrong pieces.
local BASE_TAG = "PlayerBase"

local function pinWhole(model: Model, pause: (() -> ())?)
	for _, d in model:GetDescendants() do
		if pause then
			pause()
		end
		if d:IsA("Model") and d:HasTag(PIECE_TAG) then
			d:RemoveTag(PIECE_TAG)
			d:SetAttribute("PieceId", nil)
			d.ModelStreamingMode = Enum.ModelStreamingMode.Default
		end
	end
	addPiece(model)
end

-- Everything else keeps its place in the hierarchy: a model small enough becomes a piece as
-- it is, a bigger one is split into its children. Loose parts in a big model stay as they
-- were and still stream normally.
local function splitIntoPieces(container: Instance, pause: (() -> ())?)
	for _, child in container:GetChildren() do
		if pause then
			pause()
		end
		if child:IsA("Model") then
			local mode = child.ModelStreamingMode
			if child:HasTag(BASE_TAG) then
				pinWhole(child, pause)
			elseif child:HasTag(PIECE_TAG) or mode == Enum.ModelStreamingMode.Atomic then
				-- An atomic model (a shop, say) already arrives whole, so pinning changes nothing else
				addPiece(child)
			elseif mode == Enum.ModelStreamingMode.Default then
				local parts = plainParts(child, pause)
				if parts and parts <= PIECE_PARTS then
					addPiece(child)
				else
					splitIntoPieces(child, pause)
				end
			end
		elseif child:IsA("Folder") then
			splitIntoPieces(child, pause)
		end
	end
end

-- Must run before an island's contents first replicate: switching a model's streaming mode
-- after clients have it makes it stream in all over again. So each island is split once,
-- either as it's generated or at startup before anyone has a character. `pause` may yield, so it is
-- passed only where nothing can replicate meanwhile: startup, or an island that is still unparented.
local function splitIsland(island: Model, pause: (() -> ())?)
	if split[island] then
		return
	end
	split[island] = true
	island.ModelStreamingMode = Enum.ModelStreamingMode.Default
	for _, child in island:GetChildren() do
		if child:IsA("Model") and child.Name == "Ground" and not child:HasTag(PIECE_TAG) then
			chunkGround(child, pause)
		end
	end
	splitIntoPieces(island, pause)
end

-- Called as a generated island is parented. Its trees and houses are added after that, so
-- each is split as it goes in, in the same frame and so before it first replicates.
function Lod.prepareIsland(island: Model)
	if split[island] then
		return
	end
	-- A whole city is split here; while it is unparented, yield now and then to stay inside the
	-- script timeout. A parented island is split in the frame it arrived, before it replicates.
	local pause: (() -> ())? = nil
	if island.Parent == nil then
		local resumed = os.clock()
		pause = function()
			if os.clock() - resumed > 0.05 then
				task.wait()
				resumed = os.clock()
			end
		end
	end
	splitIsland(island, pause)
	island.ChildAdded:Connect(function(child)
		if child:IsA("Model") and child.ModelStreamingMode == Enum.ModelStreamingMode.Default then
			local parts = plainParts(child)
			if parts and parts <= PIECE_PARTS then
				addPiece(child)
			else
				splitIntoPieces(child)
			end
		end
	end)
end

-- Scenery swapped into a live island later (a company island's dressing) is cut into
-- pieces the same way. Call it while `model` is still unparented, so its pieces never
-- replicate under another streaming mode first.
function Lod.pin(model: Model)
	local parts = plainParts(model)
	if parts and parts <= PIECE_PARTS then
		addPiece(model)
	else
		splitIntoPieces(model)
	end
end

-- Forgets the pieces in scenery that is about to be destroyed.
function Lod.release(model: Instance)
	for _, d in model:GetDescendants() do
		local id = if d:IsA("Model") then pieceIds[d] else nil
		if id then
			pieces[id], pieceIds[d] = nil, nil
		end
	end
	local id = if model:IsA("Model") then pieceIds[model] else nil
	if id then
		pieces[id], pieceIds[model] = nil, nil
	end
end

-- Clients report each piece as it streams in (see client/Lod) and the server pins it for
-- them. Pins used to last the whole session, so a player who sailed the map ended up holding
-- all of it. On an 8 GB laptop that filled memory within the hour; Roblox then evicted and
-- re-streamed everything that wasn't pinned (NPCs, boats, props) over and over, which showed
-- as constant Replicator GC Job / Part/Model Removals hitches and mi_collect calls in the
-- client log. Pins now follow the player: a piece farther than UNPIN_DISTANCE is released
-- (the client draws the island's shell again once it streams out) and pinned again when the
-- player comes back within REPIN_DISTANCE, after the client confirms the piece is still loaded.
local UNPIN_DISTANCE = 1100
local REPIN_DISTANCE = 450
local SWEEP_SECONDS = 4
local SWEEP_BUDGET = 0.004 -- seconds of server time one sweep step may take before yielding

function Lod.serve()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	if ReplicatedStorage:FindFirstChild("LodPin") then
		return
	end
	local Players = game:GetService("Players")
	local pinned: { [Player]: { [number]: boolean } } = {}
	-- Pieces released for being far away; ask the client about them when the player returns.
	-- Pinning an unloaded piece here would force its whole atomic model to arrive at once,
	-- bypassing the engine's normal streaming budget on every return to an island.
	local released: { [Player]: { [number]: boolean } } = {}
	-- Piece centres, measured once (island scenery doesn't move)
	local centers: { [number]: Vector3 } = {}
	Players.PlayerRemoving:Connect(function(player)
		pinned[player] = nil
		released[player] = nil
	end)

	local function centerOf(id: number, piece: Model): Vector3
		local center = centers[id]
		if not center then
			center = piece:GetBoundingBox().Position
			centers[id] = center
		end
		return center
	end
	local function flatDistance(a: Vector3, b: Vector3): number
		local dx, dz = a.X - b.X, a.Z - b.Z
		return math.sqrt(dx * dx + dz * dz)
	end

	-- The sweep yields between players and pieces, while pin requests keep arriving, so it
	-- walks a snapshot of the ids rather than the live tables.
	local snapshot: { number } = {}
	local function idsOf(set: { [number]: boolean }): { number }
		table.clear(snapshot)
		for id in set do
			table.insert(snapshot, id)
		end
		return snapshot
	end
	local remote = Instance.new("RemoteEvent")
	remote.Name = "LodPin"

	task.spawn(function()
		while true do
			task.wait(SWEEP_SECONDS)
			local resumed = os.clock()
			for _, player in Players:GetPlayers() do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if not root or not root:IsA("BasePart") then
					continue
				end
				local position = root.Position
				local held, away = pinned[player], released[player]
				if held then
					for _, id in idsOf(held) do
						if not held[id] then
							continue
						end
						local piece = pieces[id]
						if not piece or not piece.Parent then
							held[id] = nil
							centers[id] = nil
						elseif flatDistance(centerOf(id, piece), position) > UNPIN_DISTANCE then
							held[id] = nil
							piece:RemovePersistentPlayer(player)
							if not away then
								away = {}
								released[player] = away
							end
							away[id] = true
						end
						if os.clock() - resumed > SWEEP_BUDGET then
							task.wait()
							resumed = os.clock()
							if not player.Parent then
								break
							end
						end
					end
				end
				if away and player.Parent then
					local confirm: { number } = {}
					for _, id in idsOf(away) do
						if not away[id] then
							continue
						end
						local piece = pieces[id]
						if not piece or not piece.Parent then
							away[id] = nil
						elseif flatDistance(centerOf(id, piece), position) < REPIN_DISTANCE then
							-- Only already-streamed models may be repinned. Missing models arrive
							-- at the engine's pace and report themselves through the usual path.
							table.insert(confirm, id)
							if #confirm >= PIN_BATCH then
								remote:FireClient(player, confirm)
								confirm = {}
							end
						end
						if os.clock() - resumed > SWEEP_BUDGET then
							task.wait()
							resumed = os.clock()
							if not player.Parent then
								break
							end
						end
					end
					if #confirm > 0 and player.Parent then
						remote:FireClient(player, confirm)
					end
				end
			end
		end
	end)

	remote.OnServerEvent:Connect(function(player, ids)
		if typeof(ids) ~= "table" then
			return
		end
		local held = pinned[player]
		if not held then
			held = {}
			pinned[player] = held
		end
		for i, id in ids do
			if typeof(i) ~= "number" or i > PIN_BATCH then
				break
			end
			local piece = if typeof(id) == "number" then pieces[id] else nil
			if piece and not held[id] then
				if not piece.Parent then
					pieces[id], pieceIds[piece] = nil, nil
				elseif piece.ModelStreamingMode == Enum.ModelStreamingMode.PersistentPerPlayer then
					held[id] = true
					local away = released[player]
					if away then
						away[id] = nil
					end
					piece:AddPersistentPlayer(player)
				end
			end
		end
	end)
	remote.Parent = ReplicatedStorage
end

function Lod.prepareStreaming(root: Instance, pause: (() -> ())?)
	local shells = root:FindFirstChild("Lod")
	if shells and shells:IsA("Model") then
		-- Apply to baked maps too, so distant stand-ins cannot stream out/reload.
		shells.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	end
	for _, island in islands(root) do
		splitIsland(island, pause)
		-- A generated harbour parents its empty Bases folder before building the bases in it,
		-- so the island's ChildAdded split never saw them
		for _, d in island:GetDescendants() do
			if pause then
				pause()
			end
			if d:IsA("Model") and d:HasTag(BASE_TAG) and not pieceIds[d] then
				pinWhole(d, pause)
			end
		end
		-- Counts baked into a saved map go stale whenever startup repairs rebuild some ground
		-- (the harbour's drydock channel, say). A tile waiting for ground that no longer exists
		-- stayed up over the finished town, so count again from the ground as it is now.
		local id = island:GetAttribute("LodId")
		local shell = if shells and id ~= nil then shells:FindFirstChild(tostring(id)) else nil
		if pause then
			pause()
		end
		if shell and shell:GetAttribute("TileSize") then
			countTiles(shell, island)
		elseif shell then
			-- An untiled home shell is only a stand-in until Lod.build tiles it; don't make it
			-- wait for the whole town, or it sits over the harbour until the swap
			local count = if tiled(island) then 1 else groundCount(island)
			if shell:GetAttribute("Ground") ~= count then
				shell:SetAttribute("Ground", count)
			end
		end
	end
end

-- Builds shells under root.Lod if they aren't already baked in. The client keeps a shell
-- over its island until the island has mostly streamed in, so half an island never shows.
function Lod.build(root: Instance)
	-- Islands were split at startup (or as generated); this pass only re-counts, so it may yield
	local resumed = os.clock()
	Lod.prepareStreaming(root, function()
		if os.clock() - resumed > 0.05 then
			task.wait()
			resumed = os.clock()
		end
	end)
	local baked = root:FindFirstChild("Lod")
	if baked then
		local lastId = 0
		for _, island in islands(root) do
			lastId = math.max(lastId, tonumber(island:GetAttribute("LodId")) or 0)
		end
		for _, child in baked:GetChildren() do
			lastId = math.max(lastId, tonumber(child.Name) or 0)
		end
		-- Maps baked before the home island's shell came in tiles get a tiled one; the old
		-- single shell vanished at the island's first ground part and left the rest missing.
		-- A mainland added or rebuilt since the bake (the city) gets a fresh shell too.
		for _, island in islands(root) do
			local id = island:GetAttribute("LodId")
			local mainland = island:GetAttribute("LodRoot") == true
			if id == nil and mainland then
				lastId += 1
				id = lastId
				island:SetAttribute("LodId", id)
			end
			local old = if id ~= nil then baked:FindFirstChild(tostring(id)) else nil
			local stale = mainland and (not old or old:GetAttribute("LodStamp") ~= island:GetAttribute("LodStamp"))
			if id ~= nil and (stale or (tiled(island) and not (old and old:GetAttribute("TileSize")))) then
				-- This runs on every server start until a map with the current shell is saved
				print("[Lod] Rebuilding the " .. island.Name .. " shell; save the map to skip this")
				local replacement = shell(island)
				mergeShell(replacement)
				if old then
					old:Destroy()
				end
				replacement.Parent = baked
			end
		end
		-- Shells baked before they were merged still arrive as loose wedges
		mergeAll(baked)
		return
	end
	local started = os.clock()

	local container = Instance.new("Model")
	container.Name = "Lod"
	container.ModelStreamingMode = Enum.ModelStreamingMode.Persistent

	local parts = 0
	for id, island in islands(root) do
		island:SetAttribute("LodId", id)
		local model = shell(island)
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				parts += 1
			end
		end
		mergeShell(model)
		model.Parent = container
		-- Generation may continue after the harbour opens. Share the scheduler
		-- after each shell instead of blocking live players for twenty islands.
		task.wait()
	end
	container.Parent = root

	print(string.format("[Lod] Built %d shell parts in %.1fs", parts, os.clock() - started))
end

return Lod
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="233">
          <Properties>
            <string name="Name">LowPoly</string>
            <string name="Source"><![CDATA[-- Flat-shaded geometry built from WedgeParts. Every triangle is two wedges,
-- which is what gives the map its faceted, Dredge-like look.

local LowPoly = {}

local THICKNESS = 0.6

local function wedge(color: Color3, material: Enum.Material): WedgePart
	local w = Instance.new("WedgePart")
	w.Anchored = true
	w.CanTouch = false
	w.TopSurface = Enum.SurfaceType.Smooth
	w.BottomSurface = Enum.SurfaceType.Smooth
	w.Material = material
	w.Color = color
	return w
end

-- `inside` is any point behind the face; the wedges' thickness is pushed toward it
-- so the visible surface sits exactly on the triangle.
function LowPoly.triangle(
	a: Vector3,
	b: Vector3,
	c: Vector3,
	inside: Vector3,
	color: Color3,
	parent: Instance,
	material: Enum.Material?,
	thickness: number?
)
	if (b - a):Cross(c - a).Magnitude < 0.01 then
		return
	end

	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b

	local right = ac:Cross(ab).Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))

	local normal = if right:Dot((a + b + c) / 3 - inside) >= 0 then right else -right
	local depth = thickness or THICKNESS
	local shift = -normal * (depth / 2)
	local mat = material or Enum.Material.SmoothPlastic

	local w1 = wedge(color, mat)
	w1.Size = Vector3.new(depth, height, math.abs(ab:Dot(back)))
	w1.CFrame = CFrame.fromMatrix((a + b) / 2 + shift, right, up, back)
	w1.Parent = parent

	local w2 = wedge(color, mat)
	w2.Size = Vector3.new(depth, height, math.abs(ac:Dot(back)))
	w2.CFrame = CFrame.fromMatrix((a + c) / 2 + shift, -right, up, -back)
	w2.Parent = parent
end

-- Open-bottomed pyramid over a ring of base points (in order around the ring).
function LowPoly.pyramid(
	base: { Vector3 },
	apex: Vector3,
	color: Color3,
	parent: Instance,
	material: Enum.Material?,
	inside: Vector3?
)
	local centroid = Vector3.zero
	for _, p in base do
		centroid += p
	end
	centroid /= #base
	local core = inside or centroid:Lerp(apex, 0.3)
	for i = 1, #base do
		LowPoly.triangle(base[i], base[i % #base + 1], apex, core, color, parent, material)
	end
end

-- Faceted rock: two pyramids sharing a jittered ring.
function LowPoly.boulder(
	center: Vector3,
	radius: number,
	rng: Random,
	color: Color3,
	parent: Instance,
	material: Enum.Material?
)
	local ring = {}
	local sides = rng:NextInteger(5, 6)
	for i = 1, sides do
		local a = (i + rng:NextNumber(-0.25, 0.25)) / sides * math.pi * 2
		local r = radius * rng:NextNumber(0.8, 1.15)
		ring[i] = center + Vector3.new(math.cos(a) * r, rng:NextNumber(-0.25, 0.25) * radius, math.sin(a) * r)
	end
	local top = center
		+ Vector3.new(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0.7, 1.1), rng:NextNumber(-0.3, 0.3)) * radius
	local bottom = center - Vector3.new(0, radius * 0.7, 0)
	LowPoly.pyramid(ring, top, color, parent, material, center)
	LowPoly.pyramid(ring, bottom, color, parent, material, center)
end

return LowPoly
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="234">
          <Properties>
            <string name="Name">Mediterranean</string>
            <string name="Source"><![CDATA[-- Mediterranean set dressing for Harbour Isle: whitewashed cube houses, pastel townhouses, villas,
-- domed chapels, windmills, olive and cypress trees, and the fittings of a piazza.
-- Builders follow the Props conventions: a ground position, a facing (front on local +Z), parts in a new Model.

local LowPoly = require(script.Parent.LowPoly)
local Props = require(script.Parent.Props)

local Med = {}

local TAU = math.pi * 2
local rgb = Color3.fromRGB
local M = Enum.Material
local part, cylinder, beam, blob, ball = Props.part, Props.cylinder, Props.beam, Props.blob, Props.ball
local light, shade, pick = Props.light, Props.shade, Props.pick

local WHITEWASH = rgb(242, 240, 232)
local OFFWHITE = rgb(226, 222, 210)
local AEGEAN = rgb(36, 92, 168)
local TERRACOTTA = rgb(184, 92, 58)
local STONE = rgb(204, 192, 168)
local STONE_WALL = rgb(168, 154, 130)
local IRON = rgb(44, 42, 40)
local BRASS = rgb(186, 148, 70)
local WOOD = rgb(122, 92, 64)
local WOOD_DARK = rgb(78, 60, 46)
local TRUNK = rgb(96, 76, 58)
local OLIVE_BARK = rgb(112, 100, 86)
local LAMP = rgb(255, 210, 140)
local GLASS = rgb(44, 60, 76)
local DIRT = rgb(170, 132, 92)
local LEAF = rgb(70, 104, 56)
local VINE = rgb(84, 122, 58)
local CYPRESS = rgb(46, 72, 50)
local STONE_PINE = rgb(62, 92, 56)
local LAVENDER = rgb(146, 112, 196)
local CANVAS = rgb(240, 234, 218)
local WATER = rgb(78, 160, 178)

Med.WHITEWASH = WHITEWASH
Med.AEGEAN = AEGEAN

local SHUTTERS = { rgb(36, 92, 168), rgb(28, 120, 150), rgb(40, 70, 130), rgb(64, 118, 72), rgb(92, 126, 66) }
local TOWN_SHUTTERS = { rgb(64, 110, 72), rgb(92, 126, 66), rgb(112, 74, 52), rgb(40, 96, 120), rgb(150, 120, 60) }
local PASTELS = {
	rgb(236, 206, 150),
	rgb(232, 176, 140),
	rgb(242, 224, 184),
	rgb(216, 152, 112),
	rgb(246, 234, 204),
	rgb(224, 190, 120),
	rgb(210, 128, 96),
}
local ROOF_TILES = { rgb(184, 92, 58), rgb(166, 80, 52), rgb(196, 110, 70), rgb(150, 70, 48) }
local BLOOMS = { rgb(206, 44, 122), rgb(226, 80, 156), rgb(180, 40, 110), rgb(236, 120, 170) }
local OLIVE_LEAF = { rgb(128, 140, 96), rgb(112, 126, 86), rgb(142, 152, 110) }
local AWNINGS = { rgb(180, 52, 44), rgb(36, 92, 168), rgb(56, 120, 70), rgb(214, 160, 50), rgb(120, 60, 110) }
local SHOPS = { "Taverna", "Bakery", "Caffè", "Fishmonger", "Gelato", "Olive Oil", "Pottery", "Enoteca", "Bottega" }

type Look = {
	frame: Color3,
	shutter: Color3?,
	arched: boolean,
	winW: number,
	winH: number,
	spacing: number,
}

type Facade = {
	floor: number,
	storyH: number,
	stories: number,
	doorX: number?,
	doorGap: number?,
	skipSide: number?,
	extras: ((side: number, story: number, face: CFrame) -> ())?,
}

local function newModel(name: string, parent: Instance): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

----------------------------------------------------------------------------------------------------
-- Facade pieces

-- Frame on the outer surface of one wall of a w x d block standing on `base`, `y` up from it.
-- Side 0 is the front (+Z), 1 is +X, 2 the back, 3 is -X. +Z of the frame points out of the wall.
local function wallFace(base: CFrame, w: number, d: number, side: number, y: number): (CFrame, number)
	local outward = if side % 2 == 0 then d / 2 else w / 2
	local width = if side % 2 == 0 then w else d
	return base * CFrame.Angles(0, side * math.pi / 2, 0) * CFrame.new(0, y, outward), width
end

-- Upright disc on a wall (arch heads, round windows, clock faces); `face` is its centre.
local function disc(
	m: Model,
	face: CFrame,
	diameter: number,
	thickness: number,
	color: Color3,
	material: Enum.Material
): Part
	local p = cylinder(m, Vector3.zero, thickness, diameter, color, material)
	p.CFrame = face * CFrame.Angles(0, math.pi / 2, 0)
	return p
end

-- Window centred on `face`, with a plaster surround, sill, optional arched head and open shutters.
local function window(
	m: Model,
	face: CFrame,
	width: number,
	height: number,
	frame: Color3,
	shutter: Color3?,
	arched: boolean,
	lit: boolean
): Part
	local color, material = if lit then LAMP else GLASS, if lit then M.Neon else M.Glass
	part(m, Vector3.new(width + 0.8, height + 0.8, 0.12), face * CFrame.new(0, 0, 0.06), frame, M.Plaster)
	local glassDepth = if arched then 0.18 else 0.1
	local glass = part(m, Vector3.new(width, height, 0.2), face * CFrame.new(0, 0, glassDepth), color, material)
	local mullionDepth = if arched then 0.44 else 0.26
	part(m, Vector3.new(0.15, height, mullionDepth), face * CFrame.new(0, 0, mullionDepth / 2), frame, M.Wood)
	if arched then
		-- Overlapping arch, glazing and mullion faces stay 0.08 studs apart.
		disc(m, face * CFrame.new(0, height / 2, 0.14), width + 0.8, 0.12, frame, M.Plaster)
		disc(m, face * CFrame.new(0, height / 2, 0.27), width, 0.18, color, material)
	end
	part(m, Vector3.new(width + 1.4, 0.35, 0.9), face * CFrame.new(0, -height / 2 - 0.35, 0.4), frame, M.Plaster)
	if shutter then
		for flap = -1, 1, 2 do
			part(
				m,
				Vector3.new(width / 2 + 0.1, height + 0.2, 0.15),
				face * CFrame.new(flap * (width * 0.75 + 0.55), 0, 0.1),
				shutter,
				M.WoodPlanks
			)
		end
	end
	return glass
end

-- Door standing on `face` (bottom centre on the wall) with a surround, handle and a stone step.
local function door(
	m: Model,
	face: CFrame,
	width: number,
	height: number,
	color: Color3,
	frame: Color3,
	arched: boolean
): Part
	part(
		m,
		Vector3.new(width + 1, height + 0.5, 0.12),
		face * CFrame.new(0, (height + 0.5) / 2, 0.06),
		frame,
		M.Plaster
	)
	local leaf = part(m, Vector3.new(width, height, 0.3), face * CFrame.new(0, height / 2, 0.15), color, M.WoodPlanks)
	if arched then
		disc(m, face * CFrame.new(0, height + 0.5, 0.14), width + 1, 0.12, frame, M.Plaster)
		disc(m, face * CFrame.new(0, height, 0.25), width, 0.26, color, M.WoodPlanks)
	end
	ball(m, (face * CFrame.new(width * 0.3, height * 0.45, 0.4)).Position, 0.35, BRASS, M.Metal)
	part(m, Vector3.new(width + 2.2, 0.5, 1.8), face * CFrame.new(0, 0.25, 0.9), STONE, M.Limestone)
	return leaf
end

-- Axis-aligned bounding box of `pieces` inside `frame`: minimum and maximum corners.
local function boundsIn(frame: CFrame, pieces: { BasePart }): (Vector3, Vector3)
	local minimum = Vector3.new(math.huge, math.huge, math.huge)
	local maximum = -minimum
	for _, piece in pieces do
		for x = -1, 1, 2 do
			for y = -1, 1, 2 do
				for z = -1, 1, 2 do
					local corner = frame:PointToObjectSpace(
						piece.CFrame:PointToWorldSpace(
							Vector3.new(piece.Size.X * x, piece.Size.Y * y, piece.Size.Z * z) / 2
						)
					)
					minimum = minimum:Min(corner)
					maximum = maximum:Max(corner)
				end
			end
		end
	end
	return minimum, maximum
end

-- Keep a balcony's slab and ironwork as decoration behind one bounding hitbox:
-- a single solid body instead of a dozen thin colliders.
local function collapseBalcony(parent: Instance, pieces: { BasePart }, frame: CFrame)
	local minimum, maximum = boundsIn(frame, pieces)
	local hitbox = part(parent, maximum - minimum, frame * CFrame.new((minimum + maximum) / 2), IRON, M.Slate)
	hitbox.Name = "BalconyHitbox"
	hitbox.Transparency = 1
	hitbox.CastShadow = false
	hitbox.CanCollide = true
	hitbox.CanQuery = true
	for _, piece in pieces do
		piece.CanCollide, piece.CanTouch, piece.CanQuery = false, false, false
	end
end

-- Balcony whose floor is level with `face`, with a wrought-iron railing.
local function balcony(m: Model, face: CFrame, width: number, depth: number, slab: Color3)
	local pieces = {}
	local function detail(size: Vector3, at: CFrame, color: Color3, material: Enum.Material)
		table.insert(pieces, part(m, size, at, color, material))
	end
	detail(Vector3.new(width, 0.5, depth), face * CFrame.new(0, -0.25, depth / 2), slab, M.Plaster)
	local posts = math.max(3, math.floor(width / 1.1))
	for i = 0, posts do
		local x = -width / 2 + 0.2 + (width - 0.4) * i / posts
		detail(Vector3.new(0.14, 2.6, 0.14), face * CFrame.new(x, 1.3, depth - 0.2), IRON, M.Metal)
	end
	detail(Vector3.new(width - 0.2, 0.2, 0.22), face * CFrame.new(0, 2.6, depth - 0.2), IRON, M.Metal)
	for side = -1, 1, 2 do
		detail(
			Vector3.new(0.2, 0.2, depth - 0.2),
			face * CFrame.new(side * (width / 2 - 0.2), 2.6, depth / 2),
			IRON,
			M.Metal
		)
	end
	collapseBalcony(m, pieces, face)
end

local function flowerBox(m: Model, face: CFrame, width: number, rng: Random)
	part(m, Vector3.new(width, 0.8, 0.9), face * CFrame.new(0, 0, 0.6), TERRACOTTA, M.Sandstone)
	for k = 1, 3 do
		local color = if rng:NextNumber() < 0.6 then pick(rng, BLOOMS) else LEAF
		blob(
			m,
			(face * CFrame.new((k - 2) * width / 3.2, 0.6, 0.6)).Position,
			Vector3.new(1.1, 0.9, 0.9),
			rng,
			color,
			M.LeafyGrass
		)
	end
end

-- Windows across every wall of a w x d block. The front ground floor leaves a gap for the door.
local function fenestrate(m: Model, base: CFrame, w: number, d: number, rng: Random, look: Look, facade: Facade)
	local lit = false
	for side = 0, 3 do
		if side == facade.skipSide then
			continue
		end
		local _, width = wallFace(base, w, d, side, 0)
		local n = math.max(1, math.floor(width / look.spacing))
		for s = 1, facade.stories do
			local y = facade.floor + (s - 1) * facade.storyH + facade.storyH * 0.55
			local face = wallFace(base, w, d, side, y)
			for i = 1, n do
				local x = (i - (n + 1) / 2) * width / n
				local gap = facade.doorGap or (look.winW / 2 + 3)
				local skip = if side == 0
					then s == 1 and facade.doorX ~= nil and math.abs(x - facade.doorX) < gap
					else rng:NextNumber() < 0.3
				if not skip then
					local glow = rng:NextNumber() < 0.3
					local at = face * CFrame.new(x, 0, 0)
					local glass = window(m, at, look.winW, look.winH, look.frame, look.shutter, look.arched, glow)
					if glow and not lit then
						light(glass, LAMP, 18, 0.7)
						lit = true
					end
					if facade.extras then
						facade.extras(side, s, at)
					end
				end
			end
		end
	end
end

-- Block with a flat roof: a slab lipped over the walls and a low parapet round the terrace.
local function flatBlock(m: Model, base: CFrame, w: number, d: number, floor: number, h: number, color: Color3)
	part(m, Vector3.new(w, h, d), base * CFrame.new(0, floor + h / 2, 0), color, M.Plaster)
	part(m, Vector3.new(w + 0.6, 0.4, d + 0.6), base * CFrame.new(0, floor + h + 0.2, 0), color, M.Plaster)
	for side = 0, 3 do
		local face, width = wallFace(base, w, d, side, floor + h + 0.9)
		local length = if side % 2 == 0 then width else width - 1.2
		part(m, Vector3.new(length, 1, 0.6), face * CFrame.new(0, 0, -0.3), color, M.Plaster)
	end
end

-- Shallow clay-tile roof with its ridge along local X. Returns how far the ridge rises above `top`.
local function gableRoof(
	m: Model,
	base: CFrame,
	w: number,
	d: number,
	top: number,
	pitch: number,
	roof: Color3,
	gable: Color3
): number
	local rise = d / 2 * math.tan(pitch)
	local slant = (d / 2 + 1.4) / math.cos(pitch)
	for side = -1, 1, 2 do
		part(
			m,
			Vector3.new(w + 2, 0.7, slant),
			base * CFrame.new(0, top + rise / 2, side * d / 4) * CFrame.Angles(side * pitch, 0, 0),
			roof,
			M.ClayRoofTiles
		)
		local x = side * w / 2
		LowPoly.triangle(
			base:PointToWorldSpace(Vector3.new(x, top, -d / 2)),
			base:PointToWorldSpace(Vector3.new(x, top, d / 2)),
			base:PointToWorldSpace(Vector3.new(x, top + rise, 0)),
			base:PointToWorldSpace(Vector3.new(0, top, 0)),
			gable,
			m,
			M.Plaster
		)
	end
	part(
		m,
		Vector3.new(w + 2.2, 0.8, 1),
		base * CFrame.new(0, top + rise + 0.15, 0),
		roof:Lerp(Color3.new(0, 0, 0), 0.2),
		M.ClayRoofTiles
	)
	return rise
end

-- Squat whitewashed chimney with a little capped vent, Cycladic style.
local function chimney(m: Model, at: CFrame)
	part(m, Vector3.new(1.8, 3, 1.8), at * CFrame.new(0, 1.5, 0), WHITEWASH, M.Plaster)
	part(m, Vector3.new(2.4, 0.4, 2.4), at * CFrame.new(0, 3.6, 0), WHITEWASH, M.Plaster)
	for side = -1, 1, 2 do
		part(m, Vector3.new(0.4, 0.8, 2), at * CFrame.new(side * 0.8, 3.1, 0), WHITEWASH, M.Plaster)
	end
end

-- Facade pieces shared with the piazza's bespoke houses.
Med.window, Med.door, Med.balcony, Med.flowerBox, Med.gableRoof = window, door, balcony, flowerBox, gableRoof

-- Little blue dome on a drum, topped with a cross.
local function dome(m: Model, at: Vector3, diameter: number, drum: number)
	cylinder(m, at + Vector3.new(0, drum / 2, 0), drum, diameter, WHITEWASH, M.Plaster)
	ball(m, at + Vector3.new(0, drum, 0), diameter, AEGEAN, M.SmoothPlastic)
	local tip = at + Vector3.new(0, drum + diameter / 2, 0)
	part(m, Vector3.new(0.3, 2.4, 0.3), CFrame.new(tip + Vector3.new(0, 1, 0)), IRON, M.Metal)
	part(m, Vector3.new(1.2, 0.3, 0.3), CFrame.new(tip + Vector3.new(0, 1.5, 0)), IRON, M.Metal)
end

-- Bougainvillea climbing a wall from a root on `face` to a spill of blossom `height` up.
function Med.bougainvillea(parent: Instance, face: CFrame, rng: Random, height: number): Model
	local m = newModel("Bougainvillea", parent)
	beam(
		m,
		(face * CFrame.new(0, 0, 0.4)).Position,
		(face * CFrame.new(-0.4, height, 0.5)).Position,
		0.35,
		TRUNK,
		nil,
		M.Wood
	)
	for _ = 1, rng:NextInteger(6, 9) do
		local p = face * CFrame.new(rng:NextNumber(-3.4, 1), height + rng:NextNumber(-2.4, 1), rng:NextNumber(0.5, 1.1))
		local s = rng:NextNumber(1.4, 2.4)
		local color = if rng:NextNumber() < 0.75 then shade(pick(rng, BLOOMS), rng, 0.08) else LEAF
		blob(m, p.Position, Vector3.new(s, s * 0.8, s * 0.6), rng, color, M.LeafyGrass).CanCollide = false
	end
	Props.simplifyDecorationCollision(m)
	return m
end

-- Outdoor masonry stair running up a side wall from the front to the roof.
local function sideStair(m: Model, base: CFrame, w: number, d: number, floor: number, roofY: number, side: number)
	local steps = math.ceil((roofY - floor) / 0.9)
	local run = (d - 1.5) / steps
	local x = side * (w / 2 + 1.4)
	for i = 1, steps do
		local top = floor + (roofY - floor) * i / steps
		local z = d / 2 - 0.5 - (i - 0.5) * run
		part(m, Vector3.new(2.8, top, run), base * CFrame.new(x, top / 2, z), WHITEWASH, M.Plaster)
	end
	local low = base:PointToWorldSpace(Vector3.new(side * (w / 2 + 2.6), floor + 1.4, d / 2 - 0.5))
	local high = base:PointToWorldSpace(Vector3.new(side * (w / 2 + 2.6), roofY + 1.4, -d / 2 + 1))
	beam(m, low, high, 0.6, WHITEWASH, 1.2, M.Plaster)
end

----------------------------------------------------------------------------------------------------
-- Pots and plants

-- Terracotta pot holding flowers, a shrub or a little lemon tree.
function Med.pot(parent: Instance, ground: Vector3, rng: Random, plant: string?): Model
	local m = newModel("Pot", parent)
	local kind = plant or pick(rng, { "flowers", "shrub", "lemon" })
	local s = if kind == "lemon" then 2.6 else rng:NextNumber(1.6, 2.2)
	cylinder(m, ground + Vector3.new(0, s * 0.45, 0), s * 0.9, s, TERRACOTTA, M.Sandstone)
	cylinder(
		m,
		ground + Vector3.new(0, s * 0.92, 0),
		s * 0.15,
		s * 1.15,
		TERRACOTTA:Lerp(Color3.new(0, 0, 0), 0.15),
		M.Sandstone
	)
	local soil = ground + Vector3.new(0, s, 0)
	if kind == "lemon" then
		beam(m, soil - Vector3.new(0, 0.5, 0), soil + Vector3.new(0, 3, 0), 0.4, TRUNK, nil, M.Wood)
		local crown = soil + Vector3.new(0, 4.2, 0)
		blob(m, crown, Vector3.new(3.4, 3, 3.4), rng, rgb(60, 110, 50), M.LeafyGrass)
		for _ = 1, 6 do
			local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.6, 0.8), rng:NextNumber(-1, 1)).Unit
			ball(m, crown + dir * 1.9, 0.55, rgb(244, 214, 60), M.SmoothPlastic)
		end
	elseif kind == "shrub" then
		blob(
			m,
			soil + Vector3.new(0, 0.6, 0),
			Vector3.new(s * 1.2, s, s * 1.2),
			rng,
			shade(LEAF, rng, 0.1),
			M.LeafyGrass
		)
	else
		for _ = 1, 3 do
			local at = soil + Vector3.new(rng:NextNumber(-0.4, 0.4), 0.5, rng:NextNumber(-0.4, 0.4))
			blob(m, at, Vector3.new(1, 0.8, 1), rng, pick(rng, BLOOMS), M.LeafyGrass)
		end
	end
	Props.simplifyDecorationCollision(m)
	return m
end

function Med.lavender(parent: Instance, ground: Vector3, rng: Random): Model
	local m = newModel("Lavender", parent)
	for _ = 1, rng:NextInteger(3, 5) do
		local at = ground + Vector3.new(rng:NextNumber(-2.2, 2.2), 0.5, rng:NextNumber(-2.2, 2.2))
		blob(m, at, Vector3.new(1.8, 1.1, 1.8), rng, rgb(104, 120, 84), M.LeafyGrass)
		part(
			m,
			Vector3.new(1.4, 0.8, 1.4),
			CFrame.new(at + Vector3.new(0, 0.9, 0)) * CFrame.Angles(0, rng:NextNumber(0, TAU), 0),
			shade(LAVENDER, rng, 0.08),
			M.LeafyGrass
		)
	end
	Props.simplifyDecorationCollision(m)
	return m
end

----------------------------------------------------------------------------------------------------
-- Trees

-- Gnarled olive: a twisting trunk under flat silvery-green clumps.
function Med.olive(parent: Instance, ground: Vector3, rng: Random, scale: number?): Model
	local k = scale or 1
	local m = newModel("Olive", parent)
	local lean = rng:NextNumber(0, TAU)
	local dir = Vector3.new(math.cos(lean), 0, math.sin(lean))
	local h = rng:NextNumber(8, 12) * k
	local knee = ground + Vector3.new(0, h * 0.35, 0) + dir * rng:NextNumber(0.8, 1.8) * k
	local top = ground + Vector3.new(0, h * 0.62, 0) - dir * rng:NextNumber(0, 1) * k
	beam(m, ground - Vector3.new(0, 1, 0), knee, 1.9 * k, OLIVE_BARK, nil, M.Wood)
	beam(m, knee, top, 1.4 * k, OLIVE_BARK, nil, M.Wood)
	local crowns = { top + Vector3.new(0, 1.5 * k, 0) }
	for _ = 1, rng:NextInteger(2, 3) do
		local a = rng:NextNumber(0, TAU)
		local tip = top + Vector3.new(math.cos(a) * 3.5 * k, rng:NextNumber(1, 2.5) * k, math.sin(a) * 3.5 * k)
		beam(m, knee:Lerp(top, 0.6), tip, 0.7 * k, OLIVE_BARK, nil, M.Wood)
		table.insert(crowns, tip)
	end
	for _, c in crowns do
		local s = rng:NextNumber(5, 7.5) * k
		part(
			m,
			Vector3.new(s, s * 0.5, s * rng:NextNumber(0.8, 1.1)),
			CFrame.new(c + Vector3.new(0, s * 0.15, 0))
				* CFrame.Angles(rng:NextNumber(-0.25, 0.25), rng:NextNumber(0, TAU), rng:NextNumber(-0.25, 0.25)),
			shade(pick(rng, OLIVE_LEAF), rng, 0.05),
			M.LeafyGrass
		)
	end
	Props.simplifyDecorationCollision(m)
	return m
end

-- Tall dark spindle of a cypress.
function Med.cypress(parent: Instance, ground: Vector3, rng: Random, height: number?): Model
	local m = newModel("Cypress", parent)
	local h = height or rng:NextNumber(16, 26)
	local r = h * rng:NextNumber(0.09, 0.11)
	part(m, Vector3.new(1, 3, 1), CFrame.new(ground + Vector3.new(0, 0.5, 0)), TRUNK, M.Wood)
	local ringY = h * 0.3
	local spin = rng:NextNumber(0, TAU)
	local ring = {}
	for i = 1, 5 do
		local a = spin + i / 5 * TAU
		ring[i] = ground + Vector3.new(math.cos(a) * r, ringY + rng:NextNumber(-0.4, 0.4), math.sin(a) * r)
	end
	local color = shade(CYPRESS, rng, 0.08)
	local core = ground + Vector3.new(0, ringY, 0)
	local apex = ground + Vector3.new(rng:NextNumber(-0.3, 0.3), h, rng:NextNumber(-0.3, 0.3))
	LowPoly.pyramid(ring, apex, color, m, M.LeafyGrass, core)
	LowPoly.pyramid(ring, ground + Vector3.new(0, 1.5, 0), color:Lerp(Color3.new(0, 0, 0), 0.12), m, M.LeafyGrass, core)
	return m
end

-- Umbrella pine: a tall leaning trunk under a flat, spreading crown.
function Med.stonePine(parent: Instance, ground: Vector3, rng: Random): Model
	local m = newModel("StonePine", parent)
	local h = rng:NextNumber(17, 25)
	local lean = rng:NextNumber(0, TAU)
	local dir = Vector3.new(math.cos(lean), 0, math.sin(lean))
	local top = ground + Vector3.new(0, h, 0) + dir * rng:NextNumber(1.5, 4)
	local mid = ground:Lerp(top, 0.55) + dir * 0.6
	beam(m, ground - Vector3.new(0, 1, 0), mid, 1.5, rgb(110, 78, 58), nil, M.Wood)
	beam(m, mid, top, 1.2, rgb(110, 78, 58), nil, M.Wood)
	local crowns = { top + Vector3.new(0, 1, 0) }
	for _ = 1, rng:NextInteger(2, 3) do
		local a = rng:NextNumber(0, TAU)
		local tip = top
			+ Vector3.new(
				math.cos(a) * rng:NextNumber(4, 6),
				rng:NextNumber(-1.5, 0.5),
				math.sin(a) * rng:NextNumber(4, 6)
			)
		beam(m, mid:Lerp(top, 0.7), tip, 0.6, rgb(110, 78, 58), nil, M.Wood)
		table.insert(crowns, tip)
	end
	for i, c in crowns do
		local s = if i == 1 then rng:NextNumber(12, 15) else rng:NextNumber(7, 10)
		part(
			m,
			Vector3.new(s, 2.6, s * rng:NextNumber(0.75, 1)),
			CFrame.new(c + Vector3.new(0, 1, 0)) * CFrame.Angles(rng:NextNumber(-0.08, 0.08), rng:NextNumber(0, TAU), 0),
			shade(STONE_PINE, rng, 0.07),
			M.LeafyGrass
		)
	end
	Props.simplifyDecorationCollision(m)
	return m
end

----------------------------------------------------------------------------------------------------
-- Houses

-- Cycladic cube house: whitewashed walls, blue door and shutters, a flat roof terrace, and often
-- a second block stacked on top, an outside stair, a pergola or a little dome.
function Med.cubeHouse(parent: Instance, ground: Vector3, facing: number, rng: Random): Model
	local m = newModel("CubeHouse", parent)
	local base = CFrame.new(ground) * CFrame.Angles(0, facing, 0)
	local w, d, h = rng:NextNumber(17, 22), rng:NextNumber(15, 18), rng:NextNumber(10.5, 12)
	local accent = pick(rng, SHUTTERS)
	local shuttered = rng:NextNumber() < 0.65
	local look: Look = {
		frame = if shuttered then OFFWHITE else accent,
		shutter = if shuttered then accent else nil,
		arched = rng:NextNumber() < 0.4,
		winW = 2.6,
		winH = 3.2,
		spacing = 7.5,
	}
	local floor = 0.6
	local stairSide = if rng:NextNumber() < 0.5 then -1 else 1
	local hasStair = rng:NextNumber() < 0.55

	part(m, Vector3.new(w + 1, 2, d + 1), base * CFrame.new(0, -0.4, 0), STONE, M.Limestone)
	flatBlock(m, base, w, d, floor, h, WHITEWASH)
	local doorX = rng:NextNumber(-w * 0.22, w * 0.22)
	local front = wallFace(base, w, d, 0, floor)
	door(m, front * CFrame.new(doorX, 0, 0), 3.6, 7.2, accent, look.frame, rng:NextNumber() < 0.6)
	fenestrate(m, base, w, d, rng, look, {
		floor = floor,
		storyH = h,
		stories = 1,
		doorX = doorX,
		skipSide = if hasStair then (if stairSide == 1 then 1 else 3) else nil,
	})
	if rng:NextNumber() < 0.55 then
		Med.bougainvillea(m, front * CFrame.new(doorX + 3.4, 0, 0), rng, 8.6)
	end

	local roofY = floor + h + 0.4
	local hasUpper = rng:NextNumber() < 0.65
	if hasUpper then
		local w2, d2, h2 = w * rng:NextNumber(0.42, 0.58), d * rng:NextNumber(0.5, 0.65), rng:NextNumber(8.5, 9.5)
		local upper = base * CFrame.new(-stairSide * ((w - w2) / 2 - 0.6), roofY, -((d - d2) / 2 - 0.6))
		flatBlock(m, upper, w2, d2, 0, h2, WHITEWASH)
		door(m, wallFace(upper, w2, d2, 0, 0), 3, 6.6, accent, look.frame, true)
		fenestrate(m, upper, w2, d2, rng, look, { floor = 0, storyH = h2, stories = 1, doorX = 0 })
		local upperRoof = upper * CFrame.new(0, h2 + 0.4, 0)
		if rng:NextNumber() < 0.25 then
			dome(m, upperRoof.Position, math.min(w2, d2) * 0.55, 1.2)
		else
			chimney(m, upperRoof * CFrame.new(w2 / 4, 0, -d2 / 4))
		end
	else
		chimney(m, base * CFrame.new(-w / 4, roofY, -d / 4))
	end

	-- Life on the roof terrace in front of the upper block
	local terrace = base * CFrame.new(stairSide * w / 4, roofY, d / 4)
	local shaded = rng:NextNumber() < 0.45
	if shaded then
		Med.pergola(m, terrace.Position, facing, rng, w * 0.4, d * 0.35, 7)
	end
	for _, corner in { -stairSide, stairSide } do
		if rng:NextNumber() < 0.6 and not (shaded and corner == stairSide) then
			Med.pot(m, base:PointToWorldSpace(Vector3.new(corner * (w / 2 - 1.6), roofY, d / 2 - 1.6)), rng)
		end
	end
	if hasStair then
		sideStair(m, base, w, d, floor, roofY, stairSide)
	end
	Props.simplifyHouseCollision(m)
	return m
end

-- Pastel townhouse of two or three floors under a clay-tile roof: shutters, balconies,
-- flower boxes and sometimes a shopfront with a striped awning.
function Med.townhouse(parent: Instance, ground: Vector3, facing: number, rng: Random, shopfront: boolean?): Model
	local m = newModel("Townhouse", parent)
	local base = CFrame.new(ground) * CFrame.Angles(0, facing, 0)
	local w, d = rng:NextNumber(15, 19), rng:NextNumber(13, 16)
	local stories = if rng:NextNumber() < 0.6 then 2 else 3
	local storyH = rng:NextNumber(8.5, 9.5)
	local h = stories * storyH
	local wall = pick(rng, PASTELS)
	local trim = WHITEWASH:Lerp(wall, 0.2)
	local look: Look = {
		frame = trim,
		shutter = pick(rng, TOWN_SHUTTERS),
		arched = rng:NextNumber() < 0.3,
		winW = 2.4,
		winH = 3.6,
		spacing = 7,
	}
	local floor = 0.6
	local shop = if shopfront ~= nil then shopfront else rng:NextNumber() < 0.3

	part(m, Vector3.new(w + 1, 2, d + 1), base * CFrame.new(0, -0.4, 0), STONE, M.Limestone)
	part(m, Vector3.new(w, h, d), base * CFrame.new(0, floor + h / 2, 0), wall, M.Plaster)
	if rng:NextNumber() < 0.5 then
		for _, c in { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } } do
			part(m, Vector3.new(1, h, 1), base * CFrame.new(c[1] * w / 2, floor + h / 2, c[2] * d / 2), trim, M.Plaster)
		end
	end
	for s = 1, stories - 1 do
		part(m, Vector3.new(w + 0.5, 0.5, d + 0.5), base * CFrame.new(0, floor + s * storyH, 0), trim, M.Plaster)
	end
	part(m, Vector3.new(w + 1, 0.9, d + 1), base * CFrame.new(0, floor + h + 0.45, 0), trim, M.Plaster)
	gableRoof(m, base, w, d, floor + h + 0.9, math.rad(rng:NextNumber(18, 24)), pick(rng, ROOF_TILES), wall)

	local front = wallFace(base, w, d, 0, floor)
	if shop then
		-- Shop window under a striped awning, a sign board above it, the door to one side
		local sw, sx = w * 0.55, -w * 0.12
		local awning = pick(rng, AWNINGS)
		part(m, Vector3.new(sw + 1, 5.6, 0.14), front * CFrame.new(sx, 3.2, 0.07), WOOD_DARK, M.Wood)
		local glass = part(m, Vector3.new(sw, 4.6, 0.2), front * CFrame.new(sx, 3.3, 0.12), LAMP, M.Neon)
		light(glass, LAMP, 20, 0.8)
		part(m, Vector3.new(sw + 1.2, 0.6, 1.2), front * CFrame.new(sx, 0.8, 0.5), WOOD, M.WoodPlanks)
		for i = 0, 5 do
			part(
				m,
				Vector3.new(sw / 6, 0.25, 3.8),
				front * CFrame.new(sx - sw / 2 + (i + 0.5) * sw / 6, 6.6, 1.7) * CFrame.Angles(0.35, 0, 0),
				if i % 2 == 0 then awning else CANVAS,
				M.Fabric
			)
		end
		local board =
			part(m, Vector3.new(sw * 0.8, 1.4, 0.3), front * CFrame.new(sx, 7.9, 0.2), WOOD_DARK, M.WoodPlanks)
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Back
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.Garamond
		label.TextScaled = true
		label.TextColor3 = rgb(245, 230, 190)
		label.Text = pick(rng, SHOPS)
		label.Parent = gui
		gui.Parent = board
		door(m, front * CFrame.new(sx + sw / 2 + 2.4, 0, 0), 3, 6.4, WOOD_DARK, trim, false)
		Med.pot(m, front:PointToWorldSpace(Vector3.new(sx - sw / 2 - 1.2, 0, 1.4)), rng)
	else
		door(m, front, 3.4, 6.4, pick(rng, TOWN_SHUTTERS), trim, true)
		for side = -1, 1, 2 do
			if rng:NextNumber() < 0.5 then
				Med.pot(m, front:PointToWorldSpace(Vector3.new(side * 3.2, 0, 1.2)), rng)
			end
		end
	end

	fenestrate(m, base, w, d, rng, look, {
		floor = floor,
		storyH = storyH,
		stories = stories,
		doorX = 0,
		doorGap = if shop then w else nil,
		extras = function(side, story, face)
			if side ~= 0 or story == 1 then
				return
			end
			if rng:NextNumber() < 0.45 then
				balcony(m, face * CFrame.new(0, 0.5 - storyH * 0.55, 0), look.winW * 2 + 2, 2.2, trim)
				if rng:NextNumber() < 0.5 then
					Med.pot(m, face:PointToWorldSpace(Vector3.new(look.winW, 0.5 - storyH * 0.55, 1.2)), rng, "flowers")
				end
			elseif rng:NextNumber() < 0.6 then
				flowerBox(m, face * CFrame.new(0, -look.winH / 2 - 0.9, 0), look.winW + 0.6, rng)
			end
		end,
	})
	if not shop and rng:NextNumber() < 0.35 then
		Med.bougainvillea(m, front * CFrame.new(-2.6, 0, 0), rng, 7.4)
	end
	Props.simplifyHouseCollision(m)
	return m
end

-- Two-storey villa with a columned loggia carrying a balustraded terrace, flanked by cypresses.
function Med.villa(parent: Instance, ground: Vector3, facing: number, rng: Random): Model
	local m = newModel("Villa", parent)
	local base = CFrame.new(ground) * CFrame.Angles(0, facing, 0)
	local w, d = rng:NextNumber(22, 25), rng:NextNumber(15, 17)
	local storyH, stories = 9, 2
	local h = storyH * stories
	local wall = if rng:NextNumber() < 0.4 then WHITEWASH else pick(rng, PASTELS)
	local trim = WHITEWASH:Lerp(wall, 0.15)
	local look: Look = {
		frame = trim,
		shutter = pick(rng, TOWN_SHUTTERS),
		arched = true,
		winW = 2.4,
		winH = 3.8,
		spacing = 7,
	}
	local floor = 0.6
	local depth = 6

	part(m, Vector3.new(w + 1, 2, d + 1), base * CFrame.new(0, -0.4, 0), STONE, M.Limestone)
	part(m, Vector3.new(w + 1, 2, depth), base * CFrame.new(0, -0.4, d / 2 + 0.5 + depth / 2), STONE, M.Limestone)
	part(m, Vector3.new(w, h, d), base * CFrame.new(0, floor + h / 2, 0), wall, M.Plaster)
	part(m, Vector3.new(w + 0.5, 0.5, d + 0.5), base * CFrame.new(0, floor + storyH, 0), trim, M.Plaster)
	part(m, Vector3.new(w + 1, 0.9, d + 1), base * CFrame.new(0, floor + h + 0.45, 0), trim, M.Plaster)
	gableRoof(m, base, w, d, floor + h + 0.9, math.rad(20), pick(rng, ROOF_TILES), wall)
	chimney(m, base * CFrame.new(w / 3, floor + h + 0.9, -d / 4) * CFrame.new(0, d / 4 * math.tan(math.rad(20)), 0))

	-- Loggia: columns along the front carrying a terrace slab
	local columnZ = d / 2 + depth - 0.9
	local columns = 5
	for i = 0, columns - 1 do
		local x = -w / 2 + 1 + (w - 2) * i / (columns - 1)
		local colH = storyH - 0.6
		cylinder(m, base:PointToWorldSpace(Vector3.new(x, floor + colH / 2, columnZ)), colH, 1.5, trim, M.Plaster)
		part(m, Vector3.new(2, 0.6, 2), base * CFrame.new(x, floor + 0.3, columnZ), STONE, M.Limestone)
		part(m, Vector3.new(2, 0.6, 2), base * CFrame.new(x, floor + colH - 0.3, columnZ), trim, M.Plaster)
	end
	local terraceY = floor + storyH + 0.2
	part(
		m,
		Vector3.new(w + 0.6, 0.8, depth + 0.2),
		base * CFrame.new(0, terraceY - 0.4, d / 2 + depth / 2),
		trim,
		M.Plaster
	)
	for x = -w / 2 + 0.6, w / 2 - 0.5, 1.2 do
		cylinder(m, base:PointToWorldSpace(Vector3.new(x, terraceY + 1, d / 2 + depth - 0.4)), 2, 0.6, trim, M.Plaster)
	end
	part(m, Vector3.new(w + 0.6, 0.5, 0.9), base * CFrame.new(0, terraceY + 2.2, d / 2 + depth - 0.4), trim, M.Plaster)
	for side = -1, 1, 2 do
		part(
			m,
			Vector3.new(0.9, 2.4, depth),
			base * CFrame.new(side * (w / 2 - 0.15), terraceY + 1.2, d / 2 + depth / 2),
			trim,
			M.Plaster
		)
	end

	local front = wallFace(base, w, d, 0, floor)
	door(m, front, 4, 7, pick(rng, TOWN_SHUTTERS), trim, true)
	fenestrate(m, base, w, d, rng, look, { floor = floor, storyH = storyH, stories = stories, doorX = 0 })
	for _, x in { -w / 4, w / 4 } do
		Med.pot(m, base:PointToWorldSpace(Vector3.new(x, floor, d / 2 + depth / 2)), rng, "lemon")
		Med.pot(m, base:PointToWorldSpace(Vector3.new(x, terraceY, d / 2 + depth / 2)), rng, "flowers")
	end
	Med.bougainvillea(m, base * CFrame.new(-w / 2 + 1, floor, columnZ + 0.8), rng, storyH)
	for side = -1, 1, 2 do
		Med.cypress(m, base:PointToWorldSpace(Vector3.new(side * (w / 2 + 2), 0, columnZ)), rng, rng:NextNumber(18, 22))
	end
	Props.simplifyHouseCollision(m)
	return m
end

-- Whitewashed chapel with a blue dome, a bell gable over the door and a round window. `size` scales it.
function Med.chapel(parent: Instance, ground: Vector3, facing: number, rng: Random, size: number?): Model
	local k = size or 1
	local m = newModel("Chapel", parent)
	local base = CFrame.new(ground) * CFrame.Angles(0, facing, 0)
	local w, d, h = 13 * k, 16 * k, 10 * k
	local floor = 0.6

	part(m, Vector3.new(w + 3, 2.4, d + 3), base * CFrame.new(0, -0.6, 0), STONE, M.Limestone)
	part(m, Vector3.new(w * 0.5, 0.3, 1.6), base * CFrame.new(0, 0.15, d / 2 + 2.3), STONE, M.Limestone)
	flatBlock(m, base, w, d, floor, h, WHITEWASH)

	local front = wallFace(base, w, d, 0, floor)
	door(m, front, 3.4 * k, 6 * k, AEGEAN, OFFWHITE, true)
	local rose = front * CFrame.new(0, 8.6 * k, 0)
	disc(m, rose * CFrame.new(0, 0, 0.06), 2.4 * k, 0.12, OFFWHITE, M.Plaster)
	disc(m, rose * CFrame.new(0, 0, 0.1), 1.6 * k, 0.2, AEGEAN, M.Glass)
	for _, side in { 1, 3 } do
		for _, z in { -d / 4, d / 4 } do
			local face = wallFace(base, w, d, side, floor + h * 0.5)
			window(m, face * CFrame.new(z, 0, 0), 1.4 * k, 3.4 * k, OFFWHITE, nil, true, rng:NextNumber() < 0.5)
		end
	end

	local roofY = floor + h + 0.4
	dome(m, base:PointToWorldSpace(Vector3.new(0, roofY, -d * 0.1)), 9 * k, 3 * k)

	-- Bell gable standing on the front parapet
	local gable = base * CFrame.new(0, roofY + 1, d / 2 - 0.5)
	for side = -1, 1, 2 do
		part(m, Vector3.new(1.2 * k, 5 * k, 1), gable * CFrame.new(side * 1.9 * k, 2.5 * k, 0), WHITEWASH, M.Plaster)
	end
	part(m, Vector3.new(5 * k, 1.2 * k, 1), gable * CFrame.new(0, 5.6 * k, 0), WHITEWASH, M.Plaster)
	disc(m, gable * CFrame.new(0, 6.2 * k, 0.08), 2.6 * k, 1, WHITEWASH, M.Plaster)
	part(m, Vector3.new(0.3, 1.8 * k, 0.3), gable * CFrame.new(0, 8.2 * k, 0), IRON, M.Metal)
	part(m, Vector3.new(1 * k, 0.3, 0.3), gable * CFrame.new(0, 8.5 * k, 0), IRON, M.Metal)
	part(m, Vector3.new(2.6 * k, 0.3, 0.3), gable * CFrame.new(0, 4.9 * k, 0), IRON, M.Metal)
	ball(m, (gable * CFrame.new(0, 3.9 * k, 0)).Position, 1.8 * k, BRASS, M.Metal)

	for side = -1, 1, 2 do
		Med.pot(m, front:PointToWorldSpace(Vector3.new(side * 3.6 * k, 0, 1.2)), rng, "flowers")
	end
	return m
end

-- Square campanile with a clock face, an open belfry and a small dome.
function Med.bellTower(parent: Instance, ground: Vector3, facing: number, rng: Random): Model
	local m = newModel("BellTower", parent)
	local base = CFrame.new(ground) * CFrame.Angles(0, facing, 0)
	local s, h = 7, 22
	local floor = 0.6
	part(m, Vector3.new(s + 1.2, 2, s + 1.2), base * CFrame.new(0, -0.4, 0), STONE, M.Limestone)
	part(m, Vector3.new(s, h, s), base * CFrame.new(0, floor + h / 2, 0), WHITEWASH, M.Plaster)
	door(m, wallFace(base, s, s, 0, floor), 2.6, 5.4, WOOD_DARK, OFFWHITE, true)
	for side = 0, 3 do
		local face = wallFace(base, s, s, side, floor + h - 4)
		disc(m, face * CFrame.new(0, 0, 0.06), 5, 0.12, OFFWHITE, M.Plaster)
		disc(m, face * CFrame.new(0, 0, 0.12), 4.2, 0.2, rgb(250, 240, 214), M.SmoothPlastic)
		part(m, Vector3.new(0.3, 1.7, 0.2), face * CFrame.new(0, 0.7, 0.3), IRON, M.Metal)
		part(m, Vector3.new(1.3, 0.3, 0.2), face * CFrame.new(0.55, 0, 0.3), IRON, M.Metal)
		if side ~= 0 then
			window(m, wallFace(base, s, s, side, floor + h * 0.45), 1.2, 3, OFFWHITE, nil, true, false)
		end
	end

	local y = floor + h
	part(m, Vector3.new(s + 0.8, 0.6, s + 0.8), base * CFrame.new(0, y + 0.3, 0), OFFWHITE, M.Plaster)
	for _, c in { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } } do
		part(
			m,
			Vector3.new(1.4, 6, 1.4),
			base * CFrame.new(c[1] * (s / 2 - 0.7), y + 3.6, c[2] * (s / 2 - 0.7)),
			WHITEWASH,
			M.Plaster
		)
	end
	part(m, Vector3.new(s - 1, 0.3, 0.3), base * CFrame.new(0, y + 5.8, 0), WOOD_DARK, M.Wood)
	ball(m, base:PointToWorldSpace(Vector3.new(0, y + 4.4, 0)), 2.8, BRASS, M.Metal)
	part(m, Vector3.new(s + 0.8, 0.6, s + 0.8), base * CFrame.new(0, y + 6.9, 0), OFFWHITE, M.Plaster)
	if rng:NextNumber() < 0.5 then
		dome(m, base:PointToWorldSpace(Vector3.new(0, y + 7.2, 0)), 5, 1)
	else
		local corners = {}
		for i, c in { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } } do
			corners[i] = base:PointToWorldSpace(Vector3.new(c[1] * (s / 2 + 0.4), y + 7.2, c[2] * (s / 2 + 0.4)))
		end
		LowPoly.pyramid(corners, base:PointToWorldSpace(Vector3.new(0, y + 12, 0)), TERRACOTTA, m, M.ClayRoofTiles)
	end
	return m
end

-- Greek windmill: a round white tower under a conical thatch cap, with eight triangular canvas sails.
function Med.windmill(parent: Instance, ground: Vector3, facing: number, rng: Random): Model
	local m = newModel("Windmill", parent)
	local base = CFrame.new(ground) * CFrame.Angles(0, facing, 0)
	local r, h = 6.5, 18
	cylinder(m, ground + Vector3.new(0, -1.5, 0), 5, r * 2 + 3, STONE, M.Limestone)
	cylinder(m, ground + Vector3.new(0, 1 + h / 2, 0), h, r * 2, WHITEWASH, M.Plaster)
	local ring = {}
	for i = 1, 10 do
		local a = i / 10 * TAU
		ring[i] = ground + Vector3.new(math.cos(a) * (r + 0.8), 1 + h, math.sin(a) * (r + 0.8))
	end
	LowPoly.pyramid(ring, ground + Vector3.new(0, 1 + h + 6.5, 0), rgb(150, 120, 82), m, M.Wood)

	part(m, Vector3.new(3.8, 7, 0.4), base * CFrame.new(0, 4.5, r - 0.05), OFFWHITE, M.Plaster)
	part(m, Vector3.new(3, 6.4, 0.6), base * CFrame.new(0, 4.2, r), AEGEAN, M.WoodPlanks)
	for _, spot in { { -0.7, 10 }, { 0.8, 14 } } do
		part(
			m,
			Vector3.new(1.4, 2, 0.6),
			base * CFrame.Angles(0, spot[1], 0) * CFrame.new(0, spot[2], r - 0.1),
			AEGEAN,
			M.WoodPlanks
		)
	end

	-- Sails turned to face the sea breeze
	local hub = base * CFrame.new(0, h - 1, r + 2)
	beam(m, base:PointToWorldSpace(Vector3.new(0, h - 1, 0)), hub.Position, 0.9, WOOD_DARK, nil, M.Wood)
	ball(m, hub.Position, 1.8, WOOD_DARK, M.Wood)
	local spin = rng:NextNumber(0, TAU)
	for i = 1, 8 do
		local a = spin + i / 8 * TAU
		local dir = Vector3.new(math.cos(a), math.sin(a), 0)
		local dir2 = Vector3.new(math.cos(a + 0.34), math.sin(a + 0.34), 0)
		beam(m, hub.Position, hub:PointToWorldSpace(dir * 10), 0.35, WOOD, nil, M.Wood)
		LowPoly.triangle(
			hub:PointToWorldSpace(dir * 1.6),
			hub:PointToWorldSpace(dir * 10),
			hub:PointToWorldSpace(dir2 * 8.6),
			hub:PointToWorldSpace(Vector3.new(0, 0, -1)),
			CANVAS,
			m,
			M.Fabric
		)
	end
	return m
end

----------------------------------------------------------------------------------------------------
-- Piazza and garden fittings

-- Keep a pergola's trellis as decoration behind one roof box, and the vines
-- spilling over it with no hitbox at all.
local function simplifyPergola(m: Model)
	if m:GetAttribute("CollisionVersion") == 1 then
		return
	end
	local wood = {}
	for _, piece in m:GetDescendants() do
		if not piece:IsA("BasePart") then
			continue
		end
		if piece.Material == M.Wood then
			table.insert(wood, piece)
		elseif piece.Material == M.LeafyGrass or (piece:IsA("Part") and piece.Shape == Enum.PartType.Ball) then
			piece.CanCollide, piece.CanTouch, piece.CanQuery = false, false, false
		end
	end
	if #wood == 0 then
		return
	end
	local frame = wood[1].CFrame
	local minimum, maximum = boundsIn(frame, wood)
	local hitbox = part(m, maximum - minimum, frame * CFrame.new((minimum + maximum) / 2), WOOD, M.Slate)
	hitbox.Name = "PergolaHitbox"
	hitbox.Transparency = 1
	hitbox.CastShadow = false
	hitbox.CanCollide = true
	hitbox.CanQuery = true
	for _, piece in wood do
		piece.CanCollide, piece.CanTouch, piece.CanQuery = false, false, false
	end
	m:SetAttribute("CollisionVersion", 1)
end

-- Wooden pergola on whitewashed posts, overgrown with vines and the odd bougainvillea.
function Med.pergola(
	parent: Instance,
	ground: Vector3,
	facing: number,
	rng: Random,
	w: number,
	d: number,
	height: number?
): Model
	local m = newModel("Pergola", parent)
	local base = CFrame.new(ground) * CFrame.Angles(0, facing, 0)
	local h = height or 9
	local xs = if w > 12 then { -w / 2, 0, w / 2 } else { -w / 2, w / 2 }
	for _, x in xs do
		for _, z in { -d / 2, d / 2 } do
			part(m, Vector3.new(1.1, h, 1.1), base * CFrame.new(x, h / 2, z), WHITEWASH, M.Plaster)
		end
	end
	for _, z in { -d / 2, d / 2 } do
		part(m, Vector3.new(w + 2, 0.7, 0.7), base * CFrame.new(0, h + 0.35, z), WOOD, M.Wood)
	end
	local rafters = math.max(2, math.floor(w / 2.2))
	for i = 0, rafters do
		part(m, Vector3.new(0.4, 0.4, d + 2), base * CFrame.new(-w / 2 + w * i / rafters, h + 0.9, 0), WOOD, M.Wood)
	end
	for _ = 1, math.max(3, math.floor(w * d / 14)) do
		local p = base
			* CFrame.new(rng:NextNumber(-w / 2, w / 2), h + rng:NextNumber(1, 1.6), rng:NextNumber(-d / 2, d / 2))
		local s = rng:NextNumber(1.8, 3)
		local color = if rng:NextNumber() < 0.25 then pick(rng, BLOOMS) else shade(VINE, rng, 0.1)
		blob(m, p.Position, Vector3.new(s, s * 0.6, s), rng, color, M.LeafyGrass)
		if rng:NextNumber() < 0.15 then
			ball(m, p.Position - Vector3.new(0, 1.1, 0), 0.8, rgb(90, 40, 90), M.SmoothPlastic)
		end
	end
	simplifyPergola(m)
	return m
end

-- Café table with a marble top, chairs and, if given a colour, a striped parasol.
function Med.cafeTable(parent: Instance, ground: Vector3, rng: Random, parasol: Color3?): Model
	local m = newModel("CafeTable", parent)
	cylinder(m, ground + Vector3.new(0, 0.1, 0), 0.2, 1.6, IRON, M.Metal)
	cylinder(m, ground + Vector3.new(0, 1.6, 0), 3, 0.4, IRON, M.Metal)
	cylinder(m, ground + Vector3.new(0, 3.1, 0), 0.2, 3.6, WHITEWASH, M.Marble)
	ball(m, ground + Vector3.new(0.6, 3.5, 0.3), 0.6, rgb(150, 40, 60), M.Glass)
	local chairColor = if rng:NextNumber() < 0.5 then AEGEAN else WOOD
	local spin = rng:NextNumber(0, TAU)
	local chairs = rng:NextInteger(2, 4)
	for i = 1, chairs do
		local a = spin + i / chairs * TAU
		local seatAt = ground + Vector3.new(math.cos(a) * 2.8, 0, math.sin(a) * 2.8)
		local frame = CFrame.lookAt(seatAt, Vector3.new(ground.X, seatAt.Y, ground.Z))
		part(m, Vector3.new(1.6, 0.3, 1.6), frame * CFrame.new(0, 1.9, 0), chairColor, M.Wood)
		part(m, Vector3.new(1.6, 2, 0.25), frame * CFrame.new(0, 3, 0.75), chairColor, M.Wood)
		for side = -1, 1, 2 do
			part(m, Vector3.new(0.2, 1.8, 1.4), frame * CFrame.new(side * 0.65, 0.9, 0), IRON, M.Metal)
		end
	end
	if parasol then
		cylinder(m, ground + Vector3.new(0, 4.6, 0), 9, 0.3, WHITEWASH, M.Metal)
		local apex = ground + Vector3.new(0, 9.3, 0)
		for i = 1, 8 do
			local a0, a1 = i / 8 * TAU, (i + 1) / 8 * TAU
			LowPoly.triangle(
				ground + Vector3.new(math.cos(a0) * 4.6, 7.8, math.sin(a0) * 4.6),
				ground + Vector3.new(math.cos(a1) * 4.6, 7.8, math.sin(a1) * 4.6),
				apex,
				ground + Vector3.new(0, 6, 0),
				if i % 2 == 0 then parasol else CANVAS,
				m,
				M.Fabric
			)
		end
	end
	return m
end

-- Two-tier stone fountain in a round basin, with spray falling from the top bowl.
function Med.fountain(parent: Instance, ground: Vector3): Model
	local m = newModel("Fountain", parent)
	local function at(y: number): Vector3
		return ground + Vector3.new(0, y, 0)
	end
	cylinder(m, at(0.4), 0.8, 26, STONE:Lerp(Color3.new(0, 0, 0), 0.15), M.Limestone)
	cylinder(m, at(1.4), 1.2, 22, STONE, M.Limestone)
	local pool = cylinder(m, at(2.25), 0.4, 21, WATER, M.Glass)
	pool.Transparency = 0.25
	pool.CanCollide = false
	local rim = {}
	for i = 1, 16 do
		local a = i / 16 * TAU
		rim[i] = at(2.7) + Vector3.new(math.cos(a) * 10.6, 0, math.sin(a) * 10.6)
		cylinder(m, rim[i], 1.4, 1.4, STONE, M.Limestone)
	end
	for i = 1, 16 do
		beam(m, rim[i], rim[i % 16 + 1], 1.2, STONE, 1.4, M.Limestone)
	end

	cylinder(m, at(5), 6, 3.2, STONE, M.Limestone)
	cylinder(m, at(8.4), 0.8, 9, STONE, M.Limestone)
	local bowl = cylinder(m, at(8.85), 0.2, 8, WATER, M.Glass)
	bowl.Transparency = 0.25
	cylinder(m, at(10.3), 3, 1.4, STONE, M.Limestone)
	cylinder(m, at(12.1), 0.6, 3.6, STONE, M.Limestone)
	ball(m, at(12.8), 1.2, STONE, M.Limestone)

	local spout = part(m, Vector3.new(1, 1, 1), CFrame.new(at(12.8)), WATER)
	spout.Transparency = 1
	spout.CanCollide = false
	spout.CanQuery = false
	local spray = Instance.new("ParticleEmitter")
	spray.Color = ColorSequence.new(rgb(210, 240, 250))
	spray.Transparency = NumberSequence.new(0.3, 1)
	spray.Size = NumberSequence.new(0.5, 0.2)
	spray.Lifetime = NumberRange.new(0.9, 1.3)
	spray.Rate = 45
	spray.Speed = NumberRange.new(6, 9)
	spray.SpreadAngle = Vector2.new(35, 35)
	spray.Acceleration = Vector3.new(0, -22, 0)
	spray.LightEmission = 0.2
	spray.Parent = spout
	return m
end

-- Square stone planter with an olive or lemon tree.
function Med.planter(parent: Instance, ground: Vector3, rng: Random, tree: string): Model
	local m = newModel("Planter", parent)
	part(m, Vector3.new(7, 2, 7), CFrame.new(ground + Vector3.new(0, 1, 0)), STONE, M.Limestone)
	part(m, Vector3.new(6, 0.3, 6), CFrame.new(ground + Vector3.new(0, 2.05, 0)), DIRT, M.Ground)
	if tree == "olive" then
		Med.olive(m, ground + Vector3.new(0, 2, 0), rng, 0.85)
	else
		Med.pot(m, ground + Vector3.new(0, 2, 0), rng, "lemon")
	end
	return m
end

-- Keep the individual stones as decoration, with one smooth collision box per wall.
local function simplifyStoneWall(wall: Model)
	if wall:GetAttribute("CollisionVersion") == 1 then
		return
	end
	local stones = {}
	local frame: CFrame? = nil
	local minimum = Vector3.new(math.huge, math.huge, math.huge)
	local maximum = -minimum
	for _, stone in wall:GetChildren() do
		if not stone:IsA("BasePart") then
			continue
		end
		frame = frame or stone.CFrame
		table.insert(stones, stone)
		for x = -1, 1, 2 do
			for y = -1, 1, 2 do
				for z = -1, 1, 2 do
					local corner = frame:PointToObjectSpace(
						stone.CFrame:PointToWorldSpace(
							Vector3.new(stone.Size.X * x, stone.Size.Y * y, stone.Size.Z * z) / 2
						)
					)
					minimum = minimum:Min(corner)
					maximum = maximum:Max(corner)
				end
			end
		end
	end
	if not frame then
		return
	end
	local hitbox = part(wall, maximum - minimum, frame * CFrame.new((minimum + maximum) / 2), STONE_WALL, M.Slate)
	hitbox.Name = "WallHitbox"
	hitbox.CanCollide = true
	hitbox.CanQuery = true
	hitbox.Transparency = 1
	hitbox.CastShadow = false
	for _, stone in stones do
		stone.CanCollide = false
		stone.CanTouch = false
		stone.CanQuery = false
	end
	wall:SetAttribute("CollisionVersion", 1)
end

-- Dry-stone wall between two ground points.
function Med.stoneWall(parent: Instance, a: Vector3, b: Vector3, rng: Random): Model
	local m = newModel("StoneWall", parent)
	local length = (b - a).Magnitude
	local n = math.max(1, math.floor(length / 2.6))
	local dir = (b - a).Unit
	for i = 0, n - 1 do
		local p0, p1 = a + dir * (i * length / n), a + dir * ((i + 1) * length / n)
		local h = rng:NextNumber(2, 2.8)
		local lift = Vector3.new(0, h / 2 - 0.3, 0)
		part(
			m,
			Vector3.new(1.6 + (i % 2) * 0.12, h, length / n + 0.05),
			CFrame.lookAt((p0 + p1) / 2 + lift, p1 + lift),
			shade(STONE_WALL, rng, 0.1),
			M.Slate
		)
	end
	simplifyStoneWall(m)
	return m
end

-- The ensure* passes below walk the whole map at startup. `pause` (from Map.prepareStreaming)
-- yields now and then, so together they stay inside the ~10 s script timeout.

-- Upgrade borders already baked into a saved map without rebuilding their stones.
function Med.ensureStoneWalls(root: Instance, pause: (() -> ())?)
	for _, wall in root:GetDescendants() do
		if pause then
			pause()
		end
		if wall:IsA("Model") and wall.Name == "StoneWall" then
			simplifyStoneWall(wall)
		end
	end
end

-- Upgrade pergolas already baked into a saved map: their trellis and vines get
-- the same one roof box and hitbox-free greenery fresh builds get.
function Med.ensurePergolas(root: Instance, pause: (() -> ())?)
	for _, model in root:GetDescendants() do
		if pause then
			pause()
		end
		if model:IsA("Model") and model.Name == "Pergola" then
			simplifyPergola(model)
		end
	end
end

-- Balconies baked before the single-hitbox policy carry every baluster and rail
-- as its own collider. Balcony posts are the only 0.14 x 2.6 x 0.14 ironwork in
-- the builders, so each cluster of them marks a balcony to collapse.
local BALCONY_CELL = 32
function Med.ensureBalconies(root: Instance, pause: (() -> ())?)
	local collidable = {}
	-- Colliders by XZ cell: each balcony looks only at parts near it, not at every part on the map
	-- (balconies x map parts ran past the script timeout once the city was added).
	local cells: { [string]: { BasePart } } = {}
	for _, piece in root:GetDescendants() do
		if pause then
			pause()
		end
		if piece:IsA("BasePart") and piece.CanCollide then
			table.insert(collidable, piece)
			local p = piece.Position
			local key = math.floor(p.X / BALCONY_CELL) .. "," .. math.floor(p.Z / BALCONY_CELL)
			local cell = cells[key]
			if not cell then
				cell = {}
				cells[key] = cell
			end
			table.insert(cell, piece)
		end
	end
	local posts = {}
	for _, piece in collidable do
		local size = piece.Size
		if
			piece.Material == M.Metal
			and math.abs(size.X - 0.14) < 0.01
			and math.abs(size.Y - 2.6) < 0.01
			and math.abs(size.Z - 0.14) < 0.01
		then
			table.insert(posts, piece)
		end
	end
	local taken = {}
	for _, seed in posts do
		if taken[seed] then
			continue
		end
		-- Balusters stand about a stud apart within one balcony; grow the
		-- cluster until no further post joins it.
		local group = { seed }
		taken[seed] = true
		local growing = true
		while growing do
			growing = false
			for _, post in posts do
				if pause then
					pause()
				end
				if taken[post] then
					continue
				end
				for _, member in group do
					if (post.Position - member.Position).Magnitude <= 4 then
						taken[post] = true
						table.insert(group, post)
						growing = true
						break
					end
				end
			end
		end
		if #group < 3 then
			continue
		end
		local frame = group[1].CFrame
		local minimum, maximum = boundsIn(frame, group)
		local pieces = table.clone(group)
		local inGroup = {}
		for _, piece in group do
			inGroup[piece] = true
		end
		-- Every part the test below can accept has its centre within 2.5 studs of the posts'
		-- box in the balcony frame; gather the cells under a generous world circle around it.
		local centreX, centreZ, reach = 0, 0, 0
		for _, post in group do
			centreX += post.Position.X / #group
			centreZ += post.Position.Z / #group
		end
		for _, post in group do
			reach = math.max(reach, math.sqrt((post.Position.X - centreX) ^ 2 + (post.Position.Z - centreZ) ^ 2))
		end
		reach += 6
		local nearby = {}
		for cx = math.floor((centreX - reach) / BALCONY_CELL), math.floor((centreX + reach) / BALCONY_CELL) do
			for cz = math.floor((centreZ - reach) / BALCONY_CELL), math.floor((centreZ + reach) / BALCONY_CELL) do
				for _, piece in cells[cx .. "," .. cz] or {} do
					table.insert(nearby, piece)
				end
			end
		end
		if pause then
			pause()
		end
		-- The balcony's rails hug the posts at their top; its slab tops out at
		-- their feet. The door step below is deliberately left solid.
		for _, piece in nearby do
			if inGroup[piece] then
				continue
			end
			local center = frame:PointToObjectSpace(piece.Position)
			if
				center.X < minimum.X - 2.5
				or center.X > maximum.X + 2.5
				or center.Z < minimum.Z - 2.5
				or center.Z > maximum.Z + 2.5
			then
				continue
			end
			local top = center.Y + piece.Size.Y / 2
			local thin = math.min(piece.Size.X, piece.Size.Y, piece.Size.Z) <= 0.25
			local ironwork = piece.Material == M.Metal
				and thin
				and center.Y >= minimum.Y - 0.6
				and center.Y <= maximum.Y + 0.6
			local slab = math.abs(top - minimum.Y) <= 0.05
			if ironwork or slab then
				inGroup[piece] = true
				table.insert(pieces, piece)
			end
		end
		collapseBalcony(group[1].Parent, pieces, frame)
	end
end

-- Rows of vines on posts and wires over a patch of tilled earth, walled on three sides.
function Med.vineyard(parent: Instance, ground: Vector3, facing: number, rng: Random, w: number, d: number): Model
	local m = newModel("Vineyard", parent)
	local base = CFrame.new(ground) * CFrame.Angles(0, facing, 0)
	part(m, Vector3.new(w, 0.4, d), base * CFrame.new(0, 0.1, 0), DIRT, M.Ground).CastShadow = false
	local rows = math.floor(w / 3.6)
	for i = 1, rows do
		local x = -w / 2 + (i - 0.5) * w / rows
		for _, z in { -d / 2 + 1, d / 2 - 1 } do
			part(m, Vector3.new(0.4, 4, 0.4), base * CFrame.new(x, 2, z), WOOD_DARK, M.Wood)
		end
		part(m, Vector3.new(0.1, 0.1, d - 2), base * CFrame.new(x, 3.6, 0), IRON, M.Metal)
		for z = -d / 2 + 2.5, d / 2 - 2.5, 2.6 do
			blob(
				m,
				(base * CFrame.new(x, 2.6, z)).Position,
				Vector3.new(1.6, 2.2, 2.2),
				rng,
				shade(VINE, rng, 0.1),
				M.LeafyGrass
			)
			if rng:NextNumber() < 0.3 then
				ball(m, (base * CFrame.new(x + 0.9, 1.9, z)).Position, 0.7, rgb(90, 40, 90), M.SmoothPlastic)
			end
		end
	end
	local corners = {
		base:PointToWorldSpace(Vector3.new(-w / 2 - 1, 0, d / 2)),
		base:PointToWorldSpace(Vector3.new(-w / 2 - 1, 0, -d / 2 - 1)),
		base:PointToWorldSpace(Vector3.new(w / 2 + 1, 0, -d / 2 - 1)),
		base:PointToWorldSpace(Vector3.new(w / 2 + 1, 0, d / 2)),
	}
	for c = 1, 3 do
		Med.stoneWall(m, corners[c], corners[c + 1], rng)
	end
	return m
end

-- The floor and side walls form a simple hull for these scenery boats.
local function simplifyBoatCollision(boat: Model)
	if boat:GetAttribute("BoatCollisionVersion") == 1 then
		return
	end
	for _, piece in boat:GetDescendants() do
		if piece:IsA("BasePart") and piece.Name ~= "BoatFloor" and piece.Name ~= "BoatSide" then
			piece.CanCollide, piece.CanTouch, piece.CanQuery = false, false, false
		end
	end
	boat:SetAttribute("BoatCollisionVersion", 1)
end

function Med.ensureBoatCollision(root: Instance, pause: (() -> ())?)
	for _, boat in root:GetDescendants() do
		if pause then
			pause()
		end
		if boat:IsA("Model") and boat.Name == "Boat" and boat:GetAttribute("BoatGeometryVersion") == 2 then
			simplifyBoatCollision(boat)
		end
	end
end

-- Painted wooden fishing boat floating at `position` (the waterline), bow on its local +Z.
function Med.boat(
	parent: Instance,
	position: Vector3,
	facing: number,
	rng: Random,
	color: Color3,
	dimensions: { length: number, width: number, mast: boolean }?
): Model
	local m = newModel("Boat", parent)
	local base = CFrame.new(position) * CFrame.Angles(0, facing, 0)
	local length = if dimensions then dimensions.length else rng:NextNumber(13, 17)
	local width = if dimensions then dimensions.width else rng:NextNumber(4.6, 5.6)
	local mid = length * 0.3
	local top, bottom = 1.4, -0.6

	-- Keep the floor inside the walls and above the waves. The old floor shared
	-- both outside wall faces and sat directly on the terrain water surface.
	local floor = part(m, Vector3.new(width - 0.88, 0.24, mid * 2), base * CFrame.new(0, 0.4, 0), WOOD, M.WoodPlanks)
	floor.Name = "BoatFloor"
	for side = -1, 1, 2 do
		local hull = part(
			m,
			Vector3.new(0.4, top - bottom, mid * 2),
			base * CFrame.new(side * (width / 2 - 0.2), (top + bottom) / 2, 0),
			WHITEWASH,
			M.WoodPlanks
		)
		hull.Name = "BoatSide"
		-- Cap the hull instead of laying paint over a coplanar inner wall.
		local rail = part(
			m,
			Vector3.new(0.5, 0.3, mid * 2),
			base * CFrame.new(side * (width / 2 - 0.2), top + 0.15, 0),
			color,
			M.WoodPlanks
		)
		rail.Name = "BoatRail"
	end
	for _, e in { 1, -1 } do
		local function p(x: number, y: number, z: number): Vector3
			return base:PointToWorldSpace(Vector3.new(x, y, z * e))
		end
		local tl, tr = p(-width / 2, top, mid), p(width / 2, top, mid)
		local bl, br = p(-width / 2, bottom, mid), p(width / 2, bottom, mid)
		local tip = p(0, top + (if e == 1 then 1 else 0.4), length / 2)
		local keel = p(0, bottom, length / 2 - 2)
		local inside = p(0, 0.4, mid + 1)
		-- Thin planking avoids the thick terrain wedges protruding through the
		-- neighboring bow/stern panels. The shared triangle helper retains its
		-- original thickness everywhere else on the map.
		LowPoly.triangle(tl, bl, keel, inside, WHITEWASH, m, M.WoodPlanks, 0.12)
		LowPoly.triangle(tl, keel, tip, inside, color, m, M.WoodPlanks, 0.12)
		LowPoly.triangle(tr, br, keel, inside, WHITEWASH, m, M.WoodPlanks, 0.12)
		LowPoly.triangle(tr, keel, tip, inside, color, m, M.WoodPlanks, 0.12)
		LowPoly.triangle(bl, br, keel, inside, WHITEWASH, m, M.WoodPlanks, 0.12)
		LowPoly.triangle(tl, tr, tip, inside, WOOD, m, M.WoodPlanks, 0.12)
	end
	for _, z in { -mid * 0.5, mid * 0.5 } do
		part(m, Vector3.new(width - 0.8, 0.3, 1.2), base * CFrame.new(0, 0.7, z), WOOD, M.WoodPlanks)
	end
	local mast = if dimensions then dimensions.mast else rng:NextNumber() < 0.5
	if mast then
		cylinder(m, base:PointToWorldSpace(Vector3.new(0, 4.5, mid * 0.5)), 8, 0.4, WOOD_DARK, M.Wood)
	else
		for side = -1, 1, 2 do
			beam(
				m,
				base:PointToWorldSpace(Vector3.new(side * 1, 1.2, -mid)),
				base:PointToWorldSpace(Vector3.new(side * 1.4, 1.2, mid)),
				0.3,
				WOOD,
				nil,
				M.Wood
			)
		end
	end
	m:SetAttribute("BoatGeometryVersion", 2)
	simplifyBoatCollision(m)
	return m
end

-- Upgrade the decorative boats in saved maps too. Their original floor records
-- the exact position, rotation, beam and length, so no scenery is rerolled.
function Med.ensureBoats(root: Instance)
	-- Runs after players are in, over the whole map: yield now and then to stay inside the script timeout
	local resumed = os.clock()
	for _, old in root:GetDescendants() do
		if os.clock() - resumed > 0.05 then
			task.wait()
			resumed = os.clock()
		end
		if not old.Parent or not old:IsA("Model") or old.Name ~= "Boat" or old:GetAttribute("BoatGeometryVersion") == 2 then
			continue
		end
		local floor: BasePart? = nil
		local color: Color3? = nil
		local mast = false
		for _, child in old:GetChildren() do
			if child:IsA("Part") then
				local size = child.Size
				if math.abs(size.Y - 0.4) < 0.001 and size.X >= 4.6 and size.X <= 5.6 then
					floor = child
				elseif math.abs(size.X - 0.5) < 0.001 and math.abs(size.Y - 0.5) < 0.001 then
					color = child.Color
				elseif child.Shape == Enum.PartType.Cylinder and math.abs(size.X - 8) < 0.001 then
					mast = true
				end
			end
		end
		if floor and color then
			local frame = floor.CFrame
			Med.boat(
				old.Parent,
				frame.Position,
				math.atan2(-frame.LookVector.X, -frame.LookVector.Z),
				Random.new(0),
				color,
				{
					length = floor.Size.Z / 0.6,
					width = floor.Size.X,
					mast = mast,
				}
			)
			old:Destroy()
		end
	end
end

return Med
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="235">
          <Properties>
            <string name="Name">MetroStations</string>
            <string name="Source"><![CDATA[-- Walkable termini, including the migration of the old plaza stair and static train.
local Stations = {}
local LowPoly = require(script.Parent.LowPoly)
local CityMetro = require(script.Parent.CityMetro)
local VERSION = 2
local HARBOUR_VERSION = 3
local V, rgb, M = Vector3.new, Color3.fromRGB, Enum.Material
local TILE, TEAL = rgb(234, 223, 197), rgb(35, 88, 81)
local IRON, WHITE = rgb(38, 43, 40), rgb(248, 239, 217)
local STONE, BRASS = rgb(205, 190, 160), rgb(187, 150, 80)
local FLOOR = -28.8

local function part(parent, name, size, frame, color, material, collide)
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame = name, size, frame
	p.Anchored, p.CanTouch, p.CanCollide = true, false, collide ~= false
	p.Color, p.Material = color, material
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	if collide == false then p.CanQuery, p.CastShadow = false, false end
	p.Parent = parent
	return p
end

local function text(board, words, face, color)
	local gui = Instance.new("SurfaceGui")
	gui.Face, gui.SizingMode, gui.PixelsPerStud = face or Enum.NormalId.Back, Enum.SurfaceGuiSizingMode.PixelsPerStud, 35
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
	label.Font, label.TextScaled, label.TextColor3 = Enum.Font.GothamBold, true, color or WHITE
	label.Text, label.Parent = words, gui
	return label
end

local function model(name, stop, version)
	local m = Instance.new("Model")
	m.Name, m.ModelStreamingMode = name, Enum.ModelStreamingMode.PersistentPerPlayer
	m:SetAttribute("LodSkip", true)
	m:SetAttribute("MetroVersion", version or VERSION)
	m:SetAttribute("MetroStopId", stop)
	return m
end

local function marker(m, name, frame)
	local p = part(m, name, V(1, 0.1, 1), frame, TILE, M.Concrete, false)
	p.Transparency = 1
	return p
end

local function controls(m, dock, arrival, destination)
	marker(m, "TrainDock", dock)
	marker(m, "Arrival", arrival)
	local board = marker(m, "Boarding", dock * CFrame.new(-11, 3, -7.8))
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name, prompt.ActionText = "MetroBoardPrompt", "Board for " .. destination
	prompt.ObjectText = "Line 1 · Free · Every minute"
	prompt.KeyboardKeyCode, prompt.GamepadKeyCode = Enum.KeyCode.E, Enum.KeyCode.ButtonX
	prompt.MaxActivationDistance, prompt.RequiresLineOfSight, prompt.HoldDuration = 10, false, 0.3
	prompt.Enabled, prompt.Parent = false, board
end

local function indicator(m, frame, destination, size)
	local board = part(m, "DepartureBoard", size or V(15, 3.6, 0.5), frame, IRON, M.Metal, false)
	board:SetAttribute("MetroDestination", destination)
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local label = text(board, "LINE 1 · " .. destination .. "\nService preparing", face, rgb(255, 192, 87))
		label.Name, label.Font = "Countdown", Enum.Font.Code
	end
	return board
end

-- Split only axis-aligned flat slabs; keep every fragment, material and prop.
local function cutSlab(p, origin, rect)
	if not p:IsA("Part") or p.Shape ~= Enum.PartType.Block then return end
	if (p.CFrame.RightVector - Vector3.xAxis).Magnitude > 0.001 or (p.CFrame.UpVector - Vector3.yAxis).Magnitude > 0.001 then return end
	local c, h = p.Position - origin, p.Size / 2
	if c.Y + h.Y < -6 or c.Y - h.Y > 0.1 then return end
	local x0, x1, z0, z1 = c.X - h.X, c.X + h.X, c.Z - h.Z, c.Z + h.Z
	local ax, bx, az, bz = math.max(x0, rect[1]), math.min(x1, rect[2]), math.max(z0, rect[3]), math.min(z1, rect[4])
	if ax >= bx or az >= bz then return end
	for _, r in { { x0, ax, z0, z1 }, { bx, x1, z0, z1 }, { ax, bx, z0, az }, { ax, bx, bz, z1 } } do
		local w, d = r[2] - r[1], r[4] - r[3]
		if w > 0.01 and d > 0.01 then
			local clone = p:Clone()
			clone.Size = V(w, p.Size.Y, d)
			clone.CFrame = CFrame.new(origin + V((r[1] + r[2]) / 2, c.Y, (r[3] + r[4]) / 2))
			clone.Parent = p.Parent
		end
	end
	p:Destroy()
end

-- Hills use thin triangular wedges rather than slabs. Clip their visible
-- triangle around the open part of the shaft, preserving the surrounding slope.
local function cutWedge(p, origin, rect)
	if not p:IsA("WedgePart") or p.Size.X > 1 or math.abs(p.CFrame.RightVector.Y) < 0.5 then return end
	local h = p.Size / 2
	local x = if p.CFrame.RightVector.Y > 0 then h.X else -h.X
	local polygon = {
		p.CFrame * V(x, -h.Y, -h.Z), p.CFrame * V(x, -h.Y, h.Z), p.CFrame * V(x, h.Y, h.Z),
	}
	local a, b, c = polygon[1] - origin, polygon[2] - origin, polygon[3] - origin
	if math.max(a.X, b.X, c.X) <= rect[1] + 0.001 or math.min(a.X, b.X, c.X) >= rect[2] - 0.001
		or math.max(a.Z, b.Z, c.Z) <= rect[3] + 0.001 or math.min(a.Z, b.Z, c.Z) >= rect[4] - 0.001 then return end
	local pieces = {}
	for _, bound in { { "X", rect[1], 1 }, { "X", rect[2], -1 }, { "Z", rect[3], 1 }, { "Z", rect[4], -1 } } do
		local inside, outside = {}, {}
		for i, a in polygon do
			local b = polygon[i % #polygon + 1]
			local da = (a[bound[1]] - origin[bound[1]] - bound[2]) * bound[3]
			local db = (b[bound[1]] - origin[bound[1]] - bound[2]) * bound[3]
			table.insert(if da >= 0 then inside else outside, a)
			if (da >= 0) ~= (db >= 0) then
				local edge = a:Lerp(b, da / (da - db))
				table.insert(inside, edge); table.insert(outside, edge)
			end
		end
		if #outside >= 3 then table.insert(pieces, outside) end
		polygon = inside
		if #polygon < 3 then return end -- no actual overlap with the opening
	end
	local area = 0
	for i, a in polygon do
		local b = polygon[i % #polygon + 1]
		area += (a.X - origin.X) * (b.Z - origin.Z) - (b.X - origin.X) * (a.Z - origin.Z)
	end
	if math.abs(area) < 0.02 then return end
	for _, poly in pieces do
		for i = 2, #poly - 1 do
			local a, b, c = poly[1], poly[i], poly[i + 1]
			LowPoly.triangle(a, b, c, (a + b + c) / 3 - V(0, 40, 0), p.Color, p.Parent, p.Material, p.Size.X)
		end
	end
	p:Destroy()
end

function Stations.ensureHarbour(island, plaza, frame)
	local existing = island:FindFirstChild("GullhavenMetro")
	-- Ground can be regenerated independently of the saved station.
	local ground = island:FindFirstChild("Ground")
	for _, p in if ground then ground:GetDescendants() else {} do
		cutSlab(p, frame.Position, { 61, 130, -24.6, -11.4 })
		cutWedge(p, frame.Position, { 61, 96.2, -24.6, -11.4 })
	end
	if existing and existing:GetAttribute("MetroVersion") == HARBOUR_VERSION then return existing end
	local restorePlaza = existing and (existing:GetAttribute("MetroVersion") or 1) < 2
	local restored = {}
	if existing then
		-- These fills belong to the old plaza, even when replacing a v2 station.
		for _, p in existing:GetChildren() do
			if string.match(p.Name, "^FormerEntrance") or string.match(p.Name, "^RestoredPlaza") then
				p.Parent = nil
				table.insert(restored, p)
			end
		end
		existing:Destroy()
	end
	local station = model("GullhavenMetro", "Harbour", HARBOUR_VERSION)
	for _, p in restored do p.Parent = station end
	local function box(name, x0, x1, y0, y1, z0, z1, color, material, collide)
		return part(station, name, V(x1 - x0, y1 - y0, z1 - z0), frame * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2), color, material, collide)
	end
	local function bar(name, a, b, width, depth, color)
		return part(station, name, V(width, depth, (b - a).Magnitude), frame * CFrame.lookAt((a + b) / 2, b), color, M.Metal, false)
	end
	local function glow(lamp, range, brightness)
		local light = Instance.new("PointLight")
		light.Range, light.Brightness, light.Color, light.Parent = range, brightness, rgb(255, 226, 183), lamp
	end
	-- Restore the hole left by v1 and its cut plaza inlays, including on baked maps.
	if restorePlaza then
		box("FormerEntranceGround", 19, 31, -4.92, -0.92, -62, -24, rgb(118, 140, 92), M.Grass)
		box("FormerEntrancePaving", 19, 31, -0.72, -0.12, -58, -24, TILE, M.Limestone)
		box("FormerEntranceKerb", 19, 31, -0.68, 0.12, -60, -58, rgb(142, 136, 122), M.Slate)
		box("RestoredPlazaBand", 23.3, 24.7, -0.12, 0, -58, -24, rgb(166, 156, 136), M.Cobblestone, false)
		box("RestoredPlazaCrossBand", 19, 23.3, -0.12, 0, -48.7, -47.3, rgb(166, 156, 136), M.Cobblestone, false)
		box("RestoredPlazaCrossBand", 24.7, 31, -0.12, 0, -48.7, -47.3, rgb(166, 156, 136), M.Cobblestone, false)
	end
	-- East-row plot 8 is reserved by PlazaHouses. The level lane precedes the stair.
	box("EntrancePassage", 61, 80, -0.6, 0, -24.6, -11.4, STONE, M.Limestone)
	for x = 62, 78, 2 do
		box("EntrancePaverJoint", x, x + 0.045, 0.015, 0.035, -23.9, -12.1, rgb(163, 149, 124), M.Concrete, false)
	end
	for _, side in { { -26, -24 }, { -12, -10 } } do
		box("PavilionPlinth", 70, 85, -0.8, 1.2, side[1], side[2], STONE, M.Limestone)
		box("PavilionStucco", 71, 84, 1.2, 8.7, side[1] + 0.2, side[2] - 0.2, rgb(229, 185, 125), M.Plaster)
		box("PavilionCornice", 69.6, 85.4, 8.7, 9.3, side[1] - 0.2, side[2] + 0.2, TILE, M.Limestone)
		for x = 71, 83, 3 do
			box("LimestoneQuoin", x - 0.05, x + 0.6, 1.3, 8.7, side[1] - 0.1, side[2] + 0.1, TILE, M.Limestone, false)
		end
	end
	for _, z in { -22.4, -13.6 } do
		box("LanternBracket", 69.9, 70.3, 4.9, 6.8, z - 0.42, z + 0.42, IRON, M.Metal, false)
		local lamp = box("EntranceLantern", 69.65, 69.9, 5.2, 6.5, z - 0.26, z + 0.26, rgb(238, 209, 160), M.Neon, false)
		glow(lamp, 12, 0.45)
	end
	for _, side in { -1, 1 } do
		part(station, "TerracottaCanopy", V(17.8, 0.65, 8.4), frame * CFrame.new(77.5, 10.1, -18 + side * 4.2) * CFrame.Angles(side * 0.2, 0, 0), rgb(158, 79, 48), M.ClayRoofTiles)
	end
	box("RoofRidge", 68.4, 86.6, 10.8, 11.3, -18.45, -17.55, rgb(126, 60, 38), M.ClayRoofTiles)
	box("EntranceLintel", 69.2, 70, 7.3, 9.2, -24, -12, STONE, M.Limestone)
	local entrance = box("MetroEntranceSign", 68.94, 69.14, 7.55, 8.95, -23.3, -12.7, TEAL, M.Metal, false)
	text(entrance, "GULLHAVEN  ·  METRO ↓", Enum.NormalId.Left)
	-- A compact board sits on the inside wall, clear of the approach and camera.
	indicator(station, frame * CFrame.new(75.5, 5.7, -12.18), "Hafen Mitte", V(7.6, 2, 0.28))
	local service = box("EntranceServiceSign", 71.5, 79.3, 2.5, 3.6, -12.17, -12.04, TEAL, M.Metal, false)
	text(service, "1  ·  FREE SERVICE  ·  EVERY MINUTE", Enum.NormalId.Front)
	for _, side in { { -25.2, -24 }, { -12, -10.8 } } do
		box("StairwellTiles", 80, 130, FLOOR - 1, -0.8, side[1], side[2], TILE, M.CeramicTiles)
		box("StoneParapet", 85.02, 95.8, -0.8, 2.6, side[1], side[2], STONE, M.Limestone)
		box("ParapetCoping", 85.07, 95.75, 2.6, 2.85, side[1] - 0.08, side[2] + 0.08, TILE, M.Limestone, false)
	end
	for _, z in { -23.65, -12.35 } do
		bar("StairHandrail", V(79.7, 3.1, z), V(128.6, FLOOR + 3, z), 0.18, 0.18, BRASS)
		for k = 3, 35, 8 do
			local x, y = 80 + (k - 0.5) * 1.35, -k * 0.8
			local wall = if z < -18 then -24 else -12
			bar("HandrailBracket", V(x, y + 2.8, wall), V(x, y + 2.8, z), 0.12, 0.12, IRON)
			box("StairLightHousing", x - 0.55, x + 0.55, y + 4.6, y + 5.25, math.min(z, wall), math.max(z, wall), IRON, M.Metal, false)
			local lamp = box("StairWallLight", x - 0.4, x + 0.4, y + 4.72, y + 5.1, z - 0.04, z + 0.04, WHITE, M.Neon, false)
			glow(lamp, 11, 0.4)
		end
	end
	for k = 1, 36 do
		local x, y = 80 + (k - 1) * 1.35, -k * 0.8
		box("StairTread", x, x + 1.35, y - 0.9, y, -24, -12, TILE, M.Concrete)
		box("StairNosing", x + 1.17, x + 1.35, y + 0.02, y + 0.07, -23.9, -12.1, TEAL, M.Metal, false)
	end
	-- A lined, sloping soffit hides the underside of the hill and joins the hall roof.
	local a, b = V(96.2, -0.6, -18), V(120.2, FLOOR + 14, -18)
	local slope = math.atan2(b.Y - a.Y, b.X - a.X)
	part(station, "StairTunnelCeiling", V((b - a).Magnitude, 0.6, 13.2), frame * CFrame.new((a + b) / 2 + V(-math.sin(slope), math.cos(slope), 0) * 0.3) * CFrame.Angles(0, 0, slope), TILE, M.Concrete)
	box("StairTunnelRoof", 120.2, 130, FLOOR + 14, FLOOR + 15, -24.6, -11.4, TILE, M.Concrete)
	box("TunnelPortalLintel", 95.8, 96.2, -0.6, 1.5, -25.2, -10.8, STONE, M.Limestone)
	local down = box("StairDirectionSign", 95.55, 95.75, -0.2, 1.1, -22.6, -13.4, TEAL, M.Metal, false)
	text(down, "1  HAFEN MITTE  ↓", Enum.NormalId.Left)
	-- Floor slabs and pavers stop at the last tread instead of sharing its top face.
	box("StationFloor", 128.6, 151.5, FLOOR - 2, FLOOR, -110, 62, rgb(179, 167, 143), M.Concrete)
	for _, run in { { -110, -25.2 }, { -10.8, 62 } } do
		box("StationFloor", 110, 128.6, FLOOR - 2, FLOOR, run[1], run[2], rgb(179, 167, 143), M.Concrete)
		box("StationRoof", 109, 170, FLOOR + 14, FLOOR + 15, run[1], run[2], TILE, M.Concrete)
		box("WestWall", 109, 110, FLOOR, FLOOR + 14, run[1], run[2], TILE, M.CeramicTiles)
		box("TileDado", 110, 110.18, FLOOR + 0.12, FLOOR + 3.2, run[1] + 0.1, run[2] - 0.1, TEAL, M.CeramicTiles, false)
		box("WallSkirting", 110.18, 110.3, FLOOR + 0.12, FLOOR + 0.38, run[1] + 0.1, run[2] - 0.1, IRON, M.Metal, false)
		box("TileFrieze", 110, 110.2, FLOOR + 8.7, FLOOR + 9.3, run[1] + 0.1, run[2] - 0.1, TEAL, M.CeramicTiles, false)
		box("FriezeBorder", 110.2, 110.28, FLOOR + 9.3, FLOOR + 9.42, run[1] + 0.1, run[2] - 0.1, BRASS, M.Metal, false)
	end
	box("StationRoof", 130, 170, FLOOR + 14, FLOOR + 15, -25.2, -10.8, TILE, M.Concrete)
	box("EastWall", 169, 170, FLOOR - 4, FLOOR + 14, -110, 62, TILE, M.CeramicTiles)
	for _, ending in { { -110, -110.4, -110 }, { 61, 62, 62.4 } } do
		box("PlatformEndWall", 110, 151.5, FLOOR, FLOOR + 14, ending[1], ending[1] + 1, TILE, M.CeramicTiles)
		box("TunnelMouth", 151.5, 169, FLOOR - 4, FLOOR + 13.8, ending[2], ending[3], rgb(15, 20, 21), M.SmoothPlastic, false)
	end
	for ix = 0, 9 do
		for iz = 0, 42 do
			local x, z = 110.12 + ix * 4, -108.9 + iz * 4
			local x1, z1 = math.min(x + 3.92, 147.08), math.min(z + 3.92, 60.88)
			local color = if (ix + iz) % 2 == 0 then rgb(196, 184, 161) else rgb(210, 200, 180)
			local function paver(ax, bx, az, bz)
				if bx - ax > 0.01 and bz - az > 0.01 then
					box("TerrazzoPaver", ax, bx, FLOOR + 0.02, FLOOR + 0.1, az, bz, color, M.Limestone, false)
				end
			end
			paver(x, math.min(x1, 128.6), z, math.min(z1, -25.2))
			paver(x, math.min(x1, 128.6), math.max(z, -10.8), z1)
			paver(math.max(x, 128.6), x1, z, z1)
		end
	end
	box("PlatformCoping", 150, 151.5, FLOOR + 0.1, FLOOR + 0.22, -109, 61, STONE, M.Concrete, false)
	box("SafetyLine", 148.8, 149.2, FLOOR + 0.1, FLOOR + 0.2, -109, 61, rgb(229, 188, 63), M.SmoothPlastic, false)
	box("TactilePaving", 147.2, 148.4, FLOOR + 0.1, FLOOR + 0.17, -109, 61, rgb(204, 181, 112), M.Pebble, false)
	box("TrackBed", 151.5, 169, FLOOR - 4, FLOOR - 3.5, -110, 62, rgb(49, 52, 50), M.Slate)
	for z = -108, 60, 6 do
		box("Sleeper", 153, 166, FLOOR - 3.5, FLOOR - 3.1, z, z + 0.6, rgb(80, 68, 53), M.Wood, false)
	end
	for _, x in { 155.2, 160.8 } do
		box("Rail", x, x + 0.28, FLOOR - 3.1, FLOOR - 2.6, -110, 62, rgb(143, 148, 141), M.Metal, false)
	end
	for _, z in { -96, -66, -36, 6, 36, 53 } do
		box("ColumnBase", 137, 139.2, FLOOR, FLOOR + 0.6, z - 1.1, z + 1.1, STONE, M.Limestone)
		box("IronColumn", 137.6, 138.6, FLOOR + 0.6, FLOOR + 13.5, z - 0.5, z + 0.5, TEAL, M.Metal)
		box("ColumnCapital", 136.8, 139.4, FLOOR + 13, FLOOR + 14, z - 1.3, z + 1.3, BRASS, M.Metal, false)
		box("RoofCrossbeam", 110, 169, FLOOR + 13.3, FLOOR + 14, z - 0.4, z + 0.4, TEAL, M.Metal, false)
		box("ColumnCollar", 137.48, 138.72, FLOOR + 3.7, FLOOR + 3.95, z - 0.62, z + 0.62, BRASS, M.Metal, false)
		for _, side in { -1, 1 } do
			bar("ColumnBrace", V(138.1, FLOOR + 11.1, z), V(138.1 + side * 3.4, FLOOR + 13.25, z), 0.2, 0.2, TEAL)
			for _, dz in { -0.72, 0.72 } do
				box("ColumnAnchorBolt", 138.1 + side * 0.78 - 0.09, 138.1 + side * 0.78 + 0.09, FLOOR + 0.6, FLOOR + 0.72, z + dz - 0.09, z + dz + 0.09, IRON, M.Metal, false)
			end
		end
		box("LightHousing", 115.7, 133.3, FLOOR + 13.15, FLOOR + 13.35, z - 0.6, z + 0.6, IRON, M.Metal, false)
		local lamp = box("PlatformLight", 116, 133, FLOOR + 13, FLOOR + 13.2, z - 0.45, z + 0.45, WHITE, M.Neon, false)
		glow(lamp, 30, 0.65)
		box("StationSignFrame", 110.22, 110.44, FLOOR + 5.85, FLOOR + 8.55, z - 7.65, z + 7.65, BRASS, M.Metal, false)
		local name = box("StationName", 110.45, 110.6, FLOOR + 6, FLOOR + 8.4, z - 7.5, z + 7.5, TEAL, M.Metal, false)
		text(name, "GULLHAVEN\n1 · HAFEN MITTE", Enum.NormalId.Right)
	end
	-- Services sit against the wall, leaving the stair landing and edge route open.
	for _, z in { -62, 30 } do
		box("LitterBin", 113, 115.8, FLOOR + 0.12, FLOOR + 3, z - 1.2, z + 1.2, TEAL, M.Metal)
		box("BinLid", 112.9, 115.9, FLOOR + 3, FLOOR + 3.3, z - 1.3, z + 1.3, IRON, M.Metal, false)
		box("BinOpening", 115.81, 115.87, FLOOR + 2.1, FLOOR + 2.7, z - 0.8, z + 0.8, rgb(16, 23, 22), M.SmoothPlastic, false)
		local label = box("BinLabel", 115.81, 115.87, FLOOR + 1, FLOOR + 1.75, z - 0.85, z + 0.85, TEAL, M.Metal, false)
		text(label, "LITTER", Enum.NormalId.Right)
	end
	box("RouteMapFrame", 110.25, 110.52, FLOOR + 3.9, FLOOR + 8.3, -56.5, -49, BRASS, M.Metal, false)
	local route = box("RouteMap", 110.53, 110.66, FLOOR + 4.08, FLOOR + 8.12, -56.3, -49.2, WHITE, M.SmoothPlastic, false)
	text(route, "LINE 1\n● GULLHAVEN\n│\n● HAFEN MITTE\nFree · Every minute", Enum.NormalId.Right, TEAL)
	box("TimetableFrame", 110.25, 110.52, FLOOR + 4, FLOOR + 8.25, -10, -4.8, IRON, M.Metal, false)
	local timetable = box("ServiceTimetable", 110.53, 110.66, FLOOR + 4.15, FLOOR + 8.1, -9.85, -4.95, WHITE, M.SmoothPlastic, false)
	text(timetable, "GULLHAVEN METRO\n1 → HAFEN MITTE\nTrains every minute\nNo ticket needed\nMind the platform edge", Enum.NormalId.Right, TEAL)
	for _, z in { -104, 57 } do
		box("TrackCableDuct", 168.6, 169, FLOOR + 3.6, FLOOR + 4.1, z - 3, z + 3, IRON, M.Metal, false)
	end
	for y = 4.35, 5.15, 0.4 do
		box("TrackConduit", 168.76, 168.92, FLOOR + y, FLOOR + y + 0.12, -109, 61, rgb(106, 107, 94), M.Metal, false)
	end
	for _, z in { -80, -45, 15, 45 } do
		box("BenchSeat", 113, 116, FLOOR + 1.6, FLOOR + 1.8, z - 5, z + 5, IRON, M.Metal)
		for x = 113.04, 115.44, 0.6 do
			box("BenchSeatSlat", x, x + 0.52, FLOOR + 1.82, FLOOR + 2.04, z - 5, z + 5, rgb(118, 81, 53), M.Wood)
		end
		for y = 2.2, 3.6, 0.7 do
			box("BenchBackSlat", 112.75, 113.05, FLOOR + y, FLOOR + y + 0.56, z - 5, z + 5, rgb(118, 81, 53), M.Wood)
		end
		for _, dz in { -4, 4 } do
			box("BenchLeg", 113.2, 115.8, FLOOR, FLOOR + 1.6, z + dz - 0.2, z + dz + 0.2, IRON, M.Metal)
			box("BenchBackSupport", 112.65, 112.9, FLOOR + 1.6, FLOOR + 4.2, z + dz - 0.16, z + dz + 0.16, IRON, M.Metal, false)
			box("BenchArmPost", 115.25, 115.5, FLOOR + 2.04, FLOOR + 3, z + dz - 0.16, z + dz + 0.16, IRON, M.Metal, false)
			box("BenchArmrest", 113.1, 115.8, FLOOR + 3, FLOOR + 3.2, z + dz - 0.2, z + dz + 0.2, BRASS, M.Metal, false)
		end
		box("PosterFrame", 110.22, 110.5, FLOOR + 3, FLOOR + 5.7, z - 2.5, z + 2.5, IRON, M.Metal, false)
		local poster = box("TravelPoster", 110.51, 110.65, FLOOR + 3.15, FLOOR + 5.55, z - 2.35, z + 2.35, rgb(153, 80, 48), M.SmoothPlastic, false)
		text(poster, if z < 0 then "GULLHAVEN\nFRESH FROM THE BAY" else "HAFEN MITTE\nEXPLORE THE CITY", Enum.NormalId.Right)
	end
	for _, z in { -62, 24 } do
		indicator(station, frame * CFrame.new(139, FLOOR + 10, z) * CFrame.Angles(0, -math.pi / 2, 0), "Hafen Mitte")
		for _, dz in { -5.5, 5.5 } do
			box("DepartureBoardHanger", 138.88, 139.12, FLOOR + 11.8, FLOOR + 14, z + dz - 0.12, z + dz + 0.12, IRON, M.Metal, false)
		end
	end
	local exit = box("ExitWayfinding", 130.8, 131.1, FLOOR + 8.5, FLOOR + 10.6, -24, -12, TEAL, M.Metal, false)
	text(exit, "EXIT ↑\nPIAZZA · HARBOUR", Enum.NormalId.Right)
	for _, z in { -22.8, -13.2 } do
		box("ExitSignHanger", 130.86, 131.04, FLOOR + 10.6, FLOOR + 14, z - 0.09, z + 0.09, IRON, M.Metal, false)
	end
	controls(station, frame * CFrame.new(158, FLOOR + 0.22, -24) * CFrame.Angles(0, math.pi / 2, 0), frame * CFrame.new(141, FLOOR + 3.5, -18), "Hafen Mitte")
	station.Parent = island
	station:AddTag("MetroStop")
	return station
end

function Stations.ensureCity(city)
	if not city then return end
	local existing = city:FindFirstChild("CityMetroStop")
	if existing and existing:GetAttribute("MetroVersion") == VERSION then
		CityMetro.ensureSurfaces(existing, V(7000, 0, 7000))
		return existing
	end
	if existing then existing:Destroy() end
	local metro = city:FindFirstChild("HafenMitte", true)
	if not metro then return end
	CityMetro.ensureSurfaces(metro, V(7000, 0, 7000))
	local train = metro:FindFirstChild("MetroTrain")
	if train then train:Destroy() end
	local station = model("CityMetroStop", "City")
	local frame = CFrame.new(7000, -34, 7000)
	for _, name in { "MetroTicketHall", "MetroEscalators", "MetroStairwell", "MetroVault", "MetroPlatforms", "MetroTracks", "MetroBridge" } do
		local room = metro:FindFirstChild(name)
		if room then room:RemoveTag("LodPiece"); room.ModelStreamingMode = Enum.ModelStreamingMode.Default; room.Parent = station end
	end
	for _, p in station:GetDescendants() do
		if p.Name == "TrainIndicator" then
			p.Name = "DepartureBoard"
			p:SetAttribute("MetroDestination", "Gullhaven")
			for _, label in p:GetDescendants() do
				if label:IsA("TextLabel") then label.Name, label.Text = "Countdown", "LINE 1 · GULLHAVEN\nService preparing" end
			end
		end
	end
	controls(station, frame * CFrame.new(-250, 0.15, -91.5), frame * CFrame.new(-280, 3.5, -104), "Gullhaven")
	indicator(station, frame * CFrame.new(-280, 10, -104), "Gullhaven")
	station.Parent = city
	station:AddTag("MetroStop")
	return station
end

return Stations
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="236">
          <Properties>
            <string name="Name">ModernCity</string>
            <string name="Source"><![CDATA[-- A distant port city on its own stretch of mainland. Ships reach it up a long estuary, like
-- Southampton Water: the container terminal lines the west bank of a wide basin, the jetties
-- of the eastern docks face it, the refinery sits back behind the terminal, and the dense city fills
-- the peninsula behind the quays with its underground station under the forecourt. Hills rise
-- behind it all along the south and east edges (see CityHills), with a Grand Prix circuit cut
-- into the foot of the south range (see CityCircuit).
-- Coordinates follow the north-up sea chart (north is -Z), relative to CENTER.
local HttpService = game:GetService("HttpService")
local CityBuildings = require(script.Parent.CityBuildings)
local CityHills = require(script.Parent.CityHills)
local CityLand = require(script.Parent.CityLand)
local CityLandmark = require(script.Parent.CityLandmark)
local CityMetro = require(script.Parent.CityMetro)
local CityPort = require(script.Parent.CityPort)
local CityRefinery = require(script.Parent.CityRefinery)
local CityStation = require(script.Parent.CityStation)
local Lod = require(script.Parent.Lod)
local Props = require(script.Parent.Props)

local City = {}
City.VERSION = 10
local CENTER = Vector3.new(7000, 0, 7000)
local TOP = 8 -- walkable land height
local CURB = TOP + 0.9 -- pavement and building floor height
local rgb = Color3.fromRGB
local M = Enum.Material

City.COAST = {
	{ -1200, 1180 },
	{ -1380, 900 },
	{ -1520, 620 },
	{ -1460, 300 },
	{ -1600, -20 },
	{ -1560, -380 },
	{ -1460, -700 },
	{ -1540, -1000 },
	{ -1420, -1330 },
	{ -1300, -1620 }, -- western headland
	{ -1170, -1590 }, -- estuary mouth, west side
	{ -1060, -1400 },
	{ -940, -1200 },
	{ -820, -1020 },
	{ -720, -985 },
}
-- Container terminal, head of the estuary and the slips of the eastern docks
for _, point in CityPort.quays() do
	table.insert(City.COAST, point)
end
-- The east bank runs north from the docks, round the cruise branch and out to the mouth
table.insert(City.COAST, { -236, CityPort.DOCKS.z0 }) -- the north wall of the eastern docks meets the natural bank
for _, point in CityPort.cruiseQuays() do
	table.insert(City.COAST, point)
end
for _, point in {
	{ -560, -1370 },
	{ -700, -1560 }, -- estuary mouth, east side
	{ -560, -1640 },
	{ -380, -1600 },
	{ -150, -1470 },
	{ 120, -1420 },
	{ 380, -1300 },
	{ 650, -1250 },
	{ 900, -1150 },
	{ 1180, -1120, "edge" }, -- the chart's eastern edge, where the hills begin
	{ 1180, 1180, "edge" }, -- and its southern edge
} do
	table.insert(City.COAST, point)
end

-- Street centrelines and widths. Blocks fill the gaps between them; avenues are wider.
local STREETS_X = {
	{ -390, 16 }, { -300, 16 }, { -205, 16 }, { -105, 20 }, { -25, 16 }, { 60, 16 }, { 150, 26 },
	{ 235, 16 }, { 320, 16 }, { 410, 26 }, { 500, 16 }, { 590, 16 }, { 680, 16 }, { 775, 22 },
	{ 865, 16 }, { 955, 16 }, { 1050, 20 },
}
local STREETS_Z = {
	{ -870, 20 }, { -780, 16 }, { -690, 20 }, { -600, 16 }, { -510, 16 }, { -415, 26 }, { -325, 16 }, { -235, 16 }, { -130, 26 },
	{ -50, 16 }, { 40, 16 }, { 130, 26 }, { 220, 16 }, { 310, 16 }, { 400, 22 }, { 490, 16 }, { 580, 16 }, { 670, 20 },
}
local DOWNTOWN = Vector2.new(250, -80)
local STATION = { x0 = -390, x1 = -105, z0 = -130, z1 = 40 }
local CIVIC = { x0 = 235, x1 = 410, z0 = -325, z1 = -130 }
local CAR_COLORS = {
	rgb(120, 34, 30), rgb(40, 46, 58), rgb(176, 176, 170), rgb(64, 70, 66), rgb(30, 30, 32),
	rgb(90, 104, 120), rgb(150, 132, 96), rgb(200, 200, 196),
}
local LEAVES = { rgb(78, 102, 62), rgb(92, 112, 70), rgb(70, 92, 60), rgb(104, 118, 74), rgb(84, 96, 58) }
local FIELDS = { rgb(150, 140, 86), rgb(110, 126, 72), rgb(122, 104, 78), rgb(132, 146, 88), rgb(96, 112, 66) }

-- How far the built-up area reaches from downtown in a given direction, so the city
-- frays out into an irregular edge instead of filling a rectangle.
local function urbanReach(cx: number, cz: number): number
	local angle = math.atan2(cz - DOWNTOWN.Y, cx - DOWNTOWN.X)
	return 560 + 170 * math.sin(angle * 3 + 0.8) + 90 * math.sin(angle * 5 - 1.1)
end

-- Deterministic noise in [0, 1)
local function hash(a: number, b: number, salt: number): number
	local v = math.sin(a * 12.9898 + b * 78.233 + salt * 37.719) * 43758.5453
	return v - math.floor(v)
end

local function part(parent: Instance, name: string, size: Vector3, offset: Vector3, color: Color3, material: Enum.Material, collidable: boolean?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Position = CENTER + offset
	p.Anchored = true
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = collidable ~= false
	if collidable == false then
		p.CanQuery = false
		p.CastShadow = false
	end
	p.Parent = parent
	return p
end

-- A model that streams in as one piece (see server/Map/Lod)
local function pieceModel(parent: Instance, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m:AddTag("LodPiece")
	m.Parent = parent
	return m
end

local function tree(parent: Instance, x: number, z: number, scale: number, seed: number)
	local trunk = 8 + scale * 6
	part(parent, "TreeTrunk", Vector3.new(1.6 + scale, trunk, 1.6 + scale), Vector3.new(x, TOP + trunk / 2, z), rgb(88, 70, 54), M.Wood)
	local crown = part(parent, "TreeCrown", Vector3.one * (11 + scale * 9), Vector3.new(x, TOP + trunk + 3 + scale * 2, z), LEAVES[seed % #LEAVES + 1], M.Grass, false)
	crown.Shape = Enum.PartType.Ball
end

local function car(parent: Instance, x: number, z: number, alongX: boolean, seed: number)
	local body = if alongX then Vector3.new(13, 2.8, 6) else Vector3.new(6, 2.8, 13)
	local cabin = if alongX then Vector3.new(7, 2.2, 5.4) else Vector3.new(5.4, 2.2, 7)
	part(parent, "ParkedCar", body, Vector3.new(x, TOP + 2.0, z), CAR_COLORS[seed % #CAR_COLORS + 1], M.SmoothPlastic)
	part(parent, "CarCabin", cabin, Vector3.new(x, TOP + 4.5, z), rgb(38, 44, 50), M.Glass, false)
end

-- Street lamps light the pavement and the facades around them after dark. The client
-- (CityNightLights) switches the NightGlow head and NightLight lamp on once it is dark enough.
local LAMP_GLOW = rgb(255, 212, 150)
local function lamp(parent: Instance, x: number, z: number)
	part(parent, "StreetLampPole", Vector3.new(0.6, 15, 0.6), Vector3.new(x, CURB + 7.5, z), rgb(52, 56, 56), M.Metal)
	local head = part(parent, "StreetLampHead", Vector3.new(2.6, 0.7, 2.6), Vector3.new(x, CURB + 15, z), rgb(214, 200, 150), M.SmoothPlastic, false)
	head:AddTag("NightGlow")
	head:SetAttribute("GlowColor", LAMP_GLOW)
	head:SetAttribute("GlowAt", 0.25)
	local light = Instance.new("PointLight")
	light.Color = LAMP_GLOW
	light.Range = 44
	light.Brightness = 1.8
	light.Shadows = false
	light:AddTag("NightLight")
	light:SetAttribute("GlowAt", 0.25)
	light.Parent = head
end

---------------------------------------------------------------------------------------------------
-- The district: an irregular grid that thins out into low-rise and then countryside

local function blockKind(i: number, j: number, cx: number, cz: number, w: number, d: number, coast): string?
	if cx > STATION.x0 and cx < STATION.x1 and cz > STATION.z0 and cz < STATION.z1 then
		return "station"
	end
	if cx > CIVIC.x0 and cx < CIVIC.x1 and cz > CIVIC.z0 and cz < CIVIC.z1 then
		return "civic"
	end
	-- West of the quay road, the land north of the harbour road is water and docks, and the
	-- eastern docks reach as far as the street behind their back apron
	if cz < -130 and (cx < -105 or (cx < CityPort.DOCKS.x1 and cz > CityPort.DOCKS.z0)) then
		return nil
	end
	if not CityLand.fits(coast, cx, cz, w, d, 14) then
		return nil
	end
	local distance = (Vector2.new(cx, cz) - DOWNTOWN).Magnitude
	local noise = hash(i, j, 1)
	if distance < 235 then
		return "tower"
	end
	local reach = urbanReach(cx, cz)
	local kind
	if cx < 150 and cz < -235 and cz > -700 then
		kind = "old"
	elseif distance < reach * 0.7 then
		kind = "mid"
	elseif distance < reach * (0.88 + noise * 0.3) then
		kind = "low"
	end
	if kind and noise < 0.07 then
		return "park"
	elseif kind and noise < 0.14 then
		return "parking"
	end
	return kind
end

local function fillBlock(block: Model, kind: string, cx: number, cz: number, bw: number, bd: number, seed: number)
	local lotW, lotD = bw - 8, bd - 8
	local distance = (Vector2.new(cx, cz) - DOWNTOWN).Magnitude
	if kind == "tower" then
		local width = math.min(lotW, 44 + seed % 4 * 3)
		local depth = math.min(lotD, 44 + seed % 3 * 4)
		local height = 96 + (1 - distance / 235) * 70 + hash(cx, cz, 3) * 46
		local facing = if seed % 2 == 0 then 0 else math.pi
		CityBuildings.build(block, CFrame.new(CENTER + Vector3.new(cx, CURB, cz)) * CFrame.Angles(0, facing, 0), width, depth, height, seed % 40 + 1)
		return
	elseif kind == "park" then
		part(block, "PocketPark", Vector3.new(lotW, 0.3, lotD), Vector3.new(cx, CURB + 0.05, cz), rgb(96, 114, 74), M.Grass, false)
		part(block, "ParkPath", Vector3.new(lotW, 0.4, 5), Vector3.new(cx, CURB + 0.1, cz), rgb(150, 144, 130), M.Concrete, false)
		for k = 0, 3 do
			tree(block, cx + (k % 2 - 0.5) * lotW * 0.6, cz + (k // 2 - 0.5) * lotD * 0.55, 0.6 + hash(seed, k, 5) * 0.5, seed + k)
		end
		return
	elseif kind == "parking" then
		part(block, "CarPark", Vector3.new(lotW, 0.3, lotD), Vector3.new(cx, CURB + 0.05, cz), rgb(70, 72, 72), M.Asphalt, false)
		for k = 0, 9 do
			if hash(seed, k, 7) < 0.7 then
				local x = cx - lotW / 2 + 6 + (k % 5) * (lotW - 12) / 4
				car(block, x, cz + (k // 5 - 0.5) * lotD * 0.5, false, seed + k)
			end
		end
		return
	elseif kind == "old" and seed % 5 < 2 then
		local facing = if seed % 2 == 0 then 0 else math.pi
		CityBuildings.warehouse(block, CFrame.new(CENTER + Vector3.new(cx, CURB, cz)) * CFrame.Angles(0, facing, 0), lotW, lotD * 0.86, 18 + seed % 3 * 4, seed)
		return
	end

	-- Two rows of street-facing buildings back onto a narrow service yard
	local columns = if kind == "low" then 2 else 2 + seed % 2
	local yard = if kind == "low" then 8 else 3
	for row, side in { -1, 1 } do
		for c = 1, columns do
			local variant = seed * 7 + row * 3 + c
			if kind == "low" and hash(seed, row * 5 + c, 9) < 0.25 then
				continue
			end
			local width = lotW / columns
			local x = cx - lotW / 2 + (c - 0.5) * width
			local inset = (variant % 3) * 0.8
			local depth = (lotD - yard) / 2 - inset
			local z = cz + side * (lotD / 2 - inset - depth / 2)
			local floors
			if kind == "mid" then
				floors = math.clamp(4 + math.floor((420 - distance) / 60) + variant % 3, 4, 9)
			elseif kind == "old" then
				floors = 4 + variant % 3
			else
				floors = 2 + variant % 3
			end
			local facing = if side < 0 then math.pi else 0
			CityBuildings.block(block, CFrame.new(CENTER + Vector3.new(x, CURB, z)) * CFrame.Angles(0, facing, 0), width - 0.3, depth, floors, variant)
		end
	end
	if kind ~= "mid" then
		part(block, "Dumpster", Vector3.new(4, 4, 7), Vector3.new(cx + (seed % 3 - 1) * lotW * 0.3, CURB + 2, cz), rgb(52, 74, 56), M.Metal)
	end
end

local function buildDistrict(ground: Instance, coast): { { number } }
	local kinds: { [number]: { [number]: string } } = {}
	local blocks = {}
	for i = 1, #STREETS_X - 1 do
		kinds[i] = {}
		for j = 1, #STREETS_Z - 1 do
			local x0 = STREETS_X[i][1] + STREETS_X[i][2] / 2
			local x1 = STREETS_X[i + 1][1] - STREETS_X[i + 1][2] / 2
			local z0 = STREETS_Z[j][1] + STREETS_Z[j][2] / 2
			local z1 = STREETS_Z[j + 1][1] - STREETS_Z[j + 1][2] / 2
			local cx, cz, w, d = (x0 + x1) / 2, (z0 + z1) / 2, x1 - x0, z1 - z0
			local kind = blockKind(i, j, cx, cz, w, d, coast)
			if kind then
				kinds[i][j] = kind
				table.insert(blocks, { i = i, j = j, kind = kind, cx = cx, cz = cz, w = w, d = d })
			end
		end
	end
	local function kindAt(i: number, j: number): string?
		return kinds[i] and kinds[i][j]
	end
	-- A street runs between two cells unless both belong to the same merged plaza
	local function between(a: string?, b: string?): boolean
		if not a and not b then
			return false
		end
		return not (a == b and (a == "civic" or a == "station"))
	end

	local streets = Instance.new("Model")
	streets.Name = "Streets"
	streets.Parent = ground
	local asphalt, line = rgb(58, 60, 60), rgb(196, 192, 170)
	-- Streets along X lines take every intersection they reach, so the cross streets stop short
	local covered: { [string]: boolean } = {}
	for i, street in STREETS_X do
		local x, width = street[1], street[2]
		local active = {}
		for j = 1, #STREETS_Z - 1 do
			active[j] = between(kindAt(i - 1, j), kindAt(i, j))
		end
		local runStart: number? = nil
		for j = 1, #STREETS_Z do
			local on = active[j] == true
			local reaches = on or active[j - 1] == true
			if reaches then
				covered[i .. "," .. j] = true
				runStart = runStart or j
			end
			if runStart and (not on or j == #STREETS_Z) then
				local z0 = STREETS_Z[runStart][1] - STREETS_Z[runStart][2] / 2
				local z1 = STREETS_Z[j][1] + STREETS_Z[j][2] / 2
				part(streets, "Street", Vector3.new(width, 0.5, z1 - z0), Vector3.new(x, TOP + 0.25, (z0 + z1) / 2), asphalt, M.Asphalt)
				if width >= 22 then
					part(streets, "CentreLine", Vector3.new(0.8, 0.06, z1 - z0 - 4), Vector3.new(x, TOP + 0.53, (z0 + z1) / 2), line, M.SmoothPlastic, false)
				end
				runStart = nil
			end
		end
	end
	for j, street in STREETS_Z do
		local z, width = street[1], street[2]
		-- Alternate intersections and the stretches between them, west to east
		local pieces = {}
		for i = 1, #STREETS_X do
			local x = STREETS_X[i][1]
			local half = STREETS_X[i][2] / 2
			local before = i > 1 and between(kindAt(i - 1, j - 1), kindAt(i - 1, j))
			local after = i < #STREETS_X and between(kindAt(i, j - 1), kindAt(i, j))
			table.insert(pieces, { x - half, x + half, (before or after) and not covered[i .. "," .. j] })
			if i < #STREETS_X then
				table.insert(pieces, { x + half, STREETS_X[i + 1][1] - STREETS_X[i + 1][2] / 2, after })
			end
		end
		local runStart: number? = nil
		for k = 1, #pieces + 1 do
			local on = pieces[k] and pieces[k][3]
			if on and not runStart then
				runStart = pieces[k][1]
			elseif not on and runStart then
				local runEnd = pieces[k - 1][2]
				part(streets, "Street", Vector3.new(runEnd - runStart, 0.5, width), Vector3.new((runStart + runEnd) / 2, TOP + 0.25, z), asphalt, M.Asphalt)
				if width >= 22 then
					part(streets, "CentreLine", Vector3.new(runEnd - runStart - 4, 0.06, 0.8), Vector3.new((runStart + runEnd) / 2, TOP + 0.55, z), line, M.SmoothPlastic, false)
				end
				runStart = nil
			end
		end
	end
	-- Zebra crossings where avenues meet
	for i, sx in STREETS_X do
		for j, sz in STREETS_Z do
			if sx[2] >= 22 and sz[2] >= 22 and covered[i .. "," .. j] then
				for _, side in { -1, 1 } do
					for stripe = -2, 2 do
						part(streets, "Crosswalk", Vector3.new(2.2, 0.08, 6), Vector3.new(sx[1] + stripe * 4.4, TOP + 0.56, sz[1] + side * (sz[2] / 2 + 3.5)), line, M.SmoothPlastic, false)
					end
				end
			end
		end
	end
	task.wait()

	for index, b in blocks do
		local block = pieceModel(ground, "CityBlock")
		local seed = b.i * 31 + b.j * 17
		if b.kind == "station" or b.kind == "civic" then
			-- Plazas are paved once, as a whole, below
		else
			local shade = 0.85 + hash(b.i, b.j, 2) * 0.2
			part(block, "Pavement", Vector3.new(b.w, 0.9, b.d), Vector3.new(b.cx, TOP + 0.45, b.cz), Color3.new(0.6 * shade, 0.59 * shade, 0.56 * shade), M.Concrete)
			fillBlock(block, b.kind, b.cx, b.cz, b.w, b.d, seed)
			-- Opposite corners stagger the lamps down both sides of every street; downtown
			-- blocks take all four corners.
			local x0, x1 = b.cx - b.w / 2 + 1.5, b.cx + b.w / 2 - 1.5
			local z0, z1 = b.cz - b.d / 2 + 1.5, b.cz + b.d / 2 - 1.5
			lamp(block, x0, z0)
			lamp(block, x1, z1)
			if b.kind == "tower" or b.kind == "mid" then
				lamp(block, x1, z0)
				lamp(block, x0, z1)
			end
			-- Cars parked along the kerb on the block's south side
			for k = 0, 3 do
				if hash(seed, k, 11) < 0.55 then
					car(block, b.cx - b.w / 2 + 9 + k * (b.w - 18) / 3, b.cz + b.d / 2 + 4, true, seed + k)
				end
			end
			if b.kind == "mid" and seed % 3 == 0 then
				for k = -1, 1 do
					tree(block, b.cx + k * b.w * 0.3, b.cz - b.d / 2 + 2, 0.45, seed + k)
				end
			end
		end
		if index % 12 == 0 then
			task.wait()
		end
	end

	-- The station forecourt faces the head of the estuary and the marina, with the
	-- underground station below it
	local sx0, sx1 = STATION.x0 + STREETS_X[1][2] / 2, STATION.x1 - STREETS_X[4][2] / 2
	local sz0, sz1 = STATION.z0 + 13, STATION.z1 - 8
	CityMetro.build(ground, CENTER, TOP, { sx0, sx1, sz0, sz1 })
	local plaza = pieceModel(ground, "StationPlaza")
	local station = CityStation.build(plaza, CFrame.new(CENTER + Vector3.new(-250, CURB, -62)))
	station:SetAttribute("LodColor", rgb(140, 100, 84))

	local civic = pieceModel(ground, "CivicSquare")
	local cx0, cx1 = CIVIC.x0 + 8, CIVIC.x1 - 13
	local cz0, cz1 = CIVIC.z0 + 8, CIVIC.z1 - 13
	part(civic, "SquarePaving", Vector3.new(cx1 - cx0, 0.9, cz1 - cz0), Vector3.new((cx0 + cx1) / 2, TOP + 0.45, (cz0 + cz1) / 2), rgb(164, 156, 142), M.Concrete)
	local hall = CityLandmark.build(civic, CFrame.new(CENTER + Vector3.new((cx0 + cx1) / 2, CURB, -262)))
	hall:SetAttribute("LodColor", rgb(150, 110, 92))
	for _, dx in { -60, 60 } do
		for _, dz in { -185, -165 } do
			tree(civic, (cx0 + cx1) / 2 + dx, dz, 0.7, dx + dz)
		end
	end
	-- Lamps ring the square
	for k = 0, 4 do
		local x = cx0 + 3 + k * (cx1 - cx0 - 6) / 4
		lamp(civic, x, cz0 + 3)
		lamp(civic, x, cz1 - 3)
	end
	for k = 1, 3 do
		local z = cz0 + 3 + k * (cz1 - cz0 - 6) / 4
		lamp(civic, cx0 + 3, z)
		lamp(civic, cx1 - 3, z)
	end

	-- Woods may grow wherever the grid left a cell empty
	local occupied = {}
	for _, b in blocks do
		table.insert(occupied, { b.cx - b.w / 2 - 10, b.cx + b.w / 2 + 10, b.cz - b.d / 2 - 10, b.cz + b.d / 2 + 10 })
	end
	return occupied
end

---------------------------------------------------------------------------------------------------
-- Suburbs, farmland and woods around the city

local function inside(rects: { { number } }, x: number, z: number, margin: number): boolean
	for _, r in rects do
		if x > r[1] - margin and x < r[2] + margin and z > r[3] - margin and z < r[4] + margin then
			return true
		end
	end
	return false
end

local function suburbs(ground: Instance, coast, reserved: { { number } })
	local roads = Instance.new("Model")
	roads.Name = "SuburbRoads"
	roads.Parent = ground
	local x0, x1 = -380, 1120
	for row, z in { 760, 880, 1000, 1110 } do
		part(roads, "SuburbRoad", Vector3.new(x1 - x0, 0.5, 14), Vector3.new((x0 + x1) / 2, TOP + 0.25, z), rgb(66, 68, 66), M.Asphalt)
		local street: Model
		for x = x0 + 14, x1 - 14, 26 do
			-- A few houses at a time, so each streaming piece stays small and local
			if (x - x0 - 14) % 156 == 0 then
				street = pieceModel(ground, "SuburbStreet")
			end
			for _, side in { -1, 1 } do
				local seed = math.floor(x) * 3 + row * 101 + side
				local hz = z + side * 19
				if hash(x, hz, 13) < 0.3 or not CityLand.fits(coast, x, hz, 14, 14, 12) then
					continue
				end
				local wall = ({ rgb(178, 160, 136), rgb(150, 100, 82), rgb(196, 188, 170), rgb(128, 90, 76), rgb(170, 170, 160) })[seed % 5 + 1]
				local roof = ({ rgb(78, 60, 54), rgb(62, 64, 66), rgb(96, 70, 58) })[seed % 3 + 1]
				local frame = CFrame.new(CENTER + Vector3.new(x, TOP + 5, hz))
				part(street, "House", Vector3.new(14, 10, 11), Vector3.new(x, TOP + 5, hz), wall, if seed % 2 == 0 then M.Brick else M.Concrete)
				for _, slope in { -1, 1 } do
					local tile = part(street, "HouseRoof", Vector3.new(15, 0.8, 7.6), Vector3.zero, roof, M.Slate)
					tile.CFrame = frame * CFrame.new(0, 7.2, slope * 3) * CFrame.Angles(slope * 0.62, 0, 0)
				end
				if seed % 4 == 0 then
					car(street, x + 10, hz - side * 1, false, seed)
				end
			end
		end
		task.wait()
	end
	-- Lanes tie the estates back into the city grid
	for _, x in { -205, 150, 410, 775 } do
		-- Slightly lower than the streets it meets, so the overlaps never flicker
		part(roads, "SuburbLane", Vector3.new(14, 0.4, 1110 - 600), Vector3.new(x, TOP + 0.2, (1110 + 600) / 2), rgb(66, 68, 66), M.Asphalt)
		table.insert(reserved, { x - 8, x + 8, 600, 1110 })
	end
	table.insert(reserved, { x0, x1, 740, 1180 })
end

local function countryside(ground: Instance, coast, reserved: { { number } })
	-- Farmland on the western shore, behind the container terminal
	local fields = {}
	for gx = -1400, -560, 170 do
		for gz = -60, 1080, 150 do
			local w, d = 130 + hash(gx, gz, 15) * 30, 110 + hash(gz, gx, 16) * 30
			if hash(gx, gz, 17) < 0.7 and CityLand.fits(coast, gx, gz, w, d, 20) and not inside(reserved, gx, gz, 90) then
				part(ground, "Field", Vector3.new(w, 0.3, d), Vector3.new(gx, TOP + 0.15, gz), FIELDS[math.floor(hash(gx, gz, 18) * #FIELDS) + 1], M.Grass, false)
				table.insert(fields, { gx - w / 2, gx + w / 2, gz - d / 2, gz + d / 2 })
			end
		end
	end
	part(ground, "CountryRoad", Vector3.new(26, 0.5, 1290), Vector3.new(-640, TOP + 0.25, 515), rgb(66, 68, 66), M.Asphalt)
	local roadWest = CityRefinery.GATE_X - 9
	part(ground, "HarbourRoad", Vector3.new(STREETS_X[1][1] - 8 - roadWest, 0.5, 26), Vector3.new((STREETS_X[1][1] - 8 + roadWest) / 2, TOP + 0.25, -130), rgb(58, 60, 60), M.Asphalt)
	table.insert(reserved, { -653, -627, -130, 1160 })
	table.insert(reserved, { roadWest, -380, -143, -117 })

	-- Woods gather in patches rather than an even scatter
	local count = 0
	for gx = -1600, 1180, 46 do
		for gz = -1790, 1180, 46 do
			local x = gx + (hash(gx, gz, 19) - 0.5) * 30
			local z = gz + (hash(gz, gx, 20) - 0.5) * 30
			local forest = math.sin(x * 0.0045 + 1.3) * math.cos(z * 0.0052 - 0.7) + 0.5 * math.sin(x * 0.011 + z * 0.009)
			if forest > 0.35 and CityLand.inside(coast, x, z) and not inside(reserved, x, z, 12) and not inside(fields, x, z, 6) then
				if CityLand.edgeDistance(coast, x, z) > 22 then
					count += 1
					tree(ground, x, z, 0.6 + hash(x, z, 21) * 0.9, count)
				end
			end
		end
		task.wait()
	end
	Props.lighthouse(ground, CENTER + Vector3.new(-580, TOP, -1580))
end

function City.build(root: Instance): Model
	local existing = root:FindFirstChild("Modern City")
	if existing and existing:IsA("Model") and existing:GetAttribute("CityVersion") == City.VERSION then
		return existing
	end
	local city = Instance.new("Model")
	city.Name = "Modern City"
	city:SetAttribute("CityVersion", City.VERSION)
	-- The city streams and draws its distant shell like an island (see server/Map/Lod)
	city:SetAttribute("LodRoot", true)
	city:SetAttribute("LodStamp", "city" .. City.VERSION)
	if existing then
		city:SetAttribute("LodId", existing:GetAttribute("LodId"))
	end
	local chart = {}
	for _, point in City.COAST do
		table.insert(chart, { CENTER.X + point[1], CENTER.Z + point[2] })
	end
	city:SetAttribute("ChartCoast", HttpService:JSONEncode(chart))

	-- Everything you can see goes under Ground, so the client only drops the distant shell
	-- once most of the real city has arrived.
	local ground = Instance.new("Model")
	ground.Name = "Ground"
	ground.Parent = city
	local coast = CityLand.roughen(City.COAST, 110, 22)
	CityLand.fill(ground, coast, CENTER, TOP, -30, rgb(100, 112, 80), M.Grass, { CityMetro.HOLE })
	CityLand.shore(ground, coast, CENTER, TOP)
	task.wait()

	local reserved = buildDistrict(ground, coast)
	for _, rect in CityPort.build(ground, CENTER, TOP) do
		table.insert(reserved, rect)
	end
	for _, rect in CityRefinery.build(ground, CENTER, TOP) do
		table.insert(reserved, rect)
	end
	task.wait()
	suburbs(ground, coast, reserved)
	countryside(ground, coast, reserved)
	CityHills.build(ground, CENTER)

	local arrival = part(city, "CityArrival", Vector3.new(2, 0.2, 2), Vector3.new(CityMetro.ARRIVAL[1], CURB + 0.1, CityMetro.ARRIVAL[2]), rgb(150, 144, 134), M.Concrete, false)
	arrival.Transparency = 1

	-- Split into streaming pieces before the first replication, then publish it whole
	Lod.prepareIsland(city)
	city.Parent = root
	if existing then
		existing:Destroy()
	end
	return city
end

return City
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="237">
          <Properties>
            <string name="Name">OfficeDesk</string>
            <string name="Source"><![CDATA[-- The owner's starting office furniture in a base house: a worn wooden desk,
-- a tweed swivel chair and a yellowed late-80s desktop PC (flat case with the
-- CRT on top, a heavy keyboard, a ball mouse and some floppies). The owner can
-- sit down and use the PC (client OfficeComputer, server OfficeComputerService):
-- the chair carries a hidden Seat and rolls up to the desk while it is used.
--
-- Desk-local frame: origin on the floor under the middle of the desk, +Z is the
-- side the owner sits on (the desk's back meets the office's back wall).
local OfficeDesk = {}
local VERSION = 2

-- Where the chair stands, desk-local: left a little askew when free, square in
-- front of the monitor while someone sits at the computer.
local CHAIR_FREE = CFrame.new(0.15, 0, 2.7) * CFrame.Angles(0, 0.22, 0)
local CHAIR_SEATED = CFrame.new(-0.6, 0, 2.1)

local rgb = Color3.fromRGB
local M = Enum.Material

local VENEER = rgb(120, 82, 52)
local VENEER_DARK = rgb(78, 53, 35)
local BRASS = rgb(168, 136, 70)
local BEIGE = rgb(204, 192, 160) -- case plastic gone yellow with age
local BEIGE_LIGHT = rgb(214, 204, 175)
local BEIGE_DARK = rgb(176, 164, 133)
local FACEPLATE = rgb(188, 176, 145)
local CHARCOAL = rgb(44, 42, 40)
local SLOT = rgb(18, 17, 16)
local KEY_LIGHT = rgb(218, 211, 192)
local KEY_DARK = rgb(156, 150, 138)
local SCREEN = rgb(14, 26, 18)
local PHOSPHOR = rgb(110, 255, 140)
local TWEED = rgb(102, 78, 60)
local TWEED_WORN = rgb(124, 98, 76)
local BLACK_PLASTIC = rgb(32, 31, 33)
local CHROME = rgb(152, 152, 148)
local CABLE = rgb(58, 56, 52)

local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2) -- cylinder axis along Y
local FACING = CFrame.Angles(0, math.pi / 2, 0) -- cylinder axis along Z

local DESK_W, DESK_D, DESK_H = 6.6, 3.1, 2.9
local TOP_T = 0.16

local function make(
	kind: string,
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	solid: boolean?
): BasePart
	local piece: BasePart
	if kind == "Wedge" then
		piece = Instance.new("WedgePart")
	else
		local part = Instance.new("Part")
		if kind == "Cylinder" then
			part.Shape = Enum.PartType.Cylinder
		elseif kind == "Ball" then
			part.Shape = Enum.PartType.Ball
		end
		piece = part
	end
	piece.Name = name
	piece.Anchored = true
	piece.CanTouch = false
	piece.CanCollide = solid == true
	piece.CanQuery = solid == true
	-- Only the larger pieces throw shadows; keycaps and LEDs would just add cost.
	piece.CastShadow = solid == true or math.max(size.X, size.Y, size.Z) >= 0.6
	piece.TopSurface = Enum.SurfaceType.Smooth
	piece.BottomSurface = Enum.SurfaceType.Smooth
	piece.Material = material or M.SmoothPlastic
	piece.Color = color
	piece.Size = size
	piece.CFrame = cframe
	piece.Parent = parent
	return piece
end

local function group(parent: Instance, name: string): Model
	local result = Instance.new("Model")
	result.Name = name
	result.Parent = parent
	return result
end

-- Text printed on the part's local +Z face.
local function label(
	part: BasePart,
	text: string,
	color: Color3,
	font: Enum.Font,
	glow: boolean?,
	align: Enum.TextXAlignment?
): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(part.Size.X * 200, part.Size.Y * 200)
	gui.LightInfluence = if glow then 0 else 1
	gui.Parent = part
	local line = Instance.new("TextLabel")
	line.BackgroundTransparency = 1
	line.Size = UDim2.new(1, -12, 1, -8)
	line.Position = UDim2.new(0, 6, 0, 4)
	line.Font = font
	line.Text = text
	line.TextColor3 = color
	-- Scaled, never wrapped: multi-line text keeps its own line breaks.
	line.TextScaled = true
	line.TextWrapped = false
	line.TextXAlignment = align or Enum.TextXAlignment.Center
	line.TextYAlignment = if align == Enum.TextXAlignment.Left
		then Enum.TextYAlignment.Top
		else Enum.TextYAlignment.Center
	if glow then
		-- A faint same-colour stroke reads as phosphor bloom.
		line.TextStrokeColor3 = color
		line.TextStrokeTransparency = 0.85
	end
	line.Parent = gui
	return line
end

-- A cable laid through `points` (frame-local { x, y, z }), one straight run per
-- segment, each lengthened by its thickness so the bends stay closed.
local function cable(parent: Instance, frame: CFrame, points: { { number } }, thickness: number, color: Color3)
	for index = 1, #points - 1 do
		local a, b = points[index], points[index + 1]
		local dx, dy, dz = b[1] - a[1], b[2] - a[2], b[3] - a[3]
		local flat = math.sqrt(dx * dx + dz * dz)
		local length = math.sqrt(flat * flat + dy * dy)
		make(
			"Part",
			parent,
			"Cable",
			Vector3.new(thickness, thickness, length + thickness),
			frame
				* CFrame.new((a[1] + b[1]) / 2, (a[2] + b[2]) / 2, (a[3] + b[3]) / 2)
				* CFrame.Angles(0, math.atan2(dx, dz), 0)
				* CFrame.Angles(math.atan2(-dy, flat), 0, 0),
			color,
			M.Rubber
		)
	end
end

local function buildDesk(root: Model, frame: CFrame)
	local desk = group(root, "Desk")
	local function at(x: number, y: number, z: number): CFrame
		return frame * CFrame.new(x, y, z)
	end
	make(
		"Part",
		desk,
		"DeskTop",
		Vector3.new(DESK_W, TOP_T, DESK_D),
		at(0, DESK_H - TOP_T / 2, 0),
		VENEER,
		M.Wood,
		true
	)
	make(
		"Part",
		desk,
		"DeskEdge",
		Vector3.new(DESK_W + 0.04, 0.08, 0.06),
		at(0, DESK_H - TOP_T - 0.04, DESK_D / 2 - 0.01),
		VENEER_DARK,
		M.Wood
	)

	-- Drawer pedestal on the owner's right.
	local pedL, pedR = 1.15, DESK_W / 2 - 0.12
	local pedW, pedX = pedR - pedL, (pedL + pedR) / 2
	local pedBack, pedFront = -DESK_D / 2 + 0.1, DESK_D / 2 - 0.12
	local pedBottom, pedTop = 0.14, DESK_H - TOP_T
	make(
		"Part",
		desk,
		"Pedestal",
		Vector3.new(pedW, pedTop - pedBottom, pedFront - pedBack),
		at(pedX, (pedBottom + pedTop) / 2, (pedBack + pedFront) / 2),
		VENEER_DARK,
		M.Wood,
		true
	)
	make(
		"Part",
		desk,
		"PedestalPlinth",
		Vector3.new(pedW - 0.12, pedBottom, pedFront - pedBack - 0.16),
		at(pedX, pedBottom / 2, (pedBack + pedFront) / 2 - 0.04),
		CHARCOAL,
		M.Wood,
		true
	)
	local top = pedTop
	for index, height in { 0.62, 0.78, pedTop - pedBottom - 1.4 } do
		local y = top - height / 2
		make(
			"Part",
			desk,
			"DrawerFront",
			Vector3.new(pedW - 0.08, height - 0.06, 0.06),
			at(pedX, y, pedFront + 0.03),
			VENEER,
			M.Wood
		)
		local handleY = if index == 3 then top - 0.3 else y
		for _, side in { -1, 1 } do
			make(
				"Part",
				desk,
				"HandlePost",
				Vector3.new(0.05, 0.05, 0.07),
				at(pedX + side * 0.27, handleY, pedFront + 0.095),
				BRASS,
				M.Metal
			)
		end
		make(
			"Part",
			desk,
			"DrawerHandle",
			Vector3.new(0.64, 0.05, 0.05),
			at(pedX, handleY, pedFront + 0.145),
			BRASS,
			M.Metal
		)
		if index == 1 then
			make(
				"Cylinder",
				desk,
				"KeyEscutcheon",
				Vector3.new(0.02, 0.08, 0.08),
				at(pedX, top - 0.09, pedFront + 0.07) * FACING,
				BRASS,
				M.Metal
			)
			make("Part", desk, "Keyhole", Vector3.new(0.014, 0.036, 0.01), at(pedX, top - 0.09, pedFront + 0.083), SLOT)
		elseif index == 3 then
			make(
				"Part",
				desk,
				"LabelHolder",
				Vector3.new(0.42, 0.2, 0.02),
				at(pedX, top - 0.56, pedFront + 0.07),
				BRASS,
				M.Metal
			)
			make(
				"Part",
				desk,
				"LabelCard",
				Vector3.new(0.36, 0.14, 0.012),
				at(pedX, top - 0.56, pedFront + 0.082),
				rgb(232, 224, 200)
			)
		end
		top -= height
	end

	-- Panel leg on the left, modesty panel at the back, pencil drawer between.
	local legX = -DESK_W / 2 + 0.19
	make(
		"Part",
		desk,
		"LegPanel",
		Vector3.new(0.14, pedTop, DESK_D - 0.2),
		at(legX, pedTop / 2, 0),
		VENEER,
		M.Wood,
		true
	)
	make("Part", desk, "LegFoot", Vector3.new(0.18, 0.08, DESK_D - 0.16), at(legX, 0.04, 0), VENEER_DARK, M.Wood)
	local innerL = legX + 0.07
	make(
		"Part",
		desk,
		"ModestyPanel",
		Vector3.new(pedL - innerL, 1.5, 0.06),
		at((innerL + pedL) / 2, pedTop - 0.75, -DESK_D / 2 + 0.25),
		VENEER_DARK,
		M.Wood,
		true
	)
	local drawerX, drawerW = (innerL + pedL) / 2, pedL - innerL - 0.09
	make(
		"Part",
		desk,
		"PencilDrawerBox",
		Vector3.new(drawerW, 0.3, 2.4),
		at(drawerX, pedTop - 0.17, pedFront - 1.2),
		VENEER_DARK,
		M.Wood
	)
	make(
		"Part",
		desk,
		"PencilDrawer",
		Vector3.new(drawerW, 0.3, 0.06),
		at(drawerX, pedTop - 0.17, pedFront + 0.03),
		VENEER,
		M.Wood
	)
	make(
		"Part",
		desk,
		"PencilDrawerPull",
		Vector3.new(0.5, 0.04, 0.05),
		at(drawerX, pedTop - 0.27, pedFront + 0.085),
		BRASS,
		M.Metal
	)

	-- Green leather blotter under the keyboard, with darker leather ends.
	local blotterX, blotterZ, blotterW, blotterD = -0.5, 0.98, 3.6, 1.0
	make(
		"Part",
		desk,
		"Blotter",
		Vector3.new(blotterW, 0.02, blotterD),
		at(blotterX, DESK_H + 0.01, blotterZ),
		rgb(42, 74, 54),
		M.Leather
	)
	for _, side in { -1, 1 } do
		make(
			"Part",
			desk,
			"BlotterEnd",
			Vector3.new(0.18, 0.026, blotterD + 0.02),
			at(blotterX + side * (blotterW / 2 - 0.08), DESK_H + 0.013, blotterZ),
			rgb(70, 44, 30),
			M.Leather
		)
	end
end

-- Flat desktop case, origin on the desk under its middle, front +Z.
local CASE_W, CASE_H, CASE_D = 2.5, 0.6, 1.9
local function buildCase(root: Model, frame: CFrame)
	local case = group(root, "SystemUnit")
	local function at(x: number, y: number, z: number): CFrame
		return frame * CFrame.new(x, y, z)
	end
	for _, x in { -1.1, 1.1 } do
		for _, z in { -0.8, 0.8 } do
			make("Part", case, "Foot", Vector3.new(0.16, 0.04, 0.16), at(x, 0.02, z), CHARCOAL, M.Rubber)
		end
	end
	local bodyD = CASE_D - 0.08
	make("Part", case, "Body", Vector3.new(CASE_W, CASE_H, bodyD), at(0, 0.04 + CASE_H / 2, -0.04), BEIGE)
	make("Part", case, "LidSeam", Vector3.new(CASE_W + 0.024, 0.025, bodyD + 0.012), at(0, 0.52, -0.046), BEIGE_DARK)
	make(
		"Part",
		case,
		"Bezel",
		Vector3.new(CASE_W + 0.02, CASE_H + 0.02, 0.08),
		at(0, 0.34, CASE_D / 2 - 0.04),
		rgb(198, 186, 155)
	)
	local fz = CASE_D / 2 -- bezel front

	-- 5.25" drive with its turn latch closed across the slot.
	make("Part", case, "FloppyDrive525", Vector3.new(1.02, 0.34, 0.03), at(-0.62, 0.38, fz + 0.015), FACEPLATE)
	make("Part", case, "DiskSlot", Vector3.new(0.82, 0.045, 0.01), at(-0.62, 0.4, fz + 0.035), SLOT)
	make("Part", case, "DriveLatch", Vector3.new(0.07, 0.26, 0.05), at(-0.62, 0.4, fz + 0.055), CHARCOAL)
	make("Part", case, "DriveLight", Vector3.new(0.06, 0.03, 0.02), at(-1.0, 0.27, fz + 0.04), rgb(110, 24, 22))
	-- 3.5" drive.
	make("Part", case, "FloppyDrive35", Vector3.new(0.6, 0.2, 0.03), at(0.2, 0.35, fz + 0.015), FACEPLATE)
	make("Part", case, "DiskSlot", Vector3.new(0.42, 0.03, 0.01), at(0.2, 0.38, fz + 0.035), SLOT)
	make("Part", case, "EjectButton", Vector3.new(0.1, 0.05, 0.03), at(0.38, 0.3, fz + 0.04), BEIGE_DARK)
	make("Part", case, "DriveLight", Vector3.new(0.04, 0.02, 0.02), at(0.0, 0.3, fz + 0.04), rgb(30, 86, 40))
	-- Control panel: clock-speed readout, turbo and reset, key lock, status lights.
	local readout = make("Part", case, "SpeedReadout", Vector3.new(0.26, 0.14, 0.02), at(0.9, 0.52, fz + 0.01), SLOT)
	label(readout, "33", rgb(255, 60, 40), Enum.Font.Code, true)
	make("Part", case, "TurboButton", Vector3.new(0.12, 0.07, 0.04), at(0.68, 0.36, fz + 0.02), BEIGE_DARK)
	make("Part", case, "ResetButton", Vector3.new(0.08, 0.05, 0.035), at(0.84, 0.36, fz + 0.018), BEIGE_DARK)
	make("Cylinder", case, "KeyLock", Vector3.new(0.03, 0.1, 0.1), at(1.06, 0.36, fz + 0.015) * FACING, CHROME, M.Metal)
	make("Part", case, "KeySlot", Vector3.new(0.015, 0.05, 0.01), at(1.06, 0.36, fz + 0.032), SLOT)
	for index, light in
		{
			{ rgb(90, 230, 110), M.Neon }, -- power
			{ rgb(110, 70, 22), M.SmoothPlastic }, -- disk, idle
			{ rgb(240, 196, 60), M.Neon }, -- turbo
		}
	do
		make(
			"Part",
			case,
			"StatusLight",
			Vector3.new(0.05, 0.025, 0.02),
			at(0.56 + index * 0.15, 0.22, fz + 0.01),
			light[1],
			light[2]
		)
	end
	for row = 0, 3 do
		make("Part", case, "FrontVent", Vector3.new(1.0, 0.018, 0.008), at(0.5, 0.08 + row * 0.028, fz + 0.004), SLOT)
	end
	local badge = make("Part", case, "Badge", Vector3.new(0.5, 0.09, 0.012), at(-0.85, 0.13, fz + 0.006), CHARCOAL)
	label(badge, "PC 386", BEIGE_LIGHT, Enum.Font.GothamBold)
	-- Big red mains switch on the right flank, slots down the left.
	make("Part", case, "SwitchHousing", Vector3.new(0.02, 0.22, 0.32), at(CASE_W / 2 + 0.01, 0.34, -0.6), BEIGE_DARK)
	make(
		"Part",
		case,
		"PowerSwitch",
		Vector3.new(0.04, 0.16, 0.12),
		at(CASE_W / 2 + 0.03, 0.34, -0.6) * CFrame.Angles(0, 0, 0.15),
		rgb(168, 40, 32)
	)
	for index = 0, 5 do
		make(
			"Part",
			case,
			"SideVent",
			Vector3.new(0.01, 0.3, 0.03),
			at(-CASE_W / 2 - 0.003, 0.32, -0.7 + index * 0.08),
			SLOT
		)
	end
	-- Back panel: expansion brackets, fan grille and sockets.
	local bz = -CASE_D / 2
	for index = 0, 6 do
		make(
			"Part",
			case,
			"SlotBracket",
			Vector3.new(0.07, 0.42, 0.015),
			at(-1.05 + index * 0.11, 0.32, bz - 0.008),
			CHROME,
			M.Metal
		)
	end
	make(
		"Cylinder",
		case,
		"FanGrille",
		Vector3.new(0.02, 0.36, 0.36),
		at(0.78, 0.36, bz - 0.01) * FACING,
		CHARCOAL,
		M.Metal
	)
	for _, bar in { Vector3.new(0.34, 0.02, 0.012), Vector3.new(0.02, 0.34, 0.012), Vector3.new(0.24, 0.02, 0.012) } do
		make(
			"Part",
			case,
			"GrilleBar",
			bar,
			at(0.78, if bar.X == 0.24 then 0.46 else 0.36, bz - 0.022),
			CHROME,
			M.Metal
		)
	end
	make("Part", case, "MainsSocket", Vector3.new(0.16, 0.1, 0.02), at(0.36, 0.18, bz - 0.01), SLOT)
	make("Part", case, "VideoPlug", Vector3.new(0.2, 0.07, 0.04), at(-0.2, 0.18, bz - 0.02), CHARCOAL)
end

-- 14" monochrome CRT, origin on the case lid under the front of the bezel.
local function buildMonitor(root: Model, frame: CFrame)
	local monitor = group(root, "Monitor")
	local function at(x: number, y: number, z: number): CFrame
		return frame * CFrame.new(x, y, z)
	end
	make("Cylinder", monitor, "SwivelBase", Vector3.new(0.06, 1.1, 1.1), at(0, 0.03, -0.5) * UPRIGHT, BEIGE_DARK)
	make("Part", monitor, "SwivelNeck", Vector3.new(0.5, 0.22, 0.5), at(0, 0.14, -0.5), BEIGE_DARK)

	local sy = 1.06 -- bezel centre height
	local openY, openW, openH = sy + 0.1, 1.56, 1.2
	-- Bezel frame around a real opening, so the glass sits recessed.
	make("Part", monitor, "BezelTop", Vector3.new(2.0, 0.16, 0.16), at(0, sy + 0.78, 0), BEIGE_LIGHT)
	make("Part", monitor, "BezelChin", Vector3.new(2.0, 0.36, 0.16), at(0, sy - 0.68, 0), BEIGE_LIGHT)
	for _, side in { -1, 1 } do
		make("Part", monitor, "BezelSide", Vector3.new(0.22, openH, 0.16), at(side * 0.89, openY, 0), BEIGE_LIGHT)
	end
	local surround = rgb(118, 112, 98)
	for _, side in { -1, 1 } do
		make(
			"Part",
			monitor,
			"ScreenSurround",
			Vector3.new(openW, 0.06, 0.12),
			at(0, openY + side * (openH / 2 - 0.03), -0.02),
			surround
		)
		make(
			"Part",
			monitor,
			"ScreenSurround",
			Vector3.new(0.06, openH - 0.12, 0.12),
			at(side * (openW / 2 - 0.03), openY, -0.02),
			surround
		)
	end
	local glass =
		make("Part", monitor, "ScreenGlass", Vector3.new(openW - 0.12, openH - 0.12, 0.04), at(0, openY, -0.06), SCREEN)
	glass.Reflectance = 0.06
	-- The tube face bulges out of the flat glass, like a real CRT.
	local bulge =
		make("Part", monitor, "ScreenCurve", Vector3.new(openW - 0.12, openH - 0.12, 0.12), at(0, openY, -0.06), SCREEN)
	bulge.Reflectance = 0.12
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = bulge
	label(
		bulge,
		"HARBOUR-DOS  Version 3.30\n(C) Copyright 1989\n\nC:\\>dir\n ACCOUNTS   <DIR>\n STAFF      <DIR>\n LEDGER     WK1\n TIDES      EXE\n\nC:\\>_",
		PHOSPHOR,
		Enum.Font.Code,
		true,
		Enum.TextXAlignment.Left
	)

	-- Chin: model plate, contrast and brightness knobs, power button and lamp.
	local plate =
		make("Part", monitor, "ModelPlate", Vector3.new(0.62, 0.09, 0.01), at(-0.55, sy - 0.68, 0.085), CHARCOAL)
	label(plate, "MONOCHROME 14", BEIGE_LIGHT, Enum.Font.GothamBold)
	for _, x in { 0.22, 0.38 } do
		make("Cylinder", monitor, "Knob", Vector3.new(0.06, 0.11, 0.11), at(x, sy - 0.68, 0.11) * FACING, CHARCOAL)
	end
	make("Part", monitor, "PowerButton", Vector3.new(0.16, 0.12, 0.04), at(0.74, sy - 0.68, 0.1), BEIGE_DARK)
	make(
		"Part",
		monitor,
		"PowerLight",
		Vector3.new(0.05, 0.03, 0.02),
		at(0.56, sy - 0.68, 0.09),
		rgb(90, 230, 110),
		M.Neon
	)
	-- Somebody's reminder, stuck over the corner of the screen.
	local note = make(
		"Part",
		monitor,
		"StickyNote",
		Vector3.new(0.27, 0.27, 0.01),
		at(0.8, sy + 0.66, 0.086) * CFrame.Angles(0, 0, -0.12),
		rgb(250, 228, 110)
	)
	label(note, "back up\nfriday!", rgb(40, 52, 120), Enum.Font.IndieFlower)

	-- Stepped tube housing tapering to the rear, with vent slots on top.
	local steps = {
		{ Vector3.new(1.9, 1.62, 0.45), 0, -0.305 },
		{ Vector3.new(1.6, 1.34, 0.36), -0.04, -0.71 },
		{ Vector3.new(1.28, 1.06, 0.3), -0.07, -1.04 },
	}
	for _, step in steps do
		local size, dy, z = step[1], step[2], step[3]
		make("Part", monitor, "Housing", size, at(0, sy + dy, z), BEIGE)
		local slots = math.floor(size.Z / 0.07)
		for index = 1, slots - 1 do
			make(
				"Part",
				monitor,
				"TopVent",
				Vector3.new(size.X * 0.62, 0.012, 0.03),
				at(0, sy + dy + size.Y / 2 + 0.003, z - size.Z / 2 + index * 0.07),
				SLOT
			)
		end
	end
	make("Part", monitor, "RearCap", Vector3.new(0.98, 0.78, 0.1), at(0, sy - 0.09, -1.24), BEIGE_DARK)
end

-- Heavy buckling-spring style keyboard, origin on the desk under its middle.
local U, KEY_GAP = 0.098, 0.016
local ROW_Z = { fn = -0.28, num = -0.14, q = -0.042, a = 0.056, z = 0.154, sp = 0.252 }
local function keys(count: number, token: string): { string }
	local result = {}
	for _ = 1, count do
		table.insert(result, token)
	end
	return result
end
local function join(...: { string }): { string }
	local result = {}
	for _, list in { ... } do
		for _, token in list do
			table.insert(result, token)
		end
	end
	return result
end
-- "1.5" a light key 1.5 wide, "d2" a dark key 2 wide, "_1" a gap one key wide.
local MAIN_ROWS = {
	fn = join({ "d1", "_1" }, keys(4, "1"), { "_0.5" }, keys(4, "1"), { "_0.5" }, keys(4, "1")),
	num = join(keys(13, "1"), { "d2" }),
	q = join({ "d1.5" }, keys(12, "1"), { "1.5" }),
	a = join({ "d1.75" }, keys(11, "1"), { "d2.25" }),
	z = join({ "d2.25" }, keys(10, "1"), { "d2.75" }),
	sp = { "d1.5", "_1", "d1.5", "7", "d1.5", "_1", "d1.5" },
}
local NAV_ROWS = {
	fn = keys(3, "d1"),
	num = keys(3, "d1"),
	q = keys(3, "d1"),
	z = { "_1", "d1" },
	sp = keys(3, "d1"),
}
local PAD_ROWS = {
	num = keys(4, "d1"),
	q = keys(3, "1"),
	a = keys(3, "1"),
	z = keys(3, "1"),
	sp = { "2", "1" },
}
local function buildKeyboard(root: Model, frame: CFrame)
	local keyboard = group(root, "Keyboard")
	local width, depth = 2.45, 0.85
	make("Part", keyboard, "Base", Vector3.new(width, 0.12, depth), frame * CFrame.new(0, 0.06, 0), BEIGE)
	-- Rises toward the monitor (-Z), like the register's key slope.
	make(
		"Wedge",
		keyboard,
		"Slope",
		Vector3.new(width, 0.1, depth),
		frame * CFrame.new(0, 0.17, 0) * CFrame.Angles(0, math.pi, 0),
		BEIGE
	)
	local slope = frame * CFrame.new(0, 0.17, 0) * CFrame.Angles(math.atan2(0.1, depth), 0, 0)
	local function cap(x: number, z: number, wide: number, deep: number, dark: boolean)
		make(
			"Part",
			keyboard,
			"Key",
			Vector3.new(wide * U - KEY_GAP, 0.07, deep * U - KEY_GAP),
			slope * CFrame.new(x, 0.035, z),
			if dark then KEY_DARK else KEY_LIGHT
		)
	end
	local function block(rows, left: number)
		for rowName, tokens in rows do
			local cursor = left
			for _, token in tokens do
				local gap = string.sub(token, 1, 1) == "_"
				local dark = string.sub(token, 1, 1) == "d"
				local wide = tonumber(if gap or dark then string.sub(token, 2) else token) :: number
				if not gap then
					cap(cursor + wide * U / 2, ROW_Z[rowName], wide, 1, dark)
				end
				cursor += wide * U
			end
		end
	end
	local mainLeft = -1.12
	local navLeft = mainLeft + 15.25 * U
	local padLeft = navLeft + 3.25 * U
	block(MAIN_ROWS, mainLeft)
	block(NAV_ROWS, navLeft)
	block(PAD_ROWS, padLeft)
	-- Tall numpad + and Enter.
	cap(padLeft + 3.5 * U, (ROW_Z.q + ROW_Z.a) / 2, 1, 2, false)
	cap(padLeft + 3.5 * U, (ROW_Z.z + ROW_Z.sp) / 2, 1, 2, true)
	-- Lock lights over the numpad (Num Lock on) and a maker's strip top left.
	make(
		"Part",
		keyboard,
		"LightPanel",
		Vector3.new(0.38, 0.006, 0.07),
		slope * CFrame.new(padLeft + 2 * U, 0.003, ROW_Z.fn),
		CHARCOAL
	)
	for index, x in { 0.8, 2, 3.2 } do
		make(
			"Part",
			keyboard,
			"LockLight",
			Vector3.new(0.035, 0.012, 0.025),
			slope * CFrame.new(padLeft + x * U, 0.006, ROW_Z.fn),
			if index == 1 then rgb(90, 230, 110) else rgb(26, 60, 32),
			if index == 1 then M.Neon else M.SmoothPlastic
		)
	end
	make("Part", keyboard, "Badge", Vector3.new(0.3, 0.008, 0.04), slope * CFrame.new(-0.9, 0.004, -0.375), CHARCOAL)
end

-- Boxy two-button ball mouse, origin on the pad under its middle, buttons at -Z.
local function buildMouse(root: Model, frame: CFrame)
	local mouse = group(root, "Mouse")
	make("Part", mouse, "Body", Vector3.new(0.32, 0.1, 0.52), frame * CFrame.new(0, 0.05, 0), BEIGE)
	make("Wedge", mouse, "Palm", Vector3.new(0.32, 0.05, 0.32), frame * CFrame.new(0, 0.125, 0.1), BEIGE)
	for _, side in { -1, 1 } do
		make(
			"Part",
			mouse,
			"Button",
			Vector3.new(0.145, 0.015, 0.19),
			frame * CFrame.new(side * 0.08, 0.1075, -0.155),
			BEIGE_DARK
		)
	end
end

local function buildComputer(root: Model, frame: CFrame)
	local computer = group(root, "Computer")
	local caseFrame = frame * CFrame.new(-0.6, DESK_H, -0.5)
	buildCase(computer, caseFrame)
	buildMonitor(computer, caseFrame * CFrame.new(0, 0.64, 0.8))
	local top = DESK_H + 0.02 -- blotter surface
	buildKeyboard(computer, frame * CFrame.new(-0.6, top, 0.98) * CFrame.Angles(0, 0.03, 0))
	make(
		"Part",
		computer,
		"MousePad",
		Vector3.new(0.9, 0.02, 0.78),
		frame * CFrame.new(1.9, DESK_H + 0.01, 0.95),
		rgb(38, 52, 88),
		M.Fabric
	)
	buildMouse(computer, frame * CFrame.new(1.85, top, 0.98) * CFrame.Angles(0, -0.12, 0))

	local cables = group(computer, "Cables")
	-- Monitor lead down the back of the tube to the video port.
	cable(
		cables,
		caseFrame,
		{
			{ -0.2, 1.35, -0.46 },
			{ -0.2, 1.2, -0.55 },
			{ -0.2, 0.67, -0.55 },
			{ -0.2, 0.67, -0.99 },
			{ -0.2, 0.2, -0.99 },
		},
		0.05,
		CABLE
	)
	-- Keyboard lead around the left of the case; mouse tail around the right.
	local y = DESK_H + 0.045
	cable(
		cables,
		frame,
		{ { -1.5, y, 0.56 }, { -1.75, y, 0.5 }, { -1.98, y, 0.25 }, { -2.0, y, -0.9 }, { -1.6, y, -1.48 } },
		0.05,
		rgb(150, 144, 128)
	)
	cable(
		cables,
		frame,
		{
			{ 1.88, y, 0.72 },
			{ 1.75, y, 0.35 },
			{ 1.35, y, -0.05 },
			{ 0.95, y, -0.55 },
			{ 0.75, y, -1.0 },
			{ 0.66, y, -1.2 },
		},
		0.04,
		rgb(150, 144, 128)
	)
	-- Mains lead dropping down the gap between the desk and the wall.
	cable(cables, caseFrame, { { 0.36, 0.18, -1.0 }, { 0.36, 0.1, -1.065 }, { 0.36, -2.88, -1.065 } }, 0.04, CABLE)
end

local function floppy(parent: Instance, frame: CFrame, color: Color3)
	make("Part", parent, "Floppy", Vector3.new(0.38, 0.38, 0.035), frame, color)
	make("Part", parent, "Shutter", Vector3.new(0.17, 0.13, 0.045), frame * CFrame.new(0.02, 0.125, 0), CHROME, M.Metal)
	make(
		"Part",
		parent,
		"DiskLabel",
		Vector3.new(0.3, 0.17, 0.042),
		frame * CFrame.new(0, -0.08, 0),
		rgb(236, 232, 218)
	)
end

local function buildClutter(root: Model, frame: CFrame)
	local clutter = group(root, "Clutter")
	-- Box of 3.5" diskettes.
	local box = frame * CFrame.new(-2.65, DESK_H, -0.75) * CFrame.Angles(0, 0.25, 0)
	local smoke = rgb(60, 62, 66)
	make("Part", clutter, "DiskBoxBase", Vector3.new(0.5, 0.04, 0.6), box * CFrame.new(0, 0.02, 0), smoke)
	for _, side in { -1, 1 } do
		make(
			"Part",
			clutter,
			"DiskBoxWall",
			Vector3.new(0.5, 0.22, 0.03),
			box * CFrame.new(0, 0.13, side * 0.285),
			smoke
		)
		make(
			"Part",
			clutter,
			"DiskBoxWall",
			Vector3.new(0.03, 0.22, 0.54),
			box * CFrame.new(side * 0.235, 0.13, 0),
			smoke
		)
	end
	local colors =
		{ rgb(30, 30, 34), rgb(38, 70, 140), rgb(150, 36, 36), rgb(30, 30, 34), rgb(120, 120, 124), rgb(36, 96, 60) }
	for index, color in colors do
		floppy(
			clutter,
			box * CFrame.new(0, 0.23, -0.22 + (index - 1) * 0.085) * CFrame.Angles(-0.18 + index * 0.025, 0, 0),
			color
		)
	end
	-- One left out on the desk.
	floppy(
		clutter,
		frame * CFrame.new(-2.62, DESK_H + 0.018, 0.75) * CFrame.Angles(0, 0.45, 0) * CFrame.Angles(-math.pi / 2, 0, 0),
		rgb(38, 70, 140)
	)

	-- Coffee mug.
	local mug = frame * CFrame.new(2.55, DESK_H, -0.85)
	local cream = rgb(232, 226, 210)
	make("Cylinder", clutter, "Mug", Vector3.new(0.3, 0.26, 0.26), mug * CFrame.new(0, 0.15, 0) * UPRIGHT, cream)
	make(
		"Cylinder",
		clutter,
		"Coffee",
		Vector3.new(0.01, 0.22, 0.22),
		mug * CFrame.new(0, 0.27, 0) * UPRIGHT,
		rgb(54, 32, 20)
	)
	make("Part", clutter, "MugHandle", Vector3.new(0.04, 0.18, 0.05), mug * CFrame.new(0.19, 0.15, 0), cream)
	for _, y in { 0.06, 0.24 } do
		make("Part", clutter, "MugHandle", Vector3.new(0.08, 0.04, 0.05), mug * CFrame.new(0.155, y, 0), cream)
	end
end

-- Worn tweed swivel chair, origin on the floor under the seat, facing -Z.
local function buildChair(root: Model, frame: CFrame)
	local chair = group(root, "Chair")
	local function at(x: number, y: number, z: number): CFrame
		return frame * CFrame.new(x, y, z)
	end
	make("Cylinder", chair, "Hub", Vector3.new(0.18, 0.34, 0.34), at(0, 0.3, 0) * UPRIGHT, BLACK_PLASTIC)
	for index = 0, 4 do
		local spoke = frame * CFrame.Angles(0, index * 2 * math.pi / 5 + 0.3, 0)
		make(
			"Part",
			chair,
			"BaseLeg",
			Vector3.new(0.14, 0.1, 0.95),
			spoke * CFrame.new(0, 0.27, 0.55) * CFrame.Angles(0.06, 0, 0),
			BLACK_PLASTIC
		)
		make("Part", chair, "CasterFork", Vector3.new(0.1, 0.12, 0.1), spoke * CFrame.new(0, 0.18, 1.0), BLACK_PLASTIC)
		make(
			"Cylinder",
			chair,
			"Caster",
			Vector3.new(0.1, 0.18, 0.18),
			spoke * CFrame.new(0, 0.09, 1.06),
			CHARCOAL,
			M.Rubber
		)
	end
	make("Cylinder", chair, "ColumnShroud", Vector3.new(0.55, 0.26, 0.26), at(0, 0.62, 0) * UPRIGHT, BLACK_PLASTIC)
	make("Cylinder", chair, "GasColumn", Vector3.new(0.48, 0.15, 0.15), at(0, 1.13, 0) * UPRIGHT, CHROME, M.Metal)
	make("Part", chair, "TiltMechanism", Vector3.new(0.7, 0.12, 0.7), at(0, 1.41, 0), BLACK_PLASTIC, M.Metal)
	make("Part", chair, "HeightLever", Vector3.new(0.5, 0.04, 0.04), at(0.55, 1.4, -0.15), BLACK_PLASTIC, M.Metal)
	make("Ball", chair, "LeverKnob", Vector3.new(0.1, 0.1, 0.1), at(0.82, 1.4, -0.15), BLACK_PLASTIC)

	make("Part", chair, "SeatShell", Vector3.new(1.55, 0.08, 1.5), at(0, 1.51, 0), BLACK_PLASTIC)
	make("Part", chair, "SeatCushion", Vector3.new(1.6, 0.28, 1.45), at(0, 1.69, 0), TWEED, M.Fabric, true)
	for _, side in { -1, 1 } do
		make("Cylinder", chair, "SeatRoll", Vector3.new(1.6, 0.28, 0.28), at(0, 1.69, side * 0.725), TWEED, M.Fabric)
	end
	-- Rubbed shiny where years of sitting wore the weave down.
	make("Part", chair, "WornPatch", Vector3.new(0.7, 0.02, 0.6), at(0, 1.832, 0.05), TWEED_WORN, M.Fabric)
	-- Hidden seat the server sits the owner in. CanTouch is off so nobody sits
	-- down just by walking into the chair.
	local seat = Instance.new("Seat")
	seat.Name = "Seat"
	seat.Anchored = true
	seat.CanCollide = false
	seat.CanTouch = false
	seat.CanQuery = false
	seat.CastShadow = false
	seat.Transparency = 1
	seat.Size = Vector3.new(1.4, 0.2, 1.3)
	seat.CFrame = at(0, 1.73, 0)
	seat.Parent = chair

	make("Part", chair, "BackSpine", Vector3.new(0.3, 0.1, 0.75), at(0, 1.45, 0.65), BLACK_PLASTIC, M.Metal)
	make("Part", chair, "BackUpright", Vector3.new(0.3, 1.0, 0.1), at(0, 1.95, 1.0), BLACK_PLASTIC, M.Metal)
	local back = frame * CFrame.new(0, 2.95, 0.98) * CFrame.Angles(0.12, 0, 0)
	make("Part", chair, "BackShell", Vector3.new(1.5, 1.5, 0.12), back * CFrame.new(0, 0, 0.12), BLACK_PLASTIC)
	make(
		"Part",
		chair,
		"BackCushion",
		Vector3.new(1.46, 1.3, 0.24),
		back * CFrame.new(0, 0, -0.06),
		TWEED,
		M.Fabric,
		true
	)
	for _, side in { -1, 1 } do
		make(
			"Cylinder",
			chair,
			"BackRoll",
			Vector3.new(1.46, 0.24, 0.24),
			back * CFrame.new(0, side * 0.65, -0.06),
			TWEED,
			M.Fabric
		)
	end
	make(
		"Part",
		chair,
		"LumbarSeam",
		Vector3.new(1.47, 0.03, 0.25),
		back * CFrame.new(0, -0.25, -0.06),
		rgb(78, 58, 44),
		M.Fabric
	)

	for _, side in { -1, 1 } do
		make(
			"Part",
			chair,
			"ArmBracket",
			Vector3.new(0.55, 0.06, 0.18),
			at(side * 0.78, 1.46, 0.05),
			BLACK_PLASTIC,
			M.Metal
		)
		make("Part", chair, "ArmPost", Vector3.new(0.12, 0.9, 0.18), at(side * 1.0, 1.88, 0.05), BLACK_PLASTIC)
		make(
			"Part",
			chair,
			"ArmPad",
			Vector3.new(0.26, 0.1, 0.95),
			at(side * 1.0, 2.38, -0.05),
			rgb(46, 43, 41),
			M.Leather
		)
	end
end

function OfficeDesk.build(parent: Instance, frame: CFrame): Model
	local root = Instance.new("Model")
	root.Name = "OfficeDesk"
	root:SetAttribute("ModelVersion", VERSION)
	root:SetAttribute("DeskFrame", frame)
	root:SetAttribute("ChairAt", frame * CHAIR_FREE)
	buildDesk(root, frame)
	buildComputer(root, frame)
	buildClutter(root, frame)
	-- Pulled out from the desk and left a little askew.
	buildChair(root, frame * CHAIR_FREE)
	root.Parent = parent
	return root
end

-- Rolls the chair (and its seat) up to the monitor, or back out askew.
function OfficeDesk.moveChair(root: Instance, seated: boolean)
	local deskFrame = root:GetAttribute("DeskFrame")
	local current = root:GetAttribute("ChairAt")
	local chair = root:FindFirstChild("Chair")
	if typeof(deskFrame) ~= "CFrame" or typeof(current) ~= "CFrame" or not chair then
		return
	end
	local target = deskFrame * (if seated then CHAIR_SEATED else CHAIR_FREE)
	local delta = target * current:Inverse()
	for _, part in chair:GetDescendants() do
		if part:IsA("BasePart") then
			part.CFrame = delta * part.CFrame
		end
	end
	root:SetAttribute("ChairAt", target)
end

OfficeDesk.WIDTH = DESK_W
OfficeDesk.DEPTH = DESK_D
OfficeDesk.HEIGHT = DESK_H
-- Against the middle of the office's back wall (house-local z = 2.25, 0.55
-- thick), on the office floor boards (top at 0.18).
function OfficeDesk.frame(houseFrame: CFrame): CFrame
	return houseFrame * CFrame.new(-15.75, 0.18, 2.525 + 0.05 + DESK_D / 2)
end

function OfficeDesk.ensure(house: Model, houseFrame: CFrame)
	local office = house:FindFirstChild("Office")
	if not office then
		return
	end
	local existing = office:FindFirstChild("OfficeDesk")
	if existing and existing:GetAttribute("ModelVersion") == VERSION then
		return
	end
	if existing then
		existing:Destroy()
	end
	OfficeDesk.build(office, OfficeDesk.frame(houseFrame))
end

return OfficeDesk
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="238">
          <Properties>
            <string name="Name">PirateCove</string>
            <string name="Source"><![CDATA[-- Pirate Cove: a low tropical island in the Coral Shallows with a rocky headland, a long pier
-- pointing home towards Gullhaven, a little town round a flag-pole plaza (galley stall, rod stall,
-- tavern and shacks), cannons on the bluff and a wreck in the shallows. Built like the city: one
-- model straight under the map, versioned and rebuilt when VERSION changes, with its own seeded
-- RNG so the rest of the seeded archipelago is untouched. Island-local coordinates have north at -Z.
-- The crew who stand here are spawned by PirateCoveService at the anchors this sets.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Biomes = require(ReplicatedStorage.Shared.Biomes)
local Data = require(ReplicatedStorage.Shared.PirateCove)
local Islands = require(script.Parent.Islands)
local Lod = require(script.Parent.Lod)
local Props = require(script.Parent.Props)

local Cove = {}
Cove.VERSION = 2

local TAU = math.pi * 2
local rgb = Color3.fromRGB
local M = Enum.Material
local part, beam, cylinder = Props.part, Props.beam, Props.cylinder

local CENTER = Vector3.new(Data.CENTER[1], 0, Data.CENTER[2])
local HEIGHT = 12
local PIER_LENGTH = 72
-- Anything else on the map this close to CENTER (plus its own radius) is cleared for the cove.
local CLEARANCE = 270

local PALETTE = {
	top = rgb(98, 160, 70),
	cliff = rgb(182, 160, 120),
	shore = rgb(240, 226, 186),
	materials = { top = M.LeafyGrass, cliff = M.Sandstone, shore = M.Sand },
}
local ROCK = {
	top = rgb(142, 132, 112),
	cliff = rgb(122, 114, 100),
	shore = rgb(214, 200, 166),
	materials = { top = M.Rock, cliff = M.Rock, shore = M.Sand },
}
local WOOD = rgb(122, 88, 58)
local WOOD_DARK = rgb(70, 50, 36)
local IRON = rgb(44, 42, 42)
local SAIL = rgb(214, 200, 168)
local WALLS = { rgb(168, 128, 86), rgb(150, 112, 76), rgb(186, 150, 104), rgb(120, 140, 120) }
local THATCH = rgb(204, 172, 106)
local CANOPIES = { rgb(170, 40, 40), rgb(30, 70, 120), rgb(40, 110, 80) }

local function world(x: number, z: number): Vector3
	return CENTER + Vector3.new(x, 0, z)
end

-- Angle that turns a builder's local +Z (its front) from `from` towards `to`.
local function facing(from: Vector3, to: Vector3): number
	local d = to - from
	return math.atan2(d.X, d.Z)
end

local function newModel(name: string, parent: Instance): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

----------------------------------------------------------------------------------------------------
-- Clearing the site

-- The seeded archipelago knows nothing of the cove, so any scenery island, rock or coral that landed
-- here is removed, along with its distant shell.
local function clearSite(root: Instance)
	local shells = root:FindFirstChild("Lod")
	local centre = Vector2.new(CENTER.X, CENTER.Z)
	for _, folder in root:GetChildren() do
		if not folder:IsA("Folder") then
			continue
		end
		for _, child in folder:GetChildren() do
			if not child:IsA("Model") or child.Name == "Harbour Isle" then
				continue
			end
			local pivot = child:GetPivot().Position
			local reach = CLEARANCE + (tonumber(child:GetAttribute("Radius")) or 0) * 1.35
			if (Vector2.new(pivot.X, pivot.Z) - centre).Magnitude < reach then
				local id = child:GetAttribute("LodId")
				local shell = if shells and id ~= nil then shells:FindFirstChild(tostring(id)) else nil
				if shell then
					shell:Destroy()
				end
				child:Destroy()
			end
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Set pieces

-- A black flag on a tall mast with a bone-white skull and crossed bones on both faces.
local function jollyRoger(parent: Instance, ground: Vector3)
	local m = newModel("PirateFlag", parent)
	cylinder(m, ground + Vector3.new(0, 12, 0), 24, 0.7, WOOD_DARK, M.Wood)
	Props.ball(m, ground + Vector3.new(0, 24.3, 0), 1, rgb(200, 170, 80), M.Metal)
	local cloth = CFrame.new(ground + Vector3.new(0, 20.6, 4.2))
	part(m, Vector3.new(0.2, 5, 8), cloth, rgb(20, 20, 22), M.Fabric)
	local bone = rgb(236, 232, 220)
	for _, side in { -1, 1 } do
		local face = cloth * CFrame.new(side * 0.14, 0, 0)
		part(m, Vector3.new(0.06, 1.6, 1.8), face * CFrame.new(0, 0.6, 0), bone, M.SmoothPlastic)
		part(m, Vector3.new(0.06, 0.7, 1.1), face * CFrame.new(0, -0.35, 0), bone, M.SmoothPlastic)
		for _, tilt in { -0.7, 0.7 } do
			part(
				m,
				Vector3.new(0.05, 0.35, 4),
				face * CFrame.new(0, -1.3, 0) * CFrame.Angles(tilt, 0, 0),
				bone,
				M.SmoothPlastic
			)
		end
		for _, x in { -0.4, 0.4 } do
			part(
				m,
				Vector3.new(0.08, 0.36, 0.36),
				face * CFrame.new(side * 0.02, 0.75, x),
				rgb(20, 20, 22),
				M.SmoothPlastic
			)
		end
	end
	-- Mast steps and a coil of halyard at the foot.
	cylinder(m, ground + Vector3.new(0, 0.4, 0), 0.8, 3.2, WOOD, M.WoodPlanks)
	Props.ropeCoil(m, ground + Vector3.new(1.8, 0, 0.8))
end

-- Counter, striped canopy and a rack of rods; the trader stands behind the counter, customers at +Z.
local function rodStall(parent: Instance, ground: Vector3, face: number, rng: Random): Model
	local m = newModel("RodStall", parent)
	local base = CFrame.new(ground) * CFrame.Angles(0, face, 0)
	part(m, Vector3.new(9, 3, 3), base * CFrame.new(0, 1.5, 1.5), WOOD, M.WoodPlanks)
	part(m, Vector3.new(9.4, 0.3, 3.4), base * CFrame.new(0, 3.1, 1.5), WOOD_DARK, M.Wood)
	for _, c in { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } } do
		part(m, Vector3.new(0.5, 8, 0.5), base * CFrame.new(c[1] * 4.3, 4, c[2] * 2.5 + 0.5), WOOD_DARK, M.Wood)
	end
	local canopy = rgb(30, 30, 34)
	for i = 0, 4 do
		local stripe = if i % 2 == 0 then canopy else rgb(200, 40, 40)
		part(
			m,
			Vector3.new(2, 0.3, 7),
			base * CFrame.new(-4 + i * 2, 8.2, 0.5) * CFrame.Angles(0.18, 0, 0),
			stripe,
			M.Fabric
		)
	end
	-- Rack along the back with rods leaning on it, a few more laid on the counter.
	part(m, Vector3.new(8, 0.4, 0.4), base * CFrame.new(0, 5, -2.2), WOOD_DARK, M.Wood)
	local blanks = { rgb(160, 120, 70), rgb(40, 60, 58), rgb(120, 40, 34), rgb(200, 180, 120), rgb(60, 60, 64) }
	for k = 0, 6 do
		local x = -3.3 + k * 1.1
		local foot = base:PointToWorldSpace(Vector3.new(x, 0.2, -1.4))
		local tip = base:PointToWorldSpace(Vector3.new(x + rng:NextNumber(-0.3, 0.3), 7.6, -2.6))
		beam(m, foot, tip, 0.18, blanks[k % #blanks + 1], nil, M.Wood)
		part(m, Vector3.new(0.4, 0.4, 0.4), CFrame.new(foot:Lerp(tip, 0.18)), IRON, M.Metal)
	end
	for k = 0, 2 do
		local y = 3.35 + k * 0.01
		part(
			m,
			Vector3.new(7, 0.16, 0.16),
			base * CFrame.new(0, y, 0.8 + k * 0.6) * CFrame.Angles(0, rng:NextNumber(-0.08, 0.08), 0),
			blanks[k + 1],
			M.Wood
		)
	end
	Props.lantern(m, base * CFrame.new(-3.8, 6.6, 3.2))
	Props.barrel(m, base:PointToWorldSpace(Vector3.new(-5.8, 0, -1)), rng)
	return m
end

-- An iron cannon on a wooden carriage, its muzzle along the frame's -Z.
local function cannon(parent: Instance, frame: CFrame)
	local m = newModel("Cannon", parent)
	part(m, Vector3.new(2.4, 1, 4), frame * CFrame.new(0, 0.9, 0), WOOD, M.WoodPlanks)
	for _, side in { -1, 1 } do
		part(m, Vector3.new(0.4, 1.8, 3.4), frame * CFrame.new(side * 1.05, 1.6, 0.2), WOOD_DARK, M.Wood)
		for _, z in { -1.3, 1.3 } do
			local wheel = cylinder(m, (frame * CFrame.new(side * 1.4, 0.7, z)).Position, 0.4, 1.4, WOOD_DARK, M.Wood)
			wheel.CFrame = frame * CFrame.new(side * 1.4, 0.7, z)
		end
	end
	local barrel = part(
		m,
		Vector3.new(5.2, 1.2, 1.2),
		frame * CFrame.new(0, 2.2, -0.6) * CFrame.Angles(0.1, math.pi / 2, 0),
		IRON,
		M.Metal
	)
	barrel.Shape = Enum.PartType.Cylinder
	local muzzle = part(
		m,
		Vector3.new(0.5, 1.5, 1.5),
		frame * CFrame.new(0, 2.45, -3.1) * CFrame.Angles(0.1, math.pi / 2, 0),
		IRON,
		M.Metal
	)
	muzzle.Shape = Enum.PartType.Cylinder
	for k = 0, 2 do
		Props.ball(
			m,
			(frame * CFrame.new(1.8 + (k % 2) * 0.7, 0.4 + math.floor(k / 2) * 0.6, 1.6 - k * 0.35)).Position,
			0.75,
			IRON,
			M.Metal
		)
	end
end

-- A small rowboat pulled up on the sand, bow along `frame`'s -Z.
local function beachedBoat(parent: Instance, frame: CFrame, color: Color3)
	local m = newModel("BeachedBoat", parent)
	local tilt = frame * CFrame.Angles(0, 0, 0.12)
	part(m, Vector3.new(3.4, 0.4, 8), tilt * CFrame.new(0, 0.4, 0), WOOD_DARK, M.WoodPlanks)
	for _, side in { -1, 1 } do
		part(
			m,
			Vector3.new(0.3, 1.4, 8),
			tilt * CFrame.new(side * 1.75, 1, 0) * CFrame.Angles(0, 0, side * 0.25),
			color,
			M.WoodPlanks
		)
	end
	part(m, Vector3.new(3.4, 1.4, 0.3), tilt * CFrame.new(0, 1, 3.9), color, M.WoodPlanks)
	part(m, Vector3.new(1.2, 1.4, 0.3), tilt * CFrame.new(0, 1, -4.2), color, M.WoodPlanks)
	part(m, Vector3.new(3.2, 0.25, 1), tilt * CFrame.new(0, 1.2, 0.6), WOOD, M.Wood)
	beam(
		m,
		(tilt * CFrame.new(-1, 1.4, -1)).Position,
		(tilt * CFrame.new(1.6, 0.3, 4.5)).Position,
		0.2,
		WOOD,
		nil,
		M.Wood
	)
end

-- A broken-backed ship half sunk in the shallows: listing hull, snapped mast and a torn sail.
local function wreck(parent: Instance, frame: CFrame)
	local m = newModel("Shipwreck", parent)
	m:SetAttribute("LodColor", WOOD_DARK)
	local hull = frame * CFrame.Angles(0, 0, 0.42) * CFrame.Angles(0.12, 0, 0)
	local length, beamWidth = 46, 13
	part(m, Vector3.new(2, 2, length), hull * CFrame.new(0, -6, 0), WOOD_DARK, M.Wood)
	for _, side in { -1, 1 } do
		for row = 0, 4 do
			local y = -5 + row * 1.9
			local spread = beamWidth / 2 * (0.55 + row * 0.11)
			-- Planking stops short where the hull is stove in on the low side.
			local run = if side == -1 and row >= 2 then length * 0.55 else length
			local shift = if side == -1 and row >= 2 then -length * 0.2 else 0
			part(
				m,
				Vector3.new(0.6, 2, run),
				hull * CFrame.new(side * spread, y, shift) * CFrame.Angles(0, 0, side * -0.18),
				WOOD,
				M.WoodPlanks
			)
		end
	end
	-- Ribs show through the gap.
	for k = 0, 4 do
		beam(
			m,
			(hull * CFrame.new(-3, -5.5, 4 + k * 3)).Position,
			(hull * CFrame.new(-6.6, 3, 4 + k * 3)).Position,
			0.6,
			WOOD_DARK,
			nil,
			M.Wood
		)
	end
	part(
		m,
		Vector3.new(beamWidth - 1, 0.6, length * 0.5),
		hull * CFrame.new(0, 3.6, -length * 0.22),
		WOOD,
		M.WoodPlanks
	)
	part(m, Vector3.new(beamWidth * 0.7, 3, 7), hull * CFrame.new(0, 5.6, -length * 0.4), WOOD_DARK, M.WoodPlanks)
	local foot = hull * CFrame.new(0, 3.8, -2)
	local top = foot * CFrame.Angles(0.5, 0, 0.2) * CFrame.new(0, 16, 0)
	beam(m, foot.Position, top.Position, 1.1, WOOD_DARK, nil, M.Wood)
	beam(
		m,
		(foot * CFrame.Angles(0.5, 0, 0.2) * CFrame.new(-6, 11, 0)).Position,
		(foot * CFrame.Angles(0.5, 0, 0.2) * CFrame.new(6, 11, 0)).Position,
		0.6,
		WOOD_DARK,
		nil,
		M.Wood
	)
	local sail = part(
		m,
		Vector3.new(10, 7, 0.15),
		foot * CFrame.Angles(0.5, 0, 0.2) * CFrame.new(-1, 7.4, 0.5) * CFrame.Angles(0.15, 0.1, -0.08),
		SAIL,
		M.Fabric
	)
	sail.CanCollide = false
	part(m, Vector3.new(0.2, 3, 0.2), top * CFrame.new(0, 1.5, 0), WOOD_DARK, M.Wood)
	part(m, Vector3.new(0.1, 1.6, 2.4), top * CFrame.new(0, 2.2, 1.2), rgb(20, 20, 22), M.Fabric).CanCollide = false
	Props.barrel(m, (hull * CFrame.new(2, 3.9, -length * 0.15)).Position, Random.new(4))
end

-- A ring of posts round the plaza with lanterns on top and festoon lights between them.
local function plazaLights(parent: Instance, surface: (number, number) -> Vector3, rng: Random)
	local m = newModel("PlazaLights", parent)
	local tops = {}
	for k = 0, 7 do
		local angle = (k + 0.5) / 8 * TAU
		local ground = surface(math.cos(angle) * 24, math.sin(angle) * 24)
		part(m, Vector3.new(0.6, 8, 0.6), CFrame.new(ground + Vector3.new(0, 4, 0)), WOOD_DARK, M.Wood)
		Props.lantern(m, CFrame.new(ground + Vector3.new(0, 8.8, 0)))
		table.insert(tops, ground + Vector3.new(0, 7.6, 0))
	end
	for k = 1, #tops do
		Props.stringLights(m, tops[k], tops[k % #tops + 1], rng, 1.6)
	end
end

----------------------------------------------------------------------------------------------------

function Cove.build(root: Instance): Model
	local existing = root:FindFirstChild(Data.NAME)
	if existing and existing:IsA("Model") and existing:GetAttribute("CoveVersion") == Cove.VERSION then
		return existing
	end
	local lodId = existing and existing:GetAttribute("LodId")
	if existing then
		existing:Destroy()
	end
	clearSite(root)
	-- Built after players are in (and on every start until a map with this version is saved): yield
	-- between the heavy parts so the build stays inside the ~10 s script timeout.
	local resumed = os.clock()
	local function pause()
		if os.clock() - resumed > 0.05 then
			task.wait()
			resumed = os.clock()
		end
	end
	local rng = Random.new(Biomes.Seed + 4077)
	local seaFloor = Biomes.Tropical.shelfDepth or Biomes.SeaFloor

	local island = Islands.build({
		position = Vector2.new(CENTER.X, CENTER.Z),
		radius = Data.RADIUS,
		height = HEIGHT,
		shape = "plateau",
		palette = PALETTE,
		rng = rng,
		seaFloor = seaFloor,
		shoreLine = 3,
		elongation = 0.12,
		roughness = 0.14,
	})
	island.Name = Data.NAME
	island:SetAttribute("CoveVersion", Cove.VERSION)
	-- Streams and draws a distant shell like an island, but added after the bake (see Map/Lod)
	island:SetAttribute("LodRoot", true)
	island:SetAttribute("LodRadial", true)
	island:SetAttribute("LodStamp", "cove" .. Cove.VERSION)
	if lodId ~= nil then
		island:SetAttribute("LodId", lodId)
	end
	pause()
	-- The headland: a rocky stack on the north-west shore that shelters the pier.
	local headland = Islands.build({
		position = Vector2.new(CENTER.X - 128, CENTER.Z - 92),
		radius = 46,
		height = 38,
		shape = "stack",
		palette = ROCK,
		rng = rng,
		seaFloor = seaFloor,
		roughness = 0.35,
	})
	local ground = island:FindFirstChild("Ground") :: Model
	for _, piece in (headland:FindFirstChild("Ground") :: Model):GetChildren() do
		piece.Parent = ground
	end
	headland:Destroy()
	pause()

	-- Split into streaming pieces before the first replication; props added below are split as they go in.
	Lod.prepareIsland(island)
	island.Parent = root

	local function surface(x: number, z: number): Vector3
		local hit = Islands.surface(island, CENTER.X + x, CENTER.Z + z)
		return hit or world(x, HEIGHT)
	end
	local plaza = surface(0, 0)
	local anchors = {}
	local taken: { { number } } = {}
	local function claim(x: number, z: number, radius: number)
		table.insert(taken, { x, z, radius })
	end
	local function free(x: number, z: number, radius: number): boolean
		for _, t in taken do
			if (Vector2.new(t[1], t[2]) - Vector2.new(x, z)).Magnitude < t[3] + radius then
				return false
			end
		end
		return true
	end

	pause()
	-- Plaza: the flag, lights and a signpost.
	local town = newModel("Town", island)
	jollyRoger(town, plaza)
	claim(0, 0, 4)
	plazaLights(town, surface, rng)
	Props.signpost(town, surface(-6, -6), 0, {
		{ "Pier", 1.37 },
		{ "Galley", 0.3 },
		{ "Rods", 2.57 },
		{ "Tavern", -1.41 },
	})
	claim(-6, -6, 2)

	-- Market stalls facing the plaza: the galley buys fish, the rod trader sells rods.
	for _, stall in { { id = "BuyerStall", x = 17, z = -13 }, { id = "RodStall", x = -17, z = -13 } } do
		local ground = surface(stall.x, stall.z)
		local face = facing(ground, Vector3.new(plaza.X, ground.Y, plaza.Z))
		local model = if stall.id == "BuyerStall"
			then Props.stall(town, ground, face, rng, CANOPIES[1])
			else rodStall(town, ground, face, rng)
		model.Name = stall.id
		local base = CFrame.new(ground) * CFrame.Angles(0, face, 0)
		-- Behind the counter, looking out over it at the plaza.
		local stand = base * CFrame.new(0, 0, -1.1)
		anchors[stall.id] = CFrame.lookAt(stand.Position, stand.Position + base.LookVector * -1)
		claim(stall.x, stall.z, 7)
	end

	-- The tavern closes the plaza on the south; shacks ring the rest.
	local tavernGround = surface(0, 32)
	local tavern = Props.house(town, tavernGround, facing(tavernGround, plaza), rng, WALLS[1], THATCH)
	tavern.Name = "Tavern"
	Props.simplifyHouseCollision(tavern)
	claim(0, 32, 10)
	Props.barrel(town, surface(-8, 23), rng)
	Props.barrel(town, surface(-9.5, 24.5), rng)
	Props.bench(town, surface(10, 25), math.pi)
	for i, spot in { { -38, 6 }, { 38, 4 }, { -31, 34 }, { 31, 35 }, { 62, 30 }, { -62, 32 } } do
		local ground = surface(spot[1], spot[2])
		local house = Props.house(town, ground, facing(ground, plaza), rng, WALLS[(i % #WALLS) + 1], THATCH)
		house.Name = "Shack"
		Props.simplifyHouseCollision(house)
		claim(spot[1], spot[2], 10)
	end
	claim(7, 18, 3) -- the cook
	claim(0, 9, 3) -- the captain

	-- Cannons on the north-west bluff, looking out to sea, with the navigator's chart table.
	for _, spot in { { -50, -27 }, { -38, -31 }, { -62, -20 } } do
		local ground = surface(spot[1], spot[2])
		local out = Vector3.new(ground.X - 40, ground.Y, ground.Z - 40)
		cannon(town, CFrame.lookAt(ground, out))
		claim(spot[1], spot[2], 3)
	end
	local tableGround = surface(-46, -14)
	part(
		town,
		Vector3.new(4, 0.3, 2.6),
		CFrame.new(tableGround + Vector3.new(0, 2.6, 0)) * CFrame.Angles(0, 0.4, 0),
		WOOD,
		M.WoodPlanks
	)
	part(
		town,
		Vector3.new(3, 0.05, 2),
		CFrame.new(tableGround + Vector3.new(0, 2.78, 0)) * CFrame.Angles(0, 0.5, 0),
		rgb(226, 206, 160),
		M.Fabric
	)
	cylinder(town, tableGround + Vector3.new(0, 1.25, 0), 2.5, 0.6, WOOD_DARK, M.Wood)
	claim(-46, -14, 3)
	claim(-42, -18, 3)

	-- The pearl diver's corner: a drying rack, crates and barrels.
	Props.fishRack(town, surface(52, -12), 0.6, rng)
	Props.crates(town, surface(48, -28), rng)
	Props.barrel(town, surface(56, -24), rng)
	claim(52, -12, 5)
	claim(44, -20, 3)
	claim(52, -27, 4)
	-- The cabin boy's pile of loot.
	Props.crates(town, surface(-15, -27), rng)
	Props.barrel(town, surface(-4, -30), rng)
	claim(-9, -24, 3)
	claim(-14, -28, 4)

	-- The pier, from the north beach out towards home.
	local pierX = 4
	local shoreZ = -60
	for z = -60, -Data.RADIUS * 1.2, -2 do
		shoreZ = z
		if surface(pierX, z).Y < 2.4 then
			break
		end
	end
	local pierStart = world(pierX, shoreZ + 2)
	local pierEnd = Props.dock(town, pierStart, Vector3.new(0, 0, -1), PIER_LENGTH, rng)
	local stand = Vector3.new(pierStart.X - 2.2, 3.3, pierStart.Z - 12)
	anchors.Pier = CFrame.lookAt(stand, Vector3.new(stand.X, stand.Y, stand.Z + 10))
	-- The old ghost keeps watch at the far end of the pier, looking back towards the island.
	local ghost = Vector3.new(pierEnd.X - 2.2, 3.3, pierEnd.Z)
	anchors.Dreadbeard = CFrame.lookAt(ghost, Vector3.new(ghost.X, ghost.Y, ghost.Z + 10))
	Props.signpost(town, Vector3.new(pierStart.X + 4.6, 3.3, pierStart.Z - 3), 0, {
		{ Data.NAME, -math.pi / 2 },
		{ "Gullhaven", 1.28 },
	})
	Props.lifeRing(town, CFrame.new(pierEnd + Vector3.new(3.9, 0.8, 0)) * CFrame.Angles(0, math.pi / 2, 0))
	for k = 0, 3 do
		claim(pierX, shoreZ + 4 - k * 8, 6)
	end
	-- A path of planks from the plaza down to the pier.
	local prev = surface(pierX, -24)
	for z = -28, shoreZ + 8, -4 do
		local ground = surface(pierX, z)
		part(
			town,
			Vector3.new(4, 0.3, 4.4),
			CFrame.lookAt((prev + ground) / 2, ground) + Vector3.new(0, 0.15, 0),
			WOOD,
			M.WoodPlanks
		)
		prev = ground
	end
	for z = -24, shoreZ + 8, -4 do
		claim(pierX, z, 3)
	end

	-- Palms and bushes round the town and down to the beach; driftwood, shells and boats on the sand.
	local nature = newModel("Nature", island)
	local bushes = { rgb(70, 140, 60), rgb(90, 160, 70), rgb(60, 120, 64) }
	local planted = 0
	for _ = 1, 600 do
		if planted >= 70 then
			break
		end
		pause()
		local a = rng:NextNumber(0, TAU)
		local d = rng:NextNumber(32, Data.RADIUS * 0.82)
		local x, z = math.cos(a) * d, math.sin(a) * d
		local hit, normal = Islands.surface(island, CENTER.X + x, CENTER.Z + z)
		if hit and normal and hit.Y > 1.4 and normal.Y > 0.85 and free(x, z, 5) then
			claim(x, z, 5)
			planted += 1
			if rng:NextNumber() < 0.7 then
				Props.palm(nature, hit, rng)
			else
				Props.simplifyDecorationCollision(Props.bush(nature, hit, rng, bushes))
			end
		end
	end
	local scattered = 0
	for _ = 1, 400 do
		if scattered >= 28 then
			break
		end
		pause()
		local a = rng:NextNumber(0, TAU)
		local d = rng:NextNumber(Data.RADIUS * 0.66, Data.RADIUS * 0.86)
		local x, z = math.cos(a) * d, math.sin(a) * d
		local hit, normal = Islands.surface(island, CENTER.X + x, CENTER.Z + z)
		if hit and normal and hit.Y > 0.4 and hit.Y < 4 and normal.Y > 0.9 and free(x, z, 3) then
			claim(x, z, 3)
			scattered += 1
			local roll = rng:NextNumber()
			if roll < 0.4 then
				Props.driftwood(nature, hit, rng)
			elseif roll < 0.75 then
				Props.shells(nature, hit, rng)
			elseif roll < 0.9 then
				Props.barrel(nature, hit, rng)
			else
				Props.crates(nature, hit, rng)
			end
		end
	end
	for k, spot in { { 26, -118 }, { -24, -112 } } do
		local hit = surface(spot[1], spot[2])
		beachedBoat(
			nature,
			CFrame.lookAt(hit, hit + Vector3.new(-spot[1], 0, -spot[2]) * -1) * CFrame.new(0, -0.3, 0),
			CANOPIES[k + 1]
		)
	end

	pause()
	-- The wreck in the shallows off the north-east shore.
	wreck(island, CFrame.new(world(150, -150)) * CFrame.Angles(0, 0.7, 0))

	-- Where the crew stand: named anchors for the stalls and the pier, plus the plaza for facing.
	for id, frame in anchors do
		island:SetAttribute("Anchor_" .. id, frame)
	end
	island:SetAttribute("Plaza", plaza)
	return island
end

return Cove
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="239">
          <Properties>
            <string name="Name">PlazaHouses</string>
            <string name="Source"><![CDATA[-- Rows of detailed two-tone townhouses closing in the piazza on its west, north and east sides:
-- a coloured ground floor under a contrasting upper storey, quoins, string courses, rafter tails
-- under the eaves, shuttered arched windows, balconies, wall lanterns, climbing ivy and clutter.
-- The rod store uses the same builder. The rows are placed after the village so they can clear
-- ordinary houses and trees off their plots; any plot that would cover a street is left empty.

local Med = require(script.Parent.Mediterranean)
local Props = require(script.Parent.Props)

local PlazaHouses = {}

local LAYOUT_VERSION = 2
local TAU = math.pi * 2
local rgb = Color3.fromRGB
local M = Enum.Material
local part, beam, pick = Props.part, Props.beam, Props.pick

local STORY = 10
local FLOOR = 0.8
local STONE = rgb(214, 200, 172)
local QUOIN = rgb(196, 182, 156)
local WOOD = rgb(112, 80, 54)
local IRON = rgb(44, 42, 40)
local CREAM = rgb(255, 240, 205)
local LEAVES = { rgb(70, 132, 52), rgb(92, 152, 60), rgb(58, 112, 46), rgb(110, 164, 70) }

local LOWER = {
	rgb(226, 126, 70),
	rgb(240, 182, 66),
	rgb(244, 230, 200),
	rgb(206, 104, 72),
	rgb(236, 160, 96),
}
local UPPER = {
	rgb(244, 234, 210),
	rgb(92, 150, 202),
	rgb(240, 196, 92),
	rgb(108, 168, 170),
	rgb(234, 214, 176),
}
local SHUTTERS = { rgb(48, 112, 116), rgb(70, 120, 66), rgb(130, 82, 54), rgb(44, 86, 140), rgb(64, 140, 120) }
local ROOFS = { rgb(170, 84, 52), rgb(152, 72, 46), rgb(186, 100, 62) }
local DOORS = { rgb(170, 78, 54), rgb(142, 64, 44), rgb(70, 120, 66), rgb(60, 98, 130) }
local AWNINGS = { rgb(180, 52, 44), rgb(36, 92, 168), rgb(56, 120, 70), rgb(214, 160, 50) }
local SHOPS = { "Bakery", "Taverna", "Bait & Tackle", "Fishmonger", "Gelato", "Net Mender", "Chandlery", "Caffè" }

export type Spec = {
	width: number,
	depth: number,
	stories: number,
	lower: Color3,
	upper: Color3,
	trim: Color3,
	shutter: Color3,
	roof: Color3,
	door: Color3,
	balcony: boolean,
	shop: string?, -- shopfront window and awning, with this name on the board above
	blade: string?, -- a sign hung from an iron bracket beside the door
	signColor: Color3?,
	doorSide: number?, -- which end of a shopfront the door takes: 1 is +X (the default), -1 is -X
}

local function boardText(board: BasePart, value: string, face: Enum.NormalId, color: Color3?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = color or CREAM
	label.Text = value
	label.Parent = gui
end
PlazaHouses.boardText = boardText

-- Frame on the outer surface of one wall; side 0 is the front (+Z), 1 is +X, 2 the back, 3 is -X.
local function wallFace(base: CFrame, w: number, d: number, side: number, y: number): (CFrame, number)
	local outward = if side % 2 == 0 then d / 2 else w / 2
	return base * CFrame.Angles(0, side * math.pi / 2, 0) * CFrame.new(0, y, outward), if side % 2 == 0 then w else d
end

-- Ivy climbing a wall from the ground: a wandering stem with leaves either side, spreading near the top.
local function ivy(m: Model, face: CFrame, x: number, height: number, rng: Random)
	local stem = Vector3.new(x, 0.2, 0.18)
	local y = 0.2
	while y < height do
		local spread = 1 + y / height * 1.4
		local nextStem = Vector3.new(stem.X + rng:NextNumber(-0.7, 0.7), y + 1.1, 0.18)
		beam(m, face * stem, face * nextStem, 0.18, rgb(84, 70, 48), nil, M.Wood).CanCollide = false
		for _ = 1, 2 do
			local leaf = part(
				m,
				Vector3.new(rng:NextNumber(0.8, 1.6), rng:NextNumber(0.6, 1.2), 0.2),
				face
					* CFrame.new(stem.X + rng:NextNumber(-1, 1) * spread, y + rng:NextNumber(0, 1), 0.22)
					* CFrame.Angles(0, 0, rng:NextNumber(0, TAU)),
				pick(rng, LEAVES),
				M.LeafyGrass
			)
			leaf.CanCollide = false
			leaf.CastShadow = false
		end
		stem = nextStem
		y += 1.1
	end
end

-- Lantern hanging from an iron bracket on a wall; `face` is the fixing point.
local function wallLantern(m: Model, face: CFrame)
	part(m, Vector3.new(0.5, 0.8, 0.2), face * CFrame.new(0, 0, 0.1), IRON, M.Metal)
	part(m, Vector3.new(0.18, 0.18, 1.5), face * CFrame.new(0, 0.2, 0.75), IRON, M.Metal).CanCollide = false
	beam(m, face * Vector3.new(0, -0.4, 0.15), face * Vector3.new(0, 0.2, 1.1), 0.12, IRON, nil, M.Metal).CanCollide =
		false
	local lantern = Props.lantern(m, face * CFrame.new(0, -1.5, 1.3))
	for _, piece in lantern:GetChildren() do
		if piece:IsA("BasePart") then
			piece.CanCollide = false
		end
	end
end

-- Shopfront: a gridded window glowing with lamplight, a striped awning and a name board.
local function shopfront(m: Model, front: CFrame, x: number, width: number, spec: Spec, rng: Random)
	local frame, awning = spec.shutter, pick(rng, AWNINGS)
	part(m, Vector3.new(width + 1, 5.8, 0.16), front * CFrame.new(x, FLOOR + 3.6, 0.08), frame, M.Wood)
	local glass =
		part(m, Vector3.new(width, 4.8, 0.2), front * CFrame.new(x, FLOOR + 3.7, 0.14), rgb(255, 214, 150), M.Neon)
	Props.light(glass, rgb(255, 214, 150), 18, 0.8)
	local panes = math.max(2, math.floor(width / 1.6))
	for i = 1, panes - 1 do
		part(
			m,
			Vector3.new(0.14, 4.8, 0.3),
			front * CFrame.new(x - width / 2 + i * width / panes, FLOOR + 3.7, 0.3),
			frame,
			M.Wood
		)
	end
	part(m, Vector3.new(width, 0.14, 0.3), front * CFrame.new(x, FLOOR + 4.7, 0.3), frame, M.Wood)
	part(m, Vector3.new(width + 1.4, 0.5, 1.2), front * CFrame.new(x, FLOOR + 1, 0.55), WOOD, M.WoodPlanks)
	local strips = math.max(4, math.floor(width / 1.3))
	for i = 0, strips - 1 do
		part(
			m,
			Vector3.new(width / strips + 0.02, 0.2, 3.4),
			front * CFrame.new(x - width / 2 + (i + 0.5) * width / strips, FLOOR + 7, 1.55) * CFrame.Angles(0.38, 0, 0),
			if i % 2 == 0 then awning else CREAM,
			M.Fabric
		).CanCollide =
			false
	end
	local board =
		part(m, Vector3.new(width * 0.85, 1.3, 0.3), front * CFrame.new(x, FLOOR + 8.4, 0.18), frame, M.WoodPlanks)
	boardText(board, spec.shop :: string, Enum.NormalId.Back, spec.signColor)
end

-- A sign on an iron arm sticking out from the wall, readable from both directions along the street.
local function bladeSign(m: Model, face: CFrame, text: string, color: Color3?)
	part(m, Vector3.new(0.3, 0.3, 3.2), face * CFrame.new(0, 0, 1.6), IRON, M.Metal).CanCollide = false
	beam(m, face * Vector3.new(0, -1.2, 0.1), face * Vector3.new(0, 0, 2.2), 0.16, IRON, nil, M.Metal).CanCollide =
		false
	for _, z in { 0.9, 2.7 } do
		part(m, Vector3.new(0.1, 0.5, 0.1), face * CFrame.new(0, -0.35, z), IRON, M.Metal).CanCollide = false
	end
	local board = part(m, Vector3.new(0.25, 1.6, 2.6), face * CFrame.new(0, -1.4, 1.8), WOOD, M.WoodPlanks)
	board.CanCollide = false
	boardText(board, text, Enum.NormalId.Right, color)
	boardText(board, text, Enum.NormalId.Left, color)
end

-- One townhouse standing on `base` (ground level, front on local +Z). Returns the model and the
-- frame at the foot of its front door, with +Z pointing out into the street.
function PlazaHouses.house(parent: Instance, base: CFrame, spec: Spec, rng: Random): (Model, CFrame, BasePart)
	local m = Instance.new("Model")
	m.Name = "PlazaHouse"
	m.Parent = parent
	local w, d, stories = spec.width, spec.depth, spec.stories
	local h = stories * STORY
	local top = FLOOR + h

	-- A plinth deep enough to meet uneven ground, then the two-tone walls
	part(m, Vector3.new(w + 0.8, 4, d + 0.8), base * CFrame.new(0, FLOOR - 2, 0), STONE, M.Limestone)
	part(m, Vector3.new(w, STORY, d), base * CFrame.new(0, FLOOR + STORY / 2, 0), spec.lower, M.Plaster)
	if stories > 1 then
		part(
			m,
			Vector3.new(w, h - STORY, d),
			base * CFrame.new(0, FLOOR + STORY + (h - STORY) / 2, 0),
			spec.upper,
			M.Plaster
		)
	end
	for s = 1, stories - 1 do
		part(m, Vector3.new(w + 0.7, 0.55, d + 0.7), base * CFrame.new(0, FLOOR + s * STORY, 0), spec.trim, M.Plaster)
		part(
			m,
			Vector3.new(w + 0.35, 0.25, d + 0.35),
			base * CFrame.new(0, FLOOR + s * STORY - 0.4, 0),
			spec.trim,
			M.Plaster
		)
	end
	-- Rusticated quoins on the ground-floor corners
	for _, cx in { -1, 1 } do
		for _, cz in { -1, 1 } do
			for k = 0, 3 do
				local a = if k % 2 == 0 then 1.5 else 1.1
				part(
					m,
					Vector3.new(a, 1.9, a),
					base * CFrame.new(cx * (w / 2 - a / 2 + 0.15), FLOOR + 1.2 + k * 2.1, cz * (d / 2 - a / 2 + 0.15)),
					QUOIN,
					M.Limestone
				)
			end
		end
	end

	-- Cornice, rafter tails under the eaves, tiled roof and a chimney
	part(m, Vector3.new(w + 1.2, 0.8, d + 1.2), base * CFrame.new(0, top + 0.4, 0), spec.trim, M.Plaster)
	for _, z in { -1, 1 } do
		for x = -w / 2 + 1, w / 2 - 0.9, 1.8 do
			part(m, Vector3.new(0.4, 0.4, 1.5), base * CFrame.new(x, top - 0.1, z * (d / 2 + 0.75)), WOOD, M.Wood).CanCollide =
				false
		end
	end
	local rise = Med.gableRoof(m, base, w, d, top + 0.8, math.rad(rng:NextNumber(20, 25)), spec.roof, spec.upper)
	local chimneyX = (if rng:NextNumber() < 0.5 then -1 else 1) * w * 0.28
	local stackH = rise / 2 + 3
	part(
		m,
		Vector3.new(1.8, stackH, 1.8),
		base * CFrame.new(chimneyX, top + 0.8 + stackH / 2, -d / 4),
		spec.trim,
		M.Plaster
	)
	part(
		m,
		Vector3.new(2.4, 0.4, 2.4),
		base * CFrame.new(chimneyX, top + 0.8 + stackH + 0.2, -d / 4),
		spec.trim,
		M.Plaster
	)

	-- Front: door, shopfront or windows on the ground floor; a balcony and windows above
	local front = wallFace(base, w, d, 0, 0)
	local doorSide = spec.doorSide or 1
	local doorX = if spec.shop
		then doorSide * (w / 2 - 3.8)
		else (if rng:NextNumber() < 0.5 then -1 else 1) * rng:NextNumber(0, w / 6)
	local doorFace = front * CFrame.new(doorX, FLOOR, 0)
	local leaf = Med.door(m, doorFace, 3.4, 6.6, spec.door, spec.trim, true)
	local n = math.max(2, math.floor(w / 6))
	local windowW, windowH = 2.6, 3.8
	local lit = false
	local function addWindow(at: CFrame, upper: boolean)
		local glow = rng:NextNumber() < 0.3
		local glass = Med.window(m, at, windowW, windowH, spec.trim, spec.shutter, true, glow)
		if glow and not lit then
			Props.light(glass, rgb(255, 210, 140), 18, 0.7)
			lit = true
		end
		if upper and rng:NextNumber() < 0.4 then
			Med.flowerBox(m, at * CFrame.new(0, -windowH / 2 - 0.9, 0), windowW + 0.6, rng)
		end
	end
	if spec.shop then
		shopfront(m, front, -2.4 * doorSide, w - 9, spec, rng)
	else
		for i = 1, n do
			local x = (i - (n + 1) / 2) * (w - 6) / n
			if math.abs(x - doorX) > 5.5 then
				addWindow(front * CFrame.new(x, FLOOR + STORY * 0.5, 0), false)
			end
		end
	end
	local balconyX = if spec.balcony then (if spec.shop then 0 else doorX) else nil
	for s = 2, stories do
		local y = FLOOR + (s - 1) * STORY
		if s == 2 and balconyX then
			local sill = front * CFrame.new(balconyX, y + 0.3, 0)
			Med.door(m, sill, 3, 6.4, spec.shutter, spec.trim, true)
			Med.balcony(m, sill, 9, 2.4, spec.trim)
			for _, side in { -1, 1 } do
				part(m, Vector3.new(0.8, 1.6, 1.8), sill * CFrame.new(side * 3.6, -1.1, 0.9), spec.trim, M.Plaster)
			end
			Med.pot(m, sill:PointToWorldSpace(Vector3.new(-3.4, 0, 1.2)), rng, "flowers")
		end
		for i = 1, n do
			local x = (i - (n + 1) / 2) * (w - 6) / n
			if not (s == 2 and balconyX and math.abs(x - balconyX) < 7.8) then
				addWindow(front * CFrame.new(x, y + STORY * 0.5, 0), true)
			end
		end
	end

	-- Sides and back carry fewer windows, some left blank
	for side = 1, 3 do
		local face, width = wallFace(base, w, d, side, 0)
		local count = math.max(1, math.floor(width / 7))
		for s = 1, stories do
			for i = 1, count do
				if rng:NextNumber() < 0.35 then
					continue
				end
				local x = (i - (count + 1) / 2) * (width - 6) / count
				addWindow(face * CFrame.new(x, FLOOR + (s - 1) * STORY + STORY * 0.5, 0), s > 1)
			end
		end
	end

	-- Street details: lanterns either side of the door, ivy, a sign, pots and barrels on the step
	for _, side in { -1, 1 } do
		-- On a shop the awning takes the place of the lantern nearer the window
		if math.abs(doorX + side * 2.9) < w / 2 - 1 and not (spec.shop and side ~= doorSide) then
			wallLantern(m, doorFace * CFrame.new(side * 2.9, 8.4, 0))
		end
	end
	local ivyX = if doorX > 0 then -w / 2 + rng:NextNumber(1.5, 3) else w / 2 - rng:NextNumber(1.5, 3)
	ivy(m, front, ivyX, math.min(h, STORY * 1.6) + rng:NextNumber(-2, 2), rng)
	if rng:NextNumber() < 0.5 then
		local sideFace = wallFace(base, w, d, if ivyX > 0 then 1 else 3, 0)
		ivy(m, sideFace, (if ivyX > 0 then 1 else -1) * (d / 2 - 2), h * 0.8, rng)
	end
	if spec.blade then
		local bladeX = if doorX > 0 then -w / 2 + 0.8 else w / 2 - 0.8
		bladeSign(m, front * CFrame.new(bladeX, FLOOR + 9.2, 0), spec.blade :: string, spec.signColor)
	end
	-- Kept to a narrow strip by the wall, so nothing spills onto the kerb of the square
	local street = base * CFrame.new(0, 0, d / 2 + 1.6)
	for _ = 1, rng:NextInteger(1, 3) do
		local x = rng:NextNumber(-w / 2 + 1.5, w / 2 - 1.5)
		if math.abs(x - doorX) < 3.5 or (spec.shop and x * doorSide < w / 2 - 6) then
			continue
		end
		local roll = rng:NextNumber()
		local at = street:PointToWorldSpace(Vector3.new(x, 0, rng:NextNumber(-0.4, 0.2)))
		if roll < 0.45 then
			Props.barrel(m, at, rng)
		else
			Med.pot(m, at, rng, if roll < 0.75 then "flowers" else "lemon")
		end
	end
	Props.simplifyHouseCollision(m)
	return m, doorFace, leaf
end

-- A random member of the plaza family, so the rows read as one street of individual houses.
function PlazaHouses.spec(rng: Random, width: number, depth: number, stories: number): Spec
	local lower = pick(rng, LOWER)
	local upper = pick(rng, UPPER)
	if upper == lower then
		upper = UPPER[1]
	end
	local shop = if rng:NextNumber() < 0.3 then pick(rng, SHOPS) else nil
	return {
		width = width,
		depth = depth,
		stories = stories,
		lower = lower,
		upper = upper,
		trim = rgb(248, 240, 222),
		shutter = pick(rng, SHUTTERS),
		roof = pick(rng, ROOFS),
		door = pick(rng, DOORS),
		balcony = stories > 1 and rng:NextNumber() < 0.6,
		shop = shop,
		blade = if shop == nil and rng:NextNumber() < 0.2 then pick(rng, SHOPS) else nil,
	}
end

----------------------------------------------------------------------------------------------------
-- Placement round the piazza

-- Plots in paving coordinates (the square runs to ±60), each { x, z, facing, width, stories }.
-- Width runs along the row; every house is 16 deep and fronts onto the square.
local DEPTH = 16
local function plots(): { { number } }
	local list = {}
	local function row(
		fixed: number,
		from: number,
		widths: { number },
		facing: number,
		axis: string,
		stories: { number }
	)
		local at = from
		for i, width in widths do
			local middle = at + width / 2
			if axis == "z" then
				table.insert(list, { fixed, middle, facing, width, stories[i] })
			else
				table.insert(list, { middle, fixed, facing, width, stories[i] })
			end
			at += width
		end
	end
	-- West and east rows run from the north corner toward the bay; the north row closes the top.
	row(-72, -60, { 18, 16, 18, 16, 14 }, math.pi / 2, "z", { 3, 2, 3, 2, 2 })
	row(72, -60, { 16, 18, 16, 18, 14 }, -math.pi / 2, "z", { 2, 3, 2, 3, 2 })
	row(-72, -80, { 18, 18, 18, 16, 20, 16, 18, 18, 18 }, 0, "x", { 3, 2, 3, 2, 3, 3, 2, 3, 2 })
	return list
end

-- Conservative overlap: the bounds of `item` measured in the footprint box's own space.
local function overlaps(footprint: CFrame, half: Vector3, item: BasePart): boolean
	local low = Vector3.new(math.huge, math.huge, math.huge)
	local high = -low
	for _, x in { -0.5, 0.5 } do
		for _, y in { -0.5, 0.5 } do
			for _, z in { -0.5, 0.5 } do
				local p = footprint:PointToObjectSpace(
					item.CFrame * Vector3.new(item.Size.X * x, item.Size.Y * y, item.Size.Z * z)
				)
				low, high = low:Min(p), high:Max(p)
			end
		end
	end
	return low.X < half.X
		and high.X > -half.X
		and low.Y < half.Y
		and high.Y > -half.Y
		and low.Z < half.Z
		and high.Z > -half.Z
end

-- The highest ground under a plot's corners, so a house never sinks into a rising slope.
local function groundUnder(island: Instance?, frame: CFrame, w: number, d: number, fallback: number): number
	local groundModel = island and island:FindFirstChild("Ground")
	if not groundModel then
		return fallback
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { groundModel }
	local best = fallback
	for _, c in { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } } do
		local p = frame:PointToWorldSpace(Vector3.new(c[1] * w / 2, 0, c[2] * d / 2))
		local hit = workspace:Raycast(p + Vector3.new(0, 60, 0), Vector3.new(0, -120, 0), params)
		if hit then
			best = math.max(best, hit.Position.Y)
		end
	end
	return math.min(best, fallback + 3)
end

-- pavingFrame is the top of the paving at the centre of the square.
function PlazaHouses.build(plaza: Model, pavingFrame: CFrame): Model
	local existing = plaza:FindFirstChild("PlazaHouses")
	if existing and existing:GetAttribute("LayoutVersion") == LAYOUT_VERSION then
		return existing
	elseif existing then
		existing:Destroy()
	end
	local model = Instance.new("Model")
	model.Name = "PlazaHouses"
	model:SetAttribute("LayoutVersion", LAYOUT_VERSION)

	local village = plaza.Parent
	local island = village and village.Parent
	-- Streets, paths, beach, bases and the square itself block a plot. Generated houses and trees
	-- are cleared off it instead.
	local clearable: { Instance } = {}
	for _, name in { "Houses" } do
		local folder = village and village:FindFirstChild(name)
		if folder then
			table.insert(clearable, folder)
		end
	end
	for _, name in { "Hilltops", "Forest" } do
		local folder = island and island:FindFirstChild(name)
		if folder then
			table.insert(clearable, folder)
		end
	end
	local center = pavingFrame.Position
	local blocking, removable = {}, {}
	local function near(item: BasePart): boolean
		local offset = item.Position - center
		return Vector2.new(offset.X, offset.Z).Magnitude < 150 + item.Size.Magnitude / 2
	end
	if village then
		for _, item in village:GetDescendants() do
			if item:IsA("BasePart") and near(item) then
				local owner = nil
				for _, folder in clearable do
					if item:IsDescendantOf(folder) then
						owner = folder
						break
					end
				end
				if owner then
					-- Remove the whole prop (a house, lamp or tree), not just the overlapping part
					local target: Instance = item
					while target.Parent and target.Parent ~= owner do
						target = target.Parent
					end
					table.insert(removable, { item, target })
				else
					table.insert(blocking, item)
				end
			end
		end
	end
	for _, folder in clearable do
		if not folder:IsDescendantOf(village :: Instance) then
			for _, item in folder:GetDescendants() do
				if item:IsA("BasePart") and near(item) then
					local target: Instance = item
					while target.Parent and target.Parent ~= folder do
						target = target.Parent
					end
					table.insert(removable, { item, target })
				end
			end
		end
	end
	local bases = island and island:FindFirstChild("Bases")
	if bases then
		for _, item in bases:GetDescendants() do
			if item:IsA("BasePart") and near(item) then
				table.insert(blocking, item)
			end
		end
	end

	local rng = Random.new(7311)
	local groundY = center.Y - 0.8
	for index, plot in plots() do
		local x, z, facing, width, stories = plot[1], plot[2], plot[3], plot[4], plot[5]
		-- Leave room for cornices and roof overhangs: adjacent roofs and plinths
		-- previously occupied the same planes along the entire housing row.
		local spec = PlazaHouses.spec(rng, width - 2.4, DEPTH, stories)
		-- A recessed metro pavilion occupies the middle plot of the east row.
		if index == 8 then continue end
		local frame = CFrame.new(center.X, groundY, center.Z) * CFrame.new(x, 0, z) * CFrame.Angles(0, facing, 0)
		-- Plots touch along the row, so test each one fractionally inside its own walls
		local footprint = frame * CFrame.new(0, 20, 0)
		local half = Vector3.new(width / 2 - 0.3, 19.5, DEPTH / 2 + 1)
		local clear = true
		for _, item in blocking do
			if item.Parent and item.Transparency < 1 and overlaps(footprint, half, item) then
				clear = false
				break
			end
		end
		if not clear then
			continue
		end
		local doomed: { [Instance]: boolean } = {}
		for _, entry in removable do
			if entry[2].Parent and overlaps(footprint, half, entry[1]) then
				doomed[entry[2]] = true
			end
		end
		for target in doomed do
			target:Destroy()
		end
		local y = groundUnder(island, frame, width, DEPTH, groundY)
		local house = PlazaHouses.house(model, frame + Vector3.new(0, y - groundY, 0), spec, rng)
		house.Name = "PlazaHouse" .. index
	end
	model.Parent = plaza
	return model
end

-- The current paving is 116 studs wide; older baked maps used 120. Its top centre anchors
-- everything added to a saved square.
function PlazaHouses.pavingFrame(plaza: Model): CFrame?
	local saved = plaza:GetAttribute("PavingFrame")
	if typeof(saved) == "CFrame" then return saved end
	for _, slab in plaza:GetChildren() do
		if
			slab:IsA("BasePart")
			and slab.Size.X >= 115.9
			and slab.Size.X <= 120.1
			and math.abs(slab.Size.X - slab.Size.Z) < 0.01
			and slab.Size.Y <= 1
		then
			return slab.CFrame * CFrame.new(0, slab.Size.Y / 2, 0)
		end
	end
	return nil
end

-- Startup repairs scan the whole map (city and islands included) before anyone spawns. Yield a
-- frame every 50 ms so the startup thread stays inside Roblox's ~10 s script timeout.
local breatheAt = os.clock()
local function breathe()
	if task and os.clock() - breatheAt > 0.05 then
		task.wait()
		breatheAt = os.clock()
	end
end

function PlazaHouses.ensure(root: Instance)
	for _, plaza in root:GetDescendants() do
		breathe()
		if plaza:IsA("Model") and plaza.Name == "Plaza" then
			local frame = PlazaHouses.pavingFrame(plaza)
			if frame then
				PlazaHouses.build(plaza, frame)
			end
		end
	end
end

return PlazaHouses
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="240">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[-- Set dressing: trees, buildings, harbour clutter, rocks and effects, all using Roblox's textured materials.
-- Each builder takes a ground position and puts its parts in a new Model under `parent`.

local LowPoly = require(script.Parent.LowPoly)

local Props = {}

local HOUSE_COLLISION_VERSION = 1
local HOUSE_NAMES = {
	House = true,
	CubeHouse = true,
	Townhouse = true,
	Villa = true,
	FishingRodShop = true,
	FurnitureShop = true,
}
local BASE_TRIM = {
	SidePlinth = true,
	EavesBeam = true,
	TimberPost = true,
	DoorJamb = true,
	DoorHeader = true,
	RidgeCap = true,
	CeilingTie = true,
}

local M_WOOD = Enum.Material.Wood

local function noCollision(piece: BasePart)
	piece.CanCollide, piece.CanTouch, piece.CanQuery = false, false, false
end

local DECORATION_COLLISION_VERSION = 2
-- Trees keep their trunk (and mangrove stilt roots) as the one body you bump into; canopies,
-- fronds, thin branches and fruit are visual only.
local TREES = {
	Tree = true,
	Palm = true,
	Pine = true,
	DeadTree = true,
	Olive = true,
	StonePine = true,
	Mangrove = true,
}
local TRUNK_THICKNESS = 0.75
-- Greenery, coral and hanging lights: nothing a player, diver or boat needs to collide with.
local NO_HITBOX = {
	Bush = true,
	Flowers = true,
	Reeds = true,
	LilyPad = true,
	Coral = true,
	Seaweed = true,
	Lavender = true,
	Bougainvillea = true,
	StringLights = true,
	Lantern = true,
}
Props.DECORATION_NAMES = table.freeze({
	Sandcastle = true,
	BeachBall = true,
	Pot = true,
	Tree = true,
	Palm = true,
	Pine = true,
	DeadTree = true,
	Olive = true,
	StonePine = true,
	Mangrove = true,
	Bush = true,
	Flowers = true,
	Reeds = true,
	LilyPad = true,
	Coral = true,
	Seaweed = true,
	Lavender = true,
	Bougainvillea = true,
	StringLights = true,
	Lantern = true,
})

-- A solid wooden block at least TRUNK_THICKNESS across its two thinnest sides.
local function isTrunk(piece: BasePart): boolean
	if piece.Material ~= M_WOOD or (piece:IsA("Part") and piece.Shape == Enum.PartType.Ball) then
		return false
	end
	local s = piece.Size
	local thinnest = math.min(s.X, s.Y, s.Z)
	local middle = s.X + s.Y + s.Z - thinnest - math.max(s.X, s.Y, s.Z)
	return thinnest >= TRUNK_THICKNESS and middle >= TRUNK_THICKNESS
end

-- Keep one simple body for small beach props and trees; plants are entirely decorative.
function Props.simplifyDecorationCollision(model: Model)
	if (model:GetAttribute("DecorationCollisionVersion") or 0) >= DECORATION_COLLISION_VERSION then
		return
	end
	local name = model.Name
	for _, piece in model:GetDescendants() do
		if not piece:IsA("BasePart") then
			continue
		end
		local keep = false
		if name == "Sandcastle" then
			keep = piece.Size == Vector3.new(4, 1.2, 4)
		elseif name == "BeachBall" then
			keep = piece:IsA("Part") and piece.Shape == Enum.PartType.Ball
		elseif name == "Pot" then
			-- The terracotta pot itself; the plant growing out of it is decoration.
			keep = piece.Material == Enum.Material.Sandstone
		elseif TREES[name] then
			keep = isTrunk(piece)
		elseif not NO_HITBOX[name] then
			keep = piece.CanCollide
		end
		if not keep then
			noCollision(piece)
			-- Leaves and blossoms rarely read in the shadow map; trunks and pots still cast.
			if TREES[name] or NO_HITBOX[name] then
				if math.max(piece.Size.X, piece.Size.Y, piece.Size.Z) < 1.5 then
					piece.CastShadow = false
				end
			end
		end
	end
	model:SetAttribute("DecorationCollisionVersion", DECORATION_COLLISION_VERSION)
end

-- Parts smaller than this on every side are trim (bolts, knobs, bulbs, blossoms, pebbles):
-- too small to stand on or be stopped by, so they get no hitbox and cast no shadow.
local DETAIL_SIZE = 1
-- Places where small parts are interactive or player-built (bases, furniture, shops, owned
-- islands, cages): leave everything under these alone.
local KEEP_TAGS = {
	"PlayerBase",
	"CompanyIsland",
	"BoatShop",
	"RefitDock",
	"FurnitureShowroom",
	"FurnitureShop",
	"FishingRodShop",
	"BackpackShop",
	"MetroStop",
	"WeatherRadarScreen",
	"ShoreWaveSource",
	"CrabCage",
	"MusselNet",
}

local function isDetail(piece: BasePart): boolean
	local s = piece.Size
	return s.X < DETAIL_SIZE and s.Y < DETAIL_SIZE and s.Z < DETAIL_SIZE
end

local function simplifyDetail(piece: BasePart)
	if not piece.Anchored or piece.Transparency >= 1 then
		return
	end
	if piece:FindFirstChildWhichIsA("ProximityPrompt", true) or piece:FindFirstChildWhichIsA("ClickDetector") then
		return
	end
	if piece.CanCollide or piece.CanQuery or piece.CanTouch then
		noCollision(piece)
	end
	if piece.CastShadow then
		piece.CastShadow = false
	end
end

-- One walk over the whole map: decoration models by name, plus every tiny anchored detail part
-- outside player-built and interactive areas. Idempotent, so baked maps pick it up on boot.
function Props.ensureDecorationCollision(root: Instance, pause: (() -> ())?)
	local CollectionService = game:GetService("CollectionService")
	local kept: { [Instance]: boolean } = {}
	for _, tag in KEEP_TAGS do
		for _, holder in CollectionService:GetTagged(tag) do
			if holder:IsDescendantOf(root) then
				kept[holder] = true
			end
		end
	end
	local function protected(instance: Instance): boolean
		local at = instance.Parent
		while at and at ~= root do
			if kept[at] then
				return true
			end
			at = at.Parent
		end
		return false
	end
	-- Ancestor lookups are memoised per parent: siblings share the answer.
	local parentKept: { [Instance]: boolean } = {}
	local function underKept(piece: Instance): boolean
		local parent = piece.Parent
		if not parent then
			return true
		end
		local known = parentKept[parent]
		if known == nil then
			known = kept[parent] == true or protected(parent)
			parentKept[parent] = known
		end
		return known
	end

	for _, d in root:GetDescendants() do
		if pause then
			pause()
		end
		if d:IsA("Model") then
			if Props.DECORATION_NAMES[d.Name] and not underKept(d) then
				Props.simplifyDecorationCollision(d)
			end
		elseif d:IsA("BasePart") and isDetail(d) and (d.CanCollide or d.CanQuery or d.CastShadow) then
			if not underKept(d) then
				simplifyDetail(d)
			end
		end
	end
end

-- Keep the existing solid building cores and walking surfaces. Facade details
-- within 0.65 studs of a core share its collision instead of each adding a body.
-- Test all eight corners in the core's frame, including on rotated houses.
local function coveredByCore(piece: BasePart, core: BasePart): boolean
	local half = core.Size / 2 + Vector3.new(0.65, 0.65, 0.65)
	for _, x in { -0.5, 0.5 } do
		for _, y in { -0.5, 0.5 } do
			for _, z in { -0.5, 0.5 } do
				local point = core.CFrame:PointToObjectSpace(
					piece.CFrame * Vector3.new(piece.Size.X * x, piece.Size.Y * y, piece.Size.Z * z)
				)
				if math.abs(point.X) > half.X or math.abs(point.Y) > half.Y or math.abs(point.Z) > half.Z then
					return false
				end
			end
		end
	end
	return true
end

function Props.simplifyHouseCollision(house: Model)
	if house:GetAttribute("HouseCollisionVersion") == HOUSE_COLLISION_VERSION then
		return
	end
	if house.Name == "BaseHouse" then
		-- Player homes are hollow: never replace their rooms with a solid box.
		-- Only shell trim is decorative; furniture retains its own interactions.
		local shell = house:FindFirstChild("Shell")
		for _, piece in if shell then shell:GetDescendants() else {} do
			if piece:IsA("BasePart") and BASE_TRIM[piece.Name] then
				noCollision(piece)
			end
		end
	else
		local pieces, cores = {}, {}
		for _, piece in house:GetDescendants() do
			if piece:IsA("BasePart") and piece.CanCollide then
				table.insert(pieces, piece)
				-- Scenery houses already have solid, rectangular wall blocks.
				-- Roofs, steps, stilts, balconies and exterior stairs are not cores.
				if
					piece:IsA("Part")
					and piece.Shape == Enum.PartType.Block
					and piece.Size.X >= 8
					and piece.Size.Z >= 8
					and piece.Size.Y >= 6
				then
					table.insert(cores, piece)
				end
			end
		end
		for _, piece in pieces do
			if table.find(cores, piece) then
				continue
			end
			for _, core in cores do
				if coveredByCore(piece, core) then
					noCollision(piece)
					break
				end
			end
		end
	end
	house:SetAttribute("HouseCollisionVersion", HOUSE_COLLISION_VERSION)
end

-- Baked maps keep their models, positions, ownership and furnishings.
function Props.ensureHouseCollision(root: Instance, pause: (() -> ())?)
	for _, house in root:GetDescendants() do
		if pause then
			pause()
		end
		if
			house:IsA("Model")
			and (
				HOUSE_NAMES[house.Name]
				or house.Name == "BaseHouse"
				or house.Name == "PlazaHouse"
				or string.match(house.Name, "^PlazaHouse%d+$")
			)
		then
			Props.simplifyHouseCollision(house)
		end
	end
end

local TAU = math.pi * 2
local rgb = Color3.fromRGB
local M = Enum.Material

local WOOD = rgb(122, 92, 64)
local WOOD_DARK = rgb(78, 60, 46)
local TRUNK = rgb(88, 66, 50)
local WHITE = rgb(232, 228, 218)
local RED = rgb(170, 52, 44)
local IRON = rgb(52, 50, 48)
local ROPE = rgb(176, 150, 106)
local STONE = rgb(132, 126, 118)
local LAMP = rgb(255, 210, 140)
local LAVA = rgb(255, 96, 28)

local function newModel(name: string, parent: Instance): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

local function part(parent: Instance, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = material or M.SmoothPlastic
	p.Color = color
	p.Size = size
	p.CFrame = cframe
	p.Parent = parent
	return p
end

-- Upright cylinder centered on `center`.
local function cylinder(
	parent: Instance,
	center: Vector3,
	height: number,
	diameter: number,
	color: Color3,
	material: Enum.Material?
): Part
	local p = part(
		parent,
		Vector3.new(height, diameter, diameter),
		CFrame.new(center) * CFrame.Angles(0, 0, math.pi / 2),
		color,
		material
	)
	p.Shape = Enum.PartType.Cylinder
	return p
end

-- A block stretched between two points; trunks, roots, posts, branches, ropes and fronds.
local function beam(
	parent: Instance,
	a: Vector3,
	b: Vector3,
	width: number,
	color: Color3,
	thickness: number?,
	material: Enum.Material?
): Part
	if math.abs((b - a).Unit.Y) > 0.999 then
		b += Vector3.new(0.01, 0, 0)
	end
	return part(
		parent,
		Vector3.new(width, thickness or width, (b - a).Magnitude),
		CFrame.lookAt((a + b) / 2, b),
		color,
		material
	)
end

-- Randomly rotated block; reads as a chunky clump (canopies, rocks, coral).
local function blob(
	parent: Instance,
	center: Vector3,
	size: Vector3,
	rng: Random,
	color: Color3,
	material: Enum.Material?
): Part
	local spin = CFrame.Angles(rng:NextNumber(0, TAU), rng:NextNumber(0, TAU), rng:NextNumber(0, TAU))
	return part(parent, size, CFrame.new(center) * spin, color, material)
end

local function ball(parent: Instance, center: Vector3, size: number, color: Color3, material: Enum.Material?): Part
	local p = part(parent, Vector3.new(size, size, size), CFrame.new(center), color, material)
	p.Shape = Enum.PartType.Ball
	return p
end

local function light(parent: BasePart, color: Color3, range: number, brightness: number)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = parent
end

local function shade(color: Color3, rng: Random, amount: number): Color3
	local s = 1 + rng:NextNumber(-amount, amount)
	return Color3.new(math.min(color.R * s, 1), math.min(color.G * s, 1), math.min(color.B * s, 1))
end

function Props.pick<T>(rng: Random, list: { T }): T
	return list[rng:NextInteger(1, #list)]
end

Props.part = part
Props.cylinder = cylinder
Props.beam = beam
Props.blob = blob
Props.ball = ball
Props.light = light
Props.shade = shade

----------------------------------------------------------------------------------------------------
-- Trees

-- Tiered conifer; `snow` frosts the tiers for the ice biome.
function Props.pine(parent: Instance, ground: Vector3, rng: Random, leaves: Color3, snow: Color3?): Model
	local m = newModel("Pine", parent)
	local h = rng:NextNumber(14, 30)
	local width = h * rng:NextNumber(0.2, 0.26)
	part(m, Vector3.new(1.2, h * 0.3, 1.2), CFrame.new(ground + Vector3.new(0, h * 0.15 - 1, 0)), TRUNK, M.Wood)

	local tiers = if h > 21 then 3 else 2
	local spin = rng:NextNumber(0, TAU)
	for i = 1, tiers do
		local k = (i - 1) / tiers
		local baseY = h * (0.16 + k * 0.6)
		local apexY = if i == tiers then h else baseY + h * 0.5
		local r = width * (1 - k * 0.55)
		local base = {}
		for s = 0, 3 do
			local a = spin + i * 0.7 + s * TAU / 4 + rng:NextNumber(-0.2, 0.2)
			base[s + 1] = ground + Vector3.new(math.cos(a) * r, baseY, math.sin(a) * r)
		end
		local apex = ground + Vector3.new(rng:NextNumber(-0.4, 0.4), apexY, rng:NextNumber(-0.4, 0.4))
		local color = shade(leaves, rng, 0.08)
		local material = M.Grass
		if snow then
			color = color:Lerp(snow, if i == tiers then 0.85 else 0.45)
			material = if i == tiers then M.Snow else M.Grass
		end
		LowPoly.pyramid(base, apex, color, m, material)
	end
	Props.simplifyDecorationCollision(m)
	return m
end

-- Round-canopied tree (the orange/brown autumn trees around the Sound).
function Props.broadleaf(parent: Instance, ground: Vector3, rng: Random, colors: { Color3 }): Model
	local m = newModel("Tree", parent)
	local h = rng:NextNumber(10, 16)
	local top = ground + Vector3.new(rng:NextNumber(-1, 1), h * 0.65, rng:NextNumber(-1, 1))
	beam(m, ground - Vector3.new(0, 1, 0), top, 1.4, TRUNK, nil, M.Wood)
	for _ = 1, 2 do
		local a = rng:NextNumber(0, TAU)
		local tip = top:Lerp(ground, 0.35) + Vector3.new(math.cos(a) * 3.5, 3, math.sin(a) * 3.5)
		beam(m, top:Lerp(ground, 0.4), tip, 0.6, TRUNK, nil, M.Wood)
	end
	for _ = 1, rng:NextInteger(3, 4) do
		local s = rng:NextNumber(5, 8)
		local offset = Vector3.new(rng:NextNumber(-3, 3), rng:NextNumber(0, 3.5), rng:NextNumber(-3, 3))
		blob(m, top + offset, Vector3.new(s, s * 0.8, s), rng, shade(Props.pick(rng, colors), rng, 0.06), M.LeafyGrass)
	end
	Props.simplifyDecorationCollision(m)
	return m
end

-- Mangrove on arching stilt roots. `floorY` is where the roots end (sea floor or ground).
function Props.mangrove(
	parent: Instance,
	ground: Vector3,
	rng: Random,
	floorY: number,
	bark: Color3,
	canopy: { Color3 }
): Model
	local m = newModel("Mangrove", parent)
	local h = rng:NextNumber(16, 28)
	local hub = ground + Vector3.new(0, rng:NextNumber(4, 7), 0)
	local top = ground + Vector3.new(rng:NextNumber(-2, 2), h, rng:NextNumber(-2, 2))
	beam(m, hub, top, 1.4, bark, nil, M.Wood)

	for _ = 1, rng:NextInteger(4, 6) do
		local a = rng:NextNumber(0, TAU)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local reach = rng:NextNumber(5, 9)
		local knee = hub + dir * reach * 0.6 + Vector3.new(0, rng:NextNumber(0, 2), 0)
		local foot = Vector3.new(ground.X, floorY, ground.Z) + dir * reach
		beam(m, hub + Vector3.new(0, 1, 0), knee, 0.8, bark, nil, M.Wood)
		beam(m, knee, foot, 0.8, bark, nil, M.Wood)
	end

	local crowns = { top }
	for _ = 1, rng:NextInteger(2, 3) do
		local a = rng:NextNumber(0, TAU)
		local from = hub:Lerp(top, rng:NextNumber(0.5, 0.85))
		local to = from
			+ Vector3.new(math.cos(a) * rng:NextNumber(5, 9), rng:NextNumber(2, 5), math.sin(a) * rng:NextNumber(5, 9))
		beam(m, from, to, 0.7, bark, nil, M.Wood)
		table.insert(crowns, to)
	end
	for _, crown in crowns do
		local s = rng:NextNumber(8, 13)
		local tilt = CFrame.Angles(rng:NextNumber(-0.2, 0.2), rng:NextNumber(0, TAU), rng:NextNumber(-0.2, 0.2))
		part(
			m,
			Vector3.new(s, s * 0.45, s),
			CFrame.new(crown) * tilt,
			shade(Props.pick(rng, canopy), rng, 0.06),
			M.LeafyGrass
		)
	end
	Props.simplifyDecorationCollision(m)
	return m
end

function Props.palm(parent: Instance, ground: Vector3, rng: Random): Model
	local m = newModel("Palm", parent)
	local h = rng:NextNumber(14, 22)
	local lean = rng:NextNumber(0, TAU)
	local dir = Vector3.new(math.cos(lean), 0, math.sin(lean))
	local bend = rng:NextNumber(2, 6)

	local prev = ground - Vector3.new(0, 1, 0)
	for k = 1, 5 do
		local t = k / 5
		local p = ground + Vector3.new(0, h * t, 0) + dir * (bend * t * t)
		beam(m, prev, p, 1.3 - t * 0.4, if k % 2 == 0 then rgb(140, 112, 78) else rgb(120, 94, 66), nil, M.Wood)
		prev = p
	end

	local top = prev
	for f = 1, 6 do
		local a = f / 6 * TAU + rng:NextNumber(-0.2, 0.2)
		local d = Vector3.new(math.cos(a), 0, math.sin(a))
		local mid = top + d * 5 + Vector3.new(0, 1.2, 0)
		local tip = top + d * 10 + Vector3.new(0, -2.5, 0)
		beam(m, top, mid, 2.4, rgb(78, 140, 60), 0.25, M.LeafyGrass)
		beam(m, mid, tip, 2, rgb(62, 118, 52), 0.25, M.LeafyGrass)
	end
	for _ = 1, rng:NextInteger(1, 3) do
		ball(m, top + Vector3.new(rng:NextNumber(-1, 1), -1, rng:NextNumber(-1, 1)), 1.1, rgb(96, 70, 44), M.Wood)
	end
	Props.simplifyDecorationCollision(m)
	return m
end

-- Bare trunk with a few branches; swamp snags and charred volcanic trees.
function Props.deadTree(parent: Instance, ground: Vector3, rng: Random, color: Color3): Model
	local m = newModel("DeadTree", parent)
	local h = rng:NextNumber(8, 16)
	local top = ground + Vector3.new(rng:NextNumber(-1.5, 1.5), h, rng:NextNumber(-1.5, 1.5))
	beam(m, ground - Vector3.new(0, 1, 0), top, 1.1, color, nil, M.Wood)
	for _ = 1, rng:NextInteger(2, 3) do
		local a = rng:NextNumber(0, TAU)
		local from = ground:Lerp(top, rng:NextNumber(0.45, 0.85))
		local to = from
			+ Vector3.new(
				math.cos(a) * rng:NextNumber(3, 6),
				rng:NextNumber(1.5, 4),
				math.sin(a) * rng:NextNumber(3, 6)
			)
		beam(m, from, to, 0.5, color, nil, M.Wood)
	end
	Props.simplifyDecorationCollision(m)
	return m
end

function Props.bush(parent: Instance, ground: Vector3, rng: Random, colors: { Color3 }): Model
	local m = newModel("Bush", parent)
	for _ = 1, rng:NextInteger(2, 3) do
		local s = rng:NextNumber(2.5, 4.5)
		local offset = Vector3.new(rng:NextNumber(-1.5, 1.5), s * 0.25, rng:NextNumber(-1.5, 1.5))
		blob(
			m,
			ground + offset,
			Vector3.new(s, s * 0.7, s),
			rng,
			shade(Props.pick(rng, colors), rng, 0.06),
			M.LeafyGrass
		)
	end
	Props.simplifyDecorationCollision(m)
	return m
end

-- Little clump of flowers.
function Props.flowers(parent: Instance, ground: Vector3, rng: Random): Model
	local m = newModel("Flowers", parent)
	local colors = { rgb(230, 90, 90), rgb(250, 210, 90), rgb(240, 240, 240), rgb(180, 120, 220), rgb(250, 150, 60) }
	local color = Props.pick(rng, colors)
	for _ = 1, rng:NextInteger(4, 7) do
		local at = ground + Vector3.new(rng:NextNumber(-1.8, 1.8), 0, rng:NextNumber(-1.8, 1.8))
		part(m, Vector3.new(0.15, 1.2, 0.15), CFrame.new(at + Vector3.new(0, 0.6, 0)), rgb(80, 120, 60), M.Grass)
		ball(m, at + Vector3.new(0, 1.3, 0), 0.6, color, M.Plastic)
	end
	Props.simplifyDecorationCollision(m)
	return m
end

----------------------------------------------------------------------------------------------------
-- Rocks and ice

function Props.rock(parent: Instance, ground: Vector3, rng: Random, size: number, color: Color3): Part
	return blob(
		parent,
		ground + Vector3.new(0, size * 0.2, 0),
		Vector3.new(size, size * rng:NextNumber(0.5, 0.9), size * rng:NextNumber(0.7, 1.1)),
		rng,
		shade(color, rng, 0.08),
		M.Rock
	)
end

function Props.boulder(
	parent: Instance,
	ground: Vector3,
	rng: Random,
	radius: number,
	color: Color3,
	material: Enum.Material?
): Model
	local m = newModel("Boulder", parent)
	LowPoly.boulder(
		ground + Vector3.new(0, radius * 0.3, 0),
		radius,
		rng,
		shade(color, rng, 0.06),
		m,
		material or M.Rock
	)
	return m
end

-- Tall leaning four-sided shard (ice spikes, obsidian).
function Props.spike(
	parent: Instance,
	ground: Vector3,
	rng: Random,
	height: number,
	radius: number,
	color: Color3,
	material: Enum.Material?
): Model
	local m = newModel("Spike", parent)
	local spin = rng:NextNumber(0, TAU)
	local base = {}
	for i = 0, 3 do
		local a = spin + i * TAU / 4 + rng:NextNumber(-0.2, 0.2)
		local r = radius * rng:NextNumber(0.8, 1.2)
		base[i + 1] = ground + Vector3.new(math.cos(a) * r, -2, math.sin(a) * r)
	end
	local lean = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1)) * height * 0.15
	LowPoly.pyramid(base, ground + Vector3.new(0, height, 0) + lean, shade(color, rng, 0.05), m, material or M.Ice)
	return m
end

-- Cluster of basalt columns.
function Props.basalt(parent: Instance, ground: Vector3, rng: Random, color: Color3): Model
	local m = newModel("Basalt", parent)
	for _ = 1, rng:NextInteger(3, 6) do
		local h = rng:NextNumber(4, 12)
		local offset = Vector3.new(rng:NextNumber(-3, 3), h / 2 - 1, rng:NextNumber(-3, 3))
		part(
			m,
			Vector3.new(2.6, h, 2.6),
			CFrame.new(ground + offset) * CFrame.Angles(0, rng:NextNumber(0, TAU), 0),
			shade(color, rng, 0.1),
			M.Basalt
		)
	end
	return m
end

----------------------------------------------------------------------------------------------------
-- Water plants

function Props.reeds(parent: Instance, position: Vector3, rng: Random): Model
	local m = newModel("Reeds", parent)
	for _ = 1, rng:NextInteger(5, 8) do
		local base = position + Vector3.new(rng:NextNumber(-2.5, 2.5), -3, rng:NextNumber(-2.5, 2.5))
		local tip = base + Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(7, 12), rng:NextNumber(-1, 1))
		beam(m, base, tip, 0.35, shade(rgb(150, 150, 72), rng, 0.12), nil, M.Grass)
	end
	Props.simplifyDecorationCollision(m)
	return m
end

function Props.lilyPad(parent: Instance, position: Vector3, rng: Random): Model
	local m = newModel("LilyPad", parent)
	local d = rng:NextNumber(2.5, 5)
	cylinder(m, position + Vector3.new(0, 0.1, 0), 0.2, d, shade(rgb(84, 116, 56), rng, 0.1), M.LeafyGrass)
	if rng:NextNumber() < 0.2 then
		blob(m, position + Vector3.new(0, 0.5, 0), Vector3.new(0.9, 0.9, 0.9), rng, rgb(230, 170, 190), M.Plastic)
	end
	Props.simplifyDecorationCollision(m)
	return m
end

function Props.coral(parent: Instance, ground: Vector3, rng: Random, colors: { Color3 }): Model
	local m = newModel("Coral", parent)
	for _ = 1, rng:NextInteger(2, 4) do
		local s = rng:NextNumber(1.5, 4)
		local offset = Vector3.new(rng:NextNumber(-2, 2), s * 0.4, rng:NextNumber(-2, 2))
		blob(m, ground + offset, Vector3.new(s * 0.6, s * 1.4, s * 0.6), rng, Props.pick(rng, colors), M.Pebble)
	end
	Props.simplifyDecorationCollision(m)
	return m
end

----------------------------------------------------------------------------------------------------
-- Buildings

local SHUTTERS = { rgb(70, 92, 112), rgb(112, 60, 50), rgb(72, 102, 74), rgb(64, 62, 60) }

-- Cottage with timber corners, framed windows and a gabled roof; front door on its local +Z.
-- `stilts` raises it on posts (swamp shacks, beach huts). Tall ones get a second floor of windows.
function Props.house(
	parent: Instance,
	ground: Vector3,
	facing: number,
	rng: Random,
	wall: Color3,
	roof: Color3,
	stilts: number?
): Model
	local m = newModel("House", parent)
	local w, d = rng:NextNumber(11, 16), rng:NextNumber(9, 13)
	local stories = if not stilts and rng:NextNumber() < 0.3 then 2 else 1
	local h = if stories == 2 then rng:NextNumber(15, 17) else rng:NextNumber(8, 10.5)
	local lift = stilts or 0
	local base = CFrame.new(ground) * CFrame.Angles(0, facing, 0)
	local trim = wall:Lerp(Color3.new(0, 0, 0), 0.45)
	local shutter = Props.pick(rng, SHUTTERS)
	local wallMaterial = if stilts or rng:NextNumber() < 0.45 then M.WoodPlanks else M.Plaster
	local roofMaterial = if stilts then M.Fabric elseif rng:NextNumber() < 0.5 then M.RoofShingles else M.ClayRoofTiles

	if lift > 0 then
		for _, c in { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } } do
			local x, z = c[1] * (w / 2 - 0.5), c[2] * (d / 2 - 0.5)
			beam(
				m,
				base:PointToWorldSpace(Vector3.new(x, -6, z)),
				base:PointToWorldSpace(Vector3.new(x, lift, z)),
				0.9,
				WOOD_DARK,
				nil,
				M.Wood
			)
		end
		part(m, Vector3.new(w + 2, 0.6, d + 4), base * CFrame.new(0, lift - 0.7, 1.5), WOOD, M.WoodPlanks)
	end

	local floor = if lift > 0 then lift - 0.4 else 0.6
	if lift == 0 then
		part(m, Vector3.new(w + 0.8, 2, d + 0.8), base * CFrame.new(0, -0.4, 0), STONE, M.Cobblestone)
	end
	part(m, Vector3.new(w, h, d), base * CFrame.new(0, floor + h / 2, 0), wall, wallMaterial)
	for _, c in { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } } do
		part(m, Vector3.new(0.8, h, 0.8), base * CFrame.new(c[1] * w / 2, floor + h / 2, c[2] * d / 2), trim, M.Wood)
	end
	if stories == 2 then
		part(m, Vector3.new(w + 0.4, 0.6, d + 0.4), base * CFrame.new(0, floor + h / 2, 0), trim, M.Wood)
	end

	-- Roof: two slanted panels, a ridge beam and the gable triangles
	local top = floor + h
	local pitch = math.rad(rng:NextNumber(32, 42))
	local rise = d / 2 * math.tan(pitch)
	local slant = (d / 2 + 1.2) / math.cos(pitch)
	for side = -1, 1, 2 do
		part(
			m,
			Vector3.new(w + 1.8, 0.7, slant),
			base * CFrame.new(0, top + rise / 2, side * d / 4) * CFrame.Angles(side * pitch, 0, 0),
			roof,
			roofMaterial
		)
		local x = side * w / 2
		LowPoly.triangle(
			base:PointToWorldSpace(Vector3.new(x, top, -d / 2)),
			base:PointToWorldSpace(Vector3.new(x, top, d / 2)),
			base:PointToWorldSpace(Vector3.new(x, top + rise, 0)),
			base:PointToWorldSpace(Vector3.new(0, top, 0)),
			wall,
			m,
			wallMaterial
		)
	end
	part(
		m,
		Vector3.new(w + 2, 0.8, 0.8),
		base * CFrame.new(0, top + rise + 0.2, 0),
		roof:Lerp(Color3.new(0, 0, 0), 0.3),
		M.Wood
	)

	-- Door with a frame, a handle and a step
	local front = d / 2
	part(m, Vector3.new(3.4, 5.8, 0.2), base * CFrame.new(0, floor + 2.9, front + 0.05), trim, M.Wood)
	part(m, Vector3.new(2.4, 5, 0.3), base * CFrame.new(0, floor + 2.5, front + 0.1), WOOD_DARK, M.WoodPlanks)
	ball(m, base:PointToWorldSpace(Vector3.new(0.8, floor + 2.5, front + 0.3)), 0.35, rgb(200, 170, 80), M.Metal)
	if lift == 0 then
		part(m, Vector3.new(4, 0.6, 1.6), base * CFrame.new(0, floor - 0.2, front + 0.8), STONE, M.Slate)
	end

	-- Framed, shuttered front windows on every floor, plain windows on the sides
	local storyHeight = h / stories
	for s = 1, stories do
		local y = floor + (s - 1) * storyHeight + storyHeight * 0.55
		for side = -1, 1, 2 do
			local x = side * (w / 4 + 0.8)
			part(m, Vector3.new(2.4, 2.6, 0.15), base * CFrame.new(x, y, front + 0.05), trim, M.Wood)
			local glass = part(m, Vector3.new(1.7, 1.9, 0.2), base * CFrame.new(x, y, front + 0.1), LAMP, M.Neon)
			part(m, Vector3.new(0.15, 1.9, 0.25), base * CFrame.new(x, y, front + 0.12), trim, M.Wood)
			part(m, Vector3.new(2.8, 0.3, 0.7), base * CFrame.new(x, y - 1.4, front + 0.3), trim, M.Wood)
			for flap = -1, 1, 2 do
				part(
					m,
					Vector3.new(0.8, 2.6, 0.15),
					base * CFrame.new(x + flap * 1.7, y, front + 0.1),
					shutter,
					M.WoodPlanks
				)
			end
			if s == 1 and side == 1 then
				light(glass, LAMP, 16, 0.8)
			end
			part(m, Vector3.new(0.2, 1.9, 1.7), base * CFrame.new(side * (w / 2 + 0.05), y, 0), LAMP, M.Neon)
		end
	end

	if rng:NextNumber() < 0.6 then
		local chimney = base * CFrame.new(w / 3, top + rise * 0.7, -d / 5)
		part(m, Vector3.new(1.8, rise + 3, 1.8), chimney, rgb(140, 84, 66), M.Brick)
		part(m, Vector3.new(2.3, 0.5, 2.3), chimney * CFrame.new(0, (rise + 3) / 2, 0), rgb(80, 70, 66), M.Slate)
	end
	if lift == 0 and rng:NextNumber() < 0.45 then
		-- Little porch roof over the door, with a lantern
		part(
			m,
			Vector3.new(5, 0.4, 2.8),
			base * CFrame.new(0, floor + 6, front + 1.3) * CFrame.Angles(0.25, 0, 0),
			roof,
			roofMaterial
		)
		for side = -1, 1, 2 do
			part(m, Vector3.new(0.4, 6, 0.4), base * CFrame.new(side * 2.2, floor + 3, front + 2.5), trim, M.Wood)
		end
		Props.lantern(m, base * CFrame.new(1.6, floor + 5.2, front + 0.6))
	end
	if rng:NextNumber() < 0.4 then
		local box = base * CFrame.new(-(w / 4 + 0.8), floor + storyHeight * 0.55 - 2, front + 0.7)
		part(m, Vector3.new(2.8, 0.8, 0.9), box, WOOD, M.WoodPlanks)
		for k = -1, 1 do
			ball(
				m,
				box.Position + base.RightVector * k * 0.8 + Vector3.new(0, 0.6, 0),
				0.7,
				Props.pick(rng, {
					rgb(220, 80, 80),
					rgb(250, 210, 90),
					rgb(240, 240, 240),
				}),
				M.Plastic
			)
		end
	end
	Props.simplifyHouseCollision(m)
	return m
end

-- Waterside fishing hut on a plank deck: front porch under a tin roof, life ring, lantern and bench.
-- Faces its local +Z. `color` tints the plank walls.
function Props.fishingHut(parent: Instance, ground: Vector3, facing: number, rng: Random, color: Color3): Model
	local m = newModel("FishingHut", parent)
	local base = CFrame.new(ground) * CFrame.Angles(0, facing, 0)
	local w, d, h = 16, 12, 10
	local wall = color:Lerp(rgb(150, 150, 140), 0.45)
	local trim = rgb(96, 70, 50)
	local tin = rgb(118, 122, 124)

	-- Raised deck with a porch out front
	part(m, Vector3.new(w + 4, 0.8, d + 9), base * CFrame.new(0, 0.6, 2.5), WOOD, M.WoodPlanks)
	for _, c in { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } } do
		part(
			m,
			Vector3.new(0.9, 2, 0.9),
			base * CFrame.new(c[1] * (w / 2 + 1.5), 0, 2.5 + c[2] * (d + 8) / 2),
			WOOD_DARK,
			M.Wood
		)
	end
	part(m, Vector3.new(w, h, d), base * CFrame.new(0, 1 + h / 2, 0), wall, M.WoodPlanks)
	for _, c in { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } } do
		part(m, Vector3.new(0.8, h, 0.8), base * CFrame.new(c[1] * w / 2, 1 + h / 2, c[2] * d / 2), trim, M.Wood)
	end
	part(m, Vector3.new(w + 0.4, 0.6, d + 0.4), base * CFrame.new(0, 1.3, 0), trim, M.Wood)

	-- Gabled tin roof that runs forward over the porch
	local top = 1 + h
	local pitch = math.rad(28)
	local rise = w / 2 * math.tan(pitch)
	local depth = d + 7
	for side = -1, 1, 2 do
		local slant = (w / 2 + 1.2) / math.cos(pitch)
		part(
			m,
			Vector3.new(slant, 0.5, depth),
			base * CFrame.new(side * w / 4, top + rise / 2, 3) * CFrame.Angles(0, 0, -side * pitch),
			tin,
			M.CorrodedMetal
		)
		local z = side * d / 2
		LowPoly.triangle(
			base:PointToWorldSpace(Vector3.new(-w / 2, top, z)),
			base:PointToWorldSpace(Vector3.new(w / 2, top, z)),
			base:PointToWorldSpace(Vector3.new(0, top + rise, z)),
			base:PointToWorldSpace(Vector3.new(0, top, 0)),
			wall,
			m,
			M.WoodPlanks
		)
	end
	part(m, Vector3.new(0.8, 0.8, depth + 0.4), base * CFrame.new(0, top + rise + 0.2, 3), trim, M.Wood)
	for side = -1, 1, 2 do
		part(m, Vector3.new(0.7, h, 0.7), base * CFrame.new(side * (w / 2 - 0.4), 1 + h / 2, d / 2 + 6.2), trim, M.Wood)
	end

	-- Porch railing with a gap for the steps
	local railY = 3
	for side = -1, 1, 2 do
		local x = side * (w / 2 + 1.6)
		beam(
			m,
			base:PointToWorldSpace(Vector3.new(x, railY, d / 2)),
			base:PointToWorldSpace(Vector3.new(x, railY, d / 2 + 6.5)),
			0.35,
			trim,
			nil,
			M.Wood
		)
		part(m, Vector3.new(0.4, 2.5, 0.4), base * CFrame.new(x, 2, d / 2 + 6.5), trim, M.Wood)
		beam(
			m,
			base:PointToWorldSpace(Vector3.new(x, railY, d / 2 + 6.5)),
			base:PointToWorldSpace(Vector3.new(side * 3, railY, d / 2 + 6.5)),
			0.35,
			trim,
			nil,
			M.Wood
		)
	end

	-- Front: door, window, life ring, lantern
	local front = d / 2
	part(m, Vector3.new(3.6, 6.4, 0.2), base * CFrame.new(-3, 4.2, front + 0.05), trim, M.Wood)
	part(m, Vector3.new(2.8, 5.8, 0.3), base * CFrame.new(-3, 3.9, front + 0.1), WOOD_DARK, M.WoodPlanks)
	part(m, Vector3.new(4.2, 3.4, 0.15), base * CFrame.new(3.5, 6, front + 0.05), trim, M.Wood)
	local glass = part(m, Vector3.new(3.4, 2.6, 0.2), base * CFrame.new(3.5, 6, front + 0.1), LAMP, M.Neon)
	light(glass, LAMP, 18, 0.9)
	part(m, Vector3.new(0.2, 2.6, 0.25), base * CFrame.new(3.5, 6, front + 0.15), trim, M.Wood)
	part(m, Vector3.new(4.6, 0.3, 0.8), base * CFrame.new(3.5, 4.2, front + 0.4), trim, M.Wood)
	Props.lifeRing(m, base * CFrame.new(0.2, 7.6, front + 0.3))
	Props.lantern(m, base * CFrame.new(-0.6, 9.2, front + 4))
	Props.bench(m, base:PointToWorldSpace(Vector3.new(3.5, 1, front + 1.6)), facing + math.pi)
	Props.crates(m, base:PointToWorldSpace(Vector3.new(-w / 2 - 0.2, 1, front + 5)), rng)
	Props.ropeCoil(m, base:PointToWorldSpace(Vector3.new(w / 2 - 1, 1, front + 5)))

	-- Side window and a stovepipe
	part(m, Vector3.new(0.2, 2.4, 3), base * CFrame.new(w / 2 + 0.05, 6, -1), LAMP, M.Neon)
	part(m, Vector3.new(0.15, 3, 3.6), base * CFrame.new(w / 2 + 0.02, 6, -1), trim, M.Wood)
	cylinder(m, base:PointToWorldSpace(Vector3.new(-w / 4, top + rise + 1.5, -d / 4)), 4, 1.2, IRON, M.Metal)
	return m
end

function Props.clockTower(parent: Instance, ground: Vector3, facing: number): Model
	local m = newModel("ClockTower", parent)
	local base = CFrame.new(ground) * CFrame.Angles(0, facing, 0)
	part(m, Vector3.new(11, 2, 11), base * CFrame.new(0, 0, 0), STONE, M.Cobblestone)
	part(m, Vector3.new(9, 30, 9), base * CFrame.new(0, 15, 0), WHITE, M.Plaster)
	for _, c in { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } } do
		part(m, Vector3.new(1.2, 30, 1.2), base * CFrame.new(c[1] * 4.5, 15, c[2] * 4.5), STONE, M.Brick)
	end
	part(m, Vector3.new(10, 1.2, 10), base * CFrame.new(0, 29.6, 0), rgb(90, 80, 76), M.Slate)
	part(m, Vector3.new(7, 8, 7), base * CFrame.new(0, 34, 0), WHITE, M.Plaster)
	for k = 0, 3 do
		local side = base * CFrame.Angles(0, k * math.pi / 2, 0)
		cylinder(m, (side * CFrame.new(0, 34, 3.6)).Position, 0.3, 4.4, rgb(255, 240, 200), M.Neon).CFrame = side
			* CFrame.new(0, 34, 3.6)
			* CFrame.Angles(0, math.pi / 2, 0)
		part(m, Vector3.new(0.3, 1.6, 0.2), side * CFrame.new(0, 34.6, 3.85), IRON, M.Metal)
		part(m, Vector3.new(1.2, 0.3, 0.2), side * CFrame.new(0.5, 34, 3.85), IRON, M.Metal)
		part(m, Vector3.new(2.2, 3.2, 0.2), side * CFrame.new(0, 20, 4.55), rgb(70, 92, 112), M.Glass)
	end
	part(m, Vector3.new(3.4, 6.4, 0.2), base * CFrame.new(0, 4.2, 4.55), rgb(90, 80, 76), M.Wood)
	part(m, Vector3.new(3, 6, 0.3), base * CFrame.new(0, 4, 4.6), WOOD_DARK, M.WoodPlanks)

	local corners = {}
	for i, c in { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } } do
		corners[i] = base:PointToWorldSpace(Vector3.new(c[1] * 4.5, 38, c[2] * 4.5))
	end
	LowPoly.pyramid(corners, base:PointToWorldSpace(Vector3.new(0, 47, 0)), RED, m, M.RoofShingles)
	return m
end

-- Small dock details never snag characters, boats, or interaction raycasts.
local function dockDetail(p: BasePart, name: string): BasePart
	p.Name = name
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	return p
end

local DOCK_WOOD = rgb(119, 83, 53)
local DOCK_WORN = rgb(158, 122, 81)
local DOCK_PILE = rgb(77, 55, 39)

-- Local -Z runs along the section. Every board has a level top at local Y = 0.3.
local function dockDeck(parent: Model, frame: CFrame, width: number, length: number, rng: Random)
	-- A single walking surface keeps plank seams out of the navmesh and physics.
	local surface =
		part(parent, Vector3.new(width, 0.6, length), frame * CFrame.new(0, 0, -length / 2), DOCK_WOOD, M.Wood)
	surface.Name = "DeckSurface"
	surface.Transparency, surface.CastShadow = 1, false
	local count = math.ceil(length / 1.3)
	local pitch = length / count
	for i = 1, count do
		local z = -(i - 0.5) * pitch
		local color = DOCK_WOOD:Lerp(DOCK_WORN, rng:NextNumber(0.08, 0.8))
		local board = part(parent, Vector3.new(width, 0.6, pitch - 0.055), frame * CFrame.new(0, 0, z), color, M.Wood)
		board.Name = "DeckPlank"
		board.CanCollide, board.CanQuery = false, false
		if i % 3 == 1 then
			for _, side in { -1, 1 } do
				dockDetail(
					cylinder(
						parent,
						(frame * CFrame.new(side * (width / 2 - 0.6), 0.306, z)).Position,
						0.025,
						0.13,
						IRON,
						M.Metal
					),
					"PlankNail"
				)
			end
		end
	end
	for _, side in { -1, 1 } do
		local stringer = part(
			parent,
			Vector3.new(0.5, 0.85, length),
			frame * CFrame.new(side * (width / 2 - 0.3), -0.65, -length / 2),
			DOCK_PILE,
			M.Wood
		)
		stringer.Name = "Stringer"
	end
end

local function dockPile(parent: Model, frame: CFrame, x: number, z: number, rng: Random)
	local position = frame * CFrame.new(x, 0, z)
	local pile =
		cylinder(parent, (position * CFrame.new(0, -7.2, 0)).Position, 18, 1.2, shade(DOCK_PILE, rng, 0.08), M.Wood)
	pile.Name = "Pile"
	dockDetail(
		cylinder(parent, (position * CFrame.new(0, 1.83, 0)).Position, 0.1, 1.24, DOCK_WORN, M.Wood),
		"PileEndGrain"
	)
	dockDetail(
		cylinder(parent, (position * CFrame.new(0, -3.1, 0)).Position, 0.85, 1.23, rgb(65, 69, 48), M.Wood),
		"TidalMark"
	)
	dockDetail(cylinder(parent, (position * CFrame.new(0, -0.5, 0)).Position, 0.18, 1.26, IRON, M.Metal), "PileCollar")
	for i = 0, 2 do
		dockDetail(
			cylinder(parent, (position * CFrame.new(0, 1.05 + i * 0.14, 0)).Position, 0.11, 1.3, ROPE, M.Fabric),
			"RopeLashing"
		)
	end
end

local function dockRope(parent: Model, frame: CFrame, a: Vector3, b: Vector3)
	local previous = frame:PointToWorldSpace(a)
	for i = 1, 4 do
		local t = i / 4
		local nextPoint = frame:PointToWorldSpace(a:Lerp(b, t) - Vector3.new(0, math.sin(t * math.pi) * 0.24, 0))
		dockDetail(beam(parent, previous, nextPoint, 0.18, ROPE, nil, M.Fabric), "RopeRail")
		previous = nextPoint
	end
end

-- Warm inset panes with dark metal frames, mounted outside the walking lane.
local function dockLamp(parent: Model, frame: CFrame)
	local model = newModel("DockLamp", parent)
	part(model, Vector3.new(0.5, 4.8, 0.5), frame * CFrame.new(0, 2.4, 0), DOCK_PILE, M.Wood)
	part(model, Vector3.new(1.15, 0.18, 1.15), frame * CFrame.new(0, 4.85, 0), IRON, M.Metal)
	local pane = part(model, Vector3.new(0.76, 1.05, 0.76), frame * CFrame.new(0, 5.45, 0), rgb(255, 228, 163), M.Neon)
	dockDetail(pane, "LampPane")
	light(pane, rgb(255, 215, 148), 17, 1.15)
	for _, x in { -0.48, 0.48 } do
		for _, z in { -0.48, 0.48 } do
			dockDetail(
				part(model, Vector3.new(0.1, 1.2, 0.1), frame * CFrame.new(x, 5.45, z), IRON, M.Metal),
				"LampFrame"
			)
		end
	end
	dockDetail(part(model, Vector3.new(1.35, 0.22, 1.35), frame * CFrame.new(0, 6.12, 0), IRON, M.Metal), "LampCap")
end

type DockOptions = { innerSide: number?, junctionStart: number?, junctionEnd: number? }

-- Pier with an open central walk lane and an optional opening for the crosswalk.
function Props.dock(
	parent: Instance,
	start: Vector3,
	direction: Vector3,
	length: number,
	rng: Random,
	options: DockOptions?
): Vector3
	local m = newModel("Dock", parent)
	local origin = Vector3.new(start.X, 3, start.Z)
	local frame = CFrame.lookAt(origin, origin + Vector3.new(direction.X, 0, direction.Z))
	dockDeck(m, frame, 7, length, rng)
	local postsZ = { 1.2 }
	for z = 10.2, length - 2, 9 do
		table.insert(postsZ, z)
	end
	table.insert(postsZ, length - 1.2)
	for _, side in { -1, 1 } do
		local sidePosts = {}
		for _, z in postsZ do
			if
				not (
					options
					and side == options.innerSide
					and options.junctionStart
					and options.junctionEnd
					and z > options.junctionStart
					and z < options.junctionEnd
				)
			then
				table.insert(sidePosts, z)
			end
		end
		if options and side == options.innerSide and options.junctionStart and options.junctionEnd then
			if not table.find(sidePosts, options.junctionStart) then
				table.insert(sidePosts, options.junctionStart)
			end
			if not table.find(sidePosts, options.junctionEnd) then
				table.insert(sidePosts, options.junctionEnd)
			end
		end
		table.sort(sidePosts)
		for _, z in sidePosts do
			dockPile(m, frame, side * 3.85, -z, rng)
		end
		for i = 1, #sidePosts - 1 do
			local a, b = sidePosts[i], sidePosts[i + 1]
			if
				not (options and side == options.innerSide and a == options.junctionStart and b == options.junctionEnd)
			then
				dockRope(m, frame, Vector3.new(side * 3.85, 1.3, -a), Vector3.new(side * 3.85, 1.3, -b))
			end
		end
	end
	for i, z in postsZ do
		local bearer = part(m, Vector3.new(8.5, 0.65, 0.7), frame * CFrame.new(0, -1.1, -z), DOCK_PILE, M.Wood)
		bearer.Name = "Bearer"
		if i % 2 == 0 then
			for _, side in { -1, 1 } do
				local brace = beam(
					m,
					frame * Vector3.new(side * 3.85, -3.2, -z),
					frame * Vector3.new(side * 0.7, -1.45, -z),
					0.35,
					DOCK_WOOD,
					nil,
					M.Wood
				)
				brace.Name = "Brace"
			end
		end
	end
	local lampSide = if options and options.innerSide then -options.innerSide else 1
	dockLamp(m, frame * CFrame.new(lampSide * 4.15, 0.3, -(length - 1.2)))
	-- Keep the ladder beyond the tip and the landing free of loose props.
	Props.ladder(m, frame * CFrame.new(-1.5, 0, -length), -6)
	return (frame * CFrame.new(0, 0.3, -(length - 5))).Position
end

-- Matching boarded crosswalk. Local X spans 27 studs; both ends stay open.
function Props.dockLink(parent: Instance, frame: CFrame, rng: Random): Model
	local model = newModel("DockLink", parent)
	local along = frame * CFrame.Angles(0, math.pi / 2, 0) * CFrame.new(0, 0, 13.5)
	dockDeck(model, along, 5, 27, rng)
	for _, x in { -8, 0, 8 } do
		dockPile(model, frame, x, -3.1, rng)
		local joist = part(model, Vector3.new(0.7, 0.7, 6.6), frame * CFrame.new(x, -1.1, 0), DOCK_PILE, M.Wood)
		joist.Name = "Joist"
	end
	for _, a in { -8, 0 } do
		dockRope(model, frame, Vector3.new(a, 1.3, -3.1), Vector3.new(a + 8, 1.3, -3.1))
	end
	return model
end

-- Big striped lighthouse on a round stone platform. Its "LighthouseLens" part is spun by Map.animate.
function Props.lighthouse(parent: Instance, ground: Vector3): Model
	local m = newModel("Lighthouse", parent)
	local gx, gz = ground.X, ground.Z

	-- Round platform with a fence around the edge
	cylinder(m, Vector3.new(gx, ground.Y + 0.5, gz), 3, 36, STONE, M.Cobblestone)
	local fence = {}
	for i = 1, 20 do
		local a = i / 20 * TAU
		fence[i] = Vector3.new(gx + math.cos(a) * 17, ground.Y + 2, gz + math.sin(a) * 17)
		part(m, Vector3.new(0.5, 3, 0.5), CFrame.new(fence[i] + Vector3.new(0, 1.5, 0)), WOOD_DARK, M.Wood)
	end
	for i = 1, 20 do
		if i ~= 5 then -- gap facing the path
			beam(
				m,
				fence[i] + Vector3.new(0, 2.4, 0),
				fence[i % 20 + 1] + Vector3.new(0, 2.4, 0),
				0.3,
				WOOD,
				nil,
				M.WoodPlanks
			)
		end
	end

	local y = ground.Y + 2
	local r = 8.5
	for i = 1, 7 do
		cylinder(m, Vector3.new(gx, y + 4, gz), 8, r * 2, if i % 2 == 1 then WHITE else RED, M.Plaster)
		if i % 2 == 0 then
			for _, a in { 0, math.pi } do
				local face = CFrame.new(gx, y + 4, gz) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, r - 0.2)
				part(m, Vector3.new(1.6, 2.6, 0.6), face, rgb(50, 56, 62), M.Glass)
			end
		end
		y += 8
		r -= 0.5
	end
	part(m, Vector3.new(3, 6, 0.6), CFrame.new(gx, ground.Y + 5, gz) * CFrame.new(0, 0, 8.4), WOOD_DARK, M.WoodPlanks)

	-- Gallery with railing
	cylinder(m, Vector3.new(gx, y + 0.5, gz), 1, (r + 3) * 2, rgb(60, 56, 54), M.DiamondPlate)
	local rail = {}
	for i = 1, 16 do
		local a = i / 16 * TAU
		rail[i] = Vector3.new(gx + math.cos(a) * (r + 2.6), y + 1, gz + math.sin(a) * (r + 2.6))
		part(m, Vector3.new(0.3, 3, 0.3), CFrame.new(rail[i] + Vector3.new(0, 1.5, 0)), IRON, M.Metal)
	end
	for i = 1, 16 do
		beam(m, rail[i] + Vector3.new(0, 3, 0), rail[i % 16 + 1] + Vector3.new(0, 3, 0), 0.3, IRON, nil, M.Metal)
	end

	-- Lantern room
	local glass = cylinder(m, Vector3.new(gx, y + 4, gz), 6, (r - 0.5) * 2, rgb(255, 240, 200), M.SmoothPlastic)
	glass.Transparency = 0.5
	local lamp = ball(m, Vector3.new(gx, y + 4, gz), 3, LAMP, M.Neon)
	light(lamp, LAMP, 100, 3)

	local lens = part(m, Vector3.new(1, 1, 1), CFrame.new(gx, y + 4, gz), LAMP)
	lens.Name = "LighthouseLens"
	lens.Transparency = 1
	lens.CanCollide = false
	lens.CanQuery = false
	local spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Front
	spot.Range = 60
	spot.Angle = 35
	spot.Brightness = 8
	spot.Color = LAMP
	spot.Parent = lens
	local a0 = Instance.new("Attachment")
	a0.Parent = lens
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, 0, -180)
	a1.Parent = lens
	local ray = Instance.new("Beam")
	ray.Attachment0 = a0
	ray.Attachment1 = a1
	ray.Width0 = 3
	ray.Width1 = 40
	ray.FaceCamera = true
	ray.LightEmission = 1
	ray.Segments = 1
	ray.Color = ColorSequence.new(LAMP)
	ray.Transparency = NumberSequence.new(0.55, 1)
	ray.Parent = lens

	-- Domed cap
	cylinder(m, Vector3.new(gx, y + 7.3, gz), 0.6, (r + 0.6) * 2, RED, M.Metal)
	local cap = {}
	for i = 1, 8 do
		local a = i / 8 * TAU
		cap[i] = Vector3.new(gx + math.cos(a) * (r + 0.3), y + 7.6, gz + math.sin(a) * (r + 0.3))
	end
	LowPoly.pyramid(cap, Vector3.new(gx, y + 12, gz), RED, m, M.Metal)
	ball(m, Vector3.new(gx, y + 12.5, gz), 1.4, IRON, M.Metal)
	return m
end

-- Channel marker floating at the waterline.
function Props.buoy(parent: Instance, position: Vector3, rng: Random): Model
	local m = newModel("Buoy", parent)
	local color = if rng:NextNumber() < 0.5 then RED else WHITE
	cylinder(m, position + Vector3.new(0, 0.3, 0), 2.4, 5, color, M.Plastic)
	cylinder(m, position + Vector3.new(0, 1.6, 0), 0.5, 5.4, rgb(60, 56, 54), M.Rubber)
	local top = position + Vector3.new(0, 7, 0)
	for k = 0, 2 do
		local a = k * TAU / 3
		beam(m, position + Vector3.new(math.cos(a) * 1.8, 1.5, math.sin(a) * 1.8), top, 0.35, color, nil, M.Metal)
	end
	local lamp = part(m, Vector3.new(1.2, 1.2, 1.2), CFrame.new(top + Vector3.new(0, 0.6, 0)), LAMP, M.Neon)
	light(lamp, LAMP, 24, 2)
	return m
end

----------------------------------------------------------------------------------------------------
-- Harbour and village clutter

function Props.lampPost(parent: Instance, ground: Vector3): Model
	local m = newModel("LampPost", parent)
	part(m, Vector3.new(1.4, 0.8, 1.4), CFrame.new(ground + Vector3.new(0, 0.4, 0)), IRON, M.Metal)
	cylinder(m, ground + Vector3.new(0, 4.5, 0), 9, 0.55, IRON, M.Metal)
	part(m, Vector3.new(1.8, 0.4, 1.8), CFrame.new(ground + Vector3.new(0, 10.8, 0)), IRON, M.Metal)
	part(m, Vector3.new(0.8, 0.5, 0.8), CFrame.new(ground + Vector3.new(0, 11.2, 0)), IRON, M.Metal)
	local lamp = part(m, Vector3.new(1.1, 1.5, 1.1), CFrame.new(ground + Vector3.new(0, 9.8, 0)), LAMP, M.Neon)
	light(lamp, LAMP, 22, 1.2)
	return m
end

-- Small hanging lantern centred on `cframe`.
function Props.lantern(parent: Instance, cframe: CFrame, range: number?, brightness: number?): Model
	local m = newModel("Lantern", parent)
	part(m, Vector3.new(0.2, 1, 0.2), cframe * CFrame.new(0, 1.1, 0), IRON, M.Metal)
	part(m, Vector3.new(1.2, 0.3, 1.2), cframe * CFrame.new(0, 0.6, 0), IRON, M.Metal)
	part(m, Vector3.new(1.2, 0.2, 1.2), cframe * CFrame.new(0, -0.6, 0), IRON, M.Metal)
	local glow = part(m, Vector3.new(0.9, 1, 0.9), cframe, LAMP, M.Neon)
	light(glow, LAMP, range or 14, brightness or 1)
	Props.simplifyDecorationCollision(m)
	return m
end

-- Festoon of coloured bulbs sagging between two points.
function Props.stringLights(parent: Instance, a: Vector3, b: Vector3, rng: Random, sag: number?): Model
	local m = newModel("StringLights", parent)
	local colors = { rgb(255, 200, 120), rgb(255, 150, 60), rgb(170, 110, 255), rgb(120, 220, 255) }
	local droop = sag or (b - a).Magnitude * 0.08
	local count = math.max(4, math.floor((b - a).Magnitude / 4))
	local prev = a
	for i = 1, count do
		local t = i / count
		local p = a:Lerp(b, t) - Vector3.new(0, droop * 4 * t * (1 - t), 0)
		beam(m, prev, p, 0.12, IRON, nil, M.Fabric)
		if i < count then
			local bulb = ball(m, p - Vector3.new(0, 0.35, 0), 0.5, Props.pick(rng, colors), M.Neon)
			bulb.CanCollide = false
			bulb.CastShadow = false
		end
		prev = p
	end
	Props.simplifyDecorationCollision(m)
	return m
end

-- Red-and-white life ring hung on a wall; `cframe` faces out of the wall.
function Props.lifeRing(parent: Instance, cframe: CFrame): Model
	local m = newModel("LifeRing", parent)
	local sides = 8
	for i = 1, sides do
		local a0, a1 = (i - 1) / sides * TAU, i / sides * TAU
		local p0 = cframe:PointToWorldSpace(Vector3.new(math.cos(a0) * 1.3, math.sin(a0) * 1.3, 0))
		local p1 = cframe:PointToWorldSpace(Vector3.new(math.cos(a1) * 1.3, math.sin(a1) * 1.3, 0))
		beam(m, p0, p1, 0.55, if i % 2 == 0 then RED else WHITE, 0.55, M.Plastic)
	end
	return m
end

-- Ladder hanging down from `top` (its local -Z is out over the water) to height `bottomY`.
function Props.ladder(parent: Instance, top: CFrame, bottomY: number): Model
	local m = newModel("Ladder", parent)
	local height = top.Position.Y - bottomY
	for side = -1, 1, 2 do
		part(
			m,
			Vector3.new(0.3, height + 1.5, 0.3),
			top * CFrame.new(side * 0.9, -height / 2 + 0.75, -0.3),
			WOOD_DARK,
			M.Wood
		)
	end
	for y = 0.8, height, 1.4 do
		part(m, Vector3.new(1.8, 0.2, 0.25), top * CFrame.new(0, -y + 0.8, -0.3), WOOD, M.Wood)
	end
	return m
end

function Props.ropeCoil(parent: Instance, ground: Vector3): Model
	local m = newModel("RopeCoil", parent)
	cylinder(m, ground + Vector3.new(0, 0.3, 0), 0.6, 2.6, ROPE, M.Fabric)
	cylinder(m, ground + Vector3.new(0, 0.75, 0), 0.4, 1.8, ROPE, M.Fabric)
	return m
end

-- Netted crab pot.
function Props.crabPot(parent: Instance, ground: Vector3, rng: Random): Model
	local m = newModel("CrabPot", parent)
	local frame = CFrame.new(ground + Vector3.new(0, 1, 0)) * CFrame.Angles(0, rng:NextNumber(0, TAU), 0)
	local net = part(m, Vector3.new(3, 1.8, 2.2), frame, rgb(120, 130, 120), M.Fabric)
	net.Transparency = 0.35
	for _, y in { -0.9, 0.9 } do
		part(m, Vector3.new(3.1, 0.15, 2.3), frame * CFrame.new(0, y, 0), IRON, M.Metal)
	end
	for _, c in { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } } do
		part(m, Vector3.new(0.15, 1.8, 0.15), frame * CFrame.new(c[1] * 1.5, 0, c[2] * 1.1), IRON, M.Metal)
	end
	part(m, Vector3.new(0.4, 0.4, 0.4), frame * CFrame.new(0.4, 0, 0), rgb(220, 100, 60), M.Plastic)
	return m
end

-- A crab cage the angler can buy: coated-wire box on wooden skids with a funnel
-- entrance at each end, an orange bait box hung inside and a rope bridle on top.
-- `frame` is the centre of its base, the long sides along X. With `float`, a rope
-- runs to a marker float in a "Float" model that rides at CRAB_CAGE_WATERLINE.
-- Every part is decoration: no collision, queries or touches.
Props.CRAB_CAGE_SIZE = Vector3.new(3.2, 1.9, 2.4)
Props.CRAB_CAGE_WATERLINE = 1.45
function Props.crabCage(parent: Instance, frame: CFrame, float: boolean?): Model
	local m = newModel("CrabCage", parent)
	local coat, wire = rgb(30, 58, 50), rgb(48, 96, 80)
	local net, rubber = rgb(226, 214, 176), rgb(28, 28, 30)
	local size = Props.CRAB_CAGE_SIZE
	local hw, hd, top = size.X / 2 - 0.07, size.Z / 2 - 0.07, size.Y
	local floor = 0.3
	local function piece(container: Instance, dimensions: Vector3, offset: CFrame, color: Color3, material): Part
		local p = part(container, dimensions, frame * offset, color, material)
		p.CanCollide, p.CanQuery = false, false
		return p
	end
	local function bar(container: Instance, a: Vector3, b: Vector3, width: number, color: Color3, material): Part
		local p = beam(container, frame * a, frame * b, width, color, nil, material or M.SmoothPlastic)
		p.CanCollide, p.CanQuery = false, false
		p.CastShadow = width > 0.06
		return p
	end
	local V = Vector3.new
	-- An invisible root at `frame` keeps the model's pivot on the cage's base,
	-- even while a held copy is carried around welded to a Tool.
	local root = piece(m, V(0.2, 0.2, 0.2), CFrame.new(), WOOD)
	root.Name = "CageRoot"
	root.Transparency, root.CastShadow = 1, false
	m.PrimaryPart = root

	-- Skids, a slatted floor and two weight bars to sink it
	for _, z in { -(hd - 0.1), hd - 0.1 } do
		piece(m, V(size.X + 0.3, 0.16, 0.3), CFrame.new(0, 0.08, z), WOOD_DARK, M.Wood)
	end
	for index, z in { -0.84, -0.28, 0.28, 0.84 } do
		piece(
			m,
			V(size.X, 0.14, 0.48),
			CFrame.new(0, 0.23, z),
			if index % 2 == 0 then WOOD else WOOD:Lerp(WOOD_DARK, 0.3),
			M.WoodPlanks
		)
	end
	for _, x in { -(hw - 0.3), hw - 0.3 } do
		piece(m, V(0.3, 0.14, size.Z - 0.5), CFrame.new(x, floor + 0.07, 0), IRON, M.Metal)
	end

	-- Corner posts and the top and bottom rims
	for _, x in { -hw, hw } do
		for _, z in { -hd, hd } do
			bar(m, V(x, floor, z), V(x, top, z), 0.14, coat)
		end
	end
	for _, y in { floor + 0.04, top } do
		for _, z in { -hd, hd } do
			bar(m, V(-hw, y, z), V(hw, y, z), 0.12, coat)
		end
		for _, x in { -hw, hw } do
			bar(m, V(x, y, -hd), V(x, y, hd), 0.12, coat)
		end
	end
	-- Wire mesh on the long sides and the top
	for _, z in { -hd, hd } do
		for _, x in { -1, -0.5, 0, 0.5, 1 } do
			bar(m, V(x, floor, z), V(x, top, z), 0.05, wire)
		end
		for _, y in { 0.85, 1.4 } do
			bar(m, V(-hw, y, z), V(hw, y, z), 0.05, wire)
		end
	end
	for _, z in { -0.6, 0, 0.6 } do
		bar(m, V(-hw, top, z), V(hw, top, z), 0.05, wire)
	end
	for _, x in { -1.05, -0.45, 0.45, 1.05 } do
		-- The inner pair are the edges of the bait lid.
		local lid = math.abs(x) < 1
		bar(m, V(x, top, -hd), V(x, top, hd), if lid then 0.08 else 0.05, if lid then coat else wire)
	end
	-- A bungee holds the bait lid shut, hooked over the rim
	bar(m, V(0.1, top + 0.06, 0), V(hw, top + 0.03, 0), 0.07, rubber, M.Rubber)
	local function knob(at: Vector3, diameter: number)
		local p = ball(m, frame * at, diameter, IRON, M.Metal)
		p.CanCollide, p.CanQuery = false, false
	end
	knob(V(hw, top, 0), 0.14)

	-- Funnel entrances: a net ring on each end narrowing to a dark throat inside
	for _, side in { -1, 1 } do
		local x, y = side * hw, 1.11
		for _, z in { -0.66, 0.66 } do
			bar(m, V(x, floor, z), V(x, top, z), 0.05, wire)
		end
		for _, rail in { 0.62, 1.6 } do
			bar(m, V(x, rail, -hd), V(x, rail, hd), 0.05, wire)
		end
		local function ring(angle: number): Vector3
			return V(x, y + math.sin(angle) * 0.4, math.cos(angle) * 0.4)
		end
		for k = 0, 7 do
			bar(m, ring(k * TAU / 8), ring((k + 1) * TAU / 8), 0.08, net, M.Fabric)
		end
		local throatX = side * (hw - 0.55)
		local throat = piece(m, V(0.05, 0.36, 0.36), CFrame.new(throatX, y - 0.06, 0), rgb(18, 30, 26), M.Fabric)
		throat.Shape = Enum.PartType.Cylinder
		throat.Transparency = 0.25
		for k = 0, 3 do
			local angle = k * TAU / 4 + TAU / 8
			local inner = V(throatX, y - 0.06 + math.sin(angle) * 0.17, math.cos(angle) * 0.17)
			bar(m, ring(angle), inner, 0.04, net, M.Fabric)
		end
	end

	-- Bait box hung from the lid on a cord
	piece(m, V(0.5, 0.36, 0.36), CFrame.new(0, 1.3, 0), rgb(236, 124, 42), M.SmoothPlastic)
	piece(m, V(0.52, 0.05, 0.38), CFrame.new(0, 1.26, 0), rgb(150, 66, 22), M.SmoothPlastic)
	piece(m, V(0.54, 0.07, 0.4), CFrame.new(0, 1.5, 0), rgb(214, 104, 32), M.SmoothPlastic)
	bar(m, V(0, 1.52, 0), V(0, top, 0), 0.03, net, M.Fabric)

	-- Rope bridle up to a shackle in the middle of the lid
	local shackle = V(0, top + 0.47, 0)
	for _, x in { -hw * 0.6, hw * 0.6 } do
		bar(m, V(x, top, 0), shackle, 0.07, ROPE, M.Fabric)
	end
	knob(shackle, 0.16)

	if float then
		local buoy = newModel("Float", m)
		local water = Props.CRAB_CAGE_WATERLINE
		local at = V(hw + 0.75, water, hd - 0.3)
		-- Upright at the waterline, so the client can bob it about its own middle.
		buoy.WorldPivot = CFrame.new(frame * at)
		local sag = V(hw * 0.5, water + 0.05, 0.4)
		bar(buoy, shackle, sag, 0.07, ROPE, M.Fabric)
		bar(buoy, sag, at + V(-0.45, 0.1, 0), 0.07, ROPE, M.Fabric)
		local function drum(height: number, diameter: number, y: number, color: Color3, material): Part
			local p = piece(
				buoy,
				V(height, diameter, diameter),
				CFrame.new(at + V(0, y, 0)) * CFrame.Angles(0, 0, math.pi / 2),
				color,
				material
			)
			p.Shape = Enum.PartType.Cylinder
			return p
		end
		drum(1.1, 0.95, 0.15, rgb(240, 112, 38), M.SmoothPlastic)
		drum(0.22, 0.98, 0.4, WHITE, M.SmoothPlastic)
		drum(0.14, 0.6, 0.76, rgb(200, 84, 30), M.SmoothPlastic)
		bar(buoy, at + V(0, 0.7, 0), at + V(0, 2.9, 0), 0.09, WOOD_DARK, M.Wood)
		piece(buoy, V(0.04, 0.5, 0.8), CFrame.new(at + V(0, 2.6, 0.42)), rgb(250, 214, 64), M.Fabric).Name = "Flag"
	end
	return m
end

-- A weighted vertical mesh panel suspended below a surface marker.
Props.MUSSEL_NET_SIZE = Vector3.new(2.8, 4.4, 0.3)
Props.MUSSEL_NET_WATERLINE = 5.1
function Props.musselNet(parent: Instance, frame: CFrame, float: boolean?): Model
	local m = newModel("MusselNet", parent)
	local V = Vector3.new
	local function piece(container, size, offset, color, material)
		local p = part(container, size, frame * offset, color, material)
		p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
		return p
	end
	local function cord(container, a, b, width, color)
		local p = beam(container, frame * a, frame * b, width, color, nil, M.Fabric)
		p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
		return p
	end
	local root = piece(m, V(0.2, 0.2, 0.2), CFrame.new(), ROPE, M.Fabric)
	root.Transparency, root.CastShadow = 1, false
	m.PrimaryPart = root
	local netColor = rgb(93, 111, 78)
	-- A single flat curtain of mesh, held open by ropes along its top and bottom.
	for _, x in { -1.2, -0.8, -0.4, 0, 0.4, 0.8, 1.2 } do
		cord(m, V(x, 0.25, 0), V(x, 4.25, 0), 0.055, netColor)
	end
	for y = 0.25, 4.25, 0.4 do
		cord(m, V(-1.2, y, 0), V(1.2, y, 0), 0.055, netColor)
	end
	cord(m, V(-1.3, 0.25, 0), V(1.3, 0.25, 0), 0.12, ROPE)
	cord(m, V(-1.3, 4.25, 0), V(1.3, 4.25, 0), 0.12, ROPE)
	for _, x in { -1.2, 1.2 } do
		cord(m, V(x, 0.25, 0), V(x, 4.25, 0), 0.09, ROPE)
		cord(m, V(x, 4.25, 0), V(0, 4.85, 0), 0.08, ROPE)
		local weight = piece(m, V(0.25, 0.25, 0.25), CFrame.new(x, 0.25, 0), IRON, M.Metal)
		weight.Shape = Enum.PartType.Ball
	end
	if float then
		local buoy = newModel("Float", m)
		local at = V(1.7, Props.MUSSEL_NET_WATERLINE, 0.3)
		buoy.WorldPivot = CFrame.new(frame * at)
		cord(buoy, V(0, 4.85, 0), at, 0.07, ROPE)
		local marker = piece(buoy, V(0.9, 0.9, 0.9), CFrame.new(at), rgb(72, 176, 176), M.SmoothPlastic)
		marker.Shape = Enum.PartType.Ball
		cord(buoy, at, at + V(0, 2, 0), 0.09, ROPE)
		piece(buoy, V(0.05, 0.5, 0.75), CFrame.new(at + V(0, 1.8, 0.38)), rgb(250, 214, 64), M.Fabric).Name = "Flag"
	end
	return m
end

function Props.barrel(parent: Instance, ground: Vector3, rng: Random): Model
	local m = newModel("Barrel", parent)
	local center = ground + Vector3.new(0, 1.5, 0)
	cylinder(m, center, 3, 2.3, shade(WOOD, rng, 0.1), M.WoodPlanks)
	cylinder(m, center + Vector3.new(0, 0.8, 0), 0.3, 2.45, IRON, M.Metal)
	cylinder(m, center - Vector3.new(0, 0.8, 0), 0.3, 2.45, IRON, M.Metal)
	return m
end

function Props.crates(parent: Instance, ground: Vector3, rng: Random): Model
	local m = newModel("Crates", parent)
	local y = ground.Y
	for i = 1, rng:NextInteger(1, 3) do
		local s = rng:NextNumber(2.4, 3.4)
		local offset = if i == 3
			then Vector3.zero
			else Vector3.new(rng:NextNumber(-1.5, 1.5), 0, rng:NextNumber(-1.5, 1.5))
		local at = Vector3.new(ground.X, y + s / 2, ground.Z) + offset
		part(
			m,
			Vector3.new(s, s, s),
			CFrame.new(at) * CFrame.Angles(0, rng:NextNumber(0, TAU), 0),
			shade(WOOD, rng, 0.12),
			M.WoodPlanks
		)
		if i == 2 then
			y += s
		end
	end
	return m
end

function Props.bench(parent: Instance, ground: Vector3, facing: number): Model
	local m = newModel("Bench", parent)
	local base = CFrame.new(ground) * CFrame.Angles(0, facing, 0)
	part(m, Vector3.new(5, 0.4, 1.6), base * CFrame.new(0, 1.6, 0), WOOD, M.WoodPlanks)
	part(m, Vector3.new(5, 1.4, 0.3), base * CFrame.new(0, 2.6, -0.8) * CFrame.Angles(-0.2, 0, 0), WOOD, M.WoodPlanks)
	for side = -1, 1, 2 do
		part(m, Vector3.new(0.4, 1.6, 1.4), base * CFrame.new(side * 2.1, 0.8, 0), IRON, M.Metal)
	end
	return m
end

-- Signpost with an arrow board per entry ({text, angle relative to `facing`}).
function Props.signpost(parent: Instance, ground: Vector3, facing: number, arrows: { { any } }): Model
	local m = newModel("Signpost", parent)
	part(m, Vector3.new(0.6, 8, 0.6), CFrame.new(ground + Vector3.new(0, 4, 0)), WOOD_DARK, M.Wood)
	for i, arrow in arrows do
		local board = part(
			m,
			Vector3.new(5, 1.2, 0.3),
			CFrame.new(ground + Vector3.new(0, 7.4 - i * 1.5, 0))
				* CFrame.Angles(0, facing + arrow[2], 0)
				* CFrame.new(2.4, 0, 0),
			WOOD,
			M.WoodPlanks
		)
		for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
			local gui = Instance.new("SurfaceGui")
			gui.Face = face
			gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			gui.PixelsPerStud = 40
			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.Garamond
			label.TextScaled = true
			label.TextColor3 = rgb(40, 30, 22)
			label.Text = arrow[1]
			label.Parent = gui
			gui.Parent = board
		end
	end
	return m
end

-- Market stall with a striped canopy and a counter of fish; faces its local +Z.
function Props.stall(parent: Instance, ground: Vector3, facing: number, rng: Random, canopy: Color3): Model
	local m = newModel("Stall", parent)
	local base = CFrame.new(ground) * CFrame.Angles(0, facing, 0)
	part(m, Vector3.new(9, 3, 3), base * CFrame.new(0, 1.5, 1.5), WOOD, M.WoodPlanks)
	part(m, Vector3.new(9.4, 0.3, 3.4), base * CFrame.new(0, 3.1, 1.5), WOOD_DARK, M.Wood)
	for _, c in { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } } do
		part(m, Vector3.new(0.5, 8, 0.5), base * CFrame.new(c[1] * 4.3, 4, c[2] * 2.5 + 0.5), WOOD_DARK, M.Wood)
	end
	for i = 0, 4 do
		local stripe = if i % 2 == 0 then canopy else WHITE
		part(
			m,
			Vector3.new(2, 0.3, 7),
			base * CFrame.new(-4 + i * 2, 8.2, 0.5) * CFrame.Angles(0.18, 0, 0),
			stripe,
			M.Fabric
		)
	end
	part(m, Vector3.new(8.6, 1.2, 2.4), base * CFrame.new(0, 3.5, 1.5), rgb(200, 220, 230), M.Ice)
	for k = 1, 4 do
		local fish = base * CFrame.new(-3.5 + k * 1.6, 4.2, 1.5) * CFrame.Angles(0, rng:NextNumber(-0.4, 0.4), 0)
		part(m, Vector3.new(0.6, 0.4, 1.8), fish, shade(rgb(150, 160, 170), rng, 0.15), M.Foil)
	end
	Props.lantern(m, base * CFrame.new(3.8, 6.6, 3.2))
	Props.crates(m, base:PointToWorldSpace(Vector3.new(5.8, 0, -1)), rng)
	return m
end

function Props.well(parent: Instance, ground: Vector3): Model
	local m = newModel("Well", parent)
	cylinder(m, ground + Vector3.new(0, 1.5, 0), 3, 7, STONE, M.Cobblestone)
	cylinder(m, ground + Vector3.new(0, 2.9, 0), 0.4, 5.6, rgb(40, 70, 80), M.Glass)
	for side = -1, 1, 2 do
		part(m, Vector3.new(0.6, 7, 0.6), CFrame.new(ground + Vector3.new(side * 3, 5, 0)), WOOD_DARK, M.Wood)
	end
	part(m, Vector3.new(6.4, 0.4, 0.4), CFrame.new(ground + Vector3.new(0, 6.2, 0)), WOOD_DARK, M.Wood)
	part(m, Vector3.new(1, 1.4, 1), CFrame.new(ground + Vector3.new(0, 5, 0)), WOOD, M.WoodPlanks)
	for side = -1, 1, 2 do
		part(
			m,
			Vector3.new(8, 0.4, 3.4),
			CFrame.new(ground + Vector3.new(0, 8.6, side * 1.4)) * CFrame.Angles(side * 0.5, 0, 0),
			RED,
			M.RoofShingles
		)
	end
	return m
end

-- Two posts with fish hung out to dry.
function Props.fishRack(parent: Instance, ground: Vector3, facing: number, rng: Random): Model
	local m = newModel("FishRack", parent)
	local base = CFrame.new(ground) * CFrame.Angles(0, facing, 0)
	for side = -1, 1, 2 do
		part(m, Vector3.new(0.5, 6, 0.5), base * CFrame.new(side * 4, 3, 0), WOOD_DARK, M.Wood)
	end
	part(m, Vector3.new(8.6, 0.4, 0.4), base * CFrame.new(0, 5.8, 0), WOOD_DARK, M.Wood)
	for k = 1, 4 do
		part(
			m,
			Vector3.new(0.5, 1.8, 0.3),
			base * CFrame.new(-4 + k * 1.6, 4.6, 0),
			shade(rgb(160, 168, 172), rng, 0.15),
			M.Foil
		)
	end
	return m
end

-- Low wooden fence between two points.
function Props.fence(parent: Instance, a: Vector3, b: Vector3): Model
	local m = newModel("Fence", parent)
	local length = (b - a).Magnitude
	local count = math.max(1, math.floor(length / 4))
	for i = 0, count do
		part(m, Vector3.new(0.4, 2.6, 0.4), CFrame.new(a:Lerp(b, i / count) + Vector3.new(0, 1.3, 0)), WOOD, M.Wood)
	end
	for _, y in { 1, 2.1 } do
		beam(m, a + Vector3.new(0, y, 0), b + Vector3.new(0, y, 0), 0.25, WOOD, nil, M.WoodPlanks)
	end
	return m
end

function Props.flag(parent: Instance, ground: Vector3, color: Color3): Model
	local m = newModel("Flag", parent)
	cylinder(m, ground + Vector3.new(0, 9, 0), 18, 0.5, rgb(70, 66, 62), M.Metal)
	part(m, Vector3.new(0.2, 4, 6), CFrame.new(ground + Vector3.new(0, 15.6, 3.2)), color, M.Fabric)
	ball(m, ground + Vector3.new(0, 18.2, 0), 0.9, rgb(200, 170, 80), M.Metal)
	return m
end

----------------------------------------------------------------------------------------------------
-- Beach

-- Striped beach umbrella on a pole stuck in the sand.
function Props.beachUmbrella(parent: Instance, ground: Vector3, rng: Random, color: Color3): Model
	local m = newModel("BeachUmbrella", parent)
	local lean = CFrame.Angles(rng:NextNumber(-0.12, 0.12), 0, rng:NextNumber(-0.12, 0.12))
	local base = CFrame.new(ground) * lean
	local function at(x: number, y: number, z: number): Vector3
		return base:PointToWorldSpace(Vector3.new(x, y, z))
	end
	beam(m, at(0, -1, 0), at(0, 9.4, 0), 0.35, WHITE, nil, M.Metal)
	local apex, inside = at(0, 9.4, 0), at(0, 7, 0)
	for i = 1, 10 do
		local a0, a1 = i / 10 * TAU, (i + 1) / 10 * TAU
		local r0 = at(math.cos(a0) * 5.4, 7.8, math.sin(a0) * 5.4)
		local r1 = at(math.cos(a1) * 5.4, 7.8, math.sin(a1) * 5.4)
		local stripe = if i % 2 == 0 then color else WHITE
		LowPoly.triangle(r0, r1, apex, inside, stripe, m, M.Fabric)
		-- Scalloped valance hanging from the rim
		beam(m, r0 - Vector3.new(0, 0.35, 0), r1 - Vector3.new(0, 0.35, 0), 0.1, stripe, 0.7, M.Fabric)
	end
	ball(m, apex + Vector3.new(0, 0.3, 0), 0.6, WHITE, M.Plastic)
	return m
end

-- Sun lounger with a raised backrest; the foot end points along `facing`.
function Props.sunLounger(parent: Instance, ground: Vector3, facing: number, color: Color3): Model
	local m = newModel("SunLounger", parent)
	local base = CFrame.new(ground) * CFrame.Angles(0, facing, 0)
	part(m, Vector3.new(2.6, 0.3, 4.6), base * CFrame.new(0, 1.2, 1), WHITE, M.Plastic)
	part(m, Vector3.new(2.3, 0.25, 4.4), base * CFrame.new(0, 1.45, 1), color, M.Fabric)
	local back = base * CFrame.new(0, 1.3, -1.3) * CFrame.Angles(0.75, 0, 0) * CFrame.new(0, 0, -1.3)
	part(m, Vector3.new(2.6, 0.3, 2.6), back, WHITE, M.Plastic)
	part(m, Vector3.new(2.3, 0.25, 2.4), back * CFrame.new(0, 0.25, 0), color, M.Fabric)
	part(m, Vector3.new(1.4, 0.45, 0.7), back * CFrame.new(0, 0.5, -0.8), WHITE, M.Fabric)
	for _, x in { -1.1, 1.1 } do
		for _, z in { -1.1, 3 } do
			part(m, Vector3.new(0.25, 1.1, 0.25), base * CFrame.new(x, 0.55, z), WHITE, M.Plastic)
		end
	end
	return m
end

-- Striped towel following the sand's slope, built from adjoining fabric panels.
function Props.towel(parent: Instance, ground: Vector3, facing: number, color: Color3, normal: Vector3?): Model
	local m = newModel("Towel", parent)
	local up = if normal and normal.Magnitude > 0.001 then normal.Unit else Vector3.yAxis
	local right = Vector3.new(math.cos(facing), 0, -math.sin(facing))
	right -= up * right:Dot(up)
	if right.Magnitude < 0.001 then
		right = if math.abs(up.Y) < 0.9 then Vector3.yAxis:Cross(up) else Vector3.zAxis:Cross(up)
	end
	right = right.Unit
	local base = CFrame.fromMatrix(ground, right, up, right:Cross(up))
	local function panel(from: number, to: number, tint: Color3)
		local fabric =
			part(m, Vector3.new(2.8, 0.1, to - from), base * CFrame.new(0, 0.05, (from + to) / 2), tint, M.Fabric)
		fabric.CanCollide = false
		fabric.CanTouch = false
		fabric.CanQuery = false
		fabric.CastShadow = false
	end
	local edge = -2.8
	for _, z in { -2, 0, 2 } do
		panel(edge, z - 0.25, color)
		panel(z - 0.25, z + 0.25, WHITE)
		edge = z + 0.25
	end
	panel(edge, 2.8, color)
	return m
end

-- White lifeguard tower on stilts with a red roof, a ladder at the back and a life ring.
function Props.lifeguardTower(parent: Instance, ground: Vector3, facing: number): Model
	local m = newModel("LifeguardTower", parent)
	local base = CFrame.new(ground) * CFrame.Angles(0, facing, 0)
	local floor = 8
	for _, x in { -2.6, 2.6 } do
		for _, z in { -2.6, 2.6 } do
			beam(
				m,
				base * Vector3.new(x * 1.25, -1, z * 1.25),
				base * Vector3.new(x, floor, z),
				0.6,
				WHITE,
				nil,
				M.Wood
			)
		end
	end
	for _, z in { -3.05, 3.05 } do
		beam(m, base * Vector3.new(-3.05, 2, z), base * Vector3.new(3.05, 2, z), 0.3, WHITE, nil, M.Wood)
	end
	part(m, Vector3.new(7, 0.5, 7), base * CFrame.new(0, floor, 0), WOOD, M.WoodPlanks)
	-- Cabin: low walls round three sides, open toward the sea
	part(m, Vector3.new(6.4, 3, 0.3), base * CFrame.new(0, floor + 1.7, -3.1), WHITE, M.WoodPlanks)
	for side = -1, 1, 2 do
		part(m, Vector3.new(0.3, 3, 6.4), base * CFrame.new(side * 3.1, floor + 1.7, 0), WHITE, M.WoodPlanks)
		part(m, Vector3.new(0.3, 3.6, 0.3), base * CFrame.new(side * 3.1, floor + 5, 3.1), WHITE, M.Wood)
	end
	part(m, Vector3.new(6.4, 1.2, 0.3), base * CFrame.new(0, floor + 0.8, 3.1), RED, M.WoodPlanks)
	part(m, Vector3.new(8, 0.4, 8), base * CFrame.new(0, floor + 7, 0) * CFrame.Angles(0.12, 0, 0), RED, M.WoodPlanks)
	-- Ladder up the back
	local ladderTop, ladderFoot = base * Vector3.new(0, floor, -3.6), base * Vector3.new(0, 0, -7)
	for side = -1, 1, 2 do
		local offset = base:VectorToWorldSpace(Vector3.new(side * 0.9, 0, 0))
		beam(m, ladderFoot + offset, ladderTop + offset, 0.25, WOOD, nil, M.Wood)
	end
	for k = 1, 7 do
		beam(
			m,
			ladderFoot:Lerp(ladderTop, k / 8) + base:VectorToWorldSpace(Vector3.new(-0.9, 0, 0)),
			ladderFoot:Lerp(ladderTop, k / 8) + base:VectorToWorldSpace(Vector3.new(0.9, 0, 0)),
			0.2,
			WOOD,
			nil,
			M.Wood
		)
	end
	Props.lifeRing(m, base * CFrame.new(0, floor + 1.7, 3.3))
	-- Red flag on a pole beside it
	cylinder(m, base * Vector3.new(4.6, 7, -1), 14, 0.3, WHITE, M.Metal)
	part(
		m,
		Vector3.new(0.15, 2, 3),
		CFrame.new(base * Vector3.new(4.6, 13, -1)) * CFrame.Angles(0, facing, 0) * CFrame.new(0, 0, 1.5),
		RED,
		M.Fabric
	)
	return m
end

-- Striped changing cabana with a pointed roof; the doorway faces along `facing`.
function Props.cabana(parent: Instance, ground: Vector3, facing: number, color: Color3): Model
	local m = newModel("Cabana", parent)
	local base = CFrame.new(ground) * CFrame.Angles(0, facing, 0)
	local w, h = 5, 7
	part(m, Vector3.new(w + 1, 0.4, w + 1), base * CFrame.new(0, 0.2, 0), WOOD, M.WoodPlanks)
	for i = 0, 4 do
		local x = -w / 2 + (i + 0.5) * w / 5
		local stripe = if i % 2 == 0 then color else WHITE
		part(m, Vector3.new(w / 5, h, 0.2), base * CFrame.new(x, h / 2 + 0.4, -w / 2), stripe, M.Fabric)
		part(m, Vector3.new(0.2, h, w / 5), base * CFrame.new(w / 2, h / 2 + 0.4, x), stripe, M.Fabric)
		part(m, Vector3.new(0.2, h, w / 5), base * CFrame.new(-w / 2, h / 2 + 0.4, x), stripe, M.Fabric)
	end
	-- Curtains drawn back either side of the door
	for side = -1, 1, 2 do
		part(m, Vector3.new(1.4, h, 0.25), base * CFrame.new(side * 1.8, h / 2 + 0.4, w / 2), color, M.Fabric)
	end
	part(m, Vector3.new(w + 0.4, 0.6, w + 0.4), base * CFrame.new(0, h + 0.7, 0), WHITE, M.Wood)
	local roof = {
		base * Vector3.new(-w / 2 - 0.6, h + 1, -w / 2 - 0.6),
		base * Vector3.new(w / 2 + 0.6, h + 1, -w / 2 - 0.6),
		base * Vector3.new(w / 2 + 0.6, h + 1, w / 2 + 0.6),
		base * Vector3.new(-w / 2 - 0.6, h + 1, w / 2 + 0.6),
	}
	LowPoly.pyramid(roof, base * Vector3.new(0, h + 4.5, 0), color, m, M.Fabric)
	ball(m, base * Vector3.new(0, h + 4.8, 0), 0.6, WHITE, M.Wood)
	return m
end

-- Bleached driftwood log half sunk in the sand, with a stub of branch.
function Props.driftwood(parent: Instance, ground: Vector3, rng: Random): Model
	local m = newModel("Driftwood", parent)
	local a = rng:NextNumber(0, TAU)
	local dir = Vector3.new(math.cos(a), 0, math.sin(a))
	local length = rng:NextNumber(6, 11)
	local color = shade(rgb(196, 182, 160), rng, 0.06)
	local p0, p1 =
		ground - dir * length / 2 + Vector3.new(0, 0.3, 0), ground + dir * length / 2 + Vector3.new(0, 0.5, 0)
	beam(m, p0, p1, rng:NextNumber(0.9, 1.4), color, nil, M.Wood)
	local fork = p0:Lerp(p1, 0.7)
	beam(m, fork, fork + (dir + Vector3.new(-dir.Z, 0.5, dir.X)).Unit * 3, 0.45, color, nil, M.Wood)
	return m
end

-- A scatter of shells and pebbles round `ground`.
function Props.shells(parent: Instance, ground: Vector3, rng: Random): Model
	local m = newModel("Shells", parent)
	local colors = { rgb(246, 228, 214), rgb(236, 190, 170), rgb(214, 196, 168), rgb(250, 244, 236) }
	for _ = 1, rng:NextInteger(4, 8) do
		local p = ground + Vector3.new(rng:NextNumber(-4, 4), 0.1, rng:NextNumber(-4, 4))
		local s = rng:NextNumber(0.35, 0.7)
		local shell = part(
			m,
			Vector3.new(s, s * 0.4, s * 1.2),
			CFrame.new(p) * CFrame.Angles(0, rng:NextNumber(0, TAU), 0),
			shade(Props.pick(rng, colors), rng, 0.05),
			M.Marble
		)
		shell.CanCollide = false
	end
	return m
end

-- Little sandcastle with four towers, a keep and a flag, ringed by a moat.
function Props.sandcastle(parent: Instance, ground: Vector3, color: Color3): Model
	local m = newModel("Sandcastle", parent)
	cylinder(m, ground + Vector3.new(0, 0.05, 0), 0.1, 7.5, rgb(120, 140, 130), M.SmoothPlastic).Transparency = 0.3
	part(m, Vector3.new(4, 1.2, 4), CFrame.new(ground + Vector3.new(0, 0.6, 0)), color, M.Sand)
	for _, x in { -1.8, 1.8 } do
		for _, z in { -1.8, 1.8 } do
			cylinder(m, ground + Vector3.new(x, 1, z), 2, 1.2, color, M.Sand)
			LowPoly.pyramid({
				ground + Vector3.new(x - 0.6, 2, z - 0.6),
				ground + Vector3.new(x + 0.6, 2, z - 0.6),
				ground + Vector3.new(x + 0.6, 2, z + 0.6),
				ground + Vector3.new(x - 0.6, 2, z + 0.6),
			}, ground + Vector3.new(x, 2.8, z), color, m, M.Sand)
		end
	end
	part(m, Vector3.new(1.8, 2.2, 1.8), CFrame.new(ground + Vector3.new(0, 2.3, 0)), color, M.Sand)
	cylinder(m, ground + Vector3.new(0, 4, 0), 1.6, 0.1, WOOD, M.Wood)
	part(m, Vector3.new(0.05, 0.5, 0.8), CFrame.new(ground + Vector3.new(0, 4.5, 0.4)), RED, M.Fabric)
	Props.simplifyDecorationCollision(m)
	return m
end

-- Beach volleyball net between two posts, with a ball lying nearby.
function Props.volleyballNet(parent: Instance, ground: Vector3, facing: number): Model
	local m = newModel("VolleyballNet", parent)
	local base = CFrame.new(ground) * CFrame.Angles(0, facing, 0)
	for side = -1, 1, 2 do
		cylinder(m, base * Vector3.new(side * 9, 4, 0), 9, 0.4, WHITE, M.Metal)
	end
	local net = part(m, Vector3.new(18, 3, 0.1), base * CFrame.new(0, 6.2, 0), rgb(40, 40, 44), M.Fabric)
	net.Transparency = 0.45
	part(m, Vector3.new(18, 0.4, 0.15), base * CFrame.new(0, 7.8, 0), WHITE, M.Fabric)
	-- Court boundary lines meet at the corners without overlapping their top faces.
	for _, z in { -8, 8 } do
		part(m, Vector3.new(18.3, 0.08, 0.3), base * CFrame.new(0, 0.04, z), WHITE, M.Fabric).CanCollide = false
	end
	for _, x in { -9, 9 } do
		part(m, Vector3.new(0.3, 0.08, 15.7), base * CFrame.new(x, 0.04, 0), WHITE, M.Fabric).CanCollide = false
	end
	Props.beachBall(m, base * Vector3.new(3, 0, 4))
	return m
end

-- Beach ball in segments of bright colour.
function Props.beachBall(parent: Instance, ground: Vector3): Model
	local m = newModel("BeachBall", parent)
	ball(m, ground + Vector3.new(0, 0.9, 0), 1.8, WHITE, M.SmoothPlastic)
	local colors = { RED, rgb(240, 200, 50), rgb(40, 110, 190) }
	for i, color in colors do
		local band = part(
			m,
			Vector3.new(0.45, 1.85, 1.85),
			CFrame.new(ground + Vector3.new(0, 0.9, 0)) * CFrame.Angles(0, i / #colors * math.pi, 0),
			color,
			M.SmoothPlastic
		)
		band.Shape = Enum.PartType.Cylinder
	end
	Props.simplifyDecorationCollision(m)
	return m
end

-- Clump of washed-up seaweed along the tide line.
function Props.seaweed(parent: Instance, ground: Vector3, rng: Random): Model
	local m = newModel("Seaweed", parent)
	for _ = 1, rng:NextInteger(3, 6) do
		local p = ground + Vector3.new(rng:NextNumber(-2.5, 2.5), 0.08, rng:NextNumber(-2.5, 2.5))
		local strand = part(
			m,
			Vector3.new(rng:NextNumber(0.5, 1.1), 0.15, rng:NextNumber(2, 4)),
			CFrame.new(p) * CFrame.Angles(0, rng:NextNumber(0, TAU), 0),
			shade(rgb(64, 84, 46), rng, 0.15),
			M.Grass
		)
		strand.CanCollide = false
	end
	Props.simplifyDecorationCollision(m)
	return m
end

----------------------------------------------------------------------------------------------------
-- Volcanic effects

local function anchor(parent: Instance, position: Vector3): Part
	local p = part(parent, Vector3.new(4, 1, 4), CFrame.new(position), LAVA)
	p.Transparency = 1
	p.CanCollide = false
	p.CanQuery = false
	return p
end

local function smoke(parent: BasePart, size: number, rise: number)
	local s = Instance.new("Smoke")
	s.Color = rgb(70, 64, 62)
	s.Opacity = 0.22
	s.Size = size
	s.RiseVelocity = rise
	s.Parent = parent
end

function Props.lavaPool(parent: Instance, ground: Vector3, rng: Random, diameter: number?): Model
	local m = newModel("LavaPool", parent)
	local d = diameter or rng:NextNumber(6, 14)
	cylinder(m, ground + Vector3.new(0, 0.1, 0), 0.3, d + 3, rgb(60, 40, 36), M.CrackedLava)
	local pool = cylinder(m, ground + Vector3.new(0, 0.2, 0), 0.4, d, LAVA, M.Neon)
	light(pool, LAVA, d * 2.5, 2)
	return m
end

-- Glowing ribbon following a list of surface points.
function Props.lavaFlow(parent: Instance, points: { Vector3 })
	local m = newModel("LavaFlow", parent)
	for i = 1, #points - 1 do
		local width = 7 - 4 * i / #points
		local lift = Vector3.new(0, 0.6, 0)
		local p = beam(m, points[i] + lift, points[i + 1] + lift, width, LAVA, 0.5, M.Neon)
		if i % 4 == 1 then
			light(p, LAVA, 40, 1.5)
		end
	end
end

function Props.vent(parent: Instance, ground: Vector3)
	smoke(anchor(parent, ground + Vector3.new(0, 2, 0)), 14, 10)
end

-- Lava lake in a volcano's crater with rising smoke and embers.
function Props.crater(parent: Instance, center: Vector3, radius: number, rimY: number)
	local m = newModel("Crater", parent)
	local lake = cylinder(m, center + Vector3.new(0, 1, 0), 0.6, radius * 2, LAVA, M.Neon)
	light(lake, LAVA, 60, 5)

	local embers = Instance.new("ParticleEmitter")
	embers.Color = ColorSequence.new(rgb(255, 180, 80), rgb(255, 70, 20))
	embers.LightEmission = 1
	embers.Size = NumberSequence.new(0.8, 0)
	embers.Lifetime = NumberRange.new(2, 5)
	embers.Rate = 25
	embers.Speed = NumberRange.new(15, 35)
	embers.SpreadAngle = Vector2.new(25, 25)
	embers.Acceleration = Vector3.new(0, -6, 0)
	embers.Parent = anchor(m, center + Vector3.new(0, 2, 0))

	smoke(anchor(m, Vector3.new(center.X, rimY + 10, center.Z)), 60, 18)
end

return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="241">
          <Properties>
            <string name="Name">Regions</string>
            <string name="Source"><![CDATA[-- Island layouts and set dressing for each biome, plus the open sea between them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Biomes = require(ReplicatedStorage.Shared.Biomes)
local Harbour = require(script.Parent.Harbour)
local CompanyIslands = require(script.Parent.CompanyIslands)
local Islands = require(script.Parent.Islands)
local Props = require(script.Parent.Props)

type Biome = Biomes.Biome
type Palette = Islands.Palette

type Circle = { position: Vector2, radius: number }

export type Context = {
	rng: Random,
	biome: Biome,
	folder: Folder,
	placed: { Circle }, -- shared across all biomes so nothing overlaps
}

type Built = { model: Model, position: Vector2, radius: number, height: number }

type IslandOptions = { shoreLine: number?, elongation: number?, roughness: number? }

local Regions = {}

local Terrain = workspace.Terrain
local TAU = math.pi * 2
local rgb = Color3.fromRGB
local pick = Props.pick

-- Islands reserve a bit more than their radius because shape noise pushes the coast outward.
local FOOTPRINT = 1.35

----------------------------------------------------------------------------------------------------
-- Palettes

local M = Enum.Material

local function mats(top: Enum.Material, cliff: Enum.Material, shore: Enum.Material): Islands.Materials
	return { top = top, cliff = cliff, shore = shore }
end

local NORMAL = {
	land = { top = rgb(98, 116, 78), cliff = rgb(120, 118, 116), shore = rgb(186, 172, 138) },
	rock = {
		top = rgb(108, 108, 104),
		cliff = rgb(120, 118, 116),
		shore = rgb(140, 134, 120),
		materials = mats(M.Rock, M.Slate, M.Pebble),
	},
	pine = rgb(52, 66, 54),
	autumn = { rgb(184, 112, 56), rgb(150, 84, 44), rgb(122, 98, 58), rgb(170, 128, 62) },
	walls = { rgb(232, 226, 212), rgb(214, 196, 150), rgb(188, 92, 70), rgb(220, 214, 200), rgb(200, 170, 96) },
	roofs = { rgb(140, 52, 44), rgb(110, 44, 40), rgb(84, 74, 70) },
}

local SWAMP = {
	land = {
		top = rgb(96, 94, 52),
		cliff = rgb(84, 64, 40),
		shore = rgb(104, 86, 54),
		materials = mats(M.LeafyGrass, M.Mud, M.Mud),
	},
	bark = rgb(74, 50, 36),
	canopy = { rgb(150, 82, 40), rgb(124, 64, 34), rgb(172, 104, 48), rgb(110, 90, 44) },
	snag = rgb(70, 60, 50),
	walls = { rgb(110, 84, 60), rgb(96, 76, 58), rgb(130, 110, 80) },
	roofs = { rgb(70, 60, 50), rgb(90, 70, 50) },
}

local TROPICAL = {
	land = {
		top = rgb(104, 158, 72),
		cliff = rgb(178, 156, 118),
		shore = rgb(238, 224, 184),
		materials = mats(M.LeafyGrass, M.Sandstone, M.Sand),
	},
	sand = {
		top = rgb(240, 228, 190),
		cliff = rgb(220, 204, 160),
		shore = rgb(236, 222, 184),
		materials = mats(M.Sand, M.Sand, M.Sand),
	},
	rock = {
		top = rgb(150, 140, 120),
		cliff = rgb(168, 156, 130),
		shore = rgb(220, 206, 170),
		materials = mats(M.Sandstone, M.Sandstone, M.Sand),
	},
	bush = { rgb(70, 140, 60), rgb(90, 160, 70), rgb(60, 120, 64) },
	coral = { rgb(240, 110, 110), rgb(250, 160, 80), rgb(190, 110, 200), rgb(250, 210, 90), rgb(90, 200, 190) },
	walls = { rgb(150, 116, 80), rgb(170, 136, 96) },
	thatch = rgb(206, 176, 110),
}

local VOLCANIC = {
	land = {
		top = rgb(74, 66, 64),
		cliff = rgb(44, 40, 42),
		shore = rgb(56, 52, 52),
		materials = mats(M.Basalt, M.Basalt, M.Sand),
	},
	scorched = {
		top = rgb(96, 70, 56),
		cliff = rgb(50, 44, 44),
		shore = rgb(60, 56, 54),
		materials = mats(M.Ground, M.Basalt, M.Sand),
	},
	charred = rgb(34, 30, 30),
	basalt = rgb(40, 38, 42),
}

local ICE = {
	snow = {
		top = rgb(234, 240, 245),
		cliff = rgb(142, 160, 176),
		shore = rgb(206, 220, 230),
		materials = mats(M.Snow, M.Rock, M.Snow),
	},
	berg = {
		top = rgb(242, 248, 252),
		cliff = rgb(166, 208, 230),
		shore = rgb(196, 226, 240),
		materials = mats(M.Snow, M.Glacier, M.Ice),
	},
	pine = rgb(46, 64, 62),
	frost = rgb(236, 242, 246),
	shard = rgb(170, 215, 238),
}

----------------------------------------------------------------------------------------------------
-- Placement helpers

local function isFree(placed: { Circle }, position: Vector2, radius: number, gap: number): boolean
	for _, c in placed do
		if (c.position - position).Magnitude < c.radius + radius + gap then
			return false
		end
	end
	return true
end

-- Random open spot for a circle inside the biome, or nil if it is too crowded.
local function findSpot(ctx: Context, radius: number, gap: number, spread: number?): Vector2?
	local area = ctx.biome.radius * (spread or 0.92)
	for _ = 1, 80 do
		local a = ctx.rng:NextNumber(0, TAU)
		local p = ctx.biome.center + Vector2.new(math.cos(a), math.sin(a)) * area * math.sqrt(ctx.rng:NextNumber())
		if isFree(ctx.placed, p, radius, gap) then
			return p
		end
	end
	return nil
end

-- Open spot near one of a few random clump centres, or a lone spot anywhere between `inner` and `outer`.
-- Keeps islands sporadic instead of packing them evenly into whatever ring of water is left.
local function clumpedSpot(
	ctx: Context,
	clumps: { Vector2 },
	inner: number,
	outer: number,
	radius: number,
	gap: number
): Vector2?
	local rng = ctx.rng
	for _ = 1, 80 do
		local p
		if #clumps > 0 and rng:NextNumber() < 0.75 then
			local a = rng:NextNumber(0, TAU)
			local d = (rng:NextNumber() + rng:NextNumber()) * 0.5 * 420
			p = pick(rng, clumps) + Vector2.new(math.cos(a), math.sin(a)) * d
		else
			local a = rng:NextNumber(0, TAU)
			p = ctx.biome.center + Vector2.new(math.cos(a), math.sin(a)) * rng:NextNumber(inner, outer)
		end
		if isFree(ctx.placed, p, radius, gap) then
			return p
		end
	end
	return nil
end

local function island(
	ctx: Context,
	position: Vector2,
	radius: number,
	height: number,
	shape: string,
	palette: Palette,
	options: IslandOptions?
): Built
	local model = Islands.build({
		position = position,
		radius = radius,
		height = height,
		shape = shape,
		palette = palette,
		rng = ctx.rng,
		seaFloor = ctx.biome.shelfDepth or Biomes.SeaFloor,
		shoreLine = options and options.shoreLine,
		elongation = options and options.elongation,
		roughness = options and options.roughness,
	})
	model.Parent = ctx.folder
	table.insert(ctx.placed, { position = position, radius = radius * FOOTPRINT })
	task.wait()
	return { model = model, position = position, radius = radius, height = height }
end

-- Scatters `count` islands of a size range across the biome. Returns the ones that fit.
local function archipelago(
	ctx: Context,
	count: number,
	radii: { number },
	heights: { number },
	shapes: { string },
	palette: Palette,
	options: IslandOptions?,
	locate: ((radius: number, gap: number) -> Vector2?)?
): { Built }
	local built = {}
	for _ = 1, count do
		local radius = ctx.rng:NextNumber(radii[1], radii[2])
		local gap = math.max(25, radius * 0.4)
		local spot = if locate then locate(radius * FOOTPRINT, gap) else findSpot(ctx, radius * FOOTPRINT, gap)
		if spot then
			local height = ctx.rng:NextNumber(heights[1], heights[2])
			table.insert(built, island(ctx, spot, radius, height, pick(ctx.rng, shapes), palette, options))
		end
	end
	return built
end

local function isClear(taken: { Vector3 }, point: Vector3, spacing: number): boolean
	for _, other in taken do
		if Vector2.new(other.X - point.X, other.Z - point.Z).Magnitude < spacing then
			return false
		end
	end
	return true
end

-- Calls `place` at up to `count` flat spots on an island at or above `minHeight`.
local function scatterOn(
	ctx: Context,
	built: Built,
	count: number,
	minHeight: number,
	spacing: number,
	place: (Vector3) -> (),
	taken: { Vector3 }?
)
	local spots = taken or {}
	local done = 0
	for _ = 1, count * 6 do
		if done >= count then
			break
		end
		local a = ctx.rng:NextNumber(0, TAU)
		local d = built.radius * 1.1 * math.sqrt(ctx.rng:NextNumber())
		local ground, normal =
			Islands.surface(built.model, built.position.X + math.cos(a) * d, built.position.Y + math.sin(a) * d)
		if ground and normal and ground.Y >= minHeight and normal.Y > 0.8 and isClear(spots, ground, spacing) then
			table.insert(spots, ground)
			place(ground)
			done += 1
		end
	end
end

-- Roughly how many props fit on an island's usable top at a given density (per 1000 square studs).
local function areaCount(built: Built, density: number, cap: number): number
	return math.min(math.floor(math.pi * (built.radius * 0.7) ^ 2 / 1000 * density), cap)
end

-- Random points of open water in the biome (away from islands).
local function openWater(ctx: Context, count: number, spacing: number, place: (Vector3) -> ())
	for _ = 1, count do
		local spot = findSpot(ctx, spacing, 0, 0.95)
		if spot then
			table.insert(ctx.placed, { position = spot, radius = spacing * 0.5 })
			place(Vector3.new(spot.X, Biomes.WaterLevel, spot.Y))
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Gullhaven Sound: temperate home waters around the harbour isle

local function forest(ctx: Context, built: Built, density: number, cap: number, autumnShare: number)
	local rng = ctx.rng
	scatterOn(ctx, built, areaCount(built, density, cap), 4, 8, function(ground)
		if rng:NextNumber() < autumnShare then
			Props.broadleaf(built.model, ground, rng, NORMAL.autumn)
		else
			Props.pine(built.model, ground, rng, NORMAL.pine)
		end
	end)
end

function Regions.normal(ctx: Context, onHarbourReady: ((CFrame) -> ())?): CFrame
	local rng = ctx.rng
	local spawn = Harbour.build(ctx.folder, rng, ctx.biome.center)
	table.insert(ctx.placed, { position = ctx.biome.center, radius = Harbour.FOOTPRINT })
	CompanyIslands.reserve(ctx.placed)
	CompanyIslands.ensure(ctx.folder.Parent)
	-- The complete home island has collision, bases, both shops and launch docks.
	-- Surrounding scenery must not hold up the player's first spawn.
	if onHarbourReady then
		onHarbourReady(spawn)
	end

	-- The harbour fills most of the biome, so scenery lives in a few random clumps out past it
	-- (spilling into the open sea) rather than in an even ring hugging its coast.
	local clumps = {}
	for _ = 1, rng:NextInteger(2, 4) do
		local a = rng:NextNumber(0, TAU)
		table.insert(clumps, ctx.biome.center + Vector2.new(math.cos(a), math.sin(a)) * rng:NextNumber(1350, 1850))
	end
	local function locate(radius: number, gap: number): Vector2?
		return clumpedSpot(ctx, clumps, 1100, 2050, radius, gap)
	end

	-- Tall crags crowned with pines, like the cliffs guarding the harbour
	for _, crag in archipelago(ctx, 2, { 110, 160 }, { 80, 120 }, { "stack" }, NORMAL.land, { roughness = 0.3 }, locate) do
		forest(ctx, crag, 3, 40, 0.2)
	end
	for _, isle in archipelago(ctx, 4, { 100, 190 }, { 22, 60 }, { "plateau", "peak" }, NORMAL.land, nil, locate) do
		forest(ctx, isle, 2.5, 60, 0.4)
		scatterOn(ctx, isle, 4, 2, 20, function(ground)
			Props.boulder(isle.model, ground, rng, rng:NextNumber(3, 6), NORMAL.rock.cliff)
		end)
	end
	-- Keep the substantial wooded islands; the former 22 little rocks and
	-- islets leave room for company properties and clear shipping lanes.

	return spawn
end

----------------------------------------------------------------------------------------------------
-- The Sodden Mire: shallow murky water, mangroves and stilt shacks

local function mangrove(ctx: Context, parent: Instance, ground: Vector3, floorY: number)
	Props.mangrove(parent, ground, ctx.rng, floorY, SWAMP.bark, SWAMP.canopy)
end

local function swampIsland(ctx: Context, built: Built, density: number, cap: number)
	local rng = ctx.rng
	scatterOn(ctx, built, areaCount(built, density, cap), 1, 10, function(ground)
		if rng:NextNumber() < 0.75 then
			mangrove(ctx, built.model, ground, ground.Y - 2)
		else
			Props.deadTree(built.model, ground, rng, SWAMP.snag)
		end
	end)
end

function Regions.swamp(ctx: Context)
	local rng = ctx.rng
	local options = { shoreLine = 1, roughness = 0.5 }

	local heart = island(ctx, ctx.biome.center, 340, 9, "mound", SWAMP.land, options)
	local taken = {}
	scatterOn(ctx, heart, 8, 3, 30, function(ground)
		local wall, roof = pick(rng, SWAMP.walls), pick(rng, SWAMP.roofs)
		Props.house(heart.model, ground, rng:NextNumber(0, TAU), rng, wall, roof, 4)
	end, taken)
	scatterOn(ctx, heart, 60, 1, 10, function(ground)
		if rng:NextNumber() < 0.8 then
			mangrove(ctx, heart.model, ground, ground.Y - 2)
		else
			Props.deadTree(heart.model, ground, rng, SWAMP.snag)
		end
	end, taken)

	for _, isle in archipelago(ctx, 8, { 80, 160 }, { 5, 9 }, { "mound" }, SWAMP.land, options) do
		swampIsland(ctx, isle, 1.5, 18)
	end
	for _, isle in archipelago(ctx, 24, { 16, 50 }, { 3, 6 }, { "mound" }, SWAMP.land, options) do
		swampIsland(ctx, isle, 2, 3)
	end

	-- Mangroves standing straight out of the shallows
	local shelf = ctx.biome.shelfDepth or Biomes.SeaFloor
	openWater(ctx, 170, 10, function(water)
		mangrove(ctx, ctx.folder, water, shelf)
	end)
	openWater(ctx, 130, 6, function(water)
		Props.reeds(ctx.folder, water, rng)
	end)
	openWater(ctx, 200, 4, function(water)
		Props.lilyPad(ctx.folder, water, rng)
	end)
end

----------------------------------------------------------------------------------------------------
-- Coral Shallows: turquoise water, atolls, sandbars and palms

local function palms(ctx: Context, built: Built, count: number)
	local rng = ctx.rng
	scatterOn(ctx, built, count, 1.2, 8, function(ground)
		if rng:NextNumber() < 0.75 then
			Props.palm(built.model, ground, rng)
		else
			Props.bush(built.model, ground, rng, TROPICAL.bush)
		end
	end)
end

function Regions.tropical(ctx: Context)
	local rng = ctx.rng

	local lagoon = island(ctx, ctx.biome.center, 420, 7, "atoll", TROPICAL.land, { elongation = 0.1, roughness = 0.3 })
	local taken = {}
	scatterOn(ctx, lagoon, 6, 2, 40, function(ground)
		Props.house(lagoon.model, ground, rng:NextNumber(0, TAU), rng, pick(rng, TROPICAL.walls), TROPICAL.thatch, 3)
	end, taken)
	scatterOn(ctx, lagoon, 90, 1.2, 8, function(ground)
		if rng:NextNumber() < 0.7 then
			Props.palm(lagoon.model, ground, rng)
		else
			Props.bush(lagoon.model, ground, rng, TROPICAL.bush)
		end
	end, taken)

	for _, atoll in archipelago(ctx, 4, { 120, 200 }, { 5, 7 }, { "atoll" }, TROPICAL.land, { roughness = 0.3 }) do
		palms(ctx, atoll, 25)
	end
	for _, isle in archipelago(ctx, 5, { 80, 140 }, { 14, 30 }, { "mound", "peak" }, TROPICAL.land) do
		palms(ctx, isle, areaCount(isle, 2.5, 30))
	end
	for _, bar in archipelago(ctx, 20, { 16, 45 }, { 1.6, 3 }, { "mound" }, TROPICAL.sand, { shoreLine = 99 }) do
		palms(ctx, bar, rng:NextInteger(0, 3))
	end
	archipelago(ctx, 14, { 6, 18 }, { 6, 20 }, { "stack" }, TROPICAL.rock, { roughness = 0.5 })

	-- Coral gardens on the sandy shelf, visible through the clear water
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { Terrain }
	params.IgnoreWater = true
	for _ = 1, 280 do
		local a = rng:NextNumber(0, TAU)
		local d = ctx.biome.radius * 0.95 * math.sqrt(rng:NextNumber())
		local p = ctx.biome.center + Vector2.new(math.cos(a), math.sin(a)) * d
		local hit = workspace:Raycast(Vector3.new(p.X, -1, p.Y), Vector3.new(0, -80, 0), params)
		if hit and hit.Material ~= Enum.Material.Water and hit.Position.Y < -4 then
			Props.coral(ctx.folder, hit.Position, rng, TROPICAL.coral)
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Cinder Isles: black rock, a smoking volcano and rivers of lava

local function surfacePath(built: Built, angle: number, from: number, to: number, rng: Random): { Vector3 }
	local points = {}
	local wobble = 0
	for t = from, to, 0.04 do
		wobble += rng:NextNumber(-0.04, 0.04)
		local a = angle + wobble
		local ground = Islands.surface(
			built.model,
			built.position.X + math.cos(a) * built.radius * t,
			built.position.Y + math.sin(a) * built.radius * t
		)
		if not ground or ground.Y < 0 then
			break
		end
		table.insert(points, ground)
	end
	return points
end

function Regions.volcanic(ctx: Context)
	local rng = ctx.rng

	local volcano = island(ctx, ctx.biome.center, 440, 240, "volcano", VOLCANIC.land, {
		shoreLine = 3,
		elongation = 0.1,
		roughness = 0.25,
	})
	local center = Vector3.new(volcano.position.X, 0, volcano.position.Y)
	local floor = Islands.surface(volcano.model, center.X, center.Z)
	if floor then
		Props.crater(volcano.model, floor + Vector3.new(0, 3, 0), volcano.radius * 0.13, volcano.height)
	end
	for i = 1, 4 do
		local path = surfacePath(volcano, i / 4 * TAU + rng:NextNumber(-0.4, 0.4), 0.26, 0.9, rng)
		if #path > 1 then
			Props.lavaFlow(volcano.model, path)
		end
	end
	scatterOn(ctx, volcano, 18, 4, 14, function(ground)
		Props.deadTree(volcano.model, ground, rng, VOLCANIC.charred)
	end)
	scatterOn(ctx, volcano, 10, 2, 20, function(ground)
		Props.basalt(volcano.model, ground, rng, VOLCANIC.basalt)
	end)

	for _, isle in archipelago(ctx, 6, { 90, 170 }, { 40, 100 }, { "peak", "stack" }, VOLCANIC.scorched) do
		scatterOn(ctx, isle, 4, 2, 15, function(ground)
			Props.basalt(isle.model, ground, rng, VOLCANIC.basalt)
		end)
		scatterOn(ctx, isle, 3, 4, 20, function(ground)
			Props.lavaPool(isle.model, ground, rng)
		end)
		scatterOn(ctx, isle, 6, 4, 10, function(ground)
			Props.deadTree(isle.model, ground, rng, VOLCANIC.charred)
		end)
		scatterOn(ctx, isle, 1, 4, 1, function(ground)
			Props.vent(isle.model, ground)
		end)
	end
	for _, isle in archipelago(ctx, 18, { 25, 65 }, { 15, 50 }, { "stack", "peak" }, VOLCANIC.land) do
		scatterOn(ctx, isle, 1, 2, 1, function(ground)
			Props.basalt(isle.model, ground, rng, VOLCANIC.basalt)
		end)
	end
	-- Jagged spires
	archipelago(ctx, 34, { 6, 18 }, { 8, 34 }, { "stack" }, VOLCANIC.land, { roughness = 0.6 })
end

----------------------------------------------------------------------------------------------------
-- Frostmere Expanse: snowy islands, icebergs and drifting floes

local function snowForest(ctx: Context, built: Built, density: number, cap: number)
	local rng = ctx.rng
	scatterOn(ctx, built, areaCount(built, density, cap), 4, 8, function(ground)
		Props.pine(built.model, ground, rng, ICE.pine, ICE.frost)
	end)
end

local function shards(ctx: Context, built: Built, count: number)
	local rng = ctx.rng
	scatterOn(ctx, built, count, 3, 12, function(ground)
		Props.spike(built.model, ground, rng, rng:NextNumber(10, 26), rng:NextNumber(2.5, 4.5), ICE.shard)
	end)
end

function Regions.ice(ctx: Context)
	local glacier = island(ctx, ctx.biome.center, 360, 40, "plateau", ICE.snow, { elongation = 0.2 })
	snowForest(ctx, glacier, 2, 70)
	shards(ctx, glacier, 8)

	for _, isle in archipelago(ctx, 4, { 100, 170 }, { 30, 70 }, { "plateau", "peak" }, ICE.snow) do
		snowForest(ctx, isle, 2, 25)
	end
	for _, berg in archipelago(ctx, 9, { 60, 150 }, { 22, 55 }, { "berg" }, ICE.berg, { roughness = 0.5 }) do
		shards(ctx, berg, ctx.rng:NextInteger(1, 3))
	end
	archipelago(ctx, 20, { 18, 55 }, { 8, 28 }, { "berg", "stack" }, ICE.berg, { roughness = 0.5 })
	-- Flat floes drifting between the bergs
	archipelago(ctx, 50, { 6, 22 }, { 0.8, 1.6 }, { "mound" }, ICE.berg, { shoreLine = -1, roughness = 0.6 })
end

----------------------------------------------------------------------------------------------------
-- Open sea between the biomes: lone sea stacks and channel buoys

function Regions.openSea(ctx: Context)
	local rng = ctx.rng
	local limit = Biomes.MapHalfSize - 300

	local function outsideBiomes(p: Vector2): boolean
		-- Keep small stacks away from the company ring and its shipping lanes,
		-- matching the nearby-scenery cleanup applied to older baked maps.
		if (p - Biomes.Normal.center).Magnitude < 2300 then return false end
		for _, biome in Biomes.list do
			if (p - biome.center).Magnitude < biome.radius then
				return false
			end
		end
		return true
	end

	local stacks = 0
	for _ = 1, 2000 do
		if stacks >= 28 then
			break
		end
		local p = Vector2.new(rng:NextNumber(-limit, limit), rng:NextNumber(-limit, limit))
		local radius = rng:NextNumber(8, 40)
		if outsideBiomes(p) and isFree(ctx.placed, p, radius * FOOTPRINT, 60) then
			local palette = if rng:NextNumber() < 0.3 then NORMAL.land else NORMAL.rock
			local stack = island(ctx, p, radius, rng:NextNumber(10, 55), pick(rng, { "stack", "peak" }), palette)
			if palette == NORMAL.land then
				forest(ctx, stack, 2, 4, 0)
			end
			stacks += 1
		end
	end

	-- Buoys marking the routes out from the Sound to each biome
	for _, biome in Biomes.list do
		if biome ~= Biomes.Normal then
			local route = biome.center - Biomes.Normal.center
			local across = Vector2.new(-route.Y, route.X).Unit
			for _, t in { 0.42, 0.5, 0.58 } do
				for _, side in { -1, 1 } do
					local p = Biomes.Normal.center + route * t + across * side * 50
					if isFree(ctx.placed, p, 6, 4) then
						Props.buoy(ctx.folder, Vector3.new(p.X, 0, p.Y), rng)
					end
				end
			end
		end
	end
end

return Regions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="242">
          <Properties>
            <string name="Name">RodShop</string>
            <string name="Source"><![CDATA[-- Tide & Tackle, the rod store on the west side of the piazza. Outside it is one of the plaza's
-- two-tone townhouses with a shopfront; its street door leads into a two-level hall built away
-- from the map, with a gallery round three sides under open roof trusses. The hall's exit leads
-- back out onto the square. The same versioned builder repairs saved Studio maps at startup.
local CollectionService = game:GetService("CollectionService")

local LowPoly = require(script.Parent.LowPoly)
local PlazaHouses = require(script.Parent.PlazaHouses)
local Props = require(script.Parent.Props)

local RodShop = {}
local LAYOUT_VERSION = 3
local INTERIOR_VERSION = 6
local TAU = math.pi * 2
local rgb = Color3.fromRGB
local M = Enum.Material

-- 1500 studs past the ocean's edge (Biomes.MapHalfSize is 5200), where nothing else is ever built
local INTERIOR_ORIGIN = CFrame.new(6700, 300, 0)
local W, D = 56, 44 -- inner floor of the hall
local GALLERY = 12 -- height of the gallery deck
local EAVES = 24 -- top of the side walls
local RIDGE = 34

local YELLOW = rgb(244, 196, 76)
local MINT = rgb(156, 214, 192)
local FLOOR_WOOD = rgb(150, 104, 64)
local WOOD = rgb(184, 132, 72)
local BEAM = rgb(150, 100, 52)
local DARK_WOOD = rgb(102, 70, 44)
local GREEN_DOOR = rgb(84, 160, 70)
local DOOR_FRAME = rgb(214, 196, 150)
local WINDOW_FRAME = rgb(58, 112, 52)
local DAYLIGHT = rgb(255, 238, 176)
local CREAM = rgb(255, 245, 213)
local IRON = rgb(50, 57, 57)
local LAMP = rgb(255, 214, 150)
local LEAF = { rgb(86, 170, 60), rgb(110, 196, 70), rgb(70, 146, 52) }

local function interiorFolder(): Folder
	local folder = workspace:FindFirstChild("Interiors")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Interiors"
		folder.Parent = workspace
	end
	return folder :: Folder
end

local function doorPrompt(parent: BasePart, action: string, destination: CFrame): ProximityPrompt
	local prompt = parent:FindFirstChild("RodStoreDoorPrompt") :: ProximityPrompt?
	if not prompt then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = "RodStoreDoorPrompt"
		prompt.ObjectText = "Tide & Tackle"
		prompt.MaxActivationDistance = 9
		prompt.RequiresLineOfSight = false
		prompt.HoldDuration = 0
		prompt.Parent = parent
	end
	local p = prompt :: ProximityPrompt
	p.ActionText = action
	p:SetAttribute("TeleportTo", destination)
	return p
end

----------------------------------------------------------------------------------------------------
-- Interior

local function buildInterior(): Model
	local o = INTERIOR_ORIGIN
	local hall = Instance.new("Model")
	hall.Name = "RodStoreInterior"
	hall:SetAttribute("LayoutVersion", INTERIOR_VERSION)
	hall:SetAttribute("InteriorFrame", o * CFrame.new(0, RIDGE / 2, 0))
	hall:SetAttribute("InteriorSize", Vector3.new(W, RIDGE, D))
	hall:SetAttribute("ArrivalFrame", o * CFrame.new(0, 3.2, -D / 2 + 5) * CFrame.Angles(0, math.pi, 0))
	-- Stream the whole hall in at once so nobody arrives on a half-loaded floor
	hall.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	local rng = Random.new(2811)

	local function part(name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
		local piece = Props.part(hall, size, o * cf, color, material or M.Wood)
		piece.Name = name
		return piece
	end
	local function deco(name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
		local piece = part(name, size, cf, color, material)
		piece.CanCollide = false
		return piece
	end
	local function beam(name: string, a: Vector3, b: Vector3, width: number, color: Color3, thickness: number?): Part
		local piece = Props.beam(hall, o * a, o * b, width, color, thickness, M.Wood)
		piece.Name = name
		return piece
	end
	local function glow(piece: BasePart, color: Color3, range: number, brightness: number)
		Props.light(piece, color, range, brightness)
	end
	-- Frame on a wall's inner face at `pos`, with +Z pointing into the room along `normal`
	local function onWall(pos: Vector3, normal: Vector3): CFrame
		return CFrame.lookAt(pos, pos - normal)
	end
	local function disc(name: string, face: CFrame, diameter: number, thickness: number, color: Color3, material)
		local piece = part(
			name,
			Vector3.new(thickness, diameter, diameter),
			face * CFrame.Angles(0, math.pi / 2, 0),
			color,
			material
		)
		piece.Shape = Enum.PartType.Cylinder
		piece.CanCollide = false
		return piece
	end

	-- Shell: plank floor, yellow lower walls, mint upper walls, gables and a tiled roof
	part("Floor", Vector3.new(W + 2, 1, D + 2), CFrame.new(0, -0.5, 0), FLOOR_WOOD, M.WoodPlanks)
	for i = -3, 3 do
		deco("FloorBoardLine", Vector3.new(0.12, 0.02, D), CFrame.new(i * 8, 0.01, 0), DARK_WOOD, M.Wood)
	end
	for _, side in { -1, 1 } do
		part(
			"SideWallLower",
			Vector3.new(1, GALLERY, D + 2),
			CFrame.new(side * (W / 2 + 0.5), GALLERY / 2, 0),
			YELLOW,
			M.Plaster
		)
		part(
			"SideWallUpper",
			Vector3.new(1, EAVES - GALLERY, D + 2),
			CFrame.new(side * (W / 2 + 0.5), (GALLERY + EAVES) / 2, 0),
			MINT,
			M.Plaster
		)
		part(
			"EndWallLower",
			Vector3.new(W, GALLERY, 1),
			CFrame.new(0, GALLERY / 2, side * (D / 2 + 0.5)),
			YELLOW,
			M.Plaster
		)
		part(
			"EndWallUpper",
			Vector3.new(W, EAVES - GALLERY, 1),
			CFrame.new(0, (GALLERY + EAVES) / 2, side * (D / 2 + 0.5)),
			MINT,
			M.Plaster
		)
		for _, x in { -1, 1 } do
			LowPoly.triangle(
				(o * Vector3.new(x * (W / 2 + 1), EAVES, side * (D / 2 + 0.5))),
				(o * Vector3.new(0, RIDGE + 0.5, side * (D / 2 + 0.5))),
				(o * Vector3.new(0, EAVES, side * (D / 2 + 0.5))),
				o * Vector3.new(0, EAVES, 0),
				MINT,
				hall,
				M.Plaster,
				1
			)
		end
		-- Wainscot and the dado rail round the ground floor
		part("Wainscot", Vector3.new(0.2, 3, D), CFrame.new(side * (W / 2 - 0.1), 1.5, 0), WOOD, M.WoodPlanks)
		part("Wainscot", Vector3.new(W, 3, 0.2), CFrame.new(0, 1.5, side * (D / 2 - 0.1)), WOOD, M.WoodPlanks)
		local slope = math.atan2(RIDGE - EAVES, W / 2)
		local run = math.sqrt((W / 2 + 2) ^ 2 + (RIDGE - EAVES) ^ 2)
		part(
			"Roof",
			Vector3.new(run, 1, D + 4),
			CFrame.new(side * W / 4, (EAVES + RIDGE) / 2 + 0.8, 0) * CFrame.Angles(0, 0, -side * slope),
			rgb(176, 98, 64),
			M.WoodPlanks
		)
	end

	-- Exposed trusses: tie beam, king post, rafters and struts, with purlins along the slopes
	for _, z in { -16, -5.5, 5.5, 16 } do
		beam("TieBeam", Vector3.new(-W / 2, EAVES, z), Vector3.new(W / 2, EAVES, z), 1.1, BEAM)
		beam("KingPost", Vector3.new(0, EAVES, z), Vector3.new(0, RIDGE, z), 0.9, BEAM)
		for _, side in { -1, 1 } do
			beam("Rafter", Vector3.new(side * W / 2, EAVES, z), Vector3.new(0, RIDGE, z), 1, BEAM)
			beam(
				"Strut",
				Vector3.new(0, EAVES + 1, z),
				Vector3.new(side * W / 4, EAVES + (RIDGE - EAVES) / 2, z),
				0.6,
				BEAM
			)
		end
	end
	beam("Ridge", Vector3.new(0, RIDGE, -D / 2), Vector3.new(0, RIDGE, D / 2), 1.1, BEAM)
	for _, side in { -1, 1 } do
		for _, t in { 0.35, 0.7 } do
			local x, y = side * W / 2 * (1 - t), EAVES + (RIDGE - EAVES) * t
			beam("Purlin", Vector3.new(x, y, -D / 2), Vector3.new(x, y, D / 2), 0.7, BEAM)
		end
	end

	-- Gallery decks round the back and sides, held up on posts and edge beams
	local inner = W / 2 - 7
	local backEdge = D / 2 - 8
	part("GalleryBack", Vector3.new(W, 0.8, 8), CFrame.new(0, GALLERY - 0.4, D / 2 - 4), WOOD, M.WoodPlanks)
	for _, side in { -1, 1 } do
		part(
			"GallerySide",
			Vector3.new(7, 0.8, backEdge + 6),
			CFrame.new(side * (inner + 3.5), GALLERY - 0.4, (backEdge - 6) / 2),
			WOOD,
			M.WoodPlanks
		)
		beam(
			"GalleryEdgeBeam",
			Vector3.new(side * inner, GALLERY - 1.2, -6),
			Vector3.new(side * inner, GALLERY - 1.2, backEdge),
			1,
			BEAM
		)
		for _, z in { -6, 4, backEdge } do
			part(
				"GalleryPost",
				Vector3.new(1, GALLERY - 0.8, 1),
				CFrame.new(side * inner, (GALLERY - 0.8) / 2, z),
				BEAM
			)
		end
	end
	beam(
		"GalleryEdgeBeam",
		Vector3.new(-inner, GALLERY - 1.2, backEdge),
		Vector3.new(inner, GALLERY - 1.2, backEdge),
		1,
		BEAM
	)
	for _, x in { -11, 11 } do
		part("GalleryPost", Vector3.new(1, GALLERY - 0.8, 1), CFrame.new(x, (GALLERY - 0.8) / 2, backEdge), BEAM)
	end
	-- Turned balusters under a handrail along every open edge
	local function balustrade(a: Vector3, b: Vector3)
		local length = (b - a).Magnitude
		local dir = (b - a).Unit
		for k = 0, math.floor(length / 1.25) do
			local p = a + dir * (k * 1.25) + Vector3.new(0, GALLERY + 1.5, 0)
			part("Baluster", Vector3.new(0.4, 3, 0.4), CFrame.new(p), WOOD)
			deco("BalusterBulb", Vector3.new(0.65, 0.7, 0.65), CFrame.new(p + Vector3.new(0, -0.3, 0)), WOOD)
		end
		beam("Handrail", a + Vector3.new(0, GALLERY + 3.2, 0), b + Vector3.new(0, GALLERY + 3.2, 0), 0.6, BEAM, 0.45)
		beam("BottomRail", a + Vector3.new(0, GALLERY + 0.2, 0), b + Vector3.new(0, GALLERY + 0.2, 0), 0.5, BEAM, 0.3)
	end
	balustrade(Vector3.new(-inner, 0, backEdge), Vector3.new(inner, 0, backEdge))
	for _, side in { -1, 1 } do
		balustrade(Vector3.new(side * inner, 0, -6), Vector3.new(side * inner, 0, backEdge))
	end
	balustrade(Vector3.new(-W / 2, 0, -6), Vector3.new(-inner, 0, -6))

	-- Stairs up the right-hand wall arrive at the open front end of that gallery
	local steps = 15
	local rise = GALLERY / steps
	for i = 1, steps do
		part(
			"Stair",
			Vector3.new(6.5, i * rise, 1),
			CFrame.new(inner + 3.5, i * rise / 2, -6 - (steps - i) - 0.5),
			WOOD,
			M.WoodPlanks
		)
		deco(
			"StairNosing",
			Vector3.new(6.5, 0.15, 0.2),
			CFrame.new(inner + 3.5, i * rise + 0.02, -6 - (steps - i) - 0.95),
			DARK_WOOD
		)
	end
	beam("StairRail", Vector3.new(inner, 3.2, -6 - steps), Vector3.new(inner, GALLERY + 3.2, -6), 0.5, BEAM, 0.45)
	for k = 0, steps - 1, 2 do
		local y = (k + 1) * rise
		part("StairBaluster", Vector3.new(0.35, 3, 0.35), CFrame.new(inner, y + 1.5, -6 - steps + k + 0.5), WOOD)
	end

	-- Windows of small green panes and arched green doors, as on a harbour warehouse
	local function gridWindow(face: CFrame, width: number, height: number)
		deco(
			"WindowSurround",
			Vector3.new(width + 1, height + 1, 0.2),
			face * CFrame.new(0, 0, 0.1),
			DOOR_FRAME,
			M.Limestone
		)
		deco(
			"WindowArch",
			Vector3.new(0.2, width + 1, width + 1),
			face * CFrame.new(0, height / 2, 0.1) * CFrame.Angles(0, math.pi / 2, 0),
			DOOR_FRAME,
			M.Limestone
		).Shape =
			Enum.PartType.Cylinder
		local pane =
			deco("WindowLight", Vector3.new(width, height, 0.2), face * CFrame.new(0, 0, 0.22), DAYLIGHT, M.Neon)
		disc("WindowLightArch", face * CFrame.new(0, height / 2, 0.22), width, 0.2, DAYLIGHT, M.Neon)
		for i = 1, 3 do
			deco(
				"WindowBar",
				Vector3.new(0.18, height + width / 2, 0.3),
				face * CFrame.new(-width / 2 + i * width / 4, width / 4, 0.36),
				WINDOW_FRAME
			)
		end
		for j = 1, 4 do
			deco(
				"WindowBar",
				Vector3.new(width, 0.18, 0.3),
				face * CFrame.new(0, -height / 2 + j * height / 4, 0.36),
				WINDOW_FRAME
			)
		end
		deco(
			"WindowSill",
			Vector3.new(width + 1.6, 0.35, 0.9),
			face * CFrame.new(0, -height / 2 - 0.5, 0.4),
			DOOR_FRAME,
			M.Limestone
		)
		return pane
	end
	local function archDoor(face: CFrame, width: number, height: number): Part
		deco(
			"DoorSurround",
			Vector3.new(width + 1.6, height, 0.25),
			face * CFrame.new(0, height / 2, 0.12),
			DOOR_FRAME,
			M.Limestone
		)
		disc("DoorSurroundArch", face * CFrame.new(0, height, 0.12), width + 1.6, 0.25, DOOR_FRAME, M.Limestone)
		local leaf = part(
			"DoorLeaf",
			Vector3.new(width, height, 0.3),
			face * CFrame.new(0, height / 2, 0.35),
			GREEN_DOOR,
			M.WoodPlanks
		)
		disc("DoorLeafArch", face * CFrame.new(0, height, 0.35), width, 0.3, GREEN_DOOR, M.WoodPlanks)
		for i = 1, 3 do
			deco(
				"DoorPlank",
				Vector3.new(0.12, height + width / 2 - 0.4, 0.4),
				face * CFrame.new(-width / 2 + i * width / 4, height / 2 + width / 4 - 0.2, 0.42),
				rgb(64, 130, 54)
			)
		end
		for _, y in { 0.25, 0.75 } do
			deco(
				"DoorStrap",
				Vector3.new(width * 0.7, 0.4, 0.45),
				face * CFrame.new(-width * 0.12, height * y, 0.45),
				DOOR_FRAME,
				M.Metal
			)
		end
		deco(
			"DoorHandle",
			Vector3.new(0.4, 1.4, 0.35),
			face * CFrame.new(width * 0.3, height * 0.45, 0.62),
			DOOR_FRAME,
			M.Metal
		)
		return leaf
	end

	-- Front wall: the way out between two tall windows, and windows above the gallery line
	local front = onWall(Vector3.new(0, 0, -D / 2), Vector3.new(0, 0, 1))
	local exit = archDoor(front, 6, 9)
	for _, x in { -14, 14 } do
		local glass = gridWindow(front * CFrame.new(x, 6, 0), 5, 6)
		glow(glass, DAYLIGHT, 16, 0.6)
		gridWindow(front * CFrame.new(x, GALLERY + 5, 0), 4, 4.5)
	end
	gridWindow(front * CFrame.new(-24, 6, 0), 3, 5)
	-- Left wall (its local +X runs toward the front): a green door on each level and windows between
	local left = onWall(Vector3.new(-W / 2, 0, 0), Vector3.new(1, 0, 0))
	archDoor(left * CFrame.new(3, 0, 0), 5, 8)
	archDoor(left * CFrame.new(-4, GALLERY, 0), 4.4, 7.4)
	gridWindow(left * CFrame.new(18, 6, 0), 4, 5.5)
	for _, x in { -11, 14 } do
		gridWindow(left * CFrame.new(x, GALLERY + 5, 0), 4, 4.5)
	end
	-- Right wall (local +X runs toward the back): windows above the stairs and along the gallery
	local right = onWall(Vector3.new(W / 2, 0, 0), Vector3.new(-1, 0, 0))
	for _, x in { -14, 0, 12 } do
		gridWindow(right * CFrame.new(x, GALLERY + 5, 0), 4, 4.5)
	end
	gridWindow(right * CFrame.new(9.5, 6, 0), 4, 5.5)
	-- Back wall upstairs
	local back = onWall(Vector3.new(0, 0, D / 2), Vector3.new(0, 0, -1))
	archDoor(back * CFrame.new(0, GALLERY, 0), 4.4, 7.4)
	for _, x in { -14, 14 } do
		gridWindow(back * CFrame.new(x, GALLERY + 5, 0), 4, 4.5)
	end

	-- Glowing brick alcove at the back, where the store keeps its prize rod
	local alcove = back
	for _, x in { -4.2, 4.2 } do
		part("AlcovePier", Vector3.new(1.6, 9, 1.6), alcove * CFrame.new(x, 4.5, 0.8), rgb(196, 176, 150), M.Brick)
	end
	part("AlcoveHeader", Vector3.new(10, 1.6, 1.6), alcove * CFrame.new(0, 9.8, 0.8), rgb(196, 176, 150), M.Brick)
	local alcoveGlow =
		deco("AlcoveGlow", Vector3.new(6.8, 8.8, 0.2), alcove * CFrame.new(0, 4.4, 0.15), rgb(214, 96, 196), M.Neon)
	glow(alcoveGlow, rgb(232, 110, 214), 14, 0.6)
	part("AlcovePlinth", Vector3.new(3, 2.4, 2), alcove * CFrame.new(0, 1.2, 1.4), rgb(120, 110, 130), M.Slate)
	local prizeBase = alcove * CFrame.new(0, 2.4, 1.4)
	beam(
		"PrizeRodBlank",
		(prizeBase * CFrame.new(-0.4, 0.3, 0)).Position,
		(prizeBase * CFrame.new(0.8, 6.6, 0)).Position,
		0.18,
		rgb(255, 196, 60)
	).Material =
		M.Neon
	beam(
		"PrizeRodGrip",
		(prizeBase * CFrame.new(-0.6, 0, 0)).Position,
		(prizeBase * CFrame.new(-0.3, 1.6, 0)).Position,
		0.35,
		DARK_WOOD
	)

	-- The counter, with racks of rods behind it under the back gallery
	part("CounterBase", Vector3.new(16, 3.2, 2.6), CFrame.new(0, 1.6, backEdge - 6), rgb(70, 126, 110), M.WoodPlanks)
	part("CounterTop", Vector3.new(16.6, 0.35, 3.2), CFrame.new(0, 3.37, backEdge - 6), WOOD)
	for _, x in { -6, -2, 2, 6 } do
		deco(
			"CounterPanel",
			Vector3.new(3.2, 2.2, 0.12),
			CFrame.new(x, 1.6, backEdge - 7.35),
			rgb(58, 104, 92),
			M.WoodPlanks
		)
	end
	local menu =
		deco("RodPriceBoard", Vector3.new(6, 1.4, 0.15), CFrame.new(0, 8.8, backEdge - 4.2), DARK_WOOD, M.WoodPlanks)
	PlazaHouses.boardText(menu, "ROD UPGRADES", Enum.NormalId.Front)
	for _, x in { -2.9, 2.9 } do
		deco("BoardHanger", Vector3.new(0.12, 2.5, 0.12), CFrame.new(x, 10.75, backEdge - 4.2), IRON, M.Metal)
	end
	-- A brass bell and a ledger on the counter
	deco("CounterBell", Vector3.new(0.8, 0.6, 0.8), CFrame.new(5.5, 3.85, backEdge - 6), rgb(214, 170, 70), M.Metal).Shape =
		Enum.PartType.Ball
	deco(
		"Ledger",
		Vector3.new(1.8, 0.25, 1.3),
		CFrame.new(-5, 3.67, backEdge - 6) * CFrame.Angles(0, 0.25, 0),
		rgb(120, 40, 36),
		M.Fabric
	)

	local rodColors = { rgb(64, 103, 89), rgb(183, 81, 51), rgb(47, 81, 118), rgb(175, 134, 62), rgb(120, 70, 140) }
	local function rodRack(face: CFrame, count: number)
		local width = count * 1.6 + 1
		part("RackBase", Vector3.new(width, 1.2, 1.4), face * CFrame.new(0, 0.6, 0.8), DARK_WOOD)
		deco("RackRail", Vector3.new(width, 0.35, 0.5), face * CFrame.new(0, 7.2, 0.35), DARK_WOOD)
		for _, x in { -width / 2, width / 2 } do
			part("RackSide", Vector3.new(0.4, 8, 1.4), face * CFrame.new(x, 4, 0.8), DARK_WOOD)
		end
		for i = 1, count do
			local x = -width / 2 + 0.5 + (i - 0.5) * 1.6
			local color = rodColors[(i - 1) % #rodColors + 1]
			local foot = face * Vector3.new(x, 1.2, 0.9)
			local tip = face * Vector3.new(x + 0.3, 10.5, 0.35)
			Props.beam(hall, o * foot, o * tip, 0.14, color, nil, M.SmoothPlastic).CanCollide = false
			Props.beam(hall, o * foot, o * (face * Vector3.new(x + 0.05, 3, 0.85)), 0.3, rgb(196, 150, 96), nil, M.Wood).CanCollide =
				false
			deco("RackReel", Vector3.new(0.45, 0.6, 0.4), face * CFrame.new(x, 3.4, 1.15), IRON, M.Metal)
		end
	end
	rodRack(back * CFrame.new(-11.5, 0, 0), 7)
	rodRack(back * CFrame.new(11.5, 0, 0), 7)
	rodRack(left * CFrame.new(-16.5, 0, 0), 6)
	rodRack(right * CFrame.new(0, 0, 0), 6)

	-- Tackle shelves and a bookcase of fishing almanacs
	local function shelves(face: CFrame, width: number, height: number, tiers: number)
		for _, x in { -width / 2, width / 2 } do
			part("ShelfSide", Vector3.new(0.35, height, 1.8), face * CFrame.new(x, height / 2, 0.9), DARK_WOOD)
		end
		deco("ShelfBack", Vector3.new(width, height, 0.15), face * CFrame.new(0, height / 2, 0.08), WOOD, M.WoodPlanks)
		for t = 0, tiers do
			local y = 0.3 + t * (height - 0.6) / tiers
			part("Shelf", Vector3.new(width, 0.25, 1.8), face * CFrame.new(0, y, 0.9), DARK_WOOD)
			if t == tiers then
				continue
			end
			local x = -width / 2 + 0.5
			while x < width / 2 - 0.6 do
				local roll = rng:NextNumber()
				if roll < 0.55 then
					local bookW = rng:NextNumber(0.35, 0.6)
					local bookH = rng:NextNumber(1.2, 1.8)
					deco(
						"Book",
						Vector3.new(bookW, bookH, 1.3),
						face * CFrame.new(x + bookW / 2, y + 0.12 + bookH / 2, 0.9),
						Props.pick(rng, rodColors),
						M.Fabric
					)
					x += bookW + 0.05
				elseif roll < 0.8 then
					deco(
						"TackleTin",
						Vector3.new(1.1, 0.7, 1.2),
						face * CFrame.new(x + 0.55, y + 0.47, 0.9),
						Props.pick(rng, { rgb(70, 126, 110), rgb(190, 152, 100), rgb(170, 70, 50) }),
						M.SmoothPlastic
					)
					x += 1.2
				else
					local coins = deco(
						"GoldCoins",
						Vector3.new(0.4, 1, 1),
						face * CFrame.new(x + 0.5, y + 0.3, 0.9) * CFrame.Angles(0, 0, math.pi / 2),
						rgb(244, 198, 60),
						M.Metal
					)
					coins.Shape = Enum.PartType.Cylinder
					x += 1.1
				end
			end
		end
	end
	shelves(right * CFrame.new(16, 0, 0), 5, 7.5, 4)
	shelves(left * CFrame.new(11, 0, 0), 4.5, 6, 3)

	-- Floor props: a bench, barrels, crate stacks, display pedestals and a long rug down the aisle
	local function at(x: number, z: number, y: number?): Vector3
		return o * Vector3.new(x, y or 0, z)
	end
	Props.bench(hall, at(-W / 2 + 2.2, 4.5), math.pi / 2)
	for _, p in { { -W / 2 + 2, 9.2 }, { -W / 2 + 4.4, 10 }, { inner - 2, -16 } } do
		Props.barrel(hall, at(p[1], p[2]), rng)
	end
	Props.crates(hall, at(inner - 2, 10), rng)
	Props.crates(hall, at(-inner + 2, -19), rng)
	deco("AisleRug", Vector3.new(7, 0.06, 24), CFrame.new(0, 0.03, -8), rgb(170, 66, 52), M.Fabric)
	deco("AisleRugBorder", Vector3.new(8, 0.04, 25), CFrame.new(0, 0.02, -8), rgb(222, 180, 90), M.Fabric)
	-- A plain wooden crate with an empty inside and a separate hinged lid. Its prompt opens the
	-- crate window; FishingService checks the angler is standing at it.
	-- Bobbers take the opposite side of the aisle, facing the rod cases.
	for _, bobberCase in { false, true } do
		local kind = if bobberCase then "Bobber" else "Rod"
		local stand = CFrame.new(if bobberCase then -10 else 10, 0, -6)
			* CFrame.Angles(0, if bobberCase then -math.pi / 2 else math.pi / 2, 0)
		part("CratePlinth", Vector3.new(3.4, 0.8, 3), stand * CFrame.new(0, 0.4, 0), rgb(120, 116, 112), M.Slate)
		local display = Instance.new("Model")
		display.Name = kind .. "CrateDisplay"
		display:SetAttribute("CrateFrame", o * stand)
		display:SetAttribute("LidHinge", o * stand * CFrame.new(0, 2.4, 0.9))
		display.Parent = hall
		local function cratePart(name: string, size: Vector3, offset: CFrame, color: Color3): Part
			local piece = part(name, size, stand * offset, color, M.WoodPlanks)
			piece.CanQuery = false
			piece.Parent = display
			return piece
		end
		cratePart("CrateBottom", Vector3.new(2.6, 0.18, 1.8), CFrame.new(0, 0.89, 0), DARK_WOOD)
		local crate = cratePart(kind .. "Crate", Vector3.new(2.6, 1.42, 0.16), CFrame.new(0, 1.69, -0.82), WOOD)
		crate.CanQuery = true
		cratePart("CrateBack", Vector3.new(2.6, 1.42, 0.16), CFrame.new(0, 1.69, 0.82), WOOD)
		for _, x in { -1.22, 1.22 } do
			cratePart("CrateSide", Vector3.new(0.16, 1.42, 1.48), CFrame.new(x, 1.69, 0), WOOD)
		end
		for _, x in { -1.05, 1.05 } do
			for _, z in { -0.93, 0.93 } do
				cratePart("CrateBrace", Vector3.new(0.16, 1.6, 0.1), CFrame.new(x, 1.6, z), DARK_WOOD)
			end
		end
		local lid = Instance.new("Model")
		lid.Name = kind .. "CrateLid"
		lid.Parent = display
		local board = cratePart("LidBoard", Vector3.new(2.7, 0.2, 1.9), CFrame.new(0, 2.5, 0), WOOD)
		board.CanCollide = false
		board.Parent = lid
		lid.PrimaryPart = board
		for _, x in { -1.05, 1.05 } do
			local brace = cratePart("LidBrace", Vector3.new(0.16, 0.08, 1.9), CFrame.new(x, 2.64, 0), DARK_WOOD)
			brace.CanCollide = false
			brace.Parent = lid
		end
		local sign = deco(
			kind .. "CrateSign",
			Vector3.new(3, 0.8, 0.12),
			stand * CFrame.new(0, 4.4, 0.6),
			DARK_WOOD,
			M.WoodPlanks
		)
		sign.CanQuery = false
		PlazaHouses.boardText(
			sign,
			if bobberCase then "BOBBERS\n$350" else "ROD CRATES\n$350 / $750",
			Enum.NormalId.Front
		)
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "Open" .. kind .. "CratePrompt"
		prompt.ActionText = if bobberCase then "Open case" else "Open crates"
		prompt.ObjectText = if bobberCase then "Bobbers · $350" else "Rod Crates"
		prompt.MaxActivationDistance = 9
		prompt.RequiresLineOfSight = false
		prompt.HoldDuration = 0
		prompt.Parent = crate
	end

	-- Up on the gallery: potted palms, barrels and crates
	local function pottedPalm(x: number, z: number)
		local base = at(x, z, GALLERY)
		Props.cylinder(hall, base + Vector3.new(0, 1, 0), 2, 2.6, rgb(184, 96, 60), M.Sandstone)
		local top = base + Vector3.new(rng:NextNumber(-0.6, 0.6), 7, rng:NextNumber(-0.6, 0.6))
		Props.beam(hall, base + Vector3.new(0, 1.5, 0), top, 0.6, rgb(130, 100, 70), nil, M.Wood).CanCollide = false
		for f = 1, 7 do
			local a = f / 7 * TAU + rng:NextNumber(-0.2, 0.2)
			local dir = Vector3.new(math.cos(a), 0, math.sin(a))
			local mid = top + dir * 2.4 + Vector3.new(0, 0.8, 0)
			local tip = top + dir * 4.6 + Vector3.new(0, -1.2, 0)
			Props.beam(hall, top, mid, 1.3, Props.pick(rng, LEAF), 0.15, M.LeafyGrass).CanCollide = false
			Props.beam(hall, mid, tip, 1.1, Props.pick(rng, LEAF), 0.15, M.LeafyGrass).CanCollide = false
		end
	end
	for _, p in { { -18, D / 2 - 3 }, { 18, D / 2 - 3 }, { -W / 2 + 3, 0 }, { W / 2 - 3, 8 } } do
		pottedPalm(p[1], p[2])
	end
	for _, p in { { -8, D / 2 - 2.5 }, { -5.5, D / 2 - 2 }, { 24, D / 2 - 2.5 }, { -W / 2 + 2.5, 9 } } do
		Props.barrel(hall, at(p[1], p[2], GALLERY), rng)
	end
	Props.crates(hall, at(8, D / 2 - 3, GALLERY), rng)
	Props.crates(hall, at(-24, D / 2 - 3, GALLERY), rng)
	Props.crates(hall, at(W / 2 - 3, -2, GALLERY), rng)

	-- Hanging lanterns from the tie beams, and a lamp under each gallery post
	for _, z in { -16, -5.5, 5.5 } do
		for _, x in { -10, 10 } do
			local hook = Vector3.new(x, EAVES - 0.5, z)
			deco("LanternChain", Vector3.new(0.12, 5, 0.12), CFrame.new(hook - Vector3.new(0, 2.5, 0)), IRON, M.Metal)
			local lantern = Props.lantern(hall, o * CFrame.new(hook - Vector3.new(0, 6.6, 0)), 14, 0.6)
			for _, piece in lantern:GetChildren() do
				if piece:IsA("BasePart") then
					piece.CanCollide = false
				end
			end
		end
	end
	for _, p in { { -inner, -6 }, { inner, 4 }, { -inner, 4 }, { -11, backEdge }, { 11, backEdge } } do
		local lantern = Props.lantern(hall, o * CFrame.new(p[1], GALLERY - 3, p[2] - 0.9), 14, 0.6)
		for _, piece in lantern:GetChildren() do
			if piece:IsA("BasePart") then
				piece.CanCollide = false
			end
		end
	end

	-- The exit leads back through the green door; RodShop.build links it to the square
	exit.Name = "ExitDoor"
	CollectionService:AddTag(hall, "FishingRodShop")
	hall.Parent = interiorFolder()
	return hall
end

-- Finn stands centered behind the counter, facing the door below the upgrade sign.
-- FishingService dresses and places him at startup; the frame is at his soles.
local KEEPER_FRAME = INTERIOR_ORIGIN * CFrame.new(0, 0, D / 2 - 8 - 2.8)

-- Crab cages on a pallet left of the aisle, a spare on the floor in front and a
-- few loose floats. Built onto saved halls too, so it needs no interior rebuild.
-- FishingService sells one cage per BuyCrabCagePrompt at the price on the sign.
local function ensureCrabCageStand(hall: Model)
	if hall:FindFirstChild("CrabCageStand") then
		return
	end
	local stand = Instance.new("Model")
	stand.Name = "CrabCageStand"
	-- Local +Z faces the aisle; the cages' long sides run along the hall.
	local base = INTERIOR_ORIGIN * CFrame.new(-15, 0, 2) * CFrame.Angles(0, math.pi / 2, 0)
	local pallet = Props.part(stand, Vector3.new(6.8, 0.5, 3.4), base * CFrame.new(0, 0.25, 0), WOOD, M.WoodPlanks)
	pallet.Name = "Pallet"
	for _, x in { -2.9, 0, 2.9 } do
		Props.part(stand, Vector3.new(0.6, 0.12, 3.4), base * CFrame.new(x, 0.56, 0), DARK_WOOD, M.Wood).CanCollide =
			false
	end
	for _, x in { -1.65, 1.65 } do
		Props.crabCage(stand, base * CFrame.new(x, 0.62, 0))
	end
	Props.crabCage(stand, base * CFrame.new(-1.4, 0, 3.6) * CFrame.Angles(0, 0.45, 0))
	for index, offset in { CFrame.new(2.2, 0.45, 3), CFrame.new(3, 0.45, 3.6), CFrame.new(2.6, 1.3, 3.3) } do
		local floatPart = Props.part(
			stand,
			Vector3.new(1.1, 0.9, 0.9),
			base * offset * CFrame.Angles(0, index * 0.7, 0),
			rgb(240, 112, 38),
			M.SmoothPlastic
		)
		floatPart.Name = "SpareFloat"
		floatPart.Shape = Enum.PartType.Cylinder
		floatPart.CanCollide = false
	end
	for _, x in { -2.6, 2.6 } do
		Props.part(stand, Vector3.new(0.3, 5, 0.3), base * CFrame.new(x, 2.5, -1.9), DARK_WOOD, M.Wood)
	end
	local sign = Props.part(
		stand,
		Vector3.new(5.6, 1.5, 0.15),
		base * CFrame.new(0, 4.6, -1.85) * CFrame.Angles(0, math.pi, 0),
		DARK_WOOD,
		M.WoodPlanks
	)
	sign.Name = "CrabCageSign"
	sign.CanCollide, sign.CanQuery = false, false
	PlazaHouses.boardText(sign, "CRAB CAGES\n$35 · 3 HAULS", Enum.NormalId.Front)
	-- The prompt hangs over the pallet, where nothing blocks the shop's sightline check.
	local anchor = Props.part(stand, Vector3.new(1, 1, 1), base * CFrame.new(0, 3.4, 0.4), WOOD)
	anchor.Name = "CrabCagePromptAnchor"
	anchor.Transparency, anchor.CanCollide, anchor.CastShadow = 1, false, false
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "BuyCrabCagePrompt"
	prompt.ActionText = "Buy · $35"
	prompt.ObjectText = "Crab Cage"
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.HoldDuration = 0.35
	prompt.Parent = anchor
	stand.Parent = hall
end

local function ensureMusselNetStand(hall: Model)
	local existing = hall:FindFirstChild("MusselNetStand")
	if existing then
		if existing:GetAttribute("NetDesignVersion") == 2 then
			return
		end
		existing:Destroy()
	end
	local stand = Instance.new("Model")
	stand.Name = "MusselNetStand"
	stand:SetAttribute("NetDesignVersion", 2)
	local base = INTERIOR_ORIGIN * CFrame.new(-15, 0, -7) * CFrame.Angles(0, math.pi / 2, 0)
	Props.part(stand, Vector3.new(4.5, 0.4, 3), base * CFrame.new(0, 0.2, 0), WOOD, M.WoodPlanks)
	local net = Props.musselNet(stand, base * CFrame.new(0, 0.4, 0), false)
	net:ScaleTo(0.6)
	local sign = Props.part(stand, Vector3.new(4.5, 1.4, 0.15), base * CFrame.new(0, 4, -1.6) * CFrame.Angles(0, math.pi, 0), DARK_WOOD, M.WoodPlanks)
	sign.CanCollide, sign.CanQuery = false, false
	PlazaHouses.boardText(sign, "MUSSEL NET · $125\n5 HAULS · 3–5 MIN\n2–5 CATCHES", Enum.NormalId.Front)
	local anchor = Props.part(stand, Vector3.one, base * CFrame.new(0, 3, 0.4), WOOD)
	anchor.Transparency, anchor.CanCollide, anchor.CastShadow = 1, false, false
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name, prompt.ActionText, prompt.ObjectText = "BuyMusselNetPrompt", "Buy · $125", "Mussel Net"
	prompt.MaxActivationDistance, prompt.HoldDuration, prompt.RequiresLineOfSight = 9, 0.35, false
	prompt.Parent = anchor
	stand.Parent = hall
end

local function ensureSpearStand(hall: Model)
	if hall:FindFirstChild("SpearStand") then
		return
	end
	local stand = Instance.new("Model")
	stand.Name = "SpearStand"
	local base = INTERIOR_ORIGIN * CFrame.new(15, 0, 3) * CFrame.Angles(0, -math.pi / 2, 0)
	Props.part(stand, Vector3.new(4, 0.5, 2.4), base * CFrame.new(0, 0.25, 0), WOOD, M.WoodPlanks)
	for _, x in { -1, 0, 1 } do
		local shaft = Props.part(stand, Vector3.new(0.2, 4, 0.2), base * CFrame.new(x, 2.5, 0), WOOD, M.Wood)
		shaft.Name, shaft.CanCollide, shaft.CanQuery = "DisplaySpear", false, false
		local tip = Props.part(stand, Vector3.new(0.4, 1, 0.15), base * CFrame.new(x, 5, 0), IRON, M.Metal)
		tip.Name, tip.CanCollide, tip.CanQuery = "Spearhead", false, false
	end
	local sign = Props.part(stand, Vector3.new(4.6, 1.2, 0.15), base * CFrame.new(0, 6.2, -1.2) * CFrame.Angles(0, math.pi, 0), DARK_WOOD, M.WoodPlanks)
	sign.CanCollide, sign.CanQuery = false, false
	PlazaHouses.boardText(sign, "SHARK SPEAR · $250", Enum.NormalId.Front)
	local anchor = Props.part(stand, Vector3.one, base * CFrame.new(0, 3, 1.3), WOOD)
	anchor.Name = "SpearPromptAnchor"
	anchor.Transparency, anchor.CanCollide, anchor.CastShadow = 1, false, false
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name, prompt.ActionText, prompt.ObjectText = "BuySpearPrompt", "Buy · $250", "Shark Spear"
	prompt.MaxActivationDistance, prompt.HoldDuration, prompt.RequiresLineOfSight = 9, 0.35, false
	prompt.Parent = anchor
	stand.Parent = hall
end

-- Added independently so existing saved shop interiors receive the new case too.
local function ensureSpearCrateStand(hall: Model)
	if hall:FindFirstChild("SpearCrateDisplay") then
		return
	end
	local stand = Instance.new("Model")
	stand.Name = "SpearCrateDisplay"
	local base = INTERIOR_ORIGIN * CFrame.new(10, 0, -13) * CFrame.Angles(0, math.pi / 2, 0)
	stand:SetAttribute("CrateFrame", base)
	stand:SetAttribute("LidHinge", base * CFrame.new(0, 2.4, 0.9))
	Props.part(stand, Vector3.new(3.4, 0.8, 3), base * CFrame.new(0, 0.4, 0), rgb(120, 116, 112), M.Slate)
	local crate = Props.part(stand, Vector3.new(2.6, 1.5, 1.8), base * CFrame.new(0, 1.65, 0), WOOD, M.WoodPlanks)
	crate.Name = "SpearCrate"
	local lid = Instance.new("Model")
	lid.Name = "SpearCrateLid"
	local board = Props.part(lid, Vector3.new(2.7, 0.2, 1.9), base * CFrame.new(0, 2.5, 0), DARK_WOOD, M.WoodPlanks)
	board.CanCollide = false
	lid.PrimaryPart = board
	lid.Parent = stand
	local sign = Props.part(stand, Vector3.new(3, 0.8, 0.12), base * CFrame.new(0, 4.4, 0.6), DARK_WOOD, M.WoodPlanks)
	sign.CanCollide, sign.CanQuery = false, false
	PlazaHouses.boardText(sign, "SPEAR SKINS\n$350", Enum.NormalId.Front)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name, prompt.ActionText, prompt.ObjectText = "OpenSpearCratePrompt", "Open case", "Spear Skins · $350"
	prompt.MaxActivationDistance, prompt.HoldDuration, prompt.RequiresLineOfSight = 9, 0, false
	prompt.Parent = crate
	stand.Parent = hall
end

local function ensureInterior(): Model
	local existing = interiorFolder():FindFirstChild("RodStoreInterior")
	local hall: Model
	if existing and existing:IsA("Model") and existing:GetAttribute("LayoutVersion") == INTERIOR_VERSION then
		hall = existing
	else
		if existing then
			existing:Destroy()
		end
		hall = buildInterior()
	end
	-- Refresh saved interiors too, without rebuilding the shop for a sign change.
	local cratePrompt = hall:FindFirstChild("OpenRodCratePrompt", true)
	if cratePrompt and cratePrompt:IsA("ProximityPrompt") then
		cratePrompt.ObjectText = "Rod Crates"
	end
	local crateSign = hall:FindFirstChild("RodCrateSign", true)
	if crateSign then
		for _, item in crateSign:GetDescendants() do
			if item:IsA("TextLabel") then
				item.Text = "ROD CRATES\n$350 / $750"
			end
		end
	end
	ensureCrabCageStand(hall)
	ensureMusselNetStand(hall)
	ensureSpearStand(hall)
	ensureSpearCrateStand(hall)
	hall:SetAttribute("KeeperFrame", KEEPER_FRAME)
	CollectionService:AddTag(hall, "FishingRodShop")
	return hall
end

----------------------------------------------------------------------------------------------------
-- Storefront on the square

-- Front on local +Z; turned so the door faces the fountain, clear of the cafe tables to the south.
function RodShop.build(plaza: Model, plazaFrame: CFrame): Model
	local hall = ensureInterior()
	local existing = plaza:FindFirstChild("FishingRodShop")
	local shop: Model
	if existing and existing:IsA("Model") and existing:GetAttribute("LayoutVersion") == LAYOUT_VERSION then
		shop = existing
	else
		if existing then
			existing:Destroy()
		end
		local base = plazaFrame * CFrame.new(-45, 0, 35) * CFrame.Angles(0, math.pi / 2, 0)
		local rng = Random.new(4242)
		local doorFace, leaf
		shop, doorFace, leaf = PlazaHouses.house(plaza, base, {
			width = 22,
			depth = 18,
			stories = 2,
			lower = rgb(244, 232, 206),
			upper = rgb(86, 146, 200),
			trim = rgb(250, 242, 224),
			shutter = rgb(120, 80, 52),
			roof = rgb(170, 84, 52),
			door = rgb(176, 70, 52),
			balcony = true,
			shop = "TIDE & TACKLE",
			blade = "RODS",
			signColor = CREAM,
			-- The door takes the end nearer the bay, clear of the cafe tables
			doorSide = -1,
		}, rng)
		shop.Name = "FishingRodShop"
		shop:SetAttribute("LayoutVersion", LAYOUT_VERSION)
		-- A promenade palm this close would push its fronds through the walls
		for _, palm in plaza:GetChildren() do
			local trunk = palm:IsA("Model") and palm.Name == "Palm" and palm:FindFirstChildWhichIsA("BasePart")
			if trunk then
				local p = base:PointToObjectSpace(trunk.Position)
				local dx, dz = math.max(math.abs(p.X) - 11, 0), math.max(math.abs(p.Z) - 9, 0)
				if dx * dx + dz * dz < 100 then
					palm:Destroy()
				end
			end
		end
		leaf.Name = "StreetDoor"
		shop:SetAttribute("ExitFrame", doorFace * CFrame.new(0, 3.2, 4.5) * CFrame.Angles(0, math.pi, 0))
		-- A chalkboard on the step tells new anglers what is inside
		local board = doorFace * CFrame.new(-5, 0, 4)
		local panel
		for _, side in { -1, 1 } do
			-- The two leaves lean together at the top
			panel = Props.part(
				shop,
				Vector3.new(2.6, 3.6, 0.2),
				board * CFrame.new(0, 1.7, side * 0.55) * CFrame.Angles(-side * 0.3, 0, 0),
				rgb(60, 52, 44),
				M.Wood
			)
		end
		local slate = Props.part(
			shop,
			Vector3.new(2.2, 2.6, 0.06),
			panel.CFrame * CFrame.new(0, 0.2, 0.13),
			rgb(36, 44, 40),
			M.Slate
		)
		slate.CanCollide = false
		PlazaHouses.boardText(slate, "ROD\nUPGRADES\n& CRATES\ninside", Enum.NormalId.Back)
	end
	-- Link both doors every startup, so a rebuilt square and a saved hall always agree
	local leaf = shop:FindFirstChild("StreetDoor", true)
	local arrival = hall:GetAttribute("ArrivalFrame")
	local exitFrame = shop:GetAttribute("ExitFrame")
	if leaf and leaf:IsA("BasePart") and typeof(arrival) == "CFrame" then
		doorPrompt(leaf, "Enter", arrival)
	end
	local exit = hall:FindFirstChild("ExitDoor", true)
	if exit and exit:IsA("BasePart") and typeof(exitFrame) == "CFrame" then
		doorPrompt(exit, "Leave", exitFrame)
	end
	CollectionService:RemoveTag(shop, "FishingRodShop")
	return shop
end

-- Startup repairs scan the whole map (city and islands included) before anyone spawns. Yield a
-- frame every 50 ms so the startup thread stays inside Roblox's ~10 s script timeout.
local breatheAt = os.clock()
local function breathe()
	if task and os.clock() - breatheAt > 0.05 then
		task.wait()
		breatheAt = os.clock()
	end
end

function RodShop.ensure(root: Instance)
	for _, plaza in root:GetDescendants() do
		breathe()
		if plaza:IsA("Model") and plaza.Name == "Plaza" then
			local frame = PlazaHouses.pavingFrame(plaza)
			if frame then
				RodShop.build(plaza, frame)
			end
		end
	end
end

return RodShop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="243">
          <Properties>
            <string name="Name">Seabed</string>
            <string name="Source"><![CDATA[-- Continuous underwater slopes, ending inside the sea floor.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Biomes = require(ReplicatedStorage.Shared.Biomes)
local LowPoly = require(script.Parent.LowPoly)

local Seabed = {}
Seabed.Floor = Biomes.SeaFloor

-- Repair baked maps too. Only replace the eight-stud base layer, so raised
-- biome shelves, island slopes and the water above keep their existing shape.
function Seabed.ensureSand(root: Instance)
	if root:GetAttribute("SeabedSandVersion") == 1 then
		return
	end
	local terrain = workspace.Terrain
	terrain:SetMaterialColor(Enum.Material.Sand, Biomes.Normal.seabedColor)
	local function fill(x0: number, x1: number, z0: number, z1: number)
		for x = x0, x1 - 1, 1024 do
			for z = z0, z1 - 1, 1024 do
				local sx, sz = math.min(1024, x1 - x), math.min(1024, z1 - z)
				terrain:FillBlock(
					CFrame.new(x + sx / 2, Biomes.SeaFloor - 4, z + sz / 2),
					Vector3.new(sx, 8, sz),
					Enum.Material.Sand
				)
			end
			task.wait()
		end
	end
	local half, edge = Biomes.MapHalfSize, Biomes.OceanMax
	fill(-half, half, -half, half)
	fill(half, edge, Biomes.CityOceanStart, edge)
	fill(Biomes.CityOceanStart, half, half, edge)
	root:SetAttribute("SeabedSandVersion", 1)
end

-- Ease into the shore and flatten into the bed, without ledges or vertical walls.
function Seabed.height(distance: number, run: number, top: number?, floor: number?): number
	local bed = floor or Biomes.SeaFloor
	if distance > run then
		return bed - math.min(distance - run, 8) -- buried overlap after the visible slope flattens
	end
	local t = math.clamp(distance / run, 0, 1)
	local blend = t * t * (3 - 2 * t)
	local start = top or 0
	return start + (bed - start) * blend
end

-- Each ring follows the exact same shore vertices; no independent jitter can
-- open seams or turn the underwater slope back toward the island.
function Seabed.slope(
	rim: { Vector3 },
	run: number,
	floor: number,
	color: Color3,
	parent: Instance,
	material: Enum.Material
)
	local center = Vector3.zero
	for _, point in rim do
		center += point
	end
	center /= #rim
	local inside = Vector3.new(center.X, floor - 40, center.Z)
	local previous = rim
	local steps = 8
	for step = 1, steps + 1 do
		local distance = if step > steps then run + 8 else run * step / steps
		local ring = {}
		for j, point in rim do
			local outward = Vector3.new(point.X - center.X, 0, point.Z - center.Z).Unit
			local offset = point + outward * distance
			ring[j] = Vector3.new(offset.X, Seabed.height(distance, run, point.Y, floor), offset.Z)
		end
		for j = 1, #rim do
			local k = j % #rim + 1
			LowPoly.triangle(previous[j], ring[j], ring[k], inside, color, parent, material)
			LowPoly.triangle(previous[j], ring[k], previous[k], inside, color, parent, material)
		end
		previous = ring
	end
end

-- Preserve the shallow biome beds, with a smooth apron around their perimeter.
function Seabed.shelf(
	position: Vector2,
	radius: number,
	top: number,
	material: Enum.Material,
	color: Color3,
	parent: Instance
)
	local bottom = Biomes.SeaFloor - 8
	workspace.Terrain:FillCylinder(
		CFrame.new(position.X, (top + bottom) / 2, position.Y),
		top - bottom,
		radius,
		material
	)
	local slope = Instance.new("Model")
	slope.Name = "SeabedSlope"
	slope.Parent = parent
	local rim = {}
	for j = 1, 96 do
		local angle = (j - 1) / 96 * math.pi * 2
		rim[j] =
			Vector3.new(position.X + math.cos(angle) * (radius - 4), top, position.Y + math.sin(angle) * (radius - 4))
	end
	Seabed.slope(rim, 128, Biomes.SeaFloor, color, slope, material)
end

return Seabed
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="244">
          <Properties>
            <string name="Name">SeabedDetails</string>
            <string name="Source"><![CDATA[-- Small, independently streamed underwater gardens. Sample the finished ground so
-- plants follow island slopes and shelves as well as the deep ocean floor.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Biomes = require(ReplicatedStorage.Shared.Biomes)
local SeabedCarpet = require(ReplicatedStorage.Shared.SeabedCarpet)
local Harbour = require(script.Parent.Harbour)
local LowPoly = require(script.Parent.LowPoly)
local Props = require(script.Parent.Props)
local Seabed = require(script.Parent.Seabed)
local SeabedLife = require(script.Parent.SeabedLife)

local SeabedDetails = {}
-- 6: the floor carpet moved to the clients (only templates are published).
local VERSION = 6
local TAU = math.pi * 2
local M = Enum.Material
local rgb = Color3.fromRGB

type Style = {
	count: number,
	shoreCount: number,
	stone: Color3,
	weed: Color3,
	sand: Color3?,
	coral: { Color3 }?,
	vegetation: number,
}

local STYLES: { [string]: Style } = {
	normal = {
		count = 240,
		shoreCount = 220,
		stone = rgb(158, 151, 130),
		weed = rgb(67, 103, 61),
		sand = rgb(218, 202, 162),
		coral = { rgb(192, 67, 61), rgb(215, 116, 76), rgb(178, 99, 134), rgb(221, 179, 98) },
		vegetation = 1,
	},
	swamp = { count = 75, shoreCount = 60, stone = rgb(91, 89, 67), weed = rgb(77, 91, 40), vegetation = 1 },
	tropical = {
		count = 160,
		shoreCount = 120,
		stone = rgb(180, 172, 139),
		weed = rgb(54, 128, 92),
		sand = rgb(233, 220, 181),
		coral = { rgb(232, 113, 101), rgb(234, 173, 89), rgb(160, 114, 186), rgb(85, 174, 158) },
		vegetation = 0.8,
	},
	volcanic = { count = 60, shoreCount = 40, stone = rgb(61, 58, 55), weed = rgb(72, 79, 54), vegetation = 0.15 },
	ice = { count = 60, shoreCount = 40, stone = rgb(110, 133, 141), weed = rgb(65, 94, 81), vegetation = 0.35 },
	open = {
		count = 480,
		shoreCount = 0,
		stone = rgb(132, 137, 125),
		weed = rgb(69, 96, 66),
		sand = rgb(206, 190, 148),
		coral = { rgb(168, 97, 84), rgb(185, 143, 100), rgb(144, 119, 153) },
		vegetation = 0.7,
	},
}

local function model(name: string, parent: Instance): Model
	local result = Instance.new("Model")
	result.Name = name
	result.Parent = parent
	return result
end

local function sample(params: RaycastParams, x: number, z: number): RaycastResult?
	-- Start above the tallest island: a ray from below sea level can put plants
	-- inside the land above it. Only ground and Terrain participate in these rays.
	local hit = workspace:Raycast(Vector3.new(x, 600, z), Vector3.new(0, -720, 0), params)
	if
		hit
		and hit.Position.Y < Biomes.WaterLevel - 8
		and hit.Normal.Y > 0.78
		and Biomes.inOceanBounds(hit.Position)
	then
		return hit
	end
	return nil
end

-- Low sand drifts with a buried rim. Skip uneven ground rather than bridging it.
local function sandDrift(parent: Model, ground: Vector3, rng: Random, color: Color3, params: RaycastParams)
	local ring = {}
	local radius, spin = rng:NextNumber(9, 19), rng:NextNumber(0, TAU)
	for i = 1, 7 do
		local angle = spin + i / 7 * TAU
		local hit = sample(params, ground.X + math.cos(angle) * radius, ground.Z + math.sin(angle) * radius * 0.7)
		if not hit or math.abs(hit.Position.Y - ground.Y) > 0.5 then
			return
		end
		ring[i] = hit.Position - Vector3.new(0, 0.12, 0)
	end
	local drift = model("SandDrift", parent)
	local top = ground + Vector3.new(0, rng:NextNumber(0.3, 0.65), 0)
	for i, point in ring do
		LowPoly.triangle(point, ring[i % #ring + 1], top, ground - Vector3.yAxis * 2, color, drift, M.Sand, 0.18)
	end
end

local function stones(parent: Model, ground: Vector3, rng: Random, color: Color3)
	local cluster = model("SeabedStones", parent)
	local radius = rng:NextNumber(1.3, 3.8)
	-- Only the exposed crown needs geometry; bury the open base in the bed.
	local ring = {}
	local spin = rng:NextNumber(0, TAU)
	for side = 1, 5 do
		local angle = spin + side / 5 * TAU
		local reach = radius * rng:NextNumber(0.8, 1.1)
		ring[side] = ground + Vector3.new(math.cos(angle) * reach, -radius * 0.8, math.sin(angle) * reach)
	end
	LowPoly.pyramid(ring, ground + Vector3.yAxis * radius * 0.8, Props.shade(color, rng, 0.1), cluster, M.Rock)
	return radius
end

local function pebbles(parent: Model, ground: Vector3, rng: Random, color: Color3)
	local cluster = model("SeabedPebbles", parent)
	for _ = 1, 3 do
		local size = rng:NextNumber(0.5, 1.3)
		local center = ground + Vector3.new(rng:NextNumber(-0.8, 0.8), size * 0.15, rng:NextNumber(-0.8, 0.8))
		local pebble = Props.ball(cluster, center, size, Props.shade(color, rng, 0.12), M.Rock)
		pebble.Size = Vector3.new(size * 1.4, size * 0.65, size)
		pebble.CFrame *= CFrame.Angles(0, rng:NextNumber(0, TAU), 0)
	end
end

-- Curving ribbons rooted in the bottom, distinct from the washed-up beach weed.
local function seaweed(parent: Model, ground: Vector3, rng: Random, color: Color3)
	local weed = model("UnderwaterSeaweed", parent)
	for _ = 1, rng:NextInteger(3, 5) do
		local angle = rng:NextNumber(0, TAU)
		local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local base = ground + direction * rng:NextNumber(0, 1.3) - Vector3.yAxis * 0.35
		local height = rng:NextNumber(2.5, 6.2)
		local tint = Props.shade(color, rng, 0.18)
		local bend = rng:NextNumber(0.5, 1.5)
		local previous = base
		for step = 1, 2 do
			local t = step / 2
			local tip = base + Vector3.yAxis * height * t + direction * bend * t * t
			Props.beam(weed, previous, tip, 0.45 * (1 - t * 0.6), tint, 0.12, M.Grass)
			previous = tip
		end
	end
end

-- Mediterranean red/orange branching coral, with occasional rounded sponges.
local function coral(parent: Model, ground: Vector3, rng: Random, colors: { Color3 })
	local reef = model("BranchingCoral", parent)
	local color = Props.pick(rng, colors)
	local base = ground - Vector3.yAxis * 0.2
	local height = rng:NextNumber(1.7, 3.5)
	local fork = base + Vector3.new(0.1, height * 0.55, 0)
	Props.beam(reef, base, fork, 0.38, color, nil, M.Pebble)
	local spin = rng:NextNumber(0, TAU)
	for branch = 1, 4 do
		local angle = spin + branch / 4 * TAU
		local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local elbow = fork + direction * height * 0.38 + Vector3.yAxis * height * 0.15
		local tip = elbow + direction * 0.25 + Vector3.yAxis * height * rng:NextNumber(0.25, 0.5)
		Props.beam(reef, fork, elbow, 0.25, color, nil, M.Pebble)
		Props.beam(reef, elbow, tip, 0.17, color, nil, M.Pebble)
	end
	if rng:NextNumber() < 0.35 then
		Props.ball(reef, ground + Vector3.new(0.8, 0.35, 0.2), 1.1, Props.pick(rng, colors), M.Pebble)
	end
end

-- Decoration is scenery only: nothing collides with it, and it streams whole.
local function settle(patch: Model)
	for _, part in patch:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
			part.CastShadow = false
		end
	end
	patch.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
end

local function garden(parent: Instance, hit: RaycastResult, style: Style, rng: Random, params: RaycastParams)
	local patch = model("SeabedGarden", parent)
	local ground = hit.Position
	if style.sand and hit.Normal.Y > 0.98 and rng:NextNumber() < 0.45 then
		sandDrift(patch, ground, rng, Props.shade(style.sand, rng, 0.035), params)
	end
	local radius = stones(patch, ground, rng, style.stone)
	for _ = 1, rng:NextInteger(3, 5) do
		local angle, distance = rng:NextNumber(0, TAU), rng:NextNumber(radius + 1.5, 13)
		local point = sample(params, ground.X + math.cos(angle) * distance, ground.Z + math.sin(angle) * distance)
		if point and math.abs(point.Position.Y - ground.Y) < 4 then
			if style.coral and rng:NextNumber() < 0.42 then
				local kind = rng:NextNumber()
				if kind < 0.35 then
					SeabedLife.fan(patch, point.Position, rng, style.coral)
				elseif kind < 0.6 then
					SeabedLife.sponges(patch, point.Position, rng, style.coral)
				else
					coral(patch, point.Position, rng, style.coral)
				end
			elseif rng:NextNumber() < style.vegetation then
				local kind = rng:NextNumber()
				if kind < 0.3 then
					SeabedLife.kelp(patch, point.Position, rng, style.weed, Biomes.WaterLevel)
				elseif kind < 0.7 then
					SeabedLife.grass(patch, point.Position, rng, style.weed)
				else
					seaweed(patch, point.Position, rng, style.weed)
				end
			else
				pebbles(patch, point.Position, rng, style.stone)
			end
		end
	end
	-- Small finds sit between the vegetation rather than on top of the rocks.
	if rng:NextNumber() < 0.7 then
		local angle = rng:NextNumber(0, TAU)
		local point =
			sample(params, ground.X + math.cos(angle) * (radius + 2), ground.Z + math.sin(angle) * (radius + 2))
		if point and math.abs(point.Position.Y - ground.Y) < 3 then
			if rng:NextNumber() < 0.4 then
				SeabedLife.starfish(patch, point.Position, point.Normal, rng)
			else
				SeabedLife.shells(patch, point.Position, point.Normal, rng)
			end
		end
	end
	settle(patch)
end

-- One cheap piece of floor life. Kelp is left out: its height depends on the depth.
local function tuft(parent: Model, ground: Vector3, style: Style, rng: Random)
	local kind = rng:NextNumber()
	if style.coral and kind < 0.3 then
		local pick = rng:NextNumber()
		if pick < 0.35 then
			SeabedLife.fan(parent, ground, rng, style.coral)
		elseif pick < 0.6 then
			SeabedLife.sponges(parent, ground, rng, style.coral)
		else
			coral(parent, ground, rng, style.coral)
		end
	elseif kind < 0.3 + 0.45 * style.vegetation then
		if rng:NextNumber() < 0.6 then
			SeabedLife.grass(parent, ground, rng, style.weed)
		else
			seaweed(parent, ground, rng, style.weed)
		end
	elseif kind < 0.88 then
		pebbles(parent, ground, rng, style.stone)
	elseif kind < 0.95 then
		SeabedLife.shells(parent, ground, Vector3.yAxis, rng)
	else
		SeabedLife.starfish(parent, ground, Vector3.yAxis, rng)
	end
end

-- Built flat around the origin, so a copy can be turned and tilted onto any ground.
local function patchTemplate(style: Style, rng: Random): Model
	local patch = Instance.new("Model")
	patch.Name = "SeabedPatch"
	for index = 1, 2 do
		local angle = rng:NextNumber(0, TAU)
		local distance = if index == 1 then 0 else rng:NextNumber(5, 10)
		local point = Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
		if index == 1 and rng:NextNumber() < 0.2 then
			stones(patch, point, rng, style.stone)
		else
			tuft(patch, point, style, rng)
		end
	end
	settle(patch)
	patch.WorldPivot = CFrame.new()
	return patch
end

-- Dress swimming coves and island aprons more densely than the deep sea.
-- Sample actual mesh bounds so the gardens follow saved or regenerated coasts.
local function shoreGardens(
	parent: Instance,
	biome: Biomes.Biome,
	style: Style,
	surfaces: { Instance },
	params: RaycastParams,
	seed: number
)
	local rng = Random.new(seed)
	local candidates: { RaycastResult } = {}
	local harbourCandidates: { RaycastResult } = {}
	for _, ground in surfaces do
		if not ground:IsA("Model") or ground.Name ~= "Ground" then
			continue
		end
		local frame, size = ground:GetBoundingBox()
		if Biomes.at(frame.Position) ~= biome then
			continue
		end
		for x = frame.Position.X - size.X / 2 - 24, frame.Position.X + size.X / 2 + 24, 36 do
			for z = frame.Position.Z - size.Z / 2 - 24, frame.Position.Z + size.Z / 2 + 24, 36 do
				local hit = sample(params, x + rng:NextNumber(-3, 3), z + rng:NextNumber(-3, 3))
				if hit and hit.Position.Y > Biomes.WaterLevel - 44 and Biomes.at(hit.Position) == biome then
					local isHarbour = ground.Parent and ground.Parent.Name == "Harbour Isle"
					table.insert(if isHarbour then harbourCandidates else candidates, hit)
				end
			end
			task.wait()
		end
	end
	for _, list in { candidates, harbourCandidates } do
		for i = #list, 2, -1 do
			local j = rng:NextInteger(1, i)
			list[i], list[j] = list[j], list[i]
		end
	end
	-- Reserve the first gardens for the main swimming coves, then the archipelago.
	local ordered: { RaycastResult } = {}
	for index = 1, math.min(#harbourCandidates, 140) do
		table.insert(ordered, harbourCandidates[index])
	end
	for _, hit in candidates do
		table.insert(ordered, hit)
	end
	for index = 141, #harbourCandidates do
		table.insert(ordered, harbourCandidates[index])
	end
	local placed: { Vector2 } = {}
	for _, hit in ordered do
		if #placed >= style.shoreCount then
			break
		end
		local position = Vector2.new(hit.Position.X, hit.Position.Z)
		local clear = true
		for _, other in placed do
			if (other - position).Magnitude < 30 then
				clear = false
				break
			end
		end
		if not clear then
			continue
		end
		garden(parent, hit, style, rng, params)
		table.insert(placed, position)
		local index = #placed
		if index % 15 == 0 then
			task.wait()
		end
	end
	return placed
end

local function scatter(
	parent: Instance,
	biome: Biomes.Biome,
	style: Style,
	params: RaycastParams,
	seed: number,
	occupied: { Vector2 }?
)
	local rng = Random.new(seed)
	local placed: { Vector2 } = {}
	local blocked = occupied or {}
	for attempt = 1, style.count * 5 do
		if #placed >= style.count then
			break
		end
		local angle = rng:NextNumber(0, TAU)
		local position: Vector2
		if biome == Biomes.OpenSea then
			-- Sample the full ocean footprint, including the remote city approach.
			-- Biome and ocean checks below discard the two unfilled outer corners.
			position = Vector2.new(
				rng:NextNumber(Biomes.OceanMin + 40, Biomes.OceanMax - 40),
				rng:NextNumber(Biomes.OceanMin + 40, Biomes.OceanMax - 40)
			)
		else
			position = biome.center
				+ Vector2.new(math.cos(angle), math.sin(angle)) * (biome.radius - 35) * math.sqrt(rng:NextNumber())
		end
		local world = Vector3.new(position.X, 0, position.Y)
		if Biomes.at(world) ~= biome or not Biomes.inOceanBounds(world) then
			continue
		end
		local clear = true
		for _, other in blocked do
			if (other - position).Magnitude < 36 then
				clear = false
				break
			end
		end
		if clear then
			local hit = sample(params, position.X, position.Y)
			if hit then
				garden(parent, hit, style, rng, params)
				table.insert(placed, position)
				table.insert(blocked, position)
			end
		end
		if attempt % 20 == 0 then
			task.wait()
		end
	end
	return placed
end

-- The floor between gardens is carpeted with copies of small prebuilt patches, one per
-- grid cell. Cloned here that was ~60k copies and ~700k parts, which took live servers
-- past 6.5 GB and crashed them, so the server only publishes the templates (plus the
-- lake outline and the garden cells to leave bare) and each client fills the cells
-- around its own camera (client/SeabedCarpet, rules in shared/SeabedCarpet).
local function publishCarpet(seed: number, gardens: { Vector2 })
	local old = ReplicatedStorage:FindFirstChild(SeabedCarpet.FOLDER)
	if old then
		old:Destroy()
	end
	local rng = Random.new(seed)
	local carpet = Instance.new("Folder")
	carpet.Name = SeabedCarpet.FOLDER
	for _, id in SeabedCarpet.STYLES do
		local folder = Instance.new("Folder")
		folder.Name = id
		for index = 1, SeabedCarpet.TEMPLATES do
			local patch = patchTemplate(STYLES[id], rng)
			patch.Name = tostring(index)
			patch.Parent = folder
		end
		folder.Parent = carpet
	end
	local lake = Instance.new("StringValue")
	lake.Name = "Lake"
	lake.Value = SeabedCarpet.encode(Harbour.lakeOutline(Biomes.Normal.center))
	lake.Parent = carpet
	local bare = Instance.new("StringValue")
	bare.Name = "Gardens"
	bare.Value = SeabedCarpet.encode(gardens)
	bare.Parent = carpet
	carpet:SetAttribute("Seed", seed)
	carpet:SetAttribute("Version", VERSION)
	carpet.Parent = ReplicatedStorage
end

-- Garden positions from scenery that is already built (a baked map, or a repeat ensure).
local function gardensIn(details: Instance): { Vector2 }
	local gardens = {}
	for _, object in details:GetDescendants() do
		if object:IsA("Model") and object.Name == "SeabedGarden" then
			local pivot = object:GetPivot().Position
			table.insert(gardens, Vector2.new(pivot.X, pivot.Z))
		end
	end
	return gardens
end

function SeabedDetails.ensure(root: Instance)
	Seabed.ensureSand(root)
	local old = root:FindFirstChild("SeabedDetails")
	if old and old:GetAttribute("Version") == VERSION then
		local published = ReplicatedStorage:FindFirstChild(SeabedCarpet.FOLDER)
		if not published or published:GetAttribute("Version") ~= VERSION then
			publishCarpet(Biomes.Seed + 800, gardensIn(old))
		end
		return
	end
	if old then
		old:Destroy()
	end

	local details = Instance.new("Folder")
	details.Name = "SeabedDetails"
	details.Parent = root
	local surfaces: { Instance } = { workspace.Terrain }
	for _, descendant in root:GetDescendants() do
		if descendant:IsA("Model") and (descendant.Name == "Ground" or descendant.Name == "SeabedSlope") then
			table.insert(surfaces, descendant)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = surfaces
	params.IgnoreWater = true

	local gardens: { Vector2 } = {}
	for index, biome in Biomes.list do
		local folder = Instance.new("Folder")
		folder.Name = biome.name
		folder.Parent = details
		local occupied = shoreGardens(folder, biome, STYLES[biome.id], surfaces, params, Biomes.Seed + 700 + index)
		-- scatter appends its own gardens to `occupied`
		scatter(folder, biome, STYLES[biome.id], params, Biomes.Seed + 600 + index, occupied)
		table.move(occupied, 1, #occupied, #gardens + 1, gardens)
	end
	local open = Instance.new("Folder")
	open.Name = Biomes.OpenSea.name
	open.Parent = details
	local scattered = scatter(open, Biomes.OpenSea, STYLES.open, params, Biomes.Seed + 606)
	table.move(scattered, 1, #scattered, #gardens + 1, gardens)
	publishCarpet(Biomes.Seed + 800, gardens)
	details:SetAttribute("Version", VERSION)
end

return SeabedDetails
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="245">
          <Properties>
            <string name="Name">SeabedLife</string>
            <string name="Source"><![CDATA[-- Static marine life built from the same textured, low-poly parts as the islands.
local Props = require(script.Parent.Props)
local LowPoly = require(script.Parent.LowPoly)

local SeabedLife = {}
local TAU = math.pi * 2
local M = Enum.Material
local rgb = Color3.fromRGB

local function model(name: string, parent: Instance): Model
	local result = Instance.new("Model")
	result.Name = name
	result.Parent = parent
	return result
end

-- Short, splayed leaves make soft meadows between the taller rock gardens.
function SeabedLife.grass(parent: Instance, ground: Vector3, rng: Random, color: Color3)
	local meadow = model("Seagrass", parent)
	local spin = rng:NextNumber(0, TAU)
	for clump = 1, 3 do
		local angle = spin + clump / 3 * TAU
		local base = ground + Vector3.new(math.cos(angle) * 0.7, -0.15, math.sin(angle) * 0.7)
		for blade = 1, 3 do
			local facing = angle + blade * 2.4
			local lean = Vector3.new(math.cos(facing), 0, math.sin(facing))
			local tip = base + lean * rng:NextNumber(0.5, 1.1) + Vector3.yAxis * rng:NextNumber(1.2, 2.7)
			Props.beam(meadow, base, tip, 0.16, Props.shade(color, rng, 0.2), 0.07, M.Grass)
		end
	end
end

-- Broad alternating fronds on bent stalks. Depth caps keep the tips submerged.
function SeabedLife.kelp(parent: Instance, ground: Vector3, rng: Random, color: Color3, waterLevel: number)
	local kelp = model("Kelp", parent)
	local spin = rng:NextNumber(0, TAU)
	local height = math.min(rng:NextNumber(8, 14), waterLevel - ground.Y - 3)
	for stalk = 1, 2 do
		local angle = spin + stalk * 2.4
		local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local base = ground + direction * 0.7 - Vector3.yAxis * 0.25
		local previous = base
		local tint = Props.shade(color, rng, 0.15)
		for step = 1, 4 do
			local t = step / 4
			local tip = base + Vector3.yAxis * height * t + direction * (math.sin(t * 2.3) * 1.4)
			Props.beam(kelp, previous, tip, 0.16, tint, nil, M.Grass)
			local side = Vector3.new(-direction.Z, 0, direction.X) * (if step % 2 == 0 then 1 else -1)
			local endPoint = tip + side * (1.8 - t * 0.6) + direction * 0.35 + Vector3.yAxis * 0.5
			Props.beam(kelp, tip, endPoint, 0.55 * (1 - t * 0.35), tint, 0.09, M.Grass)
			previous = tip
		end
	end
end

-- Flat, spreading fans contrast with the existing upright branching coral.
function SeabedLife.fan(parent: Instance, ground: Vector3, rng: Random, colors: { Color3 })
	local fan = model("SeaFan", parent)
	local color = Props.pick(rng, colors)
	local angle = rng:NextNumber(0, TAU)
	local side = Vector3.new(math.cos(angle), 0, math.sin(angle))
	local base = ground - Vector3.yAxis * 0.15
	local hub = base + Vector3.yAxis * 0.9
	Props.beam(fan, base, hub, 0.28, color, nil, M.Pebble)
	for branch = -2, 2 do
		local elbow = hub + side * branch * 0.7 + Vector3.yAxis * (1.2 - math.abs(branch) * 0.2)
		local tip = elbow + side * branch * 0.2 + Vector3.yAxis * rng:NextNumber(0.6, 1.2)
		Props.beam(fan, hub, elbow, 0.2, color, nil, M.Pebble)
		Props.beam(fan, elbow, tip, 0.12, color, nil, M.Pebble)
		Props.beam(fan, elbow, tip + side * 0.5 - Vector3.yAxis * 0.2, 0.1, color, nil, M.Pebble)
	end
end

function SeabedLife.sponges(parent: Instance, ground: Vector3, rng: Random, colors: { Color3 })
	local sponges = model("TubeSponges", parent)
	local color = Props.pick(rng, colors)
	for tube = 1, 3 do
		local angle = tube / 3 * TAU
		local height = rng:NextNumber(1.1, 2.8)
		local width = rng:NextNumber(0.65, 1.1)
		local base = ground + Vector3.new(math.cos(angle) * 0.6, -0.15, math.sin(angle) * 0.6)
		Props.cylinder(sponges, base + Vector3.yAxis * height / 2, height, width, color, M.Pebble)
		-- Dark inset mouths read as openings without transparent or hollow meshes.
		Props.cylinder(
			sponges,
			base + Vector3.yAxis * (height + 0.01),
			0.04,
			width * 0.65,
			color:Lerp(rgb(25, 32, 36), 0.7),
			M.SmoothPlastic
		)
	end
end

-- A local surface frame keeps small bottom dwellers seated on sloping ground.
local function surfaceFrame(ground: Vector3, normal: Vector3, spin: number): CFrame
	local right = normal:Cross(Vector3.zAxis).Unit
	return CFrame.fromMatrix(ground + normal * 0.05, right, normal, right:Cross(normal)) * CFrame.Angles(0, spin, 0)
end

function SeabedLife.starfish(parent: Instance, ground: Vector3, normal: Vector3, rng: Random)
	local star = model("Starfish", parent)
	local color = Props.pick(rng, { rgb(215, 133, 80), rgb(193, 101, 75), rgb(212, 176, 114) })
	local frame = surfaceFrame(ground, normal, rng:NextNumber(0, TAU))
	local size = rng:NextNumber(0.7, 1.25)
	local center = frame * Vector3.new(0, 0.15, 0)
	local body = Props.ball(star, center, size * 0.65, color, M.Sand)
	body.Size = Vector3.new(size * 0.65, 0.22, size * 0.65)
	body.CFrame = frame * CFrame.new(0, 0.15, 0)
	for arm = 1, 5 do
		local angle = arm / 5 * TAU
		local tip = frame * Vector3.new(math.cos(angle) * size, 0, math.sin(angle) * size)
		local left = frame * Vector3.new(math.cos(angle - 0.5) * size * 0.32, 0, math.sin(angle - 0.5) * size * 0.32)
		local right = frame * Vector3.new(math.cos(angle + 0.5) * size * 0.32, 0, math.sin(angle + 0.5) * size * 0.32)
		LowPoly.triangle(left, tip, right, ground - normal, color, star, M.Sand, 0.1)
	end
end

function SeabedLife.shells(parent: Instance, ground: Vector3, normal: Vector3, rng: Random)
	local shells = model("Seashells", parent)
	local color = Props.pick(rng, { rgb(231, 219, 193), rgb(213, 182, 160), rgb(185, 174, 155) })
	local frame = surfaceFrame(ground, normal, rng:NextNumber(0, TAU))
	local size = rng:NextNumber(0.6, 1)
	local hinge = frame * Vector3.new(0, 0, -size * 0.45)
	for rib = 0, 5 do
		local a, b = rib / 6 * math.pi, (rib + 1) / 6 * math.pi
		local left = frame * Vector3.new(math.cos(a) * size, math.sin(a) * size * 0.28, math.sin(a) * size)
		local right = frame * Vector3.new(math.cos(b) * size, math.sin(b) * size * 0.28, math.sin(b) * size)
		LowPoly.triangle(hinge, left, right, ground - normal, Props.shade(color, rng, 0.07), shells, M.Limestone, 0.08)
	end
end

return SeabedLife
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="246">
          <Properties>
            <string name="Name">Shipwright</string>
            <string name="Source"><![CDATA[-- Mara is a locally built R6 rig dressed in genuine Roblox Marketplace items.
-- HumanoidDescription applies the catalog shirt, pants, hard hat and tool belt,
-- so those are the real catalog models instead of hand-sculpted lookalikes.
-- Classic faces are no longer sold in the Marketplace, so the head keeps the
-- engine's built-in smile texture. Building the rig locally keeps the shipwright
-- present even when an asset request is slow or unavailable.

local Shipwright = {}
local scheduled: { [Model]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local COSMETICS_VERSION = 3
local SKIN = Color3.fromRGB(216, 164, 119)

-- Verified Marketplace assets (all currently for sale):
--   Shirt  "Mechanic Coveralls +" (navy short-sleeved coverall top)
--   Pants  "Mechanic Coveralls -" (matching trousers and work boots)
--   Hat    "Hard Hat" (yellow construction helmet)
--   Waist  "Tool Belt" (hammer, wrenches and tape measure)
local COSMETICS = {
	Shirt = 6500613508,
	Pants = 6500616492,
	Hat = 9667880157,
	Waist = 12127743738,
}
Shipwright.COSMETICS = COSMETICS

local BODY_PARTS = {
	HumanoidRootPart = true,
	Torso = true,
	Head = true,
	["Right Arm"] = true,
	["Left Arm"] = true,
	["Right Leg"] = true,
	["Left Leg"] = true,
}

-- Also repair baked NPCs without rebuilding the workshop or launch equipment.
function Shipwright.ensureInteraction(model: Model): ProximityPrompt?
	local head = model:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return nil
	end
	local prompt = model:FindFirstChild("TalkToShipwrightPrompt", true)
	if prompt and not prompt:IsA("ProximityPrompt") then
		prompt:Destroy()
		prompt = nil
	end
	if not prompt then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = "TalkToShipwrightPrompt"
	end
	-- The invisible root is inside the torso, where camera occlusion can hide
	-- the prompt. Display it at the head; BoatService checks range, interior and
	-- the player's sightline on the server before opening or buying anything.
	prompt.ActionText = "Talk"
	prompt.ObjectText = "Mara · Shipwright"
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.HoldDuration = 0
	prompt.Enabled = true
	prompt.Style = Enum.ProximityPromptStyle.Default
	prompt.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.ClickablePrompt = true
	prompt.UIOffset = Vector2.new(0, -30)
	prompt.Parent = head
	return prompt
end

local function createDescription(): HumanoidDescription
	local description = Instance.new("HumanoidDescription")
	description.Name = "ShipwrightAppearance"
	description.Shirt = COSMETICS.Shirt
	description.Pants = COSMETICS.Pants
	description.HatAccessory = tostring(COSMETICS.Hat)
	description.WaistAccessory = tostring(COSMETICS.Waist)
	description.HeadColor = SKIN
	description.TorsoColor = SKIN
	description.LeftArmColor = SKIN
	description.RightArmColor = SKIN
	description.LeftLegColor = SKIN
	description.RightLegColor = SKIN
	return description
end

-- Classic faces are retired from the Marketplace, so restore the same built-in
-- smile the previous hand-built Mara used.
local function ensureFace(model: Model)
	local head = model:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return
	end
	local face = head:FindFirstChild("face")
	if face and face:IsA("Decal") then
		return
	end
	local decal = Instance.new("Decal")
	decal.Name = "face"
	decal.Face = Enum.NormalId.Front
	decal.Texture = "rbxasset://textures/face.png"
	decal.Parent = head
end

-- Older baked maps carried the previous hand-modelled costume. Remove those
-- pieces before applying the catalog outfit, otherwise both hats would render.
local function stripLegacyDetails(model: Model)
	for _, item in model:GetDescendants() do
		if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") then
			item:Destroy()
		elseif item:IsA("BasePart") and not BODY_PARTS[item.Name] then
			item:Destroy()
		elseif item:IsA("Decal") and item.Name == "face" then
			item:Destroy()
		end
	end
end

-- Applies the Marketplace outfit to a fresh or previously baked shipwright.
-- Returns true once the description has been applied and remembered on the
-- model, so repeated world upgrades do not reload the avatar assets.
function Shipwright.ensureAppearance(model: Model): boolean
	if model:GetAttribute("CosmeticsVersion") == COSMETICS_VERSION then
		return true
	end
	if not model:IsDescendantOf(game) then
		return false
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return false
	end
	-- Baked shipwrights predate the explicit rig type; keep descriptions on R6.
	humanoid.RigType = Enum.HumanoidRigType.R6

	stripLegacyDetails(model)

	local description = createDescription()
	local applied, reason = pcall(function()
		humanoid:ApplyDescriptionAsync(description)
	end)
	description:Destroy()
	-- Keep a readable face even if the catalog request failed.
	ensureFace(model)
	if not applied then
		warn("Shipwright Marketplace cosmetics failed to load: " .. tostring(reason))
		return false
	end

	-- Applying before the model is parented can silently skip the accessories.
	-- Report that as unfinished so the caller's post-parent retry runs.
	local hasShirt, hasPants, hasAccessory = false, false, false
	for _, item in model:GetDescendants() do
		if item:IsA("Shirt") then
			hasShirt = true
		elseif item:IsA("Pants") then
			hasPants = true
		elseif item:IsA("Accessory") then
			hasAccessory = true
		end
	end
	if not (hasShirt and hasPants and hasAccessory) then
		warn("Shipwright Marketplace cosmetics did not fully attach; retrying after parenting")
		return false
	end

	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") then
			item.CanCollide = false
			item.CanTouch = false
			item.Massless = true
			item.Anchored = item.Name == "HumanoidRootPart"
			if item.Name == "HumanoidRootPart" then
				item.CanQuery = false
				item.CastShadow = false
			end
		end
	end

	model:SetAttribute("CosmeticsVersion", COSMETICS_VERSION)
	return true
end

-- Asset loading may yield, and generated maps can be built outside the DataModel.
-- Wait for parenting without holding up world generation or calling the avatar API early.
function Shipwright.scheduleAppearance(model: Model)
	if scheduled[model] or model:GetAttribute("CosmeticsVersion") == COSMETICS_VERSION then
		return
	end
	scheduled[model] = true
	local connection: RBXScriptConnection? = nil
	local function tryStart()
		if not model:IsDescendantOf(game) then
			return
		end
		if connection then
			connection:Disconnect()
			connection = nil
		end
		task.spawn(function()
			local ok, reason = pcall(Shipwright.ensureAppearance, model)
			scheduled[model] = nil
			if not ok then
				warn("Shipwright appearance setup failed: " .. tostring(reason))
			end
		end)
	end
	connection = model.AncestryChanged:Connect(tryStart)
	tryStart()
end

-- frame is at the soles of the boots. The rig looks along its local -Z axis.
function Shipwright.build(frame: CFrame): Model
	local model = Instance.new("Model")
	model.Name = "Shipwright"
	model:SetAttribute("NpcName", "Mara")
	model:SetAttribute("Role", "Shipwright")

	local function part(name: string, size: Vector3, offset: CFrame, color: Color3): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = frame * offset
		p.Color = color
		p.Material = Enum.Material.SmoothPlastic
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.CanCollide = false
		p.CanTouch = false
		p.Massless = true
		p.Parent = model
		return p
	end

	local root = part("HumanoidRootPart", Vector3.new(2, 2, 1), CFrame.new(0, 3, 0), SKIN)
	root.Transparency = 1
	root.CanQuery = false
	root.Anchored = true
	root.CastShadow = false
	local torso = part("Torso", Vector3.new(2, 2, 1), CFrame.new(0, 3, 0), SKIN)
	local head = part("Head", Vector3.new(2, 1, 1), CFrame.new(0, 4.5, 0), SKIN)
	local headMesh = Instance.new("SpecialMesh")
	headMesh.MeshType = Enum.MeshType.Head
	headMesh.Scale = Vector3.new(1.1, 1.1, 1.1)
	headMesh.Parent = head

	local rightArm = part("Right Arm", Vector3.new(1, 2, 1), CFrame.new(1.5, 3, 0), SKIN)
	local leftArm = part("Left Arm", Vector3.new(1, 2, 1), CFrame.new(-1.5, 3, 0), SKIN)
	local rightLeg = part("Right Leg", Vector3.new(1, 2, 1), CFrame.new(0.5, 1, 0), SKIN)
	local leftLeg = part("Left Leg", Vector3.new(1, 2, 1), CFrame.new(-0.5, 1, 0), SKIN)

	-- Standard R6 attachment points, copied from Roblox's own R6 character.
	-- Humanoid:ApplyDescription welds catalog accessories to the attachment that
	-- shares their name, so the hard hat and tool belt land in the right place.
	local function attach(bodyPart: BasePart, name: string, offset: Vector3)
		local point = Instance.new("Attachment")
		point.Name = name
		point.CFrame = CFrame.new(offset.X, offset.Y, offset.Z)
		point.Parent = bodyPart
	end
	attach(head, "FaceCenterAttachment", Vector3.new(0, 0, 0))
	attach(head, "FaceFrontAttachment", Vector3.new(0, 0, -0.6))
	attach(head, "HairAttachment", Vector3.new(0, 0.6, 0))
	attach(head, "HatAttachment", Vector3.new(0, 0.6, 0))
	attach(torso, "BodyBackAttachment", Vector3.new(0, 0, 0.5))
	attach(torso, "BodyFrontAttachment", Vector3.new(0, 0, -0.5))
	attach(torso, "LeftCollarAttachment", Vector3.new(-1, 1, 0))
	attach(torso, "NeckAttachment", Vector3.new(0, 1, 0))
	attach(torso, "RightCollarAttachment", Vector3.new(1, 1, 0))
	attach(torso, "WaistBackAttachment", Vector3.new(0, -1, 0.5))
	attach(torso, "WaistCenterAttachment", Vector3.new(0, -1, 0))
	attach(torso, "WaistFrontAttachment", Vector3.new(0, -1, -0.5))
	attach(rightArm, "RightShoulderAttachment", Vector3.new(0, 1, 0))
	attach(leftArm, "LeftShoulderAttachment", Vector3.new(0, 1, 0))

	-- Standard R6 joint names and positions keep all six body parts on one rig.
	local function motor(name: string, a: BasePart, b: BasePart, offset: CFrame)
		local joint = Instance.new("Motor6D")
		joint.Name = name
		joint.Part0 = a
		joint.Part1 = b
		local jointFrame = frame * offset
		joint.C0 = a.CFrame:ToObjectSpace(jointFrame)
		joint.C1 = b.CFrame:ToObjectSpace(jointFrame)
		joint.Parent = a
	end
	motor("RootJoint", root, torso, CFrame.new(0, 3, 0))
	motor("Neck", torso, head, CFrame.new(0, 4, 0))
	motor("Right Shoulder", torso, rightArm, CFrame.new(1, 3.5, 0))
	motor("Left Shoulder", torso, leftArm, CFrame.new(-1, 3.5, 0))
	motor("Right Hip", torso, rightLeg, CFrame.new(0.5, 2, 0))
	motor("Left Hip", torso, leftLeg, CFrame.new(-0.5, 2, 0))

	local humanoid = Instance.new("Humanoid")
	humanoid.DisplayName = "Mara · Shipwright"
	humanoid.RigType = Enum.HumanoidRigType.R6
	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0
	humanoid.JumpHeight = 0
	humanoid.AutoRotate = false
	humanoid.BreakJointsOnDeath = false
	humanoid.NameDisplayDistance = 28
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.Parent = model

	model.PrimaryPart = root
	ensureFace(model)
	Shipwright.ensureInteraction(model)
	return model
end

return Shipwright
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="247">
          <Properties>
            <string name="Name">ShopDesk</string>
            <string name="Source"><![CDATA[local ImportedModel = require(script.Parent.ImportedModel)
local DeskGeometry = require(script.Parent.ShopDeskGeometry)

local ShopDesk = {}
local VERSION = 5
-- Fills two grid cells across (FurnitureCatalog), less a sliver at each end.
local DESK_WIDTH = 8.2
local DESK_HEIGHT = 64 * DESK_WIDTH / 160
-- The supplied register mesh came through as ~1,770 sliver wedges per shop, and every
-- base streams in whole, so the harbour arrived as tens of thousands of parts at once.
-- It is block-built instead, in the same footprint and finishes.
local REGISTER_VERSION = 5
local rgb = Color3.fromRGB
local M = Enum.Material
local DESK_APPEARANCE = {
	obj_0 = { color = rgb(105, 69, 43), material = M.Wood },
	obj_1 = { color = rgb(74, 46, 30), material = M.Wood },
	obj_2 = { color = rgb(137, 97, 62), material = M.Wood },
	obj_3 = { color = rgb(137, 97, 62), material = M.Wood },
	obj_4 = { color = rgb(176, 137, 68), material = M.Metal },
	obj_5 = { color = rgb(176, 137, 68), material = M.Metal },
}
local REGISTER_APPEARANCE = {
	obj_0_color_2829873 = { color = rgb(48, 58, 62), material = M.Metal },
	obj_0_color_6383466 = { color = rgb(55, 107, 112), material = M.Metal },
	obj_0_color_10988977 = { color = rgb(181, 190, 187), material = M.Metal },
	obj_0_color_14541540 = { color = rgb(235, 227, 205), material = M.SmoothPlastic },
}

-- Origin on the desktop under the register's middle. The keys slope down towards the
-- shopkeeper (+Z); the customer display stands at the back left.
local KEY_SLOPE = math.atan2(0.8, 0.93)
local REGISTER_PARTS = {
	-- group, kind, size, local frame
	{ "obj_0_color_2829873", "Part", Vector3.new(1.8, 0.42, 1.78), CFrame.new(0, 0.21, 0) },
	{ "obj_0_color_2829873", "Part", Vector3.new(0.12, 0.4, 0.12), CFrame.new(-0.6, 1.42, -0.6) },
	{ "obj_0_color_2829873", "Part", Vector3.new(0.62, 0.29, 0.1), CFrame.new(-0.6, 1.765, -0.6) },
	{ "obj_0_color_6383466", "Part", Vector3.new(1.8, 0.8, 0.85), CFrame.new(0, 0.82, -0.465) },
	{
		"obj_0_color_6383466",
		"WedgePart",
		Vector3.new(1.8, 0.8, 0.93),
		CFrame.new(0, 0.82, 0.425) * CFrame.Angles(0, math.pi, 0),
	},
	{ "obj_0_color_10988977", "Part", Vector3.new(1.5, 0.24, 0.02), CFrame.new(0, 0.21, 0.9) },
	{ "obj_0_color_10988977", "Part", Vector3.new(0.5, 0.05, 0.05), CFrame.new(0, 0.24, 0.935) },
	{ "obj_0_color_10988977", "Part", Vector3.new(0.52, 0.2, 0.02), CFrame.new(-0.6, 1.765, -0.66) },
	{ "obj_0_color_10988977", "Part", Vector3.new(0.45, 0.14, 0.45), CFrame.new(0.55, 1.29, -0.55) },
	{
		"obj_0_color_14541540",
		"Part",
		Vector3.new(1.3, 0.02, 1),
		CFrame.new(0, 0.82, 0.425) * CFrame.Angles(KEY_SLOPE, 0, 0) * CFrame.new(0, 0.011, 0),
	},
	{ "obj_0_color_14541540", "Part", Vector3.new(0.3, 0.12, 0.01), CFrame.new(0.55, 1.42, -0.55) },
}

local function buildRegister(desk: Model, frame: CFrame): Model
	local register = Instance.new("Model")
	register.Name = "CashRegister"
	register:SetAttribute("ModelVersion", REGISTER_VERSION)
	register:SetAttribute("SourceModel", "Cash Register")
	for _, spec in REGISTER_PARTS do
		local name, kind, size, offset = spec[1], spec[2], spec[3], spec[4]
		local group = register:FindFirstChild(name)
		if not group then
			group = Instance.new("Model")
			group.Name = name
			-- The supplied palette stays as metadata, as ImportedModel keeps it.
			local hex = tonumber(string.match(name, "%d+$")) :: number
			group:SetAttribute("SourceColor", Color3.fromRGB(hex // 65536, hex // 256 % 256, hex % 256))
			group.Parent = register
		end
		local finish = REGISTER_APPEARANCE[name]
		local item = Instance.new(kind) :: BasePart
		item.Name = "Solid"
		item.Size = size
		item.CFrame = frame * offset
		item.Color = finish.color
		item.Material = finish.material
		item.Anchored = true
		item.CanCollide = false
		item.CanTouch = false
		item.CastShadow = false
		item.TopSurface = Enum.SurfaceType.Smooth
		item.BottomSurface = Enum.SurfaceType.Smooth
		item.Parent = group
	end
	register.Parent = desk
	return register
end

local function registerFrame(frame: CFrame): CFrame
	-- Local +Z is the desk's front (the supplied cabinet handles). Viewed
	-- from that front, -X is the left side. Both models share that facing.
	return frame * CFrame.new(-0.31 * DESK_WIDTH, DESK_HEIGHT, 0)
end

function ShopDesk.build(parent: Instance, frame: CFrame): Model
	local desk = ImportedModel.build(parent, frame, DeskGeometry, {
		name = "ShopDesk",
		sourceName = "Ingenious Lappi",
		version = VERSION,
		width = DESK_WIDTH,
		appearance = DESK_APPEARANCE,
	})
	buildRegister(desk, registerFrame(frame))
	return desk
end

ShopDesk.WIDTH = DESK_WIDTH
ShopDesk.HEIGHT = DESK_HEIGHT
ShopDesk.DEPTH = 65 * DESK_WIDTH / 160
-- Turned clockwise as seen from above, beside the shop's front window to the
-- right of its door (house-local; the shop stands across the road). The end
-- stays clear of the window sill's stone lip. Customers stand on the desk's
-- local -Z side (toward the aisle), facing the shopkeeper.
function ShopDesk.frame(houseFrame: CFrame): CFrame
	return houseFrame * CFrame.new(-16, 0.16, 66.575 + DESK_WIDTH / 2) * CFrame.Angles(0, -math.pi / 2, 0)
end

function ShopDesk.ensure(shop: Model, houseFrame: CFrame)
	local existing = shop:FindFirstChild("ShopDesk")
	local register = existing and existing:FindFirstChild("CashRegister")
	if
		existing
		and existing:IsA("Model")
		and existing:GetAttribute("ModelVersion") == VERSION
		and existing:GetAttribute("SourceHash") == DeskGeometry.sourceHash
	then
		if not register or not register:IsA("Model") or register:GetAttribute("ModelVersion") ~= REGISTER_VERSION then
			-- Saved maps still hold the sliver-built register; swap just that.
			if register then
				register:Destroy()
			end
			buildRegister(existing, registerFrame(ShopDesk.frame(houseFrame)))
		end
		return
	end
	if existing then
		existing:Destroy()
	end
	ShopDesk.build(shop, ShopDesk.frame(houseFrame))
end

return ShopDesk
]]></string>
          </Properties>
        </Item>
