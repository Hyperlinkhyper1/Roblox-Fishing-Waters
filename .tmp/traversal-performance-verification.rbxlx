			box = {
				center = Vector3.new(-2.1394, 31.8606, 10),
				size = Vector3.new(20, 20.000039906, 20.000039906),
				right = Vector3.new(0, 0, -1),
				up = Vector3.new(0.978148048, -0.207909585, 0),
			},
			faces = {
				{ 143, 144, 145 },
				{ 144, 146, 145 },
				{ 147, 148, 149 },
				{ 148, 150, 149 },
				{ 147, 149, 145 },
				{ 149, 143, 145 },
