		{
			name = "obj_5",
			color = Color3.new(0.9137254901960784, 0.11372549019607843, 0.17647058823529413),
			box = {
				center = Vector3.new(25.1335, 30.86645, 10.5),
				size = Vector3.new(21, 5.999990467, 22.000038183),
				right = Vector3.new(0, 0, -1),
