		}),
	}),
	Trawler = table.freeze({
		Name = "Teal fishing trawler",
		Price = 17500,
		MaxHealth = 350,
		ForwardSpeed = 70,
		ReverseSpeed = 20,
		TurnRate = 0.85,
		Acceleration = 35,
		CoastDeceleration = 6,
