          <string name="Source"><![CDATA[return table.freeze({
	DoubleXP = table.freeze({ Id = 2057358447, Name = "2x XP" }),
	AutoStore = table.freeze({ Id = 3722004182, Name = "Auto Store" }),
	BlackHoleBackpack = table.freeze({ Id = 2070894733, Name = "Black Hole Backpack", Price = 999 }),
	-- Regional pricing is on, so no fixed Price: the purchase prompt shows each
	-- player's own price.
