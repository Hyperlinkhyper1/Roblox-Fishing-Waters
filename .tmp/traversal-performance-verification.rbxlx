        <Item class="ModuleScript" referent="104">
          <Properties>
            <string name="Name">RedMullet</string>
            <string name="Source"><![CDATA[return {
	Name = "Red Mullet",
	Rarity = "Uncommon",
	RarityDenominator = 9,
	MinKg = 0.1,
	AverageKg = 0.4,
