	local function layoutDock(compact: boolean)
		card.Size = UDim2.fromOffset(if compact then 400 else 800, if compact then 774 else 560)
		dockDescription.Size = UDim2.fromOffset(if compact then 352 else 740, 22)
		dockDescription.TextSize = if compact then 12 else 13
		dockRule.Position = UDim2.fromOffset(24, 112)
		previewPanel.Position = UDim2.fromOffset(24, 126)
		previewPanel.Size = UDim2.fromOffset(if compact then 352 else 430, if compact then 238 else 342)
		dockBoatName.Position = UDim2.fromOffset(if compact then 24 else 478, if compact then 376 else 126)
		dockBoatName.Size = UDim2.fromOffset(if compact then 352 else 298, 30)
		fleetLabel.Position = UDim2.fromOffset(if compact then 24 else 478, if compact then 409 else 164)
		fleet.Position = UDim2.fromOffset(if compact then 24 else 478, if compact then 434 else 188)
		fleet.Size = UDim2.fromOffset(if compact then 352 else 298, if compact then 156 else 166)
		for index, boatId in boatIds do
			local choice = dockChoices[boatId]
			choice.Position = UDim2.fromOffset(0, (index - 1) * 52)
			choice.Size = UDim2.fromOffset(if compact then 344 else 290, 46)
		end
		dockStats.Position = UDim2.fromOffset(if compact then 24 else 478, if compact then 598 else 366)
		dockStats.Size = UDim2.fromOffset(if compact then 358 else 304, 62)
		dockStatus.Position = UDim2.fromOffset(24, if compact then 668 else 484)
		dockStatus.Size = UDim2.fromOffset(if compact then 352 else 430, if compact then 28 else 48)
		launch.Position = UDim2.fromOffset(if compact then 24 else 478, if compact then 710 else 478)
		launch.Size = UDim2.fromOffset(if compact then 352 else 298, if compact then 48 else 56)
	end
	local layoutSize = Vector2.zero
	local layoutIsDock = false
	local function layoutMenu()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local size = camera.ViewportSize
		if size == layoutSize and dock.Visible == layoutIsDock then
			return
		end
		layoutSize, layoutIsDock = size, dock.Visible
		overlay.BackgroundTransparency = if dock.Visible then 0.35 else 1
		local portrait = size.X < size.Y * 1.2
		if dock.Visible then
			layoutDock(size.X < 700 or portrait)
			card.AnchorPoint = Vector2.new(0.5, 0.5)
			card.Position = UDim2.fromScale(0.5, 0.5)
			scale.Scale = math.min(1, (size.X - 32) / card.Size.X.Offset, (size.Y - 32) / card.Size.Y.Offset)
		else
			card.Size = UDim2.fromOffset(380, 500)
			card.AnchorPoint = if portrait then Vector2.new(0.5, 1) else Vector2.new(0, 0.5)
			card.Position = if portrait then UDim2.new(0.5, 0, 1, -16) else UDim2.new(0, 20, 0.5, 0)
			scale.Scale = math.min(1, (size.X - 32) / 380, (size.Y * (if portrait then 0.48 else 0.88)) / 500)
		end
	end
	local function refreshDockPreview()
		if not overlay.Visible or not dock.Visible then
			dockPreview.show(nil)
			return
		end
		local dataStatus = player:GetAttribute("BoatDataStatus")
		local ready = dataStatus == "Ready"
		local owned = player:GetAttribute("Owns" .. selectedDockBoatId) == true
		dockPreview.show(if ready and owned then selectedDockBoatId else nil)
		if not ready or not owned then
			previewStatus.Visible = true
			previewStatus.Text = if dataStatus == "Unavailable"
				then "Fleet unavailable"
				elseif not ready then "Loading your fleet…"
				else "Claim a free rowboat from Mara\nat the shipyard."
		end
	end
	dock:GetPropertyChangedSignal("Visible"):Connect(function()
		layoutMenu()
		refreshDockPreview()
	end)
	close.ZIndex = 3
	browse.Activated:Connect(function()
		request:FireServer("BrowseBoat", selectedBoatId)
	end)
	leave.Activated:Connect(function()
		overlay.Visible = false
	end)
	-- Every dismissal path (buttons, distance, Escape and respawn) restores camera.
	overlay:GetPropertyChangedSignal("Visible"):Connect(function()
		player:SetAttribute("DrydockScreenOpen", overlay.Visible or isLaunching)
		if overlay.Visible then
			layoutMenu()
		end
		refreshDockPreview()
		if not overlay.Visible and not isLaunching then
			previewShop = nil
			dockBase = nil
			DrydockCamera.stop()
		end
	end)
	player:SetAttribute("DrydockScreenOpen", false)
	player.CharacterAdded:Connect(function()
		overlay.Visible = false
		BoatCamera.stop()
		if not isLaunching then
			DrydockCamera.stop()
		end
	end)

	local toast = Instance.new("TextLabel")
	toast.Name = "BoatNotice"
	toast.AnchorPoint = Vector2.new(0.5, 1)
	toast.Position = UDim2.new(0.5, 0, 1, -88)
	toast.Size = UDim2.new(0.86, 0, 0, 66)
	toast.BackgroundColor3 = navy
	toast.BackgroundTransparency = 0.06
	toast.TextColor3 = cream
	toast.Font = Enum.Font.GothamMedium
	toast.TextSize = 15
	toast.TextWrapped = true
	toast.Visible = false
	toast.ZIndex = 5
	toast.Parent = gui
	Theme.panel(toast, false, 4)
	Theme.text(toast)
	local toastBounds = Instance.new("UISizeConstraint")
	toastBounds.MaxSize = Vector2.new(580, 66)
	toastBounds.Parent = toast
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft, padding.PaddingRight = UDim.new(0, 14), UDim.new(0, 14)
	padding.Parent = toast
	local noticeId = 0
	local function notice(message: string)
		noticeId += 1
		local current = noticeId
		toast.Text, toast.Visible = message, true
		task.delay(6, function()
			if noticeId == current then
				toast.Visible = false
			end
		end)
	end
	local function refresh()
		local amount = player:GetAttribute("Cash") or 0
		local dataStatus = player:GetAttribute("BoatDataStatus")
		local owned = player:GetAttribute("Owns" .. selectedBoatId) == true
		local locked = not owned and player:GetAttribute("BoatLocked" .. selectedBoatId) == true
		local pathName = spec.RequiresPath and Paths.Stages[spec.RequiresPath].Name or ""
		local ready = dataStatus == "Ready"
		local ownsAnyBoat = false
		for _, id in boatIds do
			if player:GetAttribute("Owns" .. id) == true then
				ownsAnyBoat = true
			end
		end
		greeting.Text = if ownsAnyBoat
			then "Welcome back! Browse our boats, or launch a boat you already own from the boat stand on your own dock."
			else "Looking for your first boat? Claim the free wooden rowboat, or choose a bigger, faster fishing boat. We'll lower it into the water and put you aboard."
		title.Text = spec.Name
		description.Text = if selectedBoatId == "RacingSpeedboat"
			then "Our fastest boat with the sharpest turns. Four cockpit seats and 49 units of cargo space: 15 fewer than the fishing boat."
			elseif
				selectedBoatId == "Tugboat"
			then "A black harbour tug with a full rubber fender and the toughest hull in the yard. Twin thrusters pivot it on the spot; cruise at 75 studs/s with the same 64 units of cargo space as the fishing boat."
			elseif
				selectedBoatId == "Trawler"
			then "A traditional teal fishing trawler with a sheltered forward wheelhouse, stern gantry, net drum and two fishing seats. Cruise at 70 studs/s with 104 units of cargo space."
			elseif
				selectedBoatId == "PatrolBoat"
			then "A long gray patrol cruiser with a wheelhouse for two, stern benches for two more, 128 units of cargo space and more speed. Pivots easily in harbour; turns a little wider than the Bluewater speedboat at speed."
			elseif
				selectedBoatId == "Hovercraft"
			then "A navy hovercraft with a big ducted stern fan and three bucket seats. Glides at 65 studs/s with the same hull strength and 64 units of cargo space as the fishing boat."
			elseif
				selectedBoatId == "Speedboat"
			then "A blue-and-white sport cruiser with more speed, sharper turns and the same 64 units of cargo space as the fishing boat."
			elseif
				selectedBoatId == "FishingBoat"
			then "A bigger hull, a sheltered wheelhouse and room for three. Cruise faster to your next fishing spot."
			else "A simple wooden boat for your first trips. Inspect the hull before we lower it into the water."
		statValues[1].Text = tostring(spec.ForwardSpeed) .. " studs/s"
		statValues[2].Text = tostring(spec.ReverseSpeed) .. " studs/s"
		statValues[3].Text = string.format("%.0f°/s", math.deg(spec.TurnRate))
		statValues[4].Text = tostring(spec.Length)
			.. " × "
			.. tostring(spec.Beam)
			.. " studs / "
			.. tostring(spec.Seats)
		for index, ratio in {
			spec.ForwardSpeed / best.speed,
			spec.ReverseSpeed / best.reverse,
			spec.TurnRate / best.turn,
			spec.Seats / best.seats,
		} do
			statBars[index].Size = UDim2.fromScale(math.clamp(ratio, 0.04, 1), 1)
		end
		price.Text = formatPrice(spec.Price)
		for boatId, tab in boatTabs do
			Theme.glassButton(tab, if boatId == selectedBoatId then "Selected" else nil)
		end
		local formatted = tostring(amount):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
		cash.Text = if ready then formatted .. " $" else "—"
		balance.Text = if ready then "$" .. formatted else "Unavailable"
		local occupied = previewShop and previewShop:GetAttribute("LaunchingUserId") ~= nil
		buy.Active = ready and not owned and not locked and amount >= spec.Price and not occupied and not isLaunching
		buy.Selectable = buy.Active
		buy.AutoButtonColor = buy.Active
		Theme.glassButton(buy, if buy.Active then "Selected" else "Disabled")
		-- The dot repeats the status in colour; the sentence beside it carries the meaning.
		statusDot.BackgroundColor3 = if dataStatus == "Unavailable"
			then Color3.fromRGB(238, 107, 111)
			elseif not ready or occupied then Color3.fromRGB(240, 196, 92)
			elseif owned then accent
			elseif locked or amount < spec.Price then Color3.fromRGB(240, 160, 92)
			else Theme.Colors.Green
		buy.Text = if owned
			then "Boat owned"
			elseif locked then "Unlocks with " .. pathName
			elseif occupied then "Drydock busy"
			else (if spec.Price == 0 then "Claim & launch · Free" else "Buy & launch · " .. formatPrice(spec.Price))
		if dataStatus == "Unavailable" then
			status.Text = "Wallet could not load. Rejoin to try again."
		elseif not ready then
			status.Text = "Loading your wallet…"
		elseif owned then
			status.Text = "Owned! Use the boat stand at your own dock to spawn it."
		elseif locked then
			status.Text = "Unlock " .. pathName .. " on the Home ▸ Paths tab to buy this boat."
		elseif occupied then
			status.Text = "Another boat is launching. The drydock will be ready shortly."
		elseif amount < spec.Price then
			status.Text = "You need $" .. tostring(spec.Price - amount) .. " more to buy this boat."
		else
			status.Text = "Includes launch and automatic boarding. Sail this boat to your own plot."
		end
		if player:GetAttribute("Owns" .. selectedDockBoatId) ~= true then
			for _, boatId in boatIds do
				if player:GetAttribute("Owns" .. boatId) == true then
					selectedDockBoatId = boatId
					break
				end
			end
		end
		for _, boatId in boatIds do
			local choice, boatSpec = dockChoices[boatId], BoatCatalog[boatId]
			local boatOwned = player:GetAttribute("Owns" .. boatId) == true
			choice.Active, choice.Selectable = ready and boatOwned, ready and boatOwned
			choice.Text = (if boatOwned and boatId == selectedDockBoatId then "✓  " else "")
				.. boatSpec.Name
				.. "\n"
				.. (
					if not ready
						then "Loading…"
						elseif boatOwned then "Owned · ready to launch"
						elseif player:GetAttribute("BoatLocked" .. boatId) == true then
							"Unlocks with " .. Paths.Stages[boatSpec.RequiresPath].Name
						else "Available at the shipyard · " .. formatPrice(boatSpec.Price)
				)
			Theme.glassButton(
				choice,
				if not ready or not boatOwned
					then "Disabled"
					elseif boatId == selectedDockBoatId then "Selected"
					else nil
			)
		end
		local dockSpec = BoatCatalog[selectedDockBoatId]
		dockBoatName.Text = if ownsAnyBoat then dockSpec.Name else "Your fleet starts here"
		local cargoSlots = 0
		for _, row in dockSpec.Hold do
			local _, count = row:gsub("#", "")
			cargoSlots += count
		end
		dockStatValues[1].Text = if ownsAnyBoat then tostring(dockSpec.ForwardSpeed) else "—"
		dockStatValues[2].Text = if ownsAnyBoat then tostring(dockSpec.Seats) else "—"
		dockStatValues[3].Text = if ownsAnyBoat then tostring(cargoSlots) else "—"
		previewHint.Visible = ownsAnyBoat and ready
		refreshDockPreview()
		launch.Active = ready and player:GetAttribute("Owns" .. selectedDockBoatId) == true and not isLaunching
		launch.Selectable, launch.AutoButtonColor = launch.Active, launch.Active
		Theme.glassButton(launch, if launch.Active then "Selected" else "Disabled")
		launch.Text = if dataStatus == "Unavailable"
			then "Fleet unavailable"
			elseif not ready then "Loading boats…"
			elseif ownsAnyBoat then "Launch boat  →"
			else "No boats owned"
		dockStatus.Text = if dataStatus == "Unavailable"
			then "Your boats could not load. Rejoin to try again."
			elseif not ready then "Loading your boats…"
			elseif not ownsAnyBoat then "Visit Mara at the shipyard to claim a free rowboat."
			else "Launching replaces your current boat. Your new boat will be waiting at this dock."
	end
	for _, id in boatIds do
		player:GetAttributeChangedSignal("Owns" .. id):Connect(refresh)
		player:GetAttributeChangedSignal("BoatLocked" .. id):Connect(refresh)
	end
	for _, attribute in { "Cash", "BoatDataStatus" } do
		player:GetAttributeChangedSignal(attribute):Connect(refresh)
	end
	for boatId, choice in dockChoices do
		choice.Activated:Connect(function()
			if not choice.Active then
				return
			end
			selectedDockBoatId = boatId
			refresh()
		end)
	end
	launch.Activated:Connect(function()
		if launch.Active then
			request:FireServer("SpawnBoat", selectedDockBoatId)
			overlay.Visible = false
		end
	end)
	refresh()
	player:GetAttributeChangedSignal("PlayerMenuOpen"):Connect(function()
		if player:GetAttribute("PlayerMenuOpen") then
			overlay.Visible = false
		end
	end)
	close.Activated:Connect(function()
		overlay.Visible = false
	end)
	overlay.Activated:Connect(function()
		overlay.Visible = false
	end)
	buy.Activated:Connect(function()
		if buy.Active then
			request:FireServer("PurchaseBoat", selectedBoatId)
		end
	end)
	local function toggleLights()
		if
			controlledBoat
			and lightsToggle.Visible
			and not overlay.Visible
			and not player:GetAttribute("PlayerMenuOpen")
		then
			request:FireServer("ToggleLights")
		end
	end
	lightsToggle.Activated:Connect(toggleLights)
	local function toggleCamera()
		if
			controlledBoat
			and cameraToggle.Visible
			and not overlay.Visible
			and not player:GetAttribute("PlayerMenuOpen")
		then
			BoatCamera.cycle()
			cameraToggle.Text = "Camera [V]\n" .. BoatCamera.label()
		end
	end
	cameraToggle.Activated:Connect(toggleCamera)
	local function toggleNet()
		if
			controlledBoat
			and netToggle.Visible
			and not overlay.Visible
			and not player:GetAttribute("PlayerMenuOpen")
		then
			netRemote:FireServer("Toggle")
		end
	end
	netToggle.Activated:Connect(toggleNet)
	UserInputService.InputBegan:Connect(function(input, processed)
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			overlay.Visible = false
		elseif input.KeyCode == Enum.KeyCode.L and not processed and not UserInputService:GetFocusedTextBox() then
			toggleLights()
		elseif input.KeyCode == Enum.KeyCode.V and not processed and not UserInputService:GetFocusedTextBox() then
			toggleCamera()
		elseif input.KeyCode == Enum.KeyCode.N and not processed and not UserInputService:GetFocusedTextBox() then
			toggleNet()
		end
	end)
	local function commandNotice(message: string)
		local channels = TextChatService:FindFirstChild("TextChannels")
		local channel = channels and (channels:FindFirstChild("RBXSystem") or channels:FindFirstChild("RBXGeneral"))
		if channel then
			local escaped = message:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
			channel:DisplaySystemMessage(escaped)
		else
			notice(message)
		end
	end
	feedback.OnClientEvent:Connect(function(kind, message, boatId)
		if
			(kind == "OpenDialogue" or kind == "OpenShop" or kind == "OpenDock")
			and player:GetAttribute("PlayerMenuOpen")
		then
			return
		end
		if kind == "OpenDialogue" then
			if isLaunching then
				return
			end
			DrydockCamera.stop()
			previewShop = nil
			dockBase = nil
			refresh()
			dialogue.Visible, product.Visible, dock.Visible = true, false, false
			overlay.Visible = true
		elseif kind == "OpenShop" then
			if isLaunching then
				return
			end
			previewShop = message
			dockBase = nil
			selectedBoatId = if type(boatId) == "string" and BoatCatalog[boatId] then boatId else "Rowboat"
			spec = BoatCatalog[selectedBoatId]
			refresh()
			dialogue.Visible, product.Visible, dock.Visible = false, true, false
			overlay.Visible = true
			if previewShop then
				DrydockCamera.show(previewShop, false, selectedBoatId)
			end
		elseif kind == "OpenDock" then
			if isLaunching or typeof(message) ~= "Instance" or message:GetAttribute("OwnerUserId") ~= player.UserId then
				return
			end
			DrydockCamera.stop()
			previewShop, dockBase = nil, message
			refresh()
			dialogue.Visible, product.Visible, dock.Visible = false, false, true
			overlay.Visible = true
		elseif kind == "LaunchStarted" then
			isLaunching = true
			player:SetAttribute("DrydockScreenOpen", true)
			previewShop = message
			dockBase = nil
			overlay.Visible = false
			if previewShop then
				DrydockCamera.show(previewShop, true, boatId)
			end
			local launchingSpec = if type(boatId) == "string" then BoatCatalog[boatId] else spec
			notice("Lowering your " .. string.lower((launchingSpec or spec).Name) .. " into the water…")
		elseif kind == "LaunchFinished" then
			isLaunching = false
			player:SetAttribute("DrydockScreenOpen", overlay.Visible)
			previewShop = nil
			DrydockCamera.stop()
		elseif kind == "CommandNotice" and type(message) == "string" then
			commandNotice(message)
		elseif kind == "TestMesh" then
			commandNotice("Testing fish meshes on this device...")
			task.spawn(function()
				local ok, result = pcall(function()
					return require(script.Parent.FishMeshes).diagnose()
				end)
				commandNotice(if ok then result else "Mesh test FAILED: " .. tostring(result))
			end)
		elseif kind == "Notice" and type(message) == "string" then
			notice(message)
		end
	end)
	netRemote.OnClientEvent:Connect(function(kind, fishName, kg, value)
		if kind == "Catch" and type(fishName) == "string" then
			notice(string.format("Your net caught a %s · %.2f kg · $%d", fishName, tonumber(kg) or 0, tonumber(value) or 0))
		elseif kind == "Notice" and type(fishName) == "string" then
			notice(fishName)
		end
	end)

	local tracked = {}
	local function trackBase(base: Instance)
		if tracked[base] then
			return
		end
		local prompts: { [ProximityPrompt]: boolean } = {}
		local function add(descendant: Instance)
			if descendant:IsA("ProximityPrompt") and descendant.Name == "SpawnRowboatPrompt" then
				prompts[descendant] = true
				descendant.Enabled = base:GetAttribute("OwnerUserId") == player.UserId
			end
		end
		local function update()
			local owned = base:GetAttribute("OwnerUserId") == player.UserId
			for prompt in prompts do
				prompt.Enabled = owned
			end
		end
		local connections = {
			base:GetAttributeChangedSignal("OwnerUserId"):Connect(update),
			base.DescendantAdded:Connect(add),
			base.DescendantRemoving:Connect(function(descendant)
				prompts[descendant] = nil
			end),
		}
		tracked[base] = connections
		-- Streaming can deliver thousands of house parts. Scan once, then inspect
		-- only the instance arriving rather than rescanning the whole base each time.
		for _, descendant in base:GetDescendants() do
			add(descendant)
		end
	end
	for _, base in CollectionService:GetTagged("PlayerBase") do
		trackBase(base)
	end
	CollectionService:GetInstanceAddedSignal("PlayerBase"):Connect(trackBase)
	CollectionService:GetInstanceRemovedSignal("PlayerBase"):Connect(function(base)
		for _, connection in tracked[base] or {} do
			connection:Disconnect()
		end
		tracked[base] = nil
	end)

	local sinceInput, sinceShopCheck = 0, 0
	local sentThrottle: number?, sentSteer: number? = nil, nil
	local previousSeat: VehicleSeat? = nil
	local sinceWeatherCheck = 0
	RunService.Heartbeat:Connect(profiled("Boating", function(dt)
		sinceWeatherCheck += dt
		if sinceWeatherCheck >= 0.5 then
			sinceWeatherCheck = 0
			refreshWeather()
			refreshClock()
		end
		local camera = workspace.CurrentCamera
		if overlay.Visible and camera then
			layoutMenu()
			if dock.Visible then
				dockPreview.step(dt)
			end
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local seat = humanoid and humanoid.SeatPart
		local boatModel = seat and seat.Parent
		local drivenBoatId = boatModel and boatModel:GetAttribute("BoatId")
		local drivenSpec = if type(drivenBoatId) == "string" then BoatCatalog[drivenBoatId] else BoatCatalog.Rowboat
		local ownSeat = seat
			and seat:IsA("VehicleSeat")
			and drivenSpec ~= nil
			and seat.Name == (drivenSpec.DriverSeat or "RowerSeat")
			and boatModel:GetAttribute("OwnerUserId") == player.UserId
		controlledBoat = if ownSeat then boatModel else nil
		local helmVisible = controlledBoat ~= nil
			and not overlay.Visible
			and not isLaunching
			and not player:GetAttribute("PlayerMenuOpen")
		lightsToggle.Visible = helmVisible
		local cameraAllowed = helmVisible
			and not player:GetAttribute("BuildModeOpen")
			and not player:GetAttribute("RodCrateOpening")
		cameraToggle.Visible = cameraAllowed
		BoatCamera.setActive(if cameraAllowed then controlledBoat else nil, if cameraAllowed then seat else nil)
		local netAllowed = helmVisible
			and controlledBoat ~= nil
			and controlledBoat:GetAttribute("BoatId") == "Trawler"
			and controlledBoat:GetAttribute("NetOwned") == true
			and not player:GetAttribute("BoatRefitOpen")
		netToggle.Visible = netAllowed
		local netDeployed = netAllowed and controlledBoat:GetAttribute("NetDeployed") == true
		if netDeployed ~= previousNetDeployed then
			previousNetDeployed = netDeployed
			netToggle.Text = if netDeployed then "Net OUT [N]" else "Net IN [N]"
			Theme.button(netToggle, if netDeployed then "Selected" else "Normal")
		end
		local lightsOn = controlledBoat ~= nil and controlledBoat:GetAttribute("LightsEnabled") ~= false
		if lightsOn ~= previousLightsOn then
			previousLightsOn = lightsOn
			lightsToggle.Text = if lightsOn then "Lights ON [L]" else "Lights OFF [L]"
			Theme.button(lightsToggle, if lightsOn then "Selected" else "Normal")
		end
		if ownSeat then
			if seat ~= previousSeat then
				notice(
					(if drivenBoatId ~= "Rowboat" then "Steer" else "Row")
						.. " with movement controls (WASD / arrows). Jump to leave the boat."
				)
			end
			sinceInput += dt
			-- Presses, releases and direction reversals bypass the analog rate cap.
			-- Repeat held input so the server's input timeout never releases the helm.
			local throttle, steer = seat.ThrottleFloat, seat.SteerFloat
			if player:GetAttribute("FreecamEnabled") then
				throttle, steer = 0, 0
			end
			local hull = boatModel.PrimaryPart
			if player:GetAttribute("BoatRefitOpen") and hull then
				-- The refit dock brakes the boat to a stop while its menu is open.
				local speed = hull.AssemblyLinearVelocity:Dot(hull.CFrame.LookVector)
				throttle, steer = if speed > 1 then -1 elseif speed < -1 then 1 else 0, 0
			end
			local changed = throttle ~= sentThrottle or steer ~= sentSteer
			local directionChanged = seat ~= previousSeat
				or (sentThrottle ~= nil and math.sign(throttle) ~= math.sign(sentThrottle))
				or (sentSteer ~= nil and math.sign(steer) ~= math.sign(sentSteer))
			if (changed and (directionChanged or sinceInput >= 1 / 30)) or sinceInput >= 0.1 then
				sinceInput = 0
				sentThrottle, sentSteer = throttle, steer
				request:FireServer("Row", throttle, steer)
			end
			-- The server still needs the input to keep the helm (and park the hull), but
			-- the movers answer it here at once.
			BoatDriving.setInput(boatModel, throttle, steer)
			previousSeat = seat
		else
			BoatDriving.setInput(nil, 0, 0)
			previousSeat, sinceInput = nil, 0
			sentThrottle, sentSteer = nil, nil
		end
		sinceShopCheck += dt
		if overlay.Visible and sinceShopCheck > 0.4 then
			sinceShopCheck = 0
			refresh()
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local nearby = false
			if dockBase then
				local prompt = dockBase:FindFirstChild("SpawnRowboatPrompt", true)
				nearby = dockBase:GetAttribute("OwnerUserId") == player.UserId
					and root ~= nil
					and prompt ~= nil
					and prompt.Parent:IsA("BasePart")
					and (root.Position - prompt.Parent.Position).Magnitude <= prompt.MaxActivationDistance + 2
			else
				for _, shop in CollectionService:GetTagged("BoatShop") do
					local prompt = shop:FindFirstChild("TalkToShipwrightPrompt", true)
					if root and prompt and prompt.Parent:IsA("BasePart") then
						nearby = nearby
							or (root.Position - prompt.Parent.Position).Magnitude
								<= prompt.MaxActivationDistance + 2
					end
				end
			end
			if not nearby then
				overlay.Visible = false
			end
		end
	end))
end

return Boating
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="303">
          <Properties>
            <string name="Name">BuildMode</string>
            <string name="Source"><![CDATA[-- Build mode: at home, press B (or the Build button) for an angled building view
-- with the roof hidden. On your company island it opens over the island's fenced
-- plot instead (site "Company"), where the island's kit and decorations go. Pan with WASD / arrows or right-drag, hold Q / E to turn,
-- and scroll to zoom.
-- Pick bought furniture from the bottom bar, turn it
-- with R and click a floor spot to place it; click placed furniture to move it or
-- pick it back up. Allowed rooms glow green while you hold an item. The preview
-- uses the shared placement rules, and the server re-checks every placement.
local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Furniture = require(ReplicatedStorage.Shared.FurnitureCatalog)
local BaseGrid = require(ReplicatedStorage.Shared.BaseGrid)
local Building = require(ReplicatedStorage.Shared.BuildingCatalog)
local FurniturePreview = require(script.Parent.FurniturePreview)
local StructureEditor = require(script.Parent.StructureEditor)
local Freecam = require(script.Parent.Freecam)
local KitchenStorage = require(script.Parent.KitchenStorage)
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))

local BuildMode = {}
local rgb = Color3.fromRGB
local FITS = rgb(84, 192, 92)
local BLOCKED = rgb(226, 72, 60)
local ROOM = rgb(96, 200, 120)
local HOME_DISTANCE = 110
local COMPANY_DISTANCE = 150
-- Everything above the doorway lintels: roof, gables, ceiling ties and pendant lamps.
local ROOF_HEIGHT = 8.4
local FLOOR_Y = 0.16
local HEIGHTS = {
	Freezer = 4,
	Register = 3,
	StorageRack = 6.6,
	FoodCase = 4.3,
	FoodShelf = 6.1,
	GrillStation = 7.6,
	Smoker = 8.1,
	SushiBar = 6.5,
	KitchenStorage = 4.3,
	DiningTable = 3.4,
	WeatherRadar = 4.4,
	CompanyPrep = 4.2,
	CompanyDesk = 4.7,
	PrepBench = 4.2,
	OfficeDesk = 4.8,
}
-- The furniture cards: everything sold, then the company island kit and the
-- house's own fixtures (shown once picked up).
local ITEMS = table.clone(Furniture.Order)
table.move(Furniture.KitOrder, 1, #Furniture.KitOrder, #ITEMS + 1, ITEMS)
table.move(Furniture.FixtureOrder, 1, #Furniture.FixtureOrder, #ITEMS + 1, ITEMS)
local CAMERA_PITCH = math.rad(55)
local TURN_SPEED = math.rad(90)
local TURN_RESPONSE = 12
local TURN_KEYS = {
	[Enum.KeyCode.Q] = -1,
	[Enum.KeyCode.E] = 1,
}
local PAN_LIMIT = Vector2.new(38, 100)
local PAN_KEYS = {
	[Enum.KeyCode.W] = Vector2.new(0, -1),
	[Enum.KeyCode.Up] = Vector2.new(0, -1),
	[Enum.KeyCode.S] = Vector2.new(0, 1),
	[Enum.KeyCode.Down] = Vector2.new(0, 1),
	[Enum.KeyCode.A] = Vector2.new(-1, 0),
	[Enum.KeyCode.Left] = Vector2.new(-1, 0),
	[Enum.KeyCode.D] = Vector2.new(1, 0),
	[Enum.KeyCode.Right] = Vector2.new(1, 0),
}
local started = false

local function make(class: string, parent: Instance?, props: { [string]: any }): any
	local item = Instance.new(class)
	for key, value in props do
		item[key] = value
	end
	item.Parent = parent
	return item
end

local function notice(message: string)
	pcall(StarterGui.SetCore, StarterGui, "SendNotification", {
		Title = "Build mode",
		Text = message,
		Duration = 4,
	})
end

function BuildMode.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local remotes = ReplicatedStorage:WaitForChild("Furniture")
	local request = remotes:WaitForChild("Request") :: RemoteFunction
	local update = remotes:WaitForChild("Update") :: RemoteEvent

	local state = nil
	local active = false
	local house: Model? = nil -- the base house, or the company island on its plot
	local houseFrame = CFrame.identity
	local site: string? = nil -- nil at home, "Company" on the island plot
	local floorY = FLOOR_Y
	local hidden: { [BasePart]: number } = {}
	local roofConnection: RBXScriptConnection? = nil
	local frozen = nil
	local held = nil -- { ItemId, From (item id or placed index), R }
	local selected: number? = nil
	local editingRack = false
	local spot = nil -- { X, Z, Reason }
	local pending = false
	local saved = nil
	local preview: Model? = nil
	local highlight: Highlight? = nil
	local grid: Folder? = nil
	local pan = Vector2.zero
	local zoom = 1
	local cameraDistance = 60
	local panKeys = {}
	local turnKeys = {}
	local yaw, turnVelocity = 0, 0
	local dragging = false
	local dragPosition: Vector2? = nil
	local touch: InputObject? = nil
	local touchStart = Vector2.zero
	local touchDragged = false
	local structures = nil
	local ghostParts = {}

	-- HUD, laid out like Restaurant Tycoon 3: StructureEditor owns the bottom dock
	-- (tools on the left, category tabs and catalogue on the right) and the status bar.
	-- Furniture fills the dock's catalogue on its Furniture tab; the actions for the
	-- selected item float beside it; camera buttons and Done sit top-right.
	local gui = make("ScreenGui", player:WaitForChild("PlayerGui"), {
		Name = "BuildMode",
		ResetOnSpawn = false,
		DisplayOrder = 24,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	local toggle = make("TextButton", gui, {
		Name = "OpenBuildMode",
		Text = "Build [B]",
		TextSize = 16,
		Position = UDim2.new(1, -126, 1, -146),
		Size = UDim2.fromOffset(112, 38),
		Visible = false,
	})
	Theme.button(toggle)
	local onStructureMode, onStructureSelect
	structures = StructureEditor.new({
		Gui = gui,
		Notice = notice,
		OnModeChanged = function(...)
			if onStructureMode then onStructureMode(...) end
		end,
		OnSelect = function()
			if onStructureSelect then onStructureSelect() end
		end,
	})
	local MENU = StructureEditor.Colors
	local DOCK_TOP = StructureEditor.DOCK_HEIGHT + StructureEditor.DOCK_MARGIN
	local panel = structures.dock
	local furniturePane = make("Frame", structures.body, {
		Name = "FurnitureCatalogue",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
	})
	local function label(parent: Instance, text: string, props: { [string]: any }): TextLabel
		local item = make("TextLabel", parent, {
			BackgroundTransparency = 1,
			Text = text,
			TextSize = 14,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
		})
		StructureEditor.styleLabel(item)
		for key, value in props do
			if key == "TextColor3" and value == Theme.Colors.Muted then value = MENU.Muted end
			item[key] = value
		end
		return item
	end
	local function button(parent: Instance, text: string, props: { [string]: any }): TextButton
		local item = make("TextButton", parent, { Text = text, TextSize = 14 })
		for key, value in props do
			item[key] = value
		end
		StructureEditor.styleButton(item)
		return item
	end
	local function horizontalStrip(parent: Instance, name: string, y: number, height: number): ScrollingFrame
		local strip = make("ScrollingFrame", parent, {
			Name = name,
			Position = UDim2.fromOffset(0, y),
			Size = UDim2.new(1, 0, 0, height),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			CanvasSize = UDim2.fromOffset(0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.X,
			ScrollingDirection = Enum.ScrollingDirection.X,
			Active = true,
		})
		Theme.scroll(strip)
		strip.ScrollBarThickness = 3
		strip.ScrollBarImageColor3 = MENU.Muted
		make("UIListLayout", strip, {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
		})
		return strip
	end
	-- The status line lives in the top-left bar (StructureEditor:setHint).
	local hint = { Text = "" }
	-- Catalogue chips: All plus every group you own unplaced stock in.
	local categoryStrip = horizontalStrip(furniturePane, "FurnitureCategories", 0, 24)
	local catalogue = horizontalStrip(furniturePane, "Placeables", 28, 70)
	local category = "All"
	local categoryButtons = {}
	for index, entry in Furniture.Categories do
		local chip = button(categoryStrip, entry.Name, {
			Name = "Category" .. entry.Id,
			LayoutOrder = index,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 22),
			TextSize = 11,
		})
		make("UIPadding", chip, { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) })
		categoryButtons[entry.Id] = chip
	end
	local inventoryTitle = categoryButtons.All
	local itemButtons = {}
	local stockLabels = {}
	local itemViews, previewStarted = {}, {}
	for index, id in ITEMS do
		local card = button(catalogue, "", {
			Name = "Hold" .. id,
			LayoutOrder = index,
			Size = UDim2.fromOffset(112, 66),
			Visible = false,
		})
		itemButtons[id] = card
		local view = make("ViewportFrame", card, {
			Name = "FurnitureThumbnail",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(4, 2),
			Size = UDim2.fromOffset(104, 38),
			Active = false,
			ZIndex = 2,
		})
		itemViews[id] = view
		label(card, Furniture.Items[id].Name, {
			Position = UDim2.fromOffset(6, 40),
			Size = UDim2.new(1, -12, 0, 13),
			TextSize = 11,
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 3,
		})
		stockLabels[id] = label(card, "", {
			Position = UDim2.fromOffset(6, 52),
			Size = UDim2.new(1, -12, 0, 12),
			TextSize = 10,
			ZIndex = 3,
			TextColor3 = Theme.Colors.Muted,
		})
	end
	local emptyInventory = label(furniturePane, "Loading your furniture…", {
		Name = "EmptyInventory",
		Position = UDim2.fromOffset(4, 30),
		Size = UDim2.new(1, -8, 0, 60),
		TextSize = 13,
		TextColor3 = Theme.Colors.Muted,
	})
	-- Floating actions for the selected or held furniture.
	local actions = make("Frame", gui, {
		Name = "FurnitureActions",
		Active = true,
		AnchorPoint = Vector2.new(0.5, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 40),
		Visible = false,
	})
	StructureEditor.stylePanel(actions)
	make("UIPadding", actions, {
		PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 5), PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5),
	})
	make("UIListLayout", actions, {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 5),
		VerticalAlignment = Enum.VerticalAlignment.Center,
	})
	local selectionName = label(actions, "", {
		Name = "SelectionName",
		LayoutOrder = 0,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 30),
		TextSize = 12,
		TextWrapped = false,
		TextYAlignment = Enum.TextYAlignment.Center,
	})
	local rotate = button(actions, "Rotate [R]", {
		Name = "Rotate",
		LayoutOrder = 1,
		Size = UDim2.fromOffset(92, 30),
		TextSize = 12,
	})
	local move = button(actions, "Move", {
		Name = "MoveSelected",
		LayoutOrder = 3,
		Size = UDim2.fromOffset(64, 30),
		TextSize = 12,
	})
	local pickUp = button(actions, "Pick up", {
		Name = "PickUpSelected",
		LayoutOrder = 4,
		Size = UDim2.fromOffset(72, 30),
		TextSize = 12,
	})
	local editRack = button(actions, "Edit rack", { Name = "EditRack", LayoutOrder = 2, Size = UDim2.fromOffset(96, 30), TextSize = 12 })
	local cancel = button(actions, "Cancel [X]", {
		Name = "Cancel",
		LayoutOrder = 5,
		Size = UDim2.fromOffset(88, 30),
		TextSize = 12,
	})
	local rackEditor = make("Frame", gui, {
		Name = "RackEditor", Active = true, AnchorPoint = Vector2.new(1, 1),
		-- Sits just above the right end of the dock.
		Position = UDim2.new(1, -12, 1, -(DOCK_TOP + 12)), Size = UDim2.new(1, -24, 0, 164), Visible = false,
	})
	make("UISizeConstraint", rackEditor, { MaxSize = Vector2.new(400, 164) })
	StructureEditor.stylePanel(rackEditor)
	label(rackEditor, "Edit storage rack", { Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 0, 24), TextSize = 16 })
	local rackStatus = label(rackEditor, "", { Position = UDim2.fromOffset(12, 35), Size = UDim2.new(1, -24, 0, 28), TextSize = 12, TextColor3 = Theme.Colors.Muted })
	local rackMode = button(rackEditor, "Mode: Fish", { Name = "RackMode", Position = UDim2.fromOffset(12, 66), Size = UDim2.new(1, -24, 0, 32) })
	local addCage = button(rackEditor, "+ Cage", { Name = "RackAddCage", Position = UDim2.new(0, 12, 0, 108), Size = UDim2.new(0.25, -15, 0, 36), TextSize = 12 })
	local takeCage = button(rackEditor, "− Cage", { Name = "RackTakeCage", Position = UDim2.new(0.25, 4, 0, 108), Size = UDim2.new(0.25, -15, 0, 36), TextSize = 12 })
	local addNet = button(rackEditor, "+ Net", { Name = "RackAddNet", Position = UDim2.new(0.5, -4, 0, 108), Size = UDim2.new(0.25, -15, 0, 36), TextSize = 12 })
	local takeNet = button(rackEditor, "− Net", { Name = "RackTakeNet", Position = UDim2.new(0.75, -12, 0, 108), Size = UDim2.new(0.25, -15, 0, 36), TextSize = 12 })
	-- Top-right: help, camera and Done.
	local navigation = make("Frame", gui, {
		Name = "BuildNavigation",
		Active = true,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(296, 48),
		Visible = false,
	})
	StructureEditor.stylePanel(navigation)
	make("UIPadding", navigation, { PaddingLeft = UDim.new(0, 7), PaddingRight = UDim.new(0, 7) })
	make("UIListLayout", navigation, {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 6),
	})
	local helpToggle = button(navigation, "?", {
		Name = "BuildHelpToggle",
		LayoutOrder = 1,
		Size = UDim2.fromOffset(34, 34),
		TextSize = 16,
	})
	local zoomOut = button(navigation, "−", {
		Name = "ZoomOut",
		LayoutOrder = 2,
		Size = UDim2.fromOffset(34, 34),
		TextSize = 18,
	})
	local zoomIn = button(navigation, "+", {
		Name = "ZoomIn",
		LayoutOrder = 3,
		Size = UDim2.fromOffset(34, 34),
		TextSize = 18,
	})
	local recenter = button(navigation, "Home", {
		Name = "RecenterView",
		LayoutOrder = 4,
		Size = UDim2.fromOffset(60, 34),
		TextSize = 12,
	})
	local done = button(navigation, "Done [B]", {
		Name = "ExitBuildMode",
		LayoutOrder = 5,
		Size = UDim2.fromOffset(96, 34),
	})
	done.BackgroundColor3, done.TextColor3 = MENU.Red, MENU.White
	local helpPanel = make("Frame", gui, {
		Name = "BuildHelp",
		Active = true,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 66),
		Size = UDim2.fromOffset(296, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
	})
	StructureEditor.stylePanel(helpPanel)
	make("UIPadding", helpPanel, {
		PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
	})
	label(
		helpPanel,
		if UserInputService.TouchEnabled
			then "Drag: pan the camera\nTap: select or place\n− / +: zoom · Home: recenter"
			else "WASD / arrows or right-drag: pan\nQ / E: turn · Wheel: zoom · Home: recenter\nR: rotate · M: move · Del: delete · X / Esc: cancel\nG: grid size · Page Up / Down: floor\nCtrl+Z / Ctrl+Y: undo / redo · B: done",
		{
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextSize = 12,
		}
	)

	local function ownHouse(): (Model?, CFrame?)
		for _, base in CollectionService:GetTagged("PlayerBase") do
			if base:GetAttribute("OwnerUserId") == player.UserId then
				local model = base:FindFirstChild("BaseHouse")
				local frame = model and model:GetAttribute("HouseFrame")
				if model and model:IsA("Model") and typeof(frame) == "CFrame" then
					return model, frame
				end
			end
		end
		return nil, nil
	end
	-- The site build mode would open on here: (model, frame, site), nearest plot first.
	local function currentSite(): (Model?, CFrame?, string?)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root then
			return nil, nil, nil
		end
		for _, island in CollectionService:GetTagged("CompanyIsland") do
			local frame = island:GetAttribute("PlotFrame")
			if
				island:IsA("Model")
				and island:GetAttribute("OwnerUserId") == player.UserId
				and typeof(frame) == "CFrame"
				and (root.Position - frame.Position).Magnitude <= COMPANY_DISTANCE
			then
				return island, frame, "Company"
			end
		end
		local model, frame = ownHouse()
		if model and frame and (root.Position - frame.Position).Magnitude <= HOME_DISTANCE then
			return model, frame, nil
		end
		return nil, nil, nil
	end
	local function atHome(): boolean
		local model = currentSite()
		return model ~= nil
	end
	-- Placed furniture on the open site.
	local function placed()
		if not state then
			return {}
		end
		return (if site == "Company" then state.CompanyPlaced else state.Placed) or {}
	end
	local function furnitureFolder(): Instance?
		return house and house:FindFirstChild(if site == "Company" then "PlotFurniture" else "Furniture")
	end

	local function setButton(item: TextButton, text: string, enabled: boolean, chosen: boolean?)
		item.Text = text
		item.Active = enabled
		item.Selectable = enabled
		StructureEditor.styleButton(item, if chosen then "Selected" elseif enabled then "Normal" else "Disabled")
	end
	local function render()
		local total = 0
		local counts = {}
		for _, id in ITEMS do
			local stock = if state and Furniture.allowedOn(id, site) then state.Stock[id] or 0 else 0
			if stock > 0 then
				local group = Furniture.category(id)
				counts[group] = (counts[group] or 0) + stock
			end
		end
		if category ~= "All" and not counts[category] then category = "All" end
		for _, id in ITEMS do
			local item = Furniture.Items[id]
			local stock = if state and Furniture.allowedOn(id, site) then state.Stock[id] or 0 else 0
			local full = state ~= nil and Furniture.count(placed(), id) >= item.MaxPlaced
			total += stock
			itemButtons[id].Visible = stock > 0 and Furniture.matchesCategory(id, category)
			itemButtons[id].Selectable = stock > 0 and not full and not pending
			stockLabels[id].Text = string.format("%d unplaced", stock)
			if stock > 0 and not previewStarted[id] then
				previewStarted[id] = true
				FurniturePreview.show(itemViews[id], remotes, id)
			end
			setButton(itemButtons[id], "", stock > 0 and not full and not pending, held ~= nil and held.From == id)
		end
		inventoryTitle.Text = string.format("All · %d", total)
		for _, entry in Furniture.Categories do
			local chip = categoryButtons[entry.Id]
			local count = if entry.Id == "All" then total else counts[entry.Id] or 0
			chip.Visible = entry.Id == "All" or count > 0
			setButton(chip, string.format("%s · %d", entry.Name, count), true, category == entry.Id)
		end
		emptyInventory.Visible = total == 0
		emptyInventory.Text = if not state
			then "Loading your furniture…"
			elseif site == "Company"
			then "Nothing to place here. Racks, kitchen storage, the radar and decorations from Harbour Home can go on your plot."
			else "No unplaced furniture. Buy items at Harbour Home, or pick up furniture in your house."
		local rack = selected and placed()[selected]
		local choosing = rack ~= nil and held == nil
		setButton(rotate, "Rotate [R]", held ~= nil or (choosing and not pending))
		setButton(cancel, "Cancel [X]", held ~= nil or selected ~= nil)
		move.Visible, pickUp.Visible = choosing, choosing
		setButton(move, "Move", choosing and not pending)
		-- The last freezer, till and the office desk can only be moved (AnglerData.pickUpFurniture).
		local keep = rack and Furniture.Items[rack.ItemId] and Furniture.Items[rack.ItemId].Keep
		local kept = keep ~= nil and Furniture.count(placed(), rack.ItemId) <= 1
		setButton(pickUp, "Pick up", choosing and not pending and not kept)
		local shown = if held then Furniture.Items[held.ItemId] elseif rack then Furniture.Items[rack.ItemId] else nil
		selectionName.Text = if shown then (if held then "Placing " .. string.lower(shown.Name) else shown.Name) else ""
		local isRack = rack and rack.ItemId == "StorageRack" and held == nil
		local isKitchen = rack and rack.ItemId == "KitchenStorage" and held == nil
		editRack.Visible = not not (isRack or isKitchen)
		setButton(editRack, if isKitchen then "Edit storage" elseif editingRack then "Close editor" else "Edit rack", not pending)
		rackEditor.Visible = active and not not isRack and editingRack
		rackStatus.Text = if isRack and rack.Mode == "Tools"
			then string.format("Stored: %d cages, %d nets / 12 · Carrying: %d cages, %d nets", rack.Cages or 0, rack.Nets or 0, state.CageStock or 0, state.NetStock or 0)
			else "Fish storage · Switch mode to store cages and nets."
		setButton(rackMode, if isRack and rack.Mode == "Tools" then "Mode: Tools" else "Mode: Fish", not pending)
		for _, item in { addCage, takeCage, addNet, takeNet } do
			item.Visible = not not (isRack and rack.Mode == "Tools")
			setButton(item, item.Text, not pending)
		end
		if held then
			local item = Furniture.Items[held.ItemId]
			hint.Text = if spot and spot.Reason
				then spot.Reason
				else string.format("Place your %s: %s.", string.lower(item.Name), if site == "Company" then "inside the plot's fence" else Furniture.roomNames(held.ItemId))
		elseif selected and placed()[selected] then
			local entry = placed()[selected]
			if entry.ItemId == "StorageRack" then
				hint.Text = if entry.Mode == "Tools" then string.format("Tools rack: %d cages, %d nets / 12. Carrying: %d cages, %d nets. Level 4 porters place stored tools.", entry.Cages or 0, entry.Nets or 0, state.CageStock or 0, state.NetStock or 0) else "Storage rack selected. Click Edit rack to choose its mode."
			elseif entry.ItemId == "KitchenStorage" then
				hint.Text = "Kitchen storage selected. Click Edit storage to choose which fish wait on the ice."
			else
				local item = Furniture.Items[entry.ItemId]
				hint.Text = if item.Keep and Furniture.count(placed(), entry.ItemId) <= 1
					then item.Name .. " selected. You can move it; " .. string.lower(string.sub(item.Keep, 1, 1)) .. string.sub(item.Keep, 2)
					else item.Name .. " selected. Move it or pick it up."
			end
		elseif state and state.PendingWallMigration then
			hint.Text = "Some furniture needs room near the new walls. Move or pick up furniture to make space."
		elseif site == "Company" then
			hint.Text = "Furnish your company plot from the catalogue. Click anything placed to move, rotate or remove it."
		else
			hint.Text = "Pick furniture from the catalogue. Click anything placed to move, rotate or remove it."
		end
		if structures then structures:setHint(hint.Text) end
	end

	local function clearPreview()
		ghostParts = {}
		if preview then
			preview:Destroy()
			preview = nil
		end
	end
	local function setHighlight(model: Instance?)
		if highlight then
			highlight:Destroy()
			highlight = nil
		end
		if model then
			highlight = make("Highlight", model, {
				FillColor = rgb(240, 200, 90),
				FillTransparency = 0.6,
				OutlineColor = rgb(255, 230, 150),
			})
		end
	end
	local function placedModel(index: number): Model?
		local entry = placed()[index]
		local folder = furnitureFolder()
		if not entry or not folder then
			return nil
		end
		for _, model in folder:GetChildren() do
			if
				model:GetAttribute("ItemId") == entry.ItemId
				and model:GetAttribute("X") == entry.X
				and model:GetAttribute("Z") == entry.Z
				and model:GetAttribute("R") == entry.R
			then
				return model
			end
		end
		return nil
	end
	local function choose(index: number?)
		if selected ~= index then editingRack = false end
		selected = index
		-- One selection at a time: furniture or a building piece.
		if index and structures then structures:clearSelection() end
		setHighlight(if index then placedModel(index) else nil)
		render()
	end

	-- Local-only parts: the held item's ghost and the rooms it may go in.
	local function plate(parent: Instance, area: { number }, y: number, color: Color3, transparency: number): Part
		return make("Part", parent, {
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Material = Enum.Material.SmoothPlastic,
			Color = color,
			Transparency = transparency,
			Size = Vector3.new(area[3] - area[1], 0.08, area[4] - area[2]),
			CFrame = houseFrame * CFrame.new((area[1] + area[3]) / 2, y, (area[2] + area[4]) / 2),
		})
	end
	local function buildPreview()
		clearPreview()
		if not held then
			return
		end
		local model = make("Model", nil, { Name = "FurniturePreview" })
		local item = Furniture.Items[held.ItemId]
		-- Yard items sit on the quay deck, a step below the house floor.
		local floor = Furniture.floor(held.ItemId, site)
		if site == "Company" then
			plate(model, Furniture.PLOT, floor + 0.05, ROOM, 0.75).Name = "AllowedRoom"
			for _, area in Furniture.PlotBlocked do
				plate(model, area, floor + 0.07, BLOCKED, 0.8).Name = "KeepClear"
			end
		end
		for _, roomId in if site == "Company" then {} else Furniture.allowedRooms(held.ItemId) do
			local room = Furniture.Rooms[roomId]
			plate(model, room, floor + 0.05, ROOM, 0.75).Name = "AllowedRoom"
			for _, area in Furniture.blocked(held.ItemId) do
				-- Only show keep-clear zones in the allowed rooms.
				if area[1] < room[3] and area[3] > room[1] and area[2] < room[4] and area[4] > room[2] then
					plate(model, area, floor + 0.07, BLOCKED, 0.8).Name = "KeepClear"
				end
			end
		end
		local height = HEIGHTS[held.ItemId] or 3
		local ghost = FurniturePreview.clone(remotes, held.ItemId)
		if ghost then
			ghost.Name = "ItemGhost"
			ghost:SetAttribute("TemplatePivot", ghost:GetPivot())
			for _, part in ghost:GetDescendants() do
				if part:IsA("BasePart") then
					table.insert(ghostParts, { Part = part, Color = part.Color })
					part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch, part.CastShadow = true, false, false, false, false
					part.Transparency = math.max(0.3, part.Transparency)
				elseif part:IsA("ProximityPrompt") or part:IsA("LayerCollector") or part:IsA("Light") or part:IsA("ParticleEmitter")
					or part:IsA("Beam") or part:IsA("Trail") then
					part.Enabled = false
				end
			end
			ghost.Parent = model
			make("Highlight", model, {
				Name = "GhostOutline", Adornee = ghost, FillTransparency = 0.94, OutlineTransparency = 0,
				DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
			})
		else
			-- The authoritative templates may still be arriving on a fresh join.
			make("Part", model, {
				Name = "Body", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
				Material = Enum.Material.SmoothPlastic, Transparency = 0.7, Size = Vector3.new(item.Width, height, item.Depth),
			})
		end
		-- The grid cells the item fills, and the strips people stand in beside them.
		make("Part", model, {
			Name = "Access",
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Material = Enum.Material.SmoothPlastic,
			Transparency = 0.6,
			Size = Vector3.new(1, 0.1, 1),
		})
		for index = 1, #Furniture.access(held.ItemId, 0, 0, 0) do
			make("Part", model, {
				Name = "Clearance" .. index,
				Anchored = true,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				CastShadow = false,
				Material = Enum.Material.SmoothPlastic,
				Transparency = 0.85,
				Size = Vector3.new(1, 0.06, 1),
			})
		end
		-- An arrow on the access side shows which way the item faces.
		make("Part", model, {
			Name = "FacingArrow",
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Material = Enum.Material.Neon,
			Color = rgb(250, 240, 200),
			Size = Vector3.new(0.5, 0.12, math.max(item.Front, 1) * 0.8),
		})
		for _, side in { -1, 1 } do
			make("Part", model, {
				Name = if side == -1 then "FacingLeft" else "FacingRight", Anchored = true, CanCollide = false,
				CanQuery = false, CanTouch = false, CastShadow = false, Material = Enum.Material.Neon,
				Color = rgb(250, 240, 200), Size = Vector3.new(0.16, 0.12, 0.8),
			})
		end
		model.Parent = workspace
		preview = model
	end
	local function updatePreview()
		if not preview or not held or not spot then
			return
		end
		local item = Furniture.Items[held.ItemId]
		local frame = Furniture.frame(houseFrame, { ItemId = held.ItemId, X = spot.X, Z = spot.Z, R = held.R }, site)
		local color = if spot.Reason then BLOCKED else FITS
		local height = HEIGHTS[held.ItemId] or 3
		local body = preview:FindFirstChild("Body") :: BasePart?
		local ghost = preview:FindFirstChild("ItemGhost") :: Model?
		local access = preview:FindFirstChild("Access") :: BasePart
		local arrow = preview:FindFirstChild("FacingArrow") :: BasePart
		access.Color = color
		if body then
			body.Color = color
			body.CFrame = frame * CFrame.new(0, height / 2, 0)
		end
		if ghost then
			ghost:PivotTo(frame * ghost:GetAttribute("TemplatePivot"))
			for _, entry in ghostParts do entry.Part.Color = entry.Color:Lerp(color, 0.18) end
			local outline = preview:FindFirstChild("GhostOutline") :: Highlight
			outline.OutlineColor, outline.FillColor = color, color
		end
		local floor = Furniture.floor(held.ItemId, site)
		local function lay(part: BasePart, area: { number }, y: number)
			part.Size = Vector3.new(area[3] - area[1] - 0.1, part.Size.Y, area[4] - area[2] - 0.1)
			part.CFrame = houseFrame * CFrame.new((area[1] + area[3]) / 2, floor + y, (area[2] + area[4]) / 2)
		end
		lay(access, Furniture.footprint(held.ItemId, spot.X, spot.Z, held.R) :: { number }, 0.12)
		for index, strip in Furniture.access(held.ItemId, spot.X, spot.Z, held.R) do
			local clearance = preview:FindFirstChild("Clearance" .. index) :: BasePart?
			if clearance then
				clearance.Color = color
				lay(clearance, strip, 0.1)
			end
		end
		local arrowZ = item.Depth / 2 + 0.85
		arrow.Size = Vector3.new(0.16, 0.12, 1.25)
		arrow.CFrame = frame * CFrame.new(0, 0.22, arrowZ)
		for _, side in { -1, 1 } do
			local wing = preview:FindFirstChild(if side == -1 then "FacingLeft" else "FacingRight") :: BasePart
			wing.CFrame = frame * CFrame.new(side * 0.24, 0.22, arrowZ + 0.35) * CFrame.Angles(0, side * math.rad(45), 0)
		end
	end

	-- ScreenPointToRay expects coordinates below the top bar, like InputObject.Position.
	-- GetMouseLocation includes that inset; normalize it for previews and clicks alike.
	local function mousePosition(): Vector2
		return UserInputService:GetMouseLocation() - GuiService:GetGuiInset()
	end

	-- Intersect the pointer with the floor, also used for drag-to-pan at any zoom.
	local function pointerFloor(position: Vector2): Vector3?
		local camera = workspace.CurrentCamera
		if not camera then
			return nil
		end
		local ray = camera:ScreenPointToRay(position.X, position.Y)
		local elevation = if structures and structures:isActive() then structures:elevation() else 0
		local pointerY = if structures and structures:isActive()
			then Building.planeHeight(site, elevation / Building.LEVEL_HEIGHT) else floorY
		local floor = houseFrame * CFrame.new(0, pointerY, 0)
		local normal = houseFrame.UpVector
		local denominator = ray.Direction:Dot(normal)
		if math.abs(denominator) < 1e-4 then
			return nil
		end
		local t = (floor.Position - ray.Origin):Dot(normal) / denominator
		if t < 0 then
			return nil
		end
		return houseFrame:PointToObjectSpace(ray.Origin + ray.Direction * t)
	end
	local function pointerSpot(position: Vector2)
		local point = pointerFloor(position)
		if not point then
			return nil
		end
		if held then
			-- Snap the middle of the item's cells to the pointer, so a 1x2 item
			-- covers the two cells nearest it rather than hanging off one end.
			local area = Furniture.footprint(held.ItemId, 0, 0, held.R) :: { number }
			return BaseGrid.snap(point.X - (area[1] + area[3]) / 2), BaseGrid.snap(point.Z - (area[2] + area[4]) / 2)
		end
		return BaseGrid.snap(point.X), BaseGrid.snap(point.Z)
	end
	local function aim(position: Vector2)
		if not held or not state then
			return
		end
		local x, z = pointerSpot(position)
		if not x then
			return
		end
		local skip = if type(held.From) == "number" then held.From else nil
		local reason = Furniture.check(placed(), held.ItemId, x, z, held.R, skip, site)
		if spot and spot.X == x and spot.Z == z and spot.R == held.R and spot.Reason == reason then return end
		spot = { X = x, Z = z, R = held.R, Reason = reason }
		updatePreview()
		render()
	end

	local function hold(itemId: string, from: any, r: number)
		held = { ItemId = itemId, From = from, R = r }
		spot = nil
		buildPreview()
		aim(mousePosition())
		render()
	end
	local function drop()
		held, spot = nil, nil
		clearPreview()
		render()
	end
	-- Stop holding furniture and give the Select tool back to the structure editor.
	local function release()
		drop()
		choose(nil)
		if structures then structures:resume() end
	end
	-- The placed furniture under the pointer, if any.
	local function furnitureAt(position: Vector2): number?
		local camera = workspace.CurrentCamera
		local folder = furnitureFolder()
		if not camera or not folder or not state then
			return nil
		end
		local ray = camera:ScreenPointToRay(position.X, position.Y)
		local parameters = RaycastParams.new()
		parameters.FilterType = Enum.RaycastFilterType.Include
		parameters.FilterDescendantsInstances = { folder }
		local reach = (ray.Origin - houseFrame.Position).Magnitude + 80
		local hit = workspace:Raycast(ray.Origin, ray.Direction * reach, parameters)
		local model = hit and hit.Instance
		while model and model.Parent ~= folder do
			model = model.Parent
		end
		if not model then
			return nil
		end
		for index, entry in placed() do
			if
				model:GetAttribute("ItemId") == entry.ItemId
				and model:GetAttribute("X") == entry.X
				and model:GetAttribute("Z") == entry.Z
				and model:GetAttribute("R") == entry.R
			then
				return index
			end
		end
		return nil
	end

	local function send(action: string, ...): boolean
		pending = true
		render()
		local ok, result = pcall(request.InvokeServer, request, action, ...)
		pending = false
		if ok and type(result) == "table" then
			state = result.State or state
			if not result.Ok and result.Message ~= "" then
				notice(result.Message)
			end
			render()
			return result.Ok == true
		end
		notice("Your furniture couldn't be saved. Try again.")
		render()
		return false
	end
	-- Turn placed furniture a quarter in place, like the catalogue preview's R.
	local function rotateSelected()
		local entry = selected and placed()[selected]
		if not entry or pending then
			return
		end
		local index, r = selected, (entry.R + 1) % 4
		local reason = Furniture.check(placed(), entry.ItemId, entry.X, entry.Z, r, index, site)
		if reason then
			notice(reason)
			return
		end
		if send("Move", index, entry.X, entry.Z, r, site) then
			choose(if placed()[index] then index else nil)
		end
	end
	local function pickUpFurniture(index: number)
		if not pending and send("PickUp", index, site) then
			choose(nil)
		end
	end

	local function placeHeld()
		if not held or not spot or pending then
			return
		end
		if spot.Reason then
			notice(spot.Reason)
			return
		end
		local action = if type(held.From) == "number" then "Move" else "Place"
		if send(action, held.From, spot.X, spot.Z, held.R, site) then
			release()
		end
	end

	local function clickFurniture(position: Vector2)
		choose(furnitureAt(position))
	end

	local function hideRoofPart(part: Instance)
		if not house or not part:IsA("BasePart") then
			return
		end
		local folder = house:FindFirstChild("Furniture")
		if folder and part:IsDescendantOf(folder) then
			return
		end
		if site == "Company" then
			local construction = house:FindFirstChild("BuildingPieces")
			if not construction or not part:IsDescendantOf(construction) then return end
		end
		if houseFrame:PointToObjectSpace(part.Position).Y > ROOF_HEIGHT then
			if hidden[part] == nil then
				hidden[part] = part.LocalTransparencyModifier
			end
			part.LocalTransparencyModifier = 1
		end
	end
	local function hideRoof()
		if not house or (structures and structures:roofVisible()) then
			return
		end
		-- On an island only constructed overhead pieces need hiding.
		if site == "Company" and not house:FindFirstChild("BuildingPieces") then
			return
		end
		if not roofConnection then
			local watched = house
			roofConnection = house.DescendantAdded:Connect(function(part)
				-- Streamed parts can arrive before their frame; the periodic pass also
				-- catches late properties and reapplies hiding after replication updates.
				task.defer(function()
					if active and house == watched and part:IsDescendantOf(watched) then
						hideRoofPart(part)
					end
				end)
			end)
		end
		for _, part in house:GetDescendants() do
			hideRoofPart(part)
		end
	end
	local function showRoof()
		if roofConnection then
			roofConnection:Disconnect()
			roofConnection = nil
		end
		for part, modifier in hidden do
			if part.Parent then
				part.LocalTransparencyModifier = modifier
			end
		end
		hidden = {}
	end
	local function showGrid()
		local folder = make("Folder", workspace, { Name = "BuildGrid" })
		grid = folder
		if structures and structures:isActive() and structures:section() ~= "Furniture" then
			local size = structures:gridSize()
			local offset = Building.gridOffset(site)
			local elevation = Building.planeHeight(site, structures:elevation() / Building.LEVEL_HEIGHT)
			local function line(x: number, z: number, width: number, depth: number)
				make("Part", folder, {
					Name = "ConstructionGrid", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
					CastShadow = false, Size = Vector3.new(width, 0.025, depth),
					CFrame = houseFrame * CFrame.new(x, elevation, z),
					Color = rgb(184, 150, 222), Material = Enum.Material.SmoothPlastic, Transparency = 0.35,
				})
			end
			for _, area in Building.Bounds[site or "Home"] do
				for column = math.ceil((area[1] - offset) / size), math.floor((area[3] - offset) / size) do
					line(column * size + offset, (area[2] + area[4]) / 2, 0.035, area[4] - area[2])
				end
				for row = math.ceil((area[2] - offset) / size), math.floor((area[4] - offset) / size) do
					line((area[1] + area[3]) / 2, row * size + offset, area[3] - area[1], 0.035)
				end
			end
			return
		end
		if site == "Company" then
			-- Cell boundaries sit halfway between the snap points, clipped to the plot.
			local area, half = Furniture.PLOT, BaseGrid.CELL_SIZE / 2
			for x = area[1] + half, area[3], BaseGrid.CELL_SIZE do
				plate(folder, { x - 0.02, area[2], x + 0.02, area[4] }, floorY + 0.13, rgb(235, 245, 255), 0.3)
			end
			for z = area[2] + half, area[4], BaseGrid.CELL_SIZE do
				plate(folder, { area[1], z - 0.02, area[3], z + 0.02 }, floorY + 0.13, rgb(235, 245, 255), 0.3)
			end
			return
		end
		-- Draw the cell boundaries, not the centers used to snap furniture.
		local halfWidth, halfLength = BaseGrid.HALF_WIDTH, BaseGrid.HALF_LENGTH
		for column = 0, BaseGrid.COLUMNS do
			local x = -halfWidth + column * BaseGrid.CELL_SIZE
			plate(folder, { x - 0.012, -halfLength, x + 0.012, halfLength }, FLOOR_Y + 0.13, rgb(235, 245, 255), 0.3)
		end
		for row = 0, BaseGrid.ROWS do
			local z = -halfLength + row * BaseGrid.CELL_SIZE
			plate(folder, { -halfWidth, z - 0.012, halfWidth, z + 0.012 }, FLOOR_Y + 0.13, rgb(235, 245, 255), 0.3)
		end
		-- Project the same grid onto the actual walking surfaces outside. Include
		-- only structural floors, ramps and decks: furniture, boats and roofs do
		-- not turn into grid surfaces, and gaps between piers remain empty.
		local base = house and house.Parent
		if not base then return end
		local surfaces = {}
		local surfaceNames = {
			DiningFloor = true, RearLanding = true, RearStep = true,
			EntranceStep = true, FrontApproachStep = true,
			-- The shop building across the street.
			ShopFloor = true, ShopEntranceStep = true, ShopForecourt = true,
		}
		for _, part in base:GetDescendants() do
			if part:IsA("BasePart") and part.CanQuery and (
				surfaceNames[part.Name]
				or (part.Name == "DeckSurface" and part.Parent and (part.Parent.Name == "Dock" or part.Parent.Name == "DockLink"))
				or ((part.Name == "DockRamp" or part.Name == "QuayLanding") and part:FindFirstAncestor("DockAccess"))
				or (part.Parent == base and part.Size.X >= 45 and part.Size.Z >= 40)
				or (part.Name == "Step" and part.Parent and part.Parent.Name == "BeachStairs")
			) then
				table.insert(surfaces, part)
			end
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = surfaces
		params.RespectCanCollide = true
		local up = houseFrame.UpVector
		local samples = {}
		local function sample(x: number, z: number): Vector3?
			local key = string.format("%.3f:%.3f", x, z)
			if samples[key] ~= nil then return samples[key] or nil end
			local origin = houseFrame:PointToWorldSpace(Vector3.new(x, 0.8, z))
			local hit = workspace:Raycast(origin, up * -8, params)
			if hit and hit.Normal:Dot(up) >= 0.7 and hit.Material ~= Enum.Material.Water then
				local point = hit.Position + up * 0.13
				samples[key] = point
				return point
			end
			samples[key] = false
			return nil
		end
		local function line(x1: number, z1: number, x2: number, z2: number, depth: number)
			-- The house already has its own uninterrupted overlay. Five samples
			-- also prevent a line from spanning water or a sudden height change.
			local mx, mz = (x1 + x2) / 2, (z1 + z2) / 2
			if math.abs(mx) < halfWidth and math.abs(mz) < halfLength then return end
			local points, count = {}, 0
			for index = 0, 4 do
				local t = index / 4
				local point = sample(x1 + (x2 - x1) * t, z1 + (z2 - z1) * t)
				points[index + 1] = point
				if point then count += 1 end
			end
			if count == 0 then return end
			local first, last = points[1], points[5]
			local continuous = count == 5
			if continuous then
				for index = 2, 4 do
					if (points[index] - first:Lerp(last, (index - 1) / 4)).Magnitude > 0.15 then
						continuous = false
						break
					end
				end
			end
			if not continuous then
				-- Clip edges and steps to smaller pieces, instead of connecting a
				-- line across a water gap or floating it above a stair tread.
				if depth < 3 then
					line(x1, z1, mx, mz, depth + 1)
					line(mx, mz, x2, z2, depth + 1)
				end
				return
			end
			local length = (last - first).Magnitude
			if length < 0.01 then return end
			make("Part", folder, {
				Name = "GroundGridLine", Anchored = true, CanCollide = false,
				CanQuery = false, CanTouch = false, CastShadow = false,
				Material = Enum.Material.SmoothPlastic, Color = rgb(235, 245, 255), Transparency = 0.3,
				Size = Vector3.new(0.024, 0.08, length),
				CFrame = CFrame.lookAt((first + last) / 2, last, up),
			})
		end
		local size = BaseGrid.CELL_SIZE
		for column = BaseGrid.BASE_MIN_COLUMN, BaseGrid.BASE_MAX_COLUMN + 1 do
			local x = -halfWidth + (column - 1) * size
			for row = BaseGrid.BASE_MIN_ROW, BaseGrid.BASE_MAX_ROW do
				local z = -halfLength + (row - 1) * size
				line(x, z, x, z + size, 0)
			end
		end
		for row = BaseGrid.BASE_MIN_ROW, BaseGrid.BASE_MAX_ROW + 1 do
			local z = -halfLength + (row - 1) * size
			for column = BaseGrid.BASE_MIN_COLUMN, BaseGrid.BASE_MAX_COLUMN do
				local x = -halfWidth + (column - 1) * size
				line(x, z, x + size, z, 0)
			end
		end
	end

	local function panBy(delta: Vector2)
		local limit = if site == "Company" then Vector2.new(60, 40) else PAN_LIMIT
		pan = Vector2.new(
			math.clamp(pan.X + delta.X, -limit.X, limit.X),
			math.clamp(pan.Y + delta.Y, -limit.Y, limit.Y)
		)
	end
	local function dragView(from: Vector2, to: Vector2)
		local first, last = pointerFloor(from), pointerFloor(to)
		if first and last then
			panBy(Vector2.new(first.X - last.X, first.Z - last.Z))
		end
	end
	local function changeZoom(steps: number)
		zoom = math.clamp(zoom * 0.85 ^ steps, 0.45, 2.5)
	end
	local function clearNavigation()
		table.clear(panKeys)
		table.clear(turnKeys)
		turnVelocity = 0
		dragging, dragPosition, touch = false, nil, nil
		touchDragged = false
	end
	local function cameraInput(_, inputState: Enum.UserInputState, input: InputObject)
		if inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
			panKeys[input.KeyCode] = nil
			turnKeys[input.KeyCode] = nil
		elseif inputState == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			panKeys[input.KeyCode] = PAN_KEYS[input.KeyCode]
			turnKeys[input.KeyCode] = TURN_KEYS[input.KeyCode]
		end
		-- Consume movement and jumping before Roblox can move the character.
		return if UserInputService:GetFocusedTextBox()
			then Enum.ContextActionResult.Pass
			else Enum.ContextActionResult.Sink
	end

	local function freezeCharacter(): boolean
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
			return false
		end
		if humanoid.SeatPart then
			notice("Leave your seat before entering build mode.")
			return false
		end
		frozen = { Root = root, Anchored = root.Anchored, Humanoid = humanoid, AutoRotate = humanoid.AutoRotate }
		humanoid:Move(Vector3.zero)
		humanoid.AutoRotate = false
		root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
		root.Anchored = true
		return true
	end
	local function releaseCharacter()
		if not frozen then
			return
		end
		if frozen.Root.Parent then
			frozen.Root.Anchored = frozen.Anchored
		end
		if frozen.Humanoid.Parent then
			frozen.Humanoid.AutoRotate = frozen.AutoRotate
		end
		frozen = nil
	end

	local function controls(enabled: boolean)
		pcall(function()
			local scripts = player:FindFirstChild("PlayerScripts")
			local playerModule = scripts and scripts:FindFirstChild("PlayerModule")
			if not playerModule or not playerModule:IsA("ModuleScript") then
				return
			end
			local module = require(playerModule)
			local playerControls = module:GetControls()
			if enabled then
				playerControls:Enable()
			else
				playerControls:Disable()
				local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
				if humanoid then
					humanoid:Move(Vector3.zero)
				end
			end
		end)
	end

	local hotbarBefore: boolean? = nil
	local function hideHotbar()
		if hotbarBefore == nil then
			local ok, enabled = pcall(StarterGui.GetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Backpack)
			hotbarBefore = if ok then enabled else true
		end
		pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Backpack, false)
	end
	local function restoreHotbar()
		if hotbarBefore ~= nil then
			pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Backpack, hotbarBefore)
			hotbarBefore = nil
		end
	end

	-- Every frame: outline furniture under the Select / Delete tools (and keep the
	-- structure tools from reacting through it), and float the furniture actions
	-- above the selected item, or centred above the dock while placing.
	local hoverModel: Model? = nil
	local hoverHighlight: Highlight? = nil
	local function placeActions()
		local position = if touch then Vector2.new(touch.Position.X, touch.Position.Y) else mousePosition()
		local tool = structures and structures:tool()
		local over = nil
		if active and not held and structures and structures:isActive() and (tool == "Select" or tool == "Remove") then
			local index = furnitureAt(position)
			over = if index then placedModel(index) else nil
		end
		if structures then structures:block(over ~= nil) end
		if over ~= hoverModel or (hoverHighlight and not hoverHighlight.Parent) then
			if hoverHighlight then
				hoverHighlight:Destroy()
				hoverHighlight = nil
			end
			hoverModel = over
			if over and not (highlight and highlight.Parent == over) then
				hoverHighlight = make("Highlight", over, {
					Name = "FurnitureHover",
					FillColor = if tool == "Remove" then BLOCKED else MENU.Blue,
					FillTransparency = 0.88,
					OutlineColor = if tool == "Remove" then BLOCKED else MENU.White,
					DepthMode = Enum.HighlightDepthMode.Occluded,
				})
			end
		end
		actions.Visible = active and (held ~= nil or (selected ~= nil and placed()[selected] ~= nil))
		if not actions.Visible then
			return
		end
		local camera = workspace.CurrentCamera
		local floor = panel.AbsolutePosition.Y - 10
		local model = if not held and selected then placedModel(selected) else nil
		local point = nil
		if model and camera then
			local box, size = model:GetBoundingBox()
			local screen, visible = camera:WorldToScreenPoint(box.Position + houseFrame.UpVector * (size.Y / 2 + 0.5))
			if visible then
				point = Vector2.new(screen.X, screen.Y)
			end
		end
		if point then
			local size = actions.AbsoluteSize
			local half = size.X / 2
			local width = gui.AbsoluteSize.X
			actions.Position = UDim2.fromOffset(
				math.clamp(point.X, half + 8, math.max(half + 8, width - half - 8)),
				math.clamp(point.Y - 8, size.Y + 72, math.max(size.Y + 72, floor))
			)
		else
			actions.Position = UDim2.new(0.5, 0, 0, floor)
		end
	end

	local function updateCamera(dt: number?)
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		camera.CameraType = Enum.CameraType.Scriptable
		camera.FieldOfView = 50
		camera.FieldOfViewMode = Enum.FieldOfViewMode.Vertical
		local viewport = camera.ViewportSize
		if viewport.X <= 0 or viewport.Y <= 0 then
			return
		end
		local inset = GuiService:GetGuiInset()
		local top = navigation.AbsolutePosition.Y + navigation.AbsoluteSize.Y + inset.Y + 12
		local bottom = panel.AbsolutePosition.Y + inset.Y - 12
		local focal = viewport.Y / (2 * math.tan(math.rad(camera.FieldOfView / 2)))
		local halfArea = math.max(1, bottom - top) / (2 * focal)
		local upper, lower = (viewport.Y / 2 - top) / focal, (viewport.Y / 2 - bottom) / focal
		local step = math.clamp(dt or 0, 0, 0.1)
		if not UserInputService:GetFocusedTextBox() then
			local turn = 0
			for _, direction in turnKeys do
				turn += direction
			end
			local targetVelocity = turn * TURN_SPEED
			local blend = 1 - math.exp(-TURN_RESPONSE * step)
			-- Integrate the eased speed so turning feels the same at different frame rates.
			yaw = (yaw + targetVelocity * step + (turnVelocity - targetVelocity) * blend / TURN_RESPONSE)
				% (2 * math.pi)
			turnVelocity += (targetVelocity - turnVelocity) * blend
		end
		local sinYaw, cosYaw = math.sin(yaw), math.cos(yaw)
		local back =
			Vector3.new(sinYaw * math.cos(CAMERA_PITCH), math.sin(CAMERA_PITCH), cosYaw * math.cos(CAMERA_PITCH))
		local orientation = CFrame.lookAt(Vector3.zero, -back)
		-- Fit the floor AND room walls in the viewport between the two toolbars.
		-- Perspective depth matters here: the near corners need more room.
		local distance = 18
		local fitHeight = if structures and structures:isActive() and structures:section() ~= "Furniture" then 18 else ROOF_HEIGHT
		local fitX, fitZ = if site == "Company" then 34 else 26, if site == "Company" then 24 else 18
		for _, x in { -fitX, fitX } do
			for _, z in { -fitZ, fitZ } do
				for _, y in { 0, fitHeight } do
					local point = orientation:PointToObjectSpace(Vector3.new(x, y, z))
					distance = math.max(
						distance,
						math.abs(point.X) * focal / (viewport.X / 2 - 12) + point.Z,
						(point.Y + upper * point.Z) / halfArea,
						(-point.Y - lower * point.Z) / halfArea
					)
				end
			end
		end
		cameraDistance = math.max(18, distance * zoom)
		if not UserInputService:GetFocusedTextBox() then
			local direction = Vector2.zero
			for _, axis in panKeys do
				direction += axis
			end
			if direction.Magnitude > 0 then
				local axis = direction.Unit
				local floorDirection =
					Vector2.new(axis.X * cosYaw + axis.Y * sinYaw, -axis.X * sinYaw + axis.Y * cosYaw)
				panBy(floorDirection * math.min(cameraDistance, 100) * 0.45 * step)
			end
		end
		local elevation = if structures and structures:isActive() then structures:elevation() else 0
		local center = houseFrame * Vector3.new(pan.X, floorY + elevation, pan.Y)
		local worldOrientation = houseFrame * orientation
		local shift = ((top + bottom) / 2 - viewport.Y / 2) * cameraDistance / focal
		local target = center + worldOrientation.UpVector * shift
		camera.CFrame =
			CFrame.lookAt(target + houseFrame:VectorToWorldSpace(back) * cameraDistance, target, houseFrame.UpVector)
		camera.Focus = CFrame.new(center)
		-- A stationary pointer must still track its floor tile as the camera moves.
		if held then
			aim(if touch then Vector2.new(touch.Position.X, touch.Position.Y) else mousePosition())
		end
		if structures then
			structures:step(if touch then Vector2.new(touch.Position.X, touch.Position.Y) else mousePosition())
		end
		if placeActions then
			placeActions()
		end
	end

	local exit
	local function enter()
		if active or not atHome() then
			if not active then
				notice("Go home to your base, or to your company island's plot, to use build mode.")
			end
			return
		end
		local model, frame, where = currentSite()
		local camera = workspace.CurrentCamera
		if not camera or not model or not frame then
			return
		end
		if not freezeCharacter() then
			return
		end
		Freecam.stop()
		active, house, houseFrame, site = true, model, frame, where
		floorY = if where == "Company" then 0 else FLOOR_Y
		clearNavigation()
		pan, zoom, yaw = Vector2.zero, 1, 0
		saved = {
			Type = camera.CameraType,
			FieldOfView = camera.FieldOfView,
			FieldOfViewMode = camera.FieldOfViewMode,
			Frame = camera.CFrame,
			Focus = camera.Focus,
		}
		camera.CameraType = Enum.CameraType.Scriptable
		camera.FieldOfView = 50
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
		controls(false)
		hideHotbar()
		ContextActionService:BindActionAtPriority(
			"FurnitureBuildMovement",
			cameraInput,
			false,
			Enum.ContextActionPriority.High.Value + 1,
			Enum.KeyCode.W,
			Enum.KeyCode.A,
			Enum.KeyCode.S,
			Enum.KeyCode.D,
			Enum.KeyCode.Up,
			Enum.KeyCode.Down,
			Enum.KeyCode.Left,
			Enum.KeyCode.Right,
			Enum.KeyCode.Q,
			Enum.KeyCode.E,
			Enum.KeyCode.Space
		)
		for key, axis in PAN_KEYS do
			if UserInputService:IsKeyDown(key) then
				panKeys[key] = axis
			end
		end
		for key, direction in TURN_KEYS do
			if UserInputService:IsKeyDown(key) then
				turnKeys[key] = direction
			end
		end
		hideRoof()
		showGrid()
		panel.Visible, navigation.Visible, toggle.Visible = true, true, false
		structures:enter(model, frame, where)
		player:SetAttribute("BuildModeOpen", true)
		updateCamera()
		RunService:BindToRenderStep("FurnitureBuildCamera", Enum.RenderPriority.Camera.Value + 1, updateCamera)
		render()
		task.spawn(function()
			local ok, result = pcall(request.InvokeServer, request, "Get")
			if ok and type(result) == "table" and result.State then
				state = result.State
				render()
			end
		end)
	end
	function exit()
		if not active then
			return
		end
		active = false
		structures:exit()
		clearNavigation()
		ContextActionService:UnbindAction("FurnitureBuildMovement")
		drop()
		choose(nil)
		RunService:UnbindFromRenderStep("FurnitureBuildCamera")
		showRoof()
		if grid then
			grid:Destroy()
			grid = nil
		end
		local camera = workspace.CurrentCamera
		if saved and camera then
			camera.CameraType = saved.Type
			camera.FieldOfViewMode = saved.FieldOfViewMode
			camera.FieldOfView = saved.FieldOfView
			camera.CFrame = saved.Frame
			camera.Focus = saved.Focus
		end
		-- Never restore a snapshot of the pointer: a lock or hidden icon captured on entry
		-- can outlive whatever set it and strand the cursor. The camera re-locks if it needs to.
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
		releaseCharacter()
		controls(true)
		restoreHotbar()
		panel.Visible, navigation.Visible, helpPanel.Visible, actions.Visible = false, false, false, false
		if hoverHighlight then
			hoverHighlight:Destroy()
			hoverHighlight, hoverModel = nil, nil
		end
		player:SetAttribute("BuildModeOpen", false)
	end
	-- Tab and tool changes from the dock. Switching tabs drops anything held; picking
	-- a placement or paint tool clears the furniture selection.
	local furnitureSection = "Furniture"
	onStructureMode = function(enabled, section, tool)
		local changed = section ~= furnitureSection
		furnitureSection = section
		if changed or (enabled and held) then
			drop()
		end
		if changed or (tool ~= nil and tool ~= "Select") then
			choose(nil)
			editingRack, rackEditor.Visible = false, false
		end
		furniturePane.Visible = section == "Furniture"
		if structures and structures:roofVisible() then showRoof() else hideRoof() end
		if active and structures then
			if grid then grid:Destroy(); grid = nil end
			showGrid()
		end
	end
	onStructureSelect = function()
		choose(nil)
	end
	for id, item in itemButtons do
		item.Activated:Connect(function()
			if active and item.Active then
				choose(nil)
				structures:suspend()
				hold(id, id, if held then held.R else 0)
			end
		end)
	end
	for id, chip in categoryButtons do
		chip.Activated:Connect(function()
			category = id
			catalogue.CanvasPosition = Vector2.zero
			render()
		end)
	end
	rotate.Activated:Connect(function()
		if held then
			held.R = (held.R + 1) % 4
			aim(mousePosition())
		else
			rotateSelected()
		end
	end)
	cancel.Activated:Connect(release)
	move.Activated:Connect(function()
		local entry = selected and placed()[selected]
		if entry and not pending then
			structures:suspend()
			hold(entry.ItemId, selected, entry.R)
		end
	end)
	pickUp.Activated:Connect(function()
		if selected then pickUpFurniture(selected) end
	end)
	helpToggle.Activated:Connect(function()
		helpPanel.Visible = not helpPanel.Visible
		setButton(helpToggle, "?", true, helpPanel.Visible)
	end)
	editRack.Activated:Connect(function()
		if selected and not pending then
			local entry = placed()[selected]
			if entry and entry.ItemId == "KitchenStorage" then
				KitchenStorage.open()
				return
			end
			editingRack = not editingRack
			render()
		end
	end)
	for item, action in { [rackMode] = "Mode", [addCage] = "AddCage", [takeCage] = "TakeCage", [addNet] = "AddNet", [takeNet] = "TakeNet" } do
		item.Activated:Connect(function()
			if selected and not pending then send("EditRack", selected, action, site) end
		end)
	end
	done.Activated:Connect(exit)
	toggle.Activated:Connect(enter)
	zoomIn.Activated:Connect(function()
		changeZoom(1)
	end)
	zoomOut.Activated:Connect(function()
		changeZoom(-1)
	end)
	recenter.Activated:Connect(function()
		pan, zoom, yaw, turnVelocity = Vector2.zero, 1, 0, 0
	end)
	UserInputService.WindowFocusReleased:Connect(clearNavigation)
	UserInputService.TextBoxFocused:Connect(clearNavigation)
	GuiService.MenuOpened:Connect(clearNavigation)

	local function clickWorld(position: Vector2)
		if held then
			aim(position)
			placeHeld()
		elseif structures and structures:isActive() then
			-- Select and Delete work on furniture and building pieces alike.
			local tool = structures:tool()
			if tool == "Select" or tool == "Remove" then
				local index = furnitureAt(position)
				if index then
					if tool == "Remove" then pickUpFurniture(index) else choose(index) end
					return
				end
				choose(nil)
			end
			structures:click(position)
		else
			clickFurniture(position)
		end
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or UserInputService:GetFocusedTextBox() then
			return
		end
		if input.KeyCode == Enum.KeyCode.B then
			if active then
				exit()
			else
				enter()
			end
		elseif not active then
			return
		elseif (input.KeyCode == Enum.KeyCode.X or input.KeyCode == Enum.KeyCode.Escape) and (held or selected) then
			-- Cancel furniture first; the structure tools also clear their own state.
			release()
			if structures then structures:key(input) end
		elseif input.KeyCode == Enum.KeyCode.R and held then
			held.R = (held.R + 1) % 4
			aim(mousePosition())
		elseif input.KeyCode == Enum.KeyCode.R and selected and placed()[selected] then
			rotateSelected()
		elseif input.KeyCode == Enum.KeyCode.M and selected and placed()[selected] and not held and not pending then
			local entry = placed()[selected]
			structures:suspend()
			hold(entry.ItemId, selected, entry.R)
		elseif input.KeyCode == Enum.KeyCode.Delete and selected and placed()[selected] and not held then
			pickUpFurniture(selected)
		elseif structures and structures:key(input) then
			return
		elseif input.KeyCode == Enum.KeyCode.X then
			drop()
			choose(nil)
		elseif input.KeyCode == Enum.KeyCode.Home then
			pan, zoom, yaw, turnVelocity = Vector2.zero, 1, 0, 0
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			dragging = true
			dragPosition = mousePosition()
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
			clickWorld(mousePosition())
		elseif input.UserInputType == Enum.UserInputType.Touch and not touch then
			touch = input
			touchStart = Vector2.new(input.Position.X, input.Position.Y)
			dragPosition, touchDragged = touchStart, false
		end
	end)
	UserInputService.InputChanged:Connect(function(input, processed)
		if not active then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseWheel and not processed then
			changeZoom(input.Position.Z)
		elseif dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local position = mousePosition()
			if dragPosition then
				dragView(dragPosition, position)
			end
			dragPosition = position
		elseif input == touch then
			local position = Vector2.new(input.Position.X, input.Position.Y)
			if (position - touchStart).Magnitude > 8 then
				touchDragged = true
			end
			if touchDragged and dragPosition then
				dragView(dragPosition, position)
			end
			dragPosition = position
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			dragging, dragPosition = false, nil
		elseif input == touch then
			if active and not touchDragged and input.UserInputState ~= Enum.UserInputState.Cancel then
				clickWorld(Vector2.new(input.Position.X, input.Position.Y))
			end
			touch, dragPosition = nil, nil
			touchDragged = false
		end
	end)
	update.OnClientEvent:Connect(function(kind, payload)
		if kind == "State" and type(payload) == "table" then
			state = payload
			if selected then
				choose(if placed()[selected] then selected else nil)
			end
			render()
		end
	end)
	-- Respawning or leaving home ends build mode; the toggle shows only at home.
	player.CharacterAdded:Connect(exit)
	player.CharacterRemoving:Connect(exit)
	task.spawn(function()
		while true do
			task.wait(0.5)
			local home = atHome()
			toggle.Visible = home and not active
			if active then
				local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
				if not home or not humanoid or humanoid.Health <= 0 then
					exit()
				else
					hideHotbar()
					hideRoof()
					-- Furniture rebuilt by the server since the last check keeps its highlight.
					if selected and highlight and not highlight.Parent then
						setHighlight(placedModel(selected))
					end
				end
			end
		end
	end)
end

return BuildMode
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="304">
          <Properties>
            <string name="Name">BuildPaintQueue</string>
            <string name="Source"><![CDATA[-- Paint stays responsive while the network saves. One writer batches/coalesces
-- clicks, and later commands can wait for a complete paint stroke to commit.
local Queue = {}
function Queue.new(options)
	local self = { Outstanding = {}, Waiting = {}, Order = {}, Running = false, Serial = 0, Listeners = {} }
	local lastSend = -math.huge
	local function report()
		if options.Changed then options.Changed(self.Outstanding) end
	end
	local function run()
		if self.Running then return end
		self.Running = true
		task.spawn(function()
			while #self.Order > 0 do
				local pause = (options.Interval or 0.1) - (os.clock() - lastSend)
				if pause > 0 then task.wait(pause) end
				local batch, serials = {}, {}
				while #self.Order > 0 and #batch < 64 do
					local id = table.remove(self.Order, 1)
					local record = self.Waiting[id]
					self.Waiting[id] = nil
					if record then
						table.insert(batch, record.Patch)
						serials[id] = record.Serial
					end
				end
				if #batch > 0 then
					local ok, result
					for attempt = 1, 6 do
						lastSend = os.clock()
						ok, result = pcall(options.Send, batch)
						local delay = ok and type(result) == "table" and result.RetryAfter
						if ok and type(result) == "table" and result.Ok == false and type(delay) == "number" and delay == delay and delay >= 0.05 and delay <= 1 and attempt < 6 then
							task.wait(delay)
						else break end
					end
					if not ok then result = { Ok = false, Message = "Painting could not be saved. Please try again." } end
					for id, serial in serials do
						local latest = self.Outstanding[id]
						if latest and latest.Serial == serial then self.Outstanding[id] = nil end
					end
					if options.Result then options.Result(result, self.Outstanding) end
					report()
				end
			end
			self.Running = false
			local listeners = self.Listeners
			self.Listeners = {}
			for _, callback in listeners do callback() end
		end)
	end
	function self:paint(patch)
		self.Serial += 1
		local record = { Patch = { Id = patch.Id, Material = patch.Material, Color = table.clone(patch.Color) }, Serial = self.Serial }
		if not self.Waiting[patch.Id] then table.insert(self.Order, patch.Id) end
		self.Waiting[patch.Id], self.Outstanding[patch.Id] = record, record
		report()
		run()
	end
	function self:drain(callback)
		if not self.Running and #self.Order == 0 then callback()
		else table.insert(self.Listeners, callback); run() end
	end
	function self:busy()
		return self.Running or #self.Order > 0
	end
	return self
end
return Queue
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="305">
          <Properties>
            <string name="Name">CargoHold</string>
            <string name="Source"><![CDATA[-- Card inventory for the backpack, hand and active boat. Capacity is independent
-- of the card layout; all saves, ownership and access are checked by the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local MarketplaceService = game:GetService("MarketplaceService")
local StarterGui = game:GetService("StarterGui")
local Aboard = require(ReplicatedStorage.Shared.Aboard)
local BoatCatalog = require(ReplicatedStorage.Shared.BoatCatalog)
local Backpacks = require(ReplicatedStorage.Shared.BackpackCatalog)
local Cargo = require(ReplicatedStorage.Shared.Cargo)
local Inventory = require(ReplicatedStorage.Shared.Inventory)
local Bait = require(ReplicatedStorage.Shared.Bait)
local Passes = require(ReplicatedStorage.Shared.Gamepasses)
local Catalog = require(ReplicatedStorage.Shared.AnglerCatalog)
local FishCatch = require(ReplicatedStorage.Shared.FishCatch)
local FishModels = require(ReplicatedStorage.Shared.FishModels)
local FishMutations = require(ReplicatedStorage.Shared.FishMutations)

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end
local CargoHold = {}
local rgb = Color3.fromRGB
local INK, HULL, EDGE = rgb(18, 19, 23), rgb(5, 6, 8), rgb(48, 49, 55)
local WHITE, MUTED = rgb(240, 240, 236), rgb(150, 152, 158)
local GOLD, CREAM, CYAN = rgb(255, 226, 128), rgb(226, 218, 196), rgb(110, 228, 240)
local VIOLET, MINT, AMBER, RED = rgb(178, 142, 255), rgb(150, 230, 140), rgb(255, 176, 96), rgb(255, 82, 82)
local WIDTH, HEIGHT, LEFT, CONTENT = 1180, 500, 176, 832
local MIN_HEIGHT = 400 -- shortest panel the fixed side columns still fit in
local CARD, CARD_HEIGHT, GAP = 98, 98, 6
local HOTBAR_CLEARANCE = 90
local started = false
local function make(class: string, parent: Instance?, props: { [string]: any }): any
	local item = Instance.new(class)
	for key, value in props do
		item[key] = value
	end
	item.Parent = parent
	return item
end

local function round(item: GuiObject, radius: number?)
	make("UICorner", item, { CornerRadius = if radius then UDim.new(0, radius) else UDim.new(1, 0) })
end

local function stroke(item: GuiObject, color: Color3, thickness: number)
	return make("UIStroke", item, {
		Color = color,
		Thickness = thickness,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function text(parent: Instance, value: string, props: { [string]: any }): TextLabel
	local label = make("TextLabel", parent, {
		BackgroundTransparency = 1,
		Font = Enum.Font.BuilderSansMedium,
		Text = value,
		TextColor3 = WHITE,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	for key, item in props do
		label[key] = item
	end
	return label
end

-- Short accent strokes in each corner, like a targeting frame.
local function brackets(item: GuiObject, color: Color3)
	for _, corner in { Vector2.new(0, 0), Vector2.new(1, 0), Vector2.new(0, 1), Vector2.new(1, 1) } do
		for _, size in { UDim2.fromOffset(7, 2), UDim2.fromOffset(2, 7) } do
			make("Frame", item, {
				Name = "Bracket",
				AnchorPoint = corner,
				Position = UDim2.fromScale(corner.X, corner.Y),
				Size = size,
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				ZIndex = 2,
			})
		end
	end
end

local function button(parent: Instance, caption: string, props: { [string]: any }, accent: Color3?): TextButton
	local item = make("TextButton", parent, {
		AutoButtonColor = true,
		BackgroundColor3 = INK,
		Font = Enum.Font.BuilderSansBold,
		Text = caption,
		TextColor3 = accent or WHITE,
		TextSize = 15,
	})
	item.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold, Enum.FontStyle.Italic)
	for key, value in props do
		item[key] = value
	end
	round(item, 2)
	stroke(item, EDGE, 1)
	brackets(item, accent or MUTED)
	return item
end

-- Small pictograms are drawn as strokes on a colored circular badge. They do
-- not depend on platform-specific emoji or uploaded image assets.
local MUTATION_ICONS = {
	Corrupted = { { {2,2,10,10}, {10,2,2,10}, {6,2,6,10} } },
	VoidTouched = { { {2,6,4,2}, {4,2,8,2}, {8,2,10,6}, {10,6,8,10}, {8,10,4,10}, {4,10,2,6}, {6,4,6,8} } },
	Windy = { { {1,4,9,4}, {9,4,10,2}, {1,7,10,7}, {10,7,9,9} } },
	Ascended = { { {2,5,6,1}, {6,1,10,5}, {6,1,6,10}, {2,10,10,10} } },
	Floral = { { {6,1,6,11}, {1,6,11,6}, {3,3,9,9}, {9,3,3,9} } },
	Snowy = { { {6,1,6,11}, {1,3,11,9}, {1,9,11,3}, {4,2,6,4}, {8,2,6,4} } },
	Tryhard = { { {2,2,10,10}, {10,2,2,10}, {1,3,4,3}, {8,3,11,3}, {1,10,3,10}, {9,10,11,10} } },
	JackOFish = { { {3,3,9,3}, {9,3,11,6}, {11,6,9,10}, {9,10,3,10}, {3,10,1,6}, {1,6,3,3}, {6,3,7,1}, {3,6,4,6}, {8,6,9,6}, {4,8,8,8} } },
	JacksPet = { { {2,5,3,9}, {3,9,9,9}, {9,9,10,5}, {10,5,8,2}, {8,2,6,4}, {6,4,4,2}, {4,2,2,5}, {4,6,4,6}, {8,6,8,6} } },
	ZeusStruck = { { {7,1,3,6}, {3,6,6,6}, {6,6,5,11}, {5,11,10,5}, {10,5,7,5}, {7,5,7,1} } },
	Nightmare = { { {1,6,4,3}, {4,3,8,3}, {8,3,11,6}, {11,6,8,9}, {8,9,4,9}, {4,9,1,6}, {6,4,6,8} } },
	Obsidian = { { {6,1,10,4}, {10,4,9,9}, {9,9,6,11}, {6,11,2,8}, {2,8,2,4}, {2,4,6,1}, {6,1,6,11}, {2,4,10,4} } },
	Gusty = { { {1,3,8,3}, {8,3,10,5}, {10,5,8,7}, {8,7,5,7}, {1,6,6,6}, {1,9,7,9} } },
	Astral = { { {6,1,6,11}, {1,6,11,6}, {3,3,9,9}, {9,3,3,9} } },
	Rainbow = { { {1,9,2,5}, {2,5,5,2}, {5,2,8,2}, {8,2,11,5}, {11,5,11,9}, {3,9,4,6}, {4,6,6,5}, {6,5,8,6}, {8,6,9,9} } },
	Neon = { { {1,8,3,8}, {3,8,4,3}, {4,3,6,3}, {6,3,6,9}, {6,9,8,9}, {8,9,9,4}, {9,4,11,4} } },
	Albino = { { {1,6,4,3}, {4,3,8,3}, {8,3,11,6}, {11,6,8,9}, {8,9,4,9}, {4,9,1,6}, {5,6,5,6} } },
}

local function mutationBadge(parent: Instance, record)
	if not record or not record.Mutation or record.Mutation == "Normal" then
		return
	end
	local index = 0
	for name in string.gmatch(record.Mutation, "[^+]+") do
		-- Badge colours are shared with the coloured mutation names (FishMutations.Colors).
		local strokes = (MUTATION_ICONS[name] or { { {2,6,10,6}, {6,2,6,10} } })[1]
		local base = FishMutations.Colors[name]
		local color = if base then rgb(base[1], base[2], base[3]) else MUTED
		local neon = name == "Neon" and FishMutations.NeonColors[record.NeonColor or ""]
		if neon then
			color = rgb(neon[1], neon[2], neon[3])
			-- Keep the white pictogram visible on especially pale neon colors.
			if color.R * 0.299 + color.G * 0.587 + color.B * 0.114 > 0.8 then
				color = color:Lerp(INK, 0.35)
			end
		end
		local badge = make("Frame", parent, {
			Name = "MutationIcon",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -2 - (index % 2) * 17, 0, 2 + math.floor(index / 2) * 17),
			Size = UDim2.fromOffset(16, 16),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = 4,
		})
		round(badge)
		for lineIndex, line in strokes do
			local dx, dy = line[3] - line[1], line[4] - line[2]
			local rainbow = FishMutations.RainbowColors[(lineIndex - 1) % #FishMutations.RainbowColors + 1]
			local mark = make("Frame", badge, {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(2 + (line[1] + line[3]) / 2, 2 + (line[2] + line[4]) / 2),
				Size = UDim2.fromOffset(math.max(1.5, math.sqrt(dx * dx + dy * dy)), 1.5),
				Rotation = math.deg(math.atan2(dy, dx)),
				BackgroundColor3 = if name == "Rainbow" then rgb(rainbow[1], rainbow[2], rainbow[3]) else WHITE,
				BorderSizePixel = 0,
				ZIndex = 5,
			})
			round(mark)
		end
		index += 1
	end
end

-- RichText card title: the coloured mutation label before the plain name.
local function fishTitle(entry): string
	local name = string.gsub(string.gsub(string.gsub(entry.Name, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
	local fish = entry.Item and entry.Item.Fish
	local mutation = if fish then FishMutations.richLabel(fish.Mutation, fish.NeonColor) else ""
	return if mutation ~= "" then mutation .. " " .. name else name
end

-- Fit every bounds corner after rolling the camera, including perspective depth.
-- Use the tile dimensions because the preview may not be parented/on screen yet.
local function fitTileFish(model: Model, camera: Camera, width: number, height: number, rotation: number)
	local center = model:GetAttribute("BoundsCenter") :: Vector3
	local half = (model:GetAttribute("BoundsSize") :: Vector3) / 2
	local orientation = camera.CFrame.Rotation * CFrame.Angles(0, 0, rotation * math.pi / 2)
	local tanY = math.tan(math.rad(camera.FieldOfView / 2))
	local tanX = tanY * width / height
	local distance = 0.1
	for _, x in { -1, 1 } do
		for _, y in { -1, 1 } do
			for _, z in { -1, 1 } do
				local corner = orientation:VectorToObjectSpace(Vector3.new(half.X * x, half.Y * y, half.Z * z))
				distance = math.max(distance, corner.Z + math.max(math.abs(corner.X) / tanX, math.abs(corner.Y) / tanY) * 1.05)
			end
		end
	end
	camera.CFrame = CFrame.new(center - orientation.LookVector * distance) * orientation
	camera:SetAttribute("Distance", distance)
end

function CargoHold.start()
	if started then return end
	started = true
	local player = Players.LocalPlayer
	local remotes = ReplicatedStorage:WaitForChild("Cargo")
	local request = remotes:WaitForChild("Request") :: RemoteFunction
	local update = remotes:WaitForChild("Update") :: RemoteEvent
	local state = { Backpack = {}, Items = {}, BackpackId = "Starter", AutoStore = true }
	local open, pending, aboard = false, false, false
	local tab, sortBy, ascending = "Backpack", nil, true
	local view = { Fish = true, Items = true, Favorites = false }
	local selected, signature = nil, nil
	local lastRequest = -math.huge
	local render, setOpen, send
	local cards = {}
	local gui = make("ScreenGui", player:WaitForChild("PlayerGui"), {
		Name = "Cargo", ResetOnSpawn = false, DisplayOrder = 23,
		IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	local toggle = button(gui, "Inventory [`]", {
		Name = "OpenCargo", Position = UDim2.new(1, -150, 1, -100), Size = UDim2.fromOffset(136, 38),
	}, GOLD)
	local shade = make("Frame", gui, {
		Name = "InventoryShade", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(),
		BackgroundTransparency = 1, BorderSizePixel = 0, Active = false, Visible = false,
	})
	local panel = make("Frame", shade, {
		Name = "InventoryPanel", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -HOTBAR_CLEARANCE),
		Size = UDim2.fromOffset(WIDTH, HEIGHT), BackgroundColor3 = HULL,
		BackgroundTransparency = 0.08, BorderSizePixel = 0, Active = true,
	})
	round(panel, 3)
	stroke(panel, EDGE, 1)
	local scale = make("UIScale", panel, { Scale = 1 })
	-- Height-dependent children are positioned by applyHeight (assigned once they exist).
	local applyHeight: (number) -> () = function() end
	local panelHeight = HEIGHT
	local function updateLayout()
		local camera = workspace.CurrentCamera
		if not camera then return end
		local size = camera.ViewportSize
		-- Shrink the hotbar gap and side margins on small screens so the panel keeps more room.
		local clearance = math.min(HOTBAR_CLEARANCE, size.Y * 0.17)
		local availableHeight = math.max(1, size.Y - clearance - 12)
		-- Scale down only as far as needed to fit the narrowest layout; the item list absorbs any
		-- remaining height difference instead of shrinking every label.
		local fit = math.min(1, (size.X - 16) / WIDTH, availableHeight / MIN_HEIGHT)
		scale.Scale = math.max(0.01, fit)
		panel.Position = UDim2.new(0.5, 0, 1, -clearance)
		local height = math.clamp(math.floor(availableHeight / scale.Scale), MIN_HEIGHT, HEIGHT)
		if height ~= panelHeight then
			panelHeight = height
			applyHeight(height)
		end
	end
	updateLayout()
	text(panel, "Inventory", { Position = UDim2.fromOffset(20, 12), Size = UDim2.fromOffset(150, 36),
		TextSize = 25, Font = Enum.Font.BuilderSansBold, TextColor3 = GOLD })
	local tabs = {}
	for index, name in { "Backpack", "Boat", "All" } do
		local control = button(panel, name, { Name = name .. "Tab", Position = UDim2.fromOffset(LEFT + (index - 1) * 154, 14),
			Size = UDim2.fromOffset(146, 32) }, if name == "Boat" then VIOLET else CYAN)
		tabs[name] = control
		control.Activated:Connect(function()
			tab, selected = name, nil
			render()
		end)
	end
	local close = button(panel, "X", { Name = "CloseInventory", Position = UDim2.new(1, -54, 0, 14),
		Size = UDim2.fromOffset(34, 34), TextSize = 20 }, RED)
	local summary = text(panel, "Loading inventory…", { Name = "InventoryCount", Position = UDim2.fromOffset(LEFT, 54),
		Size = UDim2.fromOffset(560, 28), TextSize = 19, TextColor3 = GOLD })
	local searchBox = make("TextBox", panel, { Name = "SearchInput", Position = UDim2.fromOffset(LEFT + CONTENT - 252, 54),
		Size = UDim2.fromOffset(196, 32), BackgroundColor3 = INK, Text = "", PlaceholderText = "Search inventory…",
		PlaceholderColor3 = MUTED, TextColor3 = WHITE, TextSize = 15, Font = Enum.Font.BuilderSans,
		ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left, Visible = false })
	make("UIPadding", searchBox, { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) })
	stroke(searchBox, EDGE, 1)
	local search = button(panel, "Search", { Name = "Search", Position = UDim2.fromOffset(LEFT + CONTENT - 108, 54),
		Size = UDim2.fromOffset(108, 32) }, MUTED)
	local list = make("ScrollingFrame", panel, { Name = "InventoryItems", Position = UDim2.fromOffset(LEFT, 94),
		Size = UDim2.fromOffset(CONTENT, 306), BackgroundTransparency = 1, BorderSizePixel = 0,
		CanvasSize = UDim2.fromOffset(0, 0), ScrollBarThickness = 4, ScrollBarImageColor3 = MUTED,
		ScrollingDirection = Enum.ScrollingDirection.Y, ClipsDescendants = true })
	local empty = text(panel, "", { Name = "EmptyInventory", Position = UDim2.fromOffset(LEFT + 30, 180),
		Size = UDim2.fromOffset(CONTENT - 60, 130), TextSize = 18, TextColor3 = MUTED,
		TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center })
	local capacity = text(panel, "", { Name = "Capacity", Position = UDim2.fromOffset(LEFT, 84),
		Size = UDim2.fromOffset(CONTENT, 8), TextSize = 11, TextColor3 = MUTED })
	local function sideTitle(caption, x, y)
		text(panel, caption, { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(136, 28),
			TextSize = 21, Font = Enum.Font.BuilderSansBold, TextXAlignment = Enum.TextXAlignment.Center })
		make("Frame", panel, { Position = UDim2.fromOffset(x + 6, y + 31), Size = UDim2.fromOffset(124, 2),
			BackgroundColor3 = WHITE, BorderSizePixel = 0 })
	end
	sideTitle("Auto Store", 20, 54)
	local autoStore = button(panel, "", { Name = "AutoStore", Position = UDim2.fromOffset(20, 98), Size = UDim2.fromOffset(136, 32) }, MINT)
	text(panel, "Automatically stow catches aboard your boat.", { Position = UDim2.fromOffset(22, 138),
		Size = UDim2.fromOffset(132, 42), TextSize = 12, TextColor3 = MUTED, TextWrapped = true })
	sideTitle("Sort By", 20, 196)
	local sortButtons = {}
	for index, spec in { { "Off", "Sorting: Off", CYAN }, { "Rarity", "Rarity", AMBER }, { "Worth", "Worth", MINT }, { "Name", "ABC order", VIOLET } } do
		local control = button(panel, spec[2], { Name = "Sort" .. spec[1], Position = UDim2.fromOffset(20, 238 + (index - 1) * 36),
			Size = UDim2.fromOffset(136, 32), TextSize = 14 }, spec[3])
		sortButtons[spec[1]] = control
		control.Activated:Connect(function()
			if spec[1] == "Off" then
				sortBy = if sortBy then nil else "Rarity"
				ascending = false
			elseif sortBy == spec[1] then ascending = not ascending
			else sortBy, ascending = spec[1], spec[1] == "Name" end
			list.CanvasPosition = Vector2.zero
			render()
		end)
	end
	sideTitle("View", 1026, 54)
	local viewButtons = {}
	for index, spec in { { "Fish", "Fish" }, { "Items", "Items" }, { "Favorites", "Favorites" } } do
		local control = make("TextButton", panel, { Name = "View" .. spec[1], Text = "", BackgroundTransparency = 1,
			Position = UDim2.fromOffset(1024, 100 + (index - 1) * 38), Size = UDim2.fromOffset(142, 34) })
		local track = make("Frame", control, { Position = UDim2.fromOffset(0, 7), Size = UDim2.fromOffset(44, 20),
			BackgroundColor3 = MINT, BorderSizePixel = 0 })
		round(track)
		local knob = make("Frame", track, { Position = UDim2.fromOffset(24, -1), Size = UDim2.fromOffset(22, 22),
			BackgroundColor3 = CREAM, BorderSizePixel = 0 })
		round(knob)
		stroke(knob, WHITE, 1)
		text(control, spec[2], { Position = UDim2.fromOffset(52, 0), Size = UDim2.fromOffset(94, 34), TextSize = 16 })
		viewButtons[spec[1]] = { Track = track, Knob = knob }
		control.Activated:Connect(function()
			view[spec[1]] = not view[spec[1]]
			list.CanvasPosition = Vector2.zero
			render()
		end)
	end
	text(panel, "Select a card for actions.\nRight-click a fish to favorite it.", { Position = UDim2.fromOffset(1026, 230),
		Size = UDim2.fromOffset(134, 66), TextSize = 12, TextColor3 = MUTED, TextWrapped = true })
	local detail = text(panel, "Select an item", { Name = "SelectedItem", Position = UDim2.fromOffset(LEFT, 404),
		Size = UDim2.fromOffset(CONTENT, 24), TextSize = 15, RichText = true, TextTruncate = Enum.TextTruncate.AtEnd })
	local actions = {}
	for index, spec in { { "Hand", "Take in hand", CYAN }, { "Backpack", "To backpack", CYAN },
		{ "Boat", "To boat", VIOLET }, { "Favorite", "Favorite", GOLD }, { "Release", "Release", RED },
		{ "Use", "Use", GOLD } } do
		local control = button(panel, spec[2], { Name = "Action" .. spec[1], Position = UDim2.fromOffset(LEFT + (index - 1) * 139, 432),
			Size = UDim2.fromOffset(131, 32), TextSize = 13, Visible = false }, spec[3])
		actions[spec[1]] = control
	end
	-- Bait crates live on the profile (not in the hold); they're shown here as a
	-- card too, and opened through the same server action as the equipment bag.
	local openCrate = button(panel, "Open crate", { Name = "ActionOpenCrate", Position = UDim2.fromOffset(LEFT, 432),
		Size = UDim2.fromOffset(131, 32), TextSize = 13, Visible = false }, GOLD)
	local crateSelected = false
	local bulk = button(panel, "Boat → backpack", { Name = "MoveAll", Position = UDim2.fromOffset(1026, 346),
		Size = UDim2.fromOffset(136, 36), TextSize = 13, Visible = false }, MINT)
	local fitPart = button(panel, "Fit reserved part", { Name = "FitPart", Position = UDim2.fromOffset(LEFT, 432),
		Size = UDim2.fromOffset(194, 32), Visible = false }, MINT)
	local cancelPart = button(panel, "Cancel refit", { Name = "CancelRefit", Position = UDim2.fromOffset(LEFT + 208, 432),
		Size = UDim2.fromOffset(150, 32), Visible = false }, RED)
	local worth = text(panel, "Total worth: $0", { Name = "TotalWorth", Position = UDim2.new(1, -330, 1, -30),
		Size = UDim2.fromOffset(310, 24), TextSize = 18, Font = Enum.Font.BuilderSansBold,
		TextColor3 = GOLD, TextXAlignment = Enum.TextXAlignment.Right })
	local notice = text(panel, "", { Name = "InventoryNotice", Position = UDim2.fromOffset(LEFT, HEIGHT - 30),
		Size = UDim2.fromOffset(620, 24), TextSize = 12, TextColor3 = MUTED, TextTruncate = Enum.TextTruncate.AtEnd })
	-- Offsets below match the original 500px layout; everything below the item list follows the bottom edge.
	applyHeight = function(height: number)
		local extra = height - HEIGHT
		panel.Size = UDim2.fromOffset(WIDTH, height)
		list.Size = UDim2.fromOffset(CONTENT, 306 + extra)
		empty.Position = UDim2.fromOffset(LEFT + 30, 180 + extra / 2)
		detail.Position = UDim2.fromOffset(LEFT, 404 + extra)
		for index, control in { actions.Hand, actions.Backpack, actions.Boat, actions.Favorite, actions.Release } do
			control.Position = UDim2.fromOffset(LEFT + (index - 1) * 139, 432 + extra)
		end
		openCrate.Position = UDim2.fromOffset(LEFT, 432 + extra)
		fitPart.Position = UDim2.fromOffset(LEFT, 432 + extra)
		cancelPart.Position = UDim2.fromOffset(LEFT + 208, 432 + extra)
		notice.Position = UDim2.fromOffset(LEFT, height - 30)
	end
	applyHeight(panelHeight)
	local function money(amount)
		local value = tostring(math.floor(amount))
		local formatted = value:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
		return "$" .. formatted
	end
	local function entryId(entry)
		return entry.Source .. ":" .. tostring(entry.Index)
	end
	local function refreshPreviews()
		if not open then return end
		local top = list.CanvasPosition.Y
		for _, card in cards do
			local visible = card.Y + CARD_HEIGHT >= top and card.Y <= top + list.Size.Y.Offset
			if visible and not card.Preview and card.Entry.Item and card.Entry.Item.Fish then
				local fish = card.Entry.Item.Fish
				local viewport = make("ViewportFrame", card.Button, { Position = UDim2.fromOffset(2, 9),
					Size = UDim2.fromOffset(CARD - 4, 58), BackgroundTransparency = 1, ZIndex = 1, Active = false })
				local model, camera = FishModels.show(viewport, fish.FishId, nil, fish)
				if model and camera then fitTileFish(model, camera, CARD - 4, 58, 0) end
				card.Preview = viewport
			elseif not visible and card.Preview then
				card.Preview:Destroy()
				card.Preview = nil
			end
		end
	end
	local function payload(entry)
		return { Source = entry.Source, Index = entry.Index, BoatId = state.BoatId,
			Expected = Inventory.expected(entry.Item) }
	end
	local function favorite(entry)
		if pending or not entry or not entry.Item or not entry.Item.Fish then return end
		local data = payload(entry)
		data.Locked = not entry.Locked
		send("InventoryLock", data)
	end
	local function applyState(nextState)
		if type(nextState) ~= "table" then return end
		local oldPending = state.Pending
		if nextState.BoatId ~= state.BoatId then selected, signature = nil, nil end
		state = nextState
		if state.Pending and not oldPending then
			tab, selected = "Boat", nil
			setOpen(true)
		end
		render()
	end
	send = function(action, ...)
		if pending then return end
		pending = true
		local args = table.pack(...)
		notice.Text, notice.TextColor3 = "Updating inventory…", MUTED
		render()
		task.spawn(function()
			local delay = 0.22 - (os.clock() - lastRequest)
			if delay > 0 then task.wait(delay) end
			local ok, response = pcall(request.InvokeServer, request, action, table.unpack(args, 1, args.n))
			lastRequest, pending = os.clock(), false
			if ok and type(response) == "table" then
				applyState(response.State)
				if response.Ok and (action == "Place" or action == "CancelPlace") then setOpen(false) end
				notice.Text = if response.Message ~= "" then response.Message else (if response.Ok then "Inventory updated." else "Please try again.")
				notice.TextColor3 = if response.Ok then MINT else RED
			else
				notice.Text, notice.TextColor3 = "Couldn't reach your inventory. Try again.", RED
			end
			render()
		end)
	end
	render = function()
		local owned = player:GetAttribute("OwnsAutoStore") == true
		autoStore.Text = if not owned then "Buy gamepass" elseif state.AutoStore ~= false then "ON" else "OFF"
		autoStore.TextColor3 = if owned and state.AutoStore ~= false then MINT else MUTED
		for name, control in tabs do
			control.BackgroundColor3 = if tab == name then rgb(34, 39, 44) else INK
			control.TextTransparency = if tab == name then 0 else 0.3
		end
		for name, control in sortButtons do
			control.Text = if name == "Off" then (if sortBy then "Sorting: On" else "Sorting: Off")
				else (if sortBy == name then (if ascending then "↑ " else "↓ ") else "")
					.. (if name == "Name" then "ABC order" else name)
			control.BackgroundColor3 = if sortBy == name then rgb(34, 39, 44) else INK
		end
		for name, control in viewButtons do
			control.Track.BackgroundColor3 = if view[name] then rgb(0, 184, 80) else EDGE
			control.Knob.Position = UDim2.fromOffset(if view[name] then 24 else -1, -1)
		end
		bulk.Visible = open and aboard and tab ~= "Backpack" and not state.Pending
		if not open then return end
		local entries = Inventory.entries(state, Catalog, Cargo)
		local filtered, totalWorth = Inventory.visible(entries, tab, view, searchBox.Text, sortBy, ascending)
		worth.Text = "Total worth: " .. money(totalWorth)
		local crates = player:GetAttribute("BaitCrates")
		crates = if type(crates) == "number" then crates else 0
		local query = string.lower(searchBox.Text:match("^%s*(.-)%s*$"))
		local showCrate = crates > 0 and tab ~= "Boat" and view.Items and not view.Favorites
			and string.find(string.lower(Bait.Crate.Name), query, 1, true) ~= nil
		local slots = if showCrate then 1 else 0
		if not showCrate then crateSelected = false end
		summary.Text = string.format("%d shown · %d total items", #filtered + slots, #entries + (if crates > 0 then 1 else 0))
		-- Black Hole Backpack owners carry an infinite hold over any saved pack.
		local backpack = Backpacks.layoutFor(player, state.BackpackId)
		local boat = state.BoatId and BoatCatalog[state.BoatId]
		local packTotal = Cargo.capacity(backpack.Hold)
		local packSpace = string.format("Backpack %d / %s space", Cargo.used(state.Backpack or {}, Catalog.Fish), if packTotal == math.huge then "∞" else tostring(packTotal))
		local boatSpace = if boat then string.format("Boat %d / %d space", Cargo.used(state.Items or {}, Catalog.Fish), Cargo.capacity(boat.Hold)) else "No boat launched"
		capacity.Text = if tab == "Backpack" then packSpace elseif tab == "Boat" then boatSpace else packSpace .. "    ·    " .. boatSpace
		empty.Visible = #filtered + slots == 0
		empty.Text = if tab == "Boat" and not boat then "Launch a boat to see its inventory."
			elseif view.Favorites then "No favorites match these filters.\nSelect a fish and choose Favorite."
			else "No items match these filters."
		local parts = { "crate|" .. tostring(if showCrate then crates else 0) }
		for _, entry in filtered do
			local fish = entry.Item and entry.Item.Fish
			table.insert(parts, tostring(entryId(entry)) .. "|" .. entry.Name .. "|" .. tostring(entry.Locked) .. "|"
				.. (if fish then fish.FishId .. "|" .. tostring(fish.Size) .. "|" .. tostring(fish.Kg) .. "|" .. tostring(fish.CaughtAt) .. "|" .. fish.Mutation .. "|"
					.. tostring(fish.Value) .. "|" .. tostring(fish.NeonColor) .. "|" .. table.concat(fish.Corruptions or {}, ",") else ""))
		end
		local nextSignature = table.concat(parts, ";")
		if signature ~= nextSignature then
			signature = nextSignature
			for _, card in cards do card.Button:Destroy() end
			cards = {}
			if showCrate then
				local tile = make("TextButton", list, { Name = "BaitCrateCard", Text = "", AutoButtonColor = false,
					Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(CARD, CARD_HEIGHT),
					BackgroundColor3 = INK, BorderSizePixel = 0 })
				local outline = stroke(tile, EDGE, 1)
				make("UIGradient", tile, { Rotation = 90, Color = ColorSequence.new(INK, GOLD:Lerp(HULL, 0.6)) })
				make("Frame", tile, { Position = UDim2.new(0, 0, 1, -2), Size = UDim2.new(1, 0, 0, 2),
					BackgroundColor3 = GOLD, BorderSizePixel = 0, ZIndex = 3 })
				-- A small drawn crate: wooden box with a lid band and cross slats.
				local box = make("Frame", tile, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12),
					Size = UDim2.fromOffset(40, 30), BackgroundColor3 = rgb(150, 104, 58), BorderSizePixel = 0, ZIndex = 2 })
				round(box, 3)
				stroke(box, rgb(92, 60, 30), 2)
				make("Frame", box, { Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 0, 7),
					BackgroundColor3 = rgb(116, 78, 42), BorderSizePixel = 0, ZIndex = 2 })
				for _, rotation in { 34, -34 } do
					make("Frame", box, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 3),
						Size = UDim2.fromOffset(40, 3), Rotation = rotation, BackgroundColor3 = rgb(116, 78, 42),
						BorderSizePixel = 0, ZIndex = 2 })
				end
				text(tile, Bait.Crate.Name, { Name = "FishName", Position = UDim2.fromOffset(4, 44),
					Size = UDim2.fromOffset(CARD - 8, 32), TextSize = 13, TextWrapped = true,
					TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, ZIndex = 3 })
				text(tile, "×" .. crates, { Position = UDim2.fromOffset(4, CARD_HEIGHT - 19), Size = UDim2.fromOffset(CARD - 8, 16),
					TextSize = 11, TextColor3 = CREAM, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 3 })
				table.insert(cards, { Button = tile, Outline = outline, Entry = { Source = "BaitCrate", Index = 0, Crate = true }, Y = 0 })
				tile.Activated:Connect(function() selected, crateSelected = nil, true render() end)
			end
			for position, entry in filtered do
				local index = position + slots
				local x, y = ((index - 1) % 8) * (CARD + GAP), math.floor((index - 1) / 8) * (CARD_HEIGHT + GAP)
				local fish = entry.Item and entry.Item.Fish
				local species = fish and Catalog.Fish[fish.FishId]
				local rarity = species and Catalog.Rarities[species.Rarity]
				local tint = if rarity then rarity.Color else VIOLET
				local tile = make("TextButton", list, { Name = "InventoryCard", Text = "", AutoButtonColor = false,
					Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(CARD, CARD_HEIGHT),
					BackgroundColor3 = INK, BorderSizePixel = 0 })
				local outline = stroke(tile, EDGE, 1)
				make("UIGradient", tile, { Rotation = 90, Color = ColorSequence.new(INK, tint:Lerp(HULL, 0.6)) })
				make("Frame", tile, { Position = UDim2.new(0, 0, 1, -2), Size = UDim2.new(1, 0, 0, 2),
					BackgroundColor3 = tint, BorderSizePixel = 0, ZIndex = 3 })
				-- "Corrupted Tiger Trout": each mutation word in its own colour; long
				-- stacked mutations shrink to fit the card instead of spilling out.
				local nameLabel = text(tile, fishTitle(entry), { Name = "FishName", Position = UDim2.fromOffset(4, 44),
					Size = UDim2.fromOffset(CARD - 8, 32), RichText = true, TextScaled = true,
					TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center,
					TextStrokeTransparency = 0.3, ZIndex = 3 })
				make("UITextSizeConstraint", nameLabel, { MaxTextSize = 13, MinTextSize = 7 })
				text(tile, if fish then FishCatch.formatKg(fish.Kg) else "Fitted", {
					Position = UDim2.fromOffset(4, CARD_HEIGHT - 19), Size = UDim2.fromOffset(CARD - 8, 16),
					TextSize = 11, TextColor3 = CREAM, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 3 })
				text(tile, if entry.Source == "Hand" then "IN HAND" elseif entry.Source == "Boat" then "BOAT" else "", {
					Position = UDim2.fromOffset(4, 3), Size = UDim2.fromOffset(64, 12), TextSize = 9, TextColor3 = CYAN, ZIndex = 3 })
				if entry.Locked then
					text(tile, "★", { Name = "LockIcon", Position = UDim2.fromOffset(3, 17), Size = UDim2.fromOffset(20, 20),
						TextColor3 = GOLD, TextSize = 18, ZIndex = 4 })
				end
				if fish then mutationBadge(tile, fish)
				else
					text(tile, "⚙", { Position = UDim2.fromOffset(0, 8),
						Size = UDim2.fromOffset(CARD, 46), TextSize = 32, TextColor3 = tint, TextXAlignment = Enum.TextXAlignment.Center })
				end
				table.insert(cards, { Button = tile, Outline = outline, Entry = entry, Y = y })
				tile.Activated:Connect(function() selected, crateSelected = entry, false render() end)
				tile.MouseButton2Click:Connect(function() selected, crateSelected = entry, false favorite(entry) end)
			end
			list.CanvasSize = UDim2.fromOffset(0, math.ceil((#filtered + slots) / 8) * (CARD_HEIGHT + GAP))
		end
		local nextSelected = nil
		for _, entry in filtered do
			if selected and entryId(entry) == entryId(selected) and Inventory.matches(entry.Item, Inventory.expected(selected.Item)) then
				nextSelected = entry
			end
		end
		selected = nextSelected
		for _, card in cards do
			card.Outline.Color = if (if card.Entry.Crate then crateSelected else selected and entryId(card.Entry) == entryId(selected))
				then GOLD else EDGE
		end
		local fish = selected and selected.Item and selected.Item.Fish
		local species = fish and Catalog.Fish[fish.FishId]
		local secret = species ~= nil and species.Secret == true
		local reserved = state.Pending ~= nil
		for name, control in actions do
			control.Visible = fish ~= nil and not reserved
			control.Active = not pending
			if name == "Hand" then
				control.Visible = control.Visible and selected.Source ~= "Hand"
				control.Text = if state.Hand then "Replace in hand" else "Take in hand"
			elseif name == "Backpack" then control.Visible = control.Visible and selected.Source ~= "Backpack"
			elseif name == "Boat" then control.Visible = control.Visible and selected.Source ~= "Boat" and aboard
			elseif name == "Favorite" then
				control.Visible = control.Visible and not secret
				control.Text = if selected and selected.Locked then "Unfavorite" else "Favorite"
			elseif name == "Release" then control.Visible = control.Visible and not selected.Locked
			elseif name == "Use" then
				control.Visible = control.Visible and secret
					and (selected.Source ~= "Boat" or aboard)
					and player:GetAttribute("TreasureUnlocked") ~= true
			end
		end
		fitPart.Visible, cancelPart.Visible = reserved, reserved
		openCrate.Visible = crateSelected and not reserved
		openCrate.Active = not pending
		detail.Text = if reserved then "Reserved boat fitting · confirm to use cargo space."
			elseif crateSelected then string.format("%s ×%d · %d–%d bait of one kind · bait goes to your equipment bag",
				Bait.Crate.Name, crates, Bait.Crate.MinBait, Bait.Crate.MaxBait)
			elseif fish then string.format("%s · %s · %s · %d space · %s%s", fishTitle(selected),
				FishCatch.formatKg(fish.Kg), if secret then "Priceless" else money(fish.Value),
				Cargo.space(selected.Item, Catalog.Fish), selected.Source,
				if secret then " · Secret" elseif selected.Locked then " · Favorite" else "")
			elseif selected then selected.Name .. " · Installed boat fitting"
			else (if tab == "Boat" and not aboard then "Climb aboard your boat to transfer fish." else "Select an item")
		refreshPreviews()
	end
	-- Roblox's core backpack binds the grave key as a core action, which outranks
	-- our sink, so the vanilla expanded inventory opened alongside ours. Disabling
	-- the Backpack CoreGui while ours is open closes and unbinds it; the numbered
	-- hotbar comes back on close (deferred, so the closing keypress can't reopen it).
	local coreBackpackBefore: boolean? = nil
	local function suppressCoreBackpack(suppress: boolean)
		if suppress then
			if coreBackpackBefore == nil then
				local ok, enabled = pcall(StarterGui.GetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Backpack)
				coreBackpackBefore = if ok then enabled else true
			end
			pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Backpack, false)
		elseif coreBackpackBefore ~= nil then
			local restore = coreBackpackBefore
			coreBackpackBefore = nil
			task.defer(function()
				if not open then pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Backpack, restore) end
			end)
		end
	end
	setOpen = function(value)
		if value then updateLayout() end
		open, shade.Visible = value, value
		suppressCoreBackpack(value)
		toggle.Visible = not value
		player:SetAttribute("InventoryOpen", value)
		if not value then
			searchBox:ReleaseFocus()
			for _, card in cards do card.Button:Destroy() end
			cards, signature = {}, nil
			if state.Pending and not pending then send("CancelPlace") end
		else render() end
	end
	for name, control in actions do
		control.Activated:Connect(function()
			if not selected or pending then return end
			if name == "Favorite" then
				favorite(selected)
			elseif name == "Use" then
				send("UseTreasure", payload(selected))
			else
				local data = payload(selected)
				data.Destination = name
				send("InventoryMove", data)
			end
		end)
	end
	autoStore.Activated:Connect(function()
		if player:GetAttribute("OwnsAutoStore") ~= true then
			local ok = pcall(MarketplaceService.PromptGamePassPurchase, MarketplaceService, player, Passes.AutoStore.Id)
			if not ok then notice.Text = "Couldn't open the purchase screen. Try again." end
		else send("AutoStore", state.AutoStore == false) end
	end)
	openCrate.Activated:Connect(function()
		local fishing = ReplicatedStorage:FindFirstChild("Fishing")
		local fishingRequest = fishing and fishing:FindFirstChild("Request")
		if pending or not crateSelected or not fishingRequest or player:GetAttribute("BoatDataStatus") ~= "Ready" then return end
		notice.Text, notice.TextColor3 = "Opening bait crate…", MUTED
		fishingRequest:FireServer("OpenBaitCrate")
	end)
	task.spawn(function()
		local fishingFeedback = ReplicatedStorage:WaitForChild("Fishing"):WaitForChild("Feedback") :: RemoteEvent
		fishingFeedback.OnClientEvent:Connect(function(kind, success, message)
			if kind == "BaitOpenResult" and type(message) == "string" then
				notice.Text, notice.TextColor3 = message, if success == true then MINT else RED
			end
		end)
	end)
	player:GetAttributeChangedSignal("BaitCrates"):Connect(function() render() end)
	bulk.Activated:Connect(function() send("MoveAll") end)
	fitPart.Activated:Connect(function() send("Place", 1, 1, 0) end)
	cancelPart.Activated:Connect(function() send("CancelPlace") end)
	search.Activated:Connect(function()
		searchBox.Visible = not searchBox.Visible
		summary.Size = UDim2.fromOffset(if searchBox.Visible then CONTENT - 268 else 560, 28)
		search.Position = UDim2.fromOffset(LEFT + CONTENT - (if searchBox.Visible then 48 else 108), 54)
		search.Size = UDim2.fromOffset(if searchBox.Visible then 48 else 108, 32)
		search.Text = if searchBox.Visible then "×" else "Search"
		if searchBox.Visible then searchBox:CaptureFocus() else searchBox.Text = "" searchBox:ReleaseFocus() end
	end)
	searchBox:GetPropertyChangedSignal("Text"):Connect(function() list.CanvasPosition = Vector2.zero render() end)
	list:GetPropertyChangedSignal("CanvasPosition"):Connect(refreshPreviews)
	close.Activated:Connect(function() setOpen(false) end)
	toggle.Activated:Connect(function() setOpen(not open) end)
	-- Sink the grave key before Roblox's default expanded backpack handles it;
	-- the standard numbered hotbar remains available for equipped tools.
	ContextActionService:BindActionAtPriority("ToggleInventory", function(_, inputState)
		if UserInputService:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end
		if inputState == Enum.UserInputState.Begin then setOpen(not open) end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value + 1, Enum.KeyCode.Backquote)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and open and (input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB) then
			setOpen(false)
		end
	end)
	player:GetAttributeChangedSignal("OwnsAutoStore"):Connect(function() render() end)
	player:GetAttributeChangedSignal("OwnsBlackHoleBackpack"):Connect(function() render() end)
	player:GetAttributeChangedSignal("TreasureUnlocked"):Connect(function() render() end)
	local nextCheck = 0
	RunService.Heartbeat:Connect(profiled("CargoHold", function()
		if os.clock() < nextCheck then return end
		nextCheck = os.clock() + 0.25
		local id = player:GetAttribute("ActiveBoatId")
		local boats = workspace:FindFirstChild("PlayerBoats")
		local model = if type(id) == "string" and boats then boats:FindFirstChild(id .. "_" .. player.UserId) else nil
		local now = Aboard(player.Character, model)
		if now ~= aboard then aboard = now render() elseif open then render() end
	end))
	RunService.RenderStepped:Connect(profiled("CargoHold/2", function()
		if open then updateLayout() end
	end))
	update.OnClientEvent:Connect(applyState)
	local ok, response = pcall(request.InvokeServer, request, "Get")
	if ok and type(response) == "table" then applyState(response.State) else render() end
end

return CargoHold
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="306">
          <Properties>
            <string name="Name">CastAnimation</string>
            <string name="Source"><![CDATA[-- Procedural casting and two-handed reeling for R6 and R15. Other anglers use
-- the rod's replicated CastAt/CastPhase; no uploaded assets or extra remotes.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CastAnimation = {}
-- Shoulder pitch in torso space: 0 hangs down, pi/2 holds the rod forward and
-- past pi the arm (and rod) is cocked back behind the head.
local REST, COCKED, FOLLOW = math.pi / 2, 3.3, 0.95
local HOLD_WEIGHT = 0.92
local BACKSWING, WHIP, SETTLE = 0.12, 0.16, 0.45
local started = false
local intents = {}

local function smooth(a: number): number
	return a * a * (3 - 2 * a)
end

local function windUpAngle(elapsed: number): number
	return REST + (COCKED - REST) * (1 - math.exp(-elapsed * 7))
end

local function swingAngle(elapsed: number, from: number): number?
	if elapsed < WHIP then
		return from + (FOLLOW - from) * smooth(elapsed / WHIP)
	elseif elapsed < WHIP + SETTLE then
		local a = (elapsed - WHIP) / SETTLE
		return FOLLOW + (REST - FOLLOW) * (1 - (1 - a) ^ 2)
	end
	return nil
end

function CastAnimation.windUp(tool: Tool)
	intents[tool] = { mode = "WindUp", at = os.clock() }
end

function CastAnimation.swing(tool: Tool)
	local intent = intents[tool]
	local from = if intent and intent.mode == "WindUp" then windUpAngle(os.clock() - intent.at) else COCKED
	-- Quick taps still get a backswing instead of barely moving from the hold.
	local backswing = BACKSWING * math.clamp((COCKED - from) / (COCKED - REST), 0, 1)
	intents[tool] = { mode = "Swing", at = os.clock(), from = from, backswing = backswing }
end

function CastAnimation.setReeling(tool: Tool, active: boolean)
	if active then
		intents[tool] = { mode = "Reel", at = os.clock() }
	elseif intents[tool] and intents[tool].mode == "Reel" then
		intents[tool] = nil
	end
end

function CastAnimation.pull(tool: Tool, landed: boolean)
	local intent = intents[tool]
	if intent and intent.mode == "Reel" then
		intent.pullAt = os.clock()
		intent.pullStrength = if landed then 0.42 else -0.18
	end
end

function CastAnimation.cancel(tool: Tool)
	intents[tool] = nil
end

-- Avatars using the joint upgrade swap Motor6Ds for AnimationConstraints with
-- the same names; both expose Transform, so animate whichever the rig has.
local function findJoint(character: Model, names: { string }): Instance?
	for _, name in names do
		local joint = character:FindFirstChild(name, true)
		if joint and (joint:IsA("Motor6D") or joint:IsA("AnimationConstraint")) then
			return joint
		end
	end
	return nil
end

local EXTRA_JOINTS = {
	leftShoulder = { "LeftShoulder", "Left Shoulder" },
	rightElbow = { "RightElbow" },
	leftElbow = { "LeftElbow" },
	rightWrist = { "RightWrist" },
	leftWrist = { "LeftWrist" },
	-- R15 bends at the waist; R6 has to tilt the whole torso from the root.
	waist = { "Waist" },
	root = { "RootJoint" },
}
-- R6's root also carries the legs, so its lean and twist are toned down.
local BODY_SCALE = { waist = 1, root = 0.5 }

local function restore(pose)
	if pose.joint.Parent then
		pose.joint.Transform = CFrame.identity
	end
	for _, entry in pose.extra do
		if entry.joint.Parent then
			entry.joint.Transform = CFrame.identity
		end
	end
end

local function inJointSpace(joint: any, target: CFrame): CFrame
	local rotation = CFrame.identity
	if joint:IsA("Motor6D") then
		rotation = joint.C0.Rotation
	elseif joint.Attachment0 then
		rotation = joint.Attachment0.CFrame.Rotation
	end
	return rotation:Inverse() * target * rotation
end

function CastAnimation.start()
	if started then
		return
	end
	started = true
	local poses = {}
	-- Clear our previous offsets before the Animator runs, including joints that
	-- the current animation does not key (otherwise a reel pose can accumulate).
	RunService.PreAnimation:Connect(function()
		for _, pose in poses do
			restore(pose)
		end
	end)
	RunService.PreSimulation:Connect(function(dt)
		local now, serverNow = os.clock(), workspace:GetServerTimeNow()
		local localCharacter = Players.LocalPlayer and Players.LocalPlayer.Character
		local seen = {}
		for _, tool in CollectionService:GetTagged("FishingRod") do
			local character = tool.Parent
			local humanoid = if character and character:IsA("Model")
				then character:FindFirstChildOfClass("Humanoid")
				else nil
			if not humanoid or humanoid.Health <= 0 or not character:IsDescendantOf(workspace) then
				continue
			end
			local angle: number? = nil
			local reeling, tug = false, 0
			local intent = intents[tool]
			if character == localCharacter then
				if intent and intent.mode == "WindUp" then
					angle = windUpAngle(now - intent.at)
				elseif intent and intent.mode == "Swing" then
					local elapsed = now - intent.at
					if elapsed < intent.backswing then
						angle = intent.from + (COCKED - intent.from) * smooth(elapsed / intent.backswing)
					else
						angle = swingAngle(elapsed - intent.backswing, COCKED)
					end
					if not angle then
						intents[tool] = nil
					end
				elseif intent and intent.mode == "Reel" then
					reeling = true
					local elapsed = if intent.pullAt then now - intent.pullAt else 1
					if elapsed < 0.38 then
						tug = math.sin(elapsed / 0.38 * math.pi) * intent.pullStrength
					end
				end
			else
				local castAt = tool:GetAttribute("CastAt")
				local elapsed = if type(castAt) == "number" then serverNow - castAt else -1
				if elapsed >= 0 and elapsed < BACKSWING then
					angle = REST + (COCKED - REST) * smooth(elapsed / BACKSWING)
				elseif elapsed >= BACKSWING then
					angle = swingAngle(elapsed - BACKSWING, COCKED)
				end
				reeling = tool:GetAttribute("CastPhase") == "Hooked"
			end
			local castAt = tool:GetAttribute("CastAt")
			local cycle = (if type(castAt) == "number" then serverNow - castAt else now) * math.pi * 3.6
			if reeling then
				angle = REST + 0.18 + math.sin(cycle * 0.5) * 0.08 + tug
			end
			local pose = poses[tool]
			if not pose or pose.character ~= character or not pose.joint:IsDescendantOf(character) then
				if pose then
					restore(pose)
				end
				local joint = findJoint(character, { "RightShoulder", "Right Shoulder" })
				if not joint then
					continue
				end
				pose = { character = character, joint = joint, weight = 0, angle = REST, extra = {}, nextBind = 0 }
				poses[tool] = pose
			end
			seen[tool] = true
			local blend = 1 - math.exp(-16 * math.min(dt, 0.1))
			-- R15 limbs can stream in separately from the shoulder.
			if now >= pose.nextBind then
				pose.nextBind = now + 0.5
				for key, names in EXTRA_JOINTS do
					local entry = pose.extra[key]
					if not entry or not entry.joint:IsDescendantOf(character) then
						local joint = findJoint(character, names)
						pose.extra[key] = if joint then { joint = joint, weight = 0, target = CFrame.identity } else nil
					end
				end
			end
			pose.angle = if angle then angle else pose.angle + (REST - pose.angle) * blend
			pose.weight += ((if angle then 1 else HOLD_WEIGHT) - pose.weight) * blend
			local target = inJointSpace(pose.joint, CFrame.Angles(pose.angle, 0, 0))
			-- Keep a small amount of the Animator's motion, but stop walking packs
			-- from swinging the rod arm sideways between casts.
			pose.joint.Transform = pose.joint.Transform:Lerp(target, pose.weight)
			local targets = {}
			if reeling then
				-- Brace the rod with the right hand and circle the left hand around
				-- the reel. R6 uses the shoulders; R15 also bends elbows and wrists.
				targets.leftShoulder = CFrame.Angles(1.05 + math.sin(cycle) * 0.12, -0.6, 0.45 + math.cos(cycle) * 0.1)
				targets.leftElbow = CFrame.Angles(0.95 + math.cos(cycle) * 0.25, 0, 0)
				targets.leftWrist = CFrame.Angles(math.sin(cycle) * 0.25, 0, math.cos(cycle) * 0.18)
				targets.rightElbow = CFrame.Angles(0.25 + tug * 0.5, 0, 0)
				targets.rightWrist = CFrame.Angles(-0.12, 0, 0)
			elseif angle then
				local wind = math.clamp((angle - FOLLOW) / (COCKED - FOLLOW), 0, 1)
				targets.rightElbow = CFrame.Angles(wind * 0.75, 0, 0)
				targets.rightWrist = CFrame.Angles(-wind * 0.35, 0, 0)
				-- The free hand comes up with the rod over the head, then drops away
				-- on the follow-through.
				targets.leftShoulder = CFrame.Angles(0.45 + wind * 1.35, -0.35, 0.3)
				targets.leftElbow = CFrame.Angles(0.7 + wind * 0.4, 0, 0)
				-- Lean back and turn the rod shoulder away while cocked, then drive the
				-- chest forward and round through the whip.
				local body = CFrame.Angles(-0.24 + wind * 0.44, 0.3 - wind * 0.65, 0)
				targets.waist = body
				targets.root = body
			end
			for key, entry in pose.extra do
				if not entry.joint:IsDescendantOf(character) then
					continue
				end
				local extraTarget = targets[key]
				local scale = BODY_SCALE[key]
				if extraTarget and scale and scale ~= 1 then
					extraTarget = CFrame.identity:Lerp(extraTarget, scale)
				end
				entry.target = entry.target:Lerp(extraTarget or CFrame.identity, blend)
				entry.weight += ((if extraTarget then 1 else 0) - entry.weight) * blend
				if entry.weight > 0.001 then
					entry.joint.Transform = entry.joint.Transform:Lerp(inJointSpace(entry.joint, entry.target), entry.weight)
				end
			end
		end
		for tool, pose in poses do
			if not seen[tool] then
				restore(pose)
				poses[tool] = nil
				intents[tool] = nil
			end
		end
	end)
end

return CastAnimation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="307">
          <Properties>
            <string name="Name">Casting</string>
            <string name="Source"><![CDATA[-- Hold to charge a cast, release to throw. The server owns the cast, the bite
-- and the fish; this module aims, plays the reel minigame and draws the line.
-- Every client draws every rod's bobber from the tool's replicated Cast*
-- attributes, so other anglers' lines look the same without per-frame remotes.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local CastAnimation = require(script.Parent.CastAnimation)
local FishingAudio = require(script.Parent.FishingAudio)
local Reel = require(script.Parent.ReelMinigame)
local CatchPopup = require(script.Parent.CatchPopup)
local CatchFling = require(script.Parent.CatchFling)
local FishingBobber = require(ReplicatedStorage.Shared.FishingBobber)
local CastTiming = require(ReplicatedStorage.Shared.CastTiming)
local CharacterMeter = require(script.Parent.CharacterMeter)

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end

local Casting = {}
local MIN_CAST, MAX_CAST = 10, 58
local LINE_COLOR = Color3.fromRGB(232, 234, 214)
local started = false

local function shape(name: string, class: string, size: Vector3, color: Color3, parent: Instance): Part
	local part = Instance.new(class) :: Part
	part.Name = name
	part.Size, part.Color = size, color
	part.Material = Enum.Material.SmoothPlastic
	part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery = true, false, false, false
	part.CastShadow = false
	part.Parent = parent
	return part
end

-- One floating bobber, line and splash per cast rod, local to this client.
local function newLine(tool: Tool)
	local folder = Instance.new("Folder")
	folder.Name = "CastLine"
	local bobber = shape("Bobber", "Part", Vector3.new(0.34, 0.34, 0.34), Color3.fromRGB(199, 73, 59), folder)
	bobber.Shape = Enum.PartType.Ball
	local band = shape("Band", "Part", Vector3.new(0.1, 0.35, 0.35), Color3.fromRGB(244, 235, 203), folder)
	band.Shape = Enum.PartType.Cylinder
	local stem = shape("Stem", "Part", Vector3.new(0.24, 0.05, 0.05), Color3.fromRGB(36, 42, 43), folder)
	stem.Shape = Enum.PartType.Cylinder
	local customBobber: Model? = nil
	local skin = tool:GetAttribute("BobberSkin")
	if type(skin) == "string" and skin ~= "" then
		bobber.Transparency, band.Transparency, stem.Transparency = 1, 1, 1
		customBobber = FishingBobber.build(skin)
		customBobber:ScaleTo(1.45)
		for _, part in customBobber:GetDescendants() do
			if part:IsA("BasePart") then
				part.Anchored = true
			end
		end
		customBobber.Parent = folder
	end
	local terrain = workspace.Terrain
	local from, to, splashPoint = Instance.new("Attachment"), Instance.new("Attachment"), Instance.new("Attachment")
	from.Name, to.Name, splashPoint.Name = "CastLineTip", "CastLineBobber", "CastSplash"
	from.Parent, to.Parent, splashPoint.Parent = terrain, terrain, terrain
	local beam = Instance.new("Beam")
	beam.Attachment0, beam.Attachment1 = from, to
	beam.Width0, beam.Width1 = 0.035, 0.035
	beam.Color = ColorSequence.new(LINE_COLOR)
	beam.Transparency = NumberSequence.new(0.15)
	beam.FaceCamera, beam.Segments = true, 14
	beam.Parent = folder
	local splash = Instance.new("ParticleEmitter")
	splash.Texture = "rbxasset://textures/particles/smoke_main.dds"
	splash.Color = ColorSequence.new(Color3.fromRGB(236, 246, 248))
	splash.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1.3) })
	splash.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1) })
	splash.Lifetime = NumberRange.new(0.35, 0.7)
	splash.Speed = NumberRange.new(5, 10)
	splash.SpreadAngle = Vector2.new(40, 40)
	splash.Acceleration = Vector3.new(0, -32, 0)
	splash.Rate = 0
	splash.LightEmission = 0.25
	splash.Parent = splashPoint
	folder.Parent = workspace
	return {
		tool = tool,
		folder = folder,
		bobber = bobber,
		band = band,
		stem = stem,
		customBobber = customBobber,
		from = from,
		to = to,
		splashPoint = splashPoint,
		splash = splash,
		beam = beam,
		start = nil :: Vector3?,
		late = false,
		landed = false,
		nextNibble = os.clock() + math.random() * 2 + 1,
		nibble = 0,
		nextSplash = 0,
	}
end

local function setBuiltInBobber(tool: Tool, visible: boolean)
	for _, name in { "RodBobber", "BobberBand", "BobberStem" } do
		local part = tool:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			part.LocalTransparencyModifier = if visible then 0 else 1
			for _, detail in part:GetDescendants() do
				if detail:IsA("BasePart") then
					detail.LocalTransparencyModifier = if visible then 0 else 1
				end
			end
		end
	end
	local hanging = tool:FindFirstChild("HangingLine")
	if hanging and hanging:IsA("Beam") then
		hanging.Enabled = visible
	end
end

local function destroyLine(line)
	line.folder:Destroy()
	line.from:Destroy()
	line.to:Destroy()
	line.splashPoint:Destroy()
	if line.tool.Parent then
		setBuiltInBobber(line.tool, true)
	end
end

local function updateLine(line, target: Vector3, castAt: number, phase: string, now: number)
	local tip = line.tool:FindFirstChild("RodTip", true)
	local tipPosition = if tip and tip:IsA("Attachment") then tip.WorldPosition else target
	local distance = (Vector3.new(target.X, 0, target.Z) - Vector3.new(tipPosition.X, 0, tipPosition.Z)).Magnitude
	local flight = 0.3 + distance / 55
	local progress = (workspace:GetServerTimeNow() - castAt) / flight
	local position
	if not line.start then
		-- Late arrivals (or streamed-in rods) skip straight to the floating bobber.
		line.late = progress >= 1
		line.start = if progress < 1 then tipPosition else target
	end
	if progress < 1 and not line.landed then
		local a = math.clamp(progress, 0, 1)
		position = line.start:Lerp(target, a) + Vector3.yAxis * (3 + distance * 0.25) * 4 * a * (1 - a)
	else
		if not line.landed then
			line.landed = true
			line.splashPoint.WorldPosition = target
			line.splash:Emit(14)
			if not line.late then
				FishingAudio.splash(target)
			end
		end
		local float = math.sin(now * 2.3) * 0.05
		if phase == "Hooked" then
			local jitter = Vector3.new(math.noise(now * 3, 1) * 0.6, 0, math.noise(now * 3, 7) * 0.6)
			position = target + jitter + Vector3.new(0, -0.18 + math.sin(now * 15) * 0.13, 0)
			if now >= line.nextSplash then
				line.nextSplash = now + 0.22
				line.splashPoint.WorldPosition = position
				line.splash:Emit(3)
			end
		else
			if now >= line.nextNibble then
				line.nextNibble = now + 1.4 + math.random() * 2.6
				line.nibble = now
			end
			local dip = if now - line.nibble < 0.18 then -0.14 else 0
			position = target + Vector3.new(0, 0.08 + float + dip, 0)
		end
	end
	local frame = CFrame.new(position)
	line.bobber.CFrame = frame
	line.band.CFrame = frame * CFrame.new(0, -0.03, 0) * CFrame.Angles(0, 0, math.pi / 2)
	line.stem.CFrame = frame * CFrame.new(0, 0.26, 0) * CFrame.Angles(0, 0, math.pi / 2)
	if line.customBobber then
		line.customBobber:PivotTo(frame)
	end
	-- Attachment X axes point down: slack line sags from the tip and drops into the bobber.
	local down = CFrame.fromMatrix(Vector3.zero, -Vector3.yAxis, Vector3.xAxis)
	line.from.WorldCFrame = down + tipPosition
	line.to.WorldCFrame = down + (position + Vector3.new(0, 0.38, 0))
	local slack = if phase == "Hooked" or not line.landed then 0 else math.min(distance * 0.12, 6)
	line.beam.CurveSize0, line.beam.CurveSize1 = slack, slack * 0.3
end

function Casting.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local remotes = ReplicatedStorage:WaitForChild("Catch")
	local request = remotes:WaitForChild("Request") :: RemoteEvent
	local update = remotes:WaitForChild("Update") :: RemoteEvent

	local gui = Instance.new("ScreenGui")
	gui.Name = "Catching"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 21
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.IgnoreGuiInset = false
	gui.Parent = player:WaitForChild("PlayerGui")
	local reel = Reel.new(gui)
	local popup = CatchPopup.new(gui)

	-- A slim vertical power meter follows the avatar's right side.
	local hud = Instance.new("Frame")
	hud.Name = "CastHint"
	hud.Size = UDim2.fromOffset(14, 180)
	hud.BackgroundTransparency = 1
	hud.BorderSizePixel = 0
	hud.Visible = false
	hud.Parent = gui
	local track = Instance.new("Frame")
	track.Name = "CastPower"
	track.Size = UDim2.fromScale(1, 1)
	track.BackgroundColor3 = Color3.fromRGB(23, 28, 22)
	track.BackgroundTransparency = 0.25
	track.BorderSizePixel = 0
	track.ClipsDescendants = true
	track.Parent = hud
	local outline = Instance.new("UIStroke")
	outline.Color = Color3.fromRGB(24, 34, 23)
	outline.Thickness = 1.5
	outline.Parent = track
	local power = Instance.new("Frame")
	power.Name = "Power"
	power.AnchorPoint = Vector2.new(0, 1)
	power.Position = UDim2.fromScale(0, 1)
	power.Size = UDim2.fromScale(1, 0)
	power.BackgroundColor3 = Color3.fromRGB(247, 244, 220)
	power.BackgroundTransparency = 0.05
	power.BorderSizePixel = 0
	power.Parent = track
	local perfectZone = Instance.new("Frame")
	perfectZone.Name = "PerfectZone"
	perfectZone.Size = UDim2.fromScale(1, 1 - CastTiming.PerfectThreshold)
	perfectZone.BackgroundColor3 = Color3.fromRGB(104, 220, 101)
	perfectZone.BackgroundTransparency = 0.25
	perfectZone.BorderSizePixel = 0
	perfectZone.ZIndex = 2
	perfectZone.Parent = track
	local marker = Instance.new("Frame")
	marker.Name = "PowerMarker"
	marker.AnchorPoint = Vector2.new(0, 0.5)
	marker.Size = UDim2.new(1, 0, 0, 2)
	marker.BackgroundColor3 = Color3.fromRGB(255, 255, 245)
	marker.BorderSizePixel = 0
	marker.ZIndex = 3
	marker.Parent = track
	local feedback = Instance.new("TextLabel")
	feedback.Name = "CastFeedback"
	feedback.BackgroundTransparency = 1
	feedback.AnchorPoint = Vector2.new(0, 0.5)
	feedback.Position = UDim2.new(1, 10, 0.5, 0)
	feedback.Size = UDim2.fromOffset(100, 28)
	feedback.Font = Enum.Font.GothamBold
	feedback.TextSize = 20
	feedback.TextXAlignment = Enum.TextXAlignment.Left
	feedback.TextStrokeTransparency = 0.25
	feedback.Text = ""
	feedback.Visible = false
	feedback.ZIndex = 4
	feedback.Parent = hud
	local hint = Instance.new("TextLabel")
	hint.BackgroundTransparency = 1
	hint.AnchorPoint = Vector2.new(0.5, 0)
	hint.Position = UDim2.new(0.5, 0, 1, 8)
	hint.Size = UDim2.fromOffset(170, 44)
	hint.Font = Enum.Font.GothamMedium
	hint.TextSize = 12
	hint.TextColor3 = Color3.fromRGB(240, 240, 236)
	hint.TextWrapped = true
	hint.TextStrokeTransparency = 0.35
	hint.ZIndex = 2
	hint.Parent = hud

	local phase = "Idle" -- Idle, Charging, Sent, Waiting, Fighting
	local chargeStarted = 0
	local sentAt = 0
	local rod: Tool? = nil
	local rodConnections = {}

	local noticeText, noticeUntil = "", 0
	local feedbackUntil = 0
	local perfectNotice = false
	local function setPower(strength: number, perfect: boolean)
		power.Size = UDim2.fromScale(1, strength)
		marker.Position = UDim2.fromScale(0, 1 - strength)
		power.BackgroundColor3 = if perfect then Color3.fromRGB(160, 245, 131) else Color3.fromRGB(247, 244, 220)
	end
	local function showFeedback(heldSeconds: number)
		local strength = CastTiming.strength(heldSeconds)
		local perfect = CastTiming.isPerfect(heldSeconds)
		setPower(strength, perfect)
		if perfect then
			feedback.Text = "Perfect!"
			feedback.TextColor3 = Color3.fromRGB(160, 245, 131)
		elseif strength >= 0.7 then
			feedback.Text = "Nice!"
			feedback.TextColor3 = Color3.fromRGB(167, 226, 255)
		elseif strength >= 0.4 then
			feedback.Text = "Good"
			feedback.TextColor3 = Color3.fromRGB(255, 227, 151)
		else
			feedback.Text = "Meh"
			feedback.TextColor3 = Color3.fromRGB(221, 220, 210)
		end
		feedbackUntil = os.clock() + 1.8
	end
	local function refreshHud()
		hud.Visible = rod ~= nil and phase ~= "Fighting"
		feedback.Visible = os.clock() < feedbackUntil and (phase == "Sent" or phase == "Waiting")
		track.Visible = phase == "Charging" or feedback.Visible
		hint.TextColor3 = Color3.fromRGB(240, 240, 236)
		if os.clock() < noticeUntil then
			hint.Text = noticeText
			hint.TextColor3 = if perfectNotice then Color3.fromRGB(160, 245, 131) else Color3.fromRGB(240, 240, 236)
		elseif phase == "Charging" then
			hint.Text = "Release in the green"
		elseif phase == "Sent" then
			hint.Text = "Casting…"
		elseif phase == "Waiting" then
			hint.Text = "Waiting for a bite… click to reel in"
		else
			hint.Text = if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
				then "Hold the screen to cast"
				else "Hold click to cast, release to throw"
		end
	end
	local function notice(message: string, perfect: boolean?)
		noticeText, noticeUntil = message, os.clock() + 2.5
		perfectNotice = perfect == true
		refreshHud()
		task.delay(2.6, refreshHud)
	end

	local function root(): BasePart?
		local character = player.Character
		local part = character and character:FindFirstChild("HumanoidRootPart")
		return if part and part:IsA("BasePart") then part else nil
	end

	local function findWater(strength: number): Vector3?
		local body = root()
		local camera = workspace.CurrentCamera
		if not body or not camera then
			return nil
		end
		local look = camera.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude < 0.05 then
			flat = body.CFrame.LookVector * Vector3.new(1, 0, 1)
		end
		flat = flat.Unit
		local parameters = RaycastParams.new()
		parameters.FilterType = Enum.RaycastFilterType.Exclude
		parameters.FilterDescendantsInstances = { player.Character :: Instance }
		parameters.IgnoreWater = false
		local distance = MIN_CAST + (MAX_CAST - MIN_CAST) * strength
		while distance >= 6 do
			local point = body.Position + flat * distance
			local result = workspace:Raycast(
				Vector3.new(point.X, body.Position.Y + 25, point.Z),
				Vector3.new(0, -80, 0),
				parameters
			)
			if result and result.Instance == workspace.Terrain and result.Material == Enum.Material.Water then
				local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
				if humanoid and not humanoid.Sit then
					body.CFrame = CFrame.lookAt(body.Position, body.Position + flat)
				end
				return result.Position
			end
			distance -= 4
		end
		return nil
	end
	local function fight(info)
		local fightingRod = rod
		if not fightingRod then
			return
		end
		phase = "Fighting"
		CastAnimation.setReeling(fightingRod, true)
		refreshHud()
		local noMistakes = true
		local outcome = reel:fight(info.FishId, info.Difficulty, info.Pool, info.ReelBoost, function(landed)
			if not landed then
				noMistakes = false
			end
			if rod == fightingRod and phase == "Fighting" then
				CastAnimation.pull(fightingRod, landed)
			end
		end, info.HandlingBoost)
		CastAnimation.setReeling(fightingRod, false)
		if phase == "Fighting" then
			phase = "Idle"
		end
		if outcome == "Aborted" then
			refreshHud()
			return
		end
		request:FireServer("Reel", outcome == "Landed", noMistakes)
		if outcome == "Landed" then
			reel:showMessage("REELING IT IN…", "Bringing your catch aboard.")
		else
			FishingAudio.fail()
			reel:showMessage("IT GOT AWAY", "The fish slipped the hook. Cast again!")
		end
		refreshHud()
	end

	local function press()
		if not rod then
			return
		end
		if phase == "Idle" then
			if player:GetAttribute("PlayerMenuOpen") or player:GetAttribute("RodCrateOpening") then
				return
			end
			phase, chargeStarted = "Charging", os.clock()
			noticeUntil = 0
			feedbackUntil = 0
			setPower(0, false)
			request:FireServer("Charge")
			CastAnimation.windUp(rod)
		elseif phase == "Waiting" then
			request:FireServer("Reel", false)
		elseif phase == "Fighting" then
			reel:pull()
		end
		refreshHud()
	end

	local function release()
		if phase ~= "Charging" then
			return
		end
		local heldSeconds = os.clock() - chargeStarted
		local strength = CastTiming.strength(heldSeconds)
		local target = findWater(strength)
		if not target then
			request:FireServer("CancelCharge")
			if rod then
				CastAnimation.cancel(rod)
			end
			phase = "Idle"
			refreshHud()
			notice("Aim at open water to cast.")
			return
		end
		FishingAudio.cast(strength)
		if rod then
			CastAnimation.swing(rod)
		end
		phase, sentAt = "Sent", os.clock()
		showFeedback(heldSeconds)
		request:FireServer("Cast", target, heldSeconds)
		refreshHud()
	end

	local function unbindRod()
		for _, connection in rodConnections do
			connection:Disconnect()
		end
		table.clear(rodConnections)
		if phase == "Charging" then
			request:FireServer("CancelCharge")
		end
		noticeUntil = 0
		feedbackUntil = 0
		if rod then
			CastAnimation.cancel(rod)
		end
		rod = nil
		if phase == "Fighting" then
			reel:abort()
		end
		phase = "Idle"
		refreshHud()
	end
	local function bindRod(tool: Tool)
		if rod == tool then
			return
		end
		unbindRod()
		rod = tool
		table.insert(rodConnections, tool.Activated:Connect(press))
		table.insert(rodConnections, tool.Deactivated:Connect(release))
		table.insert(rodConnections, tool.Unequipped:Connect(unbindRod))
		table.insert(
			rodConnections,
			tool.AncestryChanged:Connect(function()
				if tool.Parent ~= player.Character then
					unbindRod()
				end
			end)
		)
		refreshHud()
	end
	local function watchCharacter(character: Model)
		unbindRod()
		character.ChildAdded:Connect(function(child)
			if child:IsA("Tool") and child:GetAttribute("RodId") == "StarterRod" then
				bindRod(child)
			end
		end)
		for _, child in character:GetChildren() do
			if child:IsA("Tool") and child:GetAttribute("RodId") == "StarterRod" then
				bindRod(child)
			end
		end
	end
	player.CharacterAdded:Connect(watchCharacter)
	if player.Character then
		task.spawn(watchCharacter, player.Character)
	end

	update.OnClientEvent:Connect(function(kind, payload)
		if kind == "Cast" then
			if phase == "Sent" then
				phase = "Waiting"
			end
		elseif kind == "PerfectCast" and rod and phase == "Waiting" then
			notice(string.format("PERFECT THROW\n+%d%% LUCK", math.floor(CastTiming.PerfectLuck * 100 + 0.5)), true)
		elseif kind == "Bite" and type(payload) == "table" and rod then
			local target = rod:GetAttribute("CastTarget")
			FishingAudio.bite(if typeof(target) == "Vector3" then target else nil)
			task.spawn(fight, payload)
		elseif kind == "SecretReveal" then
			-- The server skipped the fight entirely; drop the line and play the sting.
			if rod then
				CastAnimation.setReeling(rod, false)
				CastAnimation.cancel(rod)
			end
			reel:abort()
			phase = "Idle"
			FishingAudio.secret()
		elseif kind == "Cancelled" then
			if rod then
				CastAnimation.cancel(rod)
			end
			reel:abort()
			phase = "Idle"
			if type(payload) == "string" then
				notice(payload)
			end
		elseif kind == "ReeledIn" then
			phase = "Idle"
		elseif kind == "Escaped" then
			if rod then
				CastAnimation.setReeling(rod, false)
			end
			-- Also covers a fight the server timed out or could not verify.
			if phase == "Fighting" then
				reel:abort()
				phase = "Idle"
			end
			FishingAudio.fail()
			reel:showMessage("IT GOT AWAY", "The fish slipped the hook. Cast again!")
		elseif kind == "Caught" and type(payload) == "table" then
			if not payload.Secret then
				FishingAudio.catch()
			end
			reel:dismiss()
			popup:showCatch(payload)
		elseif kind == "Fling" then
			-- Sent to everyone, for any angler's catch.
			CatchFling.fling(payload)
			return
		end
		refreshHud()
	end)
	local lines = {}
	RunService.RenderStepped:Connect(profiled("Casting", function()
		local now = os.clock()
		local onScreen = CharacterMeter.position(hud, player, 1)
		hud.Visible = rod ~= nil and phase ~= "Fighting" and onScreen
		if phase == "Charging" then
			local heldSeconds = now - chargeStarted
			local strength = CastTiming.strength(heldSeconds)
			local perfect = CastTiming.isPerfect(heldSeconds)
			setPower(strength, perfect)
			hint.Text = if perfect then "PERFECT — release!" else "Release in the green"
			hint.TextColor3 = if perfect then Color3.fromRGB(160, 245, 131) else Color3.fromRGB(240, 240, 236)
		elseif phase == "Sent" and now - sentAt > 4 then
			phase = "Idle"
			refreshHud()
		end
		if feedback.Visible then
			if now >= feedbackUntil then
				refreshHud()
			else
				local camera = workspace.CurrentCamera
				local rightEdge = hud.AbsolutePosition.X + hud.AbsoluteSize.X + 10 + feedback.AbsoluteSize.X
				local onLeft = camera ~= nil and rightEdge > camera.ViewportSize.X - 12
				feedback.AnchorPoint = Vector2.new(if onLeft then 1 else 0, 0.5)
				feedback.TextXAlignment = if onLeft then Enum.TextXAlignment.Right else Enum.TextXAlignment.Left
				feedback.Position = UDim2.new(
					if onLeft then 0 else 1,
					if onLeft then -10 else 10,
					math.clamp(marker.Position.Y.Scale, 0.08, 0.92),
					0
				)
			end
		end
		for _, tool in CollectionService:GetTagged("FishingRod") do
			local target, castAt, castPhase =
				tool:GetAttribute("CastTarget"), tool:GetAttribute("CastAt"), tool:GetAttribute("CastPhase")
			local line = lines[tool]
			local holder = tool.Parent
			local active = typeof(target) == "Vector3"
				and type(castAt) == "number"
				and holder ~= nil
				and holder:IsA("Model")
				and holder:IsDescendantOf(workspace)
			if active and not line then
				line = newLine(tool)
				lines[tool] = line
				setBuiltInBobber(tool, false)
			end
			if line then
				if active then
					updateLine(line, target, castAt, castPhase, now)
				else
					destroyLine(line)
					lines[tool] = nil
				end
			end
		end
		for tool, line in lines do
			if not tool:IsDescendantOf(game) then
				destroyLine(line)
				lines[tool] = nil
			end
		end
	end))
	refreshHud()
end

return Casting
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="308">
          <Properties>
            <string name="Name">CatchFling</string>
            <string name="Source"><![CDATA[-- Visual only: a landed catch is flung out of the water over the angler's head
-- with real physics, lands behind them, flops about and fades out. Nothing here
-- touches the real catch; each client simulates its own copy of the fish
-- (client-made parts are physically owned by that client), gone after LIFETIME.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Biomes = require(ReplicatedStorage.Shared.Biomes)
local FishModels = require(ReplicatedStorage.Shared.FishModels)

local CatchFling = {}

local LIFETIME = 7
local FADE_SECONDS = 0.7
-- Furthest out (studs) the fish leaps from, however far the cast went.
local MAX_LEAP = 18
-- The throw must clear the angler: head top above the root part, plus a small
-- gap and half the fish (it tumbles end over end).
local HEAD_ABOVE_ROOT, HEAD_CLEARANCE = 2.5, 1
-- Air time limits (s). Short air time under game gravity means a fast, flat yank.
local MIN_AIR, MAX_AIR = 0.35, 1
-- End-over-end spin on launch (rad/s).
local MIN_SPIN, MAX_SPIN = 9, 16
-- Light enough to float on water and to barely nudge anyone it touches.
local BODY_PHYSICS = PhysicalProperties.new(0.5, 0.7, 0.3, 1, 1)
local MAX_LENGTH = 12
local VIEW_DISTANCE = 300
local UP = Vector3.yAxis

-- The fish's parts are visual only (no collision, massless). One invisible box
-- body carries the mass and collides with the world; the parts are welded to it
-- once the model is in workspace (welds made outside workspace keep stale offsets).
local function build(payload): (Model?, BasePart?, number)
	local model = FishModels.create(payload.FishId, payload)
	if not model then
		return nil, nil, 0
	end
	local bounds = model:GetAttribute("BoundsSize") :: Vector3
	local longest = math.max(bounds.X, bounds.Y, bounds.Z, 0.1)
	local length = math.clamp(
		FishModels.heldLength(if type(payload.Kg) == "number" then payload.Kg else 1, payload.Size, payload.FishId),
		0.8,
		MAX_LENGTH
	)
	model:ScaleTo(length / longest)
	local box, size = model:GetBoundingBox()
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") then
			item.Anchored = true
			item.Massless = true
			item.CanCollide, item.CanQuery, item.CanTouch = false, false, false
			item:SetAttribute("SeasonExempt", true)
		end
	end
	-- Builders draw the fish head toward +X, so the box is length x height x width;
	-- a slim width lets it come to rest on its side like a real fish.
	local body = Instance.new("Part")
	body.Name = "FlingBody"
	body.Size = Vector3.new(size.X * 0.85, math.max(size.Y * 0.7, 0.25), math.max(size.Z * 0.8, 0.2))
	body.CFrame = box
	body.Transparency = 1
	body.Anchored = true
	body.CanCollide, body.CanQuery, body.CanTouch = false, false, false
	body.CustomPhysicalProperties = BODY_PHYSICS
	body.Parent = model
	model.PrimaryPart = body
	return model, body, length
end

-- Where the fish should come down behind the angler.
local function landing(model: Model, target: Vector3): Vector3
	-- Aims for decks and ground, never anyone's head.
	local ignore: { Instance } = { model }
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(ignore, player.Character)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.IgnoreWater = false
	-- Starts just above head height, so awnings and roofs overhead don't catch it.
	local hit = workspace:Raycast(target + UP * 4, -UP * 40, params)
	local water = Biomes.WaterLevel
	if not hit then
		return Vector3.new(target.X, math.max(target.Y - 3, water), target.Z)
	end
	return Vector3.new(target.X, math.max(hit.Position.Y, water), target.Z)
end

-- Fades every visible part of the fish, including skins added after the fling began.
local function fade(model: Model, originals: { [BasePart]: number }, amount: number)
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") then
			local original = originals[item]
			if original == nil then
				original = item.Transparency
				originals[item] = original
			end
			item.Transparency = original + (1 - original) * amount
		end
	end
end

local function between(low: number, high: number): number
	return low + math.random() * (high - low)
end

-- `payload` is CatchService's "Fling" broadcast: the angler's UserId, where the
-- fish was hooked, and the catch's species, weight, size and mutations.
function CatchFling.fling(payload)
	if type(payload) ~= "table" or type(payload.FishId) ~= "string" or type(payload.UserId) ~= "number" then
		return
	end
	local angler = Players:GetPlayerByUserId(payload.UserId)
	local character = angler and angler.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not character or not hrp then
		return
	end
	-- Too far away to see: skip building the model at all.
	local camera = workspace.CurrentCamera
	if camera and (camera.CFrame.Position - hrp.Position).Magnitude > VIEW_DISTANCE then
		return
	end
	local rod
	for _, child in character:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute("RodId") ~= nil then
			rod = child
			break
		end
	end
	local model, body, length = build(payload)
	if not model or not body then
		warn("[CatchFling] no model for", payload.FishId)
		return
	end

	local facing = hrp.CFrame.LookVector * Vector3.new(1, 0, 1)
	facing = if facing.Magnitude > 0.01 then facing.Unit else Vector3.zAxis
	-- Leaps out of the water along the line, at most MAX_LEAP studs out. The rod
	-- tip is the fallback.
	local tip = rod and rod:FindFirstChild("RodTip", true)
	local hooked = if typeof(payload.From) == "Vector3" and (payload.From - hrp.Position).Magnitude < 120
		then payload.From
		else nil
	local start
	if hooked then
		local out = (hooked - hrp.Position) * Vector3.new(1, 0, 1)
		local base = Vector3.new(hrp.Position.X, hooked.Y, hrp.Position.Z)
		start = if out.Magnitude > 0.1 then base + out.Unit * math.min(out.Magnitude, MAX_LEAP) else hooked
	elseif tip and tip:IsA("Attachment") then
		start = tip.WorldPosition
	else
		start = hrp.Position + facing * 3 + UP * 2.5
	end
	-- Thrown on along the line, over the angler and down behind them.
	local flat = (hrp.Position - start) * Vector3.new(1, 0, 1)
	local heading = if flat.Magnitude > 2 then flat.Unit else -facing
	local side = heading:Cross(UP)
	local behind = hrp.Position + heading * between(4.5, 6.5) + side * between(-1.5, 1.5)
	local target = landing(model, behind) + UP * body.Size.Z / 2

	-- Ballistic launch under the game's own gravity. A thrown body passes a
	-- fraction `over` of the way along at height line + g*T^2/2 * over*(1-over),
	-- so pick the air time T that just clears the angler's head; the launch
	-- velocity then follows from the target and T.
	local gravity = workspace.Gravity
	local span = ((target - start) * Vector3.new(1, 0, 1)).Magnitude
	local over = math.clamp(flat.Magnitude / math.max(span, 0.1), 0.15, 0.9)
	local lineY = start.Y + (target.Y - start.Y) * over
	local needed = hrp.Position.Y + HEAD_ABOVE_ROOT + HEAD_CLEARANCE + length / 2 - lineY
	local air = if needed > 0 then math.sqrt(2 * needed / (gravity * over * (1 - over))) else MIN_AIR
	air = math.clamp(air, MIN_AIR, MAX_AIR)
	local velocity = (target - start) / air + UP * (0.5 * gravity * air)
	-- No collisions until it is past the angler, so it can't clip them on the way.
	-- Always on well before touchdown, or it could drop through a thin deck.
	local collideAfter = math.min(over * air + 0.05, air * 0.85)

	-- Head first along the throw, then the parts weld to the body in workspace.
	model:PivotTo(CFrame.fromMatrix(start, heading, UP))
	model.Name = "CatchFling"
	model.Parent = workspace
	for _, item in model:GetDescendants() do
		-- FishMeshes' skins already weld themselves to the body's swatch.
		if item:IsA("BasePart") and item ~= body and item.Name ~= "LoftSkin" then
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1 = body, item
			weld.Parent = body
		end
	end
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") then
			item.Anchored = false
		end
	end
	body.AssemblyLinearVelocity = velocity
	local spin = between(MIN_SPIN, MAX_SPIN) * (if math.random() < 0.5 then -1 else 1)
	body.AssemblyAngularVelocity = side * spin + heading * between(-3, 3)
	print(
		string.format(
			"[CatchFling] %s flung a %s (%.0f studs out, %.2fs air)",
			angler.Name,
			payload.FishId,
			flat.Magnitude,
			air
		)
	)

	local originals = {}
	local began = os.clock()
	local nextFlop = air + between(0.2, 0.4)
	local connection
	connection = RunService.Heartbeat:Connect(function()
		local t = os.clock() - began
		if t >= LIFETIME or not model.Parent or not body.Parent then
			connection:Disconnect()
			model:Destroy()
			return
		end
		if not body.CanCollide and t >= collideAfter then
			body.CanCollide = true
		end
		-- Flops once it has come to rest on something dry: a hop off the ground
		-- with a roll over its back and a kick of the tail, weaker each time.
		local resting = body.AssemblyLinearVelocity.Magnitude < 3
		local dry = body.Position.Y > Biomes.WaterLevel + 0.3
		if t >= nextFlop and resting and dry and t < LIFETIME - 1.2 then
			local energy = math.exp(-(t - air) * 0.3)
			local mass = body.AssemblyMass
			body:ApplyImpulse((UP * between(9, 14) + side * between(-3, 3) + heading * between(-3, 3)) * mass * energy)
			body.AssemblyAngularVelocity = (
				body.CFrame.XVector * between(5, 9) * (if math.random() < 0.5 then -1 else 1) + UP * between(-5, 5)
			) * energy
			nextFlop = t + between(0.3, 0.8)
		end
		local fadeFrom = LIFETIME - FADE_SECONDS
		if t > fadeFrom then
			fade(model, originals, (t - fadeFrom) / FADE_SECONDS)
		end
	end)
end

return CatchFling
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="309">
          <Properties>
            <string name="Name">CatchPopup</string>
            <string name="Source"><![CDATA[-- The landed-catch popup: the fish pops in over a spinning burst of rays in its
-- rarity colour, bobbing and flopping while the caption slides up beneath it.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Catalog = require(ReplicatedStorage.Shared.AnglerCatalog)
local FishModels = require(ReplicatedStorage.Shared.FishModels)
local FishMutations = require(ReplicatedStorage.Shared.FishMutations)

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end

local Popup = {}
Popup.__index = Popup

local rgb = Color3.fromRGB
local WHITE = rgb(255, 255, 255)
local MUTED = rgb(200, 200, 196)
local GOLD = rgb(255, 222, 120)
local GREEN = rgb(110, 224, 130)
local STAGE = Vector2.new(300, 190)
local RAYS = 10 -- Each bar crosses the centre, so this draws twice as many rays.
local RAY_LENGTH = 340
-- CanvasGroup clips its descendants, including the burst during its pop-in overshoot.
local TOP_PADDING = 110
local HOLD_SECONDS = 4.5
local LINE_HEIGHT = 34

local function make(class: string, parent: Instance?, props: { [string]: any }): any
	local item = Instance.new(class)
	for key, value in props do
		item[key] = value
	end
	item.Parent = parent
	return item
end

local function tween(
	item: Instance,
	seconds: number,
	goal: { [string]: any },
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?
)
	local playing = TweenService:Create(
		item,
		TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		goal
	)
	playing:Play()
	return playing
end

local function hex(color: Color3): string
	return "#" .. color:ToHex()
end

local function paint(text: string, color: Color3, bold: boolean?): string
	local inner = if bold then "<b>" .. text .. "</b>" else text
	return string.format('<font color="%s">%s</font>', hex(color), inner)
end

local function formatKg(kg: number): string
	local text = string.format("%.1f", kg)
	return (string.gsub(text, "%.0$", ""))
end

local function article(name: string): string
	return if string.find(string.lower(name), "^[aeiou]") then "an" else "a"
end

function Popup.new(gui: ScreenGui)
	local self = setmetatable({}, Popup)
	self.showId = 0
	local root = make("CanvasGroup", gui, {
		Name = "CatchPopup",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -130),
		Size = UDim2.fromOffset(760, TOP_PADDING + STAGE.Y + LINE_HEIGHT * 3 + 10),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 20,
	})
	self.root = root
	self.rootScale = make("UIScale", root, {})

	local stage = make("Frame", root, {
		Name = "Stage",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(380, TOP_PADDING + STAGE.Y / 2),
		Size = UDim2.fromOffset(STAGE.X, STAGE.Y),
		BackgroundTransparency = 1,
	})
	self.stage = stage
	self.stageScale = make("UIScale", stage, { Scale = 0 })

	self.rays = {}
	for index = 1, RAYS do
		local wide = index % 2 == 0
		local ray = make("Frame", stage, {
			Name = "Ray",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(if wide then 30 else 14, if wide then RAY_LENGTH * 0.7 else RAY_LENGTH),
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
		})
		make("UIGradient", ray, {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.42, 0.35),
				NumberSequenceKeypoint.new(0.5, 0.05),
				NumberSequenceKeypoint.new(0.58, 0.35),
				NumberSequenceKeypoint.new(1, 1),
			}),
		})
		table.insert(self.rays, ray)
	end

	-- Stacked soft discs stand in for a radial glow behind the fish.
	self.glows = {}
	for _, disc in { { 170, 0.8 }, { 110, 0.62 }, { 60, 0.4 } } do
		local size = disc[1]
		local glow = make("Frame", stage, {
			Name = "Glow",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = disc[2],
			BorderSizePixel = 0,
		})
		make("UICorner", glow, { CornerRadius = UDim.new(1, 0) })
		table.insert(self.glows, { frame = glow, size = size })
	end

	self.sparkles = {}
	for _ = 1, 10 do
		local sparkle = make("Frame", stage, {
			Name = "Sparkle",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(8, 8),
			Rotation = 45,
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			Visible = false,
		})
		table.insert(self.sparkles, sparkle)
	end

	self.viewport = make("ViewportFrame", stage, {
		Name = "Fish",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(STAGE.X, STAGE.Y),
		BackgroundTransparency = 1,
	})

	self.lines = {}
	for index = 1, 3 do
		local label = make("TextLabel", root, {
			Name = "Line" .. index,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromOffset(380, TOP_PADDING + STAGE.Y + (index - 1) * LINE_HEIGHT),
			Size = UDim2.new(1, 0, 0, LINE_HEIGHT),
			BackgroundTransparency = 1,
			Font = Enum.Font.SourceSansSemibold,
			RichText = true,
			Text = "",
			TextColor3 = WHITE,
			TextScaled = true,
			TextTransparency = 1,
		})
		make("UITextSizeConstraint", label, { MaxTextSize = if index == 3 then 22 else 30 })
		local outline = make("UIStroke", label, { Thickness = 2, Color = rgb(12, 14, 24), Transparency = 1 })
		table.insert(self.lines, { label = label, stroke = outline })
	end

	RunService.RenderStepped:Connect(profiled("CatchPopup", function()
		if root.Visible then
			self:animate(os.clock() - self.shownAt)
		end
	end))
	return self
end

function Popup:animate(t: number)
	local spin = t * self.spinSpeed
	local pulse = 1 + math.sin(t * 3) * 0.06
	for index, ray in self.rays do
		ray.Rotation = spin + (index - 1) * (180 / RAYS)
		ray.BackgroundColor3 = if index % 2 == 0 then self.color else self.color:Lerp(WHITE, 0.55)
	end
	for _, glow in self.glows do
		local size = glow.size * pulse
		glow.frame.Size = UDim2.fromOffset(size, size)
		glow.frame.BackgroundColor3 = self.color:Lerp(WHITE, 0.6)
	end
	-- A quick flop on landing that settles into a lazy bob.
	local flop = math.exp(-t * 2.2)
	self.viewport.Rotation = math.sin(t * 14) * 22 * flop + math.sin(t * 2.1) * 4
	self.viewport.Position = UDim2.new(0.5, 0, 0.5, math.sin(t * 2.6) * 6 - flop * 10)
	local camera = self.camera
	if camera and camera.Parent then
		local angle = math.sin(t * 0.9) * 0.45
		camera.CFrame = CFrame.lookAt(self.focus + CFrame.Angles(0, angle, 0) * self.look * self.distance, self.focus)
	end
	for _, sparkle in self.sparkles do
		local life = (t - sparkle:GetAttribute("Delay")) / 1.1
		sparkle.Visible = life > 0 and life < 1
		if sparkle.Visible then
			local direction = sparkle:GetAttribute("Direction") :: Vector2
			local reach = 40 + 110 * (1 - (1 - life) ^ 2)
			sparkle.Position = UDim2.new(0.5, direction.X * reach, 0.5, direction.Y * reach)
			sparkle.BackgroundTransparency = life
			local size = 10 * (1 - life * 0.6)
			sparkle.Size = UDim2.fromOffset(size, size)
		end
	end
	-- The weight counts up as the caption arrives.
	if self.kg and self.kgLine then
		local shown = self.kg * math.clamp((t - 0.25) / 0.7, 0, 1) ^ 0.5
		self.lines[self.kgLine].label.Text = string.format(self.kgTemplate, formatKg(shown))
	end
end

-- `lines` is a list of rich-text captions; "%s" in the line at `kgLine` is replaced by the weight.
function Popup:show(
	fishId: string,
	traits: any?,
	lines: { string },
	color: Color3,
	rarityOrder: number,
	kg: number?,
	kgLine: number?
)
	self.showId += 1
	local current = self.showId
	local _, fishCamera = FishModels.show(self.viewport, fishId, nil, traits)
	self.camera = fishCamera
	if fishCamera then
		self.focus, self.distance = fishCamera:GetAttribute("Focus"), fishCamera:GetAttribute("Distance")
		self.look = (fishCamera.CFrame.Position - self.focus).Unit
	end
	self.color = color
	self.spinSpeed = 18 + rarityOrder * 7
	-- Lines fill from the bottom so the fish's caption always sits closest to the fish.
	local first = 4 - #lines
	self.kg, self.kgLine, self.kgTemplate = kg, kgLine and kgLine + first - 1, kgLine and lines[kgLine]
	self.shownAt = os.clock()
	for _, sparkle in self.sparkles do
		local angle = math.random() * math.pi * 2
		sparkle:SetAttribute("Direction", Vector2.new(math.cos(angle), math.sin(angle) * 0.7))
		sparkle:SetAttribute("Delay", math.random() * 0.5)
		sparkle.BackgroundColor3 = color:Lerp(WHITE, 0.5)
	end

	local root = self.root
	root.Visible = true
	root.GroupTransparency = 0
	local camera = workspace.CurrentCamera
	local fit = if camera then math.clamp((camera.ViewportSize.X - 24) / root.Size.X.Offset, 0.45, 1) else 1
	self.rootScale.Scale = fit
	self.stageScale.Scale = 0
	tween(self.stageScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	for index, line in self.lines do
		local text = lines[index - first + 1]
		local slot = UDim2.fromOffset(380, TOP_PADDING + STAGE.Y + (index - 1) * LINE_HEIGHT)
		line.label.Text = if text then string.format(text, kg and formatKg(0) or "") else ""
		line.label.TextTransparency, line.stroke.Transparency = 1, 1
		line.label.Position = slot + UDim2.fromOffset(0, 14)
		if text then
			local delay = 0.15 + (index - first) * 0.12
			task.delay(delay, function()
				if self.showId == current then
					tween(line.label, 0.3, { TextTransparency = 0, Position = slot }, Enum.EasingStyle.Back)
					tween(line.stroke, 0.3, { Transparency = 0.2 })
				end
			end)
		end
	end
	local hold = HOLD_SECONDS + rarityOrder * 0.25
	task.delay(hold, function()
		if self.showId ~= current then
			return
		end
		tween(root, 0.35, { GroupTransparency = 1 })
		tween(self.rootScale, 0.35, { Scale = fit * 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.wait(0.35)
		if self.showId == current then
			root.Visible = false
		end
	end)
end

function Popup:showCatch(payload)
	local fish = Catalog.Fish[payload.FishId]
	local rarity = fish and Catalog.Rarities[fish.Rarity]
	local color = if rarity then rarity.Color else WHITE
	if fish and fish.Secret then
		local detail = if not payload.Saved then "Your catch couldn't be saved. Please try again."
			elseif payload.StorageStored then "Kept safe on your storage rack"
			elseif payload.AutoStored then "Stored in your boat's hold"
			elseif payload.BackpackStored then "Packed into your backpack"
			elseif payload.Stored then "Added to your hotbar"
			else "Kept safe in storage"
		local hint = if payload.Saved then " · Use it in your inventory to unlock every gamepass" else ""
		local lines = {
			paint("1 IN 1,000,000", GOLD, true) .. paint("  ·  SECRET CATCH", MUTED, true),
			paint(fish.Name, color, true),
			paint("Priceless", GOLD, true) .. paint("  ·  " .. detail .. hint, MUTED),
		}
		self:show(payload.FishId, payload, lines, color, rarity and rarity.Order or 1)
		return
	end
	local mutation = FishMutations.label(payload.Mutation, payload.NeonColor)
	local name = (if mutation ~= "" then mutation .. " " else "") .. (if fish then fish.Name else payload.FishId)
	-- Mutation words keep their own colours; the species name keeps the rarity colour.
	local richMutation = FishMutations.richLabel(payload.Mutation, payload.NeonColor)
	local title = (if richMutation ~= "" then "<b>" .. richMutation .. "</b> " else "")
		.. paint(if fish then fish.Name else payload.FishId, color, true)
	local size = if payload.Size == "Huge"
		then paint("Huge ", GOLD, true)
		elseif payload.Size == "Big" then paint("Big ", GOLD, true)
		else ""
	local lead = article(if payload.Size == "Huge" or payload.Size == "Big" then payload.Size else name)
	local caption = string.format(
		"You just caught %s %s%s at %s",
		lead,
		size,
		title,
		paint("%s", MUTED, true)
	) .. "kg!"
	if type(payload.Count) == "number" then
		caption ..= " (" .. paint(string.format("×%d", payload.Count), GOLD, true) .. ")"
	end
	local lines = {}
	if payload.Count == 1 then
		table.insert(lines, paint("<i>New species discovered!</i>", GREEN, true))
	end
	table.insert(lines, caption)
	local kgLine = #lines
	local detail = if not payload.Saved
		then "Your catch couldn't be saved. Please try again."
		elseif payload.AutoStored then "Stored in your boat's hold"
		elseif payload.BackpackStored then "Packed into your backpack"
		elseif payload.Stored then "Added to your hotbar"
		else "Your hands and backpack were full, so you released it"
	table.insert(
		lines,
		paint("Worth ", MUTED) .. paint("$" .. tostring(payload.Value), GREEN, true) .. paint("  ·  " .. detail, MUTED)
	)
	self:show(payload.FishId, payload, lines, color, rarity and rarity.Order or 1, payload.Kg, kgLine)
end

return Popup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="310">
          <Properties>
            <string name="Name">CharacterMeter</string>
            <string name="Source"><![CDATA[-- Position slim screen-space meters beside the local avatar at any zoom.
local GuiService = game:GetService("GuiService")
local CharacterMeter = {}

function CharacterMeter.position(meter: Frame, player: Player, side: number): boolean
	local camera = workspace.CurrentCamera
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not camera or not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
		return false
	end
	local center, visible = camera:WorldToViewportPoint(root.Position + Vector3.new(0, 0.5, 0))
	local viewport = camera.ViewportSize
	local firstPerson = (camera.CFrame.Position - root.Position).Magnitude < 4
	if firstPerson then
		center = Vector3.new(viewport.X / 2, viewport.Y / 2, 1)
		visible = true
	end
	if not visible then
		return false
	end
	local edge = camera:WorldToViewportPoint(root.Position + camera.CFrame.RightVector * 2.7)
	local height = math.floor(math.min(180, viewport.Y * 0.28))
	local offset = if firstPerson then 76 else math.clamp(math.abs(edge.X - center.X), 64, 200)
	local margin = if side > 0 then 90 else 28
	local screenGui = meter:FindFirstAncestorOfClass("ScreenGui")
	local inset = if screenGui and not screenGui.IgnoreGuiInset then GuiService:GetGuiInset() else Vector2.zero
	meter.AnchorPoint = Vector2.new(0.5, 0.5)
	meter.Size = UDim2.fromOffset(14, height)
	meter.Position = UDim2.fromOffset(
		math.clamp(center.X + side * offset, margin, math.max(margin, viewport.X - margin)) - inset.X,
		math.clamp(center.Y, height / 2 + inset.Y + 20, math.max(height / 2 + inset.Y + 20, viewport.Y - height / 2 - 70)) - inset.Y
	)
	return true
end

return CharacterMeter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="311">
          <Properties>
            <string name="Name">CityNightLights</string>
            <string name="Source"><![CDATA[-- Lights the port city after dark. Builders tag window glass and lamp heads NightGlow (with a
-- GlowColor) and lamp lights NightLight; each also carries a GlowAt darkness between 0 and 1,
-- so windows come on one by one through dusk and go out again at dawn. A lit part becomes
-- Neon in its GlowColor; a light is simply enabled. Parts are only written when their state
-- flips, and the check runs once a second (darkness only moves during dusk and dawn).
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DayNight = require(ReplicatedStorage.Shared.DayNight)

local CityNightLights = {}

local GLOW_TAG = "NightGlow"
local LIGHT_TAG = "NightLight"
local DEFAULT_AT = 0.5

function CityNightLights.start()
	type Original = { material: Enum.Material, color: Color3 }
	local tracked: { [Instance]: boolean } = setmetatable({}, { __mode = "k" }) :: any -- instance -> currently lit
	local originals: { [BasePart]: Original } = setmetatable({}, { __mode = "k" }) :: any
	local darkness = DayNight.darkness(DayNight.clockTime())

	local function threshold(instance: Instance): number
		local at = instance:GetAttribute("GlowAt")
		return if type(at) == "number" then at else DEFAULT_AT
	end

	local function apply(instance: Instance, lit: boolean)
		if tracked[instance] == lit then
			return
		end
		tracked[instance] = lit
		if instance:IsA("Light") then
			instance.Enabled = lit
		elseif instance:IsA("BasePart") then
			local original = originals[instance]
			if lit then
				local glow = instance:GetAttribute("GlowColor")
				instance.Material = Enum.Material.Neon
				if typeof(glow) == "Color3" then
					instance.Color = glow
				end
			elseif original then
				instance.Material = original.material
				instance.Color = original.color
			end
		end
	end

	local function add(instance: Instance)
		if tracked[instance] ~= nil then
			return
		end
		if instance:IsA("BasePart") then
			if not originals[instance] then
				originals[instance] = { material = instance.Material, color = instance.Color }
			end
			-- Built unlit: only a part that should glow needs writing
			tracked[instance] = false
		end
		apply(instance, darkness >= threshold(instance))
	end

	local function remove(instance: Instance)
		tracked[instance] = nil
	end

	for _, tag in { GLOW_TAG, LIGHT_TAG } do
		CollectionService:GetInstanceAddedSignal(tag):Connect(add)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(remove)
		for _, instance in CollectionService:GetTagged(tag) do
			add(instance)
		end
	end

	task.spawn(function()
		while true do
			task.wait(1)
			local now = DayNight.darkness(DayNight.clockTime())
			if now ~= darkness then
				darkness = now
				for instance in tracked do
					if instance.Parent then
						apply(instance, darkness >= threshold(instance))
					end
				end
			end
		end
	end)
end

return CityNightLights
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="312">
          <Properties>
            <string name="Name">CoastalAmbience</string>
            <string name="Source"><![CDATA[-- Recorded coastal ambience layered over EnvironmentAudio's synthetic wash: a
-- lapping bed on open water, hull slaps close to the surface, surf where land
-- meets the sea, crickets on shore at night and gulls calling overhead by day.
-- Every asset is a Roblox-licensed ProSoundEffects recording; docs/FISCH_FEEL.md
-- explains the mix and lists spare takes. PlayerSettings routes all of it
-- through the effects mixer.
local ContentProvider = game:GetService("ContentProvider")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Biomes = require(ReplicatedStorage.Shared.Biomes)
local DayNight = require(ReplicatedStorage.Shared.DayNight)
local Weather = require(ReplicatedStorage.Shared.Weather)
local TerrainProbe = require(script.Parent.TerrainProbe)

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end

local CoastalAmbience = {}
local started = false
local SAMPLE_INTERVAL = 0.5
local FADE_RATE = 1.5
local LOOPS = {
	SeaLap = "rbxassetid://9116203162", -- Lake Lap, Fair Haven Bay, water movement
	HullLap = "rbxassetid://9113665498", -- Calm Water Lap, slowed, against side of boat
	ShoreSurf = "rbxassetid://9119676800", -- Surf, medium close, moderate air, tide rollup
	Crickets = "rbxassetid://9112762877", -- Crickets and frogs, constant, night
}
local MIX = { SeaLap = 0.24, HullLap = 0.2, ShoreSurf = 0.3, Crickets = 0.1 }
local GULLS = {
	"rbxassetid://9118858259",
	"rbxassetid://9118858279",
	"rbxassetid://9118858265",
}
local GULL_INTERVAL = NumberRange.new(9, 26)
local GULL_DISTANCE = NumberRange.new(35, 80)
local GULL_HEIGHT = NumberRange.new(12, 35)
-- Two staggered rings of terrain probes: the inner ring finds the beach you are
-- standing next to, the outer one hears the coast before you reach it.
local RINGS = { { radius = 45, weight = 1 }, { radius = 110, weight = 0.6 } }
local PROBES_PER_RING = 8

local function loop(parent: Instance, name: string): Sound
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = LOOPS[name]
	sound.Looped = true
	sound.Volume = 0
	sound:SetAttribute("AudioCategory", "Effects")
	sound.Parent = parent
	return sound
end

local function fade(sound: Sound, target: number, dt: number)
	sound.Volume += (target - sound.Volume) * (1 - math.exp(-dt * FADE_RATE))
	if target > 0.002 then
		if not sound.IsPlaying then
			-- Start each loop somewhere new so returning to a spot never replays
			-- the same opening seconds.
			sound.TimePosition = math.random() * math.max(sound.TimeLength - 1, 0)
			sound:Play()
		end
	elseif sound.Volume < 0.002 and sound.IsPlaying then
		sound.Volume = 0
		sound:Stop()
	end
end

local function between(range: NumberRange): number
	return range.Min + math.random() * (range.Max - range.Min)
end

function CoastalAmbience.start()
	if started then
		return
	end
	started = true
	local folder = Instance.new("Folder")
	folder.Name = "CoastalAmbience"
	folder.Parent = SoundService
	local loops = {}
	for name in LOOPS do
		loops[name] = loop(folder, name)
	end
	-- Gulls are positional so they wheel around the listener instead of
	-- sitting in the middle of the head.
	local gullAnchor = Instance.new("Attachment")
	gullAnchor.Name = "GullCall"
	gullAnchor.Parent = workspace.Terrain
	local gull = Instance.new("Sound")
	gull.Name = "Gull"
	gull.RollOffMode = Enum.RollOffMode.InverseTapered
	gull.RollOffMinDistance, gull.RollOffMaxDistance = 25, 240
	gull:SetAttribute("AudioCategory", "Effects")
	gull.Parent = gullAnchor
	task.spawn(function()
		local assets = {}
		for _, id in LOOPS do
			table.insert(assets, id)
		end
		for _, id in GULLS do
			table.insert(assets, id)
		end
		pcall(function()
			ContentProvider:PreloadAsync(assets)
		end)
	end)

	local probes = {}
	for index, ring in RINGS do
		for step = 0, PROBES_PER_RING - 1 do
			local angle = (step + (index - 1) * 0.5) / PROBES_PER_RING * math.pi * 2
			table.insert(probes, {
				offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * ring.radius,
				weight = ring.weight,
			})
		end
	end
	local roofParams = RaycastParams.new()
	roofParams.FilterType = Enum.RaycastFilterType.Exclude
	roofParams.IgnoreWater = true
	roofParams.RespectCanCollide = true

	-- 0..1 estimates refreshed every SAMPLE_INTERVAL.
	local land, water, overWater = 0, 0, false
	local sheltered = false
	local state: Weather.State? = nil
	local darkness = 0
	local elapsed = SAMPLE_INTERVAL
	local nextGull = os.clock() + between(GULL_INTERVAL)

	local function sample(position: Vector3)
		local exclusions = { workspace.CurrentCamera, workspace.Terrain }
		for _, other in Players:GetPlayers() do
			if other.Character then
				table.insert(exclusions, other.Character)
			end
		end
		roofParams.FilterDescendantsInstances = exclusions
		sheltered = TerrainProbe.surfaceAt(position.X, position.Z, position.Y + 0.5, position.Y + 160, true) ~= nil
			or workspace:Raycast(position, Vector3.new(0, 160, 0), roofParams) ~= nil
		local landWeight, waterWeight = 0, 0
		for _, probe in probes do
			local material, height = TerrainProbe.surfaceAt(
				position.X + probe.offset.X, position.Z + probe.offset.Z, Biomes.WaterLevel - 60, Biomes.WaterLevel + 60
			)
			if material and height then
				if material == Enum.Material.Water then
					waterWeight = math.max(waterWeight, probe.weight)
				elseif height > Biomes.WaterLevel - 1 then
					landWeight = math.max(landWeight, probe.weight)
				end
			end
		end
		land, water = landWeight, waterWeight
		local below = TerrainProbe.surfaceAt(
			position.X, position.Z, Biomes.WaterLevel - 60, Biomes.WaterLevel + 60
		)
		overWater = below == Enum.Material.Water
		local now = workspace:GetServerTimeNow()
		state = Weather.getState(now, position)
		darkness = DayNight.darkness(DayNight.clockTime(now))
	end

	RunService.Heartbeat:Connect(profiled("CoastalAmbience", function(dt: number)
		local camera = workspace.CurrentCamera
		if not camera then
			for _, sound in loops do
				fade(sound, 0, dt)
			end
			return
		end
		local position = camera.CFrame.Position
		elapsed += dt
		if elapsed >= SAMPLE_INTERVAL then
			elapsed = 0
			sample(position)
		end
		local weather = state
		if not weather then
			return
		end
		local ocean = Biomes.inOceanBounds(position)
		local height = position.Y - Biomes.WaterLevel
		local submerged = ocean and height < 0
		local exposure = if submerged then 0 elseif sheltered then 0.3 else 1
		local lake = Weather.inLake(position)
		local storm = math.max(weather.storm, math.clamp((weather.windSpeed - 6) / 46, 0, 1))
		-- Water layers fade as the camera climbs away from the surface.
		local near = math.clamp(1 - (height - 10) / 90, 0.15, 1)
		local seaWater = if ocean then (if overWater then 1 else water) else 0
		local shore = if ocean then math.min(land * 1.6, 1) * math.min(water * 1.6, 1) else 0

		fade(loops.SeaLap, MIX.SeaLap * seaWater * (1 - shore * 0.4) * near * exposure, dt)
		local hull = math.clamp(1 - (height - 8) / 14, 0, 1) * seaWater
		fade(loops.HullLap, MIX.HullLap * hull * exposure, dt)
		local surf = shore * near * (if lake then 0.45 else 1) * (1 + storm * 0.6)
		fade(loops.ShoreSurf, MIX.ShoreSurf * surf * exposure, dt)
		local crickets = darkness * math.min(land * 1.5, 1) * (1 - weather.rain * 0.7)
		fade(loops.Crickets, MIX.Crickets * crickets * (if submerged then 0 else 1), dt)

		local now = os.clock()
		if now >= nextGull then
			nextGull = now + between(GULL_INTERVAL)
			local calm = weather.rain < 0.3 and storm < 0.35
			if calm and darkness < 0.4 and land > 0 and exposure == 1 and height < 120 then
				local angle = math.random() * math.pi * 2
				local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * between(GULL_DISTANCE)
				gullAnchor.WorldPosition = position + offset + Vector3.yAxis * between(GULL_HEIGHT)
				gull.SoundId = GULLS[math.random(#GULLS)]
				gull.PlaybackSpeed = 0.9 + math.random() * 0.2
				gull.Volume = (0.25 + math.random() * 0.2) * (1 - darkness)
				gull.TimePosition = 0
				gull:Play()
			end
		end
	end))
end

return CoastalAmbience
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="313">
          <Properties>
            <string name="Name">CompanyIslands</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))
local Islands = {}
local started = false

local function make(class, parent, properties)
	local item = Instance.new(class)
	for key, value in properties do item[key] = value end
	item.Parent = parent
	return item
end

local function notice(message)
	pcall(StarterGui.SetCore, StarterGui, "SendNotification", { Title = "Company Islands", Text = message, Duration = 6 })
end

function Islands.start()
	if started then return end
	started = true
	local player = Players.LocalPlayer
	local remotes = ReplicatedStorage:WaitForChild("CompanyIslands")
	local request = remotes:WaitForChild("Request") :: RemoteFunction
	local update = remotes:WaitForChild("Update") :: RemoteEvent
	local gui = make("ScreenGui", player:WaitForChild("PlayerGui"), { Name = "CompanyIslandPurchase", ResetOnSpawn = false, DisplayOrder = 30 })
	local overlay = make("TextButton", gui, { Size = UDim2.fromScale(1, 1), Text = "", BackgroundColor3 = Color3.new(), BackgroundTransparency = 0.4, Visible = false, AutoButtonColor = false })
	local card = make("Frame", overlay, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.9, 0.85), Active = true })
	make("UISizeConstraint", card, { MaxSize = Vector2.new(530, 360) })
	Theme.window(card)
	local function label(name, text, y, height, size, color)
		local result = make("TextLabel", card, { Name = name, Text = text, BackgroundTransparency = 1, Position = UDim2.new(0, 22, y, 0), Size = UDim2.new(1, -44, height, 0), TextSize = size, TextWrapped = true, Font = Enum.Font.GothamMedium })
		Theme.text(result, color)
		return result
	end
	local heading = label("IslandName", "Company island", 0.05, 0.12, 27)
	label("Description", "A private fishing company, above the water.", 0.19, 0.08, 15, Theme.Colors.Muted)
	label("Includes", "LOWER QUAY\nLarge dock with two long piers and boat launch\n\nUPPER VILLAGE\nStorage house · kitchen house · company office", 0.3, 0.35, 16)
	local status = label("PurchaseStatus", "", 0.66, 0.12, 14, Theme.Colors.Muted)
	local buy = make("TextButton", card, { Name = "ConfirmPurchase", Position = UDim2.new(0.36, 0, 0.82, 0), Size = UDim2.new(0.59, 0, 0.12, 0), Text = "Buy island — $50,000", TextSize = 16 })
	local cancel = make("TextButton", card, { Position = UDim2.new(0.05, 0, 0.82, 0), Size = UDim2.new(0.26, 0, 0.12, 0), Text = "Close", TextSize = 16 })
	Theme.button(cancel)
	local selected, busy, generation = nil, false, 0
	local function close()
		generation += 1
		overlay.Visible = false
		player:SetAttribute("CompanyIslandScreenOpen", false)
		if GuiService.SelectedObject == buy or GuiService.SelectedObject == cancel then GuiService.SelectedObject = nil end
	end
	local function show(island)
		if player:GetAttribute("PlayerMenuOpen") or player:GetAttribute("DrydockScreenOpen") then return end
		generation += 1
		selected = island
		heading.Text = island.Name
		status.Text = island.Problem or "Includes 48 storage slots and two prep benches."
		buy.Active = island.Problem == nil and not busy
		Theme.button(buy, if buy.Active then nil else "Disabled")
		overlay.Visible = true
		player:SetAttribute("CompanyIslandScreenOpen", true)
		if UserInputService.GamepadEnabled then GuiService.SelectedObject = if buy.Active then buy else cancel end
	end
	buy.Activated:Connect(function()
		if busy or not selected or not buy.Active then return end
		busy, buy.Active = true, false
		Theme.button(buy, "Disabled")
		status.Text = "Saving your island purchase…"
		local token = generation
		local ok, result = pcall(request.InvokeServer, request, "Buy", selected.Id)
		busy = false
		local message = if ok and result then result.Message else "The purchase could not be completed. Please try again."
		if ok and result and result.Ok then
			close()
			notice(message)
		elseif generation == token and overlay.Visible then
			status.Text = message
			buy.Active = true
			Theme.button(buy)
		end
	end)
	cancel.Activated:Connect(close)
	overlay.Activated:Connect(close)
	player.CharacterRemoving:Connect(close)
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then close() end
	end)
	update.OnClientEvent:Connect(function(kind, value)
		if kind == "Inspect" then show(value) elseif kind == "Notice" then notice(value) end
	end)
end

return Islands
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="314">
          <Properties>
            <string name="Name">CrabCages</string>
            <string name="Source"><![CDATA[-- Crab cages on the client. While the hotbar cage is equipped, a ghost cage follows
-- the pointer over the water, green where it can go and red (with the reason) where
-- it can't; clicking or tapping drops it there. Placed cages' floats bob on the
-- water. CrabCageService checks and saves every drop; this module only previews.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))
local Biomes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Biomes"))
local CrabCages = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("CrabCages"))

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end

local CrabCagesClient = {}
local TOOL_ATTRIBUTE = "CrabCageTool"
local CAGE_TAG = "CrabCage"
local BASE_TAG = "PlayerBase"
local VALID = Color3.fromRGB(111, 202, 125)
local INVALID = Color3.fromRGB(238, 107, 111)
local BOB_DISTANCE = 160
local started = false

local function openWater(position: Vector3, parameters: RaycastParams): boolean
	local result = workspace:Raycast(
		Vector3.new(position.X, Biomes.WaterLevel + 12, position.Z),
		Vector3.new(0, -24, 0),
		parameters
	)
	return result ~= nil and result.Instance == workspace.Terrain and result.Material == Enum.Material.Water
end

function CrabCagesClient.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local remotes = ReplicatedStorage:WaitForChild("CrabCages")
	local request = remotes:WaitForChild("Request") :: RemoteEvent
	local update = remotes:WaitForChild("Update") :: RemoteEvent
	update.OnClientEvent:Connect(function(kind, message)
		if kind == "Notice" and type(message) == "string" then
			pcall(StarterGui.SetCore, StarterGui, "SendNotification", {
				Title = "Crab Cages",
				Text = message,
				Duration = 5,
			})
		end
	end)

	local gui = Instance.new("ScreenGui")
	gui.Name = "CrabCagePlacement"
	gui.ResetOnSpawn = false
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")
	local hint = Instance.new("TextLabel")
	hint.Name = "Hint"
	hint.AnchorPoint = Vector2.new(0.5, 1)
	hint.Position = UDim2.new(0.5, 0, 1, -118)
	hint.Size = UDim2.fromOffset(480, 26)
	hint.BackgroundTransparency = 1
	hint.TextSize = 18
	hint.TextWrapped = true
	Theme.text(hint)
	hint.Parent = gui

	local tool: Tool? = nil
	local ghost: Model? = nil
	local highlight: Highlight? = nil
	local activated: RBXScriptConnection? = nil
	local lastTouch: Vector2? = nil
	local lastSent = -math.huge

	local function myBase(): (Model?, CFrame?)
		for _, base in CollectionService:GetTagged(BASE_TAG) do
			local frame = base:GetAttribute("BoatDockFrame")
			if
				base:GetAttribute("OwnerUserId") == player.UserId
				and base:IsA("Model")
				and typeof(frame) == "CFrame"
			then
				return base, frame
			end
		end
		return nil, nil
	end

	local function pointerRay(camera: Camera): Ray
		local last = UserInputService:GetLastInputType()
		if last == Enum.UserInputType.Touch and lastTouch then
			return camera:ScreenPointToRay(lastTouch.X, lastTouch.Y)
		elseif string.sub(last.Name, 1, 7) == "Gamepad" then
			local size = camera.ViewportSize
			return camera:ViewportPointToRay(size.X / 2, size.Y / 2)
		end
		local mouse = UserInputService:GetMouseLocation()
		return camera:ViewportPointToRay(mouse.X, mouse.Y)
	end

	-- Where the pointer would drop the cage: the world spot, the cage's frame, and
	-- why it can't go there (nil when it can). Mirrors CrabCageService.place.
	local function evaluate(): (Vector3?, CFrame?, string?)
		local camera = workspace.CurrentCamera
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not camera or not tool or not root or not root:IsA("BasePart") then
			return nil, nil, nil
		end
		local base, dock = myBase()
		if not base or not dock then
			return nil, nil, "You need a dock of your own to set crab cages."
		end
		local ignore: { Instance } = { ghost :: Instance }
		for _, other in Players:GetPlayers() do
			if other.Character then
				table.insert(ignore, other.Character)
			end
		end
		local parameters = RaycastParams.new()
		parameters.FilterType = Enum.RaycastFilterType.Exclude
		parameters.FilterDescendantsInstances = ignore
		parameters.IgnoreWater = false
		local ray = pointerRay(camera)
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 400, parameters)
		if not hit or hit.Instance ~= workspace.Terrain or hit.Material ~= Enum.Material.Water then
			return nil, nil, "Point at the water by your dock."
		end
		local spot = dock:PointToObjectSpace(hit.Position)
		local x, z = CrabCages.round(spot.X), CrabCages.round(spot.Z)
		local position = dock * Vector3.new(x, 0, z)
		local waterline = tool:GetAttribute("Waterline")
		local size = tool:GetAttribute("CageSize")
		if type(waterline) ~= "number" or typeof(size) ~= "Vector3" then
			return nil, nil, nil
		end
		local frame = CFrame.new(position.X, Biomes.WaterLevel - waterline, position.Z) * dock.Rotation
		local placed = {}
		local folder = base:FindFirstChild("CrabCages")
		for _, model in if folder then folder:GetChildren() else {} do
			local cx, cz = model:GetAttribute("X"), model:GetAttribute("Z")
			if type(cx) == "number" and type(cz) == "number" then
				table.insert(placed, { X = cx, Z = cz })
			end
		end
		-- The hotbar cage only exists while one is in stock.
		local otherPlaced = {}
		local otherFolder = base:FindFirstChild("MusselNets")
		for _, model in if otherFolder then otherFolder:GetChildren() else {} do
			local cx, cz = model:GetAttribute("X"), model:GetAttribute("Z")
			if type(cx) == "number" and type(cz) == "number" then table.insert(otherPlaced, { X = cx, Z = cz }) end
		end
		local problem = CrabCages.placeProblem({ CrabCages = { Stock = 1, Placed = placed }, MusselNets = { Placed = otherPlaced } }, x, z)
		local reach = hit.Position - root.Position
		if not problem and Vector3.new(reach.X, 0, reach.Z).Magnitude > CrabCages.REACH then
			problem = "That's too far away. Walk to the edge of your pier."
		end
		if not problem then
			for _, point in CrabCages.footprint(size) do
				if not openWater(frame * point, parameters) then
					problem = "Drop it into open water, clear of the piers."
					break
				end
			end
		end
		return position, frame, problem
	end

	local function clearGhost()
		if ghost then
			ghost:Destroy()
		end
		ghost, highlight = nil, nil
	end

	-- A full-size, see-through copy of the held cage.
	local function makeGhost(from: Tool)
		clearGhost()
		local source = from:FindFirstChild("CageModel")
		if not source or not source:IsA("Model") then
			return
		end
		local copy = source:Clone()
		for _, item in copy:GetDescendants() do
			if item:IsA("WeldConstraint") then
				item:Destroy()
			elseif item:IsA("BasePart") then
				item.Anchored, item.Massless = true, false
				item.CanCollide, item.CanQuery, item.CanTouch = false, false, false
				item.CastShadow = false
				item.Transparency = math.max(item.Transparency, 0.35)
			end
		end
		-- Undo the hotbar shrink whether or not the model's scale factor replicated.
		local shrunk = from:GetAttribute("CageScale")
		copy:ScaleTo(copy:GetScale() / (if type(shrunk) == "number" and shrunk > 0 then shrunk else 1))
		copy.Name = "CrabCageGhost"
		local glow = Instance.new("Highlight")
		glow.FillTransparency, glow.OutlineTransparency = 0.6, 0.15
		glow.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		glow.Adornee = copy
		glow.Parent = copy
		ghost, highlight = copy, glow
	end

	local function verb(): string
		local last = UserInputService:GetLastInputType()
		return if last == Enum.UserInputType.Touch
			then "Tap"
			elseif string.sub(last.Name, 1, 7) == "Gamepad" then "Aim at"
			else "Click"
	end

	local function unequip()
		if activated then
			activated:Disconnect()
			activated = nil
		end
		tool = nil
		clearGhost()
		gui.Enabled = false
	end

	local function equip(held: Tool)
		unequip()
		tool = held
		makeGhost(held)
		gui.Enabled = true
		activated = held.Activated:Connect(function()
			-- Re-aim now: a tap moves the pointer just before it activates the tool.
			local position, _, problem = evaluate()
			if position and not problem and os.clock() - lastSent > 0.6 then
				lastSent = os.clock()
				request:FireServer("Place", position)
			elseif problem then
				hint.Text, hint.TextColor3 = problem, INVALID
			end
		end)
	end

	local function bindCharacter(character: Model)
		unequip()
		character.ChildAdded:Connect(function(child)
			if child:IsA("Tool") and child:GetAttribute(TOOL_ATTRIBUTE) then
				equip(child)
			end
		end)
		character.ChildRemoved:Connect(function(child)
			if child == tool then
				unequip()
			end
		end)
		for _, child in character:GetChildren() do
			if child:IsA("Tool") and child:GetAttribute(TOOL_ATTRIBUTE) then
				equip(child)
			end
		end
	end
	player.CharacterAdded:Connect(bindCharacter)
	if player.Character then
		bindCharacter(player.Character)
	end
	local function trackTouch(input: InputObject)
		if input.UserInputType == Enum.UserInputType.Touch then
			lastTouch = Vector2.new(input.Position.X, input.Position.Y)
		end
	end
	UserInputService.InputBegan:Connect(trackTouch)
	UserInputService.InputChanged:Connect(trackTouch)

	-- Where each float sat before this client first moved it. Only this client moves
	-- it, so that stays its resting pivot (a streamed-in copy starts a new entry).
	local floatRest: { [Model]: CFrame } = setmetatable({}, { __mode = "k" }) :: any
	-- Each float part's place relative to that pivot, taken when the part arrives
	-- (still where the server put it). Parts are set from these every frame rather
	-- than nudged from last frame's pose, so a part that replicates late or a
	-- rounding error can't knock one out of line with the rest.
	local partRest: { [BasePart]: CFrame } = setmetatable({}, { __mode = "k" }) :: any
	local moved: { BasePart } = {}
	local poses: { CFrame } = {}
	-- Update anchored parts before physics, as with the other floating objects,
	-- instead of moving them during rendering.
	RunService.PreSimulation:Connect(profiled("CrabCages", function()
		local camera = workspace.CurrentCamera
		-- A local clock: the synced server clock can step as it corrects itself,
		-- and nothing else needs to agree with a float's phase.
		local now = os.clock()
		table.clear(moved)
		table.clear(poses)
		-- Floats ride a gentle swell, each on its own phase.
		for _, model in CollectionService:GetTagged(CAGE_TAG) do
			local float = model:FindFirstChild("Float")
			if not float or not float:IsA("Model") or not camera then
				continue
			end
			local rest = floatRest[float]
			if not rest then
				rest = float:GetPivot()
				floatRest[float] = rest
			end
			for _, child in float:GetChildren() do
				if child:IsA("BasePart") and not partRest[child] then
					partRest[child] = rest:ToObjectSpace(child.CFrame)
				end
			end
			if (rest.Position - camera.CFrame.Position).Magnitude > BOB_DISTANCE then
				continue
			end
			local phase = rest.X * 0.37 + rest.Z * 0.61
			local lift = math.sin(now * 1.6 + phase) * 0.12
			local tilt = CFrame.Angles(math.sin(now * 1.1 + phase) * 0.07, 0, math.cos(now * 1.3 + phase) * 0.07)
			local pose = CFrame.new(rest.Position + Vector3.new(0, lift, 0)) * tilt * rest.Rotation
			for _, child in float:GetChildren() do
				local offset = if child:IsA("BasePart") then partRest[child] else nil
				if child:IsA("BasePart") and offset then
					table.insert(moved, child)
					table.insert(poses, pose * offset)
				end
			end
		end
		if #moved > 0 then
			workspace:BulkMoveTo(moved, poses, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end))
	RunService.RenderStepped:Connect(profiled("CrabCages/2", function()
		local camera = workspace.CurrentCamera
		if not tool or not ghost or not highlight then
			return
		end
		if not camera then
			ghost.Parent = nil
			return
		end
		local position, frame, problem = evaluate()
		if frame then
			ghost:PivotTo(frame)
			ghost.Parent = camera
		else
			ghost.Parent = nil
		end
		local ok = position ~= nil and problem == nil
		highlight.FillColor = if ok then VALID else INVALID
		highlight.OutlineColor = if ok then VALID else INVALID
		hint.Text = if ok then verb() .. " the water to drop your crab cage here." else problem or ""
		hint.TextColor3 = if ok then Theme.Colors.Text else INVALID
	end))
end

return CrabCagesClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="315">
          <Properties>
            <string name="Name">DrydockCamera</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local BoatCatalog = require(ReplicatedStorage.Shared.BoatCatalog)
local Freecam = require(script.Parent.Freecam)

local DrydockCamera = {}
local saved, connection = nil, nil
local display = nil

local function clearDisplay()
	if display then
		display:Destroy()
		display = nil
	end
end

function DrydockCamera.stop()
	clearDisplay()
	if connection then
		connection:Disconnect()
		connection = nil
	end
	if not saved then
		return
	end
	local camera = workspace.CurrentCamera
	if camera then
		local character = Players.LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		camera.CameraSubject = humanoid or saved.subject
		camera.CameraType = saved.kind
		camera.FieldOfView = saved.fov
		camera.CFrame = saved.frame
	end
	saved = nil
end

function DrydockCamera.show(shop: Model, launching: boolean, boatId: string?)
	clearDisplay()
	local previewAttribute = if not launching
			and boatId
			and boatId ~= "Rowboat"
		then boatId .. "PreviewFrame"
		else "PreviewOriginFrame"
	local start = shop:GetAttribute(previewAttribute)
	local railEnd = shop:GetAttribute("SlipwayTopFrame")
	local finish = shop:GetAttribute("LaunchWaterFrame")
	local boatSpec = if boatId then BoatCatalog[boatId] else nil
	local framingScale = if boatSpec then math.max(1, math.sqrt(boatSpec.Length / BoatCatalog.Rowboat.Length)) else 1
	local camera = workspace.CurrentCamera
	if not camera or typeof(start) ~= "CFrame" or typeof(railEnd) ~= "CFrame" or typeof(finish) ~= "CFrame" then
		return
	end
	if not saved then
		Freecam.stop()
		saved = {
			subject = camera.CameraSubject,
			kind = camera.CameraType,
			frame = camera.CFrame,
			fov = camera.FieldOfView,
		}
	end
	if connection then
		connection:Disconnect()
	end
	local launchStartedAt = shop:GetAttribute("LaunchStartedAt") or workspace:GetServerTimeNow()
	task.spawn(function()
		-- The shipyard can stream out while the player talks inside the hall.
		pcall(function()
			Players.LocalPlayer:RequestStreamAroundAsync(if launching then finish.Position else start.Position, 3)
		end)
	end)
	connection = RunService.RenderStepped:Connect(function()
		camera = workspace.CurrentCamera
		if not camera then
			return
		end
		if not shop.Parent then
			DrydockCamera.stop()
			return
		end
		-- The purchase hull is created only after the lift rises. Browsing uses a
		-- client-local copy so each player can inspect a different boat.
		if not launching and boatId then
			if shop:GetAttribute("LaunchingUserId") then
				clearDisplay()
			elseif not display then
				local boating = ReplicatedStorage:FindFirstChild("Boating")
				local templates = boating and boating:FindFirstChild("Previews")
				local template = templates and templates:FindFirstChild(boatId)
				if template and template:IsA("Model") then
					display = template:Clone()
					local offset = if boatId == "PatrolBoat" or boatId == "Trawler"
						then CFrame.new(0, 0, -10.5)
						else CFrame.identity
					-- Templates are built at identity; retain their root's offset.
					display:PivotTo(start * offset * template:GetPivot())
					display.Parent = workspace
				end
			end
		end
		local frame = start
		if launching then
			local time = math.max(0, workspace:GetServerTimeNow() - launchStartedAt)
			local alpha = math.clamp(time / 7, 0, 1)
			alpha = alpha * alpha * (3 - 2 * alpha)
			frame = start:Lerp(finish, alpha)
		end
		local target = frame.Position + Vector3.new(0, framingScale, 0)
		local eye = target + start:VectorToWorldSpace(Vector3.new(-24, 15, -26) * framingScale)
		local view = CFrame.lookAt(eye, target)
		-- Leave the left of the scene clear for the stat card on every aspect ratio.
		local portrait = camera.ViewportSize.X < camera.ViewportSize.Y * 1.2
		local shift = if launching
			then Vector3.zero
			else (if portrait then view.UpVector else view.RightVector) * (8 * framingScale)
		camera.CameraType = Enum.CameraType.Scriptable
		camera.FieldOfView = 50
		camera.CFrame = CFrame.lookAt(eye, target - shift)
		camera.Focus = CFrame.new(target)
	end)
end

return DrydockCamera
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="316">
          <Properties>
            <string name="Name">DrydockLift</string>
            <string name="Source"><![CDATA[-- Smooth drydock refit lift. The server only sets the cradle and hull at each end
-- of the trip and publishes the timeline on the drydock (DrydockLaunch.travel):
-- LiftRest, LiftContact, LiftFrom, LiftTo, LiftSeconds, LiftStartedAt. Every client
-- moves both anchored models locally each render frame on the shared server clock,
-- so they rise together without replication steps, and the seated owner (welded to
-- the hull) rides along. When a trip ends the server's own end pose matches ours.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local DOCK_TAG = "RefitDock"

local DrydockLift = {}
local started = false

local function smooth(alpha: number): number
	return alpha * alpha * (3 - 2 * alpha)
end

local function hullOf(dock: Instance): Model?
	local userId = dock:GetAttribute("LiftingUserId")
	local boats = workspace:FindFirstChild("PlayerBoats")
	if type(userId) ~= "number" or not boats then
		return nil
	end
	for _, model in boats:GetChildren() do
		if
			model:IsA("Model")
			and model:GetAttribute("OwnerUserId") == userId
			and typeof(model:GetAttribute("HoistPivot")) == "CFrame"
		then
			return model
		end
	end
	return nil
end

function DrydockLift.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local cast = RaycastParams.new()
	cast.FilterType = Enum.RaycastFilterType.Include
	-- The trip each dock last finished drawing, so a resting lift is not rewritten.
	local finished: { [Instance]: number } = setmetatable({}, { __mode = "k" }) :: any

	RunService:BindToRenderStep("DrydockLift", Enum.RenderPriority.Camera.Value - 1, function()
		local now = workspace:GetServerTimeNow()
		for _, dock in CollectionService:GetTagged(DOCK_TAG) do
			local startedAt, seconds = dock:GetAttribute("LiftStartedAt"), dock:GetAttribute("LiftSeconds")
			local from, to = dock:GetAttribute("LiftFrom"), dock:GetAttribute("LiftTo")
			local rest, contact = dock:GetAttribute("LiftRest"), dock:GetAttribute("LiftContact")
			if
				type(startedAt) ~= "number"
				or type(seconds) ~= "number"
				or type(from) ~= "number"
				or type(to) ~= "number"
				or typeof(rest) ~= "CFrame"
				or type(contact) ~= "number"
				or finished[dock] == startedAt
			then
				continue
			end
			local alpha = if seconds > 0 then math.clamp((now - startedAt) / seconds, 0, 1) else 1
			local rise = from + (to - from) * smooth(alpha)
			local cradle = dock:FindFirstChild("LaunchCradle", true)
			if cradle and cradle:IsA("Model") then
				cradle:PivotTo(rest + Vector3.new(0, rise, 0))
			end
			local hull = hullOf(dock)
			if hull then
				local base = hull:GetAttribute("HoistPivot") :: CFrame
				local target = base + Vector3.new(0, math.max(0, rise - contact), 0)
				local delta = target.Position.Y - hull:GetPivot().Position.Y
				-- A seated character is welded to the hull and follows it; carry
				-- someone standing on deck so they neither sink in nor hop down.
				local character = player.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if humanoid and root and root:IsA("BasePart") and not humanoid.SeatPart and delta ~= 0 then
					cast.FilterDescendantsInstances = { hull }
					local below = humanoid.HipHeight + root.Size.Y / 2 + 1.5
					if workspace:Raycast(root.Position, Vector3.new(0, -below, 0), cast) then
						root.CFrame += Vector3.new(0, delta, 0)
					end
				end
				hull:PivotTo(target)
			end
			if alpha >= 1 then
				finished[dock] = startedAt
			end
		end
	end)
end

return DrydockLift
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="317">
          <Properties>
            <string name="Name">EditableMeshBudget</string>
            <string name="Source"><![CDATA[-- Shared by optional client visuals. A failed allocation means this device has
-- no room (or API access); don't ask Roblox again for every new fish species.
local AssetService = game:GetService("AssetService")

local EditableMeshBudget = {}
local unavailable = false
local failureReason: string? = nil

function EditableMeshBudget.failureReason(): string?
	return failureReason
end

function EditableMeshBudget.create(): EditableMesh?
	if unavailable then
		return nil
	end
	local ok, mesh = pcall(function()
		return AssetService:CreateEditableMesh()
	end)
	if not ok or not mesh then
		unavailable = true
		failureReason = "CreateEditableMesh: " .. (if ok then "returned nil (mesh budget or API access unavailable)" else tostring(mesh))
		return nil
	end
	return mesh
end

-- Fish geometry never changes after construction. Keep only the smaller fixed
-- copy; the temporary dynamic mesh must be released even if copying fails.
function EditableMeshBudget.fixed(mesh: EditableMesh): EditableMesh?
	if unavailable then
		mesh:Destroy()
		return nil
	end
	local ok, fixed = pcall(function()
		return AssetService:CreateEditableMeshAsync(Content.fromObject(mesh), { FixedSize = true })
	end)
	mesh:Destroy()
	if not ok or not fixed then
		unavailable = true
		failureReason = "CreateEditableMeshAsync (fixed-size copy): " .. (if ok then "returned nil (mesh budget or API access unavailable)" else tostring(fixed))
		return nil
	end
	return fixed
end

return EditableMeshBudget
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="318">
          <Properties>
            <string name="Name">EnvironmentAudio</string>
            <string name="Source"><![CDATA[-- Camera-local ambience and positional player splashes. PlayerSettings routes
-- every sound through the effects mixer, including sounds created after spawn.
local ContentProvider = game:GetService("ContentProvider")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Biomes = require(ReplicatedStorage.Shared.Biomes)
local Weather = require(ReplicatedStorage.Shared.Weather)
local TerrainProbe = require(script.Parent.TerrainProbe)

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end

local EnvironmentAudio = {}
local started = false
local SAMPLE_INTERVAL = 0.4
local SPLASH_DURATION = 0.55
local SPLASH_FADE = 0.15
local SPLASH_DRY_TIME = 0.25
-- Roblox's bundled character audio needs no uploaded/private audio permissions.
local WIND = "rbxasset://sounds/action_falling.mp3"
local SPLASH = "rbxasset://sounds/impact_water.mp3"
local SWIM = "rbxasset://sounds/action_swim.mp3"
local WATER_PROBES = {
	Vector3.zero,
	Vector3.new(32, 0, 0),
	Vector3.new(-32, 0, 0),
	Vector3.new(0, 0, 32),
	Vector3.new(0, 0, -32),
	Vector3.new(80, 0, 0),
	Vector3.new(-80, 0, 0),
	Vector3.new(0, 0, 80),
	Vector3.new(0, 0, -80),
	Vector3.new(56, 0, 56),
	Vector3.new(-56, 0, 56),
	Vector3.new(56, 0, -56),
	Vector3.new(-56, 0, -56),
}

local function sound(parent: Instance, name: string, id: string, looped: boolean): Sound
	local result = Instance.new("Sound")
	result.Name = name
	result.SoundId = id
	result.Looped = looped
	result.Volume = 0
	result:SetAttribute("AudioCategory", "Effects")
	result.Parent = parent
	return result
end

local function fade(loop: Sound, target: number, dt: number)
	loop.Volume += (target - loop.Volume) * (1 - math.exp(-dt * 3))
	if target > 0.001 then
		if not loop.IsPlaying then
			loop:Play()
		end
	elseif loop.Volume < 0.001 then
		loop.Volume = 0
		if loop.IsPlaying then
			loop:Stop()
		end
	end
end

local function inOcean(position: Vector3): boolean
	return Biomes.inOceanBounds(position)
		and position.Y > Biomes.SeaFloor
end

function EnvironmentAudio.start()
	if started then
		return
	end
	started = true
	local ambience = Instance.new("Folder")
	ambience.Name = "EnvironmentAudio"
	ambience.Parent = SoundService
	-- Filter continuous noise for a gentle sea wash; a looped splash recording
	-- repeats a distinct impact everywhere the camera can hear the ocean.
	local waves = sound(ambience, "OceanWaves", WIND, true)
	waves.PlaybackSpeed = 0.65
	local surfFilter = Instance.new("EqualizerSoundEffect")
	surfFilter.LowGain, surfFilter.MidGain, surfFilter.HighGain = 0, -12, -28
	surfFilter.Parent = waves
	local wind = sound(ambience, "CoastalWind", WIND, true)
	wind.PlaybackSpeed = 0.85
	-- A continuous filtered rumble avoids repeating the surf clip's splash impact.
	local underwater = sound(ambience, "UnderwaterWash", WIND, true)
	underwater.PlaybackSpeed = 0.7
	local muffled = Instance.new("EqualizerSoundEffect")
	muffled.LowGain, muffled.MidGain, muffled.HighGain = 2, -18, -40
	muffled.Parent = underwater
	-- Preload asynchronously so the loading screen never waits on audio delivery.
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync({ WIND, SPLASH, SWIM })
		end)
	end)

	local roofParams = RaycastParams.new()
	roofParams.FilterType = Enum.RaycastFilterType.Exclude
	roofParams.IgnoreWater = true
	roofParams.RespectCanCollide = true
	local elapsed = SAMPLE_INTERVAL
	local waterNear = 0
	local sheltered = false
	local submerged = false
	local lastCamera: Camera? = nil
	local lastPosition: Vector3? = nil

	-- Voxel shoreline probes still find water beneath docks and boats.
	-- Keep this bounded and independent of the number of streamed shore parts.
	RunService.Heartbeat:Connect(profiled("EnvironmentAudio", function(dt: number)
		local camera = workspace.CurrentCamera
		if not camera then
			for _, loop in { waves, wind, underwater } do
				loop.Volume = 0
				loop:Stop()
			end
			lastCamera = nil
			return
		end
		local position = camera.CFrame.Position
		local ocean = inOcean(position)
		submerged = ocean and position.Y < Biomes.WaterLevel + (if submerged then 0.15 else -0.15)
		elapsed += dt
		if camera ~= lastCamera or (lastPosition and (position - lastPosition).Magnitude > 24) then
			elapsed = SAMPLE_INTERVAL
		end
		if elapsed >= SAMPLE_INTERVAL then
			elapsed = 0
			lastCamera, lastPosition = camera, position
			local exclusions = { camera, workspace.Terrain }
			for _, other in Players:GetPlayers() do
				if other.Character then
					table.insert(exclusions, other.Character)
				end
			end
			roofParams.FilterDescendantsInstances = exclusions
			sheltered = TerrainProbe.surfaceAt(position.X, position.Z, position.Y + 0.5, position.Y + 160, true) ~= nil
				or workspace:Raycast(position, Vector3.new(0, 160, 0), roofParams) ~= nil
			waterNear = 0
			if ocean then
				for _, offset in WATER_PROBES do
					local x, z = position.X + offset.X, position.Z + offset.Z
					local material, height = TerrainProbe.surfaceAt(x, z, Biomes.WaterLevel - 8, Biomes.WaterLevel + 8)
					if material == Enum.Material.Water and height then
						local distance = (position - Vector3.new(x, height, z)).Magnitude
						waterNear = math.max(waterNear, math.clamp(1 - distance / 130, 0, 1))
					end
				end
			end
		end
		local now = workspace:GetServerTimeNow()
		local state = Weather.getState(now, position)
		local strength = math.clamp((state.windSpeed - 6) / 46, 0, 1)
		local exposure = if submerged then 0.025 elseif sheltered then 0.22 else 1
		local lake = Weather.inLake(position)
		local gust = 0.88 + math.sin(now * 0.31) * 0.08 + math.sin(now * 0.73) * 0.04
		local waveVolume = waterNear * (if lake then 0.22 else 0.34) * (1 + strength * 0.65)
		local windVolume = (0.14 + strength * 0.46) * gust * (if lake then 0.8 else 1)
		fade(waves, waveVolume * exposure, dt)
		fade(wind, windVolume * exposure * (if ocean then 1 else 0), dt)
		fade(underwater, if submerged then 0.12 else 0, dt)
	end))

	-- The default controller rewrites swimming volume every frame and makes
	-- ordinary jump splashes nearly inaudible. Own the two water cues, using the
	-- same bundled audio, and silence their defaults so the controllers cannot
	-- fight over volume or play a second splash.
	local characters = {}
	local function remove(character: Model)
		local record = characters[character]
		if record then
			for _, item in record.owned do
				item:Destroy()
			end
			for cue, id in record.muted do
				if cue.Parent and cue.SoundId == "" then
					cue.SoundId = id
				end
			end
			characters[character] = nil
		end
	end
	local function add(character: Model)
		if characters[character] then
			return
		end
		characters[character] = {
			owned = {},
			muted = {},
			initialized = false,
			wet = false,
			lastSplash = -math.huge,
			lastDown = 0,
			splashVolume = 0,
			splashArmed = true,
			dryTime = 0,
		}
	end
	local function watch(other: Player)
		other.CharacterAdded:Connect(add)
		other.CharacterRemoving:Connect(remove)
		if other.Character then
			add(other.Character)
		end
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(function(other)
		if other.Character then
			remove(other.Character)
		end
	end)
	for _, other in Players:GetPlayers() do
		watch(other)
	end
	RunService.Heartbeat:Connect(profiled("EnvironmentAudio/2", function(dt: number)
		local now = os.clock()
		local camera = workspace.CurrentCamera
		for character, record in characters do
			local root = character:FindFirstChild("HumanoidRootPart")
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if not root or not root:IsA("BasePart") or not humanoid then
				continue
			end
			-- Default character sounds can arrive after the streamed root part.
			for name, id in { Splash = SPLASH, Swimming = SWIM } do
				local existing = root:FindFirstChild(name)
				local current = record[name]
				if existing and existing:IsA("Sound") then
					if record.muted[existing] == nil then
						record.muted[existing] = existing.SoundId
						existing.SoundId = ""
					end
				end
				if not current or current.Parent ~= root then
					current = sound(root, "Water" .. name, id, name == "Swimming")
					current.RollOffMode = Enum.RollOffMode.InverseTapered
					current.RollOffMinDistance, current.RollOffMaxDistance = 12, 100
					table.insert(record.owned, current)
					record[name] = current
				end
			end
			local position = root.Position
			local velocity = root.AssemblyLinearVelocity
			local swimming = humanoid:GetState() == Enum.HumanoidStateType.Swimming
			local alive = humanoid.Health > 0
			-- Let Terrain/Humanoid confirm contact instead of assuming everything
			-- below sea level is water (boat cabins and dry floors can be there).
			local stillSubmerged = record.wet
				and position.Y < Biomes.WaterLevel - 0.2
				and humanoid.FloorMaterial == Enum.Material.Air
			local wet = alive and humanoid.SeatPart == nil and inOcean(position) and (swimming or stillSubmerged)
			local near = camera ~= nil and (camera.CFrame.Position - position).Magnitude < 110
			if record.initialized and wet and record.splashArmed and near and now - record.lastSplash > 0.65 then
				local impact = math.clamp(math.max(record.lastDown, -velocity.Y) / 65, 0, 1)
				record.splashVolume = 0.5 + impact * 0.5
				record.Splash.Volume = record.splashVolume
				record.Splash.PlaybackSpeed = 1.08 - impact * 0.2
				record.Splash.TimePosition = 0
				record.Splash:Play()
				record.lastSplash = now
			end
			-- Humanoid state flicker and bobbing at the surface must not rearm a plunge.
			local clearOfWater = position.Y > Biomes.WaterLevel + 1.5 or humanoid.FloorMaterial ~= Enum.Material.Air
			if not wet and alive and humanoid.SeatPart == nil and clearOfWater then
				record.dryTime += dt
				if record.dryTime >= SPLASH_DRY_TIME then
					record.splashArmed = true
				end
			else
				record.dryTime = 0
				if wet then
					record.splashArmed = false
				end
			end
			if record.Splash.IsPlaying then
				local age = now - record.lastSplash
				record.Splash.Volume = record.splashVolume * math.clamp((SPLASH_DURATION - age) / SPLASH_FADE, 0, 1)
				if age >= SPLASH_DURATION then
					record.Splash:Stop()
				end
			end
			local speed = velocity.Magnitude
			local moving = wet and swimming and near and (speed > 1 or humanoid.MoveDirection.Magnitude > 0.05)
			record.Swimming.PlaybackSpeed = 1.15 + math.clamp(speed / 20, 0, 0.5)
			fade(record.Swimming, if moving then 0.22 + math.clamp(speed / 32, 0, 0.3) else 0, dt)
			record.wet, record.initialized, record.lastDown = wet, true, math.max(0, -velocity.Y)
		end
	end))
end

return EnvironmentAudio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="319">
          <Properties>
            <string name="Name">EquipmentBag</string>
            <string name="Source"><![CDATA[-- Collection presentation only. Equipping still goes through FishingService.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Catalog = require(ReplicatedStorage.Shared.AnglerCatalog)
local BoatCatalog = require(ReplicatedStorage.Shared.BoatCatalog)
local FishingRod = require(ReplicatedStorage.Shared.FishingRod)
local RodSkins = require(ReplicatedStorage.Shared.RodSkins)
local SpearSkins = require(ReplicatedStorage.Shared.SpearSkins)
local Spears = require(ReplicatedStorage.Shared.Spears)
local BobberSkins = require(ReplicatedStorage.Shared.BobberSkins)
local FishingBobber = require(ReplicatedStorage.Shared.FishingBobber)
local Bait = require(ReplicatedStorage.Shared.Bait)

local Bag = {}
local white = Color3.fromRGB(245, 245, 245)
local grey = Color3.fromRGB(170, 173, 175)
local mint = Color3.fromRGB(155, 255, 190)
local edge = Color3.fromRGB(73, 79, 82)
local state = { Category = "Baits", RodQuery = "", ItemQuery = "", Reverse = false, Compact = false, Favorites = {} }

-- Use native square, lightly outlined surfaces instead of the shared metal finish.
local function make(class, parent, props)
	local item = Instance.new(class)
	if item:IsA("GuiObject") then
		item.BorderSizePixel = 0
		item.BackgroundTransparency = 1
	end
	for key, value in props do
		item[key] = value
	end
	item.Parent = parent
	return item
end

local function outline(item, color, thickness)
	local border = item:FindFirstChildOfClass("UIStroke") or make("UIStroke", item, {})
	for key, value in
		{
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Color = color or edge,
			Thickness = thickness or 1,
			Transparency = 0.2,
		}
	do
		border[key] = value
	end
	return border
end

local function panel(parent, name, position, size)
	local item = make("Frame", parent, {
		Name = name,
		Position = position,
		Size = size,
		BackgroundColor3 = Color3.fromRGB(5, 9, 10),
		BackgroundTransparency = 0.22,
	})
	outline(item)
	return item
end

local function label(parent, value, size, props)
	local item = make("TextLabel", parent, {
		Text = value,
		TextSize = size,
		Font = Enum.Font.SourceSansBold,
		RichText = true,
		TextColor3 = white,
		TextStrokeColor3 = Color3.new(),
		TextStrokeTransparency = 0.25,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	})
	for key, value in props do
		item[key] = value
	end
	return item
end

local function action(parent, name, value, position, size, callback, selected)
	local item = make("TextButton", parent, {
		Name = name,
		Text = value,
		Position = position,
		Size = size,
		Font = Enum.Font.SourceSans,
		TextSize = 21,
		TextColor3 = if selected then mint else white,
		TextStrokeTransparency = 0.7,
		BackgroundColor3 = Color3.fromRGB(13, 17, 17),
		BackgroundTransparency = 0.35,
		AutoButtonColor = true,
	})
	outline(item, if selected then mint else grey)
	item.Activated:Connect(callback)
	return item
end

local function search(parent, name, placeholder, value, position, size)
	local item = make("TextBox", parent, {
		Name = name,
		Text = value,
		PlaceholderText = placeholder,
		ClearTextOnFocus = false,
		Position = position,
		Size = size,
		Font = Enum.Font.SourceSans,
		TextSize = 20,
		TextColor3 = white,
		PlaceholderColor3 = Color3.fromRGB(125, 128, 128),
		TextXAlignment = Enum.TextXAlignment.Right,
		BackgroundColor3 = Color3.new(),
		BackgroundTransparency = 0.45,
	})
	outline(item)
	make("UIPadding", item, { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) })
	return item
end

local function scrolling(parent, name, position, size, horizontal)
	local body = make("ScrollingFrame", parent, {
		Name = name,
		Position = position,
		Size = size,
		CanvasSize = UDim2.fromOffset(0, 0),
		AutomaticCanvasSize = if horizontal then Enum.AutomaticSize.X else Enum.AutomaticSize.Y,
		ScrollingDirection = if horizontal then Enum.ScrollingDirection.X else Enum.ScrollingDirection.Y,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = grey,
		ScrollBarImageTransparency = 0.4,
		ClipsDescendants = true,
	})
	make("UIListLayout", body, {
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
	})
	return body
end

local function rodPreview(parent, skinId, wear)
	local view = make("ViewportFrame", parent, {
		Name = "RodPreview",
		Position = UDim2.fromScale(0.04, 0.02),
		Size = UDim2.fromScale(0.92, 0.85),
		Ambient = Color3.fromRGB(165, 170, 175),
		LightColor = Color3.fromRGB(255, 241, 216),
		LightDirection = Vector3.new(-1, -1, -2),
	})
	local world = make("WorldModel", view, { Name = "PreviewWorld" })
	local rod = FishingRod.build(skinId, nil, wear)
	-- Preview tools must never join the live rod animation/tag listeners.
	CollectionService:RemoveTag(rod, "FishingRod")
	rod.Enabled = false
	for _, part in rod:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
		end
	end
	local model = make("Model", world, { Name = "DisplayRod" })
	rod.Parent = model
	local center, size = model:GetBoundingBox()
	-- Tilt the real rod from lower left to upper right, as in the collection reference.
	model:PivotTo(CFrame.Angles(0, math.rad(-18), math.rad(-13)) * center:Inverse() * model:GetPivot())
	local camera = make("Camera", view, { FieldOfView = 36 })
	local function framePreview()
		local aspect = math.max(0.15, view.AbsoluteSize.X / math.max(1, view.AbsoluteSize.Y))
		local height = size.Y + size.X * 0.25
		local width = size.X + size.Y * 0.25
		local distance = math.max(height, width / aspect) * 0.56 / math.tan(math.rad(18))
		camera.CFrame = CFrame.lookAt(Vector3.new(0, 0, distance), Vector3.new(0, 0, 0))
	end
	view.CurrentCamera = camera
	view:GetPropertyChangedSignal("AbsoluteSize"):Connect(framePreview)
	framePreview()
end

local function bobberPreview(parent, skinId)
	local view = make("ViewportFrame", parent, {
		Name = "BobberPreview",
		Position = UDim2.fromOffset(6, 4),
		Size = UDim2.new(1, -12, 0, 66),
		Ambient = Color3.fromRGB(165, 170, 175),
		LightColor = Color3.fromRGB(255, 241, 216),
		LightDirection = Vector3.new(-1, -1, -2),
	})
	local world = make("WorldModel", view, {})
	local model = FishingBobber.build(skinId)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
		end
	end
	model.Parent = world
	local center, size = model:GetBoundingBox()
	local camera = make("Camera", view, { FieldOfView = 32 })
	view.CurrentCamera = camera
	local function fit()
		local aspect = math.max(0.3, view.AbsoluteSize.X / math.max(1, view.AbsoluteSize.Y))
		local distance = math.max(size.Y, size.X / aspect) * 0.65 / math.tan(math.rad(16))
		camera.CFrame = CFrame.lookAt(center.Position + Vector3.new(0, 0.08, distance), center.Position)
	end
	view:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	fit()
end

local function spearPreview(parent, skinId, wear)
	local view = make("ViewportFrame", parent, {
		Name = "SpearPreview", Position = UDim2.fromOffset(6, 4), Size = UDim2.new(1, -12, 0, 82),
		Ambient = Color3.fromRGB(165, 170, 175), LightColor = Color3.fromRGB(255, 241, 216),
		LightDirection = Vector3.new(-1, -1, -2),
	})
	local world = make("WorldModel", view, {})
	local model = make("Model", world, {})
	local spear = Spears.build(skinId, wear)
	for _, part in spear:GetDescendants() do
		if part:IsA("BasePart") then part.Anchored = true end
	end
	spear.Parent = model
	local center, size = model:GetBoundingBox()
	model:PivotTo(CFrame.Angles(0, math.rad(-12), math.rad(-75)) * center:Inverse() * model:GetPivot())
	local camera = make("Camera", view, { FieldOfView = 30 })
	view.CurrentCamera = camera
	local function fit()
		local aspect = math.max(0.3, view.AbsoluteSize.X / math.max(1, view.AbsoluteSize.Y))
		local distance = math.max(size.Y * 0.65 / aspect, size.Z) / math.tan(math.rad(15))
		camera.CFrame = CFrame.lookAt(Vector3.new(0, 0, distance), Vector3.zero)
	end
	view:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	fit()
end

function Bag.show(parent, profile, player, narrow)
	local root = make("Frame", parent, { Name = "EquipmentCollection", Size = UDim2.fromScale(1, 1) })
	local rods = panel(
		root,
		"FishingRods",
		UDim2.fromOffset(0, 0),
		if narrow then UDim2.new(1, 0, 0.61, -5) else UDim2.new(0.67, -8, 1, 0)
	)
	local items = panel(
		root,
		"ItemCollection",
		if narrow then UDim2.new(0, 0, 0.61, 5) else UDim2.new(0.67, 0, 0, 0),
		if narrow then UDim2.new(0.62, -5, 0.39, -5) else UDim2.new(0.19, -8, 1, 0)
	)
	local rail = scrolling(
		root,
		"EquipmentCategories",
		if narrow then UDim2.new(0.62, 5, 0.61, 5) else UDim2.new(0.86, 0, 0, 48),
		if narrow then UDim2.new(0.38, -5, 0.39, -5) else UDim2.new(0.14, 0, 1, -48),
		false
	)
	rail.ScrollBarThickness = 3
	label(rods, "Fishing Rods", if narrow then 19 else 26, {
		Position = UDim2.fromOffset(12, 7),
		Size = UDim2.new(if narrow then 0.45 else 0.32, -12, 0, 34),
	})
	local owned, available = 0, 0
	for id, info in Catalog.Equipment do
		if info.Kind == "Fishing rod" then
			available += 1
			if profile.OwnedRods[id] then
				owned += 1
			end
		end
	end
	for id in RodSkins.Skins do
		available += 1
		if (profile.RodSkins or {})[id] then
			owned += 1
		end
	end
	label(
		rods,
		string.format("<i>%d%% Unlocked</i>", if available > 0 then math.floor(owned / available * 100) else 0),
		if narrow then 15 else 18,
		{
			Name = "UnlockedCount",
			Position = UDim2.new(if narrow then 0.45 else 0.32, 0, 0, 8),
			Size = UDim2.new(if narrow then 0.3 else 0.28, -4, 0, 30),
		}
	)
	local rodSearch = search(
		rods,
		"SearchRods",
		"Search Rods..",
		state.RodQuery,
		if narrow then UDim2.fromOffset(10, 47) else UDim2.new(0.6, 0, 0, 7),
		if narrow then UDim2.new(1, -64, 0, 32) else UDim2.new(0.4, -54, 0, 34)
	)
	local body = scrolling(
		rods,
		"RodCards",
		UDim2.fromOffset(10, if narrow then 89 else 53),
		UDim2.new(1, -20, 1, if narrow then -99 else -63),
		true
	)
	local fillRods
	local compact = action(
		rods,
		"CardDensity",
		"▦",
		UDim2.new(1, -46, 0, if narrow then 47 else 7),
		UDim2.fromOffset(34, 32),
		function()
			state.Compact = not state.Compact
			fillRods()
		end
	)
	compact.TextSize = 26
	local function empty(body, title, description)
		label(body, "<i>" .. title .. "</i>", 19, {
			Size = UDim2.new(1, -12, 0, 50),
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		label(body, description, 15, {
			Size = UDim2.new(1, -12, 0, 95),
			TextColor3 = grey,
			LayoutOrder = 1,
			TextXAlignment = Enum.TextXAlignment.Center,
		})
	end
	fillRods = function()
		for _, child in body:GetChildren() do
			if not child:IsA("UIListLayout") then
				child:Destroy()
			end
		end
		local ids = {}
		local rewardId = RodSkins.GroupReward
		local reward = RodSkins.Skins[rewardId]
		if
			not profile.GroupRodClaimed
			and not (profile.RodSkins and profile.RodSkins[rewardId])
			and string.find(string.lower(reward.Name .. " group reward"), string.lower(state.RodQuery), 1, true)
		then
			table.insert(ids, {
				Key = "GroupReward",
				Id = rewardId,
				GroupReward = true,
				Info = {
					Name = reward.Name,
					Kind = "Group exclusive · Free",
					Description = "+7.5% speed · +7.5% strength\nJoin our community to unlock.",
				},
			})
		end
		for id, ownedRod in profile.OwnedRods do
			local info = Catalog.Equipment[id]
			if
				ownedRod and string.find(string.lower(info and info.Name or id), string.lower(state.RodQuery), 1, true)
			then
				table.insert(ids, { Key = id, Id = id, Info = info })
			end
		end
		for _, copy in profile.RodSkinCopies or {} do
			local skin = RodSkins.Skins[copy.SkinId]
			local serialText = string.format("Serial #%06d", copy.Serial)
			if
				skin
				and string.find(string.lower(skin.Name .. " " .. serialText), string.lower(state.RodQuery), 1, true)
			then
				table.insert(ids, {
					Key = "Skin:" .. copy.SkinId .. ":" .. copy.Serial,
					Id = copy.SkinId,
					Serial = copy.Serial,
					Wear = copy.Wear,
					Info = {
						Name = skin.Name,
						Kind = skin.Rarity .. " skin · " .. RodSkins.wearState(copy.Wear),
						Description = table.concat(RodSkins.perks(copy.SkinId, copy.Wear), " · "),
					},
				})
			end
		end
		table.sort(ids, function(a, b)
			if state.Favorites[a.Key] ~= state.Favorites[b.Key] then
				return state.Favorites[a.Key] == true
			end
			if a.Id == b.Id then
				return (a.Serial or 0) < (b.Serial or 0)
			end
			return a.Id < b.Id
		end)
		if #ids == 0 then
			-- Empty states use a vertical layout instead of horizontal card placement.
			local blank = make("Frame", body, { Name = "EmptyRods", Size = UDim2.new(1, -6, 1, -8) })
			make("UIListLayout", blank, { Padding = UDim.new(0, 8) })
			empty(
				blank,
				if owned == 0 then "Your equipment bag is empty" else "No matching rods",
				if owned == 0
					then "Your starter rod is still loading. Please try again shortly."
					else "Try another rod name."
			)
			return
		end
		for index, entry in ids do
			local id, info, serial = entry.Id, entry.Info, entry.Serial
			local activeSkin = serial ~= nil
				and player:GetAttribute("RodSkin") == id
				and player:GetAttribute("RodSkinSerial") == serial
			local tile = panel(
				body,
				entry.Key,
				UDim2.fromOffset(0, 0),
				UDim2.new(if narrow then 0.86 elseif state.Compact then 0.25 else 1 / 3, -8, 1, -8)
			)
			tile.LayoutOrder = index
			outline(
				tile,
				if activeSkin or (player:GetAttribute("RodEquipped") and id == "StarterRod") then mint else edge,
				2
			)
			if id == "StarterRod" then
				local skin = player:GetAttribute("RodSkin")
				rodPreview(
					tile,
					if type(skin) == "string" and skin ~= "" then skin else nil,
					player:GetAttribute("RodSkinWear")
				)
			elseif serial or entry.GroupReward then
				rodPreview(tile, id, entry.Wear)
			end
			label(
				tile,
				"<i>"
					.. (info and info.Kind or "Fishing rod")
					.. "\n"
					.. (if serial
						then string.format("Serial #%06d", serial)
						elseif entry.GroupReward then "One-time reward"
						else "Owned")
					.. "</i>",
				18,
				{
					Name = "RodDetails",
					Position = UDim2.fromOffset(10, 9),
					Size = UDim2.new(1, -52, 0, 56),
					TextColor3 = grey,
					TextYAlignment = Enum.TextYAlignment.Top,
				}
			)
			local favorite = action(
				tile,
				"FavoriteRod",
				if state.Favorites[entry.Key] then "★" else "☆",
				UDim2.new(1, -40, 0, 8),
				UDim2.fromOffset(30, 32),
				function()
					state.Favorites[entry.Key] = not state.Favorites[entry.Key] or nil
					fillRods()
				end,
				state.Favorites[entry.Key]
			)
			favorite.TextSize, favorite.BackgroundTransparency = 30, 1
			label(tile, "<i>[" .. (info and info.Name or id) .. "]</i>", 18, {
				Name = "RodName",
				Position = UDim2.new(0, 8, 1, -134),
				Size = UDim2.new(1, -16, 0, 44),
				TextXAlignment = Enum.TextXAlignment.Center,
			})
			label(tile, "<i>" .. (info and info.Description or "Owned fishing equipment") .. "</i>", 15, {
				Position = UDim2.new(0, 10, 1, -91),
				Size = UDim2.new(1, -20, 0, 43),
				TextColor3 = grey,
				TextXAlignment = Enum.TextXAlignment.Center,
			})
			if entry.GroupReward then
				local claim
				claim = action(
					tile,
					"ClaimGroupReward",
					"[Join & Claim]",
					UDim2.new(0, 10, 1, -43),
					UDim2.new(1, -20, 0, 34),
					function()
						if claim:GetAttribute("Busy") or player:GetAttribute("BoatDataStatus") ~= "Ready" then
							return
						end
						claim:SetAttribute("Busy", true)
						claim.Text = "[Checking membership…]"
						task.spawn(function()
							local ok, member = pcall(function()
								return player:IsInGroupAsync(RodSkins.GroupId)
							end)
							if not ok or not member then
								local prompted, status = pcall(function()
									return game:GetService("GroupService"):PromptJoinAsync(RodSkins.GroupId)
								end)
								if not prompted then
									if claim.Parent then
										claim.Text = "[Join group on Roblox · Retry]"
										claim:SetAttribute("Busy", false)
									end
									return
								end
								if
									status == Enum.GroupMembershipStatus.None
									or status == Enum.GroupMembershipStatus.JoinRequestPending
								then
									if claim.Parent then
										claim.Text = if status == Enum.GroupMembershipStatus.JoinRequestPending
											then "[Membership pending · Retry]"
											else "[Join & Claim]"
										claim:SetAttribute("Busy", false)
									end
									return
								end
								-- Server membership can lag behind the prompt; it still authorizes
								-- every claim itself. This retry survives closing the equipment bag.
								task.delay(65, function()
									if (player:GetAttribute("RodSkinCount" .. rewardId) or 0) == 0 then
										ReplicatedStorage.Fishing.Request:FireServer("ClaimGroupReward")
									end
								end)
							end
							ReplicatedStorage.Fishing.Request:FireServer("ClaimGroupReward")
							if claim.Parent then
								claim.Text = "[Claim / Check again]"
								claim:SetAttribute("Busy", false)
							end
						end)
					end,
					true
				)
				claim.TextSize = 18
			elseif id == "StarterRod" then
				local equipped = player:GetAttribute("RodEquipped") == true
				local equip = action(
					tile,
					"EquipRod",
					if equipped then "[Equipped · Stow]" else "[Equip]",
					UDim2.new(0, 10, 1, -43),
					UDim2.new(1, -20, 0, 34),
					function()
						if player:GetAttribute("BoatDataStatus") == "Ready" then
							ReplicatedStorage.Fishing.Request:FireServer(
								if player:GetAttribute("RodEquipped") then "UnequipRod" else "EquipRod"
							)
						end
					end,
					true
				)
				equip.TextSize = 20
			elseif serial then
				local equip = action(
					tile,
					"EquipSkin",
					if activeSkin then "[Selected · Remove skin]" else "[Use skin]",
					UDim2.new(0, 10, 1, -43),
					UDim2.new(1, -20, 0, 34),
					function()
						if player:GetAttribute("BoatDataStatus") == "Ready" then
							ReplicatedStorage.Fishing.Request:FireServer(
								"EquipRodSkin",
								if activeSkin then "" else { SkinId = id, Serial = serial }
							)
						end
					end,
					activeSkin
				)
				equip.TextSize = 18
			end
		end
	end
	rodSearch:GetPropertyChangedSignal("Text"):Connect(function()
		state.RodQuery = rodSearch.Text
		fillRods()
	end)
	local itemTitle = label(items, "", if narrow then 23 else 32, {
		Position = UDim2.fromOffset(10, 2),
		Size = UDim2.new(1, -20, 0, 39),
	})
	local itemSearch =
		search(items, "SearchItems", "", state.ItemQuery, UDim2.fromOffset(10, 46), UDim2.new(1, -20, 0, 32))
	local itemBody = scrolling(items, "ItemCards", UDim2.fromOffset(10, 121), UDim2.new(1, -20, 1, -131), false)
	local fillItems
	local sort = action(
		items,
		"SortItems",
		"▾  Name: A–Z",
		UDim2.fromOffset(10, 86),
		UDim2.new(1, -20, 0, 27),
		function()
			state.Reverse = not state.Reverse
			fillItems()
		end
	)
	sort.TextSize, sort.TextXAlignment = 17, Enum.TextXAlignment.Left
	local tabs = {}
	fillItems = function()
		itemTitle.Text = "<i>" .. state.Category .. "</i>"
		itemSearch.PlaceholderText = "Search " .. state.Category .. ".."
		sort.Text = if state.Reverse then "▾  Name: Z–A" else "▾  Name: A–Z"
		for category, tab in tabs do
			tab.TextColor3 = if category == state.Category then mint else white
			tab.BackgroundTransparency = if category == state.Category then 0.18 else 0.4
			tab:FindFirstChildOfClass("UIStroke").Color = if category == state.Category then mint else grey
		end
		for _, child in itemBody:GetChildren() do
			if not child:IsA("UIListLayout") then
				child:Destroy()
			end
		end
		if state.Category == "Spears" then
			local copies = {}
			for _, copy in profile.SpearSkinCopies or {} do
				local skin = SpearSkins.Skins[copy.SkinId]
				if skin and string.find(string.lower(skin.Name .. " " .. copy.Serial), string.lower(state.ItemQuery), 1, true) then
					table.insert(copies, copy)
				end
			end
			table.sort(copies, function(a, b)
				local aName, bName = SpearSkins.Skins[a.SkinId].Name, SpearSkins.Skins[b.SkinId].Name
				if aName == bName then return a.Serial < b.Serial end
				return if state.Reverse then aName > bName else aName < bName
			end)
			for index, copy in copies do
				local skin = SpearSkins.Skins[copy.SkinId]
				local selected = player:GetAttribute("SpearSkin") == copy.SkinId and player:GetAttribute("SpearSkinSerial") == copy.Serial
				local tile = panel(itemBody, "Spear:" .. copy.SkinId .. ":" .. copy.Serial, UDim2.new(), UDim2.new(1, -7, 0, 228))
				tile.LayoutOrder = index
				outline(tile, if selected then mint else edge)
				spearPreview(tile, copy.SkinId, copy.Wear)
				label(tile, skin.Name, 17, { Position = UDim2.fromOffset(8, 84), Size = UDim2.new(1, -16, 0, 27), TextXAlignment = Enum.TextXAlignment.Center })
				label(tile, skin.Rarity .. " · " .. SpearSkins.wearState(copy.Wear) .. string.format("\nSerial #%06d", copy.Serial), 14,
					{ Position = UDim2.fromOffset(8, 111), Size = UDim2.new(1, -16, 0, 35), TextColor3 = grey })
				label(tile, table.concat(SpearSkins.perks(copy.SkinId, copy.Wear), " · "), 14,
					{ Position = UDim2.fromOffset(8, 149), Size = UDim2.new(1, -16, 0, 29), TextColor3 = grey })
				action(tile, "EquipSpearSkin", if selected then "[Selected · Remove]" else "[Use skin]", UDim2.fromOffset(8, 186), UDim2.new(1, -16, 0, 32), function()
					if player:GetAttribute("BoatDataStatus") == "Ready" then
						ReplicatedStorage.Fishing.Request:FireServer("EquipSpearSkin", if selected then "" else { SkinId = copy.SkinId, Serial = copy.Serial })
					end
				end, selected)
			end
			if #copies == 0 then
				empty(itemBody, if state.ItemQuery ~= "" then "No matching spear skins" else "No spear skins yet",
					if state.ItemQuery ~= "" then "Try another search." else "Open the $350 Spear Case in Tide & Tackle.")
			end
			return
		end
		if state.Category == "Baits" then
			local request = ReplicatedStorage.Fishing.Request
			local ready = player:GetAttribute("BoatDataStatus") == "Ready"
			local crates = profile.BaitCrates or 0
			if crates > 0 and state.ItemQuery == "" then
				local tile = panel(itemBody, "BaitCrate", UDim2.new(), UDim2.new(1, -7, 0, 112))
				outline(tile, Color3.fromRGB(244, 196, 76))
				label(tile, Bait.Crate.Name .. "  ×" .. crates, 18, {
					Position = UDim2.fromOffset(8, 6),
					Size = UDim2.new(1, -16, 0, 26),
					TextXAlignment = Enum.TextXAlignment.Center,
				})
				label(tile, string.format("%d–%d bait of one kind. Worms are common; rarer bait is stronger.", Bait.Crate.MinBait, Bait.Crate.MaxBait), 14, {
					Position = UDim2.fromOffset(8, 32),
					Size = UDim2.new(1, -16, 0, 34),
					TextColor3 = grey,
					TextXAlignment = Enum.TextXAlignment.Center,
				})
				action(tile, "OpenBaitCrate", "[Open crate]", UDim2.fromOffset(8, 72), UDim2.new(1, -16, 0, 32), function()
					if ready then
						request:FireServer("OpenBaitCrate")
					end
				end, true)
			end
			local ids = {}
			for _, id in Bait.Order do
				local count = (profile.Bait or {})[id] or 0
				if count > 0 and string.find(string.lower(Bait.Types[id].Name), string.lower(state.ItemQuery), 1, true) then
					table.insert(ids, id)
				end
			end
			if state.Reverse then
				table.sort(ids, function(a, b)
					return table.find(Bait.Order, a) > table.find(Bait.Order, b)
				end)
			end
			local equipped = player:GetAttribute("EquippedBait") or ""
			for index, id in ids do
				local bait = Bait.Types[id]
				local selected = equipped == id
				local color = Color3.fromRGB(table.unpack(Bait.Rarities[bait.Rarity].Color))
				local tile = panel(itemBody, "Bait:" .. id, UDim2.new(), UDim2.new(1, -7, 0, 150))
				tile.LayoutOrder = index + 1
				outline(tile, if selected then mint else edge)
				local swatch = make("Frame", tile, {
					Position = UDim2.fromOffset(10, 10),
					Size = UDim2.fromOffset(26, 26),
					BackgroundColor3 = Color3.fromRGB(table.unpack(bait.Color)),
					BackgroundTransparency = 0,
				})
				make("UICorner", swatch, { CornerRadius = UDim.new(1, 0) })
				outline(swatch, color, 2)
				label(tile, bait.Name .. " bait  ×" .. profile.Bait[id], 18, {
					Position = UDim2.fromOffset(44, 8),
					Size = UDim2.new(1, -52, 0, 30),
				})
				label(tile, bait.Rarity, 14, {
					Position = UDim2.fromOffset(10, 40),
					Size = UDim2.new(1, -20, 0, 18),
					TextColor3 = color,
				})
				label(tile, table.concat(Bait.perks(id), " · ") .. "\nOne is used per catch reeled in.", 14, {
					Position = UDim2.fromOffset(10, 60),
					Size = UDim2.new(1, -20, 0, 38),
					TextColor3 = grey,
				})
				action(tile, "EquipBait", if selected then "[On hook · Remove]" else "[Use bait]", UDim2.fromOffset(8, 108), UDim2.new(1, -16, 0, 32), function()
					if ready then
						request:FireServer("EquipBait", if selected then "" else id)
					end
				end, selected)
			end
			if #ids == 0 and (crates == 0 or state.ItemQuery ~= "") then
				empty(
					itemBody,
					if state.ItemQuery ~= "" then "No matching bait" else "No bait yet",
					if state.ItemQuery ~= ""
						then "Try another search."
						else string.format("Buy a $%d Bait Crate from Finn in Tide & Tackle, or get lucky on the line.", Bait.Crate.Price)
				)
			end
			return
		end
		if state.Category == "Bobbers" then
			local ids = {}
			for id, count in profile.BobberSkins or {} do
				local skin = BobberSkins.Skins[id]
				if
					count > 0
					and skin
					and string.find(string.lower(skin.Name), string.lower(state.ItemQuery), 1, true)
				then
					table.insert(ids, id)
				end
			end
			table.sort(ids, function(a, b)
				return if state.Reverse
					then BobberSkins.Skins[a].Name > BobberSkins.Skins[b].Name
					else BobberSkins.Skins[a].Name < BobberSkins.Skins[b].Name
			end)
			local equipped = player:GetAttribute("BobberSkin") or ""
			if state.ItemQuery == "" then
				local starter = panel(itemBody, "StarterBobber", UDim2.new(), UDim2.new(1, -7, 0, 110))
				label(
					starter,
					"Starter Bobber\nNo bonus",
					17,
					{ Position = UDim2.fromOffset(8, 6), Size = UDim2.new(1, -16, 0, 50) }
				)
				action(
					starter,
					"ResetBobberSkin",
					if equipped == "" then "[Selected]" else "[Use starter]",
					UDim2.fromOffset(8, 65),
					UDim2.new(1, -16, 0, 32),
					function()
						if player:GetAttribute("BoatDataStatus") == "Ready" then
							ReplicatedStorage.Fishing.Request:FireServer("EquipBobberSkin", "")
						end
					end,
					equipped == ""
				)
			end
			for index, id in ids do
				local skin = BobberSkins.Skins[id]
				local selected = equipped == id
				local tile = panel(itemBody, "Bobber:" .. id, UDim2.new(), UDim2.new(1, -7, 0, 208))
				tile.LayoutOrder = index
				outline(tile, if selected then mint else edge)
				bobberPreview(tile, id)
				label(tile, skin.Name, 17, {
					Position = UDim2.fromOffset(8, 72),
					Size = UDim2.new(1, -16, 0, 36),
					TextXAlignment = Enum.TextXAlignment.Center,
				})
				label(
					tile,
					table.concat(BobberSkins.perks(id), "\n"),
					14,
					{ Position = UDim2.fromOffset(8, 110), Size = UDim2.new(1, -16, 0, 34), TextColor3 = grey }
				)
				label(
					tile,
					skin.Rarity .. " · Owned ×" .. profile.BobberSkins[id],
					14,
					{ Position = UDim2.fromOffset(8, 146), Size = UDim2.new(1, -16, 0, 19), TextColor3 = grey }
				)
				action(
					tile,
					"EquipBobberSkin",
					if selected then "[Selected · Remove]" else "[Use bobber]",
					UDim2.fromOffset(8, 168),
					UDim2.new(1, -16, 0, 32),
					function()
						if player:GetAttribute("BoatDataStatus") == "Ready" then
							ReplicatedStorage.Fishing.Request:FireServer("EquipBobberSkin", if selected then "" else id)
						end
					end,
					selected
				)
			end
			if #ids == 0 then
				empty(
					itemBody,
					if state.ItemQuery ~= "" then "No matching bobbers" else "No bobber skins yet",
					if state.ItemQuery ~= ""
						then "Try another search."
						else "Open the $350 Bobber Case in Tide & Tackle."
				)
			end
			return
		end
		local boats = {}
		if state.Category == "Boats" then
			for id, isOwned in profile.OwnedBoats do
				local info = BoatCatalog[id]
				if
					isOwned
					and string.find(string.lower(info and info.Name or id), string.lower(state.ItemQuery), 1, true)
				then
					table.insert(boats, id)
				end
			end
		end
		table.sort(boats, function(a, b)
			local aName, bName =
				BoatCatalog[a] and BoatCatalog[a].Name or a, BoatCatalog[b] and BoatCatalog[b].Name or b
			return if state.Reverse then aName > bName else aName < bName
		end)
		for index, id in boats do
			local info = BoatCatalog[id]
			local tile = panel(itemBody, "Boat:" .. id, UDim2.fromOffset(0, 0), UDim2.new(1, -7, 0, 160))
			tile.LayoutOrder = index
			label(tile, "<i>[" .. (info and info.Name or id) .. "]</i>", 20, {
				Position = UDim2.fromOffset(8, 8),
				Size = UDim2.new(1, -16, 0, 52),
				TextXAlignment = Enum.TextXAlignment.Center,
			})
			label(tile, "Owned\nLaunch from the boat stand on your dock.", 17, {
				Position = UDim2.fromOffset(8, 64),
				Size = UDim2.new(1, -16, 0, 85),
				TextColor3 = grey,
				TextXAlignment = Enum.TextXAlignment.Center,
			})
		end
		if #boats == 0 then
			empty(
				itemBody,
				if state.ItemQuery ~= "" then "No matching items" else "No " .. string.lower(state.Category) .. " yet",
				if state.ItemQuery ~= ""
					then "Try another search."
					elseif state.Category == "Boats" then "Your owned boats appear here."
					else "There are no items in this category to equip."
			)
		end
	end
	itemSearch:GetPropertyChangedSignal("Text"):Connect(function()
		state.ItemQuery = itemSearch.Text
		fillItems()
	end)
	-- Boats retain access to the previously listed owned vessels.
	for index, category in { "Spears", "Bobbers", "Baits", "Lanterns", "Accessories", "Boats" } do
		tabs[category] = action(
			rail,
			category .. "Category",
			"[" .. category .. "]",
			UDim2.new(0, 0, 0, (index - 1) * (if narrow then 35 else 62)),
			UDim2.new(1, 0, 0, if narrow then 30 else 50),
			function()
				state.Category, state.ItemQuery = category, ""
				itemSearch.Text = ""
				fillItems()
			end,
			category == state.Category
		)
		tabs[category].TextSize = if narrow then 17 else 21
		tabs[category].LayoutOrder = index
		tabs[category].Size = UDim2.new(1, -6, 0, if narrow then 30 else 50)
	end
	fillRods()
	fillItems()
	return root
end

return Bag
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="320">
          <Properties>
            <string name="Name">FishMeshes</string>
            <string name="Source"><![CDATA[-- Gives loft fish (FishModels.LOFT_TAG) their smooth skin on this client,
-- wherever they are: hands, freezers, customers' arms and menu viewports.
-- EditableMesh never replicates, so servers build the sphere body and each
-- client swaps it out locally. Skins copy their colour, material and
-- transparency from the body's Chest swatches, so mutation painting and the
-- Rainbow/Glitch animations carry over. If a mesh can't be made, the sphere
-- body simply stays.
local AssetService = game:GetService("AssetService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FishModels = require(ReplicatedStorage.Shared.FishModels)
local MeshFeatures = require(ReplicatedStorage.Shared.MeshFeatures)
local EditableMeshBudget = require(script.Parent.EditableMeshBudget)

local FishMeshes = {}
-- Angle steps from back to belly on one flank.
local ANGLE_STEPS = 28
-- Colour bands from back to belly (fractions of pi). Blend bands mix their two
-- swatches, softening the countershading.
local BANDS = {
	{ name = "Back", from = 0, to = 0.34, a = "Back", b = "Back", mix = 0 },
	{ name = "BackSide", from = 0.34, to = 0.42, a = "Back", b = "Side", mix = 0.35 },
	{ name = "SideBack", from = 0.42, to = 0.48, a = "Back", b = "Side", mix = 0.7 },
	{ name = "Side", from = 0.48, to = 0.62, a = "Side", b = "Side", mix = 0 },
	{ name = "SideBelly", from = 0.62, to = 0.68, a = "Side", b = "Belly", mix = 0.35 },
	{ name = "BellySide", from = 0.68, to = 0.74, a = "Side", b = "Belly", mix = 0.7 },
	{ name = "Belly", from = 0.74, to = 1, a = "Belly", b = "Belly", mix = 0 },
}
-- Flatfish (loft mode "flat") lie on their side: one colour per face.
local FLAT_BANDS = {
	{ name = "Top", from = 0, to = 1, a = "Side", b = "Side", mix = 0, sides = { 1 } },
	{ name = "Under", from = 0, to = 1, a = "Belly", b = "Belly", mix = 0, sides = { -1 } },
}
local function bandsFor(spec)
	return if spec.mode == "flat" then FLAT_BANDS else BANDS
end
local PAINTED = { "Color", "Material", "Reflectance", "Transparency" }
local started = false
-- [fishId] = { [band name] = { part, mesh, size, offset } }, false when unavailable.
local skins: { [string]: any } = {}
local skinErrors: { [string]: string } = {}
-- Part creation and fixed-size copying yield. Only one species may hold a
-- temporary dynamic mesh at a time, even when many tagged fish arrive together.
local building = false
local hydrated: { [Model]: boolean } = setmetatable({}, { __mode = "k" }) :: any

-- One band of the skin as a mesh part, its vertices centred on its bounds.
local function buildBand(rings, band): (MeshPart?, Vector3?, EditableMesh?, string?)
	local scale = FishModels.SCALE
	local steps = math.max(2, math.ceil((band.to - band.from) * ANGLE_STEPS))
	local points, normals = {}, {}
	local grids = {}
	local low, high = Vector3.one * math.huge, -Vector3.one * math.huge
	local function add(point: Vector3, normal: Vector3): number
		table.insert(points, point)
		table.insert(normals, normal)
		low, high = low:Min(point), high:Max(point)
		return #points
	end
	local first, last = rings[1], rings[#rings]
	local snout = add(
		Vector3.new(first.x + 0.006, (first.top + first.bottom) / 2, 0) * scale,
		Vector3.new(1, 0, 0)
	)
	local tail = add(Vector3.new(last.x - 0.004, (last.top + last.bottom) / 2, 0) * scale, Vector3.new(-1, 0, 0))
	local sides = band.sides or { 1, -1 }
	for _, side in sides do
		local grid = {}
		for ringIndex, ring in rings do
			local row = {}
			for step = 0, steps do
				local angle = side * math.pi * (band.from + (band.to - band.from) * step / steps)
				row[step] = add(FishModels.loftPoint(ring, angle) * scale, FishModels.loftNormal(rings, ring.x, angle))
			end
			grid[ringIndex] = row
		end
		grids[side] = grid
	end
	local center = (low + high) / 2

	local mesh = EditableMeshBudget.create()
	if not mesh then
		return nil, nil, nil, EditableMeshBudget.failureReason() or "EditableMesh allocation failed"
	end
	local ok, part = pcall(function()
		local vertexIds, normalIds = {}, {}
		for index, point in points do
			vertexIds[index] = mesh:AddVertex(point - center)
			normalIds[index] = mesh:AddNormal(normals[index])
		end
		-- Wound so (b - a) x (c - a) faces outward, the side Roblox draws.
		local function face(a: number, b: number, c: number)
			local pa = points[a]
			local cross = (points[b] - pa):Cross(points[c] - pa)
			if cross.Magnitude < 1e-10 then
				return
			end
			if cross:Dot(normals[a] + normals[b] + normals[c]) < 0 then
				b, c = c, b
			end
			local id = mesh:AddTriangle(vertexIds[a], vertexIds[b], vertexIds[c])
			mesh:SetFaceNormals(id, { normalIds[a], normalIds[b], normalIds[c] })
		end
		for _, side in sides do
			local grid = grids[side]
			for ringIndex = 1, #rings - 1 do
				local row, nextRow = grid[ringIndex], grid[ringIndex + 1]
				for step = 0, steps - 1 do
					face(row[step], nextRow[step], nextRow[step + 1])
					face(row[step], nextRow[step + 1], row[step + 1])
				end
			end
			for step = 0, steps - 1 do
				face(snout, grid[1][step], grid[1][step + 1])
				face(tail, grid[#rings][step], grid[#rings][step + 1])
			end
		end

		mesh = EditableMeshBudget.fixed(mesh)
		if not mesh then
			return nil
		end
		return AssetService:CreateMeshPartAsync(
			Content.fromObject(mesh),
			{ CollisionFidelity = Enum.CollisionFidelity.Box }
		)
	end)
	if not ok or not part then
		if mesh then
			mesh:Destroy()
		end
		if not ok then
			warn("[FishMeshes] Could not create a fish skin: " .. tostring(part))
		end
		return nil, nil, nil, if not ok then tostring(part) else (EditableMeshBudget.failureReason() or "Mesh part creation returned nil")
	end
	part.Size = high - low
	return part, center, mesh
end

-- Band templates for a species, built once and shared by every fish of it.
local function skin(fishId: string)
	while building do
		task.wait()
	end
	if skins[fishId] ~= nil then
		return skins[fishId]
	end
	local spec = FishModels.loft(fishId)
	if not spec then
		skins[fishId] = false
		skinErrors[fishId] = "No smooth-body geometry exists for " .. fishId
		return false
	end
	building = true
	local bands = {}
	for _, band in bandsFor(spec) do
		local ok, part, center, mesh, reason = pcall(buildBand, spec.rings, band)
		if not ok or not part or not center or not mesh then
			for _, built in bands do
				built.part:Destroy()
				built.mesh:Destroy()
			end
			skins[fishId] = false
			skinErrors[fishId] = band.name .. " band: " .. (if not ok then tostring(part) else tostring(reason or "unknown mesh creation failure"))
			building = false
			return false
		end
		bands[band.name] = { part = part, mesh = mesh, size = part.Size, offset = center - spec.anchorPosition }
	end
	skins[fishId] = bands
	building = false
	return bands
end

-- Exercise the same seven bands used by a rainbow trout, then report whether
-- tagged fish currently in this client actually received their skins.
function FishMeshes.diagnose(): string
	if not MeshFeatures.EditableMeshesEnabled then
		return "Mesh test FAILED: EditableMeshesEnabled is off."
	end
	if not started then
		return "Mesh test FAILED: FishMeshes client has not started."
	end
	local ok, result = pcall(skin, "RainbowTrout")
	if not ok then
		return "Mesh test FAILED: " .. tostring(result)
	end
	if not result then
		return "Mesh test FAILED: " .. (skinErrors.RainbowTrout or "unknown failure")
	end
	local total, skinned, pending = 0, 0, 0
	local firstFailure: string? = nil
	for _, model in CollectionService:GetTagged(FishModels.LOFT_TAG) do
		if model:IsA("Model") and model.Parent then
			total += 1
			if model:FindFirstChild("LoftSkin", true) then
				skinned += 1
			else
				pending += 1
				local fishId = model:GetAttribute("LoftFish")
				if type(fishId) == "string" and skinErrors[fishId] then
					firstFailure = firstFailure or (fishId .. ": " .. skinErrors[fishId])
				end
			end
		end
	end
	local summary = string.format("Rainbow Trout skin available. Client fish: %d; with skins: %d; without skins: %d.", total, skinned, pending)
	if firstFailure then
		return "Mesh test PARTIAL: " .. summary .. " Failure: " .. firstFailure
	end
	if pending > 0 then
		return "Mesh test PARTIAL: " .. summary .. " Some fish may still be loading."
	end
	return "Mesh test PASS: " .. summary .. " Spots and fins remain separate parts."
end

function FishMeshes.hydrate(model: Instance)
	if not model:IsA("Model") or hydrated[model] then
		return
	end
	local fishId = model:GetAttribute("LoftFish")
	if type(fishId) ~= "string" then
		return
	end
	hydrated[model] = true
	local bands = skin(fishId)
	local spec = FishModels.loft(fishId)
	if not bands or not spec or not model.Parent then
		return
	end
	local swatches: { [string]: BasePart } = {}
	for _, item in model:GetDescendants() do
		local swatch = item:GetAttribute("LoftSwatch")
		if type(swatch) == "string" and item:IsA("BasePart") and not swatches[swatch] then
			swatches[swatch] = item
		elseif item.Name == "LoftSkin" then
			-- A clone of a fish this client already skinned.
			item:Destroy()
		end
	end
	local anchor = swatches.Side
	swatches.Back = swatches.Back or anchor
	swatches.Belly = swatches.Belly or anchor
	if not anchor then
		return
	end
	local parts = {}
	for _, band in bandsFor(spec) do
		local template = bands[band.name]
		local part = template.part:Clone()
		part.Name = "LoftSkin"
		part.Anchored = false
		part.Massless = true
		part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
		part.CastShadow = anchor.CastShadow
		parts[band] = part
	end
	local function paint()
		for band, part in parts do
			local a, b = swatches[band.a], swatches[band.b]
			part.Color = a.Color:Lerp(b.Color, band.mix)
			part.Material = a.Material
			part.Reflectance = a.Reflectance
			part.Transparency = a.Transparency
		end
	end
	local welds = {}
	-- Scaled with the Chest swatch, so ScaleTo on either machine keeps it fitted.
	local function place()
		local ratio = anchor.Size.X / spec.anchorSize.X
		for _, weld in welds do
			weld.Enabled = false
		end
		for band, part in parts do
			local template = bands[band.name]
			part.Size = template.size * ratio
			part.CFrame = anchor.CFrame * CFrame.new(template.offset * ratio)
		end
		for _, weld in welds do
			weld.Enabled = true
		end
	end
	paint()
	place()
	for _, part in parts do
		local weld = Instance.new("WeldConstraint")
		weld.Part0, weld.Part1 = anchor, part
		weld.Parent = part
		table.insert(welds, weld)
		part.Parent = anchor.Parent
	end
	for _, swatch in swatches do
		for _, property in PAINTED do
			swatch:GetPropertyChangedSignal(property):Connect(paint)
		end
	end
	anchor:GetPropertyChangedSignal("Size"):Connect(place)
	-- Hide the sphere body visually only; its parts keep carrying particles,
	-- lights and the colours the skin copies.
	for _, item in model:GetDescendants() do
		if item:GetAttribute("LoftFallback") then
			local mesh = item:FindFirstChildOfClass("SpecialMesh")
			if mesh then
				mesh.Scale = Vector3.zero
			end
		end
	end
end

function FishMeshes.start()
	if started then
		return
	end
	started = true
	if not MeshFeatures.EditableMeshesEnabled then
		return
	end
	CollectionService:GetInstanceAddedSignal(FishModels.LOFT_TAG):Connect(function(model)
		task.spawn(FishMeshes.hydrate, model)
	end)
	for _, model in CollectionService:GetTagged(FishModels.LOFT_TAG) do
		task.spawn(FishMeshes.hydrate, model)
	end
end

return FishMeshes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="321">
          <Properties>
            <string name="Name">Fishing</string>
            <string name="Source"><![CDATA[-- Fishing notices and the shared shop doorway fade.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))

local Fishing = {}
local started = false

function Fishing.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local remotes = ReplicatedStorage:WaitForChild("Fishing")
	local feedback = remotes:WaitForChild("Feedback") :: RemoteEvent
	local cream = Theme.Colors.Text
	local navy = Theme.Colors.Window
	local gui = Instance.new("ScreenGui")
	gui.Name = "Fishing"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 22
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	local toast = Instance.new("TextLabel")
	toast.Name = "FishingNotice"
	toast.AnchorPoint = Vector2.new(0.5, 1)
	toast.Position = UDim2.new(0.5, 0, 1, -92)
	toast.Size = UDim2.new(0.86, 0, 0, 64)
	toast.BackgroundColor3 = navy
	toast.BackgroundTransparency = 0.06
	toast.TextColor3 = cream
	toast.Font = Enum.Font.GothamMedium
	toast.TextSize = 15
	toast.TextWrapped = true
	toast.Visible = false
	toast.ZIndex = 5
	toast.Parent = gui
	Theme.panel(toast, false, 4)
	Theme.text(toast)
	local toastBounds = Instance.new("UISizeConstraint")
	toastBounds.MaxSize = Vector2.new(560, 64)
	toastBounds.Parent = toast
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft, padding.PaddingRight = UDim.new(0, 14), UDim.new(0, 14)
	padding.Parent = toast
	local noticeId = 0
	local function notice(message: string)
		noticeId += 1
		local current = noticeId
		toast.Text, toast.Visible = message, true
		task.delay(6, function()
			if noticeId == current then
				toast.Visible = false
			end
		end)
	end

	-- Covers the jump between a shop's street door and its interior, which is built away from the map.
	-- Its own top layer, so it hides the HUD and reaches under the top bar.
	local fadeGui = Instance.new("ScreenGui")
	fadeGui.Name = "DoorFadeLayer"
	fadeGui.IgnoreGuiInset = true
	fadeGui.DisplayOrder = 100
	fadeGui.ResetOnSpawn = false
	fadeGui.Parent = player:WaitForChild("PlayerGui")
	local fade = Instance.new("Frame")
	fade.Name = "DoorFade"
	fade.Size = UDim2.fromScale(1, 1)
	fade.BackgroundColor3 = Color3.new(0, 0, 0)
	fade.BackgroundTransparency = 1
	fade.BorderSizePixel = 0
	fade.Parent = fadeGui
	-- Each trip is tagged by the server, so a late signal from an earlier trip can't lift this fade.
	local fadeTrip: number? = nil
	local function fadeOut()
		fadeTrip = nil
		TweenService:Create(fade, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
	end
	local function fadeIn(trip: number)
		fadeTrip = trip
		TweenService:Create(fade, TweenInfo.new(0.2), { BackgroundTransparency = 0 }):Play()
		-- Failsafe: lift the fade if the arrival signal never comes, so the screen can't stay black.
		task.delay(15, function()
			if fadeTrip == trip then
				fadeOut()
			end
		end)
	end
	feedback.OnClientEvent:Connect(function(kind, message, detail)
		if kind == "DoorFade" and typeof(message) == "number" then
			fadeIn(message)
		elseif kind == "DoorArrived" and message == fadeTrip then
			fadeOut()
		elseif kind == "Notice" and typeof(message) == "string" then
			notice(message)
		elseif (kind == "BaitOpenResult" or kind == "BaitEquipResult") and typeof(detail) == "string" then
			-- Bait is opened and equipped from the equipment bag, which has no status line of its own.
			notice(detail)
		end
	end)
end

return Fishing
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="322">
          <Properties>
            <string name="Name">FishingAudio</string>
            <string name="Source"><![CDATA[-- Fishing cues stay on the client: shared sounds parent to SoundService so
-- PlayerSettings routes them through the effects mixer, while splash and bite
-- cues use a temporary attachment so they follow the bobber in world space.
local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local FishingAudio = {}
local CAST_SOUND = "rbxassetid://9126047581" -- Synth air whoosh
local SPLASH_SOUND = "rbxassetid://9125702798" -- Small shallow-water splash
local BITE_SOUND = "rbxassetid://9114451227" -- Heavy fishing reel zuzz
local PULL_SOUND = "rbxassetid://9114452634" -- Short fishing reel burst
local MISS_SOUND = "rbxassetid://9113616170" -- Light whip crack
local CATCH_SOUND = "rbxassetid://9040233162" -- Light, fun orchestral transition
local FAIL_SOUND = "rbxassetid://9042478443" -- Deflated fail quack

local CUES = {
	Cast = { id = CAST_SOUND, volume = 0.45, speed = 1.15 },
	Splash = { id = SPLASH_SOUND, volume = 0.55, speed = 1.1 },
	Bite = { id = BITE_SOUND, volume = 0.5, speed = 0.95 },
	Pull = { id = PULL_SOUND, volume = 0.35, speed = 1.2 },
	Miss = { id = MISS_SOUND, volume = 0.4, speed = 0.8 },
	Catch = { id = CATCH_SOUND, volume = 0.55, speed = 1 },
	Fail = { id = FAIL_SOUND, volume = 0.55, speed = 1 },
}

local started = false
local preloaded = false
local sounds = {}
local lastPlayed = {}

local function ensureStarted()
	if started then
		return
	end
	started = true
	for name, cue in CUES do
		local sound = Instance.new("Sound")
		sound.Name = "Fishing" .. name
		sound.SoundId = cue.id
		sound.Volume = cue.volume
		sound.PlaybackSpeed = cue.speed
		sound.Looped = false
		sound.Parent = SoundService
		sounds[name] = sound
	end
end

function FishingAudio.start()
	ensureStarted()
	if preloaded then
		return
	end
	preloaded = true
	local list = {}
	for _, sound in sounds do
		table.insert(list, sound)
	end
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync(list)
		end)
	end)
end

local function ready(name: string): Sound?
	ensureStarted()
	return sounds[name]
end

local function play(name: string, throttle: number?)
	local sound = ready(name)
	if not sound then
		return
	end
	local now = os.clock()
	if throttle and now - (lastPlayed[name] or -math.huge) < throttle then
		return
	end
	lastPlayed[name] = now
	sound.TimePosition = 0
	sound:Play()
end

local function playAt(name: string, position: Vector3?, throttle: number?)
	local source = ready(name)
	if not source then
		return
	end
	local now = os.clock()
	if throttle and now - (lastPlayed[name] or -math.huge) < throttle then
		return
	end
	lastPlayed[name] = now
	local terrain = if Workspace then Workspace.Terrain else nil
	if not position or not terrain then
		source.TimePosition = 0
		source:Play()
		return
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "FishingSound"
	attachment.WorldPosition = position
	attachment.Parent = terrain
	local sound = source:Clone()
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 16
	sound.RollOffMaxDistance = 100
	sound.Parent = attachment
	sound:Play()
	Debris:AddItem(attachment, 4)
end

function FishingAudio.cast(strength: number?)
	local sound = ready("Cast")
	if not sound then
		return
	end
	local power = if type(strength) == "number" then math.clamp(strength, 0, 1) else 0.5
	sound.PlaybackSpeed = 1.05 + power * 0.25
	play("Cast", 0.5)
end

function FishingAudio.splash(position: Vector3?)
	playAt("Splash", position)
end

function FishingAudio.bite(position: Vector3?)
	playAt("Bite", position, 0.5)
end

function FishingAudio.pull()
	play("Pull")
end

function FishingAudio.miss()
	play("Miss")
end

function FishingAudio.catch()
	play("Catch", 1)
end

function FishingAudio.fail()
	play("Fail", 2)
end

-- Dreadbeard's treasure deserves more than one cue: layer the verified catch,
-- splash, bite and pull sounds at different pitches for a rising, brassy sting.
-- Clones are temporary so the shared cue instances (and their throttles) stay put.
function FishingAudio.secret()
	ensureStarted()
	local layers = {
		{ cue = "Catch", volume = 0.9, speed = 0.62, offset = 0 },
		{ cue = "Catch", volume = 0.7, speed = 0.78, offset = 0.12 },
		{ cue = "Catch", volume = 0.6, speed = 1, offset = 0.3 },
		{ cue = "Splash", volume = 0.8, speed = 0.55, offset = 0 },
		{ cue = "Bite", volume = 0.45, speed = 0.6, offset = 0.05 },
		{ cue = "Pull", volume = 0.5, speed = 1.5, offset = 0.2 },
	}
	for _, layer in layers do
		local source = sounds[layer.cue]
		if source then
			local sound = source:Clone()
			sound.Name = "FishingSecret"
			sound.Volume = layer.volume
			sound.PlaybackSpeed = layer.speed
			sound.TimePosition = layer.offset
			sound.Parent = SoundService
			sound:Play()
			Debris:AddItem(sound, 9)
		end
	end
end

return FishingAudio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="323">
          <Properties>
            <string name="Name">FrameRateGuard</string>
            <string name="Source"><![CDATA[-- Steps the graphics preset down while the frame rate stays low.
--
-- PlayerSettings picks a preset on join from the device and Roblox's saved graphics
-- level, but most players leave graphics on Automatic, which tells it nothing: every
-- computer got the full Quality preset (shadows, detailed clouds), however weak. This
-- watches real frame times once the world has loaded and, if a window is slow, lowers
-- the preset one step (Quality -> Balanced -> Performance), leaving any option the player
-- set by hand. It never raises the preset again during the session.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local PlayerSettings = require(script.Parent.PlayerSettings)

local FrameRateGuard = {}

-- Pure decision, separate from the Roblox loop so a harness can drive it. A window is
-- slow when its average frame rate is under SLOW_FPS, or when it hitches often while
-- also missing 60 FPS. A device capped at 30 FPS with steady frames is left alone
-- unless it drops well below the cap.
FrameRateGuard.SLOW_FPS = 40
FrameRateGuard.CAPPED_FPS = 26
FrameRateGuard.HITCH_SECONDS = 0.1
FrameRateGuard.HITCH_LIMIT = 6
function FrameRateGuard.isSlow(frames: number, seconds: number, hitches: number, steady: boolean): boolean
	if seconds <= 0 or frames <= 0 then
		return false
	end
	local fps = frames / seconds
	if steady then
		return fps < FrameRateGuard.CAPPED_FPS
	end
	return fps < FrameRateGuard.SLOW_FPS or (hitches >= FrameRateGuard.HITCH_LIMIT and fps < 55)
end

local WINDOW = 10 -- seconds of frames judged together
local SETTLE = 15 -- after the loading screen lifts, streaming still settles this long
local COOLDOWN = 20 -- after a step down (it hitches once while shadows rebuild)
local LOADING_TIMEOUT = 120

local started = false

function FrameRateGuard.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	task.spawn(function()
		local deadline = os.clock() + LOADING_TIMEOUT
		while player:GetAttribute("FishingWatersLoadingSeconds") == nil and os.clock() < deadline do
			task.wait(1)
		end
		task.wait(SETTLE)

		local frames, seconds, hitches = 0, 0, 0
		local shortest, longest = math.huge, 0
		local resumeAt = 0
		local function reset()
			frames, seconds, hitches = 0, 0, 0
			shortest, longest = math.huge, 0
		end
		-- A window spent in the background (alt-tabbed, minimised) says nothing about the game.
		local focused = true
		UserInputService.WindowFocusReleased:Connect(function()
			focused = false
			reset()
		end)
		UserInputService.WindowFocused:Connect(function()
			focused = true
			reset()
		end)
		local connection: RBXScriptConnection
		connection = RunService.Heartbeat:Connect(function(dt: number)
			local now = os.clock()
			if now < resumeAt or not focused then
				return
			end
			frames += 1
			seconds += dt
			if dt > FrameRateGuard.HITCH_SECONDS then
				hitches += 1
			end
			-- Ignore the worst frames when judging steadiness; a capped game has a flat floor.
			shortest = math.min(shortest, dt)
			if dt < 0.25 then
				longest = math.max(longest, dt)
			end
			if seconds < WINDOW then
				return
			end
			-- A frame-rate cap shows up as frame times that barely vary and no hitches.
			local steady = hitches == 0 and longest - shortest < 0.006
			if FrameRateGuard.isSlow(frames, seconds, hitches, steady) then
				local fps = math.floor(frames / seconds + 0.5)
				if PlayerSettings.lowerPreset() then
					print(string.format("[FrameRateGuard] %d FPS over %ds; lowered graphics preset", fps, WINDOW))
					resumeAt = now + COOLDOWN
				else
					connection:Disconnect() -- already at the lowest preset
					return
				end
			end
			reset()
		end)
	end)
end

return FrameRateGuard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="324">
          <Properties>
            <string name="Name">Freecam</string>
            <string name="Source"><![CDATA[-- A local, session-only camera that leaves the character in place.
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local BoatCamera = require(script.Parent.BoatCamera)

local Freecam = {}
local player = Players.LocalPlayer
local active, started = false, false
local position, yaw, pitch = Vector3.zero, 0, 0
local saved = nil
local touchGui = nil
local touchKeys = {}
local lookTouch = nil
local dragging = false
local moveStick, lookStick = Vector2.zero, Vector2.zero
local gamepadUp, gamepadDown = false, false
local ACTION = "FishingWatersFreecamMovement"

local function blocked()
	return player:GetAttribute("BuildModeOpen")
		or player:GetAttribute("DrydockScreenOpen")
		or player:GetAttribute("RodCrateOpening")
end

local function clearInput()
	table.clear(touchKeys)
	moveStick, lookStick = Vector2.zero, Vector2.zero
	gamepadUp, gamepadDown = false, false
	lookTouch, dragging = nil, false
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
end

local function makeTouchControls()
	if not UserInputService.TouchEnabled then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name, gui.ResetOnSpawn = "FreecamControls", false
	gui.DisplayOrder = 10
	gui.Parent = player:WaitForChild("PlayerGui")
	touchGui = gui
	local buttons = {
		{ "W", "▲", 72, -162 },
		{ "A", "◀", 20, -110 },
		{ "S", "▼", 72, -110 },
		{ "D", "▶", 124, -110 },
		{ "E", "Up", -120, -162 },
		{ "Q", "Down", -120, -110 },
	}
	for _, spec in buttons do
		local key, label, x, y = unpack(spec)
		local button = Instance.new("TextButton")
		button.Name, button.Text = key, label
		button.Size = UDim2.fromOffset(48, 48)
		button.Position = UDim2.new(if x < 0 then 1 else 0, x, 1, y)
		button.BackgroundColor3 = Color3.fromRGB(24, 44, 58)
		button.BackgroundTransparency = 0.2
		button.TextColor3 = Color3.new(1, 1, 1)
		button.TextSize = 18
		button.Parent = gui
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = button
		button.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				touchKeys[key] = true
			end
		end)
		button.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				touchKeys[key] = nil
			end
		end)
	end
end

local function shiftDown(): boolean
	return UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
end

local function turn(delta: Vector2)
	yaw -= delta.X * 0.004
	pitch = math.clamp(pitch - delta.Y * 0.004, -math.rad(89), math.rad(89))
end

local function update(dt: number)
	local camera = workspace.CurrentCamera
	if not camera or blocked() then
		Freecam.stop()
		return
	end
	local menuOpen = player:GetAttribute("PlayerMenuOpen") or UserInputService:GetFocusedTextBox()
	local function down(key: Enum.KeyCode): number
		return if not menuOpen and (UserInputService:IsKeyDown(key) or touchKeys[key.Name]) then 1 else 0
	end
	if not menuOpen then
		yaw -= lookStick.X * dt * 2.2
		pitch = math.clamp(pitch + lookStick.Y * dt * 2.2, -math.rad(89), math.rad(89))
	end
	local rotation = CFrame.fromOrientation(pitch, yaw, 0)
	local x = down(Enum.KeyCode.D) - down(Enum.KeyCode.A) + (if menuOpen then 0 else moveStick.X)
	local y = down(Enum.KeyCode.E)
		- down(Enum.KeyCode.Q)
		+ (if not menuOpen and gamepadUp then 1 else 0)
		- (if not menuOpen and gamepadDown then 1 else 0)
	local z = down(Enum.KeyCode.S) - down(Enum.KeyCode.W) - (if menuOpen then 0 else moveStick.Y)
	local direction = Vector3.new(x, y, z)
	if direction.Magnitude > 1 then
		direction = direction.Unit
	end
	local speed = if shiftDown() then 72 else 32
	local movement = rotation:VectorToWorldSpace(Vector3.new(direction.X, 0, direction.Z)) + Vector3.yAxis * direction.Y
	position += movement * speed * math.min(dt, 0.1)
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.new(position) * rotation
	camera.Focus = camera.CFrame * CFrame.new(0, 0, -16)
end

function Freecam.stop()
	if not active then
		return
	end
	active = false
	RunService:UnbindFromRenderStep("FishingWatersFreecam")
	ContextActionService:UnbindAction(ACTION)
	clearInput()
	if touchGui then
		touchGui:Destroy()
		touchGui = nil
	end
	local camera = workspace.CurrentCamera
	if camera and saved then
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		camera.CameraSubject = if saved.subject and saved.subject:IsDescendantOf(workspace)
			then saved.subject
			else humanoid
		camera.CameraType = if saved.kind == Enum.CameraType.Scriptable then Enum.CameraType.Custom else saved.kind
		camera.FieldOfView = saved.fov
	end
	saved = nil
	player:SetAttribute("FreecamEnabled", false)
	BoatCamera.refresh()
end

function Freecam.setEnabled(enabled: boolean)
	if not enabled then
		Freecam.stop()
		return
	end
	if active or blocked() then
		return
	end
	local camera = workspace.CurrentCamera
	if not camera or (camera.CameraType == Enum.CameraType.Scriptable and not BoatCamera.isActive()) then
		return
	end
	saved = { kind = camera.CameraType, subject = camera.CameraSubject, fov = camera.FieldOfView }
	position = camera.CFrame.Position
	pitch, yaw = camera.CFrame:ToOrientation()
	active = true
	player:SetAttribute("FreecamEnabled", true)
	camera.CameraType = Enum.CameraType.Scriptable
	ContextActionService:BindActionAtPriority(ACTION, function()
		return Enum.ContextActionResult.Sink
	end, false, 3000, unpack(Enum.PlayerActions:GetEnumItems()))
	makeTouchControls()
	RunService:BindToRenderStep("FishingWatersFreecam", Enum.RenderPriority.Camera.Value + 2, update)
end

function Freecam.start()
	if started then
		return
	end
	started = true
	player:SetAttribute("FreecamEnabled", false)
	UserInputService.InputBegan:Connect(function(input, processed)
		if
			input.KeyCode == Enum.KeyCode.P
			and not processed
			and not UserInputService:GetFocusedTextBox()
			and shiftDown()
		then
			Freecam.setEnabled(not active)
		elseif active and not player:GetAttribute("PlayerMenuOpen") then
			if input.KeyCode == Enum.KeyCode.ButtonR2 then
				gamepadUp = true
			elseif input.KeyCode == Enum.KeyCode.ButtonL2 then
				gamepadDown = true
			elseif not processed and input.UserInputType == Enum.UserInputType.MouseButton2 then
				dragging = true
				UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
			elseif not processed and input.UserInputType == Enum.UserInputType.Touch and not lookTouch then
				lookTouch = input
			end
		end
	end)
	UserInputService.InputChanged:Connect(function(input, processed)
		if not active or player:GetAttribute("PlayerMenuOpen") or UserInputService:GetFocusedTextBox() then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
			turn(Vector2.new(input.Delta.X, input.Delta.Y))
		elseif input == lookTouch then
			turn(Vector2.new(input.Delta.X, input.Delta.Y))
		elseif input.KeyCode == Enum.KeyCode.Thumbstick1 then
			local stick = Vector2.new(input.Position.X, input.Position.Y)
			moveStick = if stick.Magnitude > 0.15 then stick else Vector2.zero
		elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
			local stick = Vector2.new(input.Position.X, input.Position.Y)
			lookStick = if stick.Magnitude > 0.15 then stick else Vector2.zero
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.ButtonR2 then
			gamepadUp = false
		elseif input.KeyCode == Enum.KeyCode.ButtonL2 then
			gamepadDown = false
		elseif dragging and input.UserInputType == Enum.UserInputType.MouseButton2 then
			dragging = false
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		elseif input == lookTouch then
			lookTouch = nil
		end
	end)
	local function clearIfActive()
		if active then
			clearInput()
		end
	end
	UserInputService.WindowFocusReleased:Connect(clearIfActive)
	UserInputService.TextBoxFocused:Connect(clearIfActive)
	player:GetAttributeChangedSignal("PlayerMenuOpen"):Connect(function()
		if active and player:GetAttribute("PlayerMenuOpen") then
			clearInput()
		end
	end)
	player.CharacterAdded:Connect(Freecam.stop)
end

return Freecam
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="325">
          <Properties>
            <string name="Name">FurniturePreview</string>
            <string name="Source"><![CDATA[-- Inventory thumbnails use the actual furniture builders' replicated templates,
-- so buying an item does not require its showroom or a placed copy to be streamed in.
local Preview = {}

-- Non-yielding clone for a world-space placement ghost. All templates are built
-- at the origin by the server, so their original pivot also retains that frame.
function Preview.clone(remotes: Instance, itemId: string): Model?
	local templates = remotes:FindFirstChild("Previews")
	local template = templates and templates:FindFirstChild(itemId)
	if not template or not template:IsA("Model") then return nil end
	return template:Clone()
end

function Preview.show(view: ViewportFrame, remotes: Instance, itemId: string)
	task.spawn(function()
		local templates = remotes:WaitForChild("Previews", 10)
		local template = templates and templates:WaitForChild(itemId, 10)
		if not template or not template:IsA("Model") or not view.Parent then
			return
		end
		local world = Instance.new("WorldModel")
		world.Parent = view
		local model = template:Clone()
		model.Parent = world
		local box, size = model:GetBoundingBox()
		local camera = Instance.new("Camera")
		camera.FieldOfView = 32
		camera.Parent = view
		view.CurrentCamera = camera
		view.Ambient = Color3.fromRGB(185, 185, 185)
		view.LightColor = Color3.fromRGB(255, 244, 226)
		view.LightDirection = Vector3.new(-1, -1, -2)
		local function frame()
			local aspect = math.max(0.1, view.AbsoluteSize.X / math.max(1, view.AbsoluteSize.Y))
			local direction = Vector3.new(1, 0.65, 1).Unit
			local orientation = CFrame.lookAt(Vector3.zero, -direction)
			local tangent = math.tan(math.rad(camera.FieldOfView / 2))
			local distance = 0.5
			for _, x in { -size.X / 2, size.X / 2 } do
				for _, y in { -size.Y / 2, size.Y / 2 } do
					for _, z in { -size.Z / 2, size.Z / 2 } do
						local corner = orientation:VectorToObjectSpace(box * Vector3.new(x, y, z) - box.Position)
						distance = math.max(distance, corner.Z + math.abs(corner.X) / (tangent * aspect), corner.Z + math.abs(corner.Y) / tangent)
					end
				end
			end
			camera.CFrame = CFrame.lookAt(box.Position + direction * distance * 1.12, box.Position)
		end
		view:GetPropertyChangedSignal("AbsoluteSize"):Connect(frame)
		frame()
	end)
end

return Preview
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="326">
          <Properties>
            <string name="Name">FurnitureShop</string>
            <string name="Source"><![CDATA[-- Harbour Home's catalogue, opened from showroom displays or the indoor counter. Bought
-- furniture waits in your stock until you place it from build mode at home.
-- Prices and stock come from the server; this window only displays them.
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Furniture = require(ReplicatedStorage.Shared.FurnitureCatalog)
local FurniturePreview = require(script.Parent.FurniturePreview)
local Paths = require(ReplicatedStorage.Shared.Paths)
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))

local FurnitureShop = {}
local started = false

local function make(class: string, parent: Instance?, props: { [string]: any }): any
	local item = Instance.new(class)
	for key, value in props do
		item[key] = value
	end
	item.Parent = parent
	return item
end

local function notice(message: string)
	pcall(StarterGui.SetCore, StarterGui, "SendNotification", {
		Title = "Harbour Home",
		Text = message,
		Duration = 5,
	})
end

function FurnitureShop.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local remotes = ReplicatedStorage:WaitForChild("Furniture")
	local request = remotes:WaitForChild("Request") :: RemoteFunction
	local update = remotes:WaitForChild("Update") :: RemoteEvent

	local gui = make("ScreenGui", player:WaitForChild("PlayerGui"), {
		Name = "FurnitureShop",
		ResetOnSpawn = false,
		DisplayOrder = 28,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	local overlay = make("TextButton", gui, {
		Name = "ShopOverlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(),
		BackgroundTransparency = 0.4,
		Text = "",
		AutoButtonColor = false,
		Visible = false,
	})
	local card = make("Frame", overlay, {
		Name = "FurnitureCatalogue",
		Active = true,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -28, 0, 470),
	})
	make("UISizeConstraint", card, { MaxSize = Vector2.new(560, 470) })
	Theme.window(card)
	local function label(parent: Instance, text: string, props: { [string]: any }): TextLabel
		local item = make("TextLabel", parent, {
			BackgroundTransparency = 1,
			Text = text,
			TextSize = 15,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
		})
		Theme.text(item, props.TextColor3)
		for key, value in props do
			item[key] = value
		end
		return item
	end
	label(card, "PLAZA · HARBOUR HOME", {
		Position = UDim2.fromOffset(22, 18),
		Size = UDim2.new(1, -90, 0, 18),
		TextSize = 12,
		TextColor3 = Theme.Colors.Muted,
	})
	label(card, "Furniture for your fish shop", {
		Position = UDim2.fromOffset(22, 38),
		Size = UDim2.new(1, -90, 0, 30),
		TextSize = 22,
	})
	local status = label(card, "", {
		Position = UDim2.fromOffset(22, 72),
		Size = UDim2.new(1, -44, 0, 36),
		TextSize = 13,
		TextColor3 = Theme.Colors.Muted,
		Font = Enum.Font.Gotham,
	})
	local close = make("TextButton", card, {
		Name = "CloseShop",
		Position = UDim2.new(1, -52, 0, 12),
		Size = UDim2.fromOffset(38, 38),
		Text = "×",
		TextSize = 28,
		ZIndex = 3,
	})
	Theme.button(close, "Danger")

	local rows = {}
	local state = nil
	local pending = false
	local selectedItem: string? = nil
	local activePrompt: ProximityPrompt? = nil
	local category = "All"
	local categoryButtons = {}
	local previewStarted = {}
	local list: ScrollingFrame
	local function render()
		local cash = if state then state.Cash else 0
		status.Text = if not state
			then "Loading your shop…"
			else string.format(
				"Cash $%d · %d coolers (capacity depends on fish size) · Racks hold %d fish\nPress B (or Build) at home to place what you buy.",
				cash,
				state.FreezerCount,
				state.StorageCapacity
			)
		for name, button in categoryButtons do
			button.Visible = selectedItem == nil
			Theme.button(button, if category == name then "Selected" else "Normal")
		end
		list.Position = UDim2.fromOffset(18, if selectedItem then 118 else 158)
		list.Size = UDim2.new(1, -36, 1, if selectedItem then -132 else -172)
		for _, id in Furniture.Order do
			local item, row = Furniture.Items[id], rows[id]
			row.frame.Visible = if selectedItem
				then selectedItem == id
				else category == "All"
					or (category == "Decorations" and item.Decoration == true)
					or (category == "Equipment" and not item.Decoration)
			if row.frame.Visible and not previewStarted[id] then
				previewStarted[id] = true
				FurniturePreview.show(row.preview, remotes, id)
			end
			local owned = if state then state.Stock[id] or 0 else 0
			local placed = if state then Furniture.count(state.Placed, id) else 0
			local locked = state ~= nil and Furniture.locked(id, state.Unlocked) ~= nil
			row.detail.Text = string.format(
				"%s\n%s · %d placed, %d in stock (max %d placed)",
				item.Description,
				Furniture.roomNames(id),
				placed,
				owned,
				item.MaxPlaced
			)
			local enabled = state ~= nil and not pending and not locked and cash >= item.Price
			row.buy.Text = if pending
				then "Please wait…"
				elseif locked then "Needs " .. Paths.Stages[item.Requires].Name
				else "Buy · $" .. item.Price
			row.buy.Active, row.buy.AutoButtonColor = enabled, enabled
			Theme.button(row.buy, if enabled then "Selected" else "Disabled")
		end
	end
	list = make("ScrollingFrame", card, {
		Name = "CatalogueRows",
		Position = UDim2.fromOffset(18, 118),
		Size = UDim2.new(1, -36, 1, -132),
		BackgroundTransparency = 1,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	})
	Theme.scroll(list)
	for index, name in { "All", "Equipment", "Decorations" } do
		local button = make("TextButton", card, {
			Name = name .. "Category",
			Position = UDim2.new((index - 1) / 3, 18, 0, 115),
			Size = UDim2.new(1 / 3, -16, 0, 32),
			Text = name,
			TextSize = 13,
		})
		button.Activated:Connect(function()
			category = name
			list.CanvasPosition = Vector2.zero
			render()
		end)
		categoryButtons[name] = button
	end
	make("UIListLayout", list, { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10) })
	for index, id in Furniture.Order do
		local item = Furniture.Items[id]
		local row = make("Frame", list, {
			Name = id .. "Row",
			LayoutOrder = index,
			Size = UDim2.new(1, -10, 0, 150),
		})
		Theme.panel(row, true, 8)
		local preview = make("ViewportFrame", row, {
			Name = "Preview",
			Position = UDim2.fromOffset(10, 12),
			Size = UDim2.fromOffset(66, 66),
			BackgroundTransparency = 1,
		})
		label(row, item.Name, {
			Position = UDim2.fromOffset(84, 10),
			Size = UDim2.new(1, -96, 0, 22),
			TextSize = 17,
		})
		local detail = label(row, "", {
			Position = UDim2.fromOffset(84, 36),
			Size = UDim2.new(1, -96, 0, 72),
			TextSize = 12,
			Font = Enum.Font.Gotham,
			TextColor3 = Theme.Colors.Muted,
		})
		local buy = make("TextButton", row, {
			Name = "Buy" .. id,
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -12, 1, -7),
			Size = UDim2.fromOffset(140, 30),
			TextSize = 15,
		})
		buy.Activated:Connect(function()
			if pending or not buy.Active or not overlay.Visible then
				return
			end
			pending = true
			render()
			local ok, result = pcall(request.InvokeServer, request, "Buy", id)
			pending = false
			if ok and type(result) == "table" then
				state = result.State or state
				if result.Message ~= "" then
					notice(result.Message)
				end
			else
				notice("The shop couldn't be reached. Try again.")
			end
			render()
		end)
		rows[id] = { frame = row, detail = detail, buy = buy, preview = preview }
	end

	local function refresh()
		local ok, result = pcall(request.InvokeServer, request, "Get")
		if ok and type(result) == "table" and result.State then
			state = result.State
		end
		render()
	end
	local function hide()
		overlay.Visible = false
		activePrompt = nil
	end
	close.Activated:Connect(hide)
	overlay.Activated:Connect(hide)
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			hide()
		end
	end)
	player.CharacterRemoving:Connect(hide)
	update.OnClientEvent:Connect(function(kind, payload)
		if kind == "State" and type(payload) == "table" then
			state = payload
			render()
		elseif kind == "Notice" and type(payload) == "string" then
			notice(payload)
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
		if who == player and prompt.Name == "BrowseFurniturePrompt" then
			local itemId = prompt:GetAttribute("ItemId")
			selectedItem = if type(itemId) == "string" and Furniture.Items[itemId] then itemId else nil
			activePrompt = prompt
			list.CanvasPosition = Vector2.zero
			card.Size = UDim2.new(1, -28, 0, if selectedItem then 293 else 470)
			overlay.Visible = true
			render()
			task.spawn(refresh)
		end
	end)
	-- Walking away from the current display or leaving the shop closes the catalogue.
	task.spawn(function()
		while true do
			task.wait(0.5)
			if overlay.Visible then
				local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				local anchor = activePrompt and activePrompt.Parent
				local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
				local near = root
					and humanoid
					and humanoid.Health > 0
					and anchor
					and anchor:IsA("BasePart")
					and anchor:IsDescendantOf(workspace)
					and (anchor.Position - root.Position).Magnitude
						<= (activePrompt :: ProximityPrompt).MaxActivationDistance + 2
				if not near then
					hide()
				end
			end
		end
	end)
	render()
end

return FurnitureShop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="327">
          <Properties>
            <string name="Name">HalloweenParty</string>
            <string name="Source"><![CDATA[-- The Halloween party on the client: the guests' speech bubbles (now and then on their own, and
-- whenever someone talks to one), the floating ghosts and the giant pumpkin bobbing, bats circling
-- the square, and the orange fireworks over the fountain at the midnight into 1 November.
-- The server builds the party (src/server/HalloweenService.luau); the fireworks run off the shared
-- calendar, so every client starts them at the same moment.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Calendar = require(Shared:WaitForChild("Calendar"))
local Halloween = require(Shared:WaitForChild("Halloween"))

local Client = {}
local started = false

local GUEST_TAG = "HalloweenGuest"
local BOB_TAG = "HalloweenBob"
local PROMPT = "HalloweenGuestPrompt"
local GESTURES = {
	"rbxassetid://507770239", -- wave
	"rbxassetid://507770818", -- laugh
	"rbxassetid://507770453", -- point
	"rbxassetid://507770677", -- cheer
}
local CHEER = "rbxassetid://507770677"
local BUBBLE_SECONDS = 4.5
local CHATTER_RANGE = 80 -- studs from the camera within which guests chat on their own
local TALK_SECONDS = 6 -- a guest faces whoever talked to them this long
local SHOW_RANGE = 2500 -- studs from the plaza within which the fireworks are drawn
local BATS = 12
local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local WHOOSH = "rbxasset://sounds/Rocket whoosh 01.wav"

local player = Players.LocalPlayer
local rng = Random.new()
local bubbles: { [Model]: BillboardGui } = {}
local quietUntil: { [Model]: number } = {}
local bobBase: { [Model]: CFrame } = {}
local tracks: { [Model]: { [string]: AnimationTrack } } = {}

local function head(guest: Model): BasePart?
	local found = guest:FindFirstChild("Head")
	return if found and found:IsA("BasePart") then found else nil
end

local function playGesture(guest: Model, id: string)
	if guest:GetAttribute("Dancer") then
		return
	end
	local humanoid = guest:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	local cache = tracks[guest] or {}
	tracks[guest] = cache
	local track = cache[id]
	if not track then
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local ok, loaded = pcall(animator.LoadAnimation, animator, animation)
		if not ok then
			return
		end
		track = loaded
		track.Priority = Enum.AnimationPriority.Action
		cache[id] = track
	end
	track:Play(0.2)
end

local function say(guest: Model, text: string)
	local top = head(guest)
	if not top then
		return
	end
	if bubbles[guest] then
		bubbles[guest]:Destroy()
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "HalloweenBubble"
	gui.Adornee = top
	gui.Size = UDim2.fromOffset(220, 70)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0)
	gui.MaxDistance = CHATTER_RANGE
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	local frame = Instance.new("Frame")
	frame.AnchorPoint = Vector2.new(0.5, 1)
	frame.Position = UDim2.fromScale(0.5, 1)
	frame.Size = UDim2.fromScale(1, 1)
	frame.AutomaticSize = Enum.AutomaticSize.None
	frame.BackgroundColor3 = Color3.fromRGB(34, 22, 40)
	frame.BackgroundTransparency = 0.1
	frame.Parent = gui
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 140, 30)
	stroke.Thickness = 2
	stroke.Parent = frame
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft, padding.PaddingRight = UDim.new(0, 8), UDim.new(0, 8)
	padding.PaddingTop, padding.PaddingBottom = UDim.new(0, 4), UDim.new(0, 4)
	padding.Parent = frame
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextWrapped = true
	label.TextColor3 = Color3.fromRGB(255, 226, 180)
	label.Text = text
	label.Parent = frame
	local limit = Instance.new("UITextSizeConstraint")
	limit.MaxTextSize = 18
	limit.Parent = label
	gui.Parent = top
	bubbles[guest] = gui
	task.delay(BUBBLE_SECONDS, function()
		if bubbles[guest] == gui then
			bubbles[guest] = nil
		end
		gui:Destroy()
	end)
end

local function fireworksOn(): boolean
	return Halloween.phase(Calendar.now()) == "Fireworks"
end

local function line(): string
	local list = if fireworksOn() then Halloween.FIREWORK_LINES else Halloween.LINES
	return list[rng:NextInteger(1, #list)]
end

local function speak(guest: Model)
	quietUntil[guest] = os.clock() + BUBBLE_SECONDS + rng:NextNumber(4, 12)
	say(guest, line())
	playGesture(guest, if fireworksOn() then CHEER else GESTURES[rng:NextInteger(1, #GESTURES)])
end

-- Someone walked up and pressed Talk: the guest turns to them, answers and turns back later.
local function talkTo(guest: Model)
	local root = guest:FindFirstChild("HumanoidRootPart")
	local character = player.Character
	local mine = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") and mine and mine:IsA("BasePart") then
		local from = root.Position
		local target = Vector3.new(mine.Position.X, from.Y, mine.Position.Z)
		if (target - from).Magnitude > 0.1 then
			guest:PivotTo(CFrame.lookAt(from, target))
		end
		local home = guest:GetAttribute("HomeFrame")
		local token = os.clock()
		guest:SetAttribute("TalkToken", token)
		task.delay(TALK_SECONDS, function()
			if guest.Parent and guest:GetAttribute("TalkToken") == token and typeof(home) == "CFrame" then
				guest:PivotTo(home)
			end
		end)
	end
	speak(guest)
end

local function chatter()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local near = {}
	for _, guest in CollectionService:GetTagged(GUEST_TAG) do
		local top = guest:IsA("Model") and head(guest)
		if
			top
			and (top.Position - camera.CFrame.Position).Magnitude < CHATTER_RANGE
			and (quietUntil[guest] or 0) < os.clock()
		then
			table.insert(near, guest)
		end
	end
	if #near > 0 then
		speak(near[rng:NextInteger(1, #near)])
	end
end

-- Bats: little black flapping shapes circling the giant pumpkin while the party is up.
local function batModel(): Model
	local model = Instance.new("Model")
	model.Name = "HalloweenBat"
	local function piece(size: Vector3, frame: CFrame, name: string): Part
		local part = Instance.new("Part")
		part.Name = name
		part.Size = size
		part.CFrame = frame
		part.Color = Color3.fromRGB(20, 16, 24)
		part.Material = Enum.Material.SmoothPlastic
		part.Anchored = true
		part.CanCollide, part.CanQuery, part.CanTouch = false, false, false
		part.CastShadow = false
		part.Parent = model
		return part
	end
	local body = piece(Vector3.new(0.5, 0.45, 0.9), CFrame.new(), "Body")
	piece(Vector3.new(1.3, 0.08, 0.7), CFrame.new(-0.85, 0, 0), "LeftWing")
	piece(Vector3.new(1.3, 0.08, 0.7), CFrame.new(0.85, 0, 0), "RightWing")
	model.PrimaryPart = body
	return model
end

local bats: { { model: Model, radius: number, height: number, speed: number, phase: number } } = {}
local batFolder: Folder?

local function clearBats()
	if batFolder then
		batFolder:Destroy()
		batFolder = nil
	end
	table.clear(bats)
end

local function updateBats(plaza: CFrame?, now: number)
	local party = workspace:FindFirstChild("HalloweenParty")
	if not party or not plaza then
		clearBats()
		return
	end
	if not batFolder then
		local folder = Instance.new("Folder")
		folder.Name = "HalloweenBats"
		folder.Parent = workspace
		batFolder = folder
		for _ = 1, BATS do
			local model = batModel()
			model.Parent = folder
			table.insert(bats, {
				model = model,
				radius = rng:NextNumber(10, 30),
				height = rng:NextNumber(20, 34),
				speed = rng:NextNumber(0.35, 0.7) * (if rng:NextNumber() < 0.5 then -1 else 1),
				phase = rng:NextNumber(0, math.pi * 2),
			})
		end
	end
	for _, bat in bats do
		local angle = bat.phase + now * bat.speed
		local position = plaza
			* Vector3.new(
				math.cos(angle) * bat.radius,
				bat.height + math.sin(now * 1.7 + bat.phase) * 2,
				math.sin(angle) * bat.radius
			)
		local ahead = angle + 0.1 * math.sign(bat.speed)
		local toward = plaza * Vector3.new(math.cos(ahead) * bat.radius, bat.height, math.sin(ahead) * bat.radius)
		local frame = CFrame.lookAt(position, Vector3.new(toward.X, position.Y, toward.Z))
		local flap = math.sin(now * 18 + bat.phase) * 0.7
		local model = bat.model
		local body = model.PrimaryPart :: BasePart
		body.CFrame = frame
		local left, right = model:FindFirstChild("LeftWing") :: BasePart, model:FindFirstChild("RightWing") :: BasePart
		left.CFrame = frame * CFrame.Angles(0, 0, -flap) * CFrame.new(-0.85, 0, 0)
		right.CFrame = frame * CFrame.Angles(0, 0, flap) * CFrame.new(0.85, 0, 0)
	end
end

local function updateBobbing(now: number)
	for _, item in CollectionService:GetTagged(BOB_TAG) do
		if item:IsA("Model") and item.PrimaryPart then
			local base = bobBase[item]
			if not base then
				base = item:GetPivot()
				bobBase[item] = base
			end
			local phase = item:GetAttribute("BobPhase") or 0
			item:PivotTo(
				base
					* CFrame.new(0, math.sin(now * 1.3 + phase) * 1.2, 0)
					* CFrame.Angles(0, math.sin(now * 0.4 + phase) * 0.3, 0)
			)
		end
	end
end

-- Fireworks ---------------------------------------------------------------------------------------

local fireworksFolder: Folder?

local function burstColor(): Color3
	local rgbValues = Halloween.FIREWORK_COLORS[rng:NextInteger(1, #Halloween.FIREWORK_COLORS)]
	return Color3.fromRGB(rgbValues[1], rgbValues[2], rgbValues[3])
end

local function anchoredPart(name: string, position: Vector3): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = Vector3.new(0.4, 0.4, 0.4)
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide, part.CanQuery, part.CanTouch = false, false, false
	part.CastShadow = false
	part.CFrame = CFrame.new(position)
	part.Parent = fireworksFolder
	return part
end

local function burst(position: Vector3, finale: boolean)
	local color = burstColor()
	local holder = anchoredPart("Burst", position)
	local style = rng:NextInteger(1, 3)
	local sparks = Instance.new("ParticleEmitter")
	sparks.Texture = SPARKLE
	sparks.Color = ColorSequence.new(color, color:Lerp(Color3.fromRGB(255, 60, 0), 0.5))
	sparks.LightEmission = 1
	sparks.LightInfluence = 0
	sparks.Brightness = 3
	sparks.Rate = 0
	sparks.SpreadAngle = Vector2.new(180, 180)
	sparks.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.4),
		NumberSequenceKeypoint.new(0.7, 0.9),
		NumberSequenceKeypoint.new(1, 0),
	})
	sparks.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.75, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	if style == 1 then -- peony: a round shell
		sparks.Speed = NumberRange.new(38, 44)
		sparks.Drag = 2.2
		sparks.Acceleration = Vector3.new(0, -10, 0)
		sparks.Lifetime = NumberRange.new(1.6, 2.2)
	elseif style == 2 then -- willow: long drooping trails
		sparks.Speed = NumberRange.new(26, 34)
		sparks.Drag = 1.4
		sparks.Acceleration = Vector3.new(0, -16, 0)
		sparks.Lifetime = NumberRange.new(2.6, 3.4)
	else -- chrysanthemum: fast, crackling
		sparks.Speed = NumberRange.new(48, 60)
		sparks.Drag = 3
		sparks.Acceleration = Vector3.new(0, -6, 0)
		sparks.Lifetime = NumberRange.new(1.1, 1.6)
		sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
	end
	sparks.Parent = holder
	sparks:Emit(if finale then 160 else 120)
	local flash = Instance.new("PointLight")
	flash.Color = color
	flash.Range = 60
	flash.Brightness = 6
	flash.Shadows = false
	flash.Parent = holder
	local boom = Instance.new("Explosion")
	boom.Position = position
	boom.BlastRadius = 0
	boom.BlastPressure = 0
	boom.DestroyJointRadiusPercent = 0
	boom.Visible = false
	boom.Parent = holder
	task.spawn(function()
		for step = 1, 10 do
			task.wait(0.05)
			flash.Brightness = 6 * (1 - step / 10)
		end
		flash:Destroy()
	end)
	task.delay(5, function()
		holder:Destroy()
	end)
end

local function launch(plaza: CFrame, finale: boolean)
	local angle, radius = rng:NextNumber(0, math.pi * 2), rng:NextNumber(4, 30)
	local from = plaza * Vector3.new(math.cos(angle) * radius, 0.5, math.sin(angle) * radius)
	local apex = from + Vector3.new(rng:NextNumber(-10, 10), rng:NextNumber(60, 95), rng:NextNumber(-10, 10))
	local rocket = anchoredPart("Rocket", from)
	rocket.Transparency = 0
	rocket.Material = Enum.Material.Neon
	rocket.Color = Color3.fromRGB(255, 200, 120)
	rocket.Size = Vector3.new(0.35, 0.35, 0.35)
	local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
	a0.Position, a1.Position = Vector3.new(0, 0.15, 0), Vector3.new(0, -0.15, 0)
	a0.Parent, a1.Parent = rocket, rocket
	local trail = Instance.new("Trail")
	trail.Attachment0, trail.Attachment1 = a0, a1
	trail.Lifetime = 0.5
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(Color3.fromRGB(255, 190, 100), Color3.fromRGB(255, 90, 0))
	trail.Transparency = NumberSequence.new(0, 1)
	trail.WidthScale = NumberSequence.new(1, 0)
	trail.FaceCamera = true
	trail.Parent = rocket
	local whoosh = Instance.new("Sound")
	whoosh.SoundId = WHOOSH
	whoosh.Volume = 0.35
	whoosh.PlaybackSpeed = rng:NextNumber(0.9, 1.2)
	whoosh.RollOffMaxDistance = 600
	whoosh.Parent = rocket
	whoosh:Play()
	local duration = rng:NextNumber(1.1, 1.7)
	local began = os.clock()
	local connection
	connection = RunService.Heartbeat:Connect(function()
		local t = math.min((os.clock() - began) / duration, 1)
		local eased = 1 - (1 - t) * (1 - t)
		rocket.CFrame = CFrame.new(from:Lerp(apex, eased))
		if t >= 1 then
			connection:Disconnect()
			burst(rocket.Position, finale)
			rocket.Transparency = 1
			task.delay(trail.Lifetime, function()
				rocket:Destroy()
			end)
		end
	end)
end

local nextLaunch = 0

local function updateFireworks(plaza: CFrame?)
	local date = Calendar.now()
	local on = Halloween.phase(date) == "Fireworks" and plaza ~= nil
	if not on then
		if fireworksFolder and #fireworksFolder:GetChildren() == 0 then
			fireworksFolder:Destroy()
			fireworksFolder = nil
		end
		return
	end
	local camera = workspace.CurrentCamera
	if not camera or (camera.CFrame.Position - (plaza :: CFrame).Position).Magnitude > SHOW_RANGE then
		return
	end
	if not fireworksFolder then
		local folder = Instance.new("Folder")
		folder.Name = "HalloweenFireworks"
		folder.Parent = workspace
		fireworksFolder = folder
	end
	local now = os.clock()
	if now < nextLaunch then
		return
	end
	local finale = date.Hour >= Halloween.FIREWORKS_HOURS - Halloween.FINALE_HOURS
	launch(plaza :: CFrame, finale)
	if finale and rng:NextNumber() < 0.5 then
		launch(plaza :: CFrame, true)
	end
	nextLaunch = now + if finale then rng:NextNumber(0.08, 0.22) else rng:NextNumber(0.35, 0.95)
end

function Client.start()
	if started then
		return
	end
	started = true
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		if prompt.Name ~= PROMPT then
			return
		end
		local guest = prompt:FindFirstAncestorWhichIsA("Model")
		if guest and guest:HasTag(GUEST_TAG) then
			talkTo(guest)
		end
	end)
	CollectionService:GetInstanceRemovedSignal(GUEST_TAG):Connect(function(guest)
		quietUntil[guest] = nil
		tracks[guest] = nil
		if bubbles[guest] then
			bubbles[guest]:Destroy()
			bubbles[guest] = nil
		end
	end)
	CollectionService:GetInstanceRemovedSignal(BOB_TAG):Connect(function(item)
		bobBase[item] = nil
	end)
	local nextChatter = 0
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		local plaza = workspace:GetAttribute("HalloweenPlaza")
		local frame = if typeof(plaza) == "CFrame" then plaza else nil
		updateBobbing(now)
		updateBats(frame, now)
		updateFireworks(frame)
		if now >= nextChatter then
			nextChatter = now + rng:NextNumber(1.2, 2.6)
			chatter()
		end
	end)
end

return Client
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="328">
          <Properties>
            <string name="Name">Kitchen</string>
            <string name="Source"><![CDATA[-- Recipe picker for the Supermarket path's kitchen stations. Pressing Cook at a
-- station lists what it can make from the fish you carry; the server checks the
-- fish, the station and the recipe again before anything cooks.
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))

local Kitchen = {}
local started = false

local function make(class: string, parent: Instance?, props: { [string]: any }): any
	local item = Instance.new(class)
	for key, value in props do
		item[key] = value
	end
	item.Parent = parent
	return item
end

local function notice(message: string)
	pcall(StarterGui.SetCore, StarterGui, "SendNotification", {
		Title = "Kitchen",
		Text = message,
		Duration = 5,
	})
end

function Kitchen.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local remotes = ReplicatedStorage:WaitForChild("Kitchen")
	local request = remotes:WaitForChild("Request") :: RemoteFunction
	local update = remotes:WaitForChild("Update") :: RemoteEvent

	local gui = make("ScreenGui", player:WaitForChild("PlayerGui"), {
		Name = "KitchenRecipes",
		ResetOnSpawn = false,
		DisplayOrder = 28,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	local overlay = make("TextButton", gui, {
		Name = "KitchenOverlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(),
		BackgroundTransparency = 0.45,
		Text = "",
		AutoButtonColor = false,
		Visible = false,
	})
	local card = make("Frame", overlay, {
		Name = "RecipeCard",
		Active = true,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -28, 0, 380),
	})
	make("UISizeConstraint", card, { MaxSize = Vector2.new(520, 380) })
	Theme.window(card)
	local function label(parent: Instance, text: string, props: { [string]: any }): TextLabel
		local item = make("TextLabel", parent, {
			BackgroundTransparency = 1,
			Text = text,
			TextSize = 15,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
		})
		Theme.text(item, props.TextColor3)
		for key, value in props do
			item[key] = value
		end
		return item
	end
	local title = label(card, "Kitchen", {
		Position = UDim2.fromOffset(22, 18),
		Size = UDim2.new(1, -90, 0, 30),
		TextSize = 22,
	})
	local status = label(card, "", {
		Position = UDim2.fromOffset(22, 52),
		Size = UDim2.new(1, -44, 0, 40),
		TextSize = 13,
		Font = Enum.Font.Gotham,
		TextColor3 = Theme.Colors.Muted,
	})
	local close = make("TextButton", card, {
		Name = "CloseKitchen",
		Position = UDim2.new(1, -52, 0, 12),
		Size = UDim2.fromOffset(38, 38),
		Text = "×",
		TextSize = 28,
		ZIndex = 3,
	})
	Theme.button(close, "Danger")
	local list = make("ScrollingFrame", card, {
		Name = "Recipes",
		Position = UDim2.fromOffset(18, 100),
		Size = UDim2.new(1, -36, 1, -116),
		BackgroundTransparency = 1,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	})
	Theme.scroll(list)
	make("UIListLayout", list, { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) })

	local stationKey: string? = nil
	local activePrompt: ProximityPrompt? = nil
	local options = nil
	local pending = false
	local render
	local function hide()
		overlay.Visible = false
		stationKey, activePrompt, options = nil, nil, nil
	end
	local function cook(recipeId: string)
		if pending or not stationKey then
			return
		end
		pending = true
		render()
		local ok, result = pcall(request.InvokeServer, request, "Cook", stationKey, recipeId)
		pending = false
		if ok and type(result) == "table" then
			if result.Message ~= "" then
				notice(result.Message)
			end
			if result.Ok then
				hide()
				return
			end
			options = result.Options or options
		else
			notice("The kitchen couldn't be reached. Try again.")
		end
		render()
	end
	render = function()
		for _, child in list:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		if not options then
			title.Text = "Kitchen"
			status.Text = "Checking the station…"
			return
		end
		title.Text = options.Station
		status.Text = if options.Fish
			then string.format(
				"Carrying a %s %s ($%d) · Kitchen pass %d/%d dishes",
				options.Rarity or "",
				options.Fish,
				options.FishValue or 0,
				options.Pantry,
				options.PantryCapacity
			)
			else "Take a fish from your freezer (F) or boat, equip it and come back to cook."
		for index, recipe in options.Recipes do
			local row = make("Frame", list, {
				Name = recipe.Id .. "Recipe",
				LayoutOrder = index,
				Size = UDim2.new(1, -10, 0, 74),
			})
			Theme.panel(row, true, 8)
			label(row, recipe.Name, {
				Position = UDim2.fromOffset(12, 8),
				Size = UDim2.new(1, -170, 0, 22),
				TextSize = 16,
			})
			label(row, recipe.Problem or string.format("Sells for $%d · ready in %ds", recipe.Value or 0, recipe.Seconds), {
				Position = UDim2.fromOffset(12, 32),
				Size = UDim2.new(1, -170, 0, 36),
				TextSize = 12,
				Font = Enum.Font.Gotham,
				TextColor3 = if recipe.Problem then Theme.Colors.Muted else Theme.Colors.Green,
			})
			local enabled = recipe.Problem == nil and not pending
			local button = make("TextButton", row, {
				Name = "Cook" .. recipe.Id,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.fromOffset(140, 42),
				TextSize = 15,
				Text = if pending then "Please wait…" else recipe.MinRarity .. "+ · Cook",
				Active = enabled,
				AutoButtonColor = enabled,
			})
			Theme.button(button, if enabled then "Selected" else "Disabled")
			button.Activated:Connect(function()
				if enabled then
					cook(recipe.Id)
				end
			end)
		end
	end
	close.Activated:Connect(hide)
	overlay.Activated:Connect(hide)
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			hide()
		end
	end)
	player.CharacterRemoving:Connect(hide)
	update.OnClientEvent:Connect(function(kind, payload)
		if kind == "Notice" and type(payload) == "string" then
			notice(payload)
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
		local key = prompt:GetAttribute("StationKey")
		if who ~= player or prompt.Name ~= "CookPrompt" or type(key) ~= "string" then
			return
		end
		stationKey, activePrompt, options = key, prompt, nil
		overlay.Visible = true
		render()
		task.spawn(function()
			local ok, result = pcall(request.InvokeServer, request, "Options", key)
			if stationKey ~= key then
				return
			end
			if ok and type(result) == "table" and result.Options then
				options = result.Options
			elseif ok and type(result) == "table" and result.Message ~= "" then
				notice(result.Message)
				hide()
				return
			end
			render()
		end)
	end)
	-- Walking away from the station closes the picker.
	task.spawn(function()
		while true do
			task.wait(0.5)
			if overlay.Visible then
				local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				local anchor = activePrompt and activePrompt.Parent
				if not (root and anchor and anchor:IsA("BasePart") and (anchor.Position - root.Position).Magnitude <= 10) then
					hide()
				end
			end
		end
	end)
end

return Kitchen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="329">
          <Properties>
            <string name="Name">KitchenStorage</string>
            <string name="Source"><![CDATA[-- Kitchen storage configuration GUI. Opened from build mode ("Edit storage" on a
-- selected kitchen storage counter). The owner picks how many fish of each rarity
-- (max 8 total) should wait on the ice bed for cooking; targets are sent to the
-- server which moves eligible fish from the freezer and storage racks onto the
-- prep table. Pure UI: the server re-validates every target.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Furniture = require(ReplicatedStorage.Shared.FurnitureCatalog)
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))

local KitchenStorage = {}
local started = false
local openStorage: (() -> ())? = nil

local RARITIES = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythical", "Exotic", "Divine", "Limited", "Admin" }
local CAPACITY = Furniture.KITCHEN_STORAGE_CAPACITY

local function make(class: string, parent: Instance?, props: { [string]: any }): any
	local item = Instance.new(class)
	for key, value in props do
		item[key] = value
	end
	item.Parent = parent
	return item
end

local function notice(message: string)
	pcall(StarterGui.SetCore, StarterGui, "SendNotification", {
		Title = "Kitchen Storage",
		Text = message,
		Duration = 5,
	})
end

function KitchenStorage.start()
	if started then
		return
	end
	started = true

	local player = Players.LocalPlayer
	local remotes = ReplicatedStorage:WaitForChild("KitchenStorage")
	local request = remotes:WaitForChild("Request") :: RemoteFunction

	local gui = make("ScreenGui", player:WaitForChild("PlayerGui"), {
		Name = "KitchenStorageGui",
		ResetOnSpawn = false,
		DisplayOrder = 28,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	local overlay = make("TextButton", gui, {
		Name = "StorageOverlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(),
		BackgroundTransparency = 0.45,
		Text = "",
		AutoButtonColor = false,
		Visible = false,
	})
	local card = make("Frame", overlay, {
		Name = "StorageCard",
		Active = true,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -28, 0, 420),
	})
	make("UISizeConstraint", card, { MaxSize = Vector2.new(520, 420) })
	Theme.window(card)

	local function label(parent: Instance, text: string, props: { [string]: any }): TextLabel
		local item = make("TextLabel", parent, {
			BackgroundTransparency = 1,
			Text = text,
			TextSize = 15,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
		})
		Theme.text(item, props.TextColor3)
		for key, value in props do
			item[key] = value
		end
		return item
	end

	local title = label(card, "Kitchen Storage", {
		Position = UDim2.fromOffset(22, 18),
		Size = UDim2.new(1, -90, 0, 30),
		TextSize = 22,
	})
	local status = label(card, "", {
		Position = UDim2.fromOffset(22, 52),
		Size = UDim2.new(1, -44, 0, 40),
		TextSize = 13,
		Font = Enum.Font.Gotham,
		TextColor3 = Theme.Colors.Muted,
	})
	local close = make("TextButton", card, {
		Name = "CloseStorage",
		Position = UDim2.new(1, -52, 0, 12),
		Size = UDim2.fromOffset(38, 38),
		Text = "×",
		TextSize = 28,
		ZIndex = 3,
	})
	Theme.button(close, "Danger")

	local list = make("ScrollingFrame", card, {
		Name = "Rarities",
		Position = UDim2.fromOffset(18, 100),
		Size = UDim2.new(1, -36, 1, -176),
		BackgroundTransparency = 1,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	})
	Theme.scroll(list)
	make("UIListLayout", list, { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10) })

	local totalBar = make("Frame", card, {
		Name = "TotalBar",
		Position = UDim2.fromOffset(18, 0),
		Size = UDim2.new(1, -36, 0, 26),
		BackgroundTransparency = 1,
	})
	Theme.panel(totalBar, true, 8)
	local totalLabel = label(totalBar, "", {
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(1, -140, 0, 18),
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	local setTargets = make("TextButton", card, {
		Name = "SetTargets",
		Position = UDim2.new(1, -152, 1, -34),
		Size = UDim2.fromOffset(140, 38),
		TextSize = 15,
		Text = "Set Targets",
	})
	Theme.button(setTargets)

	local rows = {} -- [rarity] = { frame, countLabel, minus, plus, availableLabel }
	local targets: { [string]: number } = {}
	local available: { [string]: number } = {}
	local pending = false

	local function render()
		local total = 0
		for _, rarity in RARITIES do
			total += targets[rarity] or 0
		end
		totalLabel.Text = string.format("Total: %d/%d fish", total, CAPACITY)
		local overCap = total > CAPACITY
		totalLabel.TextColor3 = if overCap then Color3.fromRGB(238, 107, 111) else Theme.Colors.Text

		for _, rarity in RARITIES do
			local row = rows[rarity]
			if not row then
				continue
			end
			local count = targets[rarity] or 0
			row.countLabel.Text = tostring(count)
			row.availableLabel.Text = string.format("Available: %d", available[rarity] or 0)
			row.minus.Active = count > 0 and not pending
			row.minus.AutoButtonColor = row.minus.Active
			Theme.button(row.minus, if row.minus.Active then "Normal" else "Disabled")
			row.plus.Active = total < CAPACITY and not pending
			row.plus.AutoButtonColor = row.plus.Active
			Theme.button(row.plus, if row.plus.Active then "Normal" else "Disabled")
		end

		status.Text = string.format(
			"Pick how many fish of each rarity should wait on the ice. %d/%d targeted.",
			total,
			CAPACITY
		)
		setTargets.Active = not pending and total <= CAPACITY
		setTargets.AutoButtonColor = setTargets.Active
		Theme.button(setTargets, if setTargets.Active then "Selected" else "Disabled")
	end

	local function adjust(rarity: string, delta: number)
		if pending then
			return
		end
		local total = 0
		for _, value in pairs(targets) do
			total += value
		end
		local current = targets[rarity] or 0
		local count = math.clamp(current + delta, 0, math.max(current, CAPACITY - (total - current)))
		targets[rarity] = count
		render()
	end

	for index, rarity in RARITIES do
		local catalog = require(ReplicatedStorage.Shared.AnglerCatalog)
		local color = catalog.Rarities[rarity].Color
		local row = make("Frame", list, {
			Name = rarity .. "Row",
			LayoutOrder = index,
			Size = UDim2.new(1, -10, 0, 64),
		})
		Theme.panel(row, true, 8)

		local rarityLabel = label(row, rarity, {
			Position = UDim2.fromOffset(14, 10),
			Size = UDim2.new(0, 96, 0, 20),
			TextSize = 16,
			TextColor3 = color,
		})
		local availableLabel = label(row, "", {
			Position = UDim2.fromOffset(14, 34),
			Size = UDim2.new(0, 96, 0, 16),
			TextSize = 12,
			Font = Enum.Font.Gotham,
			TextColor3 = Theme.Colors.Muted,
			Name = rarity .. "Available",
		})

		local minus = make("TextButton", row, {
			Name = "Minus" .. rarity,
			Position = UDim2.new(0.5, -74, 0.5, 0),
			Size = UDim2.fromOffset(32, 32),
			Text = "−",
			TextSize = 20,
		})
		Theme.button(minus)
		local countLabel = make("TextLabel", row, {
			Name = "Count" .. rarity,
			Position = UDim2.new(0.5, -16, 0.5, 0),
			Size = UDim2.fromOffset(32, 32),
			Text = "0",
			TextSize = 18,
			Font = Enum.Font.GothamBold,
		})
		Theme.text(countLabel)
		countLabel.BackgroundTransparency = 1
		countLabel.BorderSizePixel = 0
		local plus = make("TextButton", row, {
			Name = "Plus" .. rarity,
			Position = UDim2.new(0.5, 42, 0.5, 0),
			Size = UDim2.fromOffset(32, 32),
			Text = "+",
			TextSize = 20,
		})
		Theme.button(plus)

		minus.Activated:Connect(function()
			adjust(rarity, -1)
		end)
		plus.Activated:Connect(function()
			adjust(rarity, 1)
		end)

		rows[rarity] = {
			frame = row,
			countLabel = countLabel,
			availableLabel = availableLabel,
			minus = minus,
			plus = plus,
		}
	end

	local function fetch()
		local ok, result = pcall(request.InvokeServer, request, "Get")
		if not ok or type(result) ~= "table" or not result.Ok then
			notice("Couldn't load kitchen storage. Try again.")
			return
		end
		available = result.Available or {}
		targets = {}
		for _, rarity in RARITIES do
			targets[rarity] = (result.Targets or {})[rarity] or 0
		end
		render()
	end

	local function hide()
		overlay.Visible = false
	end

	local function setTargetsPressed()
		if pending then
			return
		end
		local total = 0
		for _, c in pairs(targets) do
			total += c
		end
		if total > CAPACITY then
			notice("Kitchen storage can hold at most " .. CAPACITY .. " fish.")
			return
		end
		pending = true
		render()
		local ok, result = pcall(request.InvokeServer, request, "SetTargets", targets)
		pending = false
		if ok and type(result) == "table" then
			if result.Message ~= "" then
				notice(result.Message)
			end
			if result.Ok then
				hide()
				return
			end
		else
			notice("The kitchen storage couldn't be reached. Try again.")
		end
		render()
	end

	setTargets.Activated:Connect(setTargetsPressed)

	close.Activated:Connect(hide)
	overlay.Activated:Connect(hide)
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			hide()
		end
	end)
	player.CharacterRemoving:Connect(hide)

	openStorage = function()
		fetch()
		overlay.Visible = true
		render()
	end
end

-- Opened from build mode's "Edit storage" button on a selected kitchen storage.
function KitchenStorage.open()
	KitchenStorage.start()
	if openStorage then
		openStorage()
	end
end

return KitchenStorage
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="330">
          <Properties>
            <string name="Name">Leaderboard</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Theme = require(ReplicatedFirst:WaitForChild("UITheme"))
local FishingRanks = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("FishingRanks"))

local Leaderboard = {}

local function label(parent, text, position, size, alignment)
	local item = Instance.new("TextLabel")
	item.BackgroundTransparency = 1
	item.Position = position
	item.Size = size
	item.Text = text
	item.TextSize = 13
	item.Font = Enum.Font.GothamMedium
	item.TextColor3 = Color3.fromRGB(242, 242, 245)
	item.TextXAlignment = alignment or Enum.TextXAlignment.Left
	item.TextTruncate = Enum.TextTruncate.AtEnd
	item.Parent = parent
	return item
end

local function formatMoney(value)
	local amount = tonumber(value)
	if not amount then
		return "—"
	end
	local absolute = math.abs(amount)
	for _, suffix in { { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e4, "K" } } do
		if absolute >= suffix[1] then
			local divisor = if suffix[2] == "K" then 1e3 else suffix[1]
			local abbreviated = string.format("%.1f", amount / divisor):gsub("%.0$", "")
			return abbreviated .. suffix[2]
		end
	end
	local digits = tostring(math.floor(absolute))
	while true do
		local formatted, replacements = digits:gsub("^(%d+)(%d%d%d)", "%1,%2")
		digits = formatted
		if replacements == 0 then
			break
		end
	end
	return (if amount < 0 then "-" else "") .. digits
end

-- Use the same proportional columns in the header and each player row.
local function columns(parent, playerText, moneyText, levelText, bestiaryText, header)
	local playerName = label(parent, playerText, UDim2.fromScale(0, 0), UDim2.new(0.44, -4, 1, 0))
	local money = label(parent, moneyText, UDim2.fromScale(0.44, 0), UDim2.new(0.18, 0, 1, 0), Enum.TextXAlignment.Center)
	local level = label(parent, levelText, UDim2.fromScale(0.62, 0), UDim2.new(0.15, 0, 1, 0), Enum.TextXAlignment.Center)
	local bestiary = label(parent, bestiaryText, UDim2.fromScale(0.77, 0), UDim2.new(0.23, 0, 1, 0), Enum.TextXAlignment.Center)
	if header then
		for _, item in { playerName, money, level, bestiary } do
			item.TextSize = 12
			item.Font = Enum.Font.Gotham
			item.TextColor3 = Color3.fromRGB(177, 176, 188)
		end
	end
	return playerName, money, level, bestiary
end

function Leaderboard.start()
	local localPlayer = Players.LocalPlayer
	local gui = Instance.new("ScreenGui")
	gui.Name = "CustomLeaderboard"
	gui.ResetOnSpawn = false
	gui.Parent = localPlayer:WaitForChild("PlayerGui")

	local toggle = Instance.new("TextButton")
	toggle.Name = "Toggle"
	toggle.AnchorPoint = Vector2.new(1, 0)
	toggle.Position = UDim2.new(1, -12, 0, 8)
	toggle.Size = UDim2.fromOffset(100, 32)
	toggle.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
	toggle.BackgroundTransparency = 0.4
	toggle.BorderSizePixel = 0
	toggle.Text = "Players"
	toggle.TextColor3 = Color3.fromRGB(242, 242, 245)
	toggle.Font = Enum.Font.GothamMedium
	toggle.TextSize = 14
	Theme.corner(toggle, 8)
	toggle.Parent = gui

	local panel = Instance.new("Frame")
	panel.Name = "PlayerList"
	panel.AnchorPoint = Vector2.new(1, 0)
	panel.Position = UDim2.new(1, -12, 0, 8)
	panel.Size = UDim2.new(0.9, 0, 0.55, 0)
	panel.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
	panel.BackgroundTransparency = 0.4
	panel.BorderSizePixel = 0
	Theme.corner(panel, 8)
	panel.Parent = gui
	local constraint = Instance.new("UISizeConstraint")
	constraint.MaxSize = Vector2.new(320, 55)
	constraint.Parent = panel

	local close = Instance.new("TextButton")
	close.Name = "Close"
	close.Position = UDim2.fromOffset(5, 0)
	close.Size = UDim2.fromOffset(30, 26)
	close.BackgroundTransparency = 1
	close.Text = "×"
	close.Font = Enum.Font.Gotham
	close.TextSize = 24
	close.TextColor3 = Color3.fromRGB(245, 245, 245)
	close.Parent = panel

	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Position = UDim2.fromOffset(15, 25)
	header.Size = UDim2.new(1, -30, 0, 20)
	header.BackgroundTransparency = 1
	header.Parent = panel
	columns(header, "People", "Money", "Level", "Bestiary", true)

	local list = Instance.new("ScrollingFrame")
	list.Name = "Rows"
	list.Position = UDim2.fromOffset(15, 48)
	list.Size = UDim2.new(1, -30, 1, -55)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 4
	list.ScrollBarImageColor3 = Color3.fromRGB(45, 45, 49)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new()
	list.Parent = panel
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	local expanded = true
	local function updateVisibility()
		local available = localPlayer:GetAttribute("BuildModeOpen") ~= true
		toggle.Visible = available and not expanded
		panel.Visible = available and expanded
	end
	toggle.Activated:Connect(function()
		expanded = true
		updateVisibility()
	end)
	close.Activated:Connect(function()
		expanded = false
		updateVisibility()
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.Tab and not UserInputService:GetFocusedTextBox() then
			expanded = not expanded
			updateVisibility()
		end
	end)
	localPlayer:GetAttributeChangedSignal("BuildModeOpen"):Connect(updateVisibility)
	updateVisibility()

	local entries = {}
	local function updateOrder()
		local sorted = {}
		for player in entries do
			table.insert(sorted, player)
		end
		-- Fit the current roster without leaving an empty panel, while keeping
		-- longer lists scrollable and bounded by the viewport's height.
		constraint.MaxSize = Vector2.new(320, math.min(300, 55 + #sorted * 32))
		table.sort(sorted, function(a, b)
			local aMoney = entries[a].moneyValue or -math.huge
			local bMoney = entries[b].moneyValue or -math.huge
			if aMoney ~= bMoney then
				return aMoney > bMoney
			end
			return a.Name:lower() < b.Name:lower()
		end)
		for index, player in sorted do
			entries[player].row.LayoutOrder = index
		end
	end

	local function addPlayer(player)
		if entries[player] then
			return
		end
		local row = Instance.new("Frame")
		row.Name = tostring(player.UserId)
		row.Size = UDim2.new(1, 0, 0, 32)
		row.BackgroundTransparency = 1
		row.BorderSizePixel = 0
		row.Parent = list
		local name, money, level, bestiary = columns(row, player.DisplayName, "—", "—", "—")
		local entry = { row = row, connections = {}, statsConnections = {} }
		entries[player] = entry
		local function refreshLevel()
			local value = tonumber(player:GetAttribute("Level"))
			level.Text = if value then tostring(value) else "—"
			name.TextColor3 = FishingRanks.forLevel(value or 0).Color
		end
		local function refreshBestiary()
			local value = tonumber(player:GetAttribute("BestiaryPercent"))
			bestiary.Text = if value then string.format("%d%%", math.clamp(math.floor(value + 0.5), 0, 100)) else "—"
		end
		local function bindStats()
			for _, connection in entry.statsConnections do
				connection:Disconnect()
			end
			table.clear(entry.statsConnections)
			local stats = player:FindFirstChild("leaderstats")
			local moneyValue = stats and stats:FindFirstChild("Money")
			local function refreshMoney()
				entry.moneyValue = if moneyValue and moneyValue:IsA("ValueBase") then tonumber(moneyValue.Value) else nil
				money.Text = formatMoney(entry.moneyValue)
				updateOrder()
			end
			if stats then
				table.insert(entry.statsConnections, stats.ChildAdded:Connect(bindStats))
				table.insert(entry.statsConnections, stats.ChildRemoved:Connect(bindStats))
			end
			if moneyValue and moneyValue:IsA("ValueBase") then
				table.insert(entry.statsConnections, moneyValue.Changed:Connect(refreshMoney))
			end
			refreshMoney()
		end
		table.insert(entry.connections, player:GetAttributeChangedSignal("Level"):Connect(refreshLevel))
		table.insert(entry.connections, player:GetAttributeChangedSignal("BestiaryPercent"):Connect(refreshBestiary))
		table.insert(
			entry.connections,
			player:GetPropertyChangedSignal("DisplayName"):Connect(function()
				name.Text = player.DisplayName
			end)
		)
		table.insert(
			entry.connections,
			player.ChildAdded:Connect(function(child)
				if child.Name == "leaderstats" then
					bindStats()
				end
			end)
		)
		table.insert(
			entry.connections,
			player.ChildRemoved:Connect(function(child)
				if child.Name == "leaderstats" then
					bindStats()
				end
			end)
		)
		bindStats()
		refreshLevel()
		refreshBestiary()
	end

	Players.PlayerAdded:Connect(addPlayer)
	Players.PlayerRemoving:Connect(function(player)
		local entry = entries[player]
		if not entry then
			return
		end
		entries[player] = nil
		for _, connection in entry.connections do
			connection:Disconnect()
		end
		for _, connection in entry.statsConnections do
			connection:Disconnect()
		end
		entry.row:Destroy()
		updateOrder()
	end)
	for _, player in Players:GetPlayers() do
		addPlayer(player)
	end

	-- CoreGui can be unavailable during early startup.
	task.spawn(function()
		for _ = 1, 20 do
			local success = pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.PlayerList, false)
			if success then
				return
			end
			task.wait(0.5)
		end
		warn("[Leaderboard] Could not disable the default player list")
	end)
end

return Leaderboard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="331">
          <Properties>
            <string name="Name">LightShadows</string>
            <string name="Source"><![CDATA[-- Budgets shadow-casting interior lights (tag ShadowLight: base pendants, dining lamps).
--
-- Every base house hangs 11 shadowed pendants, so a walk through the village had dozens of
-- point-light shadow maps on screen, each redrawn whenever a townsperson or customer moved
-- through its range. Out of the house it was the bulk of the frame. Only the lights closest
-- to the camera keep their shadows here; the rest still light the room, unshadowed. Light
-- properties written on the client stay local, so the server's Shadows = true is untouched.
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local LightShadows = {}

local TAG = "ShadowLight"
-- Inside a room the pendants overhead are well within this; across the street they are not.
local RANGE = 40
local MAX_SHADOWED = 6
local INTERVAL = 0.4

local started = false

-- Pure choice, separate from the Roblox loop so a harness can drive it: the indexes of
-- `distances` that keep shadows (nearest first, at most `limit`, within `range`).
function LightShadows.choose(distances: { number }, range: number, limit: number): { [number]: boolean }
	local order = {}
	for index, distance in distances do
		if distance <= range then
			table.insert(order, index)
		end
	end
	table.sort(order, function(a, b)
		return distances[a] < distances[b]
	end)
	local keep = {}
	for rank = 1, math.min(limit, #order) do
		keep[order[rank]] = true
	end
	return keep
end

function LightShadows.start()
	if started then
		return
	end
	started = true
	local lights: { [Light]: boolean } = {} -- light -> shadows currently on (locally)

	local function add(instance: Instance)
		if instance:IsA("Light") and lights[instance] == nil then
			-- Off until the next pass decides; a newly streamed house never pops in 11 shadow maps.
			lights[instance] = false
			instance.Shadows = false
		end
	end
	local function remove(instance: Instance)
		lights[instance :: Light] = nil
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(add)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(remove)
	for _, instance in CollectionService:GetTagged(TAG) do
		add(instance)
	end

	task.spawn(function()
		local list: { Light } = {}
		local distances: { number } = {}
		while true do
			task.wait(INTERVAL)
			local camera = workspace.CurrentCamera
			if not camera then
				continue
			end
			local eye = camera.CFrame.Position
			-- Performance preset (GlobalShadows off): nothing would draw them anyway.
			local allowed = Lighting.GlobalShadows
			table.clear(list)
			table.clear(distances)
			for light in lights do
				local parent = light.Parent
				if parent and parent:IsA("BasePart") and light.Enabled then
					table.insert(list, light)
					table.insert(distances, if allowed then (parent.Position - eye).Magnitude else math.huge)
				elseif lights[light] then
					lights[light] = false
					light.Shadows = false
				end
			end
			local keep = LightShadows.choose(distances, RANGE, MAX_SHADOWED)
			for index, light in list do
				local on = keep[index] == true
				if lights[light] ~= on then
					lights[light] = on
					light.Shadows = on
				end
			end
		end
	end)
end

return LightShadows
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="332">
          <Properties>
            <string name="Name">Lod</string>
            <string name="Source"><![CDATA[-- Shows each island's coarse shell (server/Map/Lod) only while the real island is streamed out,
-- so distant islands stay visible without the client holding their full detail.
--
-- An island counts as loaded only while it actually has ground parts on this client. Going by the
-- island Model alone isn't enough: the instance can be around (arriving, or left behind after its
-- parts stream out) with nothing to draw, and hiding the shell then leaves a hole in the sea.
--
-- Islands stream in piece by piece rather than as one atomic unit (that froze the frame), so a
-- shell gives way only once most of its island's ground has arrived. The home island is too big
-- to wait for whole, so its shell comes in tiles and each tile follows the ground under it.
--
-- Once a shell has given way it stays away while its island is near (within FAR_SHELL).
-- Bringing it back over missing parts flipped shells on and off over a fully drawn town, and a
-- shell the server swaps in later picks up where the one it replaces left off.
--
-- Islands come in pieces the server pins for this player as each one arrives (see
-- reportPieces), so a nearby island's ground never streams back out, not even when the device
-- runs low on memory. The server releases pins on far islands so low-memory devices can let
-- them go; once such an island is short of ground again, its shell comes back.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end

local Lod = {}

local FADE_TIME = 0.6
-- A shell holds thousands of parts and every transparency write is paid for by the
-- renderer, so the fade moves in a few steps rather than on every frame.
local FADE_STEPS = 4
local SURFACE_INSET = Vector3.new(0, 0.2, 0)
local insetParts = setmetatable({}, { __mode = "k" })
local PREFETCH_INTERVAL = 1
local PREFETCH_AHEAD = 400
local PREFETCH_STEP = 150 -- skip requests that barely move the streamed area
local TILE_LOADED = 0.85 -- share of a tile's ground that has to be in before its shell gives way
local ISLAND_LOADED = 0.95 -- the same for a whole island, which has no player inside it to cover gaps
local HANDOVER = 0.5 -- share of the ground that will do for a shell replacing one that had already given way
local TILE_NEAR = 96 -- streaming always holds the ground this close to the player
local TILE_INTERVAL = 0.5 -- how often tiles near the player are looked at again as they move
local PIECE_TAG = "LodPiece"
local PIN_BATCH = 500 -- most pieces the server pins per request
-- Past this distance a drawn island or tile that has lost ground shows its shell again. The
-- server only releases pins beyond 1100 studs (server/Map/Lod), so nearer islands never thin out.
local FAR_SHELL = 900

type Island = {
	model: Model,
	ground: number,
	parts: { [BasePart]: boolean },
	connections: { RBXScriptConnection },
	groundConnections: { RBXScriptConnection },
}
type Visual = { parts: { BasePart }, hidden: boolean?, fadeApplied: number? }
type Tile = Visual & { expected: number, loaded: number, minX: number, minZ: number }
type Grid = { size: number, x: number, z: number }
type Shell = Visual & {
	model: Model,
	connections: { RBXScriptConnection },
	needed: number, -- ground parts that have to be in before an untiled shell gives way
	inherited: boolean, -- replaced a shell that had already given way to the real island
	grid: Grid?, -- set when the shell is tiled
	tiles: { [string]: Tile },
	dirty: boolean, -- tile ground counts need redoing from scratch
	centerX: number?, -- rough middle of an untiled shell, for its distance from the player
	centerZ: number?,
}

local function disconnectAll(connections: { RBXScriptConnection })
	for _, c in connections do
		c:Disconnect()
	end
	table.clear(connections)
end

local function halfExtent(part: BasePart): Vector3
	local frame, size = part.CFrame, part.Size / 2
	local right, up, back = frame.RightVector, frame.UpVector, frame.LookVector
	return Vector3.new(
		math.abs(right.X) * size.X + math.abs(up.X) * size.Y + math.abs(back.X) * size.Z,
		math.abs(right.Y) * size.X + math.abs(up.Y) * size.Y + math.abs(back.Y) * size.Z,
		math.abs(right.Z) * size.X + math.abs(up.Z) * size.Y + math.abs(back.Z) * size.Z
	)
end

-- Every tile a part's footprint overlaps, keyed exactly as server/Map/Lod counted them.
local function tileKeys(part: BasePart, grid: Grid, callback: (string) -> ())
	local half, p = halfExtent(part), part.Position
	for x = math.floor((p.X - half.X - grid.x) / grid.size), math.floor((p.X + half.X - grid.x) / grid.size) do
		for z = math.floor((p.Z - half.Z - grid.z) / grid.size), math.floor((p.Z + half.Z - grid.z) / grid.size) do
			callback(x .. "," .. z)
		end
	end
end

local function playerPosition(): Vector3?
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root.Position else nil
end

-- Tells the server about each island piece as it streams in, so it pins the piece for this
-- player (see server/Map/Lod). Arrivals are sent once a frame, however many came in.
local function reportPieces()
	local queued: { number } = {}
	local reported: { [number]: boolean } = {}
	local present: { [number]: Instance } = {}
	local remote: RemoteEvent? = nil
	local scheduled = false

	local function send()
		scheduled = false
		if not remote then
			return
		end
		local ids: { number } = {}
		for _, id in queued do
			local piece = present[id]
			if piece and piece:IsDescendantOf(workspace) then
				table.insert(ids, id)
				if #ids >= PIN_BATCH then
					remote:FireServer(ids)
					ids = {}
				end
			end
		end
		if #ids > 0 then
			remote:FireServer(ids)
		end
		table.clear(queued)
	end

	local function arrived(piece: Instance)
		local id = piece:GetAttribute("PieceId")
		if typeof(id) ~= "number" then
			return
		end
		present[id] = piece
		if not reported[id] then
			reported[id] = true
			table.insert(queued, id)
			if not scheduled then
				scheduled = true
				task.defer(send)
			end
		end
	end
	CollectionService:GetInstanceAddedSignal(PIECE_TAG):Connect(arrived)
	-- A piece that streams out before its pin lands is reported again when it comes back
	CollectionService:GetInstanceRemovedSignal(PIECE_TAG):Connect(function(piece)
		local id = piece:GetAttribute("PieceId")
		if typeof(id) == "number" and present[id] == piece then
			present[id] = nil
			reported[id] = nil
		end
	end)
	for _, piece in CollectionService:GetTagged(PIECE_TAG) do
		arrived(piece)
	end

	task.spawn(function()
		remote = ReplicatedStorage:WaitForChild("LodPin", math.huge) :: RemoteEvent
		remote.OnClientEvent:Connect(function(ids: { number })
			-- A released piece may still be here when we return. Confirm only models
			-- actually loaded in workspace; never ask the server to force missing scenery in.
			for _, id in ids do
				local piece = present[id]
				if piece and piece:IsDescendantOf(workspace) then
					reported[id] = nil
					arrived(piece)
				end
			end
		end)
		send()
	end)
end

function Lod.start()
	reportPieces()

	local map = workspace:WaitForChild("Map")
	-- Shells only appear once the whole map is built, which can take a minute on a fresh server
	local shells = map:WaitForChild("Lod", math.huge)

	local byId: { [string]: Shell } = {}
	local islands: { [string]: Island } = {}
	local pending: { [string]: boolean } = {}
	local fading: { [Visual]: number } = {}

	-- Ground parts an island needs before it counts as drawn. Tiled shells decide per tile,
	-- so for them any ground at all will do.
	local function needed(id: string): number
		local shell = byId[id]
		return if shell then shell.needed else 1
	end

	local function groundIn(id: string): number
		local island = islands[id]
		return if island and island.model:IsDescendantOf(workspace) then island.ground else 0
	end

	local function isTiled(id: string): boolean
		local shell = byId[id]
		return shell ~= nil and shell.grid ~= nil
	end

	-- Tracks how much of each tile's ground is here, as ground parts come and go.
	local function count(id: string, part: BasePart, delta: number)
		local shell = byId[id]
		local grid = shell and shell.grid
		if grid and not shell.dirty then
			tileKeys(part, grid, function(key)
				local tile = shell.tiles[key]
				if tile then
					tile.loaded += delta
				end
			end)
		end
	end

	local function recount(shell: Shell, id: string)
		shell.dirty = false
		for _, tile in shell.tiles do
			tile.loaded = 0
		end
		local island = islands[id]
		if island then
			for part in island.parts do
				count(id, part, 1)
			end
		end
	end

	-- Whether an untiled shell's island is far enough away that its shell may come back.
	local function farShell(shell: Shell, focus: Vector3?): boolean
		if not focus then
			return false
		end
		if not shell.centerX then
			local count = #shell.parts
			if count == 0 then
				return false
			end
			-- A spread of the shell's own parts is close enough to its middle
			local sx, sz, n = 0, 0, 0
			for index = 1, count, math.max(1, count // 16) do
				local p = shell.parts[index].Position
				sx, sz, n = sx + p.X, sz + p.Z, n + 1
			end
			shell.centerX, shell.centerZ = sx / n, sz / n
		end
		local dx, dz = focus.X - (shell.centerX :: number), focus.Z - (shell.centerZ :: number)
		return dx * dx + dz * dz > FAR_SHELL * FAR_SHELL
	end

	local function show(visual: Visual, hidden: boolean)
		if visual.hidden == hidden then
			return
		end
		local first = visual.hidden == nil
		visual.hidden = hidden
		visual.fadeApplied = nil
		if hidden and not first then
			-- The real island is already drawn underneath, so the shell can melt away
			fading[visual] = os.clock()
		else
			-- Nothing else is there, so the shell has to be back this frame. A shell that arrives
			-- over an island that's already drawn goes straight away rather than flashing up.
			fading[visual] = nil
			for _, part in visual.parts do
				part.LocalTransparencyModifier = if hidden then 1 else 0
			end
		end
	end

	-- Coalesce streaming bursts and only touch shell parts when visibility changes.
	-- Keep shells in their persistent container: reparenting whole islands tears down
	-- and recreates their workspace/render registrations on every transition.
	local function refresh(id: string)
		if pending[id] then
			return
		end
		pending[id] = true
		task.defer(function()
			pending[id] = nil
			local shell = byId[id]
			if not shell then
				return
			end
			local ground = groundIn(id)
			local grid = shell.grid
			if grid then
				if shell.dirty then
					recount(shell, id)
				end
				local focus = playerPosition()
				for _, tile in shell.tiles do
					local near, far = false, false
					if focus then
						local dx = math.max(tile.minX - focus.X, 0, focus.X - tile.minX - grid.size)
						local dz = math.max(tile.minZ - focus.Z, 0, focus.Z - tile.minZ - grid.size)
						near = dx * dx + dz * dz < TILE_NEAR * TILE_NEAR
						far = dx * dx + dz * dz > FAR_SHELL * FAR_SHELL
					end
					-- Shells sit on top of the ground, so a half-streamed tile stays covered until it's
					-- nearly whole. Right around the player it's always real, never draped in shell.
					local share = if shell.inherited then HANDOVER else TILE_LOADED
					local whole = near or tile.loaded >= tile.expected * share
					show(tile, ground > 0 and (whole or (tile.hidden == true and not far)))
				end
			else
				local keep = shell.hidden == true and not farShell(shell, playerPosition())
				show(shell, ground > 0 and (ground >= shell.needed or keep))
			end
		end)
	end

	RunService.Heartbeat:Connect(profiled("Lod", function()
		local now = os.clock()
		for visual, started in fading do
			local alpha = math.min((now - started) / FADE_TIME, 1)
			local stepped = math.ceil(alpha * FADE_STEPS) / FADE_STEPS
			if stepped ~= visual.fadeApplied then
				visual.fadeApplied = stepped
				for _, part in visual.parts do
					part.LocalTransparencyModifier = stepped
				end
			end
			if alpha >= 1 then
				visual.fadeApplied = nil
				fading[visual] = nil
			end
		end
	end))

	-- Ask for the water ahead of the boat early, so islands have time to stream in piece by piece
	-- before you sail up to them. Only while driving: on foot this kept dragging whole islands in
	-- around the harbour, which is memory the client then has to hold.
	task.spawn(function()
		local player = Players.LocalPlayer
		local lastRequest: Vector3? = nil
		while true do
			task.wait(PREFETCH_INTERVAL)
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local seat = humanoid and humanoid.SeatPart
			if seat and seat:IsA("VehicleSeat") then
				local velocity = seat.AssemblyLinearVelocity * Vector3.new(1, 0, 1)
				if velocity.Magnitude > 6 then
					local ahead = seat.Position + velocity.Unit * PREFETCH_AHEAD
					if not lastRequest or (ahead - lastRequest).Magnitude > PREFETCH_STEP then
						lastRequest = ahead
						pcall(player.RequestStreamAroundAsync, player, ahead, PREFETCH_INTERVAL * 4)
					end
				end
			end
		end
	end)

	-- Which tiles count as near changes as the player walks, without any ground streaming
	task.spawn(function()
		while true do
			task.wait(TILE_INTERVAL)
			for id in byId do
				if isTiled(id) then
					refresh(id)
				end
			end
		end
	end)

	-- The server swaps in a new shell (say, a tiled one for an older baked map) by replacing it
	-- The server destroys the old shell before parenting the new one, so remember for the
	-- replacement whether the island had already been drawn
	local gaveWay: { [string]: boolean } = {}
	local function forget(model: Instance)
		local shell = byId[model.Name]
		if shell and shell.model == model then
			local drawn = shell.hidden == true
			for _, tile in shell.tiles do
				drawn = drawn or tile.hidden == true
			end
			gaveWay[model.Name] = drawn or nil
			byId[model.Name] = nil
			disconnectAll(shell.connections)
			fading[shell] = nil
			for _, tile in shell.tiles do
				fading[tile] = nil
			end
		end
	end

	local function onShell(model: Instance)
		if not model:IsA("Model") then
			return
		end
		local old = byId[model.Name]
		if old then
			if old.model == model then
				return
			end
			forget(old.model)
		end

		local id = model.Name
		local inherited = gaveWay[id] == true
		gaveWay[id] = nil
		local size = model:GetAttribute("TileSize")
		local grid: Grid? = nil
		if typeof(size) == "number" then
			grid = {
				size = size,
				x = tonumber(model:GetAttribute("TileOriginX")) or 0,
				z = tonumber(model:GetAttribute("TileOriginZ")) or 0,
			}
		end
		local function groundNeeded(): number
			local ground = tonumber(model:GetAttribute("Ground"))
			local share = if inherited then HANDOVER else ISLAND_LOADED
			return if grid or not ground then 1 else math.max(math.ceil(ground * share), 1)
		end
		local shell: Shell = {
			model = model,
			parts = {},
			hidden = nil,
			connections = {},
			needed = groundNeeded(),
			inherited = inherited,
			grid = grid,
			tiles = {},
			dirty = grid ~= nil,
		}
		byId[id] = shell

		-- Untiled shells are one visual; tiled ones keep their parts in one Model per tile
		local function visualOf(d: Instance, create: boolean): Visual?
			if not grid then
				return shell
			end
			local tileModel = d.Parent
			if not tileModel or tileModel.Parent ~= model then
				return nil
			end
			local tile = shell.tiles[tileModel.Name]
			if not tile and create then
				local x, z = string.match(tileModel.Name, "^(-?%d+),(-?%d+)$")
				if not x or not z then
					return nil
				end
				tile = {
					parts = {},
					hidden = nil,
					expected = tonumber(tileModel:GetAttribute("Ground")) or 0,
					loaded = 0,
					minX = grid.x + (tonumber(x) :: number) * grid.size,
					minZ = grid.z + (tonumber(z) :: number) * grid.size,
				}
				shell.tiles[tileModel.Name] = tile
				-- The server recounts the ground under each tile at startup (see server/Map/Lod)
				local created = tile
				table.insert(
					shell.connections,
					tileModel:GetAttributeChangedSignal("Ground"):Connect(function()
						created.expected = tonumber(tileModel:GetAttribute("Ground")) or 0
						refresh(id)
					end)
				)
				-- Its ground may already be here; count everything again on the next refresh
				shell.dirty = true
				refresh(id)
			end
			return tile
		end
		local function onPart(d: Instance)
			if d:IsA("BasePart") then
				-- Saved shells were sampled exactly on the real terrain. Keep their
				-- faces below it while tiles overlap during streaming and fading.
				if not insetParts[d] then
					d.Position -= SURFACE_INSET
					insetParts[d] = true
				end
				local visual = visualOf(d, true)
				if visual then
					table.insert(visual.parts, d)
					if visual.hidden ~= nil then
						d.LocalTransparencyModifier = if visual.hidden then 1 else 0
					end
				end
			end
		end
		table.insert(
			shell.connections,
			model:GetAttributeChangedSignal("Ground"):Connect(function()
				shell.needed = groundNeeded()
				refresh(id)
			end)
		)
		table.insert(shell.connections, model.DescendantAdded:Connect(onPart))
		table.insert(
			shell.connections,
			model.DescendantRemoving:Connect(function(d)
				if d:IsA("BasePart") then
					local visual = visualOf(d, false)
					local index = visual and table.find(visual.parts, d)
					if visual and index then
						table.remove(visual.parts, index)
					end
				end
			end)
		)
		for _, d in model:GetDescendants() do
			onPart(d)
		end
		refresh(id)
	end
	shells.ChildAdded:Connect(onShell)
	shells.ChildRemoved:Connect(forget)
	for _, shell in shells:GetChildren() do
		onShell(shell)
	end

	-- Only the Ground model's parts decide whether an island is drawn, so watch just that
	-- rather than every tree, prop and house part streaming onto the island.
	local function watchGround(island: Island, id: string, ground: Instance?)
		disconnectAll(island.groundConnections)
		island.ground = 0
		table.clear(island.parts)
		local shell = byId[id]
		if shell then
			shell.dirty = true
		end
		local function arrived(d: Instance)
			if d:IsA("BasePart") and not island.parts[d] then
				island.parts[d] = true
				island.ground += 1
				count(id, d, 1)
				-- Only the arrival that completes the island matters, so a streaming burst costs
				-- nothing. A tiled shell cares about every part, since each tile has its own count.
				if island.ground == needed(id) or isTiled(id) then
					refresh(id)
				end
			end
		end
		if ground then
			for _, d in ground:GetDescendants() do
				arrived(d)
			end
			table.insert(island.groundConnections, ground.DescendantAdded:Connect(arrived))
			table.insert(
				island.groundConnections,
				ground.DescendantRemoving:Connect(function(d)
					if d:IsA("BasePart") and island.parts[d] then
						island.parts[d] = nil
						island.ground -= 1
						count(id, d, -1)
						-- A shell that gave way comes back once the island's ground is all gone, or
						-- (far away) once it is short of ground; refreshes coalesce per island
						local shell = byId[id]
						if
							island.ground == 0
							or isTiled(id)
							or (shell and island.ground < shell.needed and farShell(shell, playerPosition()))
						then
							refresh(id)
						end
					end
				end)
			)
		end
		refresh(id)
	end

	local function track(model: Model, id: string)
		local old = islands[id]
		if old and old.model == model then
			return
		end
		if old then
			disconnectAll(old.connections)
			disconnectAll(old.groundConnections)
		end

		local island: Island = { model = model, ground = 0, parts = {}, connections = {}, groundConnections = {} }
		islands[id] = island
		table.insert(
			island.connections,
			model.ChildAdded:Connect(function(child)
				if child.Name == "Ground" then
					watchGround(island, id, child)
				end
			end)
		)
		table.insert(
			island.connections,
			model.ChildRemoved:Connect(function(child)
				if child.Name == "Ground" then
					watchGround(island, id, model:FindFirstChild("Ground"))
				end
			end)
		)
		-- Covers the whole island leaving at once, whether it's destroyed or just unparented
		table.insert(
			island.connections,
			model.AncestryChanged:Connect(function()
				refresh(id)
			end)
		)
		watchGround(island, id, model:FindFirstChild("Ground"))
	end

	-- Islands are the models directly inside each biome folder, plus mainlands marked LodRoot
	-- in the map itself (see server/Map/Lod). Listening there costs one call per island instead
	-- of one per part streaming into the map.
	local function onIsland(child: Instance)
		if not child:IsA("Model") then
			return
		end
		local id = child:GetAttribute("LodId")
		if id then
			track(child, tostring(id))
		else
			-- Islands generated after this client joined get their id once shells are built
			local connection
			connection = child:GetAttributeChangedSignal("LodId"):Connect(function()
				connection:Disconnect()
				onIsland(child)
			end)
		end
	end
	local function onFolder(folder: Instance)
		if folder:IsA("Folder") then
			folder.ChildAdded:Connect(onIsland)
			for _, child in folder:GetChildren() do
				onIsland(child)
			end
		elseif folder:IsA("Model") and folder:GetAttribute("LodRoot") then
			-- A mainland (the city) sits directly in the map rather than in a biome folder
			onIsland(folder)
		end
	end
	map.ChildAdded:Connect(onFolder)
	for _, folder in map:GetChildren() do
		onFolder(folder)
	end
end

return Lod
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="333">
          <Properties>
            <string name="Name">Metro</string>
            <string name="Source"><![CDATA[local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Schedule = require(ReplicatedStorage.Shared.MetroSchedule)
local Train = require(ReplicatedStorage.Shared.MetroTrain)

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end
local Metro = {}
local started = false

local function make(class, parent, props)
	local item = Instance.new(class)
	for key, value in props do item[key] = value end
	item.Parent = parent
	return item
end

function Metro.start()
	if started then return end
	started = true
	local player = Players.LocalPlayer
	local transit = ReplicatedStorage:WaitForChild("MetroTransit")
	local remote = transit:WaitForChild("Ride")
	local trains, ride, savedCamera = {}, nil, nil
	local visuals = make("Folder", workspace, { Name = "MetroVisuals" })
	local gui = make("ScreenGui", player:WaitForChild("PlayerGui"), {
		Name = "MetroJourney", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 70, Enabled = false,
	})
	local tunnel = make("Frame", gui, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(13, 24, 26), BorderSizePixel = 0 })
	local streaks = {}
	for i = 1, 12 do
		streaks[i] = make("Frame", tunnel, {
			Size = UDim2.fromScale(0.08 + i % 3 * 0.07, 0.002), Position = UDim2.fromScale(i / 12, i / 14),
			BackgroundColor3 = Color3.fromRGB(175, 153, 107), BackgroundTransparency = 0.8, BorderSizePixel = 0,
		})
	end
	local card = make("Frame", gui, {
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 0.92), Size = UDim2.new(0.88, 0, 0, 136),
		BackgroundColor3 = Color3.fromRGB(25, 59, 56), BackgroundTransparency = 0.04, BorderSizePixel = 0,
	})
	make("UISizeConstraint", card, { MaxSize = Vector2.new(650, 136) })
	make("UICorner", card, { CornerRadius = UDim.new(0, 8) })
	make("UIStroke", card, { Color = Color3.fromRGB(185, 151, 83), Thickness = 1 })
	local function label(words, y, height, size, color)
		return make("TextLabel", card, {
			Text = words, Position = UDim2.new(0, 22, 0, y), Size = UDim2.new(1, -44, 0, height),
			BackgroundTransparency = 1, TextColor3 = color or Color3.fromRGB(243, 233, 207),
			Font = Enum.Font.GothamMedium, TextSize = size, TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
	end
	local route = label("", 13, 26, 20)
	local status = label("", 43, 23, 15, Color3.fromRGB(214, 193, 142))
	local line = make("Frame", card, { Position = UDim2.new(0, 24, 0, 87), Size = UDim2.new(1, -48, 0, 3), BackgroundColor3 = Color3.fromRGB(89, 115, 103), BorderSizePixel = 0 })
	local progress = make("Frame", line, { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.fromRGB(222, 190, 111), BorderSizePixel = 0 })
	local dot = make("Frame", line, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(11, 11), BackgroundColor3 = Color3.fromRGB(250, 229, 171), BorderSizePixel = 0 })
	make("UICorner", dot, { CornerRadius = UDim.new(1, 0) })
	local ends = label("", 102, 18, 12, Color3.fromRGB(180, 201, 183))
	local function restore()
		ride, gui.Enabled = nil, false
		local camera = workspace.CurrentCamera
		if camera and savedCamera then
			camera.CameraType, camera.FieldOfView = savedCamera.kind, savedCamera.fov
			local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			camera.CameraSubject = humanoid or savedCamera.subject
		end
		savedCamera = nil
	end
	remote.OnClientEvent:Connect(function(action, data)
		if action == "Depart" then
			restore()
			ride, gui.Enabled = data, true
			tunnel.BackgroundTransparency = 1 - Schedule.darkness(workspace:GetServerTimeNow(), data.departure)
			local camera = workspace.CurrentCamera
			if camera then savedCamera = { kind = camera.CameraType, fov = camera.FieldOfView, subject = camera.CameraSubject } end
			route.Text = "1  ·  " .. data.origin .. "  →  " .. data.destination
			ends.Text = data.origin .. "                         " .. data.destination
		elseif action == "Transfer" and ride then
			ride.dock = data.dock
		elseif action == "Arrive" or action == "Cancel" then
			restore()
		end
	end)
	player.CharacterRemoving:Connect(restore)
	player:GetAttributeChangedSignal("MetroRiding"):Connect(function()
		if not player:GetAttribute("MetroRiding") then restore() end
	end)
	local function added(stop)
		if trains[stop] or not stop:FindFirstChild("TrainDock") then return end
		local boards = {}
		for _, p in stop:GetDescendants() do
			if p.Name == "DepartureBoard" then
				for _, label in p:GetDescendants() do
					if label:IsA("TextLabel") then table.insert(boards, { label = label, destination = p:GetAttribute("MetroDestination") }) end
				end
			end
		end
		trains[stop] = { boards = boards, dock = stop.TrainDock.CFrame }
	end
	CollectionService:GetInstanceAddedSignal("MetroStop"):Connect(added)
	CollectionService:GetInstanceRemovedSignal("MetroStop"):Connect(function(stop)
		local train = trains[stop]
		if train then
			if train.model then train.model:Destroy() end
			trains[stop] = nil
		end
	end)
	for _, stop in CollectionService:GetTagged("MetroStop") do added(stop) end
	-- A preloaded destination can arrive while the camera is still at the source.
	-- Build only nearby trains, outside the render callback, one per Heartbeat.
	RunService.Heartbeat:Connect(profiled("Metro", function()
		local camera = workspace.CurrentCamera
		if not camera or transit:GetAttribute("Ready") ~= true then return end
		for _, train in trains do
			if not train.model and (camera.CFrame.Position - train.dock.Position).Magnitude < 650 then
				debug.profilebegin("Metro/Build")
				train.model, train.doors = Train.build(visuals, train.dock, false)
				debug.profileend()
				return
			end
		end
	end))
	local lastSecond = -1
	RunService:BindToRenderStep("Metro", Enum.RenderPriority.Camera.Value + 1, profiled("Metro/2", function()
		local now = workspace:GetServerTimeNow()
		local state, active = Schedule.state(now), transit:GetAttribute("Ready") == true
		local second = math.floor(now)
		local camera = workspace.CurrentCamera
		local focus = camera and camera.CFrame.Position
		for stop, train in trains do
			local nearby = focus and (focus - train.dock.Position).Magnitude < 650
			-- Keep the model registered. Reparenting hundreds of parts every arrival
			-- causes avoidable render-registration spikes on weaker clients.
			if train.model and (train.active ~= active or (nearby and (train.offset ~= state.offset or train.open ~= state.doors))) then
				local frame = if active then Schedule.frame(train.dock, now) else train.dock * CFrame.new(0, -100, 0)
				Train.pose(train.model, train.doors, frame, state.doors)
				train.active, train.offset, train.open = active, state.offset, state.doors
			end
			if second ~= lastSecond then
				local message = if not active then "Service preparing" elseif state.boarding then "Doors open · Departs in " .. state.seconds .. "s"
					elseif state.phase < Schedule.OPEN then "Arriving · Stand back" elseif state.phase < Schedule.TUNNEL then "Doors closed · Next in " .. state.seconds .. "s"
					else "Next train  0:" .. string.format("%02d", state.seconds)
				for _, board in train.boards do board.label.Text = "1  " .. board.destination .. "\n" .. message end
			end
		end
		lastSecond = second
		if not ride then return end
		local amount = math.clamp((now - ride.departure) / (ride.arrival - ride.departure), 0, 1)
		progress.Size, dot.Position = UDim2.fromScale(amount, 1), UDim2.fromScale(amount, 0.5)
		local onArrival = now >= ride.arrival - Schedule.OPEN
		local darkness = Schedule.darkness(now, ride.departure)
		tunnel.BackgroundTransparency = 1 - darkness
		for i, streak in streaks do
			streak.Visible = darkness > 0.9
			streak.Position = UDim2.fromScale(1 - ((now * (0.25 + i * 0.017) + i / 12) % 1), i / 14)
		end
		status.Text = if onArrival then "Arriving at " .. ride.destination elseif state.phase < Schedule.DEPART then "Doors closing · Please stand clear"
			elseif state.phase < Schedule.TUNNEL then "Departing " .. ride.origin else "Travelling to " .. ride.destination .. " · " .. math.max(0, math.ceil(ride.arrival - now)) .. "s"
		if camera then
			if not savedCamera then savedCamera = { kind = camera.CameraType, fov = camera.FieldOfView, subject = camera.CameraSubject } end
			camera.CameraType, camera.FieldOfView = Enum.CameraType.Scriptable, 68
			local frame = Schedule.frame(ride.dock, now)
			camera.CFrame = CFrame.lookAt(frame * Vector3.new(-3, 5.7, 0.8), frame * Vector3.new(2, 5, -12))
		end
		-- A missing completion packet must not leave the player in a scripted camera.
		if now > ride.arrival + 8 then restore() end
	end))
end

return Metro
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="334">
          <Properties>
            <string name="Name">MusselNets</string>
            <string name="Source"><![CDATA[-- Preview mussel net placement and animate placed nets' floats. The server
-- checks and saves every drop.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))
local Biomes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Biomes"))
local MusselNets = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MusselNets"))

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end

local MusselNetsClient = {}
local TOOL_ATTRIBUTE = "MusselNetTool"
local CAGE_TAG = "MusselNet"
local BASE_TAG = "PlayerBase"
local VALID = Color3.fromRGB(111, 202, 125)
local INVALID = Color3.fromRGB(238, 107, 111)
local BOB_DISTANCE = 160
local started = false

local function openWater(position: Vector3, parameters: RaycastParams): boolean
	local result = workspace:Raycast(
		Vector3.new(position.X, Biomes.WaterLevel + 12, position.Z),
		Vector3.new(0, -24, 0),
		parameters
	)
	return result ~= nil and result.Instance == workspace.Terrain and result.Material == Enum.Material.Water
end

function MusselNetsClient.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local remotes = ReplicatedStorage:WaitForChild("MusselNets")
	local request = remotes:WaitForChild("Request") :: RemoteEvent
	local update = remotes:WaitForChild("Update") :: RemoteEvent
	update.OnClientEvent:Connect(function(kind, message)
		if kind == "Notice" and type(message) == "string" then
			pcall(StarterGui.SetCore, StarterGui, "SendNotification", {
				Title = "Mussel Nets",
				Text = message,
				Duration = 5,
			})
		end
	end)

	local gui = Instance.new("ScreenGui")
	gui.Name = "MusselNetPlacement"
	gui.ResetOnSpawn = false
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")
	local hint = Instance.new("TextLabel")
	hint.Name = "Hint"
	hint.AnchorPoint = Vector2.new(0.5, 1)
	hint.Position = UDim2.new(0.5, 0, 1, -118)
	hint.Size = UDim2.fromOffset(480, 26)
	hint.BackgroundTransparency = 1
	hint.TextSize = 18
	hint.TextWrapped = true
	Theme.text(hint)
	hint.Parent = gui

	local tool: Tool? = nil
	local ghost: Model? = nil
	local highlight: Highlight? = nil
	local activated: RBXScriptConnection? = nil
	local lastTouch: Vector2? = nil
	local lastSent = -math.huge

	local function myBase(): (Model?, CFrame?)
		for _, base in CollectionService:GetTagged(BASE_TAG) do
			local frame = base:GetAttribute("BoatDockFrame")
			if
				base:GetAttribute("OwnerUserId") == player.UserId
				and base:IsA("Model")
				and typeof(frame) == "CFrame"
			then
				return base, frame
			end
		end
		return nil, nil
	end

	local function pointerRay(camera: Camera): Ray
		local last = UserInputService:GetLastInputType()
		if last == Enum.UserInputType.Touch and lastTouch then
			return camera:ScreenPointToRay(lastTouch.X, lastTouch.Y)
		elseif string.sub(last.Name, 1, 7) == "Gamepad" then
			local size = camera.ViewportSize
			return camera:ViewportPointToRay(size.X / 2, size.Y / 2)
		end
		local mouse = UserInputService:GetMouseLocation()
		return camera:ViewportPointToRay(mouse.X, mouse.Y)
	end

	-- Where the pointer would drop the cage: the world spot, the cage's frame, and
	-- why it can't go there (nil when it can). Mirrors MusselNetService.place.
	local function evaluate(): (Vector3?, CFrame?, string?)
		local camera = workspace.CurrentCamera
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not camera or not tool or not root or not root:IsA("BasePart") then
			return nil, nil, nil
		end
		local base, dock = myBase()
		if not base or not dock then
			return nil, nil, "You need a dock of your own to set mussel nets."
		end
		local ignore: { Instance } = { ghost :: Instance }
		for _, other in Players:GetPlayers() do
			if other.Character then
				table.insert(ignore, other.Character)
			end
		end
		local parameters = RaycastParams.new()
		parameters.FilterType = Enum.RaycastFilterType.Exclude
		parameters.FilterDescendantsInstances = ignore
		parameters.IgnoreWater = false
		local ray = pointerRay(camera)
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 400, parameters)
		if not hit or hit.Instance ~= workspace.Terrain or hit.Material ~= Enum.Material.Water then
			return nil, nil, "Point at the water by your dock."
		end
		local spot = dock:PointToObjectSpace(hit.Position)
		local x, z = MusselNets.round(spot.X), MusselNets.round(spot.Z)
		local position = dock * Vector3.new(x, 0, z)
		local waterline = tool:GetAttribute("Waterline")
		local size = tool:GetAttribute("CageSize")
		if type(waterline) ~= "number" or typeof(size) ~= "Vector3" then
			return nil, nil, nil
		end
		local frame = CFrame.new(position.X, Biomes.WaterLevel - waterline, position.Z) * dock.Rotation
		local placed = {}
		local folder = base:FindFirstChild("MusselNets")
		for _, model in if folder then folder:GetChildren() else {} do
			local cx, cz = model:GetAttribute("X"), model:GetAttribute("Z")
			if type(cx) == "number" and type(cz) == "number" then
				table.insert(placed, { X = cx, Z = cz })
			end
		end
		-- The hotbar cage only exists while one is in stock.
		local otherPlaced = {}
		local otherFolder = base:FindFirstChild("CrabCages")
		for _, model in if otherFolder then otherFolder:GetChildren() else {} do
			local cx, cz = model:GetAttribute("X"), model:GetAttribute("Z")
			if type(cx) == "number" and type(cz) == "number" then
				table.insert(otherPlaced, { X = cx, Z = cz })
			end
		end
		local problem = MusselNets.placeProblem(
			{ MusselNets = { Stock = 1, Placed = placed }, CrabCages = { Placed = otherPlaced } },
			x,
			z
		)
		local reach = hit.Position - root.Position
		if not problem and Vector3.new(reach.X, 0, reach.Z).Magnitude > MusselNets.REACH then
			problem = "That's too far away. Walk to the edge of your pier."
		end
		if not problem then
			for _, point in MusselNets.footprint(size) do
				if not openWater(frame * point, parameters) then
					problem = "Drop it into open water, clear of the piers."
					break
				end
			end
		end
		return position, frame, problem
	end

	local function clearGhost()
		if ghost then
			ghost:Destroy()
		end
		ghost, highlight = nil, nil
	end

	-- A full-size, see-through copy of the held cage.
	local function makeGhost(from: Tool)
		clearGhost()
		local source = from:FindFirstChild("CageModel")
		if not source or not source:IsA("Model") then
			return
		end
		local copy = source:Clone()
		for _, item in copy:GetDescendants() do
			if item:IsA("WeldConstraint") then
				item:Destroy()
			elseif item:IsA("BasePart") then
				item.Anchored, item.Massless = true, false
				item.CanCollide, item.CanQuery, item.CanTouch = false, false, false
				item.CastShadow = false
				item.Transparency = math.max(item.Transparency, 0.35)
			end
		end
		-- Undo the hotbar shrink whether or not the model's scale factor replicated.
		local shrunk = from:GetAttribute("CageScale")
		copy:ScaleTo(copy:GetScale() / (if type(shrunk) == "number" and shrunk > 0 then shrunk else 1))
		copy.Name = "MusselNetGhost"
		local glow = Instance.new("Highlight")
		glow.FillTransparency, glow.OutlineTransparency = 0.6, 0.15
		glow.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		glow.Adornee = copy
		glow.Parent = copy
		ghost, highlight = copy, glow
	end

	local function verb(): string
		local last = UserInputService:GetLastInputType()
		return if last == Enum.UserInputType.Touch
			then "Tap"
			elseif string.sub(last.Name, 1, 7) == "Gamepad" then "Aim at"
			else "Click"
	end

	local function unequip()
		if activated then
			activated:Disconnect()
			activated = nil
		end
		tool = nil
		clearGhost()
		gui.Enabled = false
	end

	local function equip(held: Tool)
		unequip()
		tool = held
		makeGhost(held)
		gui.Enabled = true
		activated = held.Activated:Connect(function()
			-- Re-aim now: a tap moves the pointer just before it activates the tool.
			local position, _, problem = evaluate()
			if position and not problem and os.clock() - lastSent > 0.6 then
				lastSent = os.clock()
				request:FireServer("Place", position)
			elseif problem then
				hint.Text, hint.TextColor3 = problem, INVALID
			end
		end)
	end

	local function bindCharacter(character: Model)
		unequip()
		character.ChildAdded:Connect(function(child)
			if child:IsA("Tool") and child:GetAttribute(TOOL_ATTRIBUTE) then
				equip(child)
			end
		end)
		character.ChildRemoved:Connect(function(child)
			if child == tool then
				unequip()
			end
		end)
		for _, child in character:GetChildren() do
			if child:IsA("Tool") and child:GetAttribute(TOOL_ATTRIBUTE) then
				equip(child)
			end
		end
	end
	player.CharacterAdded:Connect(bindCharacter)
	if player.Character then
		bindCharacter(player.Character)
	end
	local function trackTouch(input: InputObject)
		if input.UserInputType == Enum.UserInputType.Touch then
			lastTouch = Vector2.new(input.Position.X, input.Position.Y)
		end
	end
	UserInputService.InputBegan:Connect(trackTouch)
	UserInputService.InputChanged:Connect(trackTouch)

	-- Where each float sat before this client first moved it. Only this client moves
	-- it, so that stays its resting pivot (a streamed-in copy starts a new entry).
	local floatRest: { [Model]: CFrame } = setmetatable({}, { __mode = "k" }) :: any
	-- Each float part's place relative to that pivot, taken when the part arrives
	-- (still where the server put it). Parts are set from these every frame rather
	-- than nudged from last frame's pose, so a part that replicates late or a
	-- rounding error can't knock one out of line with the rest.
	local partRest: { [BasePart]: CFrame } = setmetatable({}, { __mode = "k" }) :: any
	local moved: { BasePart } = {}
	local poses: { CFrame } = {}
	-- Update anchored parts before physics, as with the other floating objects,
	-- instead of moving them during rendering.
	RunService.PreSimulation:Connect(profiled("MusselNets", function()
		local camera = workspace.CurrentCamera
		-- A local clock: the synced server clock can step as it corrects itself,
		-- and nothing else needs to agree with a float's phase.
		local now = os.clock()
		table.clear(moved)
		table.clear(poses)
		-- Floats ride a gentle swell, each on its own phase.
		for _, model in CollectionService:GetTagged(CAGE_TAG) do
			local float = model:FindFirstChild("Float")
			if not float or not float:IsA("Model") or not camera then
				continue
			end
			local rest = floatRest[float]
			if not rest then
				rest = float:GetPivot()
				floatRest[float] = rest
			end
			for _, child in float:GetChildren() do
				if child:IsA("BasePart") and not partRest[child] then
					partRest[child] = rest:ToObjectSpace(child.CFrame)
				end
			end
			if (rest.Position - camera.CFrame.Position).Magnitude > BOB_DISTANCE then
				continue
			end
			local phase = rest.X * 0.37 + rest.Z * 0.61
			local lift = math.sin(now * 1.6 + phase) * 0.12
			local tilt = CFrame.Angles(math.sin(now * 1.1 + phase) * 0.07, 0, math.cos(now * 1.3 + phase) * 0.07)
			local pose = CFrame.new(rest.Position + Vector3.new(0, lift, 0)) * tilt * rest.Rotation
			for _, child in float:GetChildren() do
				local offset = if child:IsA("BasePart") then partRest[child] else nil
				if child:IsA("BasePart") and offset then
					table.insert(moved, child)
					table.insert(poses, pose * offset)
				end
			end
		end
		if #moved > 0 then
			workspace:BulkMoveTo(moved, poses, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end))
	RunService.RenderStepped:Connect(profiled("MusselNets/2", function()
		local camera = workspace.CurrentCamera
		if not tool or not ghost or not highlight then
			return
		end
		if not camera then
			ghost.Parent = nil
			return
		end
		local position, frame, problem = evaluate()
		if frame then
			ghost:PivotTo(frame)
			ghost.Parent = camera
		else
			ghost.Parent = nil
		end
		local ok = position ~= nil and problem == nil
		highlight.FillColor = if ok then VALID else INVALID
		highlight.OutlineColor = if ok then VALID else INVALID
		hint.Text = if ok then verb() .. " the water to drop your mussel net here." else problem or ""
		hint.TextColor3 = if ok then Theme.Colors.Text else INVALID
	end))
end

return MusselNetsClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="335">
          <Properties>
            <string name="Name">MutationEffects</string>
            <string name="Source"><![CDATA[-- Cycles the colours of Rainbow fish, wherever they are: in hands, freezers,
-- customers' arms and menu viewports. FishModels paints each part's base hue,
-- so a fish this never reaches still shows a still rainbow.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FishModels = require(ReplicatedStorage.Shared.FishModels)

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end

local MutationEffects = {}
local CYCLE_SECONDS = 4
local STEP_SECONDS = 1 / 20
local parts: { [Model]: { BasePart } } = setmetatable({}, { __mode = "k" }) :: any
local voids: { [Model]: any } = setmetatable({}, { __mode = "k" }) :: any
local started = false
-- Recolouring rewrites every painted part, and the renderer pays for each one.
-- Fish in the world past this range (stocked freezers and shop displays across
-- the harbour) hold their colours; viewports and held fish always animate.
local ANIMATE_DISTANCE = 160
-- A fish in a character's hand or an NPC's arms is part of that Humanoid model, and a
-- colour change there makes the renderer rebuild the whole character's mesh batch
-- (FastCluster in the MicroProfiler). Those fish step every HELD_EVERY ticks instead.
local HELD_EVERY = 4

local function held(model: Model): boolean
	local holder = model:FindFirstAncestorWhichIsA("Model")
	while holder do
		if holder:FindFirstChildOfClass("Humanoid") then
			return true
		end
		holder = holder:FindFirstAncestorWhichIsA("Model")
	end
	return false
end

local function outOfView(list: { BasePart }, eye: Vector3?): boolean
	local first = list[1]
	return eye ~= nil
		and first ~= nil
		and first:IsDescendantOf(workspace)
		and (first.Position - eye).Magnitude > ANIMATE_DISTANCE
end

local function painted(model: Model): { BasePart }
	local list = parts[model]
	if not list then
		list = {}
		for _, item in model:GetDescendants() do
			if item:IsA("BasePart") and item:GetAttribute("RainbowHue") ~= nil then
				table.insert(list, item)
			end
		end
		parts[model] = list
	end
	return list
end

local glitchParts: { [Model]: { BasePart } } = setmetatable({}, { __mode = "k" }) :: any
local function paintedGlitch(model: Model): { BasePart }
 local list = glitchParts[model]
 if not list then
  list = {}
  for _, item in model:GetDescendants() do
   if item:IsA("BasePart") and item:GetAttribute("GlitchBaseColor") then table.insert(list, item) end
  end
  glitchParts[model] = list
 end
 return list
end

local function animateVoid(model: Model, time: number)
	local aura = voids[model]
	if not aura then
		for _, item in model:GetDescendants() do
			if item:IsA("BasePart") and item:GetAttribute("VoidAuraCore") then
				local points = {}
				for _, child in item:GetChildren() do
					if child:IsA("Attachment") and child:GetAttribute("VoidLensAngle") ~= nil then
						table.insert(points, child)
					end
				end
				aura = { core = item, points = points }
				voids[model] = aura
				break
			end
		end
	end
	if not aura or not aura.core.Parent then
		return
	end
	local core = aura.core
	local camera = workspace.CurrentCamera
	-- Keep menu previews animated; distant stored fish can hold a still lens.
	if model:IsDescendantOf(workspace) and camera and (core.Position - camera.CFrame.Position).Magnitude > 160 then
		return
	end
	local original = core:GetAttribute("VoidAuraOriginalSize")
	local scale = core.Size.X / original.X
	local center = core:GetAttribute("VoidAuraCenter") * scale
	local radius = core:GetAttribute("VoidAuraRadius") * scale
	for _, point in aura.points do
		local angle = point:GetAttribute("VoidLensAngle")
		local warp = 1 + math.sin(angle * 3 + time * 2.4) * 0.12
		local turn = angle + time * 0.55
		point.Position = center
			+ Vector3.new(
				math.cos(turn) * radius.X * warp,
				math.sin(turn) * radius.Y * warp,
				math.sin(angle * 2 - time * 1.5) * radius.Z * 0.55
			)
	end
end

function MutationEffects.start()
	if started then
		return
	end
	started = true
	CollectionService:GetInstanceRemovedSignal(FishModels.RAINBOW_TAG):Connect(function(model)
		parts[model] = nil
	end)
	CollectionService:GetInstanceRemovedSignal(FishModels.VOID_TAG):Connect(function(model)
		voids[model] = nil
	end)
	local elapsed = 0
	local steps = 0
	RunService.RenderStepped:Connect(profiled("MutationEffects", function(dt)
		elapsed += dt
		if elapsed < STEP_SECONDS then
			return
		end
		elapsed = 0
		steps += 1
		local heldStep = steps % HELD_EVERY == 0
		local shift = os.clock() / CYCLE_SECONDS
		local camera = workspace.CurrentCamera
		local eye = camera and camera.CFrame.Position
		for _, model in CollectionService:GetTagged(FishModels.RAINBOW_TAG) do
			if model:IsA("Model") and not model:HasTag(FishModels.VOID_TAG) then
				local list = painted(model)
				if #list == 0 or outOfView(list, eye) or (not heldStep and held(model)) then
					continue
				end
				for _, item in list do
					item.Color = Color3.fromHSV(
						(item:GetAttribute("RainbowHue") + shift) % 1,
						item:GetAttribute("RainbowSaturation") or 0.6,
						item:GetAttribute("RainbowValue") or 1
					)
				end
			end
		end
  for _, model in CollectionService:GetTagged(FishModels.GLITCH_TAG) do
   local list = if model:IsA("Model") then paintedGlitch(model) else nil
   if list and #list > 0 and not outOfView(list, eye) and (heldStep or not held(model)) then
    local tick = math.floor(os.clock() * 13)
    for index, item in list do
     local phase = (tick + index * 7) % 11
     item.Color = if phase < 2 then Color3.fromRGB(255, 30, 180) elseif phase == 2 then Color3.new(1, 1, 1) else item:GetAttribute("GlitchBaseColor")
     item.Transparency = if phase == 3 then 0.55 else item:GetAttribute("GlitchBaseTransparency")
    end
   end
  end
		for _, model in CollectionService:GetTagged(FishModels.VOID_TAG) do
			if model:IsA("Model") then
				animateVoid(model, os.clock())
			end
		end
	end))
end

return MutationEffects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="336">
          <Properties>
            <string name="Name">OfficeComputer</string>
            <string name="Source"><![CDATA[-- The office PC in your own base house (Map/OfficeDesk). A "Use computer" prompt on the chair sits
-- you down (OfficeComputerService), the camera settles on the monitor, and the tube shows
-- HARBOUR-OS: a green-phosphor home screen with a pixel pointer that follows your mouse. The camera
-- holds still, square on to the glass, so the screen is a ScreenGui laid exactly over the glass's
-- projection each frame (Roblox's SurfaceGui mouse input never reached it, 2026-11-07).
-- Apps open in a window; the first is Harbour Exchange (StockApp). Jump or press EXIT to stand up.
local CollectionService = game:GetService("CollectionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local RetroUI = require(script.Parent.RetroUI)
local StockApp = require(script.Parent.StockApp)
local Calendar = require(ReplicatedStorage.Shared.Calendar)
local Stocks = require(ReplicatedStorage.Shared.Stocks)

local OfficeComputer = {}

local BASE_TAG = "PlayerBase"
local PROMPT_NAME = "OfficeComputerPrompt"
local GUI_NAME = "OfficeComputerScreen"
-- Narrow field of view so the tube fills the view without fisheye.
local FOV = 40
-- Share of the view the glass fills (the rest shows the beige bezel).
local FILL = 0.86

local C = RetroUI.Colors
local px = UDim2.fromOffset

local player = Players.LocalPlayer

type Session = {
	Desk: Model,
	Seat: Seat,
	Screen: BasePart,
	Gui: ScreenGui,
	Connections: { RBXScriptConnection },
	App: { destroy: () -> () }?,
	Saved: { [string]: any },
	HiddenGuis: { LayerCollector },
	ScreenLabels: { SurfaceGui },
	Hidden: { BasePart | Decal },
}

local session: Session? = nil
local busy = false
local prompts: { [ProximityPrompt]: Instance } = {}

local function notice(message: string)
	pcall(StarterGui.SetCore, StarterGui, "SendNotification", {
		Title = "Office PC",
		Text = message,
		Duration = 4,
	})
end

local function requestServer(action: string): (boolean, string?)
	local folder = ReplicatedStorage:FindFirstChild("OfficeComputer")
	local remote = folder and folder:FindFirstChild("Request")
	if not remote or not remote:IsA("RemoteFunction") then
		return false, "The computer isn't ready yet."
	end
	local ok, result = pcall(remote.InvokeServer, remote, action)
	if not ok or type(result) ~= "table" then
		return false, "The computer didn't respond. Try again."
	end
	return result.Ok == true, result.Message
end

local function ownerBase(desk: Instance): Instance?
	local node = desk.Parent
	while node and node ~= workspace do
		if CollectionService:HasTag(node, BASE_TAG) then
			return node
		end
		node = node.Parent
	end
	return nil
end

local function refreshPrompts()
	for prompt, base in prompts do
		prompt.Enabled = session == nil and base:GetAttribute("OwnerUserId") == player.UserId
	end
end

----------------------------------------------------------------------------------------------------
-- Camera and seat

local function cameraTarget(screen: BasePart): CFrame
	local camera = workspace.CurrentCamera
	local view = camera.ViewportSize
	local aspect = view.X / math.max(view.Y, 1)
	local tanHalf = math.tan(math.rad(FOV / 2))
	local height, width = screen.Size.Y / FILL, screen.Size.X / FILL
	local distance = math.max(height / 2 / tanHalf, width / 2 / (tanHalf * aspect))
	local face = screen.CFrame * CFrame.new(0, 0, screen.Size.Z / 2)
	return CFrame.lookAt((face * CFrame.new(0, 0, distance)).Position, face.Position, screen.CFrame.UpVector)
end

-- The glass's rectangle on screen (viewport pixels): top-left corner and size.
local function screenRect(screen: BasePart): (Vector2, Vector2)
	local camera = workspace.CurrentCamera
	local face = screen.CFrame * CFrame.new(0, 0, screen.Size.Z / 2)
	local halfX, halfY = screen.Size.X / 2, screen.Size.Y / 2
	local low, high = Vector2.new(math.huge, math.huge), Vector2.new(-math.huge, -math.huge)
	for _, corner in { Vector3.new(-halfX, halfY, 0), Vector3.new(halfX, -halfY, 0) } do
		local point = camera:WorldToViewportPoint((face * CFrame.new(corner)).Position)
		low = Vector2.new(math.min(low.X, point.X), math.min(low.Y, point.Y))
		high = Vector2.new(math.max(high.X, point.X), math.max(high.Y, point.Y))
	end
	return low, high - low
end

----------------------------------------------------------------------------------------------------
-- HARBOUR-OS

local function buildDesktop(root: Frame, current: Session, leave: () -> ())
	local status: TextLabel
	local function setStatus(text: string)
		status.Text = text
	end

	-- Menu bar in inverse video.
	local bar = RetroUI.frame(root, "MenuBar", px(0, 0), px(800, 34), {
		BackgroundTransparency = 0,
		BackgroundColor3 = C.Bright,
	})
	local logo = RetroUI.text(bar, "Logo", "HARBOUR-OS", px(14, 0), px(260, 34), {
		Font = RetroUI.Fonts.Title,
		Size = 16,
		Color = C.Screen,
	})
	logo.TextStrokeTransparency = 1
	local clock = RetroUI.text(bar, "Clock", "", px(380, 0), px(406, 34), {
		Size = 20,
		Color = C.Screen,
		AlignX = Enum.TextXAlignment.Right,
	})
	clock.TextStrokeTransparency = 1
	local function paintClock()
		local date = Calendar.now()
		local hour = math.floor(date.Hour)
		local minute = math.floor((date.Hour - hour) * 60)
		clock.Text = string.format(
			"%s  %02d:%02d   %s",
			string.upper(Calendar.format(date, true)),
			hour,
			minute,
			Stocks.money(player:GetAttribute("Cash") or 0)
		)
	end
	paintClock()

	-- Status line and the way out.
	RetroUI.rule(root, "StatusRule", px(0, 564), UDim.new(1, 0), C.Mid)
	status = RetroUI.text(root, "Status", "", px(14, 568), px(640, 30), { Size = 16, Color = C.Mid })
	RetroUI.button(root, "Exit", "EXIT", px(686, 568), px(100, 28), leave, { Font = RetroUI.Fonts.Title, Size = 14 })

	local desktop = RetroUI.frame(root, "Desktop", px(0, 36), px(800, 526))
	local window: Frame? = nil
	local readyText = "READY. CLICK STOCKS TO OPEN THE EXCHANGE.  JUMP OR EXIT TO STAND UP."

	local function closeWindow()
		if current.App then
			current.App.destroy()
			current.App = nil
		end
		if window then
			window:Destroy()
			window = nil
		end
		setStatus(readyText)
	end

	-- Classic zoom rectangle from the icon out to the window, then the window itself.
	local function openApp(from: GuiObject)
		if window then
			return
		end
		-- Absolute sizes are scaled screen pixels; convert back to canvas pixels.
		local scale = math.max(root.AbsoluteSize.X / RetroUI.WIDTH, 1e-3)
		local start = (from.AbsolutePosition - root.AbsolutePosition) / scale
		local size = from.AbsoluteSize / scale
		local zoom = RetroUI.frame(root, "Zoom", px(start.X, start.Y), px(size.X, size.Y), {
			ZIndex = 40,
		})
		RetroUI.border(zoom, C.Hot, 2)
		local tween = TweenService:Create(zoom, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = px(16, 44),
			Size = px(768, 516),
		})
		tween:Play()
		tween.Completed:Wait()
		zoom:Destroy()
		if session ~= current or window then
			return
		end
		local frame = RetroUI.frame(root, "Window", px(16, 44), px(768, 516), {
			BackgroundTransparency = 0,
			BackgroundColor3 = C.Screen,
			ZIndex = 5,
		})
		RetroUI.border(frame, C.Bright, 2)
		window = frame
		local title = RetroUI.frame(frame, "TitleBar", px(0, 0), px(768, 30), {
			BackgroundTransparency = 0,
			BackgroundColor3 = C.Bright,
		})
		local titleText = RetroUI.text(title, "Title", StockApp.TITLE .. "  -  LIVE MARKET", px(12, 0), px(600, 30), {
			Font = RetroUI.Fonts.Title,
			Size = 14,
			Color = C.Screen,
		})
		titleText.TextStrokeTransparency = 1
		-- Close box: dark on the bright title bar, inverted under the pointer.
		local close = Instance.new("TextButton")
		close.Name = "Close"
		close.AutoButtonColor = false
		close.Text = "X"
		close.Font = RetroUI.Fonts.Title
		close.TextSize = 16
		close.BackgroundColor3 = C.Screen
		close.BackgroundTransparency = 1
		close.BorderSizePixel = 0
		close.Position = px(722, 0)
		close.Size = px(46, 30)
		close.Parent = title
		RetroUI.setColor(close, C.Screen)
		close.TextStrokeTransparency = 1
		RetroUI.hover(close, function(hot)
			close.BackgroundTransparency = if hot then 0 else 1
			RetroUI.setColor(close, if hot then C.Bright else C.Screen)
		end)
		close.Activated:Connect(closeWindow)
		local content = RetroUI.frame(frame, "Content", px(0, 30), px(768, 486))
		setStatus("CONNECTING TO HARBOUR EXCHANGE...")
		task.spawn(function()
			local mounted, app = pcall(StockApp.mount, content, setStatus)
			if not mounted then
				warn("[OfficeComputer] Harbour Exchange failed to start: " .. tostring(app))
				if window == frame then
					RetroUI.text(
						content,
						"Crashed",
						"HARBOUR EXCHANGE HIT AN ERROR.\nCLOSE THE WINDOW AND TRY AGAIN.",
						px(0, 0),
						UDim2.fromScale(1, 1),
						{
							AlignX = Enum.TextXAlignment.Center,
							Wrap = true,
							Size = 22,
						}
					)
					setStatus("! THE APP COULD NOT START.")
				end
				return
			end
			if session ~= current or window ~= frame then
				app.destroy()
				return
			end
			current.App = app
			setStatus("PRICES UPDATE EVERY FEW SECONDS. DIVIDENDS PAY EVERY 7 IN-GAME DAYS.")
		end)
	end

	-- Desktop icon: a little framed chart above its name.
	local icon = Instance.new("TextButton")
	icon.Name = "StocksIcon"
	icon.AutoButtonColor = false
	icon.Text = ""
	icon.BackgroundTransparency = 1
	icon.Position = px(40, 36)
	icon.Size = px(120, 118)
	icon.Parent = desktop
	local art = RetroUI.frame(icon, "Art", px(24, 6), px(72, 60), {
		BackgroundTransparency = 0,
		BackgroundColor3 = C.Panel,
	})
	RetroUI.border(art, C.Bright, 2)
	local points = { 44, 38, 40, 28, 32, 20, 24, 12 }
	for index = 1, #points - 1 do
		local a = Vector2.new(6 + (index - 1) * 8.5, points[index])
		local b = Vector2.new(6 + index * 8.5, points[index + 1])
		local delta = b - a
		local middle = (a + b) / 2
		RetroUI.frame(art, "Line", px(middle.X, middle.Y), px(delta.Magnitude + 1, 3), {
			BackgroundTransparency = 0,
			BackgroundColor3 = C.Hot,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Rotation = math.deg(math.atan2(delta.Y, delta.X)),
		})
	end
	RetroUI.text(
		art,
		"Dollar",
		"$",
		px(48, 34),
		px(20, 22),
		{ Font = RetroUI.Fonts.Title, Size = 14, Color = C.Bright }
	)
	local iconLabel = RetroUI.text(icon, "Label", "STOCKS", px(0, 76), px(120, 30), {
		Font = RetroUI.Fonts.Title,
		Size = 14,
		AlignX = Enum.TextXAlignment.Center,
	})
	iconLabel.BackgroundColor3 = C.Bright
	local function paintIcon(hot: boolean)
		iconLabel.BackgroundTransparency = if hot then 0 else 1
		RetroUI.setColor(iconLabel, if hot then C.Screen else C.Bright)
		iconLabel.TextStrokeTransparency = if hot then 1 else 0.88
	end
	RetroUI.hover(icon, paintIcon)
	icon.Activated:Connect(function()
		openApp(art)
	end)

	-- A little welcome note so the desk reads as somebody's office.
	RetroUI.text(
		desktop,
		"Welcome",
		"WELCOME BACK, " .. string.upper(player.DisplayName) .. ".\nTHE MARKET IS OPEN.",
		px(200, 46),
		px(560, 60),
		{ Size = 20, Color = C.Mid, Wrap = true, AlignY = Enum.TextYAlignment.Top }
	)

	setStatus(readyText)
	local sinceClock = 0
	table.insert(
		current.Connections,
		RunService.Heartbeat:Connect(function(step)
			sinceClock += step
			if sinceClock >= 1 then
				sinceClock = 0
				paintClock()
			end
		end)
	)
end

-- A short power-on self test, typed out line by line. Any click skips it.
local BOOT = {
	"HARBOUR BIOS  V2.1",
	"MEMORY TEST  640K OK",
	"FLOPPY A: ......... READY",
	"FIXED DISK C: ..... 20MB",
	"",
	"LOADING HARBOUR-OS 3.30...",
}

local function boot(root: Frame, current: Session, finished: () -> ())
	local screen = RetroUI.frame(root, "Boot", px(0, 0), px(800, 600), {
		BackgroundTransparency = 0,
		BackgroundColor3 = C.Screen,
		ZIndex = 30,
	})
	local text = RetroUI.text(screen, "Text", "", px(40, 40), px(720, 400), {
		Size = 22,
		Wrap = true,
		AlignY = Enum.TextYAlignment.Top,
	})
	text.ZIndex = 30
	local done = false
	local function finish()
		if done then
			return
		end
		done = true
		screen:Destroy()
		finished()
	end
	local skip = Instance.new("TextButton")
	skip.BackgroundTransparency = 1
	skip.Text = ""
	skip.Size = UDim2.fromScale(1, 1)
	skip.ZIndex = 31
	skip.Parent = screen
	skip.Activated:Connect(finish)
	task.spawn(function()
		local shown = {}
		for _, line in BOOT do
			if done or session ~= current then
				return
			end
			table.insert(shown, line)
			text.Text = table.concat(shown, "\n") .. "_"
			task.wait(0.14)
		end
		task.wait(0.2)
		if session == current then
			finish()
		end
	end)
end

----------------------------------------------------------------------------------------------------
-- Sitting down and getting up

local function leave(requestStand: boolean)
	local current = session
	if not current then
		return
	end
	session = nil
	for _, connection in current.Connections do
		connection:Disconnect()
	end
	pcall(RunService.UnbindFromRenderStep, RunService, "OfficeComputerView")
	RetroUI.setHovered(nil)
	if current.App then
		current.App.destroy()
	end
	current.Gui:Destroy()
	for _, label in current.ScreenLabels do
		if label.Parent then
			label.Enabled = true
		end
	end
	for _, item in current.Hidden do
		if item.Parent then
			item.LocalTransparencyModifier = 0
		end
	end
	for _, gui in current.HiddenGuis do
		if gui.Parent then
			gui.Enabled = true
		end
	end
	local saved = current.Saved
	UserInputService.MouseIconEnabled = saved.MouseIcon
	pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Backpack, saved.Backpack)
	local camera = workspace.CurrentCamera
	camera.FieldOfView = saved.FieldOfView
	camera.CameraType = saved.CameraType
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
	refreshPrompts()
	if requestStand then
		task.spawn(requestServer, "Stand")
	end
end

local function enter(desk: Model)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local chair = desk:FindFirstChild("Chair")
	local seat = chair and chair:FindFirstChild("Seat")
	local screen = desk:FindFirstChild("ScreenCurve", true)
	if not humanoid or not seat or not seat:IsA("Seat") or not screen or not screen:IsA("BasePart") then
		task.spawn(requestServer, "Stand")
		return
	end
	local camera = workspace.CurrentCamera
	local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui

	local ok, backpack = pcall(StarterGui.GetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Backpack)
	local gui = Instance.new("ScreenGui")
	gui.Name = GUI_NAME
	gui.IgnoreGuiInset = true -- same pixel space as WorldToViewportPoint and GetMouseLocation
	gui.DisplayOrder = 50
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Enabled = false -- shown once the camera has settled on the glass

	local current: Session = {
		Desk = desk,
		Seat = seat,
		Screen = screen,
		Gui = gui,
		Connections = {},
		App = nil,
		Saved = {
			CameraType = camera.CameraType,
			FieldOfView = camera.FieldOfView,
			MouseIcon = UserInputService.MouseIconEnabled,
			Backpack = if ok then backpack else true,
		},
		HiddenGuis = {},
		ScreenLabels = {},
		Hidden = {},
	}
	session = current
	refreshPrompts()

	-- Nothing else on screen while you're at the computer.
	for _, item in playerGui:GetChildren() do
		if item:IsA("ScreenGui") and item.Enabled then
			item.Enabled = false
			table.insert(current.HiddenGuis, item)
		end
	end
	pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Backpack, false)
	-- The camera sits where your head is; hide your own character so it can't clip the view.
	for _, item in character:GetDescendants() do
		if item:IsA("BasePart") or item:IsA("Decal") then
			table.insert(current.Hidden, item)
		end
	end

	camera.CameraType = Enum.CameraType.Scriptable
	local target = cameraTarget(screen)
	local glide = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
	TweenService:Create(camera, glide, { CFrame = target, FieldOfView = FOV }):Play()
	task.delay(0.72, function()
		if session == current then
			target = cameraTarget(screen)
			camera.CFrame = target
		end
	end)
	table.insert(
		current.Connections,
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			target = cameraTarget(screen)
			camera.CFrame = target
		end)
	)

	local root = RetroUI.frame(gui, "Root", px(0, 0), px(RetroUI.WIDTH, RetroUI.HEIGHT), {
		BackgroundTransparency = 0,
		BackgroundColor3 = C.Screen,
		ClipsDescendants = true,
	})
	local rootScale = Instance.new("UIScale")
	rootScale.Parent = root
	RetroUI.scanlines(root)
	local pointer = RetroUI.cursor(root, 2)
	pointer.Visible = false
	gui.Parent = playerGui

	-- Lay the canvas over the glass (it only moves if the window is resized). `corner` is the
	-- canvas's top-left in full-viewport pixels: the space of WorldToViewportPoint,
	-- GetMouseLocation and Position in this IgnoreGuiInset gui.
	local corner = Vector2.zero
	local function fit()
		local low, size = screenRect(screen)
		rootScale.Scale = math.max(size.X / RetroUI.WIDTH, 1e-3)
		corner = Vector2.new(math.floor(low.X + 0.5), math.floor(low.Y + 0.5))
		root.Position = px(corner.X, corner.Y)
	end

	-- GetGuiObjectsAtPosition and AbsolutePosition don't agree on whether the top bar counts
	-- (assuming they did put the highlight a top-bar height above the pointer, 2026-11-07). An
	-- invisible probe in the canvas corner tells which shift makes a hit test land on it; a wrong
	-- shift lands a whole top bar off the canvas.
	local probe = RetroUI.frame(root, "HitProbe", px(2, 2), px(6, 6))
	RetroUI.ignoreHover(probe)
	local queryShift = Vector2.zero
	local sinceProbe = math.huge
	local function calibrate()
		local inset = GuiService:GetGuiInset()
		local spot = probe.AbsolutePosition + probe.AbsoluteSize / 2
		for _, shift in { queryShift, Vector2.zero, inset, -inset } do
			local at = spot + shift
			for _, object in playerGui:GetGuiObjectsAtPosition(at.X, at.Y) do
				if object == probe then
					queryShift = shift
					return
				end
			end
		end
	end

	local mouse = UserInputService.MouseEnabled
	if mouse then
		UserInputService.MouseIconEnabled = false
	end
	RunService:BindToRenderStep("OfficeComputerView", Enum.RenderPriority.Camera.Value + 1, function()
		if session ~= current then
			return
		end
		for _, item in current.Hidden do
			item.LocalTransparencyModifier = 1
		end
		fit()
		if not (mouse and gui.Enabled) then
			return
		end
		-- Measured against `corner`, never root.AbsolutePosition: AbsolutePosition is in GUI space,
		-- which starts below the top bar even in an IgnoreGuiInset gui, and using it drew the
		-- pointer a top-bar height below the real mouse (2026-11-07).
		local at = UserInputService:GetMouseLocation()
		local point = (at - corner) / rootScale.Scale
		local inside = point.X >= 0 and point.Y >= 0 and point.X < RetroUI.WIDTH and point.Y < RetroUI.HEIGHT
		pointer.Visible = inside
		-- Off the glass, show the real cursor so it never just vanishes.
		if UserInputService.MouseIconEnabled == inside then
			UserInputService.MouseIconEnabled = not inside
		end
		if not inside then
			RetroUI.setHovered(nil)
			return
		end
		pointer.Position = px(point.X, point.Y)
		-- Hover follows the drawn pointer exactly: the pointer's spot in AbsolutePosition space,
		-- moved into GetGuiObjectsAtPosition's space by the probed shift.
		local absAt = root.AbsolutePosition + point * rootScale.Scale
		sinceProbe += 1
		if sinceProbe >= 30 then
			sinceProbe = 0
			calibrate()
		end
		local queryAt = absAt + queryShift
		local under = playerGui:GetGuiObjectsAtPosition(queryAt.X, queryAt.Y)
		RetroUI.setHovered(RetroUI.hoverTarget(under, absAt))
	end)

	-- Once the camera has arrived: swap the idle DOS prompt for HARBOUR-OS and boot.
	task.delay(0.75, function()
		if session ~= current then
			return
		end
		for _, item in screen:GetChildren() do
			if item:IsA("SurfaceGui") and item.Enabled then
				item.Enabled = false
				table.insert(current.ScreenLabels, item)
			end
		end
		fit()
		gui.Enabled = true
		boot(root, current, function()
			buildDesktop(root, current, function()
				leave(true)
			end)
		end)
	end)

	-- Standing up by any other route (jumping, the server releasing the seat, dying) closes the PC.
	local seatedOnce = humanoid.SeatPart == seat
	table.insert(
		current.Connections,
		humanoid:GetPropertyChangedSignal("SeatPart"):Connect(function()
			if humanoid.SeatPart == seat then
				seatedOnce = true
			elseif seatedOnce then
				leave(false)
			end
		end)
	)
	table.insert(
		current.Connections,
		humanoid.Died:Connect(function()
			leave(false)
		end)
	)
	table.insert(
		current.Connections,
		player.CharacterRemoving:Connect(function()
			leave(false)
		end)
	)
	task.delay(3, function()
		if session == current and not seatedOnce then
			leave(true)
		end
	end)
end

local function sitDown(desk: Model)
	if session or busy then
		return
	end
	busy = true
	refreshPrompts()
	local ok, message = requestServer("Sit")
	busy = false
	if ok then
		enter(desk)
	else
		refreshPrompts()
		notice(message or "You can't use this computer right now.")
	end
end

----------------------------------------------------------------------------------------------------
-- Finding desks

local function addPrompt(desk: Model, base: Instance, cushion: BasePart)
	if cushion:FindFirstChild(PROMPT_NAME) then
		return
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = PROMPT_NAME
	prompt.ActionText = "Use computer"
	prompt.ObjectText = "Office PC"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 7
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false
	prompt.Parent = cushion
	prompts[prompt] = base
	prompt.Triggered:Connect(function()
		sitDown(desk)
	end)
	prompt.AncestryChanged:Connect(function()
		if not prompt:IsDescendantOf(workspace) then
			prompts[prompt] = nil
		end
	end)
	refreshPrompts()
end

local tracked: { [Instance]: boolean } = {}
local function trackDesk(desk: Instance)
	if tracked[desk] or not desk:IsA("Model") then
		return
	end
	local base = ownerBase(desk)
	if not base then
		return
	end
	tracked[desk] = true
	local function consider(item: Instance)
		if item.Name == "SeatCushion" and item:IsA("BasePart") and item.Parent and item.Parent.Name == "Chair" then
			addPrompt(desk, base, item)
		end
	end
	-- Streaming may deliver (and re-deliver) the chair after the desk model arrives.
	desk.DescendantAdded:Connect(consider)
	for _, item in desk:GetDescendants() do
		consider(item)
	end
	desk.AncestryChanged:Connect(function()
		if not desk:IsDescendantOf(workspace) then
			tracked[desk] = nil
		end
	end)
end

local watchedBases: { [Instance]: boolean } = {}
local function trackBase(base: Instance)
	if watchedBases[base] then
		return
	end
	watchedBases[base] = true
	base:GetAttributeChangedSignal("OwnerUserId"):Connect(refreshPrompts)
	base.DescendantAdded:Connect(function(item)
		if item.Name == "OfficeDesk" then
			trackDesk(item)
		end
	end)
	local desk = base:FindFirstChild("OfficeDesk", true)
	if desk then
		trackDesk(desk)
	end
end

function OfficeComputer.start()
	for _, base in CollectionService:GetTagged(BASE_TAG) do
		trackBase(base)
	end
	CollectionService:GetInstanceAddedSignal(BASE_TAG):Connect(trackBase)
end

return OfficeComputer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="337">
          <Properties>
            <string name="Name">OverlayInset</string>
            <string name="Source"><![CDATA[-- Full-screen dim overlays (shop/kitchen/workshop backdrops) live in ScreenGuis that keep
-- IgnoreGuiInset off so their content sits below the Roblox top bar. That leaves the top-bar
-- strip undimmed. Instead of moving every overlay (which would shift its centred card), this
-- gives each one a child strip above it that mirrors its colour and transparency.
local Players = game:GetService("Players")

local OverlayInset = {}

local COVER_NAME = "InsetCover"
local COVER_HEIGHT = 400 -- taller than any top bar; the part above the screen is never drawn
local FULL = UDim2.fromScale(1, 1)
local ORIGIN = UDim2.new()

local covered: { [GuiObject]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local function isOverlay(object: Instance): boolean
	if not object:IsA("GuiObject") then
		return false
	end
	local screen = object.Parent
	if not (screen and screen:IsA("ScreenGui")) or screen.IgnoreGuiInset then
		return false
	end
	if object.Size ~= FULL or object.Position ~= ORIGIN or object.AnchorPoint ~= Vector2.zero then
		return false
	end
	local colour = object.BackgroundColor3
	return colour.R + colour.G + colour.B < 0.3
end

local function cover(overlay: GuiObject)
	if covered[overlay] or overlay:FindFirstChild(COVER_NAME) then
		return
	end
	covered[overlay] = true
	local strip = Instance.new("Frame")
	strip.Name = COVER_NAME
	strip.BorderSizePixel = 0
	strip.Active = overlay.Active
	strip.Position = UDim2.new(0, 0, 0, -COVER_HEIGHT)
	strip.Size = UDim2.new(1, 0, 0, COVER_HEIGHT)
	local function sync()
		strip.BackgroundColor3 = overlay.BackgroundColor3
		strip.BackgroundTransparency = overlay.BackgroundTransparency
		strip.ZIndex = overlay.ZIndex
	end
	sync()
	overlay:GetPropertyChangedSignal("BackgroundColor3"):Connect(sync)
	overlay:GetPropertyChangedSignal("BackgroundTransparency"):Connect(sync)
	overlay:GetPropertyChangedSignal("ZIndex"):Connect(sync)
	strip.Parent = overlay
end

local function check(object: Instance)
	-- Deferred so properties set right after parenting are in place.
	task.defer(function()
		if object.Parent and isOverlay(object) then
			cover(object :: GuiObject)
		end
	end)
end

function OverlayInset.start()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local function watchScreen(screen: Instance)
		if not screen:IsA("ScreenGui") then
			return
		end
		for _, child in screen:GetChildren() do
			check(child)
		end
		screen.ChildAdded:Connect(check)
	end
	for _, screen in playerGui:GetChildren() do
		watchScreen(screen)
	end
	playerGui.ChildAdded:Connect(function(screen)
		task.defer(watchScreen, screen)
	end)
end

return OverlayInset
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="338">
          <Properties>
            <string name="Name">Oxygen</string>
            <string name="Source"><![CDATA[-- Compact breath meter beside the avatar. The server supplies the state; this module only
-- presents it and fades the local screen before the server respawns the player.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local CharacterMeter = require(script.Parent.CharacterMeter)

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end

local Oxygen = {}
local started = false

local BUBBLE_COUNT = 4
local BAR_FADE = TweenInfo.new(0.18, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
local BLACKOUT_FADE = TweenInfo.new(1.15, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
local RETURN_FADE = TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

local function rounded(item: GuiObject, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = item
end

function Oxygen.start()
	if started then
		return
	end
	started = true

	local player = Players.LocalPlayer
	local gui = Instance.new("ScreenGui")
	gui.Name = "OxygenHud"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 20
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	-- Match the cast meter, on the avatar's left side.
	local meter = Instance.new("Frame")
	meter.Name = "OxygenBar"
	meter.Size = UDim2.fromOffset(14, 180)
	meter.BackgroundColor3 = Color3.fromRGB(6, 24, 43)
	meter.BackgroundTransparency = 1
	meter.BorderSizePixel = 0
	meter.Visible = false
	meter.Parent = gui
	rounded(meter, 2)
	local meterStroke = Instance.new("UIStroke")
	meterStroke.Color = Color3.fromRGB(102, 206, 255)
	meterStroke.Thickness = 1.5
	meterStroke.Transparency = 1
	meterStroke.Parent = meter

	local caption = Instance.new("CanvasGroup")
	caption.Name = "Caption"
	caption.BackgroundTransparency = 1
	caption.BorderSizePixel = 0
	caption.AnchorPoint = Vector2.new(0.5, 0)
	caption.Position = UDim2.new(0.5, 0, 1, 7)
	caption.Size = UDim2.fromOffset(34, 22)
	caption.GroupTransparency = 1
	caption.ZIndex = 2
	caption.Parent = meter
	-- Three circles form a bubble icon without an uploaded image.
	for index, bubble in { { 19, 5, 8 }, { 11, 12, 6 }, { 22, 17, 4 } } do
		local dot = Instance.new("Frame")
		dot.Name = "BubbleIcon" .. index
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.Position = UDim2.fromOffset(bubble[1], bubble[2])
		dot.Size = UDim2.fromOffset(bubble[3], bubble[3])
		dot.BackgroundColor3 = Color3.fromRGB(164, 221, 255)
		dot.BorderSizePixel = 0
		dot.Parent = caption
		rounded(dot, 10)
	end

	local track = Instance.new("Frame")
	track.Name = "Track"
	track.Position = UDim2.fromOffset(1, 1)
	track.Size = UDim2.new(1, -2, 1, -2)
	track.BackgroundColor3 = Color3.fromRGB(10, 54, 83)
	track.BackgroundTransparency = 1
	track.BorderSizePixel = 0
	track.ClipsDescendants = true
	track.Parent = meter
	rounded(track, 1)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.AnchorPoint = Vector2.new(0, 1)
	fill.Position = UDim2.fromScale(0, 1)
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(34, 167, 237)
	fill.BackgroundTransparency = 1
	fill.BorderSizePixel = 0
	fill.ClipsDescendants = true
	fill.Parent = track
	rounded(fill, 1)
	local shine = Instance.new("UIGradient")
	shine.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(195, 234, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(64, 125, 166)),
	})
	shine.Rotation = 90
	shine.Parent = fill

	local remaining = Instance.new("TextLabel")
	remaining.Name = "Remaining"
	remaining.BackgroundTransparency = 1
	remaining.AnchorPoint = Vector2.new(0.5, 1)
	remaining.Position = UDim2.new(0.5, 0, 0, -5)
	remaining.Size = UDim2.fromOffset(48, 18)
	remaining.Font = Enum.Font.GothamBold
	remaining.Text = "100%"
	remaining.TextSize = 11
	remaining.TextColor3 = Color3.fromRGB(197, 242, 255)
	remaining.TextTransparency = 1
	remaining.TextStrokeTransparency = 0.4
	remaining.ZIndex = 2
	remaining.Parent = meter

	-- Lightweight circular highlights create visible, gently rising bubbles in
	-- the blue fill without depending on an uploaded image asset.
	local bubbles = {}
	for index = 1, BUBBLE_COUNT do
		local bubble = Instance.new("Frame")
		local size = 3 + (index % 4) * 1.5
		bubble.Name = "Bubble"
		bubble.AnchorPoint = Vector2.new(0.5, 0.5)
		bubble.Size = UDim2.fromOffset(size, size)
		bubble.BackgroundColor3 = Color3.fromRGB(220, 249, 255)
		bubble.BackgroundTransparency = 0.34
		bubble.BorderSizePixel = 0
		bubble.ZIndex = 2
		bubble.Parent = fill
		rounded(bubble, 20)
		table.insert(bubbles, {
			item = bubble,
			x = ((index * 37) % 97 + 2) / 100,
			phase = index / BUBBLE_COUNT,
			speed = 0.16 + (index % 3) * 0.035,
		})
	end

	local blackout = Instance.new("Frame")
	blackout.Name = "OxygenBlackout"
	blackout.Size = UDim2.fromScale(1, 1)
	blackout.BackgroundColor3 = Color3.new(0, 0, 0)
	blackout.BackgroundTransparency = 1
	blackout.BorderSizePixel = 0
	blackout.ZIndex = 100
	blackout.Parent = gui

	local barTween: Tween? = nil
	local blackoutTween: Tween? = nil
	local shown = false
	local function setMeterVisible(visible: boolean)
		if visible == shown then
			return
		end
		shown = visible
		if barTween then
			barTween:Cancel()
		end
		if visible then
			meter.Visible = true
			barTween = TweenService:Create(meter, BAR_FADE, { BackgroundTransparency = 0.08 })
			barTween:Play()
			TweenService:Create(meterStroke, BAR_FADE, { Transparency = 0.15 }):Play()
			TweenService:Create(track, BAR_FADE, { BackgroundTransparency = 0.18 }):Play()
			TweenService:Create(fill, BAR_FADE, { BackgroundTransparency = 0 }):Play()
			TweenService:Create(caption, BAR_FADE, { GroupTransparency = 0 }):Play()
			TweenService:Create(remaining, BAR_FADE, { TextTransparency = 0 }):Play()
		else
			barTween = TweenService:Create(meter, BAR_FADE, { BackgroundTransparency = 1 })
			barTween:Play()
			TweenService:Create(meterStroke, BAR_FADE, { Transparency = 1 }):Play()
			TweenService:Create(track, BAR_FADE, { BackgroundTransparency = 1 }):Play()
			TweenService:Create(fill, BAR_FADE, { BackgroundTransparency = 1 }):Play()
			TweenService:Create(caption, BAR_FADE, { GroupTransparency = 1 }):Play()
			TweenService:Create(remaining, BAR_FADE, { TextTransparency = 1 }):Play()
			task.delay(BAR_FADE.Time, function()
				if not shown then
					meter.Visible = false
				end
			end)
		end
	end

	local function refresh()
		local oxygen = math.clamp(player:GetAttribute("Oxygen") or 1, 0, 1)
		fill.Size = UDim2.fromScale(1, oxygen)
		remaining.Text = string.format("%d%%", math.ceil(oxygen * 100))
		local low = oxygen <= 0.2
		fill.BackgroundColor3 = if low then Color3.fromRGB(255, 117, 91) else Color3.fromRGB(255, 255, 255)
		remaining.TextColor3 = if low then Color3.fromRGB(255, 151, 126) else Color3.fromRGB(197, 242, 255)
		meterStroke.Color = if low then Color3.fromRGB(255, 117, 91) else Color3.fromRGB(55, 133, 174)
		setMeterVisible(player:GetAttribute("Underwater") == true and player:GetAttribute("OxygenBlackout") ~= true)
	end

	local function setBlackout(active: boolean)
		if blackoutTween then
			blackoutTween:Cancel()
		end
		blackoutTween = TweenService:Create(blackout, if active then BLACKOUT_FADE else RETURN_FADE, {
			BackgroundTransparency = if active then 0 else 1,
		})
		blackoutTween:Play()
	end

	player:GetAttributeChangedSignal("Oxygen"):Connect(refresh)
	player:GetAttributeChangedSignal("Underwater"):Connect(refresh)
	player:GetAttributeChangedSignal("OxygenBlackout"):Connect(function()
		local blackingOut = player:GetAttribute("OxygenBlackout") == true
		setBlackout(blackingOut)
		refresh()
	end)
	refresh()
	setBlackout(player:GetAttribute("OxygenBlackout") == true)

	local bubbleTime = 0
	RunService.RenderStepped:Connect(profiled("Oxygen", function(dt)
		local onScreen = CharacterMeter.position(meter, player, -1)
		if shown then
			meter.Visible = onScreen
		end
		if not shown then
			return
		end
		bubbleTime += dt
		for _, bubble in bubbles do
			local rise = (bubble.phase + bubbleTime * bubble.speed) % 1
			bubble.item.Position = UDim2.fromScale(bubble.x + math.sin(bubbleTime + bubble.phase * 8) * 0.025, 1.08 - rise * 1.16)
		end
	end))
end

return Oxygen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="339">
          <Properties>
            <string name="Name">ParkedBoats</string>
            <string name="Source"><![CDATA[-- Parked hulls are anchored on the server so movers never fight people on deck.
-- Each client rolls them on the shared swell clock instead; the server releases
-- a hull at that same pose (Weather.parkedOffset), so driving off never snaps.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Weather = require(ReplicatedStorage.Shared.Weather)

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end

local ParkedBoats = {}
local started = false
-- Rolling a hull rewrites every part in it, and the renderer pays per moved part
-- (instanced clusters, shadow maps). A full harbour re-pivoted every hull every
-- frame. Hulls close to the camera still roll every frame; farther ones step on a
-- stride, distant ones hold their last pose, and the deck you stand on always moves.
-- A village berth row is several hulls of a few hundred parts each, all inside the old
-- 160-stud every-frame ring from anywhere on the waterfront; the slow swell reads the
-- same at a third or a sixth of the frame rate once the hull isn't right beside you.
local NEAR_DISTANCE = 90
local MID_DISTANCE = 220
local FAR_DISTANCE = 450
local MID_STRIDE = 3
local FAR_STRIDE = 6
-- Skip a move this small (studs at the root, or at 20 studs out for tilt): calm
-- water or a sheltered berth would otherwise rewrite the hull for nothing.
local MIN_MOVE = 0.005
local TILT_ARM = 20
local HULL_REFRESH = 1

function ParkedBoats.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local heldRoot, heldBoat, heldAt, heldPosition
	local frame = 0
	local slots: { [Instance]: number } = setmetatable({}, { __mode = "k" }) :: any
	local nextSlot = 0
	-- Each parked hull's parts and their offsets from the root. Rebuilt when the hull parks
	-- again, its root changes, or every HULL_REFRESH seconds (planks and fittings can be
	-- added or removed while it sits at the berth).
	type Hull = { root: BasePart, parkedAt: number, at: number, parts: { BasePart }, offsets: { CFrame }, frames: { CFrame } }
	local hulls: { [Model]: Hull } = setmetatable({}, { __mode = "k" }) :: any
	local function hullOf(model: Model, root: BasePart, parkedAt: number): Hull
		local clock = os.clock()
		local hull = hulls[model]
		if not hull or hull.root ~= root or hull.parkedAt ~= parkedAt or clock - hull.at > HULL_REFRESH then
			local parts, offsets = {}, {}
			local frame = root.CFrame
			for _, piece in model:GetDescendants() do
				if piece:IsA("BasePart") then
					table.insert(parts, piece)
					table.insert(offsets, frame:ToObjectSpace(piece.CFrame))
				end
			end
			hull = { root = root, parkedAt = parkedAt, at = clock, parts = parts, offsets = offsets, frames = table.create(#parts) }
			hulls[model] = hull
		end
		return hull
	end
	-- Before physics, so a local character standing on deck collides with this pose.
	RunService.PreSimulation:Connect(profiled("ParkedBoats", function()
		frame += 1
		local camera = workspace.CurrentCamera
		local eye = camera and camera.CFrame.Position
		local folder = workspace:FindFirstChild("PlayerBoats")
		if not folder then
			heldRoot, heldBoat, heldAt, heldPosition = nil, nil, nil, nil
			return
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local avatarRoot = character and character:FindFirstChild("HumanoidRootPart")
		local ground
		if
			humanoid
			and avatarRoot
			and avatarRoot:IsA("BasePart")
			and humanoid.Health > 0
			and not avatarRoot.Anchored
			and not humanoid.SeatPart
			and not humanoid.Sit
			and not humanoid.Jump
			and humanoid.FloorMaterial ~= Enum.Material.Air
		then
			local state = humanoid:GetState()
			if
				state == Enum.HumanoidStateType.Running
				or state == Enum.HumanoidStateType.RunningNoPhysics
				or state == Enum.HumanoidStateType.Landed
			then
				local parameters = RaycastParams.new()
				parameters.FilterType = Enum.RaycastFilterType.Exclude
				parameters.FilterDescendantsInstances = { character }
				parameters.IgnoreWater = true
				parameters.RespectCanCollide = true
				parameters.CollisionGroup = avatarRoot.CollisionGroup
				-- R6 has zero HipHeight, but its legs still put the root above deck.
				local reach = math.max(3, humanoid.HipHeight + avatarRoot.Size.Y / 2) + 0.75
				ground = workspace:Raycast(avatarRoot.Position, Vector3.new(0, -reach, 0), parameters)
			end
		end
		local now = workspace:GetServerTimeNow()
		local holding = false
		for _, model in folder:GetChildren() do
			local root = model:IsA("Model") and model.PrimaryPart
			local rest, parkedAt = model:GetAttribute("ParkedFrame"), model:GetAttribute("ParkedAt")
			if
				root
				and root.Anchored
				and model:GetAttribute("Parked")
				-- A hull up on the drydock lift is out of the water.
				and not model:GetAttribute("Hoisted")
				and typeof(rest) == "CFrame"
				and type(parkedAt) == "number"
			then
				local before = root.CFrame
				local riding = ground ~= nil and ground.Instance:IsDescendantOf(model)
				local due = true
				if not riding and eye then
					local distance = (before.Position - eye).Magnitude
					if distance > FAR_DISTANCE then
						due = false
					elseif distance > NEAR_DISTANCE then
						local slot = slots[model]
						if not slot then
							nextSlot += 1
							slot = nextSlot
							slots[model] = slot
						end
						due = (frame + slot) % (if distance > MID_DISTANCE then FAR_STRIDE else MID_STRIDE) == 0
					end
				end
				if not due then
					continue
				end
				local offset = Weather.parkedOffset(
					rest,
					parkedAt,
					now,
					model:GetAttribute("DryFloorHeight"),
					model:GetAttribute("DryFloorHalfBeam"),
					model:GetAttribute("DryFloorHalfLength"),
					model:GetAttribute("WaterlineRootOffset")
				)
				local goal = offset * rest
				local change = (goal.Position - before.Position).Magnitude
					+ ((goal.LookVector - before.LookVector).Magnitude + (goal.UpVector - before.UpVector).Magnitude)
						* TILT_ARM
				if change >= MIN_MOVE then
					-- The hull is rigid: every part keeps one offset from the root, and the root
					-- goes to offset * rest (what PivotTo(offset * pivot) produced). One engine
					-- call for the whole hull instead of PivotTo setting each part in turn.
					local hull = hullOf(model, root, parkedAt)
					local frames = hull.frames
					for index, relative in hull.offsets do
						frames[index] = goal * relative
					end
					workspace:BulkMoveTo(hull.parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
				end
				if riding then
					local position = before:PointToObjectSpace(avatarRoot.Position)
					if humanoid.MoveDirection.Magnitude < 0.01 then
						-- CFrame animation supplies no platform velocity. Keep an idle
						-- rider at their deck position instead of accumulating slope slip.
						if
							heldRoot ~= avatarRoot
							or heldBoat ~= model
							or heldAt ~= parkedAt
							or not heldPosition
							or (position - heldPosition).Magnitude > 3
						then
							heldPosition = position
						end
						heldRoot, heldBoat, heldAt = avatarRoot, model, parkedAt
						position = Vector3.new(heldPosition.X, position.Y, heldPosition.Z)
						local velocity = avatarRoot.AssemblyLinearVelocity
						avatarRoot.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
						holding = true
					end
					-- Carry translation and tilt around the hull pivot while keeping
					-- the humanoid upright. Walking remains relative to the deck.
					local target = root.CFrame:PointToWorldSpace(position)
					avatarRoot.CFrame += target - avatarRoot.Position
				end
			end
		end
		if not holding then
			heldRoot, heldBoat, heldAt, heldPosition = nil, nil, nil, nil
		end
	end))
end

return ParkedBoats
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="340">
          <Properties>
            <string name="Name">Pedestrians</string>
            <string name="Source"><![CDATA[-- Draws the townsfolk the server plans (Shared.Pedestrians, PedestrianService).
--
-- Every pedestrian wears a real Roblox avatar: the server publishes a handful of
-- HumanoidDescriptions from real players (ReplicatedStorage.PedestrianAvatars),
-- this client builds one template rig per description and clones it per person.
-- Rigs are local, anchored at the root and non-colliding, moved from the trip and
-- the server clock, so the server replicates nothing per frame. Motion updates
-- drop with distance from the camera:
--   Near  (< 70 studs): stock Roblox walk and idle animations, every frame.
--   Mid   (< 150):      animations stopped (standing pose), 8 updates a second.
--   Far   (< 280):      same, 3 updates a second.
--   Past that, or out of sight in a shop: not drawn and not updated at all.
-- If no avatar could be loaded at all, a two-block stand-in is drawn instead.
-- All moves of a frame go out in one workspace:BulkMoveTo call.
-- Only near avatars cast shadows (a moving caster redraws part of the sun's shadow map),
-- avatars come without layered clothing (Shared.AvatarLite), and a rig hidden for a few
-- seconds goes back to a small per-avatar pool, so memory follows how many are on screen
-- rather than how many people walk the island.
-- A rig's look is batched by the renderer per Humanoid model (FastCluster in the
-- MicroProfiler). Re-parenting one, or changing a part's transparency or shadow, rebuilds
-- that batch, so a briefly hidden rig is parked out of sight instead of unparented and
-- fades step coarsely. Lower graphics presets (PlayerSettings) animate fewer avatars.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Pedestrians = require(ReplicatedStorage.Shared.Pedestrians)
local AvatarLite = require(ReplicatedStorage.Shared.AvatarLite)

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end

local PedestriansClient = {}

local TIERS = Pedestrians.TIERS
local HIDDEN = Pedestrians.HIDDEN
local HIDDEN_CHECK = 0.5 -- how often an undrawn pedestrian is looked at again
local RELEASE_SECONDS = 6 -- an avatar hidden this long goes back to the pool
local POOL_PER_SLOT = 3 -- spare rigs kept per avatar; more are destroyed
-- Hidden rigs wait here, high above the map and far outside any camera's draw range.
local PARKED = CFrame.new(0, 25000, 0)
-- Smallest transparency step written during a fade (each step rebuilds the rig's batch)
local FADE_STEP = 0.12
-- Animated (near tier) avatars allowed per graphics tier (PlayerSettings GraphicsTier)
local NEAR_CAP_BY_TIER = { 6, 10, Pedestrians.NEAR_CAP }
local AREA_REACH = 165 * 1.5 + TIERS[#TIERS].exit
-- Roblox's stock R15 animations (the default Animate script's walk and idle)
local WALK_ANIMATION = "rbxassetid://913402848"
local IDLE_ANIMATION = "rbxassetid://507766388"
local WALK_ANIM_SPEED = 6.4 -- studs a second the stock walk is authored for at height scale 1

local SKINS = {
	Color3.fromRGB(255, 219, 172),
	Color3.fromRGB(241, 194, 125),
	Color3.fromRGB(224, 172, 105),
	Color3.fromRGB(198, 134, 66),
	Color3.fromRGB(141, 85, 36),
	Color3.fromRGB(92, 58, 36),
}
local SHIRTS = {
	Color3.fromRGB(236, 236, 228),
	Color3.fromRGB(40, 92, 160),
	Color3.fromRGB(180, 52, 44),
	Color3.fromRGB(56, 120, 70),
	Color3.fromRGB(230, 180, 60),
	Color3.fromRGB(110, 168, 196),
	Color3.fromRGB(60, 60, 66),
	Color3.fromRGB(150, 110, 170),
}
local BAGS = {
	Color3.fromRGB(176, 70, 52), -- Tide & Tackle
	Color3.fromRGB(60, 98, 130), -- Harbour Home
	Color3.fromRGB(222, 206, 170),
	Color3.fromRGB(70, 120, 66),
	Color3.fromRGB(214, 160, 50),
}

type Rig = {
	model: Model,
	root: BasePart, -- the one part BulkMoveTo moves; everything else hangs off it
	lift: number, -- root height above the feet
	fade: { BasePart | Decal },
	shown: boolean,
	alpha: number,
	-- Avatar rigs only
	walk: AnimationTrack?,
	idle: AnimationTrack?,
	mode: string, -- "still", "idle" or "walk"
	heightScale: number,
	bag: BasePart?,
	slot: number?, -- avatar template it was cloned from (pool key)
	shadows: boolean,
}

type Person = {
	config: Configuration,
	seed: number,
	trip: Pedestrians.Trip?,
	tier: number,
	avatar: Rig?,
	standIn: Rig?,
	nextUpdate: number,
	sample: Pedestrians.Sample,
	yaw: number,
	connection: RBXScriptConnection,
	shopConnection: RBXScriptConnection,
	center: Vector3?,
	away: boolean,
	hiddenAt: number?,
}

local started = false
local container: Folder
local people: { [Configuration]: Person } = {}
local nearCount = 0
local nearCap = Pedestrians.NEAR_CAP
local moveParts: { BasePart } = {}
local moveFrames: { CFrame } = {}

-- Avatar templates by slot: a Model once built, false if it failed to build.
local templates: { [number]: Model | false } = {}
-- Released avatar rigs by template slot, unparented and ready to reuse.
local pool: { [number]: { Rig } } = {}
local building: { [number]: boolean } = {}
local avatarFolder: Instance? = nil

local function prepareTemplate(model: Model): Model?
	local root = model:FindFirstChild("HumanoidRootPart")
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid then
		model:Destroy()
		return nil
	end
	AvatarLite.stripModel(model)
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") then
			-- Only the root is anchored, so Motor6Ds and accessory welds still pose the rest
			item.Anchored = item == root
			item.CanCollide, item.CanTouch, item.CanQuery = false, false, false
			item.Massless = true
			-- Off by default; near-tier rigs turn it back on (setShadows)
			item.CastShadow = false
		elseif item:IsA("Script") or item:IsA("LocalScript") or item:IsA("Sound") then
			item:Destroy()
		end
	end
	root.Transparency = 1
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	-- No physics states to run: the rig is placed, never simulated
	humanoid.EvaluateStateMachine = false
	if not humanoid:FindFirstChildOfClass("Animator") then
		Instance.new("Animator").Parent = humanoid
	end
	model.PrimaryPart = root
	return model
end

local function buildTemplate(slot: number)
	if templates[slot] ~= nil or building[slot] then
		return
	end
	local description = avatarFolder and avatarFolder:FindFirstChild(tostring(slot))
	if not description or not description:IsA("HumanoidDescription") then
		return -- not published yet; asked again on a later update
	end
	building[slot] = true
	task.spawn(function()
		-- A local copy without layered clothing, even if the server published one with it.
		local lite = AvatarLite.strip(description:Clone())
		local ok, model =
			pcall(Players.CreateHumanoidModelFromDescriptionAsync, Players, lite, Enum.HumanoidRigType.R15)
		lite:Destroy()
		local prepared = if ok and model then prepareTemplate(model) else nil
		templates[slot] = prepared or false
		building[slot] = nil
		if not ok then
			warn("[Pedestrians] Avatar " .. slot .. " failed: " .. tostring(model))
		end
	end)
end

-- The person's own avatar (and its slot), or any built one if theirs failed. Nil while still loading.
local function templateFor(seed: number): (Model?, number?)
	local slot = Pedestrians.avatarSlot(seed)
	local own = templates[slot]
	if own then
		return own, slot
	end
	if own == nil then
		buildTemplate(slot)
		-- A later description must not permanently give this person another
		-- avatar before their own loads: the physical visitor uses this exact slot.
		return nil
	end
	for offset = 1, Pedestrians.AVATAR_COUNT - 1 do
		local otherSlot = (slot + offset - 1) % Pedestrians.AVATAR_COUNT + 1
		local other = templates[otherSlot]
		if other then
			return other, otherSlot
		end
	end
	return nil, nil
end

local function anyTemplateCould(): boolean
	-- True while an avatar might still turn up, so the block stand-in isn't flashed during loading
	if not avatarFolder then
		return true
	end
	for slot = 1, Pedestrians.AVATAR_COUNT do
		if templates[slot] ~= false then
			return true
		end
	end
	return false
end

local function loadTrack(animator: Animator, id: string, priority: Enum.AnimationPriority): AnimationTrack
	local animation = Instance.new("Animation")
	animation.AnimationId = id
	local track = animator:LoadAnimation(animation)
	track.Priority = priority
	track.Looped = true
	return track
end

local function buildAvatar(template: Model, slot: number?): Rig
	local model = template:Clone()
	model.Name = "Townsperson"
	local root = model.PrimaryPart :: BasePart
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local fade: { BasePart | Decal } = {}
	for _, item in model:GetDescendants() do
		if (item:IsA("BasePart") and item ~= root) or item:IsA("Decal") then
			table.insert(fade, item)
		end
	end
	local rig: Rig = {
		model = model,
		root = root,
		lift = humanoid.HipHeight + root.Size.Y / 2,
		fade = fade,
		shown = false,
		alpha = 0,
		walk = nil,
		idle = nil,
		mode = "still",
		heightScale = math.max(humanoid.HipHeight / 2, 0.5),
		bag = nil,
		slot = slot,
		shadows = false,
	}
	-- A shopping bag held in the right hand, parented only while carrying one
	local hand = model:FindFirstChild("RightHand")
	if hand and hand:IsA("BasePart") then
		local bag = Instance.new("Part")
		bag.Name = "ShoppingBag"
		bag.Size = Vector3.new(0.95, 1.05, 0.45) * rig.heightScale
		bag.Material = Enum.Material.SmoothPlastic
		bag.Anchored, bag.CanCollide, bag.CanTouch, bag.CanQuery = false, false, false, false
		bag.Massless, bag.CastShadow = true, false
		local weld = Instance.new("Weld")
		weld.Part0, weld.Part1 = hand, bag
		weld.C0 = CFrame.new(0, -hand.Size.Y / 2 - bag.Size.Y / 2 - 0.05, 0)
		weld.Parent = bag
		rig.bag = bag
	end
	return rig
end

local function buildStandIn(seed: number): Rig
	local random = Random.new(seed)
	local scale = random:NextNumber(0.9, 1.08)
	local model = Instance.new("Model")
	model.Name = "Townsperson"
	local function block(size: Vector3, color: Color3, shape: Enum.PartType?): BasePart
		local part = Instance.new("Part")
		part.Size = size * scale
		part.Color = color
		part.Material = Enum.Material.SmoothPlastic
		part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch = false, false, false, false
		part.Massless, part.CastShadow = true, false
		if shape then
			part.Shape = shape
		end
		part.Parent = model
		return part
	end
	local body = block(Vector3.new(2, 4.1, 1), SHIRTS[random:NextInteger(1, #SHIRTS)])
	body.Anchored = true
	local head = block(Vector3.one * 1.25, SKINS[random:NextInteger(1, #SKINS)], Enum.PartType.Ball)
	head.CFrame = body.CFrame * CFrame.new(0, 2.73 * scale, 0)
	local weld = Instance.new("WeldConstraint")
	weld.Part0, weld.Part1, weld.Parent = body, head, head
	return {
		model = model,
		root = body,
		lift = 2.05 * scale,
		fade = { body, head },
		shown = false,
		alpha = 0,
		mode = "still",
		heightScale = scale,
		shadows = false,
	}
end

local function show(rig: Rig?, visible: boolean)
	if rig and rig.shown ~= visible then
		rig.shown = visible
		if visible then
			-- Pooled rigs come back unparented; parked ones are already in place and are
			-- moved into view by this frame's BulkMoveTo.
			if rig.model.Parent ~= container then
				rig.model.Parent = container
			end
		else
			rig.root.CFrame = PARKED
		end
	end
end

local function setShadows(rig: Rig, on: boolean)
	if rig.shadows == on then
		return
	end
	rig.shadows = on
	for _, item in rig.fade do
		if item:IsA("BasePart") then
			item.CastShadow = on
		end
	end
end

local function setAlpha(rig: Rig, alpha: number)
	if alpha == rig.alpha or (math.abs(rig.alpha - alpha) < FADE_STEP and alpha > 0 and alpha < 1) then
		return
	end
	rig.alpha = alpha
	for _, item in rig.fade do
		item.Transparency = alpha
	end
	if rig.bag then
		rig.bag.Transparency = alpha
	end
end

-- "walk", "idle" or "still" (no animation: the default standing pose).
local function setMode(rig: Rig, mode: string)
	if rig.mode == mode then
		return
	end
	rig.mode = mode
	if mode ~= "still" and not rig.walk then
		local humanoid = rig.model:FindFirstChildOfClass("Humanoid")
		local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
		if not animator then
			return
		end
		rig.walk = loadTrack(animator, WALK_ANIMATION, Enum.AnimationPriority.Movement)
		rig.idle = loadTrack(animator, IDLE_ANIMATION, Enum.AnimationPriority.Idle)
	end
	local walk, idle = rig.walk, rig.idle
	if not walk or not idle then
		return
	end
	if mode == "walk" then
		if not walk.IsPlaying then
			walk:Play(0.2)
		end
		if idle.IsPlaying then
			idle:Stop(0.2)
		end
	elseif mode == "idle" then
		if not idle.IsPlaying then
			idle:Play(0.25)
		end
		if walk.IsPlaying then
			walk:Stop(0.25)
		end
	else
		walk:Stop(0)
		idle:Stop(0)
	end
end

local function queue(part: BasePart, frame: CFrame)
	table.insert(moveParts, part)
	table.insert(moveFrames, frame)
end

local function hideAll(person: Person)
	show(person.avatar, false)
	show(person.standIn, false)
	if person.avatar then
		setMode(person.avatar, "still")
	end
	if person.tier == 1 then
		nearCount -= 1
	end
	person.tier = HIDDEN
end

local function shortestAngle(from: number, to: number): number
	return (to - from + math.pi) % (math.pi * 2) - math.pi
end

-- The rig to draw: the avatar once one exists, the block stand-in only if none ever will.
local function rigFor(person: Person): Rig?
	if person.avatar then
		return person.avatar
	end
	local template, slot = templateFor(person.seed)
	if template then
		local spare = slot and pool[slot]
		person.avatar = if spare and #spare > 0 then table.remove(spare) else buildAvatar(template, slot)
		if person.standIn then
			person.standIn.model:Destroy()
			person.standIn = nil
		end
		return person.avatar
	end
	if anyTemplateCould() then
		return nil
	end
	if not person.standIn then
		person.standIn = buildStandIn(person.seed)
	end
	return person.standIn
end

local function update(person: Person, now: number, dt: number, camera: Vector3)
	local trip = person.trip
	if not trip or person.config:GetAttribute("InShop") then
		hideAll(person)
		person.nextUpdate = now + HIDDEN_CHECK
		return
	end
	local sample = Pedestrians.sample(trip, now, person.sample)
	local position = Vector3.new(sample.x, sample.y, sample.z)
	local tier = Pedestrians.tierFor((position - camera).Magnitude, person.tier)
	if sample.alpha >= 0.999 then
		tier = HIDDEN
	end
	-- Only so many animated avatars at once: later arrivals stand still like the mid tier
	if tier == 1 and person.tier ~= 1 and nearCount >= nearCap then
		tier = 2
	end
	local rig = if tier == HIDDEN then nil else rigFor(person)
	if not rig then
		tier = HIDDEN
	end
	if tier ~= person.tier then
		if person.tier == 1 then
			nearCount -= 1
		end
		if tier == 1 then
			nearCount += 1
			-- Arrive facing the right way instead of spinning round
			person.yaw = sample.yaw
		end
		person.tier = tier
	end
	if tier == HIDDEN or not rig then
		show(person.avatar, false)
		show(person.standIn, false)
		if person.avatar then
			setMode(person.avatar, "still")
		end
		-- Still waiting on an avatar to load: look again sooner
		person.nextUpdate = now + (if rig then HIDDEN_CHECK else HIDDEN_CHECK / 2)
		return
	end
	-- Coarse tiers don't fade: they just appear and vanish halfway through
	local visible = tier == 1 or sample.alpha <= 0.5
	show(rig, visible)
	if not visible then
		person.nextUpdate = now + TIERS[tier].interval
		return
	end
	local yaw = sample.yaw
	setShadows(rig, tier == 1)
	if tier == 1 then
		person.yaw += shortestAngle(person.yaw, sample.yaw) * math.min(dt * 9, 1)
		yaw = person.yaw
		setAlpha(rig, sample.alpha)
	else
		person.yaw = sample.yaw
		setAlpha(rig, 0)
	end
	if rig == person.avatar then
		if tier == 1 then
			setMode(rig, if sample.moving then "walk" else "idle")
			if rig.mode == "walk" and rig.walk then
				local speed = trip.speed / (WALK_ANIM_SPEED * rig.heightScale)
				if math.abs(rig.walk.Speed - speed) > 0.02 then
					rig.walk:AdjustSpeed(speed)
				end
			end
		else
			setMode(rig, "still")
		end
		local bag = rig.bag
		if bag then
			local carrying = trip.bag > 0 and tier == 1
			if carrying then
				local color = BAGS[math.clamp(trip.bag, 1, #BAGS)]
				if bag.Color ~= color then
					bag.Color = color
				end
				if bag.Parent ~= rig.model then
					bag.Parent = rig.model
				end
			elseif bag.Parent then
				bag.Parent = nil
			end
		end
	end
	queue(rig.root, CFrame.new(position + Vector3.new(0, rig.lift, 0)) * CFrame.Angles(0, yaw, 0))
	person.nextUpdate = now + TIERS[tier].interval
end

local function destroy(person: Person)
	person.connection:Disconnect()
	person.shopConnection:Disconnect()
	if person.tier == 1 then
		nearCount -= 1
	end
	if person.avatar then
		if person.avatar.bag then
			person.avatar.bag:Destroy()
		end
		person.avatar.model:Destroy()
	end
	if person.standIn then
		person.standIn.model:Destroy()
	end
end

local function track(config: Instance)
	if not config:IsA("Configuration") or people[config] then
		return
	end
	local seed = config:GetAttribute("Look")
	local person: Person = {
		config = config,
		seed = if type(seed) == "number" then seed else 1,
		trip = nil,
		tier = HIDDEN,
		avatar = nil,
		standIn = nil,
		nextUpdate = 0,
		sample = { x = 0, y = 0, z = 0, yaw = 0, moving = false, stride = 0, alpha = 0 },
		yaw = 0,
		connection = nil :: any,
		shopConnection = nil :: any,
		center = config:GetAttribute("AreaCenter") :: Vector3?,
		away = false,
		hiddenAt = nil,
	}
	local function refresh()
		person.trip = Pedestrians.decode(config:GetAttribute("Trip") :: string)
		if person.trip then
			local p = person.trip.points
			local n = #p
			-- The culling centre follows each leg of an island-wide journey.
			person.center = Vector3.new((p[1] + p[n - 2]) / 2, (p[2] + p[n - 1]) / 2, (p[3] + p[n]) / 2)
		end
		person.nextUpdate = 0
	end
	person.connection = config:GetAttributeChangedSignal("Trip"):Connect(refresh)
	person.shopConnection = config:GetAttributeChangedSignal("InShop"):Connect(function()
		person.nextUpdate = 0
		if config:GetAttribute("InShop") then hideAll(person) end
	end)
	refresh()
	people[config] = person
end

-- Hands a hidden person's avatar back to the pool (or destroys it if the pool is full).
local function release(person: Person)
	local rig = person.avatar
	if not rig or rig.shown then
		return
	end
	person.avatar = nil
	person.hiddenAt = nil
	setMode(rig, "still")
	setShadows(rig, false)
	if rig.bag then
		rig.bag.Parent = nil
	end
	-- Pooled rigs leave the world entirely; they may wait a long time for reuse.
	rig.model.Parent = nil
	local slot = rig.slot
	local spare = slot and (pool[slot] or {})
	if slot and spare and #spare < POOL_PER_SLOT then
		pool[slot] = spare
		table.insert(spare, rig)
	else
		if rig.bag then
			rig.bag:Destroy()
		end
		rig.model:Destroy()
	end
end

local function untrack(config: Instance)
	local person = people[config :: Configuration]
	if person then
		people[config :: Configuration] = nil
		destroy(person)
	end
end

function PedestriansClient.start()
	if started then
		return
	end
	started = true
	container = Instance.new("Folder")
	container.Name = "Townsfolk"
	container.Parent = workspace
	local folder = ReplicatedStorage:WaitForChild(Pedestrians.FOLDER)
	folder.ChildAdded:Connect(track)
	folder.ChildRemoved:Connect(untrack)
	for _, config in folder:GetChildren() do
		track(config)
	end

	-- Build the avatar templates as their descriptions arrive, before anyone walks close
	task.spawn(function()
		local avatars = ReplicatedStorage:WaitForChild(Pedestrians.AVATAR_FOLDER, 120)
		if not avatars then
			return
		end
		avatarFolder = avatars
		local function onAdded(child: Instance)
			local slot = tonumber(child.Name)
			if slot then
				buildTemplate(slot)
			end
		end
		avatars.ChildAdded:Connect(onAdded)
		for _, child in avatars:GetChildren() do
			onAdded(child)
		end
	end)

	local townCenter: Vector3? = nil
	local awayUntil = 0
	RunService.Heartbeat:Connect(profiled("Pedestrians", function(dt)
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local now = workspace:GetServerTimeNow()
		local eye = camera.CFrame.Position
		-- Cull whole neighbourhoods twice a second, including shops outside the plaza.
		if now >= awayUntil then
			awayUntil = now + 0.5
			local graphics = Players.LocalPlayer:GetAttribute("GraphicsTier")
			nearCap = if type(graphics) == "number"
				then NEAR_CAP_BY_TIER[math.clamp(graphics, 1, #NEAR_CAP_BY_TIER)]
				else Pedestrians.NEAR_CAP
			local saved = folder:GetAttribute("Center")
			townCenter = if typeof(saved) == "Vector3" then saved else townCenter
			for _, person in people do
				local middle = person.center or townCenter
				person.away = middle == nil or (eye - (middle :: Vector3)).Magnitude > AREA_REACH
				if person.away then
					hideAll(person)
				end
				local avatar = person.avatar
				if avatar and not avatar.shown then
					if not person.hiddenAt then
						person.hiddenAt = now
					elseif now - (person.hiddenAt :: number) >= RELEASE_SECONDS then
						release(person)
					end
				else
					person.hiddenAt = nil
				end
			end
		end
		for _, person in people do
			if not person.away and now >= person.nextUpdate then
				update(person, now, dt, eye)
			end
		end
		if #moveParts > 0 then
			workspace:BulkMoveTo(moveParts, moveFrames, Enum.BulkMoveMode.FireCFrameChanged)
			table.clear(moveParts)
			table.clear(moveFrames)
		end
	end))
end

return PedestriansClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="341">
          <Properties>
            <string name="Name">PirateCove</string>
            <string name="Source"><![CDATA[-- Talking to Pirate Cove's crew (Shared.PirateCove): quest givers offer and take in their quests,
-- Gunner Flint sells rods and Quartermaster Bess buys fish. The panel asks the server for what to
-- show and sends every choice back to it; the server decides and saves.
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Cove = require(Shared:WaitForChild("PirateCove"))
local RodSkins = require(Shared:WaitForChild("RodSkins"))

local Client = {}
local started = false

local GOLD = Color3.fromRGB(255, 205, 64)
local PROMPT = "PirateCoveNpcPrompt"
local WALK_AWAY = 18
local MAX_BUTTONS = 6

local function label(parent: Instance, props): TextLabel
	local item = Instance.new("TextLabel")
	item.BackgroundTransparency = 1
	item.TextWrapped = true
	for key, value in props do
		item[key] = value
	end
	Theme.text(item, props.TextColor3)
	item.Font = props.Font or Enum.Font.GothamBold
	item.Parent = parent
	return item
end

local function perks(skinId: string): string
	local skin = RodSkins.Skins[skinId]
	local parts = {}
	if (skin.Reel or 0) > 0 then
		table.insert(parts, string.format("+%g%% reel", skin.Reel * 100))
	end
	if (skin.Size or 0) > 0 then
		table.insert(parts, string.format("+%g%% size", skin.Size * 100))
	end
	return table.concat(parts, " · ")
end

function Client.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local folder = ReplicatedStorage:WaitForChild("PirateCove")
	local remote = folder:WaitForChild("Request") :: RemoteFunction

	local gui = Instance.new("ScreenGui")
	gui.Name = "PirateCove"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 25
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	local panel = Instance.new("Frame")
	panel.Name = "Dialogue"
	panel.AnchorPoint = Vector2.new(0.5, 1)
	panel.Position = UDim2.new(0.5, 0, 1, -24)
	panel.Size = UDim2.new(0.92, 0, 0, 236)
	panel.Visible = false
	panel.Active = true
	panel.ZIndex = 10
	panel.Parent = gui
	Theme.window(panel)
	local bounds = Instance.new("UISizeConstraint")
	bounds.MaxSize = Vector2.new(660, 236)
	bounds.Parent = panel
	local speaker = label(panel, {
		Name = "Speaker",
		Position = UDim2.fromOffset(20, 14),
		Size = UDim2.new(1, -40, 0, 22),
		TextSize = 19,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = GOLD,
		RichText = true,
		ZIndex = 11,
	})
	local line = label(panel, {
		Name = "Line",
		Position = UDim2.fromOffset(20, 42),
		Size = UDim2.new(1, -40, 0, 62),
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Font = Enum.Font.GothamMedium,
		ZIndex = 11,
	})
	local status = label(panel, {
		Name = "Status",
		Position = UDim2.fromOffset(20, 106),
		Size = UDim2.new(1, -40, 0, 20),
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Colors.Muted,
		Font = Enum.Font.GothamMedium,
		RichText = true,
		ZIndex = 11,
	})
	local options = Instance.new("Frame")
	options.Name = "Options"
	options.BackgroundTransparency = 1
	options.Position = UDim2.new(0, 16, 1, -100)
	options.Size = UDim2.new(1, -32, 0, 86)
	options.ZIndex = 11
	options.Parent = panel
	local grid = Instance.new("UIGridLayout")
	grid.CellPadding = UDim2.fromOffset(8, 8)
	grid.CellSize = UDim2.new(1 / 3, -6, 0, 39)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = options

	local buttons: { TextButton } = {}
	local handlers: { [TextButton]: () -> () } = {}
	for i = 1, MAX_BUTTONS do
		local button = Instance.new("TextButton")
		button.Name = "Option" .. i
		button.LayoutOrder = i
		button.TextSize = 13
		button.TextWrapped = true
		button.RichText = true
		button.Visible = false
		button.ZIndex = 12
		button.Parent = options
		Theme.button(button)
		buttons[i] = button
		button.Activated:Connect(function()
			local run = handlers[button]
			if run then
				run()
			end
		end)
	end

	local talking: string? = nil
	local pending = false
	local lorePage = 1

	local function close()
		talking = nil
		panel.Visible = false
	end

	type Option = { text: string, style: string?, run: () -> () }
	local function setOptions(list: { Option })
		for i, button in buttons do
			local option = list[i]
			button.Visible = option ~= nil
			handlers[button] = option and option.run
			if option then
				button.Text = option.text
				Theme.button(button, option.style)
			end
		end
	end

	local render: (string, any, string?) -> ()

	local function send(id: string, action: string, value: any?)
		if pending then
			return
		end
		pending = true
		local ok, result = pcall(remote.InvokeServer, remote, action, id, value)
		pending = false
		if talking ~= id then
			return
		end
		if not ok or type(result) ~= "table" then
			status.Text = "The cove didn't answer. Try again."
			return
		end
		render(id, result.State, result.Message)
	end

	render = function(id: string, view, message: string?)
		local npc = Cove.Npcs[id]
		if not npc or type(view) ~= "table" then
			return
		end
		local bye = { text = "Bye", run = close }
		status.Text = ""
		if npc.Kind == "Lore" then
			local pages = npc.Lore or { npc.Greeting }
			lorePage = math.clamp(lorePage, 1, #pages)
			line.Text = message or pages[lorePage]
			if view.Unlocked then
				status.Text = "His treasure is spent: every gamepass is yours for good."
			elseif view.Found then
				status.Text = "You carry his lost compass rose. Use it from your cargo hold to unlock every gamepass."
			else
				status.Text = "The Ultimate treasure waits in the deep: one cast in a million."
			end
			local list = {}
			if lorePage < #pages then
				table.insert(list, {
					text = "Tell me more",
					style = "Selected",
					run = function()
						lorePage += 1
						render(id, view, nil)
					end,
				})
			end
			table.insert(list, bye)
			setOptions(list)
		elseif npc.Kind == "Buyer" then
			local left = view.SalesLeft or 0
			line.Text = message
				or (
					if left > 0
						then npc.Greeting .. string.format(" I'll take %d more fish today.", left)
						else "We've got enough fish to feed the whole cove today. Come back tomorrow, love!"
				)
			status.Text = string.format(
				"Holding: %s · Backpack: %d fish · Galley needs %d / %d more today",
				if view.Holding then "a fish" else "nothing",
				view.Backpack or 0,
				left,
				Cove.DAILY_SALES
			)
			if left > 0 then
				setOptions({
					{
						text = "Sell held fish",
						style = "Selected",
						run = function()
							send(id, "SellHand")
						end,
					},
					{
						text = "Sell all",
						run = function()
							send(id, "SellAll")
						end,
					},
					bye,
				})
			else
				setOptions({ bye })
			end
		elseif npc.Kind == "Shop" then
			line.Text = message or npc.Greeting
			status.Text = string.format(
				"Second-hand rods in %s wear. Each one is yours to keep.",
				RodSkins.wearState(Cove.ROD_WEAR)
			)
			local list = {}
			for _, rod in Cove.Rods do
				local skin = RodSkins.Skins[rod.SkinId]
				local owned = (view.Owned or {})[rod.SkinId] or 0
				table.insert(list, {
					text = string.format(
						'%s  <font color="#FFCD40">$%d</font>\n<font size="11">%s%s</font>',
						skin.Name,
						rod.Price,
						perks(rod.SkinId),
						if owned > 0 then string.format(" · own %d", owned) else ""
					),
					run = function()
						send(id, "BuyRod", rod.SkinId)
					end,
				})
			end
			table.insert(list, bye)
			setOptions(list)
		else
			local quest = Cove.quest(id, view.Step)
			if view.Finished or not quest then
				line.Text = message or (npc.Greeting .. " You've done everything I asked. Fair winds, friend.")
				setOptions({ bye })
			elseif not view.Accepted then
				line.Text = message or (npc.Greeting .. " " .. quest.Offer)
				status.Text = string.format(
					"<b>%s</b> · %s · Reward $%d, %d XP",
					quest.Title,
					view.Goal or "",
					quest.Cash,
					quest.XP
				)
				setOptions({
					{
						text = "Accept",
						style = "Selected",
						run = function()
							send(id, "Accept")
						end,
					},
					bye,
				})
			else
				local claimText = if quest.Kind == "Catch" then "Claim reward" else "Hand it over"
				line.Text = message or (if view.Ready then quest.Done else quest.Offer)
				status.Text = string.format("<b>%s</b> · %s", quest.Title, view.Goal or "")
				setOptions({
					{
						text = claimText,
						style = if view.Ready then "Selected" else nil,
						run = function()
							send(id, "Claim")
						end,
					},
					bye,
				})
			end
		end
		local title = npc.Name .. '  <font color="#D7D7D7" size="14">' .. npc.Title .. "</font>"
		speaker.Text = title
	end

	local function open(id: string)
		local npc = Cove.Npcs[id]
		if not npc then
			return
		end
		talking = id
		lorePage = 1
		speaker.Text = npc.Name .. '  <font color="#D7D7D7" size="14">' .. npc.Title .. "</font>"
		line.Text = npc.Greeting
		status.Text = ""
		setOptions({ { text = "Bye", run = close } })
		panel.Visible = true
		send(id, "Get")
	end

	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		if prompt.Name == PROMPT then
			local id = prompt:GetAttribute("NpcId")
			if type(id) == "string" then
				open(id)
			end
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if talking and not processed and input.KeyCode == Enum.KeyCode.Escape then
			close()
		end
	end)
	RunService.Heartbeat:Connect(function()
		local id = talking
		if not id then
			return
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local position = folder:GetAttribute("Npc_" .. id)
		if not root or (typeof(position) == "Vector3" and (root.Position - position).Magnitude > WALK_AWAY) then
			close()
		end
	end)
end

return Client
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="342">
          <Properties>
            <string name="Name">PlayerMenu</string>
            <string name="Source"><![CDATA[-- Left-side navigation and data-backed collection screens. Gameplay remains server-owned.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local MarketplaceService = game:GetService("MarketplaceService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Gamepasses = require(ReplicatedStorage.Shared.Gamepasses)
local Catalog = require(ReplicatedStorage.Shared.AnglerCatalog)
local StaffCatalog = require(ReplicatedStorage.Shared.StaffCatalog)
local ShopUpgrades = require(ReplicatedStorage.Shared.ShopUpgrades)
local BoatCatalog = require(ReplicatedStorage.Shared.BoatCatalog)
local Paths = require(ReplicatedStorage.Shared.Paths)
local Recipes = require(ReplicatedStorage.Shared.Recipes)
local FishCatch = require(ReplicatedStorage.Shared.FishCatch)
local FishMutations = require(ReplicatedStorage.Shared.FishMutations)
local FishModels = require(ReplicatedStorage.Shared.FishModels)
local BackpackModels = require(ReplicatedStorage.Shared.BackpackModels)
local Settings = require(script.Parent.PlayerSettings)
local Freecam = require(script.Parent.Freecam)
local StaffPreview = require(script.Parent.StaffPreview)
local EquipmentBag = require(script.Parent:WaitForChild("EquipmentBag"))
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))
local Menu = {}
local started = false
local ink = Theme.Colors.Text
local paper = Theme.Colors.Panel
local cream = Theme.Colors.Text
local navy = Theme.Colors.Window
local muted = Theme.Colors.Muted
local gold = Theme.Colors.Blue
local green = Theme.Colors.Green
local Book = {
	Paper = Color3.fromRGB(209, 196, 168),
	Page = Color3.fromRGB(230, 219, 194),
	Ink = Color3.fromRGB(51, 43, 32),
	Edge = Color3.fromRGB(133, 115, 80),
	Leather = Color3.fromRGB(102, 35, 36),
	Bestiary = Color3.fromRGB(43, 83, 68),
	Gold = Color3.fromRGB(225, 192, 119),
}

local function isGlass(item)
	while item do
		if item:GetAttribute("GlassSurface") then
			return true
		end
		item = item.Parent
	end
	return false
end

local function styleGlassItem(item, state)
	if not isGlass(item) then
		return
	end
	if item:IsA("TextButton") then
		Theme.glassButton(item, state)
	elseif item:IsA("TextLabel") or item:IsA("TextBox") then
		Theme.text(item, if item.TextColor3 == muted then Color3.fromRGB(178, 178, 178) else cream)
		if item:IsA("TextBox") then
			Theme.glassPanel(item, true)
		end
	elseif item:IsA("Frame") and item.BackgroundTransparency ~= 1 then
		Theme.glassPanel(item)
	elseif item:IsA("ScrollingFrame") then
		item.ScrollBarThickness = 6
		item.ScrollBarImageColor3 = Color3.fromRGB(156, 156, 156)
		item.ScrollBarImageTransparency = 0.25
	end
end

local function styleBookItem(item)
	local ancestor = item.Parent
	while ancestor and not ancestor:GetAttribute("BookSurface") do
		ancestor = ancestor.Parent
	end
	if not ancestor then
		return
	end
	if item:IsA("TextLabel") or item:IsA("TextBox") then
		item.Font = Enum.Font.Garamond
		item.TextColor3 = Book.Ink
		item.TextStrokeTransparency = 1
		if item:IsA("TextBox") then
			item.BackgroundColor3 = Book.Page
			item.PlaceholderColor3 = Book.Leather
		end
	elseif item:IsA("TextButton") and item:FindFirstChild("ThemeFace") then
		local selected = item.ThemeFace:GetAttribute("Finish") == "Selected"
		item.ThemeFace.ThemeFinish.Color =
			ColorSequence.new(if selected then Book.Gold else Book.Page, if selected then Book.Edge else Book.Paper)
		item.ThemeBorder.Color = Book.Edge
		item.ThemeCaption.Font = Enum.Font.Garamond
		item.ThemeCaption.TextColor3 = Book.Ink
		item.ThemeCaption.TextStrokeTransparency = 1
	elseif item:IsA("ScrollingFrame") then
		item.ScrollBarImageColor3 = Book.Edge
		item.ScrollBarThickness = 6
	elseif item:IsA("Frame") or item:IsA("ImageLabel") then
		if item.BackgroundTransparency ~= 1 then
			item.BackgroundColor3 = Book.Page
		end
	end
	local border = item:FindFirstChild("ThemeBorder")
	if border then
		border.Color = Book.Edge
		border.Transparency = 0.6
	end
end

local function make(class, parent, props)
	local instance = Instance.new(class)
	for key, value in props do
		instance[key] = value
	end
	if class == "TextLabel" or class == "TextBox" then
		Theme.text(instance, instance.TextColor3)
	elseif (class == "Frame" or class == "ImageLabel") and props.BackgroundTransparency ~= 1 then
		Theme.panel(instance, class == "ImageLabel")
	end
	if class == "ScrollingFrame" then
		Theme.scroll(instance)
	end
	instance.Parent = parent
	styleBookItem(instance)
	styleGlassItem(instance)
	return instance
end
local function decoration(parent, name, color, position, size)
	local item = make("Frame", parent, {
		Name = name,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = position,
		Size = size,
		Active = false,
	})
	item.BackgroundColor3, item.BackgroundTransparency = color, 0
	return item
end

-- Native GUI geometry keeps the book sharp at every resolution, without an
-- uploaded texture. Decorations deliberately bypass the shared metal UI theme.
local function bookPart(parent, name, color, position, size, radius)
	local part = decoration(parent, name, color, position, size)
	if radius then
		Theme.corner(part, radius)
	end
	return part
end

local function paperFinish(part, reverse)
	local gradient = Instance.new("UIGradient")
	gradient.Name = "PaperLight"
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(171, 153, 120)),
		ColorSequenceKeypoint.new(0.12, Color3.fromRGB(224, 212, 185)),
		ColorSequenceKeypoint.new(0.55, Color3.fromRGB(238, 228, 205)),
		ColorSequenceKeypoint.new(0.9, Color3.fromRGB(222, 209, 182)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(158, 137, 103)),
	})
	gradient.Rotation = if reverse then 180 else 0
	part.BackgroundColor3 = Color3.new(1, 1, 1)
	gradient.Parent = part
end

local function bookButton(item, selected)
	Theme.button(item, if selected then "Selected" else "Normal")
	local cover = if item.Name == "Bestiary" then Book.Bestiary else Book.Leather
	item.BackgroundColor3 = cover
	Theme.corner(item, 4)
	Theme.corner(item.ThemeFace, 4)
	item.ThemeFace.ThemeFinish.Rotation = 0
	item.ThemeFace.ThemeFinish.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, cover:Lerp(Book.Ink, 0.65)),
		ColorSequenceKeypoint.new(0.09, cover),
		ColorSequenceKeypoint.new(0.13, cover:Lerp(Book.Ink, 0.5)),
		ColorSequenceKeypoint.new(0.19, cover:Lerp(Book.Gold, if selected then 0.24 else 0.12)),
		ColorSequenceKeypoint.new(0.7, cover),
		ColorSequenceKeypoint.new(1, cover:Lerp(Book.Ink, 0.3)),
	})
	item.ThemeBorder.Color = Book.Gold
	item.ThemeBorder.Transparency = if selected then 0.2 else 0.55
	item.ThemeBorder.Thickness = 1
	item.ThemeCaption.Font = Enum.Font.Garamond
	item.ThemeCaption.TextColor3 = Book.Gold
	item.ThemeCaption.TextStrokeTransparency = 1
	item.ThemeCaption.Position = UDim2.fromOffset(28, -2)
	item.ThemeCaption.Size = UDim2.new(1, -44, 1, -4)
	local grain = item.ThemeFace:FindFirstChild("BookGrain")
	if not grain then
		grain = Instance.new("Frame")
		grain.Name = "BookGrain"
		grain.BackgroundTransparency = 1
		grain.BorderSizePixel = 0
		grain.Size = UDim2.fromScale(1, 1)
		grain.ClipsDescendants = true
		grain.Active = false
		grain.ZIndex = item.ThemeFace.ZIndex
		grain.Parent = item.ThemeFace

		-- A fixed seed keeps the leather grain stable when selection refreshes.
		local seed = if item.Name == "Bestiary" then 413 else 829
		local function nextUnit()
			seed = (seed * 48271) % 2147483647
			return seed / 2147483647
		end
		for index = 1, 64 do
			local fleck = Instance.new("Frame")
			fleck.Name = "GrainFleck" .. index
			fleck.BorderSizePixel = 0
			fleck.BackgroundColor3 = if index % 3 == 0 then Book.Gold else Book.Paper
			fleck.BackgroundTransparency = if index % 4 == 0 then 0.94 else 0.97
			fleck.Position = UDim2.fromScale(nextUnit(), nextUnit())
			fleck.Size = UDim2.fromScale(0.004 + nextUnit() * 0.009, 0.018 + nextUnit() * 0.04)
			fleck.Rotation = math.floor(nextUnit() * 70) - 35
			fleck.Active = false
			fleck.ZIndex = grain.ZIndex
			fleck.Parent = grain
		end
		for index = 1, 11 do
			local grainLine = Instance.new("Frame")
			grainLine.Name = "GrainLine" .. index
			grainLine.BorderSizePixel = 0
			grainLine.BackgroundColor3 = Book.Ink
			grainLine.BackgroundTransparency = 0.95
			grainLine.Position = UDim2.fromScale(0.08 + nextUnit() * 0.84, nextUnit())
			grainLine.Size = UDim2.fromScale(0.035 + nextUnit() * 0.09, 0.008)
			grainLine.Rotation = math.floor(nextUnit() * 24) - 12
			grainLine.Active = false
			grainLine.ZIndex = grain.ZIndex
			grainLine.Parent = grain
		end
	end
	if not item.ThemeFace:FindFirstChild("BookSpine") then
		local face = item.ThemeFace
		decoration(face, "BookSpine", cover:Lerp(Book.Ink, 0.7), UDim2.fromOffset(5, 1), UDim2.new(0, 9, 1, -6))
		decoration(face, "SpineHighlight", Book.Edge, UDim2.fromOffset(15, 2), UDim2.new(0, 1, 1, -8)).BackgroundTransparency =
			0.25
		local pages = decoration(face, "PageEdges", Book.Paper, UDim2.new(0, 19, 1, -6), UDim2.new(1, -23, 0, 4))
		for index = 1, 2 do
			decoration(
				pages,
				"PageLine" .. index,
				Book.Edge,
				UDim2.fromOffset(1, index * 2 - 1),
				UDim2.new(1, -1, 0, 1)
			).BackgroundTransparency =
				0.5
		end
		decoration(face, "PageForeEdge", Book.Page, UDim2.new(1, -4, 0, 6), UDim2.new(0, 2, 1, -12))
		for _, y in { 8, 15, 34, 41 } do
			decoration(face, "SpineBand" .. y, Book.Gold, UDim2.fromOffset(4, y), UDim2.fromOffset(11, 1)).BackgroundTransparency =
				0.22
		end
		local tooling = bookPart(face, "CoverTooling", cover, UDim2.fromOffset(22, 5), UDim2.new(1, -31, 1, -15), 2)
		tooling.BackgroundTransparency = 1
		local border = Instance.new("UIStroke")
		border.Name = "EmbossedBorder"
		border.Color, border.Thickness, border.Transparency = Book.Gold, 1, 0.65
		border.Parent = tooling
		for _, x in { 0, 1 } do
			for _, y in { 0, 1 } do
				local corner = bookPart(
					tooling,
					"GoldCorner" .. x .. y,
					Book.Gold,
					UDim2.new(x, if x == 0 then 3 else -3, y, if y == 0 then 3 else -3),
					UDim2.fromOffset(3, 3)
				)
				corner.AnchorPoint = Vector2.new(0.5, 0.5)
				corner.Rotation = 45
				corner.BackgroundTransparency = 0.25
			end
		end
		local ribbon = decoration(
			face,
			"Bookmark",
			if item.Name == "Bestiary" then Book.Gold else Book.Bestiary,
			UDim2.new(1, -22, 1, -13),
			UDim2.fromOffset(7, 11)
		)
		ribbon.BackgroundTransparency = 0.12
	end
end
-- Line icons drawn from native frames on a 22px grid, so they stay sharp at any
-- scale and need no uploaded images. `position` is the icon's centre.
local function glyph(parent, name, color, position, size)
	local icon = decoration(parent, "Icon", color, position, UDim2.fromOffset(22, 22))
	icon.BackgroundTransparency = 1
	icon.AnchorPoint = Vector2.new(0.5, 0.5)
	if size and size ~= 22 then
		local scale = Instance.new("UIScale")
		scale.Scale = size / 22
		scale.Parent = icon
	end
	local function line(label, x, y, width, rotation)
		local part = decoration(icon, label, color, UDim2.fromOffset(x, y), UDim2.fromOffset(width, 2))
		part.AnchorPoint = Vector2.new(0.5, 0.5)
		part.Rotation = rotation or 0
		Theme.corner(part, 1)
		return part
	end
	local function outline(label, x, y, width, height, radius)
		local part = decoration(icon, label, color, UDim2.fromOffset(x, y), UDim2.fromOffset(width, height))
		part.BackgroundTransparency = 1
		Theme.corner(part, radius or 2)
		local stroke = Instance.new("UIStroke")
		stroke.Color, stroke.Thickness, stroke.Transparency = color, 1.5, 0.08
		stroke.Parent = part
		return part
	end
	local function dot(label, x, y, width, height, radius)
		local part = decoration(icon, label, color, UDim2.fromOffset(x, y), UDim2.fromOffset(width, height or width))
		Theme.corner(part, radius or 1)
		return part
	end
	if name == "Home" then
		line("RoofLeft", 6, 6, 13, -42)
		line("RoofRight", 16, 6, 13, 42)
		line("WallLeft", 3, 14, 12, 90)
		line("WallRight", 19, 14, 12, 90)
		line("Floor", 11, 20, 16)
		outline("Door", 8, 12, 6, 8, 1)
	elseif name == "Equipmentbag" then
		outline("Bag", 3, 7, 16, 13, 3)
		outline("Handle", 7, 2, 8, 6, 2)
		line("Pocket", 11, 13, 8)
		line("Clasp", 11, 15, 3, 90)
	elseif name == "Settings" then
		for index, y in { 4, 11, 18 } do
			line("Track" .. index, 11, y, 20)
			local knob = decoration(
				icon,
				"Knob" .. index,
				color,
				UDim2.fromOffset(if index == 2 then 14 else 6, y),
				UDim2.fromOffset(4, 6)
			)
			knob.AnchorPoint = Vector2.new(0.5, 0.5)
			Theme.corner(knob, 2)
		end
	elseif name == "Shop" then
		outline("ShoppingBag", 3, 6, 16, 15, 2)
		outline("Handle", 7, 1, 8, 10, 4)
	elseif name == "Paths" then
		line("Pole", 5, 11, 18, 90)
		outline("Flag", 6, 3, 12, 8, 1)
		dot("Stone1", 12, 18, 3)
		dot("Stone2", 17, 18, 3)
	elseif name == "Staff" then
		outline("Head", 7, 2, 8, 8, 4)
		outline("Shoulders", 3, 13, 16, 8, 6)
	elseif name == "Filter" then
		line("Top", 11, 3, 18)
		line("Left", 6, 8, 14, 48)
		line("Right", 16, 8, 14, -48)
		line("Stem", 11, 17, 8, 90)
	elseif name == "Upgrades" then
		line("Shaft", 11, 12, 14, 90)
		line("TipLeft", 8, 6, 8.5, -45)
		line("TipRight", 14, 6, 8.5, 45)
		line("Base", 11, 20, 16)
	elseif name == "Overview" then
		outline("Board", 4, 3, 14, 17, 2)
		dot("Clip", 8, 1, 6, 3)
		line("Row1", 11, 9, 8)
		line("Row2", 11, 13, 8)
		line("Row3", 11, 17, 5)
	elseif name == "Achievements" then
		outline("Cup", 6, 3, 10, 9, 4)
		outline("HandleLeft", 2, 4, 5, 5, 2)
		outline("HandleRight", 15, 4, 5, 5, 2)
		line("Stem", 11, 15, 5, 90)
		line("Base", 11, 19, 10)
	elseif name == "Performance" then
		line("BoltTop", 11, 6.5, 10.8, 123.7)
		line("BoltMiddle", 11, 11, 7)
		line("BoltBottom", 11, 15.5, 10.8, 123.7)
	elseif name == "Audio" then
		outline("Box", 3, 8, 5, 6, 1)
		line("ConeTop", 10.5, 5.5, 7, -45)
		line("ConeBottom", 10.5, 16.5, 7, 45)
		line("Back", 13, 11, 16, 90)
		line("Wave1", 17, 11, 6, 90)
		line("Wave2", 20, 11, 11, 90)
	elseif name == "Music" then
		outline("NoteHead", 3, 14, 7, 6, 3)
		line("Stem", 9.5, 9, 12, 90)
		line("Flag", 13, 5, 8, 30)
	elseif name == "Effects" then
		line("Ray1", 11, 11, 18)
		line("Ray2", 11, 11, 18, 90)
		line("Ray3", 11, 11, 11, 45)
		line("Ray4", 11, 11, 11, -45)
	elseif name == "Codes" then
		outline("Ring", 2, 7, 8, 8, 4)
		line("Shaft", 15, 11, 11)
		line("Tooth1", 16, 14, 4, 90)
		line("Tooth2", 19.5, 14, 4, 90)
	elseif name == "Titles" then
		line("Left", 3, 12, 10, 90)
		line("Right", 19, 12, 10, 90)
		line("PeakA", 5, 9.5, 6.4, 51.3)
		line("PeakB", 9, 8.5, 8, -60.3)
		line("PeakC", 13, 8.5, 8, 60.3)
		line("PeakD", 17, 9.5, 6.4, -51.3)
		line("Band", 11, 18, 16)
	elseif name == "Shadows" then
		outline("Sun", 6, 2, 10, 10, 5)
		line("Ground", 11, 16, 18)
		line("Shadow1", 9, 20, 10)
	elseif name == "Weather" then
		outline("Cloud", 2, 7, 18, 9, 5)
		outline("Puff", 7, 2, 9, 9, 5)
		line("Drop1", 8, 19.5, 4, 70)
		line("Drop2", 14, 19.5, 4, 70)
	elseif name == "Coin" then
		outline("Coin", 2, 2, 18, 18, 9)
		line("Bar", 11, 11, 10, 90)
		line("Top", 11, 8.5, 6)
		line("Bottom", 11, 13.5, 6)
	elseif name == "Robux" then
		outline("Outer", 3, 3, 16, 16, 5)
		outline("Inner", 8, 8, 6, 6, 1)
	elseif name == "Lock" then
		outline("Shackle", 6, 2, 10, 11, 5)
		dot("Body", 4, 10, 14, 10, 2)
	elseif name == "Check" then
		line("Short", 6.5, 14.5, 7, 45)
		line("Long", 13.5, 11, 14, -50.7)
	elseif name == "Fish" then
		outline("Body", 2, 6, 14, 10, 5)
		line("TailTop", 18, 9, 5.6, -45)
		line("TailBottom", 18, 13, 5.6, 45)
		dot("Eye", 5, 9, 2)
	elseif name == "AutoStore" then
		outline("Crate", 3, 9, 16, 11, 1)
		line("Lid", 11, 13, 16)
		line("Arrow", 11, 3.5, 7, 90)
		line("ArrowLeft", 9.5, 5.5, 4.2, 45)
		line("ArrowRight", 12.5, 5.5, 4.2, 135)
	end
	return icon
end

-- A separate face lets the black background fade without fading the label or icon.
local function navIcon(face, name)
	glyph(face, name, cream, UDim2.new(0, 22, 0.5, 0)).Name = "NavIcon"
end

-- Puts an icon at the left of a themed button and moves its caption beside it.
local function withIcon(item, name, color, size)
	size = size or 20
	local caption = item:FindFirstChild("ThemeCaption")
	glyph(item:FindFirstChild("ThemeFace") or item, name, color or cream, UDim2.new(0, 10 + size / 2, 0.5, 0), size)
	if caption then
		caption.Position = UDim2.fromOffset(size + 18, 2)
		caption.Size = UDim2.new(1, -(size + 24), 1, -4)
	end
	return item
end

local function navButton(item, selected)
	Theme.button(item, if selected then "Selected" else "Normal")
	item.BackgroundTransparency = 1
	item.AutoButtonColor = false
	item.TextScaled = true
	item.TextWrapped = false
	item.TextXAlignment = Enum.TextXAlignment.Left
	item.ThemeBorder.Transparency = 1
	Theme.corner(item, 6)
	local face = item.ThemeFace
	Theme.corner(face, 6)
	face.BackgroundColor3 = Color3.new()
	face.BackgroundTransparency = 0
	face.ThemeFinish.Rotation = 0
	face.ThemeFinish.Color = ColorSequence.new(Color3.new(), Color3.new())
	face.ThemeFinish.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.35, 0.06),
		NumberSequenceKeypoint.new(0.72, 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	local caption = item.ThemeCaption
	caption.Font = Enum.Font.GothamMedium
	caption.TextColor3 = cream
	caption.TextStrokeTransparency = 1
	caption.TextXAlignment = Enum.TextXAlignment.Left
	caption.Position = UDim2.fromOffset(44, 0)
	caption.Size = UDim2.new(1, -48, 1, 0)
	caption.TextScaled = true
	if not caption:FindFirstChild("CaptionSize") then
		local size = Instance.new("UITextSizeConstraint")
		size.Name = "CaptionSize"
		size.MinTextSize, size.MaxTextSize = 11, 14
		size.Parent = caption
	end
	if not face:FindFirstChild("NavIcon") then
		navIcon(face, item.Name)
	end
	-- Focus is visible for both pointer and controller navigation. Preserve the
	-- fade by changing only the left-side accent and caption brightness.
	local accent = face:FindFirstChild("FocusAccent")
	if not accent then
		accent = decoration(face, "FocusAccent", cream, UDim2.new(0, 0, 0.5, -9), UDim2.fromOffset(2, 18))
		Theme.corner(accent, 1)
		local hovered, focused = false, false
		local function update()
			local highlighted = hovered or focused or face:GetAttribute("Finish") == "Selected"
			accent.BackgroundTransparency = if highlighted then 0.1 else 1
			caption.TextTransparency = if highlighted then 0 else 0.12
		end
		item.MouseEnter:Connect(function()
			hovered = true
			update()
		end)
		item.MouseLeave:Connect(function()
			hovered = false
			update()
		end)
		item.SelectionGained:Connect(function()
			focused = true
			update()
		end)
		item.SelectionLost:Connect(function()
			focused = false
			update()
		end)
		item.Parent:GetPropertyChangedSignal("Visible"):Connect(function()
			if not item.Parent.Visible then
				hovered, focused = false, false
			end
			update()
		end)
		face:GetAttributeChangedSignal("Finish"):Connect(update)
		update()
	end
end
local function round(parent, radius)
	Theme.corner(
		parent,
		if isGlass(parent) then 1 elseif parent:IsA("TextButton") then 10 else math.min(radius or 2, 4)
	)
end
local function text(parent, value, size, color, props)
	local item = make("TextLabel", parent, {
		BackgroundTransparency = 1,
		Text = value,
		TextSize = size or 16,
		Font = Enum.Font.Gotham,
		TextColor3 = color or cream,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 28),
	})
	for key, setting in props or {} do
		item[key] = setting
	end
	Theme.text(item, color or cream)
	styleBookItem(item)
	styleGlassItem(item)
	return item
end
local function button(parent, value, callback, props)
	local item = make("TextButton", parent, {
		BackgroundColor3 = navy,
		Text = value,
		TextSize = 16,
		Font = Enum.Font.GothamBold,
		TextColor3 = cream,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 44),
		AutoButtonColor = true,
	})
	for key, setting in props or {} do
		item[key] = setting
	end
	local state = if item.BackgroundColor3 == gold or item.BackgroundColor3 == green then "Selected" else "Normal"
	Theme.button(item, state)
	styleBookItem(item)
	styleGlassItem(item, state)
	item.Activated:Connect(callback)
	return item
end
-- A section heading led by its icon, so headings read differently from buttons.
local function iconTitle(parent, iconName, value, size, color, props)
	local row = make("Frame", parent, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, size + 14) })
	for key, setting in props or {} do
		row[key] = setting
	end
	local iconSize = size + 4
	glyph(row, iconName, color or cream, UDim2.new(0, iconSize / 2, 0.5, 0), iconSize)
	text(row, value, size, color or cream, {
		Name = "Title",
		Position = UDim2.fromOffset(iconSize + 10, 0),
		Size = UDim2.new(1, -(iconSize + 10), 1, 0),
		Font = Enum.Font.GothamBold,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	return row
end
-- Navigation tabs: an icon and a left-aligned label, with a bright bar on the active one.
local function tabButton(parent, name, iconName, selected, compact, callback, props)
	local item = button(parent, name, callback, props)
	Theme.glassButton(item, if selected then "Selected" else "Normal")
	item.TextXAlignment = Enum.TextXAlignment.Left
	withIcon(item, iconName, cream, if compact then 16 else 22)
	if compact then
		item.TextScaled = true
		make("UITextSizeConstraint", item.ThemeCaption, { MinTextSize = 9, MaxTextSize = item.TextSize })
	end
	if selected then
		local marker =
			decoration(item.ThemeFace, "ActiveMarker", cream, UDim2.new(0, 0, 0.5, 0), UDim2.new(0, 3, 1, -16))
		marker.AnchorPoint = Vector2.new(0, 0.5)
		Theme.corner(marker, 2)
	end
	return item
end
local function list(parent, gap)
	return make("UIListLayout", parent, { Padding = UDim.new(0, gap or 10), SortOrder = Enum.SortOrder.LayoutOrder })
end
local function scroll(parent, props)
	local item = make("ScrollingFrame", parent, {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = gold,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	})
	for key, value in props or {} do
		item[key] = value
	end
	return item
end
local function input(parent, placeholder)
	local item = make("TextBox", parent, {
		Size = UDim2.new(1, 0, 0, 42),
		BackgroundColor3 = Color3.fromRGB(15, 26, 29),
		Text = "",
		PlaceholderText = placeholder,
		PlaceholderColor3 = muted,
		TextColor3 = cream,
		Font = Enum.Font.Gotham,
		TextSize = 16,
		ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	Theme.panel(item, true, 2)
	Theme.text(item)
	styleBookItem(item)
	styleGlassItem(item)
	make("UIPadding", item, { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) })
	return item
end
local function empty(parent, title, description, color)
	text(
		parent,
		title,
		22,
		color or cream,
		{ Position = UDim2.new(0.06, 0, 0, 64), Size = UDim2.new(0.88, 0, 0, 68), Font = Enum.Font.GothamBold }
	)
	text(parent, description, 16, color or muted, {
		Position = UDim2.new(0.06, 0, 0, 140),
		Size = UDim2.new(0.88, 0, 0, 110),
		TextYAlignment = Enum.TextYAlignment.Top,
	})
end
local function commas(value)
	local formatted = tostring(value or 0)
	local count
	repeat
		formatted, count = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
	until count == 0
	return formatted
end
-- RichText "Red Neon Albino Cod": each mutation word in its own colour
-- (FishMutations.richLabel), then the species name in `nameColor` if given.
local function fishName(record, nameColor: string?)
	local fish = Catalog.Fish[record.FishId]
	local mutation = FishMutations.richLabel(record.Mutation, record.NeonColor)
	local name = fish and fish.Name or record.FishId
	if nameColor then
		name = '<font color="' .. nameColor .. '">' .. name .. "</font>"
	end
	return (if mutation ~= "" then mutation .. " " else "") .. name
end
-- Silhouettes are drawn as flat ink, so undiscovered fish keep their shape secret-ish.
local function picture(parent, id, props, silhouette, traits)
	local species = Catalog.Fish[id]
	local holder = make("Frame", parent, {
		BackgroundColor3 = Color3.fromRGB(113, 128, 111),
		BackgroundTransparency = 0.65,
		Size = UDim2.new(1, 0, 0, 78),
		BorderSizePixel = 0,
	})
	for key, value in props or {} do
		holder[key] = value
	end
	round(holder, 7)
	local surface = parent
	while surface and not surface:GetAttribute("BookSurface") do
		surface = surface.Parent
	end
	if surface and holder.BackgroundTransparency ~= 1 then
		holder.BackgroundColor3 = Color3.fromRGB(159, 151, 115)
		holder.BackgroundTransparency = 0
		Theme.corner(holder, 1)
		local wash = Instance.new("UIGradient")
		wash.Color = ColorSequence.new(Color3.fromRGB(231, 223, 191), Color3.fromRGB(145, 139, 113))
		wash.Rotation = 90
		wash.Parent = holder
	end
	if species and species.Image and species.Image ~= "" then
		make("ImageLabel", holder, {
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Image = species.Image,
			ImageColor3 = if silhouette then Book.Ink else Color3.new(1, 1, 1),
			ScaleType = Enum.ScaleType.Fit,
		})
	elseif species and FishModels and FishModels.has(id) then
		local view = make("ViewportFrame", holder, { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
		if silhouette then
			view.ImageColor3 = Book.Ink
		end
		FishModels.show(view, id, silhouette, traits)
	else
		text(
			holder,
			if silhouette then "?" elseif species then species.Name else "No catch yet",
			14,
			ink,
			{ Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center }
		)
	end
	return holder
end

function Menu.start()
	if started then
		return
	end
	started = true
	Settings.start()
	Freecam.start()
	local player = Players.LocalPlayer
	-- The server makes this remote in a startup step, often well past 5 s after a
	-- join; an explicit timeout keeps that normal wait out of the error report.
	local remote = ReplicatedStorage:WaitForChild("AnglerMenu", math.huge) :: RemoteFunction
	local profile = nil
	local active = nil
	local settingTab, journalTab = "Performance", "Stats"
	local homeTab = "Paths"
	local selectedStaff, staffFilter = "Seller", "All"
	local freezerUsage, pantryCapacity = 0, 0
	local busy = false
	local render
	local narrow = false
	-- Kept outside render so progress refreshes don't snap the book back to page one.
	local bestiaryPage, bestiaryQuery = 1, ""
	local bestiarySelected, bestiaryBack = nil, nil
	local journalCollapsed = {}
	local turnBestiary
	local gui = make("ScreenGui", player:WaitForChild("PlayerGui"), {
		Name = "PlayerMenu",
		ResetOnSpawn = false,
		DisplayOrder = 30,
		-- Cover the world behind the Roblox top bar when a menu is open.
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	local sidebar = make("Frame", gui, {
		Name = "LeftNavigation",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 14, 0.45, -162),
		Size = UDim2.fromOffset(172, 334),
	})
	list(sidebar, 8)
	local function refreshNavigation()
		sidebar.Visible = active == nil
			and player:GetAttribute("DrydockScreenOpen") ~= true
			and player:GetAttribute("RodCrateOpening") ~= true
		if not sidebar.Visible and GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(sidebar) then
			GuiService.SelectedObject = nil
		end
	end
	player:GetAttributeChangedSignal("DrydockScreenOpen"):Connect(refreshNavigation)
	player:GetAttributeChangedSignal("RodCrateOpening"):Connect(refreshNavigation)
	refreshNavigation()
	local overlay = make("TextButton", gui, {
		Name = "MenuOverlay",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(),
		BackgroundTransparency = 0.35,
		Visible = false,
	})
	local card = make("Frame", overlay, {
		Name = "MenuWindow",
		Active = true,
		BackgroundColor3 = navy,
		BackgroundTransparency = 0.04,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -28, 1, -28),
	})
	make("UISizeConstraint", card, { MaxSize = Vector2.new(1020, 680) })
	Theme.window(card)
	local bookChrome = make("Frame", card, {
		Name = "BookChrome",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
	})
	local shadow = bookPart(bookChrome, "BookShadow", Color3.new(), UDim2.fromOffset(5, 12), UDim2.new(1, 8, 1, 0), 14)
	shadow.BackgroundTransparency = 0.55
	local leatherCover =
		bookPart(bookChrome, "LeatherCover", Book.Leather, UDim2.fromOffset(0, 0), UDim2.fromScale(1, 1), 9)
	local leaves = {}
	for _, side in { 0, 1 } do
		for layer = 4, 1, -1 do
			bookPart(
				bookChrome,
				"PageEdges" .. side .. layer,
				if layer % 2 == 0 then Book.Edge else Book.Paper,
				UDim2.new(side * 0.5, 18 + layer * 2, 0, 14 + layer * 2),
				UDim2.new(0.5, -40, 1, -36),
				20
			)
		end
		local page = bookPart(
			bookChrome,
			if side == 0 then "LeftLeaf" else "RightLeaf",
			Book.Page,
			UDim2.new(side * 0.5, if side == 0 then 18 else -3, 0, 12),
			UDim2.new(0.5, -15, 1, -34),
			26
		)
		paperFinish(page, side == 1)
		leaves[side + 1] = page
		-- Sparse fibers and edge marks suggest worn paper without competing with text.
		for index = 1, 28 do
			local fiber = bookPart(
				page,
				"PaperFiber" .. index,
				Book.Edge,
				UDim2.fromScale(0.06 + ((index * 37) % 89) / 100, 0.03 + ((index * 23) % 93) / 100),
				UDim2.fromOffset(2 + index % 4, 1)
			)
			fiber.BackgroundTransparency = 0.88
		end
		for _, y in { 0, 1 } do
			bookPart(
				page,
				"MarginRule" .. y,
				Book.Edge,
				UDim2.new(0, 26, y, if y == 0 then 69 else -24),
				UDim2.new(1, -58, 0, 1)
			)
		end
	end
	local binding =
		bookPart(bookChrome, "CenterBinding", Book.Ink, UDim2.new(0.5, -18, 0, 22), UDim2.new(0, 36, 1, -53), 18)
	local gutter = Instance.new("UIGradient")
	gutter.Color = ColorSequence.new(Book.Paper, Book.Ink)
	gutter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, 0.35),
		NumberSequenceKeypoint.new(1, 1),
	})
	gutter.Parent = binding
	for index = 1, 12 do
		local loop = bookPart(
			binding,
			"BindingLoop" .. index,
			Book.Ink,
			UDim2.new(0.5, -22, (index - 0.5) / 12, -5),
			UDim2.fromOffset(44, 10),
			5
		)
		loop.Rotation = -5
		local highlight =
			bookPart(loop, "ThreadHighlight", Book.Edge, UDim2.fromOffset(3, 1), UDim2.new(1, -6, 0, 2), 1)
		highlight.BackgroundTransparency = 0.45
	end
	for _, point in { Vector2.new(0, 0), Vector2.new(1, 0), Vector2.new(0, 1), Vector2.new(1, 1) } do
		local corner = bookPart(
			bookChrome,
			"BrassCorner",
			Book.Gold,
			UDim2.new(point.X, if point.X == 0 then 3 else -3, point.Y, if point.Y == 0 then 3 else -3),
			UDim2.fromOffset(13, 13),
			2
		)
		corner.AnchorPoint = point
	end
	bookPart(bookChrome, "RibbonBookmark", Book.Bestiary, UDim2.new(1, -88, 0, 0), UDim2.fromOffset(18, 38))
	local heading = text(card, "", 26, cream, {
		Position = UDim2.fromOffset(60, 8),
		Size = UDim2.new(1, -120, 0, 36),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local subtitle = text(card, "", 13, muted, { Position = UDim2.fromOffset(24, 53), Size = UDim2.new(1, -48, 0, 34) })
	local content = make("Frame", card, {
		Name = "Content",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(20, 98),
		Size = UDim2.new(1, -40, 1, -142),
	})
	local notice = text(
		card,
		"",
		13,
		gold,
		{ Name = "MenuStatus", Position = UDim2.new(0, 24, 1, -37), Size = UDim2.new(1, -48, 0, 30) }
	)
	local navButtons = {}
	local layoutWindow
	local function refreshSelection()
		for name, item in navButtons do
			if name == "Bestiary" or name == "Journal" then
				bookButton(item, name == active)
			else
				navButton(item, name == active)
			end
		end
	end
	local function close()
		if active == "Home" then
			content:ClearAllChildren()
		end
		active = nil
		bestiarySelected = nil
		overlay.Visible = false
		player:SetAttribute("PlayerMenuOpen", false)
		refreshSelection()
		if layoutWindow then
			layoutWindow()
		end
		if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(card) then
			GuiService.SelectedObject = nil
		end
	end
	local closeButton = button(
		card,
		"×",
		close,
		{ Name = "CloseMenu", Position = UDim2.new(1, -53, 0, 12), Size = UDim2.fromOffset(40, 40), TextSize = 28 }
	)
	Theme.button(closeButton, "Danger")
	overlay.Activated:Connect(close)
	local nextRequestAt = 0
	local function request(action, key, value)
		if busy then
			return
		end
		busy = true
		notice.Text = if action == "Get" then "Loading your progress…" else "Saving…"
		task.spawn(function()
			local delay = nextRequestAt - os.clock()
			if delay > 0 then
				task.wait(delay)
			end
			local ok, result = pcall(function()
				return remote:InvokeServer(action, key, value)
			end)
			nextRequestAt = os.clock() + 0.3
			busy = false
			if ok and type(result) == "table" then
				freezerUsage = result.FreezerUsage or freezerUsage
				pantryCapacity = result.PantryCapacity or pantryCapacity
				if result.Profile then
					profile = result.Profile
					profile.Angler.Settings =
						Settings.apply(profile.Angler.Settings, if result.Ok and action == "Setting" then key else nil)
				end
				notice.Text = result.Message or ""
				if result.Ok and result.PromptProductId == Paths.SKIP_PRODUCT_ID then
					local prompted = pcall(function()
						MarketplaceService:PromptProductPurchase(player, Paths.SKIP_PRODUCT_ID)
					end)
					if not prompted then
						notice.Text = "Could not open the quest skip purchase. Please try again."
					end
				end
			else
				notice.Text = "Could not reach your progress. Close and reopen to try again."
			end
			if player:GetAttribute("WalletSessionOnly") and notice.Text == "" then
				notice.Text = "Studio session · progress resets when this server stops."
			end
			if active then
				render()
			end
		end)
	end
	local function bestiary()
		-- A dense index: many small plates per page, with full field notes behind
		-- the picture. Wide screens keep the two-page spread; narrow ones use one.
		local spread = if narrow then 1 else 2
		local pages = {}
		for side = 1, spread do
			pages[side] = make("Frame", content, {
				Name = "BestiaryPage" .. side,
				BackgroundTransparency = 1,
				Position = if narrow
					then UDim2.fromOffset(12, 0)
					elseif side == 1 then UDim2.fromOffset(14, 0)
					else UDim2.new(0.5, 34, 0, 0),
				Size = if narrow then UDim2.new(1, -24, 1, 0) else UDim2.new(0.5, -48, 1, 0),
			})
		end
		local function label(parent, value, size, props, fade)
			local item = text(parent, value, size, Book.Ink, props)
			item.TextColor3 = Book.Ink
			item.TextTransparency = fade or 0
			return item
		end
		local function rule(parent, position, width)
			local line = decoration(parent, "Rule", Book.Edge, position, UDim2.fromOffset(width, 1))
			line.AnchorPoint = Vector2.new(0.5, 0.5)
			line.BackgroundTransparency = 0.35
			return line
		end

		-- The search field is ink on the page: no box, only a ruled line to write on.
		local search = input(pages[1], "Search the bestiary…")
		search.BackgroundTransparency = 1
		search.Size = UDim2.new(1, 0, 0, 34)
		search.Text = bestiaryQuery
		search.TextSize = 17
		search.PlaceholderColor3 = Book.Edge
		search:FindFirstChild("ThemeBorder").Enabled = false
		local searchLine = decoration(search, "SearchLine", Book.Edge, UDim2.new(0, -12, 1, -1), UDim2.new(1, 24, 0, 1))
		searchLine.BackgroundTransparency = 0.4
		search.Focused:Connect(function()
			searchLine.BackgroundColor3, searchLine.BackgroundTransparency = Book.Ink, 0
		end)
		search.FocusLost:Connect(function()
			searchLine.BackgroundColor3, searchLine.BackgroundTransparency = Book.Edge, 0.4
		end)

		local all = {}
		local discovered = 0
		for id, species in Catalog.Fish do
			if not species.DropOnly then
				table.insert(all, id)
				local entry = profile.Angler.Catches[id]
				if entry and (entry.Count or 0) > 0 then
					discovered += 1
				end
			end
		end
		table.sort(all, function(a, b)
			local rankA = (Catalog.Rarities[Catalog.Fish[a].Rarity] or {}).Order or 0
			local rankB = (Catalog.Rarities[Catalog.Fish[b].Rarity] or {}).Order or 0
			if rankA ~= rankB then
				return rankA < rankB
			end
			return Catalog.Fish[a].Name < Catalog.Fish[b].Name
		end)
		local number = {}
		for index, id in all do
			number[id] = index
		end
		if not narrow then
			label(pages[2], string.format("FIELD NOTES   ·   %d of %d discovered", discovered, #all), 14, {
				Size = UDim2.new(1, 0, 0, 34),
				TextXAlignment = Enum.TextXAlignment.Center,
			}, 0.25)
		end

		local sheets, footers = {}, {}
		for side, page in pages do
			sheets[side] = make("Frame", page, {
				Name = "Sheet",
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(0, 50),
				Size = UDim2.new(1, 0, 1, -94),
			})
			footers[side] = make("Frame", page, {
				Name = "Footer",
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 0, 1, -38),
				Size = UDim2.new(1, 0, 0, 30),
			})
		end

		-- The index is a dense set of small plates: picture, name and catch count.
		-- Full field notes open only when the angler presses a picture.
		local gap = 6
		local contentWidth = math.max(content.AbsoluteSize.X, 320)
		local contentHeight = math.max(content.AbsoluteSize.Y, 300)
		local pageWidth = if narrow then contentWidth - 24 else contentWidth * 0.5 - 48
		local pageHeight = contentHeight - 94
		local columns = math.clamp(math.floor((pageWidth + gap) / 100), 3, if narrow then 6 else 5)
		local rows = math.max(3, math.floor((pageHeight + gap) / 90))
		local perPage = columns * rows
		local cellWidth = math.max(54, math.floor((pageWidth - (columns - 1) * gap) / columns))
		local cellHeight = math.max(66, math.floor((pageHeight - (rows - 1) * gap) / rows))
		local artSize = math.clamp(math.floor(math.min(cellWidth - 16, cellHeight - 40)), 30, 48)
		local fill

		local function details(id)
			local species = Catalog.Fish[id]
			local entry = profile.Angler.Catches[id]
			local known = entry ~= nil and (entry.Count or 0) > 0
			local rarity = Catalog.Rarities[species.Rarity]
			local panelWidth = math.max(contentWidth - 36, 260)
			local panelHeight = math.max(contentHeight - 10, 320)
			local tight = panelWidth < 520

			local shadow = decoration(content, "BestiaryDetailShadow", Color3.new(), UDim2.fromScale(0.5, 0.5), UDim2.new(1, -30, 1, -4))
			shadow.AnchorPoint, shadow.BackgroundTransparency = Vector2.new(0.5, 0.5), 0.72
			Theme.corner(shadow, 4)

			local panel = make("Frame", content, {
				Name = "BestiaryDetail",
				BackgroundTransparency = 1,
				Active = true,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(panelWidth, panelHeight),
				ZIndex = 20,
			})
			paperFinish(panel, false)
			Theme.corner(panel, 3)
			local edge = Instance.new("UIStroke")
			edge.Color, edge.Transparency, edge.Thickness = Book.Edge, 0.2, 1
			edge.Parent = panel

			local back = make("TextButton", panel, {
				Name = "BestiaryBack",
				BackgroundTransparency = 1,
				AutoButtonColor = false,
				Text = "‹  Bestiary",
				Font = Enum.Font.Garamond,
				TextSize = 17,
				TextColor3 = Book.Leather,
				TextXAlignment = Enum.TextXAlignment.Left,
				Position = UDim2.fromOffset(18, 8),
				Size = UDim2.fromOffset(150, 30),
				ZIndex = 21,
			})
			back.MouseEnter:Connect(function()
				back.TextColor3 = Book.Ink
			end)
			back.MouseLeave:Connect(function()
				back.TextColor3 = Book.Leather
			end)
			back.Activated:Connect(function()
				bestiarySelected = nil
				fill()
			end)

			local tag = label(
				panel,
				string.format("No. %02d", number[id])
					.. (if known then "   ·   " .. string.upper(rarity and rarity.Name or species.Rarity) else ""),
				13,
				{
					Position = UDim2.new(0, 0, 0, 10),
					Size = UDim2.new(1, 0, 0, 22),
					TextXAlignment = Enum.TextXAlignment.Center,
				},
				0.15
			)
			tag.TextColor3 = Book.Leather

			-- A double-ruled plate, like an engraving tipped into a field guide.
			local plateTop = 42
			local plateHeight = math.clamp(panelHeight * 0.34, 130, 190)
			local plateWidth = math.clamp(panelWidth * 0.55, 210, 430)
			local plate = make("Frame", panel, {
				Name = "Plate",
				BackgroundTransparency = 1,
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, plateTop),
				Size = UDim2.fromOffset(plateWidth, plateHeight),
			})
			plate.BackgroundColor3, plate.BackgroundTransparency = Book.Edge, if known then 0.86 else 0.9
			Theme.corner(plate, 2)
			local outer = Instance.new("UIStroke")
			outer.Color, outer.Transparency, outer.Thickness = Book.Edge, 0.25, 1
			outer.Parent = plate
			local inner = make("Frame", plate, {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(5, 5),
				Size = UDim2.new(1, -10, 1, -10),
			})
			local innerStroke = Instance.new("UIStroke")
			innerStroke.Color, innerStroke.Transparency, innerStroke.Thickness = Book.Edge, 0.6, 1
			innerStroke.Parent = inner
			local art = picture(inner, id, {
				BackgroundTransparency = 1,
				Position = UDim2.fromScale(0.05, 0.06),
				Size = UDim2.fromScale(0.9, 0.88),
			}, not known)
			local artEdge = art:FindFirstChild("ThemeBorder")
			if artEdge then
				artEdge.Enabled = false
			end

			local nameTop = plateTop + plateHeight + 6
			label(panel, if known then species.Name else "Undiscovered", if tight then 23 else 30, {
				Position = UDim2.new(0, 0, 0, nameTop),
				Size = UDim2.new(1, 0, 0, 36),
				TextXAlignment = Enum.TextXAlignment.Center,
			}, if known then 0 else 0.45)
			local ornamentY = nameTop + 38
			rule(panel, UDim2.new(0.5, -44, 0, ornamentY), 70)
			rule(panel, UDim2.new(0.5, 44, 0, ornamentY), 70)
			local diamond =
				decoration(panel, "Ornament", Book.Leather, UDim2.new(0.5, 0, 0, ornamentY), UDim2.fromOffset(6, 6))
			diamond.AnchorPoint, diamond.Rotation = Vector2.new(0.5, 0.5), 45

			local statsTop = ornamentY + 10
			local stats = {
				{ "CAUGHT", if known then tostring(entry.Count) else "—" },
				{ "BIGGEST", if known then string.format("%.2f kg", entry.BiggestKg) else "—" },
				{ "SIZE RANGE", if known then string.format("%g–%g kg", species.MinKg, species.MaxKg) else "—" },
				-- Shown before discovery so anglers know when to look for it.
				{ "SEASON", FishCatch.seasonLabel(species) },
			}
			for column, stat in stats do
				local x = (column - 1) / #stats
				label(panel, stat[1], if tight then 10 else 12, {
					Position = UDim2.new(x, 0, 0, statsTop),
					Size = UDim2.new(1 / #stats, 0, 0, 16),
					TextXAlignment = Enum.TextXAlignment.Center,
				}, 0.4)
				label(panel, stat[2], if tight then 15 else 20, {
					Position = UDim2.new(x, 0, 0, statsTop + 16),
					Size = UDim2.new(1 / #stats, 0, 0, 26),
					TextXAlignment = Enum.TextXAlignment.Center,
				})
				if column > 1 then
					local divider =
						decoration(panel, "StatDivider", Book.Edge, UDim2.new(x, 0, 0, statsTop + 4), UDim2.fromOffset(1, 34))
					divider.BackgroundTransparency = 0.6
				end
			end

			local notesTop = statsTop + 62
			if not known then
				label(panel, "Land one of these to fill in this page.", 15, {
					Position = UDim2.new(0.1, 0, 0, notesTop),
					Size = UDim2.new(0.8, 0, 0, 44),
					TextXAlignment = Enum.TextXAlignment.Center,
					TextYAlignment = Enum.TextYAlignment.Top,
				}, 0.4)
				return
			end
			-- Sorted by plain name, written with each mutation word in its own colour.
			local recorded = {}
			for mutation, count in entry.Mutations or {} do
				local info = Catalog.Mutations[mutation]
				table.insert(recorded, { Plain = info and info.Name or mutation, Key = mutation, Count = count })
			end
			table.sort(recorded, function(a, b)
				return a.Plain < b.Plain
			end)
			local mutationNames = {}
			for _, item in recorded do
				local rich = FishMutations.richLabel(item.Key, nil, true)
				table.insert(mutationNames, (if rich ~= "" then rich else item.Plain) .. " ×" .. item.Count)
			end
			label(panel, "MUTATIONS", if tight then 10 else 12, {
				Position = UDim2.new(0, 0, 0, notesTop),
				Size = UDim2.new(1, 0, 0, 16),
				TextXAlignment = Enum.TextXAlignment.Center,
			}, 0.4)
			local notes = scroll(panel, {
				Position = UDim2.new(0.08, 0, 0, notesTop + 20),
				Size = UDim2.new(0.84, 0, 1, -(notesTop + 32)),
			})
			label(
				notes,
				if #mutationNames > 0 then table.concat(mutationNames, "   ·   ") else "None recorded yet",
				if tight then 13 else 15,
				{
					Size = UDim2.new(1, -8, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					RichText = true,
					TextXAlignment = Enum.TextXAlignment.Center,
					TextYAlignment = Enum.TextYAlignment.Top,
				},
				0.1
			)
		end

		local function entryTile(sheet, id, order)
			local species = Catalog.Fish[id]
			local entry = profile.Angler.Catches[id]
			local known = entry ~= nil and (entry.Count or 0) > 0
			local tile = make("Frame", sheet, {
				Name = "Entry_" .. id,
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(
					(order % columns) * (cellWidth + gap),
					math.floor(order / columns) * (cellHeight + gap)
				),
				Size = UDim2.fromOffset(cellWidth, cellHeight),
			})
			local art = picture(tile, id, {
				BackgroundTransparency = 1,
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, 0),
				Size = UDim2.fromOffset(artSize, artSize),
			}, not known)
			local artEdge = art:FindFirstChild("ThemeBorder")
			if artEdge then
				artEdge.Enabled = false
			end
			local name = label(tile, if known then species.Name else "Undiscovered", 11, {
				Position = UDim2.fromOffset(0, artSize + 3),
				Size = UDim2.new(1, 0, 0, 23),
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextScaled = true,
			}, if known then 0 else 0.45)
			make("UITextSizeConstraint", name, { MinTextSize = 8, MaxTextSize = 11 })
			label(tile, if known then "×" .. commas(entry.Count) else "—", 11, {
				Position = UDim2.fromOffset(0, artSize + 26),
				Size = UDim2.new(1, 0, 0, 14),
				TextXAlignment = Enum.TextXAlignment.Center,
			}, 0.25)
			-- Only the picture is the button, so the index stays quiet and dense.
			local hit = make("TextButton", tile, {
				Name = "BestiaryArt_" .. id,
				BackgroundTransparency = 1,
				AutoButtonColor = false,
				Text = "",
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, 0),
				Size = UDim2.fromOffset(artSize, artSize),
				ZIndex = 5,
			})
			local function highlight(on)
				name.TextColor3 = if on then Book.Leather else Book.Ink
			end
			hit.MouseEnter:Connect(function()
				highlight(true)
			end)
			hit.MouseLeave:Connect(function()
				highlight(false)
			end)
			hit.SelectionGained:Connect(function()
				highlight(true)
			end)
			hit.SelectionLost:Connect(function()
				highlight(false)
			end)
			hit.Activated:Connect(function()
				bestiarySelected = id
				fill()
			end)
		end

		local function pageButton(parent, value, alignment, onActivated)
			local item = make("TextButton", parent, {
				Name = "PageTurn",
				BackgroundTransparency = 1,
				AutoButtonColor = false,
				Text = value,
				Font = Enum.Font.Garamond,
				TextSize = 18,
				TextColor3 = Book.Leather,
				TextXAlignment = alignment,
				Position = if alignment == Enum.TextXAlignment.Left then UDim2.new() else UDim2.new(1, -110, 0, 0),
				Size = UDim2.new(0, 110, 1, 0),
			})
			item.MouseEnter:Connect(function()
				item.TextColor3 = Book.Ink
			end)
			item.MouseLeave:Connect(function()
				item.TextColor3 = Book.Leather
			end)
			item.Activated:Connect(onActivated)
			return item
		end

		local spreads = 1
		turnBestiary = function(step)
			if bestiarySelected then
				return
			end
			local target = math.clamp(bestiaryPage + step, 1, spreads)
			if target ~= bestiaryPage then
				bestiaryPage = target
				fill()
			end
		end
		bestiaryBack = function()
			if bestiarySelected then
				bestiarySelected = nil
				fill()
			end
		end
		fill = function()
			-- Details live over the whole spread, so clear the previous panel
			-- before rebuilding the index (or another species' notes).
			for _, name in { "BestiaryDetail", "BestiaryDetailShadow" } do
				local layer = content:FindFirstChild(name)
				if layer then
					layer:Destroy()
				end
			end
			local query = string.lower(bestiaryQuery)
			local ids = {}
			for _, id in all do
				local entry = profile.Angler.Catches[id]
				if query == "" then
					table.insert(ids, id)
				elseif entry and (entry.Count or 0) > 0 then
					-- Only discovered pages are searchable, so search can't spoil a species.
					local haystack = Catalog.Fish[id].Name
					for mutation in entry.Mutations or {} do
						local info = Catalog.Mutations[mutation]
						haystack ..= " " .. (info and info.Name or mutation)
					end
					if string.find(string.lower(haystack), query, 1, true) then
						table.insert(ids, id)
					end
				end
			end
			local pagesTotal = math.max(1, math.ceil(#ids / perPage))
			spreads = math.max(1, math.ceil(pagesTotal / spread))
			bestiaryPage = math.clamp(bestiaryPage, 1, spreads)
			if bestiarySelected and not table.find(ids, bestiarySelected) then
				bestiarySelected = nil
			end
			for side = 1, spread do
				sheets[side]:ClearAllChildren()
				footers[side]:ClearAllChildren()
			end
			if #ids == 0 then
				local blank = if next(Catalog.Fish)
					then "No discovered fish match that search."
					else "New species will appear here as they are added."
				label(sheets[1], blank, 18, {
					Position = UDim2.fromScale(0.1, 0.3),
					Size = UDim2.new(0.8, 0, 0, 60),
					TextXAlignment = Enum.TextXAlignment.Center,
				}, 0.35)
				return
			end
			if bestiarySelected then
				details(bestiarySelected)
				return
			end
			local first = (bestiaryPage - 1) * perPage * spread
			for side = 1, spread do
				local start = first + (side - 1) * perPage
				for order = 0, perPage - 1 do
					local id = ids[start + order + 1]
					if not id then
						break
					end
					entryTile(sheets[side], id, order)
				end
				local pageNumber = (bestiaryPage - 1) * spread + side
				if pageNumber <= pagesTotal then
					label(footers[side], string.format("%d / %d", pageNumber, pagesTotal), 14, {
						Size = UDim2.fromScale(1, 1),
						TextXAlignment = Enum.TextXAlignment.Center,
					}, 0.45)
				end
			end
			if bestiaryPage > 1 then
				pageButton(footers[1], "‹  Previous", Enum.TextXAlignment.Left, function()
					turnBestiary(-1)
				end)
			end
			if bestiaryPage < spreads then
				pageButton(footers[spread], "Next  ›", Enum.TextXAlignment.Right, function()
					turnBestiary(1)
				end)
			end
		end
		search:GetPropertyChangedSignal("Text"):Connect(function()
			if search.Text ~= bestiaryQuery then
				bestiaryQuery, bestiaryPage, bestiarySelected = search.Text, 1, nil
				fill()
			end
		end)
		fill()
	end
	local function equipment()
		EquipmentBag.show(content, profile, player, card.AbsoluteSize.X < 1000)
	end
	local function journal()
		-- A hand-lettered field journal: profile and stats on the left, findings on the right.
		local hand = Enum.Font.PatrickHand
		local frameInk = Color3.fromRGB(104, 92, 70)
		local function write(parent, value, size, props, color, font)
			local item = text(parent, value, size, Book.Ink, props)
			item.Font = font or hand
			item.TextColor3 = color or Book.Ink
			return item
		end
		local function box(parent, name, color, position, size, radius, strokeColor, thickness)
			local item = decoration(parent, name, color, position, size)
			if radius then
				Theme.corner(item, radius)
			end
			if strokeColor then
				local stroke = Instance.new("UIStroke")
				stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				stroke.Color, stroke.Thickness = strokeColor, thickness or 2
				stroke.Parent = item
			end
			return item
		end
		local function rule(parent, y)
			local line = decoration(parent, "Rule", Book.Ink, UDim2.fromOffset(0, y), UDim2.new(1, 0, 0, 2))
			line.BackgroundTransparency = 0.55
		end

		local book = if narrow then scroll(content) else content
		local left = make("Frame", book, {
			Name = "JournalStatsPage",
			BackgroundTransparency = 1,
			Position = if narrow then UDim2.new() else UDim2.fromOffset(14, 0),
			Size = if narrow then UDim2.new(1, -8, 0, 600) else UDim2.new(0.5, -44, 1, 0),
		})
		local right = make("Frame", book, {
			Name = "JournalFindingsPage",
			BackgroundTransparency = 1,
			Position = if narrow then UDim2.fromOffset(0, 618) else UDim2.new(0.5, 30, 0, 0),
			Size = if narrow then UDim2.new(1, -8, 0, 560) else UDim2.new(0.5, -44, 1, 0),
		})

		-- Title: the inked check box doubles as the close control, like a ticked-off page.
		rule(left, 0)
		local tick = make("TextButton", left, {
			Name = "CloseJournal",
			Text = "✕",
			Font = hand,
			TextSize = 24,
			TextColor3 = Book.Leather,
			AutoButtonColor = false,
			BackgroundColor3 = Book.Paper,
			BackgroundTransparency = 0.4,
			Position = UDim2.fromOffset(6, 12),
			Size = UDim2.fromOffset(30, 30),
		})
		local tickStroke = Instance.new("UIStroke")
		tickStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		tickStroke.Color, tickStroke.Thickness = Book.Ink, 2
		tickStroke.Parent = tick
		tick.MouseEnter:Connect(function()
			tick.TextColor3 = Book.Ink
		end)
		tick.MouseLeave:Connect(function()
			tick.TextColor3 = Book.Leather
		end)
		tick.Activated:Connect(close)
		write(left, "Angler's Journal", 34, { Position = UDim2.fromOffset(48, 6), Size = UDim2.new(1, -54, 0, 44) })
		rule(left, 54)

		local avatar = make("ImageLabel", left, {
			Name = "Portrait",
			BackgroundColor3 = Book.Paper,
			Position = UDim2.fromOffset(6, 68),
			Size = UDim2.fromOffset(80, 80),
		})
		avatar.BackgroundColor3 = Color3.fromRGB(196, 184, 156)
		avatar.ThemeBorder.Color, avatar.ThemeBorder.Thickness, avatar.ThemeBorder.Transparency = frameInk, 3, 0
		task.spawn(function()
			local ok, image = pcall(function()
				return Players:GetUserThumbnailAsync(
					player.UserId,
					Enum.ThumbnailType.HeadShot,
					Enum.ThumbnailSize.Size150x150
				)
			end)
			if ok and avatar.Parent then
				avatar.Image = image
			end
		end)
		write(left, player.DisplayName, 26, {
			Position = UDim2.fromOffset(100, 74),
			Size = UDim2.new(1, -184, 0, 32),
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextWrapped = false,
		})
		write(left, "Lv. " .. (player:GetAttribute("Level") or 1), 26, {
			Position = UDim2.new(1, -84, 0, 74),
			Size = UDim2.fromOffset(80, 32),
			TextXAlignment = Enum.TextXAlignment.Right,
		}, Color3.fromRGB(150, 118, 52))
		write(left, "@" .. player.Name, 15, {
			Position = UDim2.fromOffset(100, 106),
			Size = UDim2.new(1, -104, 0, 22),
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextWrapped = false,
		}, nil, Enum.Font.RobotoMono)
		rule(left, 160)

		local search = make("TextBox", left, {
			Name = "JournalSearch",
			Text = "",
			PlaceholderText = "Search...",
			ClearTextOnFocus = false,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextSize = 20,
			Position = UDim2.fromOffset(0, 174),
			Size = UDim2.new(0.5, -8, 0, 34),
		})
		search.Font, search.TextColor3, search.PlaceholderColor3 = hand, Book.Ink, Book.Edge
		search.BackgroundColor3, search.BackgroundTransparency = Color3.fromRGB(214, 200, 160), 0
		Theme.corner(search, 10)
		local searchStroke = Instance.new("UIStroke")
		searchStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		searchStroke.Color, searchStroke.Thickness = Book.Edge, 2
		searchStroke.Parent = search
		make("UIPadding", search, { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) })

		-- Segmented Stats / Achievements switch.
		local toggle =
			box(left, "JournalTabs", Book.Paper, UDim2.new(0.5, 8, 0, 174), UDim2.new(0.5, -8, 0, 34), 17, Book.Edge, 2)
		local tabButtons = {}
		local fill
		local function refreshTabs()
			for tab, item in tabButtons do
				item.BackgroundTransparency = if tab == journalTab then 0 else 1
				item.TextSize = if tab == journalTab then 21 else 17
			end
		end
		for index, tab in { "Stats", "Achievements" } do
			local item = make("TextButton", toggle, {
				Name = tab .. "Tab",
				Text = tab,
				Font = hand,
				TextColor3 = Book.Ink,
				AutoButtonColor = false,
				BackgroundColor3 = Color3.fromRGB(252, 234, 192),
				Position = UDim2.new((index - 1) * 0.5, 2, 0, 2),
				Size = UDim2.new(0.5, -4, 1, -4),
			})
			Theme.corner(item, 15)
			item.Activated:Connect(function()
				if journalTab ~= tab then
					journalTab = tab
					refreshTabs()
					fill()
				end
			end)
			tabButtons[tab] = item
		end
		refreshTabs()

		local ledger = box(
			left,
			"StatsLedger",
			Color3.fromRGB(226, 215, 190),
			UDim2.fromOffset(0, 220),
			UDim2.new(1, 0, 1, -224),
			2,
			frameInk,
			3
		)
		local rows = scroll(ledger, {
			Position = UDim2.fromOffset(4, 4),
			Size = UDim2.new(1, -8, 1, -8),
		})
		rows.ScrollBarImageColor3, rows.ScrollBarThickness = frameInk, 6
		list(rows, 0)

		fill = function()
			for _, child in rows:GetChildren() do
				if child:IsA("GuiObject") then
					child:Destroy()
				end
			end
			local stats = profile.Angler.Stats
			local discovered = 0
			local caughtByRarity = {}
			for fishId, entry in profile.Angler.Catches do
				if entry.Count > 0 then
					discovered += 1
					local fish = Catalog.Fish[fishId]
					if fish then
						caughtByRarity[fish.Rarity] = (caughtByRarity[fish.Rarity] or 0) + entry.Count
					end
				end
			end
			local entries
			if journalTab == "Stats" then
				local catchDetails = {
					{ "Species Discovered", discovered },
					{ "Total Weight Caught", string.format("%.2f kg", stats.TotalCaughtKg or 0) },
				}
				local rarities = {}
				for id in Catalog.Rarities do
					table.insert(rarities, id)
				end
				table.sort(rarities, function(a, b)
					return Catalog.Rarities[a].Order < Catalog.Rarities[b].Order
				end)
				for _, id in rarities do
					table.insert(catchDetails, { Catalog.Rarities[id].Name .. " Caught", caughtByRarity[id] or 0 })
				end
				entries = {
					{ "Astral Anomalies Activated", stats.AstralAnomaliesActivated },
					{
						"Bestiary Pages Completed",
						stats.BestiaryPagesCompleted,
						{
							{ "Limited Bestiaries Completed", stats.LimitedBestiariesCompleted },
							{ "Permanent Bestiaries Completed", stats.PermanentBestiariesCompleted },
						},
					},
					{ "Fish Caught", stats.TotalCaught, catchDetails },
					{ "Perfect Catches", stats.PerfectCatches or 0 },
					{ "Catch Streak", stats.CatchStreak, { { "Highest Catch Streak", stats.HighestCatchStreak } } },
					{
						"Treasure Chests Opened",
						stats.TreasureChestsOpened,
						{ { "Sunken Chests Opened", stats.SunkenChestsOpened } },
					},
					{
						"Coins",
						profile.Cash,
						{
							{ "Lifetime Coins Earned", stats.CoinsEarned },
							{ "Lifetime Coins Spent", stats.CoinsSpent },
						},
					},
					{ "Crab Cages Opened", stats.CrabCagesOpened },
					{ "Deaths", stats.Deaths },
				}
			else
				local function goal(name, objective, progress, target)
					local status = if progress >= target then "Complete" else commas(progress) .. " / " .. commas(target)
					return { name, status, { { objective, "" } } }
				end
				entries = {
					goal("First Catch", "Catch 1 fish", stats.TotalCaught, 1),
					goal("Getting the Hang of It", "Catch 10 fish", stats.TotalCaught, 10),
					goal("Seasoned Angler", "Catch 100 fish", stats.TotalCaught, 100),
					goal("Curious Angler", "Discover 5 species", discovered, 5),
					goal("Fish Merchant", "Sell 10 fish", stats.FishSold, 10),
					goal("Making a Living", "Earn 1,000 coins", stats.CoinsEarned, 1000),
					goal("Crab Collector", "Open 10 crab cages", stats.CrabCagesOpened, 10),
					goal("Home Cook", "Cook 10 meals", stats.FoodCooked, 10),
				}
			end

			local query = string.lower(search.Text)
			local function matches(entry)
				return string.find(string.lower(entry[1]), query, 1, true) ~= nil
			end
			local shown = 0
			local function row(entry, child, children)
				shown += 1
				local line = decoration(rows, "Row", Book.Edge, UDim2.new(), UDim2.new(1, -8, 0, 28))
				line.LayoutOrder = shown
				line.BackgroundTransparency = if shown % 2 == 0 then 0.8 else 1
				local x = if child then 30 else 6
				if child then
					local thread =
						decoration(line, "TreeLine", Book.Edge, UDim2.fromOffset(15, 0), UDim2.new(0, 1, 1, 0))
					thread.BackgroundTransparency = 0.25
				end
				local marker = if children
					then (if journalCollapsed[entry[1]] and query == "" then "▼" else "▲")
					else "•"
				write(line, marker, if children then 13 else 20, {
					Position = UDim2.fromOffset(x, 0),
					Size = UDim2.new(0, 14, 1, 0),
					TextXAlignment = Enum.TextXAlignment.Center,
				})
				write(line, entry[1], 20, {
					Position = UDim2.fromOffset(x + 20, 0),
					Size = UDim2.new(0.72, -(x + 20), 1, 0),
					TextTruncate = Enum.TextTruncate.AtEnd,
					TextWrapped = false,
				})
				write(line, if type(entry[2]) == "number" then commas(entry[2]) else tostring(entry[2] or 0), 20, {
					Position = UDim2.fromScale(0.72, 0),
					Size = UDim2.new(0.28, -8, 1, 0),
					TextXAlignment = Enum.TextXAlignment.Right,
				})
				if children then
					local hit = make("TextButton", line, {
						Name = "Collapse",
						Text = "",
						BackgroundTransparency = 1,
						AutoButtonColor = false,
						Size = UDim2.fromScale(1, 1),
					})
					hit.Activated:Connect(function()
						journalCollapsed[entry[1]] = not journalCollapsed[entry[1]] or nil
						fill()
					end)
				end
			end
			for _, entry in entries do
				local children = {}
				for _, child in entry[3] or {} do
					if query == "" or matches(entry) or matches(child) then
						table.insert(children, child)
					end
				end
				if query ~= "" and not matches(entry) and #children == 0 then
					continue
				end
				row(entry, false, if entry[3] then children else nil)
				if query ~= "" or not journalCollapsed[entry[1]] then
					for _, child in children do
						row(child, true)
					end
				end
			end
			if shown == 0 then
				write(rows, "Nothing written about that yet.", 20, {
					Size = UDim2.new(1, -8, 0, 40),
					TextXAlignment = Enum.TextXAlignment.Center,
					TextTransparency = 0.4,
				})
			end
		end
		search:GetPropertyChangedSignal("Text"):Connect(fill)
		fill()

		-- Findings: a double-ruled panel of specimen cards.
		local panel = box(
			right,
			"FindingsPanel",
			Color3.fromRGB(226, 215, 190),
			UDim2.new(),
			UDim2.fromScale(1, 1),
			2,
			frameInk,
			3
		)
		box(panel, "InnerRule", Color3.new(), UDim2.fromOffset(5, 5), UDim2.new(1, -10, 1, -10), 1, frameInk, 1).BackgroundTransparency =
			1
		write(panel, "FINDINGS", 30, {
			Position = UDim2.fromOffset(0, 8),
			Size = UDim2.new(1, 0, 0, 36),
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		local shelf = scroll(panel, { Position = UDim2.fromOffset(14, 46), Size = UDim2.new(1, -20, 1, -54) })
		shelf.ScrollBarImageColor3, shelf.ScrollBarThickness = frameInk, 6

		local findings = profile.Angler.Findings
		local mostId, mostCount = nil, 0
		for id, entry in profile.Angler.Catches do
			if entry.Count > mostCount then
				mostId, mostCount = id, entry.Count
			end
		end
		local function richName(record)
			return fishName(record, "#A6D8F2")
		end
		local cards = {
			{
				"Highest Value",
				findings.HighestValue,
				function(r)
					return "$" .. commas(math.floor(r.Value + 0.5))
				end,
			},
			{
				"Rarest",
				findings.Rarest,
				function(r)
					return "1 in " .. commas(r.Rarity)
				end,
			},
			{
				"Most Caught",
				mostId and { FishId = mostId, Mutation = "Normal" },
				function()
					return commas(mostCount) .. " Caught"
				end,
			},
			{
				"Largest",
				findings.Largest,
				function(r)
					return string.format("%.2f kg", r.Kg)
				end,
			},
			{
				"Relative Largest",
				findings.RelativeLargest,
				function(r)
					return string.format("%.2f kg (%.2f×)", r.Kg, r.Relative)
				end,
			},
		}
		local cardHeight = 128
		for i, entry in cards do
			local full = i == 1
			local x = if full or i % 2 == 0 then 0 else 0.5
			local y = if full then 0 else (cardHeight + 46) * (1 + math.floor((i - 2) / 2))
			local slot = make("Frame", shelf, {
				Name = entry[1]:gsub(" ", ""),
				BackgroundTransparency = 1,
				Position = UDim2.new(x, if full or x == 0 then 0 else 6, 0, y),
				Size = UDim2.new(if full then 1 else 0.5, if full then -10 else -16, 0, cardHeight + 34),
			})
			write(slot, "—  " .. entry[1] .. "  —", if #entry[1] > 12 then 17 else 20, {
				Size = UDim2.new(1, 0, 0, 26),
				TextXAlignment = Enum.TextXAlignment.Center,
				TextWrapped = false,
			})
			local plate = box(
				slot,
				"Specimen",
				Color3.new(1, 1, 1),
				UDim2.fromOffset(2, 32),
				UDim2.new(1, -4, 0, cardHeight),
				2,
				Color3.fromRGB(88, 80, 58),
				3
			)
			local wash = Instance.new("UIGradient")
			wash.Color = ColorSequence.new(Color3.fromRGB(176, 166, 128), Color3.fromRGB(118, 110, 82))
			wash.Rotation = 90
			wash.Parent = plate
			local r = entry[2]
			if r then
				local art = picture(plate, r.FishId, {
					BackgroundTransparency = 1,
					Position = UDim2.fromScale(0.15, 0.18),
					Size = UDim2.fromScale(0.7, 0.62),
				}, nil, r)
				local artEdge = art:FindFirstChild("ThemeBorder")
				if artEdge then
					artEdge.Enabled = false
				end
			end
			for _, caption in
				{
					{ if r then richName(r) else "No catch yet", UDim2.fromOffset(8, 4) },
					{ if r then entry[3](r) else "", UDim2.new(0, 8, 1, -28) },
				}
			do
				local label = write(plate, caption[1], 19, {
					Position = caption[2],
					Size = UDim2.new(1, -16, 0, 24),
					RichText = true,
					TextWrapped = false,
					TextTruncate = Enum.TextTruncate.AtEnd,
				}, Color3.new(1, 1, 1))
				label.TextStrokeColor3, label.TextStrokeTransparency = Color3.fromRGB(40, 34, 24), 0.55
			end
		end
	end
	-- Home ▸ Paths: the business road from fish shop to company. Stage rules live in
	-- Shared.Paths; this only draws them from the saved profile.
	local function paths(body, nextOrder)
		local state = Paths.state(profile.Angler)
		local choices = Paths.choices(profile)
		local function auto(class, parent, props)
			props.BackgroundTransparency = props.BackgroundTransparency or 1
			props.AutomaticSize = Enum.AutomaticSize.Y
			return make(class, parent, props)
		end
		local function stack(parent, gap)
			make("UIListLayout", parent, {
				Padding = UDim.new(0, gap),
				SortOrder = Enum.SortOrder.LayoutOrder,
			})
		end
		local function wrapped(parent, value, size, color, layoutOrder, props)
			local item = text(parent, value, size, color, {
				LayoutOrder = layoutOrder,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				TextYAlignment = Enum.TextYAlignment.Top,
			})
			for key, setting in props or {} do
				item[key] = setting
			end
			return item
		end
		local function goalRow(parent, goal, layoutOrder)
			local current, target = Paths.goalProgress(goal, profile)
			local done = current >= target
			local row = make("Frame", parent, {
				Name = "Goal",
				BackgroundTransparency = 1,
				LayoutOrder = layoutOrder,
				Size = UDim2.new(1, 0, 0, 40),
			})
			text(row, (if done then "✓  " else "○  ") .. Paths.goalText(goal), 14, if done then green else cream, {
				Size = UDim2.new(1, -110, 0, 22),
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextWrapped = false,
			})
			local count = if goal.Money
				then "$" .. commas(current) .. " / $" .. commas(target)
				elseif target > 1 then commas(current) .. " / " .. commas(target)
				else (if done then "Done" else "Not yet")
			text(row, count, 12, muted, {
				Position = UDim2.new(1, -108, 0, 2),
				Size = UDim2.fromOffset(108, 20),
				TextXAlignment = Enum.TextXAlignment.Right,
			})
			local track =
				decoration(row, "GoalTrack", Theme.Colors.Inset, UDim2.fromOffset(0, 28), UDim2.new(1, 0, 0, 6))
			Theme.corner(track, 3)
			local fill = decoration(
				track,
				"GoalFill",
				if done then green else gold,
				UDim2.new(),
				UDim2.fromScale(math.clamp(current / target, 0, 1), 1)
			)
			Theme.corner(fill, 3)
		end
		local function stageCard(parent, id, number, layoutOrder, width)
			local stage = Paths.Stages[id]
			local completed = state.Completed[id] == true
			local current = state.Active == id
			local progress = Paths.progress(profile, id)
			local available = table.find(choices, id) ~= nil
			local card = auto("Frame", parent, {
				Name = id .. "Stage",
				BackgroundTransparency = 0,
				BackgroundColor3 = paper,
				LayoutOrder = layoutOrder,
				Size = width or UDim2.new(1, -10, 0, 0),
			})
			make("UIPadding", card, {
				PaddingTop = UDim.new(0, 12),
				PaddingBottom = UDim.new(0, 14),
				PaddingLeft = UDim.new(0, 14),
				PaddingRight = UDim.new(0, 14),
			})
			stack(card, 8)
			local header = make("Frame", card, {
				Name = "Header",
				BackgroundTransparency = 1,
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 48),
			})
			local node = decoration(
				header,
				"StageNode",
				if completed then green elseif current then gold elseif available then cream else Theme.Colors.Inset,
				UDim2.fromOffset(0, 2),
				UDim2.fromOffset(44, 44)
			)
			Theme.corner(node, 22)
			text(
				node,
				if completed then "✓" else tostring(number),
				20,
				if completed or current or available then navy else muted,
				{
					Size = UDim2.fromScale(1, 1),
					TextXAlignment = Enum.TextXAlignment.Center,
					Font = Enum.Font.GothamBold,
				}
			)
			text(header, stage.Name, 19, cream, {
				Position = UDim2.fromOffset(56, 0),
				Size = UDim2.new(1, -150, 0, 26),
				Font = Enum.Font.GothamBold,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextWrapped = false,
			})
			text(header, stage.Tagline, 12, muted, {
				Position = UDim2.fromOffset(56, 26),
				Size = UDim2.new(1, -150, 0, 18),
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextWrapped = false,
			})
			local badge = if completed
				then "Completed"
				elseif current then math.floor(progress * 100) .. "%"
				elseif available then "$" .. commas(stage.Price)
				else "Locked"
			text(
				header,
				badge,
				if current then 22 else 13,
				if completed then green elseif current then gold else muted,
				{
					Position = UDim2.new(1, -92, 0, 6),
					Size = UDim2.fromOffset(92, 30),
					TextXAlignment = Enum.TextXAlignment.Right,
					Font = Enum.Font.GothamBold,
				}
			)
			wrapped(card, stage.Description, 13, muted, 2)
			if current or completed then
				wrapped(card, "Unlocked: " .. table.concat(stage.Features, " · "), 12, cream, 3)
			end
			if current then
				local track = decoration(card, "StageTrack", Theme.Colors.Inset, UDim2.new(), UDim2.new(1, 0, 0, 10))
				track.LayoutOrder = 4
				Theme.corner(track, 5)
				local fill = decoration(
					track,
					"StageFill",
					if progress >= 1 then green else gold,
					UDim2.new(),
					UDim2.fromScale(progress, 1)
				)
				Theme.corner(fill, 5)
				if not completed then
					for index, goal in stage.Goals do
						goalRow(card, goal, 4 + index)
					end
				end
				if not Paths.skipProblem(profile, id) then
					wrapped(card, Paths.skipWarning(profile), 13, gold, 16, { Name = "PathSkipWarning" })
					local confirmation = auto("Frame", card, {
						Name = "PathSkipConfirmation",
						LayoutOrder = 18,
						Size = UDim2.new(1, 0, 0, 0),
						Visible = false,
					})
					stack(confirmation, 8)
					wrapped(confirmation, "Skip all remaining quests for " .. stage.Name .. "?", 13, cream, 1)
					local skip
					skip = button(
						card,
						if state.SkipCredits > 0 then "Use purchased quest skip" else "Skip quests · Robux",
						function()
							confirmation.Visible = true
							skip.Visible = false
						end,
						{
							Name = "SkipPathQuests",
							LayoutOrder = 17,
							Size = UDim2.new(1, 0, 0, 42),
						}
					)
					button(
						confirmation,
						if state.SkipCredits > 0 then "Confirm quest skip" else "Continue · Robux",
						function()
							request("PreparePathSkip", id)
						end,
						{
							Name = "ConfirmPathSkip",
							LayoutOrder = 2,
							Size = UDim2.new(1, 0, 0, 42),
						}
					)
					button(confirmation, "Cancel", function()
						confirmation.Visible = false
						skip.Visible = true
					end, {
						Name = "CancelPathSkip",
						LayoutOrder = 3,
						Size = UDim2.new(1, 0, 0, 36),
					})
				end
				if progress >= 1 and #choices == 0 and Paths.finished(profile) then
					wrapped(card, "Every path is complete. Your business runs on all fronts!", 14, green, 20)
				elseif progress >= 1 then
					wrapped(
						card,
						"Stage complete! Choose your next path below. Its money cost still applies.",
						14,
						green,
						20
					)
				end
			elseif available then
				local afford = profile.Cash >= stage.Price
				local choose = button(
					card,
					if afford
						then "Open " .. stage.Name .. " · $" .. commas(stage.Price)
						else "$" .. commas(stage.Price - profile.Cash) .. " more needed",
					function()
						if afford then
							request("ChoosePath", id)
						end
					end,
					{
						Name = "Choose" .. id,
						LayoutOrder = 20,
						Size = UDim2.new(1, 0, 0, 42),
						Active = afford,
						AutoButtonColor = afford,
						BackgroundColor3 = if afford then gold else navy,
					}
				)
				Theme.glassButton(choose, if afford then "Selected" else "Disabled")
				withIcon(choose, if afford then "Coin" else "Lock", if afford then cream else muted)
				choose.Selectable = afford
			elseif not completed then
				local needs = {}
				for _, required in stage.Requires do
					table.insert(needs, Paths.Stages[required].Name)
				end
				wrapped(card, "Opens after " .. table.concat(needs, " and ") .. " reaches 100%.", 12, muted, 20)
			end
			return card
		end
		local function road(layoutOrder)
			local segment = make("Frame", body, {
				Name = "Road",
				BackgroundTransparency = 1,
				LayoutOrder = layoutOrder,
				Size = UDim2.new(1, -10, 0, 18),
			})
			local strip =
				decoration(segment, "RoadStrip", Theme.Colors.Border, UDim2.fromOffset(34, 0), UDim2.new(0, 4, 1, 0))
			strip.BackgroundTransparency = 0.4
		end

		wrapped(
			body,
			"Grow your business one stage at a time. Stages stack, so everything you unlock keeps working. "
				.. "Reach 100% on your current stage to buy the next one.",
			14,
			muted,
			nextOrder()
		)
		-- The fork after the Supermarket: whichever branch was chosen comes first.
		local first, second = "Restaurant", "Company"
		if state.Unlocked.Company and not state.Unlocked.Restaurant then
			first, second = "Company", "Restaurant"
		end
		local forked = not state.Unlocked.Restaurant and not state.Unlocked.Company
		for index, id in { "Fishshop", "Supermarket" } do
			if index > 1 then
				road(nextOrder())
			end
			stageCard(body, id, index, nextOrder())
		end
		road(nextOrder())
		if forked then
			wrapped(
				body,
				"Choose a branch. The other one opens once your choice reaches 100%.",
				13,
				gold,
				nextOrder(),
				{
					Font = Enum.Font.GothamBold,
				}
			)
			local fork = auto("Frame", body, {
				Name = "PathFork",
				LayoutOrder = nextOrder(),
				Size = UDim2.new(1, -10, 0, 0),
			})
			make("UIListLayout", fork, {
				FillDirection = if narrow then Enum.FillDirection.Vertical else Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 10),
				SortOrder = Enum.SortOrder.LayoutOrder,
			})
			for index, id in { first, second } do
				stageCard(fork, id, 3, index, if narrow then UDim2.new(1, 0, 0, 0) else UDim2.new(0.5, -5, 0, 0))
			end
		else
			stageCard(body, first, 3, nextOrder())
			road(nextOrder())
			stageCard(body, second, 4, nextOrder())
		end
	end
	local function home()
		-- Cash sits in its own inset badge, apart from the clickable tabs below it.
		local wallet = make("Frame", content, {
			Name = "CashBadge",
			BackgroundColor3 = paper,
			Size = UDim2.fromOffset(if narrow then 200 else 210, 54),
		})
		Theme.glassPanel(wallet, true)
		glyph(wallet, "Coin", green, UDim2.fromOffset(26, 27), 26)
		text(
			wallet,
			"AVAILABLE CASH",
			11,
			muted,
			{ Position = UDim2.fromOffset(48, 6), Size = UDim2.new(1, -54, 0, 16) }
		)
		text(wallet, "$" .. commas(profile.Cash), 22, cream, {
			Position = UDim2.fromOffset(48, 22),
			Size = UDim2.new(1, -54, 0, 26),
			Font = Enum.Font.GothamBold,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextWrapped = false,
		})
		local tabNames = { "Paths", "Staff", "Upgrades", "Overview", "Achievements" }
		local tabRows = math.ceil(#tabNames / 2)
		local tabs = make("Frame", content, {
			Name = "HomeTabs",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, 66),
			Size = if narrow then UDim2.new(1, 0, 0, tabRows * 48) else UDim2.new(0, 210, 1, -66),
		})
		for index, name in tabNames do
			tabButton(tabs, if name == "Staff" then "Workers" else name, name, homeTab == name, narrow, function()
				homeTab = name
				render()
			end, {
				Name = name .. "Tab",
				TextSize = if narrow then 13 else 17,
				Position = if narrow
					then UDim2.new((index - 1) % 2 / 2, 0, 0, math.floor((index - 1) / 2) * 48)
					else UDim2.fromOffset(0, (index - 1) * 62),
				Size = if narrow then UDim2.new(0.5, -4, 0, 42) else UDim2.new(1, -10, 0, 52),
			})
		end
		local bodyTop = 66 + tabRows * 48 + 10
		local body = scroll(content, {
			Name = "HomeBody",
			Position = if narrow then UDim2.fromOffset(0, bodyTop) else UDim2.fromOffset(226, 0),
			Size = if narrow then UDim2.new(1, 0, 1, -bodyTop) else UDim2.new(1, -226, 1, 0),
		})
		list(body, 12)
		-- Room for the raised buttons' drop shadows and outlines inside the scroll clip.
		make("UIPadding", body, {
			PaddingTop = UDim.new(0, 2),
			PaddingBottom = UDim.new(0, 12),
			PaddingLeft = UDim.new(0, 2),
		})
		local order = 0
		local function line(value, size, color, height)
			order += 1
			return text(body, value, size, color, {
				LayoutOrder = order,
				Size = UDim2.new(1, -10, 0, height or 32),
			})
		end
		order += 1
		iconTitle(
			body,
			homeTab,
			if homeTab == "Staff" then "Manage Workers" else homeTab,
			24,
			cream,
			{ LayoutOrder = order, Size = UDim2.new(1, -10, 0, 40) }
		)
		if homeTab == "Paths" then
			paths(body, function()
				order += 1
				return order
			end)
		elseif homeTab == "Staff" then
			local hiredCount, visibleRoles = 0, {}
			for _, id in StaffCatalog.Order do
				local hired = profile.Angler.Staff and profile.Angler.Staff[id] == true
				if hired then
					hiredCount += 1
				end
				if
					staffFilter == "All"
					or (staffFilter == "Hired" and hired)
					or (staffFilter == "For hire" and not hired)
				then
					table.insert(visibleRoles, id)
				end
			end
			if not table.find(visibleRoles, selectedStaff) then
				selectedStaff = visibleRoles[1]
			end
			order += 1
			local toolbar = make("Frame", body, {
				Name = "WorkerToolbar",
				BackgroundTransparency = 1,
				LayoutOrder = order,
				Size = UDim2.new(1, -14, 0, 58),
			})
			text(toolbar, string.format("Your crew · %d/%d hired", hiredCount, #StaffCatalog.Order), 13, cream, {
				Size = UDim2.new(1, -142, 0, 32),
			})
			local filter = button(toolbar, staffFilter, function()
				staffFilter = if staffFilter == "All"
					then "Hired"
					elseif staffFilter == "Hired" then "For hire"
					else "All"
				render()
			end, {
				Name = "WorkerFilter",
				Position = UDim2.new(1, -132, 0, 0),
				Size = UDim2.fromOffset(132, 32),
				TextSize = 13,
			})
			withIcon(filter, "Filter", cream, 16)
			text(toolbar, "Select a worker to manage your crew.", 12, muted, {
				Position = UDim2.fromOffset(0, 38),
				Size = UDim2.new(1, 0, 0, 20),
			})
			order += 1
			local grid = make("Frame", body, {
				Name = "WorkerGrid",
				BackgroundTransparency = 1,
				LayoutOrder = order,
				Size = UDim2.new(1, -16, 0, 264),
				Visible = #visibleRoles > 0,
			})
			local layout = make("UIGridLayout", grid, {
				Name = "WorkerCards",
				CellPadding = UDim2.fromOffset(10, 10),
				SortOrder = Enum.SortOrder.LayoutOrder,
			})
			local function fitGrid()
				local width = math.max(1, grid.AbsoluteSize.X)
				local columns = math.clamp(math.floor((width + 10) / 148), 1, 5)
				local cellWidth = math.max(1, math.floor((width - (columns - 1) * 10) / columns))
				local height = math.clamp(math.floor(cellWidth * 1.3), 220, 280)
				layout.CellSize = UDim2.fromOffset(cellWidth, height)
				layout.FillDirectionMaxCells = columns
				grid.Size = UDim2.new(1, -16, 0, math.max(0, math.ceil(#visibleRoles / columns) * (height + 10) - 10))
			end
			grid:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitGrid)
			fitGrid()
			order += 1
			local details = make("Frame", body, {
				Name = "WorkerDetails",
				BackgroundColor3 = paper,
				LayoutOrder = order,
				Size = UDim2.new(1, -16, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
			})
			local cards = {}
			local function showDetails()
				for id, workerCard in cards do
					local selected = id == selectedStaff
					workerCard.ThemeBorder.Color = if selected then gold else Theme.Colors.Border
					workerCard.ThemeBorder.Transparency = if selected then 0 else 0.65
					workerCard.ThemeBorder.Thickness = if selected then 2 else 1
					workerCard.SelectionAccent.Visible = selected
				end
				details:ClearAllChildren()
				make("UIPadding", details, {
					PaddingTop = UDim.new(0, 14),
					PaddingBottom = UDim.new(0, 14),
					PaddingLeft = UDim.new(0, 14),
					PaddingRight = UDim.new(0, 14),
				})
				list(details, 8)
				-- Recreate the panel border after clearing the previous worker's controls.
				Theme.glassPanel(details, true)
				if not selectedStaff then
					text(details, "No workers in this filter.", 15, muted, { LayoutOrder = 1 })
					return
				end
				local role = StaffCatalog.Roles[selectedStaff]
				local hired = profile.Angler.Staff and profile.Angler.Staff[selectedStaff] == true
				iconTitle(
					details,
					"Staff",
					role.Name .. (if hired then " · Hired" else " · Job details"),
					18,
					cream,
					{
						LayoutOrder = 1,
						Size = UDim2.new(1, 0, 0, 30),
					}
				)
				text(details, role.Description, 13, muted, {
					LayoutOrder = 2,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
				})
				local locked = role.Requires ~= nil and not Paths.unlocked(profile, role.Requires)
				local status = if locked
					then "Unlocks with " .. Paths.Stages[role.Requires].Name .. " (Paths tab)"
					elseif not hired and profile.Cash < role.Price then "$"
						.. commas(role.Price - profile.Cash)
						.. " more needed"
					elseif not hired then "Select Hire on the card to add this worker to your crew."
					elseif selectedStaff == "Fisherman" then "Choose the boat he takes out:"
					elseif selectedStaff == "RestaurantChef" or selectedStaff == "CompanyChef" then
						"Choose a recipe for this chef."
					else "No daily wages. Returns whenever you join."
				text(details, status, 12, if locked then gold else muted, {
					LayoutOrder = 3,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
				})
				if selectedStaff == "Porter" then
					local level = StaffCatalog.workerLevel(profile.Angler, "Porter")
					local price = StaffCatalog.PorterLevelPrices[level]
					text(details, "Level " .. level .. " / 4 · " .. (if level == 1 then "Carries 3 fish" elseif level == 2 then "Collects crab cages" elseif level == 3 then "Collects crab cages and mussel nets" else "Places stored cages and nets"), 14, cream, { LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 35) })
					if price then
						text(details, if level == 1 then "Next: collect crab cages for sale" elseif level == 2 then "Next: collect mussel nets for sale" else "Next: place equipment from tools racks", 13, muted, { LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 30) })
					end
					local canUpgrade = hired and price ~= nil and profile.Cash >= price
					local upgrade = button(details, if not hired then "Hire a porter first" elseif not price then "Maximum level" elseif profile.Cash < price then "$" .. commas(price - profile.Cash) .. " more needed" else "Upgrade to level " .. (level + 1) .. " · $" .. commas(price), function()
						if canUpgrade then request("UpgradeWorker", "Porter", level) end
					end, { Name = "UpgradePorterLevel", LayoutOrder = 6, Size = UDim2.new(1, 0, 0, 40), TextSize = 13, Active = canUpgrade, Selectable = canUpgrade })
					Theme.glassButton(upgrade, if canUpgrade then "Selected" else "Disabled")
				end
				if hired and selectedStaff == "Fisherman" then
					local boats = {}
					for boatId in BoatCatalog do
						if profile.OwnedBoats[boatId] then
							table.insert(boats, boatId)
						end
					end
					table.sort(boats, function(a, b)
						return BoatCatalog[a].Price < BoatCatalog[b].Price
					end)
					if #boats == 0 then
						text(details, "Claim a free rowboat at the drydock first.", 13, gold, { LayoutOrder = 4 })
					end
					for index, boatId in boats do
						local chosen = profile.Angler.FishermanBoat == boatId
						local pick = button(
							details,
							BoatCatalog[boatId].Name .. (if chosen then " · Assigned" else " · Assign boat"),
							function()
								if not chosen then
									request("AssignBoat", boatId)
								end
							end,
							{
								Name = "Assign" .. boatId,
								LayoutOrder = index + 3,
								Size = UDim2.new(1, 0, 0, 40),
								TextSize = 13,
							}
						)
						Theme.glassButton(pick, if chosen then "Selected" else "Normal")
						withIcon(pick, if chosen then "Check" else "Equipmentbag", cream, 16)
					end
				end
				if hired and (selectedStaff == "RestaurantChef" or selectedStaff == "CompanyChef") then
					local selectedRecipe = (profile.Angler.ChefRecipes or {})[selectedStaff]
					text(
						details,
						"Uses fish from kitchen storage and the required station. Dishes go to the shared kitchen pass for supermarket customers and, when unlocked, restaurant diners.",
						12,
						muted,
						{ LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }
					)
					local paused = not selectedRecipe or selectedRecipe == ""
					local pause = button(details, if paused then "Paused" else "Pause cooking", function()
						if not paused then
							request("SetChefRecipe", selectedStaff, "")
						end
					end, {
						Name = "PauseChef",
						LayoutOrder = 5,
						Size = UDim2.new(1, 0, 0, 40),
						TextSize = 13,
					})
					Theme.glassButton(pause, if paused then "Selected" else "Normal")
					for index, recipeId in Recipes.Order do
						local recipe = Recipes.Items[recipeId]
						local chosen = selectedRecipe == recipeId
						local station = Recipes.Stations[recipe.Station].Name
						local pick = button(
							details,
							string.format(
								"%s · %s · %s+%s",
								recipe.Name,
								station,
								recipe.MinRarity,
								if chosen then " · Assigned" else ""
							),
							function()
								if not chosen then
									request("SetChefRecipe", selectedStaff, recipeId)
								end
							end,
							{
								Name = "ChefRecipe" .. recipeId,
								LayoutOrder = index + 5,
								Size = UDim2.new(1, 0, 0, 40),
								TextSize = 13,
							}
						)
						Theme.glassButton(pick, if chosen then "Selected" else "Normal")
					end
				end
			end
			for index, id in visibleRoles do
				local role = StaffCatalog.Roles[id]
				local hired = profile.Angler.Staff and profile.Angler.Staff[id] == true
				local locked = role.Requires ~= nil and not Paths.unlocked(profile, role.Requires)
				local enabled = not hired and not locked and profile.Cash >= role.Price
				local workerCard = make("Frame", grid, {
					Name = id .. "Staff",
					BackgroundColor3 = paper,
					LayoutOrder = index,
				})
				workerCard.BackgroundColor3 = Color3.fromRGB(250, 248, 242)
				Theme.corner(workerCard, 6)
				cards[id] = workerCard
				local accent =
					decoration(workerCard, "SelectionAccent", gold, UDim2.fromOffset(8, 0), UDim2.new(1, -16, 0, 3))
				Theme.corner(accent, 2)
				local portrait = make("Frame", workerCard, {
					Name = id .. "Portrait",
					BackgroundTransparency = 1,
					Position = UDim2.fromOffset(1, 4),
					Size = UDim2.new(1, -2, 1, -70),
					ClipsDescendants = true,
				})
				local view = make("ViewportFrame", portrait, {
					Name = id .. "Preview",
					BackgroundTransparency = 1,
					Size = UDim2.fromScale(1, 1),
				})
				local loading = text(portrait, "Loading preview…", 12, muted, {
					Name = "PreviewStatus",
					Position = UDim2.fromOffset(8, 8),
					Size = UDim2.new(1, -16, 1, -16),
					TextXAlignment = Enum.TextXAlignment.Center,
					ZIndex = 2,
				})
				StaffPreview.show(view, id, loading, true)
				local fade = decoration(
					portrait,
					"PortraitFade",
					Color3.fromRGB(250, 248, 242),
					UDim2.new(0, 0, 1, -44),
					UDim2.new(1, 0, 0, 44)
				)
				fade.ZIndex = 2
				make("UIGradient", fade, {
					Rotation = 90,
					Transparency = NumberSequence.new({
						NumberSequenceKeypoint.new(0, 1),
						NumberSequenceKeypoint.new(1, 0.15),
					}),
				})
				local badge = decoration(
					workerCard,
					"RoleBadge",
					Theme.Colors.Inset,
					UDim2.new(1, -36, 0, 10),
					UDim2.fromOffset(26, 26)
				)
				Theme.corner(badge, 5)
				glyph(
					badge,
					if id == "Seller" then "Coin" elseif id == "Porter" then "Equipmentbag" else "Fish",
					cream,
					UDim2.fromOffset(13, 13),
					16
				)
				text(
					workerCard,
					if hired then "HIRED" elseif locked then "LOCKED" else "FOR HIRE",
					10,
					if hired then green else muted,
					{
						Position = UDim2.fromOffset(10, 12),
						Size = UDim2.new(1, -50, 0, 20),
					}
				)
				text(workerCard, role.Name, 18, Color3.fromRGB(80, 70, 62), {
					Name = "WorkerName",
					Position = UDim2.new(0, 6, 1, -76),
					Size = UDim2.new(1, -12, 0, 26),
					TextXAlignment = Enum.TextXAlignment.Center,
					TextScaled = true,
				})
				workerCard.WorkerName.TextColor3 = Color3.fromRGB(80, 70, 62)
				workerCard.WorkerName.TextStrokeTransparency = 1
				make("UITextSizeConstraint", workerCard.WorkerName, { MinTextSize = 12, MaxTextSize = 18 })
				-- A transparent native button keeps the entire portrait keyboard/touch selectable.
				local select = Instance.new("TextButton")
				select.Name, select.Text, select.BackgroundTransparency = "Select" .. id, "", 1
				select.Size, select.ZIndex, select.Parent = UDim2.new(1, 0, 1, -48), 4, workerCard
				select.Activated:Connect(function()
					selectedStaff = id
					showDetails()
				end)
				local actions = make("Frame", workerCard, {
					Name = "WorkerActions", BackgroundColor3 = Color3.fromRGB(43, 133, 218),
					Position = UDim2.new(0, 5, 1, -44), Size = UDim2.new(1, -10, 0, 36),
					ZIndex = 5, ClipsDescendants = true,
				})
				Theme.corner(actions, 6)
				actions.BackgroundColor3 = Color3.fromRGB(43, 133, 218)
				local label = text(actions, if hired then "Lv " .. StaffCatalog.workerLevel(profile.Angler, id) .. " " .. role.Name else if locked then "Locked" else "Hire · $" .. commas(role.Price), 13, Color3.new(1, 1, 1), { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 6 })
				local hire = button(actions, if hired then "Fire" else if locked then "Locked" else "Hire · $" .. commas(role.Price), function()
					if hired then request("FireStaff", id) elseif enabled then request("HireStaff", id) end
				end, { Name = "Hire" .. id, Size = if hired and id == "Porter" then UDim2.fromScale(0.5, 1) else UDim2.fromScale(1, 1), TextSize = 12, ZIndex = 7, Visible = false, Active = hired or enabled })
				Theme.glassButton(hire, if hired or enabled then "Selected" else "Disabled")
				local upgrade
				if hired and id == "Porter" then
					label.Size = UDim2.fromScale(0.5, 1)
					local level = StaffCatalog.workerLevel(profile.Angler, id)
					local price = StaffCatalog.PorterLevelPrices[level]
					upgrade = button(actions, if price then "Upgrade $" .. commas(price) else "Max level", function()
						if price and profile.Cash >= price then request("UpgradeWorker", id, level) end
					end, { Name = "UpgradeWorkerPorter", Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromScale(0.5, 1), TextSize = 11, ZIndex = 7, Visible = true, Active = price ~= nil and profile.Cash >= price })
					Theme.glassButton(upgrade, if price and profile.Cash >= price then "Selected" else "Disabled")
				end
				local function revealActions(show)
					label.Visible = not show
					hire.Visible = show
				end
				workerCard.MouseEnter:Connect(function() revealActions(true) end)
				workerCard.MouseLeave:Connect(function() revealActions(false) end)
				select.Activated:Connect(function() revealActions(true) end)
			end
			showDetails()
		elseif homeTab == "Overview" then
			line("SHOP SIGN", 16, gold, 26)
			line("Choose a name for the sign above your shop. Leave it blank to restore the default.", 14, muted, 42)
			order += 1
			local signName = input(body, "Your shop name (up to 32 characters)")
			signName.Name = "ShopSignInput"
			signName.LayoutOrder = order
			signName.Size = UDim2.new(1, -10, 0, 42)
			signName.Text = profile.Angler.ShopSign or ""
			order += 1
			button(body, "Save shop sign", function()
				request("ShopSign", signName.Text)
			end, { Name = "SaveShopSign", LayoutOrder = order, Size = UDim2.new(1, -10, 0, 44) })
			local stock, totalValue = {}, 0
			local function add(records, location)
				for _, record in records do
					table.insert(stock, { Record = record, Location = location })
					totalValue += math.max(1, math.floor(record.Value))
				end
			end
			local data = profile.Angler
			add(data.Freezer, "Freezer · Ready to sell")
			add(data.Storage or {}, "Storage rack")

			if data.Hand then
				add({ data.Hand }, "In hand")
			end
			local packedFish = {}
			for _, item in data.Backpack or {} do
				table.insert(packedFish, item.Fish)
			end
			add(packedFish, "Backpack")
			add(data.Cooler, "Legacy cooler")
			local boats = {}
			for id in data.Holds do
				table.insert(boats, id)
			end
			table.sort(boats)
			for _, id in boats do
				local fish = {}
				for _, item in data.Holds[id] do
					if item.Fish then
						table.insert(fish, item.Fish)
					end
				end
				add(fish, (BoatCatalog[id] and BoatCatalog[id].Name or id) .. " · Cargo hold")
			end
			line(string.format("%d fish in stock · $%s total value", #stock, commas(totalValue)), 16, gold, 44)
			line(
				string.format(
					"Freezer %d fish · %d%% space used · %d fish waiting to be stocked",
					#data.Freezer,
					freezerUsage,
					#stock - #data.Freezer
				),
				14,
				muted,
				44
			)
			if Paths.unlocked(profile, "Supermarket") then
				local dishValue = 0
				for _, dish in data.Pantry or {} do
					dishValue += math.floor(dish.Value)
				end
				local cooking = 0
				for _ in data.Kitchen or {} do
					cooking += 1
				end
				line(
					string.format(
						"Kitchen pass %d/%d dishes · $%s · %d cooking",
						#(data.Pantry or {}),
						pantryCapacity,
						commas(dishValue),
						cooking
					),
					14,
					muted,
					30
				)
				for _, dish in data.Pantry or {} do
					local recipe = Recipes.Items[dish.RecipeId]
					line(
						string.format(
							"%s · $%s",
							if recipe then recipe.Name else dish.RecipeId,
							commas(math.floor(dish.Value))
						),
						14,
						cream,
						26
					)
				end
			end
			if #stock == 0 then
				line("No fish in stock yet. Bring your next catch home to fill the freezer.", 16, muted, 80)
			end
			for _, item in stock do
				local record = item.Record
				order += 1
				local stockCard = make("Frame", body, {
					Name = "StockItem",
					BackgroundColor3 = paper,
					Size = UDim2.new(1, -10, 0, 108),
					LayoutOrder = order,
				})
				local tile = make("Frame", stockCard, {
					Name = "FishTile",
					BackgroundColor3 = paper,
					Position = UDim2.fromOffset(12, 12),
					Size = UDim2.fromOffset(84, 84),
				})
				Theme.glassPanel(tile, true)
				glyph(tile, "Fish", cream, UDim2.fromScale(0.5, 0.5), 40)
				text(stockCard, fishName(record), 17, cream, {
					Position = UDim2.fromOffset(110, 10),
					Size = UDim2.new(1, -124, 0, 28),
					RichText = true,
				})
				text(
					stockCard,
					string.format("%.2f kg · $%s", record.Kg, commas(math.max(1, math.floor(record.Value)))),
					14,
					cream,
					{
						Position = UDim2.fromOffset(110, 42),
						Size = UDim2.new(1, -124, 0, 24),
					}
				)
				text(stockCard, item.Location, 12, muted, {
					Position = UDim2.fromOffset(110, 72),
					Size = UDim2.new(1, -124, 0, 26),
				})
			end
		elseif homeTab == "Upgrades" then
			for _, upgradeId in { "SocialMediaAdvertisement", "Baskets" } do
				local upgrade = ShopUpgrades[upgradeId]
				local owned = (profile.Angler.Upgrades[upgradeId] or 0) >= 1
				local enabled = not owned and profile.Cash >= upgrade.Price
				line(upgrade.Name, 18, cream, 36)
				line(upgrade.Description, 14, muted, 48)
				if upgradeId == "SocialMediaAdvertisement" then
					line("Two customers every 35 seconds, spaced apart.", 14, muted, 36)
				end
				order += 1
				local buy = button(
					body,
					if owned
						then "Owned"
						elseif not enabled then "$" .. commas(upgrade.Price - profile.Cash) .. " more needed"
						else "Buy · $" .. commas(upgrade.Price),
					function()
						if enabled then
							request("BuyShopUpgrade", upgradeId)
						end
					end,
					{
						Name = "Buy" .. upgradeId,
						LayoutOrder = order,
						Size = UDim2.new(1, -16, 0, 44),
						TextSize = 14,
						Active = enabled,
						Selectable = enabled,
					}
				)
				Theme.glassButton(buy, if enabled then "Selected" else "Disabled")
			end
		else
			order += 1
			local placeholder = make("Frame", body, {
				Name = "EmptyIcon",
				BackgroundColor3 = paper,
				LayoutOrder = order,
				Size = UDim2.fromOffset(96, 96),
			})
			Theme.glassPanel(placeholder, true)
			glyph(placeholder, homeTab, muted, UDim2.fromScale(0.5, 0.5), 48)
			line("No achievements yet.", 18, muted, 56)
			line("Your future milestones will appear here.", 14, muted, 56)
		end
	end
	local function settings()
		local function settingsOutline(item)
			item.ThemeBorder.Color = Color3.fromRGB(122, 122, 122)
			item.ThemeBorder.Transparency = 0.35
			item.ThemeBorder.Thickness = 1
		end
		local function settingsButton(parent, value, callback, props)
			local item = button(parent, value, callback, props)
			if not (props and props.Size) then
				item.Size = UDim2.new(1, -8, 0, 44)
			end
			return item
		end
		local tabs = make(
			"Frame",
			content,
			{ BackgroundTransparency = 1, Size = if narrow then UDim2.new(1, 0, 0, 48) else UDim2.new(0, 210, 1, 0) }
		)
		for i, name in { "Performance", "Audio", "Codes", "Titles" } do
			tabButton(tabs, name, name, settingTab == name, narrow, function()
				settingTab = name
				render()
			end, {
				Name = name .. "Tab",
				TextSize = if narrow then 12 else 17,
				-- Keep the full stroke and drop shadow inside Content's clipping boundary on both layouts.
				Position = if narrow then UDim2.new((i - 1) / 4, 2, 0, 2) else UDim2.fromOffset(2, (i - 1) * 62 + 2),
				Size = if narrow then UDim2.new(0.25, -4, 0, 40) else UDim2.new(1, -12, 0, 52),
			})
		end
		local body = scroll(content, {
			Position = if narrow then UDim2.fromOffset(0, 56) else UDim2.fromOffset(226, 0),
			Size = if narrow then UDim2.new(1, 0, 1, -56) else UDim2.new(1, -226, 1, 0),
		})
		-- Leave room for the outlines and drop shadows along the scrolling area's edges.
		make("UIPadding", body, {
			PaddingLeft = UDim.new(0, 2),
			PaddingRight = UDim.new(0, 2),
			PaddingTop = UDim.new(0, 2),
			PaddingBottom = UDim.new(0, 6),
		})
		list(body, 12)
		iconTitle(body, settingTab, settingTab, 24, cream, { Size = UDim2.new(1, -8, 0, 42), LayoutOrder = 0 })
		local function settingRow(key, name, description, iconName)
			local value = if key == "Freecam" then player:GetAttribute("FreecamEnabled") == true else profile.Angler.Settings[key]
			-- FrameRateGuard can lower the preset after the profile loaded; show what is in use.
			local live = if key == "Freecam" then nil else Settings.current(key)
			if live ~= nil then
				value = live
			end
			local row = make("Frame", body, {
				Name = key .. "Row",
				BackgroundColor3 = Theme.Colors.Panel,
				BorderSizePixel = 0,
				Size = UDim2.new(1, -8, 0, 116),
				LayoutOrder = 1,
			})
			round(row)
			settingsOutline(row)
			local badge = make("Frame", row, {
				Name = "SettingIcon",
				BackgroundColor3 = paper,
				Position = UDim2.fromOffset(14, 14),
				Size = UDim2.fromOffset(40, 40),
			})
			Theme.glassPanel(badge, true)
			glyph(badge, iconName, cream, UDim2.fromScale(0.5, 0.5), 22)
			text(
				row,
				name,
				18,
				cream,
				{ Position = UDim2.fromOffset(66, 10), Size = UDim2.new(1, -80, 0, 26), Font = Enum.Font.GothamBold }
			)
			text(row, description, 13, muted, { Position = UDim2.fromOffset(66, 36), Size = UDim2.new(1, -80, 0, 34) })
			if type(value) == "boolean" then
				-- A sliding switch: blue with the knob right when on, flat with the knob left when off.
				local switch = settingsButton(row, if value then "On" else "Off", function()
					if key == "Freecam" then
						Freecam.setEnabled(not value)
					else
						request("Setting", key, not value)
					end
				end, {
					Name = key,
					Position = UDim2.new(1, -108, 1, -46),
					Size = UDim2.fromOffset(92, 34),
					BackgroundColor3 = if value then gold else navy,
				})
				Theme.corner(switch, 17)
				Theme.corner(switch.ThemeFace, 17)
				Theme.corner(switch.ThemeDrop, 17)
				local knob = decoration(
					switch.ThemeFace,
					"Knob",
					cream,
					UDim2.new(if value then 1 else 0, if value then -4 else 4, 0.5, 0),
					UDim2.fromOffset(26, 26)
				)
				knob.AnchorPoint = Vector2.new(if value then 1 else 0, 0.5)
				Theme.corner(knob, 13)
				switch.ThemeCaption.Position = UDim2.fromOffset(if value then 8 else 34, 2)
				switch.ThemeCaption.Size = UDim2.new(1, -42, 1, -4)
			else
				-- Level bar plus step buttons, so the value is visible at a glance.
				local track = decoration(
					row,
					"LevelTrack",
					Theme.Colors.Inset,
					UDim2.new(0, 14, 1, -29),
					UDim2.new(1, -230, 0, 8)
				)
				Theme.corner(track, 4)
				local fill =
					decoration(track, "LevelFill", gold, UDim2.new(), UDim2.fromScale(math.clamp(value / 100, 0, 1), 1))
				Theme.corner(fill, 4)
				settingsButton(
					row,
					"−",
					function()
						request("Setting", key, math.max(0, value - 10))
					end,
					{
						Name = key .. "Down",
						Position = UDim2.new(1, -196, 1, -46),
						Size = UDim2.fromOffset(44, 34),
						TextSize = 22,
					}
				)
				text(row, value .. "%", 16, cream, {
					Position = UDim2.new(1, -148, 1, -46),
					Size = UDim2.fromOffset(84, 34),
					TextXAlignment = Enum.TextXAlignment.Center,
				})
				settingsButton(
					row,
					"+",
					function()
						request("Setting", key, math.min(100, value + 10))
					end,
					{
						Name = key .. "Up",
						Position = UDim2.new(1, -60, 1, -46),
						Size = UDim2.fromOffset(44, 34),
						TextSize = 22,
					}
				)
			end
		end
		if settingTab == "Performance" then
			text(body, Settings.description(), 13, muted, { Size = UDim2.new(1, -8, 0, 48), LayoutOrder = 0 })
			settingRow("Freecam", "Free camera", "Shift+P: toggle. WASD: move, Q/E: down/up, right-drag: look. Touch: use buttons and drag.", "Settings")
			settingRow("Shadows", "Shadows", "Disable global shadows to reduce graphics work.", "Shadows")
			settingRow(
				"WeatherEffects",
				"Weather effects",
				"Show rain, wind particles, and lightning flashes.",
				"Weather"
			)
			settingRow(
				"BackpackAnimation",
				"Backpack animation",
				"Animate Black Hole Backpacks: spinning accretion disk, fish falling in and stardust. Off by default on phones.",
				"Equipmentbag"
			)
		elseif settingTab == "Audio" then
			settingRow("MasterVolume", "Master volume", "Overall game audio.", "Audio")
			settingRow("MusicVolume", "Music", "Volume for music tracks.", "Music")
			settingRow("EffectsVolume", "Sound effects", "Weather and other game sound effects.", "Effects")
		elseif settingTab == "Codes" then
			text(
				body,
				"Enter a code to claim its reward. There are no active codes yet.",
				15,
				muted,
				{ Size = UDim2.new(1, -8, 0, 46) }
			)
			local field = input(body, "Enter code…")
			field.Name = "CodeInput"
			field.Size = UDim2.new(1, -8, 0, 42)
			settingsOutline(field)
			withIcon(
				settingsButton(body, "Redeem code", function()
					request("Code", field.Text)
				end, { BackgroundColor3 = gold }),
				"Codes"
			)
		elseif settingTab == "Titles" then
			text(body, "Choose a title you have unlocked.", 15, muted, { Size = UDim2.new(1, -8, 0, 40) })
			-- The equipped choice is the blue one, with a tick; every other row is a plain option.
			local function titleButton(value, chosen, callback)
				local item = settingsButton(body, value, callback, { BackgroundColor3 = if chosen then gold else navy })
				item.TextXAlignment = Enum.TextXAlignment.Left
				withIcon(item, if chosen then "Check" else "Titles", if chosen then cream else muted)
			end
			titleButton(
				if profile.Angler.EquippedTitle == "" then "No title · Selected" else "Remove title",
				profile.Angler.EquippedTitle == "",
				function()
					request("Title", "")
				end
			)
			local unlocked = 0
			for id, owned in profile.Angler.Titles do
				local title = Catalog.Titles[id]
				if owned and title then
					unlocked += 1
					titleButton(
						title.Name .. (if profile.Angler.EquippedTitle == id then " · Selected" else ""),
						profile.Angler.EquippedTitle == id,
						function()
							request("Title", id)
						end
					)
				end
			end
			if unlocked == 0 then
				text(body, "No titles unlocked yet.", 16, muted, { Size = UDim2.new(1, -8, 0, 60) })
			end
		end
	end
	-- Robux shop: Featured / Gamepasses tabs over big art-forward banner cards.
	-- Banner art is built from plain frames (gradients, strokes, sparkles) so it
	-- needs no uploaded images and stays sharp on every screen.
	local shopTab = "Featured"
	local shopViews = {}
	local ShopProducts = {
		{
			Key = "BlackHoleBackpack",
			Name = "Black Hole Backpack",
			New = true,
			Perks = { "Infinite fish storage", "Spinning accretion disk", "Fish fall right in" },
			Colors = { Color3.fromRGB(34, 8, 66), Color3.fromRGB(150, 40, 175), Color3.fromRGB(40, 175, 225) },
			Accent = Color3.fromRGB(205, 140, 255),
			Description = "A captive singularity strapped to your back. Infinite fish storage: your backpack never fills up, so you can keep fishing all day. Animated accretion disk and infalling fish (toggle in Settings > Performance).",
		},
		{
			Key = "BoatCustomization",
			Name = "Boat Customization",
			New = true,
			Perks = { "30 pieces of boat furniture", "Place them anywhere on deck", "Bought at the drydock" },
			Colors = { Color3.fromRGB(20, 54, 92), Color3.fromRGB(36, 128, 150), Color3.fromRGB(240, 176, 84) },
			Accent = Color3.fromRGB(255, 205, 120),
			Description = "Turn your boat into your own. Buy deck chairs, lanterns, palms, a hot tub and more at the drydock refit dock, then place them freely on your decks. Furniture is bought with in-game cash and moves between your boats.",
		},
		{
			Key = "AutoStore",
			Name = "Auto Store",
			Perks = { "Auto-stores your catches", "Toggle in Inventory", "Works aboard your ship" },
			Colors = { Color3.fromRGB(8, 70, 96), Color3.fromRGB(30, 140, 190), Color3.fromRGB(110, 225, 195) },
			Accent = Color3.fromRGB(120, 235, 210),
			Description = "Automatically stores caught fish in your ship's inventory while you are aboard your own ship. Toggle Auto Store in Inventory. Fish keep their space cost; if the boat is full, the fish stays in your hand.",
		},
		{
			Key = "DoubleXP",
			Name = "2x XP",
			Perks = { "Double XP every catch", "Crab cages & mussel nets", "Trawler net too" },
			Colors = { Color3.fromRGB(250, 150, 40), Color3.fromRGB(230, 80, 160), Color3.fromRGB(115, 90, 235) },
			Accent = Color3.fromRGB(255, 215, 120),
			Description = "Earn double XP from every catch, including crab cages, mussel nets and the trawler net.",
		},
	}
	-- Unthemed instance: the banners own their colours instead of the glass finish.
	local function raw(class, parent, props)
		local item = Instance.new(class)
		for key, value in props do
			item[key] = value
		end
		item.Parent = parent
		return item
	end
	local function gradient(parent, colors, rotation)
		local keys = {}
		for index, color in colors do
			table.insert(keys, ColorSequenceKeypoint.new((index - 1) / math.max(#colors - 1, 1), color))
		end
		return raw("UIGradient", parent, { Color = ColorSequence.new(keys), Rotation = rotation or 0 })
	end
	local function outline(parent, color, thickness)
		return raw("UIStroke", parent, {
			Color = color,
			Thickness = thickness or 2,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		})
	end
	local function corner(parent, radius)
		return raw("UICorner", parent, { CornerRadius = UDim.new(0, radius or 6) })
	end
	-- Chunky outlined display text, like a sticker on the banner.
	local function display(parent, value, size, color, props)
		local item = raw("TextLabel", parent, {
			BackgroundTransparency = 1,
			Text = value,
			TextSize = size,
			Font = Enum.Font.FredokaOne,
			TextColor3 = color or Color3.new(1, 1, 1),
			TextStrokeColor3 = Color3.fromRGB(20, 10, 30),
			TextStrokeTransparency = 0,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Right,
		})
		for key, value2 in props or {} do
			item[key] = value2
		end
		return item
	end
	-- Four-point star: two long rays and two short diagonal ones.
	local function sparkle(parent, position, size, transparency)
		for _, ray in { { 0, 1 }, { 90, 1 }, { 45, 0.55 }, { 135, 0.55 } } do
			local part = raw("Frame", parent, {
				Name = "Sparkle",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = transparency or 0.1,
				BorderSizePixel = 0,
				Position = position,
				Rotation = ray[1],
				Size = UDim2.fromOffset(size * ray[2], math.max(2, size / 6)),
				ZIndex = 3,
			})
			corner(part, size)
		end
	end
	local function badge(parent, value, color, position)
		local tag = raw("Frame", parent, {
			Name = "Badge",
			BackgroundColor3 = Color3.fromRGB(28, 20, 10),
			BackgroundTransparency = 0.15,
			Position = position,
			Size = UDim2.fromOffset(120, 40),
			ZIndex = 4,
		})
		corner(tag, 4)
		outline(tag, color, 2)
		display(tag, value, 18, color, {
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Center,
			Font = Enum.Font.GothamBold,
			TextStrokeTransparency = 1,
			ZIndex = 5,
		})
		return tag
	end
	local function art(parent, pass, owned, size)
		if pass.Key == "BlackHoleBackpack" then
			local view = raw("ViewportFrame", parent, {
				Name = "BlackHolePreview",
				BackgroundTransparency = 1,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(size, size),
				ZIndex = 2,
			})
			pcall(BackpackModels.show, view, "BlackHole")
		elseif pass.Key == "BoatCustomization" then
			local view = raw("ViewportFrame", parent, {
				Name = "BoatFurniturePreview",
				BackgroundTransparency = 1,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(size, size),
				ZIndex = 2,
			})
			pcall(function()
				require(ReplicatedStorage.Shared.BoatFurniture).preview(view, "DeckChair")
			end)
		elseif pass.Key == "AutoStore" then
			glyph(parent, "AutoStore", if owned then green else Color3.new(1, 1, 1), UDim2.fromScale(0.5, 0.5), size * 0.6)
		else
			display(parent, "2x\nXP", size * 0.38, Color3.fromRGB(255, 236, 140), {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(size, size),
				TextXAlignment = Enum.TextXAlignment.Center,
				LineHeight = 0.85,
				Rotation = -8,
				ZIndex = 2,
			})
		end
	end
	local function buyPass(pass)
		if player:GetAttribute("Owns" .. pass.Key) == true then
			return
		end
		local ok = pcall(function()
			MarketplaceService:PromptGamePassPurchase(player, Gamepasses[pass.Key].Id)
		end)
		if not ok then
			notice.Text = "The purchase prompt could not open. Please try again."
		end
	end
	-- One banner. `compact` is the shorter card used in the Gamepasses grid.
	local function banner(parent, pass, position, width, height, compact)
		local owned = player:GetAttribute("Owns" .. pass.Key) == true
		local stacked = width < 520
		local frame = raw("Frame", parent, {
			Name = pass.Key .. "Card",
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Position = position,
			Size = UDim2.fromOffset(width, height),
		})
		corner(frame, 6)
		gradient(frame, pass.Colors, 20)
		outline(frame, pass.Accent, 3)
		-- Soft glow behind the art and a dark wash behind the text keep both readable.
		local glow = raw("Frame", frame, {
			Name = "ArtGlow",
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.55,
			BorderSizePixel = 0,
			Position = if stacked then UDim2.new(0.5, 0, 0, height * 0.24) else UDim2.new(0, height * 0.62, 0.5, 0),
			Size = UDim2.fromOffset(height * (if stacked then 0.42 else 0.9), height * (if stacked then 0.42 else 0.9)),
		})
		corner(glow, height)
		raw("UIGradient", glow, {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.2),
				NumberSequenceKeypoint.new(1, 1),
			}),
		})
		local wash = raw("Frame", frame, {
			Name = "TextWash",
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
		})
		raw("UIGradient", wash, {
			Rotation = if stacked then 90 else 0,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.45, 1),
				NumberSequenceKeypoint.new(1, 0.55),
			}),
		})
		local artSize = if stacked then height * 0.4 else height * 0.78
		local artBox = raw("Frame", frame, {
			Name = "ProductIcon",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = glow.Position,
			Size = UDim2.fromOffset(artSize, artSize),
			ZIndex = 2,
		})
		art(artBox, pass, owned, artSize)
		sparkle(frame, UDim2.new(0, 22, 1, -26), 14)
		sparkle(frame, UDim2.new(1, -26, 0, 18), 18)
		sparkle(frame, UDim2.new(0.45, 0, 0, 22), 10, 0.3)
		sparkle(frame, UDim2.new(0.12, 0, 0.35, 0), 8, 0.4)
		badge(frame, if owned then "Owned" else "Gamepass", if owned then green else Color3.fromRGB(255, 214, 110), UDim2.fromOffset(16, 16))

		local pad = 18
		local textLeft = if stacked then pad else math.floor(width * 0.42)
		local textTop = if stacked then height * 0.46 else pad
		local align = if stacked then Enum.TextXAlignment.Center else Enum.TextXAlignment.Right
		local titleSize = if compact then 28 elseif stacked then 30 else 40
		local title = display(frame, pass.Name, titleSize, Color3.new(1, 1, 1), {
			Name = "Title",
			Position = UDim2.fromOffset(textLeft, textTop),
			Size = UDim2.new(1, -(textLeft + pad), 0, titleSize + 8),
			TextXAlignment = align,
			TextScaled = true,
			ZIndex = 4,
		})
		raw("UITextSizeConstraint", title, { MaxTextSize = titleSize, MinTextSize = 16 })
		gradient(title, { Color3.new(1, 1, 1), pass.Accent }, 90)

		local perkSize = if compact or stacked then 18 else 23
		local perkTop = textTop + titleSize + 12
		local perks = raw("Frame", frame, {
			Name = "Perks",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(textLeft, perkTop),
			Size = UDim2.new(1, -(textLeft + pad), 0, #pass.Perks * (perkSize + 6)),
			ZIndex = 4,
		})
		for index, perk in pass.Perks do
			display(perks, perk, perkSize, if index % 2 == 0 then pass.Accent else Color3.new(1, 1, 1), {
				Position = UDim2.fromOffset(0, (index - 1) * (perkSize + 6)),
				Size = UDim2.new(1, 0, 0, perkSize + 4),
				TextXAlignment = align,
				TextWrapped = false,
				TextScaled = true,
				ZIndex = 4,
			})
		end
		-- View swaps the perks for the full description.
		local details = display(frame, pass.Description, if stacked then 14 else 16, Color3.new(1, 1, 1), {
			Name = "Details",
			Font = Enum.Font.GothamMedium,
			Position = perks.Position,
			Size = UDim2.new(1, -(textLeft + pad), 0, (height - 76) - perkTop),
			TextXAlignment = align,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextScaled = true,
			Visible = shopViews[pass.Key] == true,
			ZIndex = 4,
		})
		raw("UITextSizeConstraint", details, { MaxTextSize = if stacked then 14 else 17, MinTextSize = 10 })
		perks.Visible = not details.Visible

		local buttonWidth = if stacked then math.floor((width - pad * 3) / 2) else 150
		local price = Gamepasses[pass.Key].Price
		local buy = button(frame, if owned then "Owned" elseif price then tostring(price) else "Robux", function()
			buyPass(pass)
		end, {
			Name = "Buy" .. pass.Key,
			Position = UDim2.new(1, -(pad + buttonWidth), 1, -62),
			Size = UDim2.fromOffset(buttonWidth, 48),
			BackgroundColor3 = if owned then navy else gold,
			Active = not owned,
			TextSize = 22,
			ZIndex = 5,
		})
		Theme.glassButton(buy, if owned then "Disabled" else "Selected")
		withIcon(buy, if owned then "Check" else "Robux", if owned then green else Color3.fromRGB(150, 255, 170), 22)
		buy.ThemeBorder.Color = if owned then green else pass.Accent
		local view = button(frame, if details.Visible then "Back" else "View", function()
			shopViews[pass.Key] = not shopViews[pass.Key]
			render()
		end, {
			Name = "View" .. pass.Key,
			Position = UDim2.new(1, -(pad * 2 + buttonWidth * 2), 1, -62),
			Size = UDim2.fromOffset(buttonWidth, 48),
			TextSize = 22,
			ZIndex = 5,
		})
		Theme.glassButton(view, "Normal")
		view.ThemeBorder.Color = Color3.fromRGB(120, 140, 255)
		return frame
	end
	local function shop()
		local measured = content.AbsoluteSize
		local width = math.max(
			if measured and measured.X > 0 then measured.X else card.AbsoluteSize.X - 40,
			280
		)
		-- Tabs: Featured (hero banners) and Gamepasses (compact grid).
		local tabs = { { "Featured", Color3.fromRGB(235, 130, 255) }, { "Gamepasses", Color3.fromRGB(150, 235, 170) } }
		local tabWidth = math.min(170, math.floor((width - 24) / #tabs))
		for index, entry in tabs do
			local name, color = entry[1], entry[2]
			local tab = button(content, name, function()
				shopTab = name
				render()
			end, {
				Name = name .. "Tab",
				Position = UDim2.fromOffset(8 + (index - 1) * (tabWidth + 10), 14),
				Size = UDim2.fromOffset(tabWidth, 44),
				TextSize = if narrow then 15 else 18,
			})
			Theme.glassButton(tab, if shopTab == name then "Selected" else "Normal")
			tab.ThemeBorder.Color = color
			tab.ThemeBorder.Transparency = if shopTab == name then 0 else 0.35
			tab.ThemeCaption.TextColor3 = color
			if name == "Featured" then
				display(content, "NEW", 15, Color3.new(1, 1, 1), {
					Name = "NewTag",
					Font = Enum.Font.FredokaOne,
					Position = UDim2.fromOffset(8 + tabWidth - 64, 0),
					Size = UDim2.fromOffset(50, 18),
					Rotation = 6,
					ZIndex = 6,
				})
				sparkle(content, UDim2.fromOffset(8 + tabWidth - 6, 6), 14)
			end
		end
		local shelf = scroll(content, {
			Name = "ShopCards",
			Position = UDim2.fromOffset(0, 70),
			Size = UDim2.new(1, 0, 1, -100),
		})
		display(content, "Gamepasses are bought once and kept forever.", if narrow then 12 else 15, muted, {
			Name = "ShopFooter",
			Font = Enum.Font.GothamMedium,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 8, 1, 0),
			Size = UDim2.new(1, -16, 0, 26),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextStrokeTransparency = 1,
		})
		local inner = width - 28
		local y = 0
		if shopTab == "Featured" then
			-- Red ribbon over the newest pass, like a shop-window sticker.
			local ribbon = raw("Frame", shelf, {
				Name = "Ribbon",
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(math.floor(inner * 0.35), 0),
				Size = UDim2.fromOffset(inner - math.floor(inner * 0.35) + 8, 44),
			})
			gradient(ribbon, { Color3.fromRGB(10, 6, 14), Color3.fromRGB(120, 10, 20), Color3.fromRGB(215, 25, 35) })
			display(ribbon, "New: Black Hole Backpack!", if narrow then 16 else 24, Color3.new(1, 1, 1), {
				Position = UDim2.fromOffset(10, 0),
				Size = UDim2.new(1, -24, 1, 0),
				TextScaled = true,
			})
			y = 40
			local height = if inner < 520 then 440 else 300
			for _, pass in ShopProducts do
				banner(shelf, pass, UDim2.fromOffset(8, y), inner, height, false)
				y += height + 18
			end
		else
			local columns = if inner >= 760 then 2 else 1
			local cardWidth = math.floor((inner - (columns - 1) * 14) / columns)
			local height = if cardWidth < 520 then 400 else 240
			for index, pass in ShopProducts do
				local column = (index - 1) % columns
				local row = math.floor((index - 1) / columns)
				banner(
					shelf,
					pass,
					UDim2.fromOffset(8 + column * (cardWidth + 14), row * (height + 14)),
					cardWidth,
					height,
					true
				)
			end
		end
	end
	render = function()
		content:ClearAllChildren()
		local isBook = active == "Bestiary" or active == "Journal"
		local glass = active == "Home" or active == "Settings" or active == "Equipment bag" or active == "Shop"
		card:SetAttribute("BookSurface", isBook)
		card:SetAttribute("GlassSurface", glass)
		bookChrome.Visible = isBook
		binding.Visible = isBook and card.AbsoluteSize.X >= 680
		card.BackgroundColor3 = if isBook then (if active == "Bestiary" then Book.Bestiary else Book.Leather) else navy
		leatherCover.BackgroundColor3 = card.BackgroundColor3
		Theme.button(closeButton, "Danger")
		if isBook then
			styleBookItem(closeButton)
		end
		card.ThemeBorder.Color = if isBook then Book.Edge else Theme.Colors.Border
		card.ThemeInnerRim.Visible = not isBook
		for index = 1, 4 do
			card["ThemeBolt" .. index].Visible = not isBook and not glass
		end
		if not glass then
			Theme.window(card)
			card.BackgroundColor3 = if isBook
				then (if active == "Bestiary" then Book.Bestiary else Book.Leather)
				else navy
			card.BackgroundTransparency = 0
			closeButton.ThemeFace.BackgroundTransparency = 0
			card.ThemeBorder.Color = if isBook then Book.Edge else Theme.Colors.Border
			local texture = card:FindFirstChild("GlassTexture")
			if texture then
				texture.Visible = false
			end
		else
			Theme.glassWindow(card)
			Theme.glassButton(closeButton, "Danger")
		end
		overlay.BackgroundTransparency = if glass then 0.65 else 0.35
		for _, label in { heading, subtitle, notice } do
			Theme.text(label, if label == heading then cream elseif label == notice then gold else muted)
			styleBookItem(label)
			styleGlassItem(label)
		end
		refreshSelection()
		if layoutWindow then
			layoutWindow()
		end
		if not active then
			return
		end
		heading.Text = if active == "Settings"
			then "Select your settings"
			elseif active == "Journal" then "Your fishing journal"
			else active
		subtitle.Text = ({
			Home = "Manage your staff, stock and home base.",
			Bestiary = "Every species. Every mutation. Every personal best.",
			["Equipment bag"] = "The equipment you own, ready for your next trip.",
			Journal = "Your story on the water, one catch at a time.",
			Settings = "Make yourself at home on the water.",
			Shop = "The Fishing Waters Robux shop.",
		})[active]
		if active == "Shop" then
			shop()
		elseif not profile then
			empty(
				content,
				"Your progress is loading",
				"Your collection and settings will appear once your saved progress is available."
			)
		elseif active == "Home" then
			home()
		elseif active == "Bestiary" then
			bestiary()
		elseif active == "Equipment bag" then
			equipment()
		elseif active == "Journal" then
			journal()
		elseif active == "Settings" then
			settings()
		end
	end
	player:GetAttributeChangedSignal("FreecamEnabled"):Connect(function()
		if active == "Settings" then
			render()
		end
	end)
	for _, attribute in { "OwnsAutoStore", "OwnsDoubleXP", "OwnsBlackHoleBackpack", "OwnsBoatCustomization" } do
		player:GetAttributeChangedSignal(attribute):Connect(function()
			if active == "Shop" then
				render()
			end
		end)
	end
	for index, name in { "Bestiary", "Journal", "Home", "Equipment bag", "Settings", "Shop" } do
		navButtons[name] = button(sidebar, name, function()
			if player:GetAttribute("DrydockScreenOpen") or player:GetAttribute("RodCrateOpening") then
				return
			end
			if active == name then
				close()
				return
			end
			active = name
			if name == "Bestiary" then
				bestiarySelected = nil
			end
			overlay.Visible = true
			player:SetAttribute("PlayerMenuOpen", true)
			render()
			request("Get")
			if UserInputService.GamepadEnabled then
				GuiService.SelectedObject = if closeButton.Visible then closeButton else nil
			end
		end, {
			Name = name:gsub(" ", ""),
			LayoutOrder = index,
			Size = UDim2.new(1, 0, 0, if name == "Bestiary" or name == "Journal" then 52 else 46),
			BackgroundTransparency = 0,
			TextSize = 14,
		})
	end
	refreshSelection()
	UserInputService.InputBegan:Connect(function(event)
		if overlay.Visible and (event.KeyCode == Enum.KeyCode.Escape or event.KeyCode == Enum.KeyCode.ButtonB) then
			if active == "Bestiary" and bestiarySelected and bestiaryBack then
				bestiaryBack()
			else
				close()
			end
		elseif
			overlay.Visible
			and active == "Bestiary"
			and turnBestiary
			and not UserInputService:GetFocusedTextBox()
		then
			local step = ({
				[Enum.KeyCode.Left] = -1,
				[Enum.KeyCode.Right] = 1,
				[Enum.KeyCode.ButtonL1] = -1,
				[Enum.KeyCode.ButtonR1] = 1,
			})[event.KeyCode]
			if step then
				turnBestiary(step)
			end
		end
	end)
	local refreshToken = 0
	local function scheduleRefresh()
		refreshToken += 1
		local token = refreshToken
		task.delay(0.4, function()
			if token ~= refreshToken then
				return
			end
			if busy then
				scheduleRefresh()
				return
			end
			if player:GetAttribute("BoatDataStatus") == "Ready" then
				request("Get")
			end
		end)
	end
	player:GetAttributeChangedSignal("AnglerRevision"):Connect(scheduleRefresh)
	player:GetAttributeChangedSignal("BoatDataStatus"):Connect(scheduleRefresh)
	player:GetAttributeChangedSignal("RodEquipped"):Connect(function()
		if active == "Equipment bag" then
			render()
		end
	end)
	player.CharacterRemoving:Connect(close)
	ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
		if who ~= player or prompt.Name ~= "CompanyOfficePrompt" or prompt:GetAttribute("OwnerUserId") ~= player.UserId then
			return
		end
		if player:GetAttribute("DrydockScreenOpen") or player:GetAttribute("RodCrateOpening") then return end
		active, homeTab = "Home", "Staff"
		overlay.Visible = true
		player:SetAttribute("PlayerMenuOpen", true)
		render()
		request("Get")
	end)
	layoutWindow = function()
		narrow = card.AbsoluteSize.X < 680
		local isBook = active == "Bestiary" or active == "Journal"
		-- The journal letters its own title and close box onto the page.
		local isJournal = active == "Journal"
		local isEquipment = active == "Equipment bag"
		card:FindFirstChildOfClass("UISizeConstraint").MaxSize = if isEquipment
			then Vector2.new(1480, 700)
			else Vector2.new(1020, 680)
		heading.Visible, subtitle.Visible, closeButton.Visible =
			not isJournal and not isEquipment, not isJournal and not isEquipment, not isJournal
		content.Position = if isEquipment
			then UDim2.fromOffset(12, 12)
			elseif isJournal then UDim2.fromOffset(20, 34)
			else UDim2.fromOffset(20, 98)
		content.Size = if isEquipment
			then UDim2.new(1, -24, 1, -54)
			elseif isJournal then UDim2.new(1, -40, 1, -80)
			else UDim2.new(1, -40, 1, -142)
		for _, leaf in leaves do
			leaf.MarginRule0.Visible, leaf.MarginRule1.Visible = not isJournal, not isJournal
		end
		binding.Visible = isBook and not narrow
		leaves[1].Visible = not narrow
		leaves[2].Position = if narrow then UDim2.fromOffset(18, 12) else UDim2.new(0.5, -3, 0, 12)
		leaves[2].Size = if narrow then UDim2.new(1, -36, 1, -34) else UDim2.new(0.5, -15, 1, -34)
		heading.Position = if isBook then UDim2.fromOffset(48, 22) else UDim2.fromOffset(60, 8)
		heading.Size = if isBook
			then UDim2.new(if narrow then 1 else 0.5, if narrow then -100 else -78, 0, 32)
			else UDim2.new(1, -120, 0, 36)
		heading.TextXAlignment = if isBook then Enum.TextXAlignment.Left else Enum.TextXAlignment.Center
		subtitle.Position = if isBook then UDim2.fromOffset(48, 54) else UDim2.fromOffset(24, 53)
		subtitle.Size = if isBook
			then UDim2.new(if narrow then 1 else 0.5, if narrow then -100 else -78, 0, 26)
			else UDim2.new(1, -48, 0, 34)
		subtitle.TextSize = if isBook then 12 else 13
		sidebar.Size = UDim2.fromOffset(if gui.AbsoluteSize.X < 680 then 144 else 172, 334)
		for _, item in navButtons do
			item.TextSize = if item.Name == "Bestiary" or item.Name == "Journal" then 20 else 14
		end
		refreshNavigation()
	end
	card:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		layoutWindow()
		if active then
			render()
		end
	end)
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutWindow)
	layoutWindow()
	scheduleRefresh()
end
return Menu
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="343">
          <Properties>
            <string name="Name">PlayerSettings</string>
            <string name="Source"><![CDATA[-- Sound groups keep source volumes intact, including dynamically updated thunder.
local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Settings = {}
local started = false
local master, music, effects
local underwaterFilter: EqualizerSoundEffect
local underwaterTween: Tween? = nil
local underwater = false
local performance, device, preset
-- 1 = Performance, 2 = Balanced, 3 = Quality. Published as the GraphicsTier attribute so
-- ambient systems (townsfolk) can scale their own detail.
local tier = 3
-- Performance keys the player changed by hand this session; an automatic step down
-- (Settings.lowerPreset) leaves those alone.
local manual: { [string]: boolean } = {}
local lowered = false

local PRESETS = { "Performance", "Balanced", "Quality" }
local function presetValues(level: number)
	return { Shadows = level == 3, WeatherEffects = level >= 2 }
end

local function applyPerformance()
	Lighting.GlobalShadows = performance.Shadows
	Players.LocalPlayer:SetAttribute("WeatherEffectsEnabled", performance.WeatherEffects)
	-- Read by BlackHoleBackpack for every worn black hole pack in view.
	Players.LocalPlayer:SetAttribute("BackpackAnimationEnabled", performance.BackpackAnimation)
	-- Computers get the full supercell tower and denser billows. The rain deck
	-- under the supercell remains present on every device, including Performance mode.
	Players.LocalPlayer:SetAttribute("VolumetricCloudsEnabled", device == "Computer" and performance.WeatherEffects)
	Players.LocalPlayer:SetAttribute("GraphicsTier", tier)
end

local function detectPerformance()
	-- Input capabilities are a device heuristic, not a hardware benchmark. A
	-- controller connected to a computer must not lower its preset on its own.
	tier = 3
	device = "Computer"
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		device, tier = "Mobile / tablet", 1
	elseif
		UserInputService.GamepadEnabled
		and not UserInputService.KeyboardEnabled
		and not UserInputService.TouchEnabled
	then
		device, tier = "Console", 2
	end
	local ok, quality = pcall(function()
		return UserSettings():GetService("UserGameSettings").SavedQualityLevel.Value
	end)
	-- Zero means Roblox's automatic quality, not the lowest graphics level.
	if ok and type(quality) == "number" and quality > 0 then
		tier = math.min(tier, if quality <= 3 then 1 elseif quality <= 6 then 2 else 3)
	end
	preset = PRESETS[tier]
	-- The black hole pack animation is off by default on phones and tablets
	-- regardless of their graphics level; it can still be turned on in Settings.
	performance = presetValues(tier)
	performance.BackpackAnimation = device ~= "Mobile / tablet"
	table.clear(manual)
	lowered = false
end

function Settings.description()
	Settings.start()
	if lowered then
		return device .. " · lowered to the " .. preset .. " preset to keep the frame rate up. Changes apply until you rejoin."
	end
	return device .. " · " .. preset .. " preset on join. Changes apply until you rejoin."
end

-- The value this session actually uses for a performance option, or nil for other keys.
function Settings.current(key: string): any
	Settings.start()
	return performance[key]
end

-- Steps the preset down one tier for the rest of the session (FrameRateGuard calls this
-- when the frame rate stays low). Options the player set by hand are kept. Returns
-- whether anything was lowered.
function Settings.lowerPreset(): boolean
	Settings.start()
	if tier <= 1 then
		return false
	end
	tier -= 1
	preset = PRESETS[tier]
	lowered = true
	for key, value in presetValues(tier) do
		if not manual[key] then
			performance[key] = value
		end
	end
	applyPerformance()
	return true
end

function Settings.start()
	if started then
		return
	end
	started = true
	detectPerformance()
	-- Apply before the profile/remote is available, even if loading takes time.
	applyPerformance()
	master = Instance.new("SoundGroup")
	master.Name, master.Parent = "PlayerMaster", SoundService
	master.Volume = 1
	-- Attenuate the whole mix without fighting saved volumes or sounds whose
	-- source volume changes every frame. Higher frequencies lose the most energy.
	underwaterFilter = Instance.new("EqualizerSoundEffect")
	underwaterFilter.Name = "UnderwaterMuffle"
	underwaterFilter.LowGain, underwaterFilter.MidGain, underwaterFilter.HighGain = 0, 0, 0
	underwaterFilter.Parent = master
	music = Instance.new("SoundGroup")
	music.Name, music.Parent = "PlayerMusic", master
	music.Volume = 1
	effects = Instance.new("SoundGroup")
	effects.Name, effects.Parent = "PlayerEffects", master
	effects.Volume = 1
	local function bind(instance)
		if not instance:IsA("Sound") then
			return
		end
		local function route()
			local group = instance.SoundGroup
			-- Preserve an authored group's effects/volume by parenting that group
			-- under our mixer; ungrouped sounds use their AudioCategory attribute.
			if group and group ~= music and group ~= effects and group ~= master then
				local top = group
				while top.Parent and top.Parent:IsA("SoundGroup") and top.Parent ~= master do
					top = top.Parent
				end
				if top.Parent ~= master then
					top.Parent = if instance:GetAttribute("AudioCategory") == "Music" or top.Name == "Music"
						then music
						else effects
				end
			else
				local target = if instance:GetAttribute("AudioCategory") == "Music" then music else effects
				if group ~= target then
					instance.SoundGroup = target
				end
			end
		end
		instance:GetAttributeChangedSignal("AudioCategory"):Connect(route)
		instance:GetPropertyChangedSignal("SoundGroup"):Connect(route)
		route()
	end
	-- Only places sounds can play from: the mixer, this player's GUI, characters
	-- (footsteps, splashes) and boats (engines). Watching all of workspace ran a
	-- script call for every part streaming into the map, thousands per island piece.
	local function watch(root: Instance)
		root.DescendantAdded:Connect(bind)
		for _, instance in root:GetDescendants() do
			bind(instance)
		end
	end
	watch(SoundService)
	-- Positional fishing splashes and gull calls live on Terrain attachments.
	watch(workspace.Terrain)
	watch(Players.LocalPlayer)
	local function watchPlayer(other: Player)
		other.CharacterAdded:Connect(watch)
		if other.Character then
			watch(other.Character)
		end
	end
	Players.PlayerAdded:Connect(watchPlayer)
	for _, other in Players:GetPlayers() do
		watchPlayer(other)
	end
	-- Sounds parented straight to workspace, and the boats folder.
	local function topLevel(child: Instance)
		bind(child)
		if child.Name == "PlayerBoats" then
			watch(child)
		end
	end
	workspace.ChildAdded:Connect(topLevel)
	for _, child in workspace:GetChildren() do
		topLevel(child)
	end
end

function Settings.setUnderwater(submerged: boolean)
	Settings.start()
	if underwater == submerged then
		return
	end
	underwater = submerged
	if underwaterTween then
		underwaterTween:Cancel()
	end
	underwaterTween = TweenService:Create(underwaterFilter, TweenInfo.new(0.18, Enum.EasingStyle.Sine), {
		LowGain = if submerged then -4 else 0,
		MidGain = if submerged then -14 else 0,
		HighGain = if submerged then -30 else 0,
	})
	underwaterTween:Play()
end

function Settings.apply(values, changedKey)
	Settings.start()
	-- Profile refreshes and saved settings from another device must not undo
	-- this join's preset or a manual change made during the current session.
	if performance[changedKey] ~= nil and type(values[changedKey]) == "boolean" then
		performance[changedKey] = values[changedKey]
		manual[changedKey] = true
	end
	local effective = table.clone(values)
	for key, value in performance do
		effective[key] = value
	end
	applyPerformance()
	master.Volume = values.MasterVolume / 100
	music.Volume = values.MusicVolume / 100
	effects.Volume = values.EffectsVolume / 100
	return effective
end
return Settings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="344">
          <Properties>
            <string name="Name">ReelMinigame</string>
            <string name="Source"><![CDATA[-- The hooked-fish panel: a needle sweeps one of two arc gauges and every Pull
-- inside the green zone reels the fish closer to the surface. Rarer and heavier
-- fish sweep faster, shrink and drift the zone, and pull back harder. The same
-- panel shows short messages; CatchPopup shows the landed catch.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Catalog = require(ReplicatedStorage.Shared.AnglerCatalog)
local FishCatch = require(ReplicatedStorage.Shared.FishCatch)
local FishModels = require(ReplicatedStorage.Shared.FishModels)
local FishingAudio = require(script.Parent.FishingAudio)

local Reel = {}
Reel.__index = Reel

local rgb = Color3.fromRGB
local INK = rgb(10, 10, 10)
local BRONZE = rgb(150, 118, 72)
local BRONZE_DIM = rgb(78, 62, 42)
local TRACK = rgb(112, 36, 32)
local TRACK_DIM = rgb(54, 24, 22)
local ZONE = rgb(84, 192, 92)
local WHITE = rgb(240, 240, 236)
local MUTED = rgb(170, 170, 164)
local PANEL_SIZE = Vector2.new(560, 250)
local CENTER = Vector2.new(190, 135)
local RADIUS = 100
local THICKNESS = 16
local SEGMENTS = 28
-- Screen angles in degrees, clockwise from +X (y points down).
local GAUGES = { { 200, 320 }, { 340, 440 } }

local function make(class: string, parent: Instance?, props: { [string]: any }): any
	local item = Instance.new(class)
	for key, value in props do
		item[key] = value
	end
	item.Parent = parent
	return item
end

local function round(item: GuiObject, radius: number?)
	make("UICorner", item, { CornerRadius = if radius then UDim.new(0, radius) else UDim.new(1, 0) })
end

local function stroke(item: GuiObject, color: Color3, thickness: number, name: string?)
	return make("UIStroke", item, {
		Name = name or "Stroke",
		Color = color,
		Thickness = thickness,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function text(parent: Instance, value: string, props: { [string]: any }): TextLabel
	local label = make("TextLabel", parent, {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Text = value,
		TextColor3 = WHITE,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	for key, item in props do
		label[key] = item
	end
	return label
end

local function arcPoint(angle: number, radius: number): Vector2
	local radians = math.rad(angle)
	return CENTER + Vector2.new(math.cos(radians), math.sin(radians)) * radius
end

local function buildGauge(parent: Instance, from: number, to: number)
	local gauge = { from = from, to = to, segments = {}, rims = {} }
	local length = math.rad(to - from) * RADIUS / SEGMENTS
	for index = 1, SEGMENTS do
		local angle = from + (to - from) * (index - 0.5) / SEGMENTS
		local point = arcPoint(angle, RADIUS)
		local rim = make("Frame", parent, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(point.X, point.Y),
			Size = UDim2.fromOffset(length + 2, THICKNESS + 6),
			Rotation = angle + 90,
			BackgroundColor3 = BRONZE,
			BorderSizePixel = 0,
			ZIndex = 2,
		})
		local segment = make("Frame", parent, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(point.X, point.Y),
			Size = UDim2.fromOffset(length + 1.5, THICKNESS),
			Rotation = angle + 90,
			BackgroundColor3 = TRACK,
			BorderSizePixel = 0,
			ZIndex = 3,
		})
		table.insert(gauge.rims, rim)
		table.insert(gauge.segments, { frame = segment, t = (index - 0.5) / SEGMENTS })
	end
	-- Rounded caps close both ends of the track.
	for _, angle in { from, to } do
		local point = arcPoint(angle, RADIUS)
		local cap = make("Frame", parent, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(point.X, point.Y),
			Size = UDim2.fromOffset(THICKNESS + 6, THICKNESS + 6),
			BackgroundColor3 = BRONZE,
			BorderSizePixel = 0,
			ZIndex = 2,
		})
		round(cap)
		table.insert(gauge.rims, cap)
	end
	return gauge
end

function Reel.new(gui: ScreenGui)
	local self = setmetatable({}, Reel)
	self.random = Random.new()
	local root = make("Frame", gui, {
		Name = "ReelMinigame",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(PANEL_SIZE.X, PANEL_SIZE.Y),
		BackgroundTransparency = 1,
		Visible = false,
	})
	self.root = root
	self.scale = make("UIScale", root, {})

	local panel = make("Frame", root, {
		Name = "Panel",
		Size = UDim2.fromOffset(PANEL_SIZE.X, PANEL_SIZE.Y),
		BackgroundColor3 = INK,
		BackgroundTransparency = 0.04,
		BorderSizePixel = 0,
		Active = true,
	})
	round(panel, 4)
	self.panelStroke = stroke(panel, BRONZE, 3)
	local rim = make("Frame", panel, {
		Position = UDim2.fromOffset(6, 6),
		Size = UDim2.new(1, -12, 1, -12),
		BackgroundTransparency = 1,
	})
	round(rim, 2)
	stroke(rim, BRONZE_DIM, 1)
	self.panel = panel

	-- Fight view.
	local fight = make("Frame", panel, { Name = "Fight", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
	self.fightView = fight
	local meterTop, meterBottom = 40, 214
	self.meterTop, self.meterBottom = meterTop, meterBottom
	make("Frame", fight, {
		Position = UDim2.fromOffset(33, meterTop - 14),
		Size = UDim2.fromOffset(2, meterBottom - meterTop + 22),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
	})
	for y = meterTop + 12, meterBottom - 6, 16 do
		make("Frame", fight, {
			Position = UDim2.fromOffset(36, y),
			Size = UDim2.fromOffset(6, 1),
			BackgroundColor3 = MUTED,
			BorderSizePixel = 0,
		})
	end
	local ring = make("Frame", fight, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(34, meterTop - 20),
		Size = UDim2.fromOffset(13, 13),
		BackgroundTransparency = 1,
	})
	round(ring)
	stroke(ring, rgb(226, 170, 140), 2)
	for index, width in { 30, 22 } do
		make("Frame", fight, {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromOffset(34, meterTop - 6 + index * 4),
			Size = UDim2.fromOffset(width, 2),
			BackgroundColor3 = rgb(70, 140, 214),
			BorderSizePixel = 0,
		})
	end
	make("Frame", fight, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(34, meterBottom + 14),
		Size = UDim2.fromOffset(9, 9),
		Rotation = 45,
		BackgroundColor3 = rgb(226, 170, 140),
		BorderSizePixel = 0,
	})
	local marker = make("Frame", fight, {
		Name = "FishMarker",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 4,
	})
	round(marker)
	self.markerStroke = stroke(marker, INK, 2)
	make("Frame", marker, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(6, 6),
		BackgroundColor3 = INK,
		BorderSizePixel = 0,
		ZIndex = 5,
	})
	self.marker = marker

	self.silhouette = make("ViewportFrame", fight, {
		Name = "FishSilhouette",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(CENTER.X, CENTER.Y),
		Size = UDim2.fromOffset(160, 150),
		BackgroundTransparency = 1,
		ImageColor3 = WHITE,
		ZIndex = 2,
	})
	self.gauges = {}
	for _, range in GAUGES do
		table.insert(self.gauges, buildGauge(fight, range[1], range[2]))
	end
	local needle = make("Frame", fight, {
		Name = "Needle",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(THICKNESS + 18, 5),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 6,
	})
	stroke(needle, INK, 1.5)
	self.needle = needle
	local tip = make("Frame", fight, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(11, 11),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 6,
	})
	stroke(tip, INK, 1.5)
	self.needleTip = tip

	self.title = text(fight, "DISTURBED WATER", {
		Position = UDim2.fromOffset(320, 20),
		Size = UDim2.fromOffset(222, 42),
		Font = Enum.Font.Oswald,
		TextScaled = true,
	})
	make("UITextSizeConstraint", self.title, { MaxTextSize = 36 })
	make("Frame", fight, {
		Position = UDim2.fromOffset(320, 66),
		Size = UDim2.fromOffset(222, 2),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
	})
	self.strength = text(
		fight,
		"Strength: Medium",
		{ Position = UDim2.fromOffset(320, 78), Size = UDim2.fromOffset(222, 24), TextSize = 18 }
	)
	local tag = make("Frame", fight, {
		Position = UDim2.fromOffset(320, 110),
		Size = UDim2.fromOffset(0, 24),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = rgb(36, 40, 98),
		BorderSizePixel = 0,
	})
	round(tag, 3)
	make("UIPadding", tag, { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) })
	self.place = text(tag, "GULLHAVEN SOUND", {
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
	})
	self.hint = text(fight, "Pull when the needle is in the green.", {
		Position = UDim2.fromOffset(320, 140),
		Size = UDim2.fromOffset(222, 32),
		TextSize = 13,
		TextColor3 = MUTED,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	local pull = make("TextButton", fight, {
		Name = "Pull",
		Position = UDim2.fromOffset(320, 180),
		Size = UDim2.fromOffset(200, 46),
		BackgroundColor3 = rgb(26, 26, 26),
		AutoButtonColor = true,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamMedium,
		Text = "Pull",
		TextColor3 = WHITE,
		TextSize = 22,
	})
	round(pull, 3)
	self.pullStroke = stroke(pull, WHITE, 2)
	local key = make("TextLabel", pull, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(26, 26),
		BackgroundColor3 = WHITE,
		Font = Enum.Font.GothamBold,
		Text = "F",
		TextColor3 = INK,
		TextSize = 15,
		Visible = UserInputService.KeyboardEnabled,
	})
	round(key, 5)
	pull.Activated:Connect(function()
		self:pull()
	end)

	-- Catch view.
	local result = make(
		"Frame",
		panel,
		{ Name = "Result", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false }
	)
	self.result = result
	self.trophy = make("ViewportFrame", result, {
		Name = "Fish",
		Position = UDim2.fromOffset(18, 18),
		Size = UDim2.fromOffset(290, PANEL_SIZE.Y - 36),
		BackgroundTransparency = 1,
	})
	self.resultTitle = text(result, "", {
		Position = UDim2.fromOffset(320, 20),
		Size = UDim2.fromOffset(222, 42),
		Font = Enum.Font.Oswald,
		TextScaled = true,
	})
	make("UITextSizeConstraint", self.resultTitle, { MaxTextSize = 36 })
	make("Frame", result, {
		Position = UDim2.fromOffset(320, 66),
		Size = UDim2.fromOffset(222, 2),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
	})
	local badges = make("Frame", result, {
		Position = UDim2.fromOffset(320, 78),
		Size = UDim2.fromOffset(222, 24),
		BackgroundTransparency = 1,
	})
	make("UIListLayout", badges, { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) })
	local function badge(name: string)
		local frame = make("Frame", badges, {
			Name = name,
			Size = UDim2.fromOffset(0, 24),
			AutomaticSize = Enum.AutomaticSize.X,
			BorderSizePixel = 0,
		})
		round(frame, 3)
		make("UIPadding", frame, { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) })
		local label = text(frame, "", {
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			Font = Enum.Font.GothamBold,
			TextSize = 14,
			TextColor3 = INK,
		})
		return frame, label
	end
	self.rarityBadge, self.rarityLabel = badge("Rarity")
	self.sizeBadge, self.sizeLabel = badge("Size")
	self.weight = text(result, "", {
		Position = UDim2.fromOffset(320, 112),
		Size = UDim2.fromOffset(222, 28),
		TextSize = 22,
		Font = Enum.Font.GothamBold,
	})
	self.worth = text(result, "", {
		Position = UDim2.fromOffset(320, 142),
		Size = UDim2.fromOffset(222, 28),
		TextSize = 22,
		Font = Enum.Font.GothamBold,
		TextColor3 = rgb(111, 202, 125),
	})
	self.footer = text(result, "", {
		Position = UDim2.fromOffset(320, 180),
		Size = UDim2.fromOffset(222, 44),
		TextSize = 13,
		TextColor3 = MUTED,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
	})

	UserInputService.InputBegan:Connect(function(input, processed)
		if
			not processed
			and (
				input.KeyCode == Enum.KeyCode.F
				or input.KeyCode == Enum.KeyCode.ButtonX
				or input.KeyCode == Enum.KeyCode.ButtonR2
			)
		then
			self:pull()
		end
	end)
	RunService.RenderStepped:Connect(function()
		local camera = workspace.CurrentCamera
		if camera and root.Visible then
			local viewport = camera.ViewportSize
			self.scale.Scale = math.clamp(
				math.min((viewport.X - 24) / root.Size.X.Offset, (viewport.Y - 30) / root.Size.Y.Offset),
				0.3,
				1
			)
		end
	end)
	return self
end

function Reel:refreshVisibility()
	local panelShown = self.state ~= nil or self.showingResult
	self.panel.Visible = panelShown
	self.root.Visible = panelShown
end

function Reel:newRound()
	local state = self.state
	state.gauge = if state.gauge == 1 then 2 else 1
	state.t, state.direction = 0, 1
	-- The zone always starts ahead of the needle, so every hit takes travel time.
	state.zone = self.random:NextNumber(0.3, 1 - state.tuning.zoneSize)
	state.zoneDirection = if self.random:NextNumber() < 0.5 then -1 else 1
end

function Reel:pull()
	local state = self.state
	if not state or state.result or os.clock() < state.lockUntil then
		return
	end
	local landed = state.t >= state.zone and state.t <= state.zone + state.tuning.zoneSize
	if state.onPull then
		state.onPull(landed)
	end
	if landed then
		state.progress += state.tuning.gain
		state.flash, state.flashColor = 0.25, ZONE
		state.lockUntil = os.clock() + 0.12
		state.jolt = 1
		FishingAudio.pull()
		self:newRound()
	else
		state.progress -= state.tuning.missPenalty
		state.flash, state.flashColor = 0.35, rgb(226, 72, 60)
		state.lockUntil = os.clock() + 0.4
		state.shake = 0.3
		FishingAudio.miss()
	end
end

function Reel:abort()
	if self.state and not self.state.result then
		self.state.result = "Aborted"
	end
end

function Reel:render(state, dt: number)
	local now = os.clock()
	for index, gauge in self.gauges do
		local active = index == state.gauge
		for _, rimFrame in gauge.rims do
			rimFrame.BackgroundColor3 = if active then BRONZE else BRONZE_DIM
		end
		for _, segment in gauge.segments do
			local inZone = active and segment.t >= state.zone and segment.t <= state.zone + state.tuning.zoneSize
			segment.frame.BackgroundColor3 = if inZone then ZONE elseif active then TRACK else TRACK_DIM
		end
	end
	local gauge = self.gauges[state.gauge]
	local shake = if state.shake > 0 then math.sin(now * 90) * 4 * state.shake / 0.3 else 0
	local angle = gauge.from + (gauge.to - gauge.from) * state.t + shake
	local point = arcPoint(angle, RADIUS)
	self.needle.Position = UDim2.fromOffset(point.X, point.Y)
	self.needle.Rotation = angle
	local outer = arcPoint(angle, RADIUS + THICKNESS / 2 + 12)
	self.needleTip.Position = UDim2.fromOffset(outer.X, outer.Y)
	self.needleTip.Rotation = angle + 45
	local y = self.meterBottom + (self.meterTop - self.meterBottom) * math.clamp(state.progress, 0, 1)
	self.marker.Position = UDim2.fromOffset(34 + math.sin(now * 9) * 1.5, y)
	local flash = math.clamp(state.flash / 0.25, 0, 1)
	self.panelStroke.Color = BRONZE:Lerp(state.flashColor, flash)
	self.markerStroke.Color = INK:Lerp(state.flashColor, flash)
	self.pullStroke.Color = if now < state.lockUntil and state.flashColor ~= ZONE then rgb(120, 120, 116) else WHITE
	local camera = state.camera
	if camera then
		local focus, distance = camera:GetAttribute("Focus"), camera:GetAttribute("Distance")
		local thrash = 0.08 + state.difficulty * 0.16
		local yaw = math.sin(now * (5 + state.difficulty * 6)) * thrash + state.jolt * 0.35
		local pitch = math.cos(now * 3.3) * thrash * 0.4
		local direction = (CFrame.Angles(pitch, yaw, 0) * state.view).Unit
		camera.CFrame = CFrame.lookAt(focus + direction * distance, focus)
	end
	state.jolt = math.max(0, state.jolt - dt * 4)
end

-- Yields until the fight ends: "Landed", "Escaped" or "Aborted".
-- Reel Speed and Handling boosts are snapshotted by the server for this cast.
function Reel:fight(fishId: string, difficulty: number, placeName: string?, reelBoost: number?, onPull: ((boolean) -> ())?, handlingBoost: number?): string
	self:abort()
	local fish = Catalog.Fish[fishId]
	local state = {
		onPull = onPull,
		tuning = FishCatch.tuning(difficulty, if type(reelBoost) == "number" then reelBoost else nil, handlingBoost),
		difficulty = difficulty,
		progress = FishCatch.START_PROGRESS,
		gauge = 2,
		t = 0,
		direction = 1,
		zone = 0.5,
		zoneDirection = 1,
		lockUntil = 0,
		flash = 0,
		flashColor = ZONE,
		shake = 0,
		jolt = 0,
		seed = self.random:NextNumber(0, 10),
	}
	self.state = state
	self:newRound()
	self.showingResult = false
	self.result.Visible, self.fightView.Visible = false, true
	self.title.Text = if fish then FishCatch.title(fish) else "DISTURBED WATER"
	self.strength.Text = "Strength: " .. FishCatch.strength(difficulty)
	self.place.Text = string.upper(placeName or "Gullhaven Sound")
	local model, camera = FishModels.show(self.silhouette, fishId, true)
	if model and camera then
		state.camera = camera
		state.view = (model:GetAttribute("ViewDirection") :: Vector3).Unit
	end
	self:refreshVisibility()
	while not state.result do
		local dt = math.min(RunService.RenderStepped:Wait(), 0.1)
		local tuning = state.tuning
		local speed = tuning.needleSpeed
		if tuning.erratic then
			speed *= 1 + 0.45 * math.sin(os.clock() * 3.1 + state.seed) * math.sin(os.clock() * 1.7)
		end
		state.t += state.direction * speed * dt
		if state.t > 1 then
			state.t, state.direction = 2 - state.t, -1
		elseif state.t < 0 then
			state.t, state.direction = -state.t, 1
		end
		if tuning.zoneDrift > 0 then
			state.zone += state.zoneDirection * tuning.zoneDrift * dt
			local maximum = 1 - tuning.zoneSize
			if state.zone > maximum then
				state.zone, state.zoneDirection = maximum, -1
			elseif state.zone < 0 then
				state.zone, state.zoneDirection = 0, 1
			end
		end
		state.progress -= tuning.drain * dt
		state.flash = math.max(0, state.flash - dt)
		state.shake = math.max(0, state.shake - dt)
		if state.progress >= 1 then
			state.result = "Landed"
		elseif state.progress <= 0 then
			state.result = "Escaped"
		end
		self:render(state, dt)
	end
	if self.state == state then
		self.state = nil
	end
	self:refreshVisibility()
	return state.result
end

local resultId = 0
local function holdResult(self, seconds: number)
	resultId += 1
	local current = resultId
	self.showingResult = true
	self.fightView.Visible, self.result.Visible = false, true
	self:refreshVisibility()
	task.delay(seconds, function()
		if resultId == current and self.showingResult then
			self.showingResult = false
			self:refreshVisibility()
		end
	end)
end

-- Clears the reeling message once the catch popup takes over.
function Reel:dismiss()
	resultId += 1
	self.showingResult = false
	self:refreshVisibility()
end

function Reel:showMessage(title: string, message: string)
	if self.state then
		return
	end
	for _, child in self.trophy:GetChildren() do
		child:Destroy()
	end
	self.resultTitle.Text = title
	self.rarityBadge.Visible, self.sizeBadge.Visible = false, false
	self.weight.Text, self.worth.Text = "", ""
	self.footer.Text = message
	holdResult(self, 2.5)
end

return Reel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="345">
          <Properties>
            <string name="Name">RetroUI</string>
            <string name="Source"><![CDATA[-- Widgets for the office PC's green-phosphor screen (OfficeComputer, StockApp). Everything is
-- drawn on an 800x600 canvas (a ScreenGui laid over the glass): monochrome like the MONOCHROME 14 monitor it runs on,
-- so meaning is carried by text, arrows and inverse video rather than colour.
local TweenService = game:GetService("TweenService")

local RetroUI = {}

local rgb = Color3.fromRGB
RetroUI.Colors = {
	Screen = rgb(4, 12, 7), -- unlit tube
	Panel = rgb(8, 24, 13),
	Dim = rgb(28, 82, 44), -- borders, grid lines (decoration only)
	Mid = rgb(78, 184, 104), -- secondary text
	Bright = rgb(110, 255, 140), -- primary text (the monitor's phosphor)
	Hot = rgb(205, 255, 214), -- emphasis
}
RetroUI.Fonts = {
	Title = Enum.Font.Arcade,
	Body = Enum.Font.Code,
}
RetroUI.WIDTH, RetroUI.HEIGHT = 800, 600

local FAST = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function apply(item: Instance, props: { [string]: any }?)
	if props then
		for key, value in props do
			(item :: any)[key] = value
		end
	end
	return item
end

function RetroUI.frame(parent: Instance, name: string, position: UDim2, size: UDim2, props: { [string]: any }?): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundColor3 = RetroUI.Colors.Screen
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Position = position
	frame.Size = size
	apply(frame, props)
	frame.Parent = parent
	return frame
end

function RetroUI.border(item: GuiObject, color: Color3?, thickness: number?): UIStroke
	local stroke = item:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = color or RetroUI.Colors.Bright
	stroke.Thickness = thickness or 2
	stroke.Parent = item
	return stroke
end

export type TextOptions = {
	Size: number?,
	Color: Color3?,
	Font: Enum.Font?,
	AlignX: Enum.TextXAlignment?,
	AlignY: Enum.TextYAlignment?,
	Wrap: boolean?,
}

function RetroUI.text(
	parent: Instance,
	name: string,
	text: string,
	position: UDim2,
	size: UDim2,
	options: TextOptions?
): TextLabel
	local opts = options or {}
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Position = position
	label.Size = size
	label.Font = opts.Font or RetroUI.Fonts.Body
	label.Text = text
	label.TextSize = opts.Size or 20
	label.TextColor3 = opts.Color or RetroUI.Colors.Bright
	label.TextXAlignment = opts.AlignX or Enum.TextXAlignment.Left
	label.TextYAlignment = opts.AlignY or Enum.TextYAlignment.Center
	label.TextWrapped = opts.Wrap == true
	label.TextTruncate = if opts.Wrap then Enum.TextTruncate.None else Enum.TextTruncate.AtEnd
	-- A faint same-colour stroke reads as phosphor bloom.
	label.TextStrokeColor3 = label.TextColor3
	label.TextStrokeTransparency = 0.88
	label.Parent = parent
	return label
end

function RetroUI.setColor(label: TextLabel | TextButton | TextBox, color: Color3)
	label.TextColor3 = color
	label.TextStrokeColor3 = color
end

----------------------------------------------------------------------------------------------------
-- Hover. Roblox's MouseEnter/MouseLeave miss quick moves (rows stay lit after the pointer has
-- gone) and never fire for rows rebuilt under a still pointer, so OfficeComputer works out what is
-- under the drawn pointer every frame and calls `setHovered`; widgets register with `hover`.

local hoverables: { [GuiObject]: (boolean) -> () } = setmetatable({}, { __mode = "k" }) :: any
-- Pointer and scanline frames sit on top of everything but must never catch the pointer.
local passThrough: { [GuiObject]: boolean } = setmetatable({}, { __mode = "k" }) :: any
local hovered: GuiObject? = nil

function RetroUI.hover(item: GuiObject, paint: (boolean) -> ())
	hoverables[item] = paint
end

function RetroUI.ignoreHover(item: GuiObject)
	passThrough[item] = true
end

function RetroUI.setHovered(item: GuiObject?)
	if item == hovered then
		return
	end
	local old = hovered
	hovered = item
	if old and hoverables[old] then
		hoverables[old](false)
	end
	if item and hoverables[item] then
		hoverables[item](true)
	end
end

local function outside(gui: GuiObject, point: Vector2): boolean
	local low = gui.AbsolutePosition
	local high = low + gui.AbsoluteSize
	return point.X < low.X or point.Y < low.Y or point.X >= high.X or point.Y >= high.Y
end

-- The widget the pointer is over: walks PlayerGui:GetGuiObjectsAtPosition's results (top-most
-- first) and stops at the first thing that would catch a click or hides what is behind it.
-- `point` is in the same GUI space as AbsolutePosition.
function RetroUI.hoverTarget(objects: { GuiObject }, point: Vector2): GuiObject?
	for _, object in objects do
		if passThrough[object] then
			continue
		end
		local found: GuiObject? = nil
		local clipped = false
		local node: Instance? = object
		while node and node:IsA("GuiObject") do
			local gui = node :: GuiObject
			if not found and hoverables[gui] then
				found = gui
			end
			if gui ~= object and gui.ClipsDescendants and outside(gui, point) then
				clipped = true -- scrolled out of its list
				break
			end
			node = node.Parent
		end
		if not clipped then
			if found then
				return found
			end
			if object.Active or object.BackgroundTransparency < 1 then
				return nil
			end
		end
	end
	return nil
end

export type Button = {
	Instance: TextButton,
	setEnabled: (Button, boolean) -> (),
	setSelected: (Button, boolean) -> (),
	setText: (Button, string) -> (),
}

-- A bordered phosphor button: inverse video on hover/selection, a bright flash on press.
function RetroUI.button(
	parent: Instance,
	name: string,
	text: string,
	position: UDim2,
	size: UDim2,
	onClick: () -> (),
	options: TextOptions?
): Button
	local opts = options or {}
	local item = Instance.new("TextButton")
	item.Name = name
	item.AutoButtonColor = false
	item.BackgroundColor3 = RetroUI.Colors.Bright
	item.BackgroundTransparency = 1
	item.BorderSizePixel = 0
	item.Position = position
	item.Size = size
	item.Font = opts.Font or RetroUI.Fonts.Body
	item.Text = text
	item.TextSize = opts.Size or 20
	item.TextXAlignment = opts.AlignX or Enum.TextXAlignment.Center
	item.TextTruncate = Enum.TextTruncate.AtEnd
	item.Parent = parent
	local stroke = RetroUI.border(item, RetroUI.Colors.Bright, 2)

	local enabled, selected, hovered = true, false, false
	local function paint()
		local inverse = enabled and (selected or hovered)
		item.BackgroundTransparency = if inverse then 0 else 1
		item.BackgroundColor3 = if hovered and not selected then RetroUI.Colors.Hot else RetroUI.Colors.Bright
		local color = if not enabled
			then RetroUI.Colors.Dim
			elseif inverse then RetroUI.Colors.Screen
			else RetroUI.Colors.Bright
		RetroUI.setColor(item, color)
		item.TextStrokeTransparency = if inverse then 1 else 0.88
		stroke.Color = if enabled then RetroUI.Colors.Bright else RetroUI.Colors.Dim
	end
	RetroUI.hover(item, function(value)
		hovered = value
		paint()
	end)
	-- Light up the moment the button goes down; the action itself runs on release.
	item.MouseButton1Down:Connect(function()
		if not enabled then
			return
		end
		item.BackgroundColor3 = RetroUI.Colors.Hot
		item.BackgroundTransparency = 0
		RetroUI.setColor(item, RetroUI.Colors.Screen)
		item.TextStrokeTransparency = 1
	end)
	item.MouseButton1Up:Connect(paint)
	item.Activated:Connect(function()
		if not enabled then
			return
		end
		item.BackgroundColor3 = RetroUI.Colors.Hot
		item.BackgroundTransparency = 0
		TweenService:Create(item, FAST, { BackgroundTransparency = if selected or hovered then 0 else 1 }):Play()
		onClick()
	end)
	paint()

	local button = { Instance = item }
	function button.setEnabled(_, value: boolean)
		enabled = value
		item.Active = value
		paint()
	end
	function button.setSelected(_, value: boolean)
		selected = value
		paint()
	end
	function button.setText(_, value: string)
		item.Text = value
	end
	return (button :: any) :: Button
end

function RetroUI.input(parent: Instance, name: string, position: UDim2, size: UDim2, text: string): TextBox
	local box = Instance.new("TextBox")
	box.Name = name
	box.BackgroundColor3 = RetroUI.Colors.Panel
	box.BackgroundTransparency = 0
	box.BorderSizePixel = 0
	box.Position = position
	box.Size = size
	box.ClearTextOnFocus = false
	box.Font = RetroUI.Fonts.Body
	box.Text = text
	box.TextSize = 22
	box.PlaceholderColor3 = RetroUI.Colors.Dim
	RetroUI.setColor(box, RetroUI.Colors.Hot)
	box.TextStrokeTransparency = 0.88
	box.Parent = parent
	RetroUI.border(box, RetroUI.Colors.Mid, 2)
	return box
end

function RetroUI.rule(parent: Instance, name: string, position: UDim2, width: UDim, color: Color3?): Frame
	return RetroUI.frame(parent, name, position, UDim2.new(width, UDim.new(0, 2)), {
		BackgroundTransparency = 0,
		BackgroundColor3 = color or RetroUI.Colors.Dim,
	})
end

-- Faint horizontal scanlines and a darker rim, laid over the whole canvas.
function RetroUI.scanlines(parent: Instance): Frame
	local overlay = RetroUI.frame(parent, "Scanlines", UDim2.new(), UDim2.fromScale(1, 1), { ZIndex = 50 })
	overlay.Active = false
	for y = 0, RetroUI.HEIGHT - 1, 4 do
		RetroUI.frame(overlay, "Line", UDim2.fromOffset(0, y), UDim2.new(1, 0, 0, 1), {
			BackgroundTransparency = 0.82,
			BackgroundColor3 = Color3.new(0, 0, 0),
			ZIndex = 50,
		})
	end
	local vignette = RetroUI.frame(overlay, "Rim", UDim2.new(), UDim2.fromScale(1, 1), {
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.new(0, 0, 0),
		ZIndex = 51,
	})
	local gradient = Instance.new("UIGradient")
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.55),
		NumberSequenceKeypoint.new(0.12, 1),
		NumberSequenceKeypoint.new(0.88, 1),
		NumberSequenceKeypoint.new(1, 0.55),
	})
	gradient.Parent = vignette
	passThrough[overlay] = true
	for _, item in overlay:GetDescendants() do
		if item:IsA("GuiObject") then
			passThrough[item] = true
		end
	end
	return overlay
end

-- Pixel-art mouse pointer: rows of a classic arrow, X outline and O phosphor fill.
local ARROW = {
	"X...........",
	"XX..........",
	"XOX.........",
	"XOOX........",
	"XOOOX.......",
	"XOOOOX......",
	"XOOOOOX.....",
	"XOOOOOOX....",
	"XOOOOOOOX...",
	"XOOOOOOOOX..",
	"XOOOOOXXXXX.",
	"XOOXOOX.....",
	"XOX.XOOX....",
	"XX..XOOX....",
	"X....XOOX...",
	".....XOOX...",
	"......XX....",
}

function RetroUI.cursor(parent: Instance, pixel: number): Frame
	local holder = RetroUI.frame(parent, "Cursor", UDim2.new(), UDim2.fromOffset(12 * pixel, #ARROW * pixel), {
		ZIndex = 100,
	})
	holder.Active = false
	for row, line in ARROW do
		-- One frame per run of the same pixel kind keeps the arrow to a few dozen frames.
		local col = 1
		while col <= #line do
			local kind = line:sub(col, col)
			local stop = col
			while stop < #line and line:sub(stop + 1, stop + 1) == kind do
				stop += 1
			end
			if kind ~= "." then
				RetroUI.frame(
					holder,
					"Px",
					UDim2.fromOffset((col - 1) * pixel, (row - 1) * pixel),
					UDim2.fromOffset((stop - col + 1) * pixel, pixel),
					{
						BackgroundTransparency = 0,
						BackgroundColor3 = if kind == "X" then RetroUI.Colors.Screen else RetroUI.Colors.Hot,
						ZIndex = 100,
					}
				)
			end
			col = stop + 1
		end
	end
	passThrough[holder] = true
	for _, item in holder:GetChildren() do
		passThrough[item :: GuiObject] = true
	end
	return holder
end

export type Chart = {
	Instance: Frame,
	set: (Chart, { number }) -> (number?, number?),
}

-- Line chart with a faint area fill and four grid lines. `set` redraws and returns the low/high.
function RetroUI.chart(parent: Instance, name: string, position: UDim2, size: Vector2): Chart
	local holder = RetroUI.frame(parent, name, position, UDim2.fromOffset(size.X, size.Y), {
		ClipsDescendants = true,
	})
	RetroUI.border(holder, RetroUI.Colors.Dim, 2)
	for index = 1, 3 do
		RetroUI.frame(holder, "Grid", UDim2.fromOffset(0, math.floor(size.Y * index / 4)), UDim2.new(1, 0, 0, 1), {
			BackgroundTransparency = 0.4,
			BackgroundColor3 = RetroUI.Colors.Dim,
		})
	end
	local bars: { Frame } = {}
	local segments: { Frame } = {}
	local empty = RetroUI.text(holder, "Empty", "LOADING...", UDim2.new(), UDim2.fromScale(1, 1), {
		AlignX = Enum.TextXAlignment.Center,
		Color = RetroUI.Colors.Mid,
		Size = 18,
	})

	local chart = { Instance = holder }
	function chart.set(_, points: { number }): (number?, number?)
		local count = #points
		empty.Visible = count < 2
		if count < 2 then
			for _, item in segments do
				item.Visible = false
			end
			for _, item in bars do
				item.Visible = false
			end
			return nil, nil
		end
		local low, high = math.huge, -math.huge
		for _, value in points do
			low, high = math.min(low, value), math.max(high, value)
		end
		local span = math.max(high - low, high * 0.002, 0.01)
		local pad = 10
		local function at(index: number): Vector2
			local x = (index - 1) / (count - 1) * (size.X - 4) + 2
			local y = pad + (1 - (points[index] - low) / span) * (size.Y - pad * 2)
			return Vector2.new(x, y)
		end
		local step = (size.X - 4) / (count - 1)
		for index = 1, count do
			local point = at(index)
			local bar = bars[index]
			if not bar then
				bar = RetroUI.frame(holder, "Fill", UDim2.new(), UDim2.new(), {
					BackgroundTransparency = 0.86,
					BackgroundColor3 = RetroUI.Colors.Bright,
				})
				bars[index] = bar
			end
			bar.Visible = true
			bar.Position = UDim2.fromOffset(point.X - step / 2, point.Y)
			bar.Size = UDim2.fromOffset(math.ceil(step) + 1, size.Y - point.Y)
			if index < count then
				local nextPoint = at(index + 1)
				local delta = nextPoint - point
				local segment = segments[index]
				if not segment then
					segment = RetroUI.frame(holder, "Line", UDim2.new(), UDim2.new(), {
						BackgroundTransparency = 0,
						BackgroundColor3 = RetroUI.Colors.Bright,
						AnchorPoint = Vector2.new(0.5, 0.5),
						ZIndex = 2,
					})
					segments[index] = segment
				end
				segment.Visible = true
				local middle = (point + nextPoint) / 2
				segment.Position = UDim2.fromOffset(middle.X, middle.Y)
				segment.Size = UDim2.fromOffset(delta.Magnitude + 1, 2)
				segment.Rotation = math.deg(math.atan2(delta.Y, delta.X))
			end
		end
		for index = count + 1, #bars do
			bars[index].Visible = false
		end
		for index = count, #segments do
			segments[index].Visible = false
		end
		return low, high
	end
	return (chart :: any) :: Chart
end

return RetroUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="346">
          <Properties>
            <string name="Name">RodCaseOpening</string>
            <string name="Source"><![CDATA[-- The paid case remains in the player's inventory until the server opens it.
-- This screen only animates a reward that the server has already awarded.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local FishingRod = require(Shared:WaitForChild("FishingRod"))
local RodSkins = require(Shared:WaitForChild("RodSkins"))

local RodCaseOpening = {}

function RodCaseOpening.create(overlay, onOpen, onBack)
	local panel = Instance.new("Frame")
	panel.Name = "RodCaseOpening"
	panel.Active = true
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(760, 470)
	panel.Visible = false
	panel.Parent = overlay
	Theme.window(panel)
	local scale = Instance.new("UIScale")
	scale.Parent = panel
	local function label(parent, name, text, pos, size, textSize, color)
		local item = Instance.new("TextLabel")
		item.Name = name
		item.BackgroundTransparency = 1
		item.Position, item.Size = pos, size
		item.Text, item.TextSize = text, textSize
		item.TextWrapped = true
		item.TextXAlignment = Enum.TextXAlignment.Center
		Theme.text(item, color or Theme.Colors.Text)
		item.Parent = parent
		return item
	end
	local function button(name, text, pos, size)
		local item = Instance.new("TextButton")
		item.Name, item.Text = name, text
		item.Position, item.Size = pos, size
		item.TextSize = 16
		item.Parent = panel
		Theme.button(item, "Selected")
		return item
	end
	local title = label(panel, "Title", "", UDim2.fromOffset(32, 20), UDim2.new(1, -64, 0, 36), 25)
	local subtitle =
		label(panel, "Subtitle", "", UDim2.fromOffset(32, 58), UDim2.new(1, -64, 0, 30), 14, Theme.Colors.Muted)
	local reel = Instance.new("Frame")
	reel.Name = "Reel"
	reel.Position = UDim2.fromOffset(28, 120)
	reel.Size = UDim2.new(1, -56, 0, 180)
	reel.BackgroundColor3 = Theme.Colors.Inset
	reel.ClipsDescendants = true
	reel.BorderSizePixel = 0
	reel.Parent = panel
	Theme.corner(reel, 8)
	local strip = Instance.new("Frame")
	strip.Name = "Strip"
	strip.BackgroundTransparency = 1
	strip.Size = UDim2.fromOffset(30 * 164, 180)
	strip.Parent = reel
	local marker = Instance.new("Frame")
	marker.Name = "Marker"
	marker.AnchorPoint = Vector2.new(0.5, 0)
	marker.Position = UDim2.fromScale(0.5, 0)
	marker.Size = UDim2.new(0, 3, 1, 0)
	marker.BackgroundColor3 = Color3.fromRGB(244, 196, 76)
	marker.BorderSizePixel = 0
	marker.ZIndex = 3
	marker.Parent = reel
	local inspect = Instance.new("ViewportFrame")
	inspect.Name = "InspectRod"
	inspect.Position = UDim2.fromOffset(28, 98)
	inspect.Size = UDim2.new(1, -56, 0, 220)
	inspect.BackgroundColor3 = Theme.Colors.Inset
	inspect.BorderSizePixel = 0
	inspect.Ambient = Color3.fromRGB(175, 180, 190)
	inspect.LightColor = Color3.fromRGB(255, 241, 216)
	inspect.LightDirection = Vector3.new(-1, -1, -2)
	inspect.Visible = false
	inspect.Active = true
	inspect.Parent = panel
	Theme.corner(inspect, 8)
	local description =
		label(panel, "Description", "", UDim2.fromOffset(28, 320), UDim2.new(1, -56, 0, 52), 14, Theme.Colors.Muted)
	local open = button("OpenCase", "OPEN CASE", UDim2.new(0.5, -110, 1, -66), UDim2.fromOffset(220, 42))
	local back = button("Back", "BACK", UDim2.fromOffset(24, 1), UDim2.fromOffset(100, 35))
	back.Position = UDim2.new(0, 24, 1, -62)
	local currentId, busy = nil, false
	local generation = 0
	local displayModel, basePivot = nil, nil
	local angle = 0
	local dragging = false
	local lastX = 0

	local function clearInspect()
		for _, child in inspect:GetChildren() do
			if child:IsA("WorldModel") or child:IsA("Camera") then
				child:Destroy()
			end
		end
		displayModel, basePivot = nil, nil
	end
	local function inspectReward(reward)
		clearInspect()
		local world = Instance.new("WorldModel")
		world.Parent = inspect
		local rod = FishingRod.build(reward.SkinId, nil, reward.Wear)
		CollectionService:RemoveTag(rod, "FishingRod")
		rod.Enabled = false
		local model = Instance.new("Model")
		model.Name = "Reward"
		model.Parent = world
		for _, part in rod:GetDescendants() do
			if part:IsA("BasePart") then
				part.Anchored = true
			end
		end
		rod.Parent = model
		local center, size = model:GetBoundingBox()
		model:PivotTo(CFrame.Angles(0, math.rad(-12), math.rad(-75)) * center:Inverse() * model:GetPivot())
		local camera = Instance.new("Camera")
		camera.FieldOfView = 30
		camera.Parent = inspect
		inspect.CurrentCamera = camera
		local aspect = math.max(0.5, inspect.AbsoluteSize.X / math.max(1, inspect.AbsoluteSize.Y))
		local distance = math.max(math.max(size.X, size.Y) * 0.65 / aspect, size.Z) / math.tan(math.rad(15))
		camera.CFrame = CFrame.lookAt(Vector3.new(0, 0, distance), Vector3.zero)
		displayModel, basePivot, angle = model, model:GetPivot(), 0
	end
	local function makeReel(crateId, winner)
		strip:ClearAllChildren()
		local crate = RodSkins.Crates[crateId]
		for i = 1, 30 do
			local skinId = if i == 26 and winner then winner else crate.Skins[math.random(1, #crate.Skins)]
			local rarity = RodSkins.rarity(skinId, crateId)
			local rgb = RodSkins.Rarities[rarity].Color
			local color = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
			local card = Instance.new("Frame")
			card.Name = "Item" .. i
			card.Position = UDim2.fromOffset((i - 1) * 164 + 4, 12)
			card.Size = UDim2.fromOffset(156, 156)
			card.BackgroundColor3 = Theme.Colors.Panel
			card.BorderSizePixel = 0
			card.Parent = strip
			Theme.corner(card, 6)
			local bar = Instance.new("Frame")
			bar.Size = UDim2.new(1, 0, 0, 5)
			bar.BackgroundColor3 = color
			bar.BorderSizePixel = 0
			bar.Parent = card

			local thumbnail = Instance.new("ViewportFrame")
			thumbnail.Name = "Rod"
			thumbnail.Position = UDim2.fromOffset(6, 10)
			thumbnail.Size = UDim2.new(1, -12, 0, 65)
			thumbnail.BackgroundTransparency = 1
			thumbnail.Ambient = Color3.fromRGB(165, 170, 175)
			thumbnail.LightColor = Color3.fromRGB(255, 241, 216)
			thumbnail.LightDirection = Vector3.new(-1, -1, -2)
			thumbnail.Parent = card
			local world = Instance.new("WorldModel")
			world.Parent = thumbnail
			local rod = FishingRod.build(skinId)
			CollectionService:RemoveTag(rod, "FishingRod")
			rod.Enabled = false
			local model = Instance.new("Model")
			model.Parent = world
			for _, part in rod:GetDescendants() do
				if part:IsA("BasePart") then
					part.Anchored = true
				end
			end
			rod.Parent = model
			local center, size = model:GetBoundingBox()
			model:PivotTo(CFrame.Angles(0, math.rad(-12), math.rad(-75)) * center:Inverse() * model:GetPivot())
			local camera = Instance.new("Camera")
			camera.FieldOfView = 30
			camera.Parent = thumbnail
			thumbnail.CurrentCamera = camera
			local distance = math.max(math.max(size.X, size.Y) * 0.65 / (144 / 65), size.Z) / math.tan(math.rad(15))
			camera.CFrame = CFrame.lookAt(Vector3.new(0, 0, distance), Vector3.zero)
			label(card, "Name", RodSkins.Skins[skinId].Name, UDim2.fromOffset(8, 76), UDim2.new(1, -16, 0, 38), 15)
			label(card, "Rarity", string.upper(rarity), UDim2.fromOffset(5, 120), UDim2.new(1, -10, 0, 24), 12, color)
		end
		strip.Position = UDim2.fromOffset(0, 0)
	end
	local api = {}
	function api.show(crateId, count)
		generation += 1
		currentId, busy = crateId, false
		panel.Visible, reel.Visible, inspect.Visible = true, true, false
		clearInspect()
		makeReel(crateId)
		title.TextColor3 = Theme.Colors.Text
		title.Text = RodSkins.Crates[crateId].Name
		subtitle.Text = string.format("YOU OWN %d  ·  NO KEY REQUIRED", count)
		description.Text = "Open your case to reveal one rod skin. Its wear affects its appearance and bonuses."
		open.Text = "OPEN CASE"
		open.Active, open.Selectable = count > 0, count > 0
		Theme.button(open, if count > 0 then "Selected" else "Disabled")
		back.Text = "BACK"
	end
	function api.hide()
		generation += 1
		panel.Visible, busy = false, false
		dragging = false
		clearInspect()
	end
	function api.setPending()
		busy = true
		open.Active, open.Selectable = false, false
		open.Text = "OPENING…"
		Theme.button(open, "Disabled")
		return generation
	end
	function api.isPending(token)
		return panel.Visible and busy and generation == token
	end
	function api.failed(message, count)
		busy = false
		subtitle.Text = message
		open.Text = "OPEN CASE"
		open.Active, open.Selectable = count > 0, count > 0
		Theme.button(open, if count > 0 then "Selected" else "Disabled")
	end
	function api.reveal(reward)
		generation += 1
		local run = generation
		busy = true
		makeReel(currentId, reward.SkinId)
		subtitle.Text = "UNBOXING…"
		open.Text = "OPENING…"
		local endX = 704 / 2 - (25 * 164 + 82)
		local animation = TweenService:Create(
			strip,
			TweenInfo.new(5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{ Position = UDim2.fromOffset(endX, 0) }
		)
		animation:Play()
		task.delay(5.3, function()
			if generation ~= run or not panel.Visible then
				return
			end
			busy = false
			reel.Visible, inspect.Visible = false, true
			inspectReward(reward)
			local rarity = RodSkins.rarity(reward.SkinId, currentId)
			local rgb = RodSkins.Rarities[rarity].Color
			title.Text = RodSkins.Skins[reward.SkinId].Name
			title.TextColor3 = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
			subtitle.Text = string.upper(rarity)
				.. (if reward.Serial then string.format("  ·  #%06d", reward.Serial) else "")
			local wear = if type(reward.Wear) == "number" then reward.Wear else 0.2
			local wearName = RodSkins.wearState(wear)
			description.Text = string.format(
				"%s  ·  Wear %.4f\n%s\nDrag to rotate",
				wearName,
				wear,
				table.concat(RodSkins.perks(reward.SkinId, wear), "   ·   ")
			)
			open.Text = "DONE"
			open.Active, open.Selectable = true, true
			Theme.button(open, "Selected")
			back.Text = "BACK"
		end)
	end
	open.Activated:Connect(function()
		if busy or not open.Active then
			return
		end
		if inspect.Visible then
			title.TextColor3 = Theme.Colors.Text
			onBack()
		else
			onOpen(currentId)
		end
	end)
	back.Activated:Connect(function()
		if not busy then
			title.TextColor3 = Theme.Colors.Text
			onBack()
		end
	end)
	inspect.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging, lastX = true, input.Position.X
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if
			dragging
			and (
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			)
		then
			angle += (input.Position.X - lastX) * 0.01
			lastX = input.Position.X
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging = false
		end
	end)
	RunService.RenderStepped:Connect(function()
		if displayModel and basePivot and panel.Visible then
			displayModel:PivotTo(CFrame.Angles(0, angle, 0) * basePivot)
		end
		local camera = workspace.CurrentCamera
		if camera and panel.Visible then
			scale.Scale =
				math.max(0.3, math.min(1, (camera.ViewportSize.X - 24) / 760, (camera.ViewportSize.Y - 40) / 470))
		end
	end)
	return api
end

return RodCaseOpening
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="347">
          <Properties>
            <string name="Name">RodCrateReveal</string>
            <string name="Source"><![CDATA[-- Local shop animation: every angler sees their own saved reward emerge from the stand.
local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local FishingRod = require(ReplicatedStorage.Shared.FishingRod)
local Freecam = require(script.Parent.Freecam)

local Reveal = {}
local ACTION = "RodCrateRevealMovement"

local function ease(value: number): number
	local alpha = math.clamp(value, 0, 1)
	return alpha * alpha * (3 - 2 * alpha)
end

function Reveal.play(
	stand: BasePart?,
	skinId: string,
	onReward: () -> (),
	onFinished: () -> (),
	makeReward: (() -> Model)?,
	rewardScaleOverride: number?
): (() -> ())?
	local crate = stand and stand.Parent
	local lid = crate and (crate:FindFirstChild("RodCrateLid") or crate:FindFirstChild("BobberCrateLid") or crate:FindFirstChild("SpearCrateLid"))
	local origin = crate and crate:GetAttribute("CrateFrame")
	local hinge = crate and crate:GetAttribute("LidHinge")
	local camera = workspace.CurrentCamera
	if
		not crate
		or not lid
		or not lid:IsA("Model")
		or typeof(origin) ~= "CFrame"
		or typeof(hinge) ~= "CFrame"
		or not camera
	then
		return nil
	end

	local player = Players.LocalPlayer
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if
		not root
		or not root:IsA("BasePart")
		or not humanoid
		or humanoid.Health <= 0
		or not crate:IsDescendantOf(workspace)
		or (root.Position - origin.Position).Magnitude > 18
	then
		return nil
	end
	Freecam.stop()
	local closed = lid:GetPivot()
	local hingeOffset = hinge:ToObjectSpace(closed)
	local saved = {
		kind = camera.CameraType,
		subject = camera.CameraSubject,
		frame = camera.CFrame,
		focus = camera.Focus,
		fov = camera.FieldOfView,
		prompts = ProximityPromptService.Enabled,
	}
	local reward: Model
	local rewardScale = rewardScaleOverride or (if makeReward then 5 else 1)
	if makeReward then
		reward = makeReward()
	else
		local rod = FishingRod.build(skinId)
		CollectionService:RemoveTag(rod, "FishingRod")
		rod.Enabled = false
		reward = Instance.new("Model")
		reward.Name = "UnboxedRod"
		rod.Parent = reward
		reward.PrimaryPart = rod:FindFirstChild("Handle") :: BasePart
	end
	for _, part in reward:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
		end
	end
	reward:ScaleTo(0.15 * rewardScale)
	reward:PivotTo(origin * CFrame.new(0, 1.45, 0))
	-- Keep it out of Workspace until the lid has opened.
	local connection: RBXScriptConnection?
	local finished, announced = false, false
	local elapsed = 0
	local hidden = {}
	local function stop()
		if finished then
			return
		end
		finished = true
		if connection then
			connection:Disconnect()
		end
		reward:Destroy()
		if lid.Parent then
			lid:PivotTo(closed)
		end
		ContextActionService:UnbindAction(ACTION)
		ProximityPromptService.Enabled = saved.prompts
		for part, transparency in hidden do
			if part.Parent then
				part.LocalTransparencyModifier = transparency
			end
		end
		if workspace.CurrentCamera == camera then
			local currentCharacter = player.Character
			local humanoid = currentCharacter and currentCharacter:FindFirstChildOfClass("Humanoid")
			camera.CameraSubject = if saved.subject and saved.subject.Parent then saved.subject else humanoid
			camera.CFrame, camera.Focus = saved.frame, saved.focus
			camera.FieldOfView = saved.fov
			camera.CameraType = saved.kind
		end
		onFinished()
	end

	ContextActionService:BindActionAtPriority(ACTION, function()
		return Enum.ContextActionResult.Sink
	end, false, 3000, unpack(Enum.PlayerActions:GetEnumItems()))
	ProximityPromptService.Enabled = false
	-- The angler can stand directly between the camera and the crate.
	for _, part in character:GetDescendants() do
		if part:IsA("BasePart") then
			hidden[part] = part.LocalTransparencyModifier
			part.LocalTransparencyModifier = 1
		end
	end
	camera.CameraType = Enum.CameraType.Scriptable
	connection = RunService.RenderStepped:Connect(function(dt)
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if
			player.Character ~= character
			or not root
			or not root:IsA("BasePart")
			or not humanoid
			or humanoid.Health <= 0
			or not crate:IsDescendantOf(workspace)
			or not lid.Parent
			or workspace.CurrentCamera ~= camera
			or (root.Position - origin.Position).Magnitude > 18
		then
			stop()
			return
		end
		elapsed += dt
		local aspect = camera.ViewportSize.X / math.max(1, camera.ViewportSize.Y)
		local eye = origin * Vector3.new(3.5, 5.6, -math.max(12, 5 / math.max(0.3, aspect)))
		local target = origin * Vector3.new(0, 4.6, 0)
		local shot = CFrame.lookAt(eye, target)
		local enter = ease(elapsed / 0.45)
		local leave = ease((elapsed - 5.1) / 0.4)
		camera.CFrame = saved.frame:Lerp(shot, enter):Lerp(saved.frame, leave)
		camera.Focus = CFrame.new(target)
		camera.FieldOfView = saved.fov + (48 - saved.fov) * enter * (1 - leave)

		local opening = ease((elapsed - 0.45) / 0.75)
		local closing = ease((elapsed - 4.65) / 0.45)
		lid:PivotTo(hinge * CFrame.Angles(math.rad(110) * opening * (1 - closing), 0, 0) * hingeOffset)
		if elapsed >= 1.25 and elapsed < 4.65 then
			local rise = ease((elapsed - 1.25) / 1.1)
			reward:ScaleTo((0.15 + 0.85 * rise) * rewardScale)
			reward:PivotTo(
				origin * CFrame.new(0, 1.45 + 1.95 * rise, -0.12) * CFrame.Angles(0, (elapsed - 1.25) * 0.65, 0)
			)
			reward.Parent = workspace
		elseif elapsed >= 4.65 then
			reward.Parent = nil
		end
		if elapsed >= 2.35 and not announced then
			announced = true
			onReward()
		end
		if elapsed >= 5.5 then
			stop()
		end
	end)
	return stop
end

return Reveal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="348">
          <Properties>
            <string name="Name">RodCrates</string>
            <string name="Source"><![CDATA[-- Rod and bobber cases in Tide & Tackle share the same catalog-driven window.
-- The server rolls, charges and saves; this module presents owned skins and
-- plays the unboxing reveal at the matching stand.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local FishingRod = require(Shared:WaitForChild("FishingRod"))
local RodSkins = require(Shared:WaitForChild("RodSkins"))
local BobberSkins = require(Shared:WaitForChild("BobberSkins"))
local SpearSkins = require(Shared:WaitForChild("SpearSkins"))
local Spears = require(Shared:WaitForChild("Spears"))
local FishingBobber = require(Shared:WaitForChild("FishingBobber"))
local CrateReveal = require(script.Parent:WaitForChild("RodCrateReveal"))
local RodCaseOpening = require(script.Parent:WaitForChild("RodCaseOpening"))

local RodCrates = {}
local started = false

local WIDTH, HEIGHT = 760, 698
local CARD_WIDTH, CARD_HEIGHT, CARD_GAP = 170, 220, 10
local GOLD = Color3.fromRGB(244, 196, 76)
local AFFORD = Color3.fromRGB(111, 202, 125)
local SHORT = Color3.fromRGB(238, 107, 111)

local function rarityColor(rarity: string): Color3
	local rgb = RodSkins.Rarities[rarity].Color
	return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

local function hex(color: Color3): string
	return string.format(
		"#%02x%02x%02x",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

local function commas(value: number): string
	local text = tostring(math.floor(value))
	while true do
		local replaced, count = text:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
		text = replaced
		if count == 0 then
			return text
		end
	end
end

local function percent(chance: number): string
	local value = chance * 100
	return if value >= 1
		then string.format("%g%%", math.floor(value * 100 + 0.5) / 100)
		else string.format("%.2g%%", value)
end

-- A still, anchored copy of the real skin, so the card shows exactly what the angler will hold.
local function preview(parent: GuiObject, skinId: string, kind: string)
	local view = Instance.new("ViewportFrame")
	view.Name = "SkinPreview"
	view.BackgroundTransparency = 1
	view.Position = UDim2.fromOffset(6, 10)
	view.Size = UDim2.new(1, -12, 0, 78)
	view.Ambient = Color3.fromRGB(165, 170, 175)
	view.LightColor = Color3.fromRGB(255, 241, 216)
	view.LightDirection = Vector3.new(-1, -1, -2)
	view.Parent = parent
	local world = Instance.new("WorldModel")
	world.Parent = view
	local bobber = kind == "Bobber"
	local rod = if bobber then FishingBobber.build(skinId) elseif kind == "Spear" then Spears.build(skinId) else FishingRod.build(skinId)
	-- Preview tools must never join the live rod animation/tag listeners.
	if kind == "Rod" then
		CollectionService:RemoveTag(rod, "FishingRod")
		rod.Enabled = false
	end
	local model = Instance.new("Model")
	model.Name = "DisplayRod"
	model.Parent = world
	for _, part in rod:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
		end
	end
	rod.Parent = model
	-- Lay the rod on its side, butt to the left.
	local center, size = model:GetBoundingBox()
	model:PivotTo(
		CFrame.Angles(0, math.rad(-12), if bobber then 0 else math.rad(-75)) * center:Inverse() * model:GetPivot()
	)
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	camera.Parent = view
	view.CurrentCamera = camera
	local function frame()
		local aspect = math.max(0.5, view.AbsoluteSize.X / math.max(1, view.AbsoluteSize.Y))
		local length = math.max(size.X, size.Y) * (if bobber then 1.3 else 1)
		local distance = math.max(length * 0.62 / aspect, if bobber then length * 0.62 else 0, size.Z)
			/ math.tan(math.rad(15))
		camera.CFrame = CFrame.lookAt(Vector3.new(0, 0, distance), Vector3.zero)
	end
	view:GetPropertyChangedSignal("AbsoluteSize"):Connect(frame)
	frame()
end

local function startShop(RodSkins, kind: string)
	local bobber = kind == "Bobber"
	local spear = kind == "Spear"
	local rod = kind == "Rod"
	local openAction = "Open" .. kind .. "Crate"
	local buyAction = "BuyRodCrate"
	local ownedAction = "OpenOwnedRodCrate"
	local equipAction = "Equip" .. kind .. "Skin"
	local openEvent = if bobber then "OpenBobberCrates" elseif spear then "OpenSpearCrates" else "OpenCrates"
	local resultEvent = if bobber then "BobberCrateResult" elseif spear then "SpearCrateResult" else "CrateResult"
	local skinEvent = if bobber then "BobberSkinResult" elseif spear then "SpearSkinResult" else "SkinResult"
	local skinAttribute = kind .. "Skin"
	local countAttribute = kind .. "SkinCount"
	local player = Players.LocalPlayer
	local remotes = ReplicatedStorage:WaitForChild("Fishing")
	local request = remotes:WaitForChild("Request") :: RemoteEvent
	local feedback = remotes:WaitForChild("Feedback") :: RemoteEvent
	local cream, muted = Theme.Colors.Text, Theme.Colors.Muted
	local crateId = RodSkins.CrateOrder[1]
	local crate = RodSkins.Crates[crateId]

	local gui = Instance.new("ScreenGui")
	gui.Name = kind .. "Crates"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 23
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	local function label(parent: Instance, text: string, position: UDim2, size: UDim2, textSize: number, color: Color3)
		local item = Instance.new("TextLabel")
		item.BackgroundTransparency = 1
		item.Position, item.Size = position, size
		item.Text, item.TextSize = text, textSize
		item.TextWrapped = true
		item.TextXAlignment = Enum.TextXAlignment.Left
		Theme.text(item, color)
		item.Parent = parent
		return item
	end
	local function frame(parent: Instance, name: string, position: UDim2, size: UDim2, color: Color3): Frame
		local item = Instance.new("Frame")
		item.Name = name
		item.Position, item.Size = position, size
		item.BackgroundColor3 = color
		item.BorderSizePixel = 0
		item.Parent = parent
		return item
	end
	local function gradient(parent: Instance, top: Color3, bottom: Color3)
		local fill = Instance.new("UIGradient")
		fill.Rotation = 90
		fill.Color = ColorSequence.new(top, bottom)
		fill.Parent = parent
		return fill
	end
	local function button(parent: Instance, name: string, text: string, position: UDim2, size: UDim2): TextButton
		local item = Instance.new("TextButton")
		item.Name = name
		item.Position, item.Size = position, size
		item.Text = text
		item.TextSize = 14
		item.TextWrapped = true
		item.RichText = true
		item.Parent = parent
		Theme.button(item, "Selected")
		return item
	end

	local overlay = Instance.new("TextButton")
	overlay.Name = "CrateOverlay"
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = Color3.new(0, 0, 0)
	overlay.BackgroundTransparency = 0.45
	overlay.Text = ""
	overlay.AutoButtonColor = false
	overlay.Visible = false
	overlay.Parent = gui

	local window = Instance.new("Frame")
	window.Name = kind .. "CrateWindow"
	window.Active = true
	window.AnchorPoint = Vector2.new(0.5, 0.5)
	window.Position = UDim2.fromScale(0.5, 0.5)
	window.Size = UDim2.fromOffset(WIDTH, HEIGHT)
	window.Parent = overlay
	Theme.window(window)
	local scale = Instance.new("UIScale")
	scale.Parent = window

	-- Header: crate name, odds summary and the angler's wallet.
	local header = frame(window, "Header", UDim2.fromOffset(14, 14), UDim2.new(1, -28, 0, 96), Color3.new(1, 1, 1))
	Theme.corner(header, 8)
	gradient(header, Color3.fromRGB(86, 52, 120), Color3.fromRGB(40, 26, 66))
	label(
		header,
		"TIDE & TACKLE · " .. (if bobber then "BOBBERS" elseif spear then "SPEAR CRATES" else "ROD CRATES"),
		UDim2.fromOffset(18, 12),
		UDim2.fromOffset(360, 18),
		13,
		GOLD
	)
	local title = label(header, crate.Name, UDim2.fromOffset(18, 30), UDim2.fromOffset(360, 32), 26, cream)
	local oddsLine = label(header, "", UDim2.fromOffset(18, 64), UDim2.new(1, -220, 0, 20), 13, muted)
	oddsLine.RichText = true
	oddsLine.Font = Enum.Font.GothamMedium
	local wallet = frame(header, "Wallet", UDim2.new(1, -196, 0, 24), UDim2.fromOffset(150, 46), Theme.Colors.Inset)
	Theme.panel(wallet, true, 23)
	label(wallet, "WALLET", UDim2.fromOffset(16, 4), UDim2.new(1, -24, 0, 14), 11, muted)
	local cash = label(wallet, "$0", UDim2.fromOffset(16, 18), UDim2.new(1, -24, 0, 24), 20, AFFORD)

	local close = Instance.new("TextButton")
	close.Name = "CloseCrates"
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(1, -6, 0, 6)
	close.Size = UDim2.fromOffset(34, 34)
	close.Text = "×"
	close.TextSize = 24
	close.ZIndex = 4
	close.Parent = header
	Theme.button(close, "Danger")

	-- Each crate has its own reward grid; selecting a tab also changes the purchase.
	local tabs = frame(window, "CrateTabs", UDim2.fromOffset(14, 122), UDim2.new(1, -28, 0, 32), Color3.new())
	tabs.BackgroundTransparency = 1
	local crateViews = {}
	for crateIndex, optionId in RodSkins.CrateOrder do
		local option = RodSkins.Crates[optionId]
		local tab = button(
			tabs,
			"Select" .. optionId,
			string.format("%s · $%s", option.Name, commas(option.Price)),
			UDim2.new((crateIndex - 1) / #RodSkins.CrateOrder, 0, 0, 0),
			UDim2.new(1 / #RodSkins.CrateOrder, -8, 1, 0)
		)
		local cards = {}
		local grid = frame(
			window,
			"Skins" .. optionId,
			UDim2.fromOffset(14, 164),
			UDim2.new(1, -28, 0, CARD_HEIGHT * 2 + CARD_GAP),
			Color3.new()
		)
		grid.BackgroundTransparency = 1
		local layout = Instance.new("UIGridLayout")
		layout.CellSize = UDim2.fromOffset(CARD_WIDTH, CARD_HEIGHT)
		layout.CellPadding = UDim2.fromOffset(CARD_GAP, CARD_GAP)
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = grid
		for index, skinId in option.Skins do
			local skin = RodSkins.Skins[skinId]
			local skinRarity = RodSkins.rarity(skinId, optionId)
			local color = rarityColor(skinRarity)
			local card = frame(grid, skinId, UDim2.new(), UDim2.new(), Theme.Colors.Panel)
			card.LayoutOrder = index
			Theme.panel(card, false, 8)
			local stripe = frame(card, "Accent", UDim2.fromScale(0, 0), UDim2.new(1, 0, 0, 5), color)
			Theme.corner(stripe, 8)
			local glow = frame(card, "Glow", UDim2.fromOffset(0, 5), UDim2.new(1, 0, 0, 80), color)
			glow.BackgroundTransparency = 0.85
			local fade = gradient(glow, Color3.new(1, 1, 1), Color3.new(1, 1, 1))
			fade.Transparency = NumberSequence.new(0, 1)
			preview(card, skinId, kind)
			label(card, skin.Name, UDim2.fromOffset(10, 88), UDim2.new(1, -20, 0, 20), 15, cream)
			local rarity = label(
				card,
				string.format("%s · %s", string.upper(skinRarity), percent(RodSkins.chance(optionId, skinId))),
				UDim2.fromOffset(10, 107),
				UDim2.new(1, -20, 0, 14),
				11,
				color
			)
			rarity.Font = Enum.Font.GothamBold
			local perks = label(
				card,
				table.concat(if rod then RodSkins.previewPerks(skinId) else RodSkins.perks(skinId), "\n"),
				UDim2.fromOffset(10, 123),
				UDim2.new(1, -20, 0, 60),
				11,
				muted
			)
			perks.Font = Enum.Font.GothamMedium
			perks.TextYAlignment = Enum.TextYAlignment.Top
			local equip = button(card, "Equip" .. skinId, "", UDim2.new(0, 8, 1, -34), UDim2.new(1, -16, 0, 28))
			cards[skinId] = { card = card, glow = glow, equip = equip }
		end
		crateViews[optionId] = { tab = tab, grid = grid, cards = cards }
	end

	local footer = frame(window, "Footer", UDim2.new(0, 14, 1, -84), UDim2.new(1, -28, 0, 70), Color3.new())
	footer.BackgroundTransparency = 1
	local status = label(footer, "", UDim2.fromOffset(0, 0), UDim2.new(1, -414, 0, 36), 13, muted)
	status.Font = Enum.Font.GothamMedium
	status.TextYAlignment = Enum.TextYAlignment.Top
	local plain = button(
		footer,
		"UseStarterLook",
		if bobber then "Use starter bobber" elseif spear then "Use starter spear look" else "Use starter rod look",
		UDim2.fromOffset(0, 40),
		UDim2.fromOffset(200, 28)
	)
	local openOwned = if rod
		then button(footer, "OpenOwnedCase", "", UDim2.fromOffset(204, 40), UDim2.fromOffset(190, 28))
		else nil
	local opens = {}
	for index, count in { 1, 3, 10 } do
		local open = button(
			footer,
			if count == 1 then openAction else openAction .. count,
			"",
			UDim2.new(1, -402 + (index - 1) * 136, 0, 4),
			UDim2.fromOffset(130, 60)
		)
		open.TextSize = 15
		opens[count] = open
	end

	local results =
		frame(overlay, "CrateResults", UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(480, 410), Theme.Colors.Inset)
	results.AnchorPoint = Vector2.new(0.5, 0.5)
	results.Visible = false
	results.ZIndex = 10
	Theme.panel(results, true, 8)
	local resultsScale = Instance.new("UIScale")
	resultsScale.Parent = results
	local resultsTitle = label(results, "YOUR REWARDS", UDim2.fromOffset(20, 12), UDim2.new(1, -40, 0, 30), 22, cream)
	resultsTitle.ZIndex = 11
	local resultsText = label(results, "", UDim2.fromOffset(20, 48), UDim2.new(1, -40, 0, 302), 16, cream)
	resultsText.RichText = true
	resultsText.TextYAlignment = Enum.TextYAlignment.Top
	resultsText.ZIndex = 11
	local resultsClose = button(results, "CloseResults", "DONE", UDim2.new(0.5, -90, 1, -48), UDim2.fromOffset(180, 36))
	resultsClose.ZIndex = 11

	-- A small reward caption stays outside the closed menu during the shop animation.
	local reveal =
		frame(gui, "RewardCaption", UDim2.new(0.5, 0, 1, -32), UDim2.fromOffset(520, 116), Theme.Colors.Inset)
	reveal.AnchorPoint = Vector2.new(0.5, 1)
	reveal.BackgroundTransparency = 0.2
	reveal.Visible = false
	reveal.ZIndex = 6
	Theme.corner(reveal, 8)
	local rewardScale = Instance.new("UIScale")
	rewardScale.Parent = reveal
	local revealName = label(reveal, "", UDim2.fromOffset(16, 8), UDim2.new(1, -32, 0, 32), 26, cream)
	revealName.TextXAlignment = Enum.TextXAlignment.Center
	revealName.ZIndex = 7
	local revealRarity = label(reveal, "", UDim2.fromOffset(16, 41), UDim2.new(1, -32, 0, 20), 14, muted)
	revealRarity.TextXAlignment = Enum.TextXAlignment.Center
	revealRarity.Font = Enum.Font.GothamBold
	revealRarity.ZIndex = 7
	local revealPerks = label(reveal, "", UDim2.fromOffset(16, 66), UDim2.new(1, -32, 0, 44), 13, muted)
	revealPerks.TextXAlignment = Enum.TextXAlignment.Center
	revealPerks.TextYAlignment = Enum.TextYAlignment.Top
	revealPerks.ZIndex = 7
	local revealRing = Instance.new("UIStroke")
	revealRing.Thickness = 3
	revealRing.Color = GOLD
	revealRing.Parent = reveal

	local pending: string? = nil
	local pendingId = 0
	local lastRequest = -math.huge
	local revealing = false
	local stopReveal: (() -> ())? = nil
	local standPart: BasePart? = nil
	local caseScreen = nil
	local function ownedCases(): number
		local count = player:GetAttribute("RodCrateCount" .. crateId)
		return if type(count) == "number" then count else 0
	end

	local function owned(skinId: string): number
		local value = player:GetAttribute(countAttribute .. skinId)
		return if type(value) == "number" then value else 0
	end
	local function setStatus(message: string, color: Color3)
		status.Text, status.TextColor3 = message, color
	end

	local function refresh()
		local money = player:GetAttribute("Cash")
		money = if type(money) == "number" then money else 0
		cash.Text = "$" .. commas(money)
		local ready = player:GetAttribute("BoatDataStatus") == "Ready"
		local ownsRod = player:GetAttribute("OwnsStarterRod") == true
		local equipped = player:GetAttribute(skinAttribute)
		local idle = ready and pending == nil and not revealing
		title.Text = crate.Name
		local odds = {}
		for _, rarity in RodSkins.RarityOrder do
			table.insert(
				odds,
				string.format(
					'<font color="%s">%s %s</font>',
					hex(rarityColor(rarity)),
					rarity,
					percent(crate.Odds[rarity])
				)
			)
		end
		oddsLine.Text = table.concat(odds, "  ·  ")
		for optionId, view in crateViews do
			view.grid.Visible = optionId == crateId
			Theme.button(view.tab, if optionId == crateId then "Selected" else "Normal")
			view.tab.Active, view.tab.Selectable = idle, idle
		end
		for skinId, view in crateViews[crateId].cards do
			local count = owned(skinId)
			local active = equipped == skinId
			local enabled = idle and count > 0 and not active and not spear
			view.equip.Text = if spear and count > 0 then "Equip in equipment bag" elseif count == 0
				then "Not owned"
				elseif active then "EQUIPPED"
				elseif count > 1 then string.format('Equip  <font color="#bdbdbd">×%d</font>', count)
				else "Equip"
			Theme.button(view.equip, if active then "Normal" elseif enabled then "Selected" else "Disabled")
			view.equip.Active, view.equip.Selectable, view.equip.AutoButtonColor = enabled, enabled, enabled
			local stroke = view.card:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = if active then GOLD else Theme.Colors.Border
			end
		end
		local plainEnabled = idle and type(equipped) == "string" and equipped ~= ""
		Theme.button(plain, if plainEnabled then "Selected" else "Disabled")
		plain.Active, plain.Selectable, plain.AutoButtonColor = plainEnabled, plainEnabled, plainEnabled
		if openOwned then
			local cases = ownedCases()
			local enabled = idle and cases > 0
			openOwned.Text = string.format("Open owned case (%d)", cases)
			Theme.button(openOwned, if enabled then "Selected" else "Disabled")
			openOwned.Active, openOwned.Selectable, openOwned.AutoButtonColor = enabled, enabled, enabled
		end
		for count, open in opens do
			local afford = money >= crate.Price * count
			local openEnabled = idle and ownsRod and afford
			open.Text = if pending == openAction
					or pending == buyAction
					or revealing
				then if not rod then "Opening…" else "Buying…"
				else string.format(
					(
						if not rod
							then 'OPEN %d×\n<font color="%s">$%s</font>'
							else 'BUY %d×\n<font color="%s">$%s</font>'
					),
					count,
					if afford then "#a6f0b2" else "#ff9a9d",
					commas(crate.Price * count)
				)
			Theme.button(open, if openEnabled then "Selected" else "Disabled")
			open.Active, open.Selectable, open.AutoButtonColor = openEnabled, openEnabled, openEnabled
		end
		if not ready then
			setStatus("Loading your wallet…", muted)
		elseif not ownsRod then
			setStatus("Your starter rod is still loading. Please try again shortly.", muted)
		end
	end

	local function openWindow()
		if
			overlay.Visible
			or revealing
			or pending == openAction
			or player:GetAttribute("RodCratesOpen")
			or player:GetAttribute("RodCrateOpening")
		then
			return
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if
			not root
			or not root:IsA("BasePart")
			or not standPart
			or not standPart:IsDescendantOf(workspace)
			or (root.Position - standPart.Position).Magnitude > 18
			or player:GetAttribute("PlayerMenuOpen")
		then
			return
		end
		setStatus(
			if bobber
				then "Equip one bobber for small luck and mutation boosts. Duplicate copies do not stack perks."
				elseif spear then "Spear skins boost shark damage or fire rate. Wear affects each bonus; equip copies in your equipment bag."
				else "Bonuses vary with wear; cards show the possible range. Your equipment bag shows each copy's actual bonus.",
			muted
		)
		reveal.Visible = false
		refresh()
		overlay.Visible = true
		player:SetAttribute("RodCratesOpen", true)
		scale.Scale = scale:GetAttribute("Fit") or 1
		window.Position = UDim2.new(0.5, 0, 0.5, 24)
		TweenService
			:Create(window, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Position = UDim2.fromScale(0.5, 0.5) })
			:Play()
	end
	local function closeWindow()
		if pending == ownedAction then
			return
		end
		if overlay.Visible then
			overlay.Visible = false
			results.Visible = false
			if caseScreen then
				caseScreen.hide()
			end
			window.Visible = true
			player:SetAttribute("RodCratesOpen", false)
		end
	end

	local function send(action: string, value: any)
		if pending or revealing or os.clock() - lastRequest < 0.5 then
			return
		end
		lastRequest = os.clock()
		pending, pendingId = action, pendingId + 1
		local current = pendingId
		refresh()
		if action == openAction then
			closeWindow()
			player:SetAttribute("RodCrateOpening", true)
		end
		request:FireServer(action, value)
		task.delay(
			if action == ownedAction or (action == openAction and type(value) == "table") then 60 else 8,
			function()
				if pendingId == current and pending then
					pending = nil
					if action == openAction then
						player:SetAttribute("RodCrateOpening", false)
						openWindow()
					end
					if action == ownedAction and caseScreen then
						caseScreen.failed("That took too long. Check your inventory before trying again.", ownedCases())
					end
					setStatus("That took too long. Please try again.", SHORT)
					refresh()
				end
			end
		)
	end

	if rod then
		caseScreen = RodCaseOpening.create(overlay, function(id)
			if pending or revealing then
				return
			end
			local token = caseScreen.setPending()
			-- The shop shares a server request throttle; queue a quick open after purchase.
			task.delay(math.max(0, 0.55 - (os.clock() - lastRequest)), function()
				if caseScreen.isPending(token) then
					send(ownedAction, id)
				end
			end)
		end, function()
			caseScreen.hide()
			window.Visible = true
			refresh()
		end)
		openOwned.Activated:Connect(function()
			if openOwned.Active then
				window.Visible = false
				caseScreen.show(crateId, ownedCases())
			end
		end)
	end

	-- Only animate the actual skin after the server has charged and saved it.
	local function play(skinId: string, message: string, serial: number?, rewards: any?, wear: number?)
		if stopReveal then
			stopReveal()
		end
		closeWindow()
		revealing = true
		player:SetAttribute("RodCrateOpening", true)
		refresh()
		local skin = RodSkins.Skins[skinId]
		local skinRarity = RodSkins.rarity(skinId, crateId)
		local final = rarityColor(skinRarity)
		local function showReward()
			reveal.Visible = true
			revealName.Text = skin.Name
			revealName.TextColor3 = final
			revealRarity.Text = string.upper(skinRarity)
				.. (if serial then string.format(" · Serial #%06d", serial) else "")
				.. (if spear and wear then " · " .. RodSkins.wearState(wear) else "")
			revealRarity.TextColor3 = final
			revealPerks.Text = table.concat(RodSkins.perks(skinId, wear), "   ·   ")
			revealRing.Color = final
			setStatus(message, AFFORD)
		end
		local function finish()
			reveal.Visible = false
			revealing = false
			stopReveal = nil
			player:SetAttribute("RodCrateOpening", false)
			refresh()
			local view = crateViews[crateId].cards[skinId]
			if view then
				view.glow.BackgroundTransparency = 0.2
				TweenService:Create(view.glow, TweenInfo.new(1), { BackgroundTransparency = 0.85 }):Play()
			end
			if rewards then
				local lines = {}
				for _, reward in rewards do
					local rarity = RodSkins.rarity(reward.SkinId, crateId)
					table.insert(
						lines,
						string.format(
							'<font color="%s">%s</font>%s',
							hex(rarityColor(rarity)),
							RodSkins.Skins[reward.SkinId].Name,
							(if reward.Serial then string.format(" · #%06d", reward.Serial) else "")
								.. (if spear and reward.Wear then " · " .. RodSkins.wearState(reward.Wear) .. " · " .. table.concat(RodSkins.perks(reward.SkinId, reward.Wear), " · ") else "")
						)
					)
				end
				resultsText.Text = table.concat(lines, "\n")
				overlay.Visible = true
				window.Visible = false
				results.Visible = true
				player:SetAttribute("RodCratesOpen", true)
			end
		end
		stopReveal = CrateReveal.play(
			standPart,
			skinId,
			showReward,
			finish,
			if bobber
				then function()
					return FishingBobber.build(skinId)
				end
				elseif spear then function()
					local model = Instance.new("Model")
					local tool = Spears.build(skinId, wear)
					tool.Parent = model
					model.PrimaryPart = tool:FindFirstChild("Handle")
					return model
				end
				else nil,
			if spear then 1 else nil
		)
		if not stopReveal then
			-- The stand may have streamed away while the save was in flight.
			showReward()
			local cancelled = false
			stopReveal = function()
				if not cancelled then
					cancelled = true
					finish()
				end
			end
			task.delay(3, function()
				if not cancelled then
					cancelled = true
					finish()
				end
			end)
		end
	end

	for count, open in opens do
		open.Activated:Connect(function()
			if open.Active then
				setStatus(if not rod then "Finn is prying the lid off…" else "Purchasing your case…", muted)
				if not rod then
					send(openAction, if count == 1 then crateId else { CrateId = crateId, Count = count })
				else
					send(buyAction, { CrateId = crateId, Count = count })
				end
			end
		end)
	end
	resultsClose.Activated:Connect(function()
		results.Visible = false
		window.Visible = true
		closeWindow()
	end)
	plain.Activated:Connect(function()
		if plain.Active then
			send(equipAction, "")
		end
	end)
	for optionId, crateView in crateViews do
		crateView.tab.Activated:Connect(function()
			if pending or revealing or optionId == crateId then
				return
			end
			crateId, crate = optionId, RodSkins.Crates[optionId]
			setStatus(crate.Description, muted)
			refresh()
		end)
		for skinId, view in crateView.cards do
			view.equip.Activated:Connect(function()
				if view.equip.Active then
					send(equipAction, skinId)
				end
			end)
		end
	end
	close.Activated:Connect(closeWindow)
	overlay.Activated:Connect(function()
		if not revealing then
			closeWindow()
		end
	end)
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			closeWindow()
		end
	end)

	feedback.OnClientEvent:Connect(function(kind, a, b, c, d)
		if kind == openEvent and not player:GetAttribute("PlayerMenuOpen") then
			local hall = workspace:FindFirstChild("Interiors")
			local stand = hall and hall:FindFirstChild(openAction .. "Prompt", true)
			standPart = if stand and stand.Parent and stand.Parent:IsA("BasePart") then stand.Parent else nil
			openWindow()
		elseif rod and kind == "RodCratePurchaseResult" and type(b) == "string" then
			pending = nil
			if a == true and type(c) == "string" and RodSkins.validCrate(c) then
				crateId, crate = c, RodSkins.Crates[c]
				if overlay.Visible then
					window.Visible = false
					caseScreen.show(c, math.max(ownedCases(), if type(d) == "number" then d else 1))
				end
				setStatus(b, AFFORD)
			else
				setStatus(b, SHORT)
			end
			task.delay(0.15, refresh)
		elseif rod and kind == resultEvent and type(b) == "string" then
			pending = nil
			if a == true and type(c) == "table" and RodSkins.valid(c.SkinId) then
				if overlay.Visible then
					caseScreen.reveal(c)
				end
				setStatus(b, AFFORD)
			else
				if caseScreen then
					caseScreen.failed(b, ownedCases())
				end
				setStatus(b, SHORT)
			end
			task.delay(0.15, refresh)
		elseif kind == resultEvent and type(b) == "string" then
			pending = nil
			if a == true and type(c) == "table" and #c > 0 and RodSkins.valid(c[1].SkinId) then
				play(c[1].SkinId, b, c[1].Serial, c, c[1].Wear)
			elseif a == true and RodSkins.valid(c) then
				play(c, b, if type(d) == "number" then d else nil)
			else
				player:SetAttribute("RodCrateOpening", false)
				openWindow()
				setStatus(b, SHORT)
				task.delay(0.15, refresh)
			end
		elseif kind == skinEvent and type(b) == "string" then
			pending = nil
			setStatus(b, if a == true then AFFORD else SHORT)
			task.delay(0.15, refresh)
		end
	end)
	local watched = { "Cash", "BoatDataStatus", "OwnsStarterRod", skinAttribute }
	for skinId in RodSkins.Skins do
		table.insert(watched, countAttribute .. skinId)
	end
	if rod then
		for _, id in RodSkins.CrateOrder do
			table.insert(watched, "RodCrateCount" .. id)
		end
	end
	for _, attribute in watched do
		player:GetAttributeChangedSignal(attribute):Connect(function()
			if overlay.Visible then
				refresh()
			end
		end)
	end
	player:GetAttributeChangedSignal("PlayerMenuOpen"):Connect(function()
		if player:GetAttribute("PlayerMenuOpen") then
			closeWindow()
			if stopReveal then
				stopReveal()
			end
		end
	end)
	player.CharacterRemoving:Connect(function()
		pending = nil
		closeWindow()
		player:SetAttribute("RodCrateOpening", false)
		if stopReveal then
			stopReveal()
		end
	end)

	-- Fit small screens, and close once the angler walks away from the stand.
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.25 then
			return
		end
		elapsed = 0
		local camera = workspace.CurrentCamera
		if camera then
			resultsScale.Scale = math.min(1, (camera.ViewportSize.X - 24) / 480, (camera.ViewportSize.Y - 60) / 410)
			rewardScale.Scale = math.min(1, math.max(0.3, (camera.ViewportSize.X - 24) / 520))
			local fit =
				math.max(0.3, math.min(1, (camera.ViewportSize.X - 24) / WIDTH, (camera.ViewportSize.Y - 60) / HEIGHT))
			scale:SetAttribute("Fit", fit)
			scale.Scale = fit
		end
		if overlay.Visible and not revealing then
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if
				not root
				or not root:IsA("BasePart")
				or (standPart and (root.Position - standPart.Position).Magnitude > 18)
			then
				closeWindow()
			end
		end
	end)
	refresh()
end

function RodCrates.start()
	if started then
		return
	end
	started = true
	startShop(RodSkins, "Rod")
	startShop(BobberSkins, "Bobber")
	startShop(SpearSkins, "Spear")
end

return RodCrates
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="349">
          <Properties>
            <string name="Name">RodPhysics</string>
            <string name="Source"><![CDATA[-- Each client derives bend from replicated handle movement, including rods held
-- by other players. No per-frame remotes or server physics forces are needed.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local RodDynamics = require(ReplicatedStorage.Shared.RodDynamics)

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end

local RodPhysics = {}
local stopCurrent: (() -> ())? = nil

local function limit(vector: Vector3, maximum: number): Vector3
	local magnitude = vector.Magnitude
	return if magnitude > maximum then vector * (maximum / magnitude) else vector
end

function RodPhysics.start()
	if stopCurrent then
		return stopCurrent
	end
	local records = {}
	local connections = {}
	local elapsed = 0

	local function reset(record)
		RodDynamics.reset(record.spring)
		record.lastFrame, record.linearVelocity, record.angularVelocity = nil, Vector3.zero, Vector3.zero
		record.acceleration, record.angularAcceleration = Vector3.zero, Vector3.zero
		if record.binding then
			for _, hinge in record.binding.hinges do
				hinge.joint.Transform = CFrame.identity
			end
			record.binding.bobber.Transform = CFrame.identity
		end
	end
	local function remove(tool)
		local record = records[tool]
		if record then
			reset(record)
			if record.destroying then
				record.destroying:Disconnect()
			end
			records[tool] = nil
		end
	end
	local function add(tool)
		if not tool:IsA("Tool") or tool:GetAttribute("RodId") ~= "StarterRod" or records[tool] then
			return
		end
		local record = { spring = RodDynamics.new(), nextBind = 0, active = false }
		records[tool] = record
		record.destroying = tool.Destroying:Connect(function()
			remove(tool)
		end)
		reset(record)
	end
	local function bind(tool, record)
		local handle = tool:FindFirstChild("Handle")
		local bobberPart = tool:FindFirstChild("RodBobber")
		local bobber = if bobberPart then bobberPart:FindFirstChild("BobberSwing") else nil
		if not handle or not handle:IsA("BasePart") or not bobber or not bobber:IsA("Motor6D") then
			return false
		end
		local hinges = {}
		for _, child in tool:GetDescendants() do
			if child:IsA("Motor6D") and child:GetAttribute("RodSegment") then
				if not child.Part0 or not child.Part1 then
					return false
				end
				table.insert(hinges, {
					joint = child,
					index = child:GetAttribute("RodSegment"),
					weight = child:GetAttribute("FlexWeight"),
				})
			end
		end
		if #hinges ~= tool:GetAttribute("RodSegmentCount") then
			return false
		end
		table.sort(hinges, function(a, b)
			return a.index < b.index
		end)
		if not bobber.Part0 or not bobber.Part1 then
			return false
		end
		record.binding = {
			handle = handle,
			bobber = bobber,
			hinges = hinges,
			lineLength = tool:GetAttribute("RodLineLength") or 1.25,
		}
		reset(record)
		return true
	end
	local function bindingPresent(tool, binding)
		if not binding.handle:IsDescendantOf(tool) or not binding.bobber:IsDescendantOf(tool) then
			return false
		end
		for _, hinge in binding.hinges do
			local joint = hinge.joint
			if
				not joint:IsDescendantOf(tool)
				or not joint.Part0
				or not joint.Part1
				or not joint.Part0:IsDescendantOf(tool)
				or not joint.Part1:IsDescendantOf(tool)
			then
				return false
			end
		end
		return binding.bobber.Part0 ~= nil and binding.bobber.Part1 ~= nil
	end
	local function articulate(record, dt: number)
		local binding = record.binding
		local frame = binding.handle.CFrame
		local previous = record.lastFrame
		if not previous or dt <= 0 or dt > 0.15 or (frame.Position - previous.Position).Magnitude > 12 then
			reset(record)
			record.lastFrame = frame
			return
		end
		record.lastFrame = frame
		local linearVelocity = limit((frame.Position - previous.Position) / dt, 100)
		local axis, angle = previous:ToObjectSpace(frame):ToAxisAngle()
		local angularVelocity = limit(previous:VectorToWorldSpace(axis * (angle / dt)), 14)
		local smoothing = 1 - math.exp(-14 * dt)
		record.acceleration =
			record.acceleration:Lerp(limit((linearVelocity - record.linearVelocity) / dt, 150), smoothing)
		record.angularAcceleration =
			record.angularAcceleration:Lerp(limit((angularVelocity - record.angularVelocity) / dt, 90), smoothing)
		record.linearVelocity, record.angularVelocity = linearVelocity, angularVelocity
		local acceleration = frame:VectorToObjectSpace(record.acceleration)
		local rotation = frame:VectorToObjectSpace(angularVelocity)
		local angularAcceleration = frame:VectorToObjectSpace(record.angularAcceleration)
		local gravity = workspace.Gravity
		local localGravity = frame:VectorToObjectSpace(Vector3.new(0, -gravity, 0))
		local spring = record.spring
		-- Wrist rotations from walking packs change direction rapidly. Their
		-- angular acceleration should add a little flex, not whip the shaft.
		RodDynamics.step(spring, dt, {
			bendX = (localGravity.Z * 0.14 - acceleration.Z) * 0.0028
				- rotation.X * 0.018
				- angularAcceleration.X * 0.0012,
			bendZ = (-localGravity.X * 0.14 + acceleration.X) * 0.0028
				- rotation.Z * 0.018
				- angularAcceleration.Z * 0.0012,
			bobX = -record.acceleration.X / math.max(gravity, 32),
			bobZ = -record.acceleration.Z / math.max(gravity, 32),
		})
		-- Reconstruct this frame's chain instead of reading last frame's segment
		-- positions; the Motor6D batch is applied after PreSimulation finishes.
		local parentFrame = frame
		for _, hinge in binding.hinges do
			local joint = hinge.joint
			local flex = hinge.weight * 0.27
			local transform = CFrame.Angles(spring.bendX * flex, 0, spring.bendZ * flex)
			joint.Transform = transform
			parentFrame = parentFrame * joint.C0 * transform * joint.C1:Inverse()
		end
		local tipFrame = parentFrame * binding.bobber.C0
		local direction = Vector3.new(spring.bobX, -1, spring.bobZ).Unit
		local desired = CFrame.new(tipFrame.Position + direction * binding.lineLength)
		binding.bobber.Transform = tipFrame:ToObjectSpace(desired) * binding.bobber.C1
	end

	for _, tool in CollectionService:GetTagged("FishingRod") do
		add(tool)
	end
	table.insert(connections, CollectionService:GetInstanceAddedSignal("FishingRod"):Connect(add))
	table.insert(connections, CollectionService:GetInstanceRemovedSignal("FishingRod"):Connect(remove))
	table.insert(
		connections,
		RunService.PreSimulation:Connect(profiled("RodPhysics", function(dt)
			elapsed += dt
			for tool, record in records do
				local character = tool.Parent
				local humanoid = if character and character:IsA("Model")
					then character:FindFirstChildOfClass("Humanoid")
					else nil
				local equipped = humanoid and humanoid.Health > 0 and character:IsDescendantOf(workspace)
				if not equipped then
					if record.active then
						reset(record)
						record.active = false
					end
					continue
				end
				if record.binding and not bindingPresent(tool, record.binding) then
					reset(record)
					record.binding = nil
					record.nextBind = elapsed
				end
				if not record.binding then
					if elapsed < record.nextBind then
						continue
					end
					record.nextBind = elapsed + 0.25
					if not bind(tool, record) then
						continue
					end
				end
				record.active = true
				articulate(record, dt)
			end
		end))
	)
	stopCurrent = function()
		for _, connection in connections do
			connection:Disconnect()
		end
		for tool in records do
			remove(tool)
		end
		stopCurrent = nil
	end
	return stopCurrent
end

return RodPhysics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="350">
          <Properties>
            <string name="Name">RodWorkshop</string>
            <string name="Source"><![CDATA[-- Finn's rod upgrade counter in Tide & Tackle. The server charges, saves and
-- publishes levels as RodUpgrade<Stat> attributes; this module only presents them.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))
local RodUpgrades = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("RodUpgrades"))
local Bait = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Bait"))

local RodWorkshop = {}
local started = false

local WIDTH, HEIGHT = 842, 516
local CARD_WIDTH, CARD_GAP = 188, 14
local GOLD = Color3.fromRGB(244, 196, 76)
local AFFORD = Color3.fromRGB(111, 202, 125)
local SHORT = Color3.fromRGB(238, 107, 111)
local ACCENTS = {
	Speed = Color3.fromRGB(86, 196, 232),
	Handling = Color3.fromRGB(111, 202, 125),
	Strength = Color3.fromRGB(238, 120, 84),
	Luck = Color3.fromRGB(196, 120, 240),
}
local GREETINGS = {
	"Ahoy! Bring me coin and I'll tune that rod till it sings.",
	"Every level costs a bit more, but the fish never stop getting bigger.",
	"Rarity Luck's my finest work. Pricey, mind you, but legends bite for it.",
	"A faster reel means fewer fish slipping the hook. Trust old Finn.",
}

local function commas(value: number): string
	local text = tostring(math.floor(value))
	while true do
		local replaced, count = text:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
		text = replaced
		if count == 0 then
			return text
		end
	end
end

function RodWorkshop.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local remotes = ReplicatedStorage:WaitForChild("Fishing")
	local request = remotes:WaitForChild("Request") :: RemoteEvent
	local feedback = remotes:WaitForChild("Feedback") :: RemoteEvent
	local cream, muted = Theme.Colors.Text, Theme.Colors.Muted

	local gui = Instance.new("ScreenGui")
	gui.Name = "RodWorkshop"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 23
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	local function label(parent: Instance, text: string, position: UDim2, size: UDim2, textSize: number, color: Color3)
		local item = Instance.new("TextLabel")
		item.BackgroundTransparency = 1
		item.Position, item.Size = position, size
		item.Text, item.TextSize = text, textSize
		item.TextWrapped = true
		item.TextXAlignment = Enum.TextXAlignment.Left
		Theme.text(item, color)
		item.Parent = parent
		return item
	end
	local function frame(parent: Instance, name: string, position: UDim2, size: UDim2, color: Color3): Frame
		local item = Instance.new("Frame")
		item.Name = name
		item.Position, item.Size = position, size
		item.BackgroundColor3 = color
		item.BorderSizePixel = 0
		item.Parent = parent
		return item
	end
	local function gradient(parent: Instance, top: Color3, bottom: Color3)
		local fill = Instance.new("UIGradient")
		fill.Rotation = 90
		fill.Color = ColorSequence.new(top, bottom)
		fill.Parent = parent
		return fill
	end

	local overlay = Instance.new("TextButton")
	overlay.Name = "WorkshopOverlay"
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = Color3.new(0, 0, 0)
	overlay.BackgroundTransparency = 0.45
	overlay.Text = ""
	overlay.AutoButtonColor = false
	overlay.Visible = false
	overlay.Parent = gui

	local window = Instance.new("Frame")
	window.Name = "RodUpgrades"
	window.Active = true
	window.AnchorPoint = Vector2.new(0.5, 0.5)
	window.Position = UDim2.fromScale(0.5, 0.5)
	window.Size = UDim2.fromOffset(WIDTH, HEIGHT)
	window.Parent = overlay
	Theme.window(window)
	local scale = Instance.new("UIScale")
	scale.Parent = window

	-- Header: Finn's badge, his line of dialogue and the angler's wallet.
	local header = frame(window, "Header", UDim2.fromOffset(14, 14), UDim2.new(1, -28, 0, 112), Color3.new(1, 1, 1))
	Theme.corner(header, 8)
	gradient(header, Color3.fromRGB(38, 92, 104), Color3.fromRGB(24, 52, 66))
	local badge =
		frame(header, "Badge", UDim2.fromOffset(16, 16), UDim2.fromOffset(80, 80), Color3.fromRGB(250, 236, 200))
	Theme.corner(badge, 40)
	local badgeRing = Instance.new("UIStroke")
	badgeRing.Color, badgeRing.Thickness = GOLD, 3
	badgeRing.Parent = badge
	local initial = label(badge, "F", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), 42, Color3.fromRGB(38, 92, 104))
	initial.TextXAlignment = Enum.TextXAlignment.Center
	initial.TextStrokeTransparency = 1
	label(header, "FINN · ROD KEEPER", UDim2.fromOffset(112, 14), UDim2.fromOffset(300, 18), 13, GOLD)
	label(header, "Rod upgrades", UDim2.fromOffset(112, 32), UDim2.fromOffset(300, 32), 26, cream)
	local speech = label(header, "", UDim2.fromOffset(112, 66), UDim2.new(1, -300, 0, 38), 14, muted)
	speech.Font = Enum.Font.GothamMedium
	speech.TextYAlignment = Enum.TextYAlignment.Top
	local wallet = frame(header, "Wallet", UDim2.new(1, -168, 0, 22), UDim2.fromOffset(150, 46), Theme.Colors.Inset)
	Theme.panel(wallet, true, 23)
	label(wallet, "WALLET", UDim2.fromOffset(16, 4), UDim2.new(1, -24, 0, 14), 11, muted)
	local cash = label(wallet, "$0", UDim2.fromOffset(16, 18), UDim2.new(1, -24, 0, 24), 20, AFFORD)

	local close = Instance.new("TextButton")
	close.Name = "CloseWorkshop"
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(1, -6, 0, 6)
	close.Size = UDim2.fromOffset(34, 34)
	close.Text = "×"
	close.TextSize = 24
	close.ZIndex = 4
	close.Parent = header
	Theme.button(close, "Danger")

	-- One card per stat: accent stripe, level pips, effect now and next, buy button.
	local cards = {}
	local row = frame(window, "Upgrades", UDim2.fromOffset(0, 140), UDim2.new(1, 0, 0, 252), Color3.new())
	row.BackgroundTransparency = 1
	local rowWidth = CARD_WIDTH * #RodUpgrades.Order + CARD_GAP * (#RodUpgrades.Order - 1)
	for index, stat in RodUpgrades.Order do
		local spec = RodUpgrades.Stats[stat]
		local x = (WIDTH - rowWidth) / 2 + (index - 1) * (CARD_WIDTH + CARD_GAP)
		local card = frame(row, stat, UDim2.fromOffset(x, 0), UDim2.fromOffset(CARD_WIDTH, 252), Theme.Colors.Panel)
		Theme.panel(card, false, 8)
		local stripe = frame(card, "Accent", UDim2.fromScale(0, 0), UDim2.new(1, 0, 0, 6), ACCENTS[stat])
		Theme.corner(stripe, 8)
		local glow = frame(card, "Glow", UDim2.fromOffset(0, 6), UDim2.new(1, 0, 0, 60), ACCENTS[stat])
		glow.BackgroundTransparency = 0.8
		local fade = gradient(glow, Color3.new(1, 1, 1), Color3.new(1, 1, 1))
		fade.Transparency = NumberSequence.new(0, 1)
		label(card, string.upper(spec.Name), UDim2.fromOffset(14, 16), UDim2.new(1, -28, 0, 20), 15, ACCENTS[stat])
		local level = label(card, "", UDim2.fromOffset(14, 38), UDim2.new(1, -28, 0, 30), 24, cream)
		local description = label(card, spec.Description, UDim2.fromOffset(14, 70), UDim2.new(1, -28, 0, 44), 12, muted)
		description.Font = Enum.Font.GothamMedium
		description.TextYAlignment = Enum.TextYAlignment.Top
		local pips = {}
		local pipWidth = (CARD_WIDTH - 28 - (spec.MaxLevel - 1) * 3) / spec.MaxLevel
		for pip = 1, spec.MaxLevel do
			local cell = frame(
				card,
				"Pip" .. pip,
				UDim2.fromOffset(14 + (pip - 1) * (pipWidth + 3), 120),
				UDim2.fromOffset(pipWidth, 10),
				Theme.Colors.Inset
			)
			Theme.corner(cell, 3)
			pips[pip] = cell
		end
		local now = label(card, "", UDim2.fromOffset(14, 140), UDim2.new(1, -28, 0, 18), 13, cream)
		local nextEffect = label(card, "", UDim2.fromOffset(14, 158), UDim2.new(1, -28, 0, 18), 13, AFFORD)
		local buy = Instance.new("TextButton")
		buy.Name = "Upgrade" .. stat
		buy.Position = UDim2.new(0, 12, 1, -64)
		buy.Size = UDim2.new(1, -24, 0, 52)
		buy.TextSize = 16
		buy.TextWrapped = true
		buy.RichText = true
		buy.Parent = card
		Theme.button(buy, "Selected")
		cards[stat] = {
			card = card,
			level = level,
			pips = pips,
			now = now,
			nextEffect = nextEffect,
			buy = buy,
			glow = glow,
		}
	end

	-- Bait crates: bought here, opened from the equipment bag.
	local baitStrip =
		frame(window, "BaitCrates", UDim2.fromOffset((WIDTH - rowWidth) / 2, 404), UDim2.fromOffset(rowWidth, 56), Theme.Colors.Panel)
	Theme.panel(baitStrip, false, 8)
	label(baitStrip, "BAIT CRATE", UDim2.fromOffset(14, 6), UDim2.fromOffset(300, 18), 14, GOLD)
	local baitInfo = label(
		baitStrip,
		string.format("%d–%d bait each · used up per catch · rarer bait, better stats", Bait.Crate.MinBait, Bait.Crate.MaxBait),
		UDim2.fromOffset(14, 26),
		UDim2.new(1, -330, 0, 22),
		12,
		muted
	)
	baitInfo.Font = Enum.Font.GothamMedium
	local baitButtons = {}
	for index, count in Bait.BuyCounts do
		local buy = Instance.new("TextButton")
		buy.Name = "BuyBaitCrate" .. count
		buy.AnchorPoint = Vector2.new(1, 0.5)
		buy.Position = UDim2.new(1, -12 - (#Bait.BuyCounts - index) * 150, 0.5, 0)
		buy.Size = UDim2.fromOffset(140, 40)
		buy.TextSize = 14
		buy.RichText = true
		buy.Parent = baitStrip
		Theme.button(buy, "Selected")
		baitButtons[count] = buy
	end

	local status = label(window, "", UDim2.fromOffset(24, HEIGHT - 50), UDim2.new(1, -48, 0, 32), 14, muted)
	status.TextXAlignment = Enum.TextXAlignment.Center
	status.Font = Enum.Font.GothamMedium

	local pending: string? = nil
	local pendingId = 0
	local lastRequest = -math.huge
	local keeperHead: BasePart? = nil

	local function levelOf(stat: string): number
		local value = player:GetAttribute(RodUpgrades.attribute(stat))
		return if type(value) == "number" then value else 0
	end

	local function refresh()
		local money = player:GetAttribute("Cash")
		money = if type(money) == "number" then money else 0
		cash.Text = "$" .. commas(money)
		local ready = player:GetAttribute("BoatDataStatus") == "Ready"
		local ownsRod = player:GetAttribute("OwnsStarterRod") == true
		for _, stat in RodUpgrades.Order do
			local spec = RodUpgrades.Stats[stat]
			local view = cards[stat]
			local current = levelOf(stat)
			local price = RodUpgrades.price(stat, current)
			view.level.Text = string.format('Lv %d <font size="15" color="#9a9a9a">/ %d</font>', current, spec.MaxLevel)
			view.level.RichText = true
			for pip, cell in view.pips do
				cell.BackgroundColor3 = if pip <= current then ACCENTS[stat] else Theme.Colors.Inset
			end
			view.now.Text = if current > 0 then "Now: " .. RodUpgrades.effect(stat, current) else "Now: stock rod"
			local enabled = false
			if not price then
				view.nextEffect.Text = "Fully upgraded!"
				view.nextEffect.TextColor3 = GOLD
				view.buy.Text = "MAXED OUT"
				Theme.button(view.buy, "Disabled")
			else
				view.nextEffect.Text = "Next: " .. RodUpgrades.effect(stat, current + 1)
				view.nextEffect.TextColor3 = AFFORD
				local afford = money >= price
				enabled = ready and ownsRod and afford and pending == nil
				local priceColor = if afford then "#a6f0b2" else "#ff9a9d"
				view.buy.Text = if pending == stat
					then "Upgrading…"
					else string.format('UPGRADE\n<font color="%s">$%s</font>', priceColor, commas(price))
				Theme.button(view.buy, if enabled then "Selected" elseif pending == stat then "Normal" else "Disabled")
			end
			view.buy.Active, view.buy.Selectable, view.buy.AutoButtonColor = enabled, enabled, enabled
		end
		for count, buy in baitButtons do
			local price = Bait.Crate.Price * count
			local afford = money >= price
			local enabled = ready and afford and pending == nil
			buy.Text = if pending == "Bait" .. count
				then "Buying…"
				else string.format(
					'BUY %d <font color="%s">$%s</font>',
					count,
					if afford then "#a6f0b2" else "#ff9a9d",
					commas(price)
				)
			Theme.button(buy, if enabled then "Selected" else "Disabled")
			buy.Active, buy.Selectable, buy.AutoButtonColor = enabled, enabled, enabled
		end
		if not ready then
			status.Text = "Loading your wallet…"
			status.TextColor3 = muted
		elseif not ownsRod then
			status.Text = "Your starter rod is still loading. Please try again shortly."
			status.TextColor3 = muted
		end
	end

	local function setStatus(message: string, color: Color3)
		status.Text, status.TextColor3 = message, color
	end

	local function open()
		if overlay.Visible then
			return
		end
		speech.Text = "“" .. GREETINGS[math.random(#GREETINGS)] .. "”"
		setStatus("Upgrades apply from your next cast.", muted)
		refresh()
		overlay.Visible = true
		player:SetAttribute("RodWorkshopOpen", true)
		scale.Scale = scale:GetAttribute("Fit") or 1
		window.Position = UDim2.new(0.5, 0, 0.5, 24)
		TweenService
			:Create(window, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Position = UDim2.fromScale(0.5, 0.5) })
			:Play()
	end
	local function closeWorkshop()
		if overlay.Visible then
			overlay.Visible = false
			player:SetAttribute("RodWorkshopOpen", false)
		end
	end

	local function celebrate(stat: string)
		local view = cards[stat]
		if not view then
			return
		end
		view.glow.BackgroundTransparency = 0.25
		TweenService:Create(view.glow, TweenInfo.new(0.8), { BackgroundTransparency = 0.8 }):Play()
		local pip = view.pips[levelOf(stat)]
		if pip then
			pip.Size = UDim2.fromOffset(pip.Size.X.Offset, 16)
			pip.Position = UDim2.fromOffset(pip.Position.X.Offset, 117)
			TweenService:Create(pip, TweenInfo.new(0.35, Enum.EasingStyle.Back), {
				Size = UDim2.fromOffset(pip.Size.X.Offset, 10),
				Position = UDim2.fromOffset(pip.Position.X.Offset, 120),
			}):Play()
		end
	end

	for _, stat in RodUpgrades.Order do
		cards[stat].buy.Activated:Connect(function()
			if pending or not cards[stat].buy.Active or os.clock() - lastRequest < 0.5 then
				return
			end
			lastRequest = os.clock()
			pending, pendingId = stat, pendingId + 1
			local current = pendingId
			setStatus("Finn is working on your rod…", muted)
			refresh()
			request:FireServer("UpgradeRod", stat)
			task.delay(8, function()
				if pendingId == current and pending then
					pending = nil
					setStatus("The upgrade took too long. Please try again.", SHORT)
					refresh()
				end
			end)
		end)
	end
	for count, buy in baitButtons do
		buy.Activated:Connect(function()
			if pending or not buy.Active or os.clock() - lastRequest < 0.5 then
				return
			end
			lastRequest = os.clock()
			pending, pendingId = "Bait" .. count, pendingId + 1
			local current = pendingId
			setStatus("Finn is fetching your bait…", muted)
			refresh()
			request:FireServer("BuyBaitCrate", count)
			task.delay(8, function()
				if pendingId == current and pending then
					pending = nil
					setStatus("That took too long. Please try again.", SHORT)
					refresh()
				end
			end)
		end)
	end
	close.Activated:Connect(closeWorkshop)
	overlay.Activated:Connect(closeWorkshop)
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			closeWorkshop()
		end
	end)

	feedback.OnClientEvent:Connect(function(kind, a, b)
		if kind == "OpenUpgrades" and not player:GetAttribute("PlayerMenuOpen") then
			local hall = workspace:FindFirstChild("Interiors")
			local keeper = hall and hall:FindFirstChild("RodKeeper", true)
			local head = keeper and keeper:FindFirstChild("Head")
			keeperHead = if head and head:IsA("BasePart") then head else nil
			open()
		elseif kind == "UpgradeResult" and type(b) == "string" then
			local stat = pending
			pending = nil
			-- Let the replicated level and wallet arrive before redrawing the card.
			task.delay(0.15, function()
				refresh()
				if a == true and stat then
					celebrate(stat)
				end
			end)
			setStatus(b, if a == true then AFFORD else SHORT)
		elseif kind == "BaitCrateResult" and type(b) == "string" then
			pending = nil
			task.delay(0.15, refresh)
			setStatus(b, if a == true then AFFORD else SHORT)
		end
	end)
	local watched = { "Cash", "BoatDataStatus", "OwnsStarterRod" }
	for _, stat in RodUpgrades.Order do
		table.insert(watched, RodUpgrades.attribute(stat))
	end
	for _, attribute in watched do
		player:GetAttributeChangedSignal(attribute):Connect(function()
			if overlay.Visible then
				refresh()
			end
		end)
	end
	player:GetAttributeChangedSignal("PlayerMenuOpen"):Connect(function()
		if player:GetAttribute("PlayerMenuOpen") then
			closeWorkshop()
		end
	end)
	player.CharacterRemoving:Connect(closeWorkshop)

	-- Fit small screens, and close once the angler walks away from the counter.
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.25 then
			return
		end
		elapsed = 0
		local camera = workspace.CurrentCamera
		if camera then
			local fit =
				math.max(0.3, math.min(1, (camera.ViewportSize.X - 24) / WIDTH, (camera.ViewportSize.Y - 60) / HEIGHT))
			scale:SetAttribute("Fit", fit)
			scale.Scale = fit
		end
		if overlay.Visible then
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if
				not root
				or not root:IsA("BasePart")
				or (keeperHead and (root.Position - keeperHead.Position).Magnitude > 18)
			then
				closeWorkshop()
			end
		end
	end)
	refresh()
end

return RodWorkshop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="351">
          <Properties>
            <string name="Name">RowingAnimation</string>
            <string name="Source"><![CDATA[-- Procedural strokes need no uploaded animation asset and support R6 and R15.
-- Every client animates the boats it has streamed in, including other players.
local RunService = game:GetService("RunService")
local RowingAnimation = {}
local started = false
local DISCOVERY_INTERVAL = 0.25

local function restoreArms(record)
	for joint in record.arms do
		if joint.Parent then
			joint.Transform = CFrame.identity
		end
	end
	record.arms = {}
	record.occupant = nil
end

function RowingAnimation.start()
	if started then return end
	started = true
	local records = {}
	local previousFolder = nil
	local discovery = DISCOVERY_INTERVAL
	RunService.PreSimulation:Connect(function(dt)
		local folder = workspace:FindFirstChild("PlayerBoats")
		discovery += dt
		if folder and (folder ~= previousFolder or discovery >= DISCOVERY_INTERVAL) then
			discovery = 0
			for _, model in folder:GetChildren() do
				if model:GetAttribute("BoatId") == "Rowboat" and not records[model] then
					local seat = model:FindFirstChild("RowerSeat", true)
					if seat then
						local oars = {}
						for _, joint in model:GetDescendants() do
							if joint:IsA("Motor6D") and joint:GetAttribute("RowSide") then
								oars[joint] = joint:GetAttribute("RowSide")
							end
						end
						records[model] = { seat = seat, oars = oars, drives = {}, arms = {}, blend = 0 }
					end
				end
			end
		end
		previousFolder = folder
		local phase = workspace:GetServerTimeNow() * math.pi * 1.5
		for model, record in records do
			if model.Parent ~= folder or not record.seat:IsDescendantOf(model) then
				restoreArms(record)
				for joint in record.oars do
					if joint.Parent then joint.Transform = CFrame.identity end
				end
				records[model] = nil
				continue
			end
			local occupant = record.seat.Occupant
			if occupant ~= record.occupant then
				restoreArms(record)
				record.occupant = occupant
				if occupant and occupant.Parent then
					for _, joint in occupant.Parent:GetDescendants() do
						if joint:IsA("Motor6D") then
							if joint.Name == "LeftShoulder" or joint.Name == "Left Shoulder" then
								record.arms[joint] = -1
							elseif joint.Name == "RightShoulder" or joint.Name == "Right Shoulder" then
								record.arms[joint] = 1
							end
						end
					end
				end
			end
			local throttle = if occupant and occupant.Health > 0 then model:GetAttribute("RowThrottle") or 0 else 0
			local steer = if occupant and occupant.Health > 0 then model:GetAttribute("RowSteer") or 0 else 0
			local effort = math.max(math.abs(throttle), math.abs(steer))
			record.blend += (effort - record.blend) * (1 - math.exp(-8 * math.min(dt, 0.1)))
			-- Parked oars need one final reset, then no transform writes until input returns.
			if effort == 0 and record.blend < 0.001 then
				if not record.idle then
					for joint in record.oars do
						if joint.Parent then joint.Transform = CFrame.identity end
					end
					for joint in record.arms do
						if joint.Parent and record.posed then joint.Transform = CFrame.identity end
					end
					table.clear(record.drives)
					record.posed = false
					record.idle = true
				end
				continue
			end
			record.idle = false
			for joint, side in record.oars do
				local target = math.clamp(throttle + side * steer, -1, 1)
				local drive = (record.drives[joint] or 0)
				drive += (target - drive) * (1 - math.exp(-8 * math.min(dt, 0.1)))
				record.drives[joint] = drive
				local direction = if drive < 0 then -1 else 1
				local strength = math.abs(drive)
				joint.Transform = CFrame.Angles(0, side * math.sin(phase) * 0.38 * direction * strength,
					side * math.max(0, math.cos(phase)) * 0.16 * strength)
			end
			for joint, side in record.arms do
				local drive = math.clamp(throttle + side * steer, -1, 1)
				local stroke = math.sin(phase) * (if drive < 0 then -1 else 1)
				local pose = CFrame.Angles(-0.95 + stroke * 0.32, side * 0.12, side * 0.12)
				-- R6 shoulders use rotated joint bases; rotate in torso space.
				local rotation = joint.C0.Rotation
				pose = rotation:Inverse() * pose * rotation
				if record.blend > 0.001 then
					joint.Transform = CFrame.identity:Lerp(pose, record.blend)
				elseif record.posed then
					joint.Transform = CFrame.identity
				end
			end
			record.posed = record.blend > 0.001
		end
	end)
end

return RowingAnimation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="352">
          <Properties>
            <string name="Name">SeabedCarpet</string>
            <string name="Source"><![CDATA[-- Builds the ocean-floor carpet around the camera from the patch templates the
-- server publishes in ReplicatedStorage.SeabedCarpet. The server used to clone
-- a patch into every cell of the ocean (~700k parts), which crashed live
-- servers; here only the cells within RADIUS exist, locally on this client.
-- Cell rules (grid, jitter, patch choice) live in shared/SeabedCarpet, so every
-- client builds the same floor.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Biomes = require(ReplicatedStorage.Shared.Biomes)
local Rules = require(ReplicatedStorage.Shared.SeabedCarpet)

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end

local SeabedCarpet = {}

-- The deep floor is out of sight further away than this, even from a diver.
local RADIUS = 320
-- The harbour lake's grid is four times as dense (24-stud cells) and lies around the village,
-- where the camera spends most of its time; past this the floor is lost under the surface
-- glare anyway. At 320 it was ~700 patches (~7k parts) drawn under the water at all times.
local LAKE_RADIUS = 208
-- Cells are only removed this far past their grid's radius, so a camera on a cell edge doesn't churn.
local KEEP_MARGIN = 96
-- Spread the old 24-patch / 0.2 s batch across frames. Cloning, scaling and parenting
-- a patch can touch dozens of parts; both arrivals and departures need a hard cap.
local CELLS_PER_FRAME = 2
local REMOVALS_PER_FRAME = 2
local SCANS_PER_FRAME = 64
local FRAME_BUDGET = 0.001
-- Ground that hasn't streamed in yet: try again a few times.
local RETRY_SECONDS = 2
local MAX_TRIES = 8

local started = false

local function groundOf(instance: Instance): boolean
	return instance:IsA("Terrain")
		or instance:FindFirstAncestor("Ground") ~= nil
		or instance:FindFirstAncestor("SeabedSlope") ~= nil
end

-- Pure stepping logic, separate from the Roblox loop so the checks can drive it.
-- `sample(x, z)` follows Rules.plan; `place(styleId, template, frame, scale)` returns
-- the built model. Returns `update(position, now)` and the live cell table.
-- The optional clock lets the checks simulate expensive probes/clones.
function SeabedCarpet.tracker(data, sample, place, clock)
	clock = clock or os.clock
	local grids = Rules.grids()
	local taken = {}
	for _, grid in grids do
		taken[grid.id] = Rules.occupied(grid, data.gardens)
	end
	local inLake = Rules.lakeTest(data.lake)
	-- [key] = { model = Model?, x, z, keep, tries, retryAt }
	local cells: { [number]: any } = {}
	local entries = {}
	local cleanupCursor, candidateCursor = 1, 0
	local ranges = {}

	local function update(position: Vector3, now: number): number
		local deadline = clock() + FRAME_BUDGET
		local built = 0
		-- A teleport used to destroy the entire old neighbourhood in one frame.
		-- A dense list lets cleanup resume without rescanning its settled prefix.
		local scanned, removed = 0, 0
		local cleanupCount = math.min(SCANS_PER_FRAME, #entries)
		while scanned < cleanupCount and removed < REMOVALS_PER_FRAME and clock() < deadline do
			if cleanupCursor > #entries then
				cleanupCursor = 1
			end
			local entry = entries[cleanupCursor]
			scanned += 1
			if math.max(math.abs(entry.x - position.X), math.abs(entry.z - position.Z)) > entry.keep then
				if entry.model then
					entry.model:Destroy()
				end
				cells[entry.key] = nil
				entries[cleanupCursor] = entries[#entries]
				entries[#entries] = nil
				removed += 1
			else
				cleanupCursor += 1
			end
		end
		local total = 0
		for index, grid in grids do
			local radius = if grid.lake then LAKE_RADIUS else RADIUS
			local x0, x1, z0, z1 = Rules.range(grid, position.X, position.Z, radius)
			local columns = math.max(0, z1 - z0 + 1)
			local count = math.max(0, x1 - x0 + 1) * columns
			ranges[index] = { x = x0, z = z0, columns = columns, count = count, radius = radius }
			total += count
		end
		-- The cursor survives frames and camera movement. Limiting scans as well as
		-- probes prevents a mostly settled lake grid from consuming a frame on foot.
		for _ = 1, math.min(SCANS_PER_FRAME, total) do
			if built >= CELLS_PER_FRAME or clock() >= deadline then
				break
			end
			candidateCursor = candidateCursor % total + 1
			local offset = candidateCursor - 1
			local gridIndex = 1
			while offset >= ranges[gridIndex].count do
				offset -= ranges[gridIndex].count
				gridIndex += 1
			end
			local grid, range = grids[gridIndex], ranges[gridIndex]
			local cx, cz = range.x + offset // range.columns, range.z + offset % range.columns
			local key = Rules.key(grid, cx, cz)
			local entry = cells[key]
			if taken[grid.id][key] or (entry and (entry.model or entry.tries >= MAX_TRIES or now < entry.retryAt)) then
				continue
			end
			if not entry then
				entry = {
					key = key,
					x = cx * grid.cell + grid.cell / 2,
					z = cz * grid.cell + grid.cell / 2,
					keep = range.radius + KEEP_MARGIN,
					tries = 0,
					retryAt = 0,
				}
				cells[key] = entry
				table.insert(entries, entry)
			end
			built += 1
			local hit, rng, retry = Rules.plan(grid, cx, cz, data.seed, inLake, sample)
			if hit and rng then
				local frame, template, scale = Rules.frame(hit, rng)
				entry.model = place(Rules.style(hit.Position), template, frame, scale)
			else
				entry.tries = if retry then entry.tries + 1 else MAX_TRIES
				entry.retryAt = now + RETRY_SECONDS
			end
		end
		return built
	end
	return update, cells
end

function SeabedCarpet.start()
	if started then
		return
	end
	started = true
	local source = ReplicatedStorage:WaitForChild(Rules.FOLDER, math.huge)
	local lake = source:WaitForChild("Lake", math.huge) :: StringValue
	local gardens = source:WaitForChild("Gardens", math.huge) :: StringValue
	local templates: { [string]: { Model } } = {}
	for _, id in Rules.STYLES do
		local folder = source:WaitForChild(id, math.huge)
		local list = {}
		for index = 1, Rules.TEMPLATES do
			list[index] = folder:WaitForChild(tostring(index), math.huge) :: Model
		end
		templates[id] = list
	end

	local folder = Instance.new("Folder")
	folder.Name = "SeabedCarpet"
	folder.Parent = workspace
	-- Terrain is read from voxels, never raycast: a ray into a terrain chunk this client hasn't
	-- queried builds that chunk's collision first (RaycastTerrain > buildKDTree, tens of ms),
	-- and a moving camera reaches fresh seabed chunks with every new ring of cells.
	local TerrainProbe = require(script.Parent.TerrainProbe)
	local TOP, BOTTOM = 600, -120
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { folder, workspace.Terrain }
	params.IgnoreWater = true

	-- Same acceptance as the server's garden sampling. Anything else in the way
	-- (an unstreamed island, a swimmer, a crab cage) is retried a few times.
	local function sample(x: number, z: number): (RaycastResult?, boolean)
		local partHit = workspace:Raycast(Vector3.new(x, TOP, z), Vector3.new(0, BOTTOM - TOP, 0), params)
		local floor, normal, surface = TerrainProbe.seabed(x, z, BOTTOM)
		local hit: any = partHit
		if not partHit or (floor and floor > partHit.Position.Y) then
			if floor then
				hit = { Position = Vector3.new(x, floor, z), Normal = normal, Instance = workspace.Terrain }
			elseif surface == "land" then
				return nil, false
			else
				return nil, true -- terrain not streamed in yet
			end
		end
		if
			hit.Position.Y >= Biomes.WaterLevel - 8
			or hit.Normal.Y <= 0.78
			or not Biomes.inOceanBounds(hit.Position)
		then
			return nil, false
		end
		if not groundOf(hit.Instance) then
			return nil, true
		end
		return hit, false
	end
	local function place(style: string, template: number, frame: CFrame, scale: number): Model?
		local pool = templates[style] or templates.open
		local patch = pool[template]:Clone()
		patch:ScaleTo(scale)
		patch:PivotTo(frame)
		patch.Parent = folder
		return patch
	end

	local update = SeabedCarpet.tracker({
		seed = source:GetAttribute("Seed") or 0,
		lake = Rules.decode(lake.Value),
		gardens = Rules.decode(gardens.Value),
	}, sample, place)
	RunService.Heartbeat:Connect(profiled("SeabedCarpet", function()
		local camera = workspace.CurrentCamera
		if camera then
			update(camera.CFrame.Position, os.clock())
		end
	end))
end

return SeabedCarpet
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="353">
          <Properties>
            <string name="Name">SeasonFoliage</string>
            <string name="Source"><![CDATA[-- Recolours grass and tree foliage on this client to match the season. Summer is
-- the map as built; every other season is a tint over each part's own colour, so
-- the builders' shading survives. Foliage is any green Grass or LeafyGrass part,
-- plus the terrain's grass materials, picked up again as islands stream in. The tropics (the Coral
-- Shallows and Pirate Cove) have no seasons, so their foliage stays as built all year.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Seasons = require(ReplicatedStorage.Shared.Seasons)
local Biomes = require(ReplicatedStorage.Shared.Biomes)

local SeasonFoliage = {}

local BATCH = 600 -- parts recoloured per frame when the season turns
local GROUND_AREA = 400 -- a part this wide on top is lawn, not leaves
local PIECE_TAG = "LodPiece" -- streamed map pieces (server/Map/Lod)
local rgb = Color3.fromRGB

local SPRING = rgb(132, 198, 84)
local AUTUMN_GROUND = rgb(158, 140, 72)
local AUTUMN_LEAVES = { rgb(214, 124, 42), rgb(188, 72, 38), rgb(228, 178, 62), rgb(162, 98, 46) }
local SNOW = rgb(234, 240, 244)
local FROST = rgb(222, 230, 234)

local foliageMaterials = { [Enum.Material.Grass] = true, [Enum.Material.LeafyGrass] = true }

local function isGreen(color: Color3): boolean
	local h, s, v = color:ToHSV()
	return h >= 0.16 and h <= 0.48 and s >= 0.18 and v >= 0.12
end

local function tint(original: Color3, season: string, ground: boolean, seed: number): Color3
	if season == "Spring" then
		return original:Lerp(SPRING, 0.35)
	elseif season == "Autumn" then
		if ground then
			return original:Lerp(AUTUMN_GROUND, 0.55)
		end
		return original:Lerp(AUTUMN_LEAVES[seed % #AUTUMN_LEAVES + 1], 0.72)
	elseif season == "Winter" then
		return original:Lerp(if ground then SNOW else FROST, if ground then 0.8 else 0.5)
	end
	return original
end

-- Neighbouring leaves get different autumn colours, but a part keeps its own.
local function seedOf(part: BasePart): number
	local p = part.Position
	return math.abs(
		math.floor(p.X * 0.37) * 73856093 + math.floor(p.Y * 0.53) * 19349663 + math.floor(p.Z * 0.41) * 83492791
	)
end

function SeasonFoliage.tint(original: Color3, season: string, ground: boolean, seed: number): Color3
	return tint(original, season, ground, seed)
end

function SeasonFoliage.start()
	type Entry = { original: Color3, ground: boolean, seed: number }
	local tracked: { [BasePart]: Entry } = setmetatable({}, { __mode = "k" }) :: any
	local season = Seasons.current()
	local terrain = workspace.Terrain
	local terrainOriginal = {}
	for material in foliageMaterials do
		terrainOriginal[material] = terrain:GetMaterialColor(material)
	end

	local function apply(part: BasePart, entry: Entry)
		part.Color = tint(entry.original, season, entry.ground, entry.seed)
	end

	local function consider(item: Instance)
		if not item:IsA("BasePart") or tracked[item] or not foliageMaterials[item.Material] then
			return
		end
		if not isGreen(item.Color) or item:GetAttribute("SeasonExempt") then
			return
		end
		if Biomes.at(item.Position).id == "tropical" then
			return
		end
		-- Characters, held tools and boats keep their own colours.
		local model = item:FindFirstAncestorWhichIsA("Model")
		if item:FindFirstAncestorWhichIsA("Tool") or (model and model:FindFirstChildOfClass("Humanoid")) then
			return
		end
		local entry = {
			original = item.Color,
			ground = item.Size.X * item.Size.Z >= GROUND_AREA and item.Size.Y < math.min(item.Size.X, item.Size.Z),
			seed = seedOf(item),
		}
		tracked[item] = entry
		if season ~= "Summer" then
			apply(item, entry)
		end
	end

	local function applyTerrain()
		for material, original in terrainOriginal do
			terrain:SetMaterialColor(material, tint(original, season, true, 0))
		end
	end

	local generation = 0
	local function recolour()
		generation += 1
		local mine = generation
		applyTerrain()
		-- Parts streaming in mid-pass are tinted on arrival, so a snapshot is enough.
		local parts = {}
		for part in tracked do
			table.insert(parts, part)
		end
		local count = 0
		for _, part in parts do
			if mine ~= generation then
				return
			end
			local entry = tracked[part]
			if entry and part.Parent then
				apply(part, entry)
				count += 1
				if count % BATCH == 0 then
					RunService.Heartbeat:Wait()
				end
			end
		end
	end

	-- Map content streams in as LodPiece models that arrive whole (PersistentPerPlayer), so one
	-- scan per piece picks up its foliage. Watching workspace.DescendantAdded instead resumed a
	-- script thread for every part, weld and decal streaming in: tens of thousands per island,
	-- the deferredThreads storms in the MicroProfiler.
	local function scanPiece(piece: Instance)
		for _, item in piece:GetDescendants() do
			consider(item)
		end
	end
	CollectionService:GetInstanceAddedSignal(PIECE_TAG):Connect(scanPiece)
	task.spawn(function()
		local count = 0
		for _, item in workspace:GetDescendants() do
			consider(item)
			count += 1
			if count % 4000 == 0 then
				RunService.Heartbeat:Wait()
			end
		end
	end)
	applyTerrain()

	-- The clock turns the season every few in-game days; the override flips it at once.
	local function check()
		local now = Seasons.current()
		if now ~= season then
			season = now
			task.spawn(recolour)
		end
	end
	workspace:GetAttributeChangedSignal("SeasonOverride"):Connect(check)
	task.spawn(function()
		while Players.LocalPlayer do
			task.wait(5)
			check()
		end
	end)
end

return SeasonFoliage
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="354">
          <Properties>
            <string name="Name">ServerUpdates</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))
local Service = {}
local started = false

function Service.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local gui = Instance.new("ScreenGui")
	gui.Name = "ServerUpdateNotice"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 1100
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")
	local panel = Instance.new("Frame")
	panel.AnchorPoint = Vector2.new(0.5, 0)
	panel.Position = UDim2.new(0.5, 0, 0, 12)
	panel.Size = UDim2.new(1, -24, 0, 154)
	panel.Parent = gui
	Theme.panel(panel)
	local constraint = Instance.new("UISizeConstraint")
	constraint.MaxSize = Vector2.new(540, 154)
	constraint.Parent = panel
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(14, 8)
	title.Size = UDim2.new(1, -28, 0, 26)
	title.TextSize = 20
	Theme.text(title)
	title.Parent = panel
	local description = Instance.new("TextLabel")
	description.BackgroundTransparency = 1
	description.Position = UDim2.fromOffset(14, 38)
	description.Size = UDim2.new(1, -28, 0, 56)
	description.TextSize = 14
	description.TextWrapped = true
	Theme.text(description, Theme.Colors.Muted)
	description.Parent = panel
	local button = Instance.new("TextButton")
	button.AnchorPoint = Vector2.new(0.5, 1)
	button.Position = UDim2.new(0.5, 0, 1, -10)
	button.Size = UDim2.new(1, -28, 0, 38)
	button.TextSize = 16
	Theme.text(button)
	Theme.button(button, "Selected")
	button.Parent = panel
	button.Activated:Connect(function()
		local remote = ReplicatedStorage:FindFirstChild("JoinUpdatedServer")
		if remote and not player:GetAttribute("FishingWatersUpdateStatus") then
			remote:FireServer()
		end
	end)
	local function refresh()
		local status = player:GetAttribute("FishingWatersUpdateStatus")
		gui.Enabled = ReplicatedStorage:GetAttribute("FishingWatersUpdateAvailable") == true or status ~= nil
		local maintenance = ReplicatedStorage:GetAttribute("FishingWatersRestartKind") == "Maintenance"
		title.Text = if maintenance then "Server restarting" else "Update available!"
		description.Text = if status
			then "Taking you to a fresh server. If Roblox is busy, we'll keep trying automatically."
			else "This server is running an older version. Join a newer server to play the latest update."
		local restart = ReplicatedStorage:GetAttribute("FishingWatersRestartAt") or 0
		if not status and restart > 0 then
			description.Text = "This server is restarting soon. You can move to a fresh server now."
		end
		button.Text = if status == "Retrying"
			then "Connection failed — retrying…"
			elseif status then "Joining fresh server…"
			else "Join updated server"
		button.Active = status == nil
		button.AutoButtonColor = status == nil
	end
	for _, attribute in { "FishingWatersUpdateAvailable", "FishingWatersRestartAt", "FishingWatersRestartKind" } do
		ReplicatedStorage:GetAttributeChangedSignal(attribute):Connect(refresh)
	end
	player:GetAttributeChangedSignal("FishingWatersUpdateStatus"):Connect(refresh)
	refresh()
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="355">
          <Properties>
            <string name="Name">SharkSwim</string>
            <string name="Source"><![CDATA[-- The invisible server-owned root remains the combat and navigation position.
-- Only the visible pieces are interpolated locally between server updates.
local RunService = game:GetService("RunService")

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end

local SharkSwim = {}
-- Joints in server SharkModel: SwimFlex pieces bend at the hips and SwimTail
-- pieces bend there and again at the tail stalk, so a wave runs down the body.
local FLEX_PIVOT = CFrame.new(0, -1.4, 1.6)
local TAIL_PIVOT = CFrame.new(0, -1.35, 3.2)
local FLEX_PIVOT_INVERSE = FLEX_PIVOT:Inverse()
local TAIL_PIVOT_INVERSE = TAIL_PIVOT:Inverse()
local SMOOTHING = 22
local REFRESH_INTERVAL = 0.5
-- Every piece is rewritten when a shark moves; past this range the body wave
-- can't be seen, so far sharks step every few frames.
local NEAR_DISTANCE = 250
local FAR_STRIDE = 4

function SharkSwim.start()
	local folder = workspace:WaitForChild("Sharks")
	local states = {}
	local function add(model)
		if model:IsA("Model") and not states[model] then
			states[model] = { parts = {}, refresh = 0, phase = math.random() * math.pi * 2 }
		end
	end
	for _, model in folder:GetChildren() do
		add(model)
	end
	folder.ChildAdded:Connect(add)
	folder.ChildRemoved:Connect(function(model)
		states[model] = nil
	end)

	local frame = 0
	RunService.RenderStepped:Connect(profiled("SharkSwim", function(dt)
		frame += 1
		local camera = workspace.CurrentCamera
		local eye = camera and camera.CFrame.Position
		local now = workspace:GetServerTimeNow()
		local alpha = 1 - math.exp(-SMOOTHING * math.min(dt, 0.25))
		local moved, frames = {}, {}
		for model, state in states do
			local root = model.PrimaryPart
			if not root or not root:IsDescendantOf(model) then
				-- Streaming can remove and later restore the root and its pieces.
				state.frame = nil
				continue
			end
			local target = root.CFrame
			if not state.frame or (state.frame.Position - target.Position).Magnitude > 35 then
				state.frame = target
			else
				state.frame = state.frame:Lerp(target, alpha)
			end
			if now >= state.refresh then
				state.refresh = now + REFRESH_INTERVAL
				local parts = {}
				for _, piece in model:GetDescendants() do
					if piece:IsA("BasePart") and piece ~= root then
						local offset = piece:GetAttribute("SwimOffset")
						if typeof(offset) == "CFrame" then
							local joint = if piece:GetAttribute("SwimTail") == true
								then "tail"
								elseif piece:GetAttribute("SwimFlex") == true then "flex"
								else nil
							table.insert(parts, { part = piece, offset = offset, joint = joint })
						end
					end
				end
				state.parts = parts
			end
			if eye and (state.frame.Position - eye).Magnitude > NEAR_DISTANCE and (frame + math.floor(state.phase * 10)) % FAR_STRIDE ~= 0 then
				continue
			end
			-- The head swings against the tail, each joint lagging the one ahead.
			local phase = now * 5 + state.phase
			local body = state.frame * CFrame.Angles(0, math.sin(phase) * 0.03, math.sin(phase - 0.6) * 0.035)
			local flex = FLEX_PIVOT * CFrame.Angles(0, math.sin(phase - 1.3) * 0.15, 0) * FLEX_PIVOT_INVERSE
			local joints = {
				flex = body * flex,
				tail = body
					* flex
					* TAIL_PIVOT
					* CFrame.Angles(0, math.sin(phase - 2.3) * 0.32, 0)
					* TAIL_PIVOT_INVERSE,
			}
			for _, entry in state.parts do
				if entry.part:IsDescendantOf(model) then
					table.insert(moved, entry.part)
					table.insert(frames, (if entry.joint then joints[entry.joint] else body) * entry.offset)
				end
			end
		end
		if #moved > 0 then
			workspace:BulkMoveTo(moved, frames, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end))
end

return SharkSwim
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="356">
          <Properties>
            <string name="Name">ShopCustomers</string>
            <string name="Source"><![CDATA[-- Freezer and customer prompts belong to the base owner; everyone else never sees
-- them. Shop notices use the standard Roblox notification.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local ShopCustomers = {}
local OWNER_PROMPT_TAG = "ShopOwnerPrompt"
local started = false

local function bindPrompt(prompt: Instance)
	if not prompt:IsA("ProximityPrompt") then
		return
	end
	local function refresh()
		-- Local only: the server never writes Enabled on these prompts. It marks a
		-- prompt that doesn't apply right now (a busy kitchen station) Available = false.
		prompt.Enabled = prompt:GetAttribute("OwnerUserId") == Players.LocalPlayer.UserId
			and prompt:GetAttribute("Available") ~= false
	end
	prompt:GetAttributeChangedSignal("OwnerUserId"):Connect(refresh)
	prompt:GetAttributeChangedSignal("Available"):Connect(refresh)
	refresh()
end

function ShopCustomers.start()
	if started then
		return
	end
	started = true
	CollectionService:GetInstanceAddedSignal(OWNER_PROMPT_TAG):Connect(bindPrompt)
	for _, prompt in CollectionService:GetTagged(OWNER_PROMPT_TAG) do
		bindPrompt(prompt)
	end
	local update = ReplicatedStorage:WaitForChild("ShopCustomers"):WaitForChild("Update") :: RemoteEvent
	update.OnClientEvent:Connect(function(kind, message)
		if kind == "Notice" and type(message) == "string" then
			pcall(StarterGui.SetCore, StarterGui, "SendNotification", {
				Title = "Fish & Tackle",
				Text = message,
				Duration = 5,
			})
		end
	end)
end

return ShopCustomers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="357">
          <Properties>
            <string name="Name">ShoreWaves</string>
            <string name="Source"><![CDATA[-- Short foam crests move from the shallows onto the sand, widen, then dissolve.
-- Only invisible shoreline samples replicate; all moving effects stay on the client.
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local WaterQuality = require(script.Parent.WaterQuality)

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end

local ShoreWaves = {}
local TAG = "ShoreWaveSource"
local PERIOD = 9.2
local DISTANCE = 550
local started = false

local function smoothstep(x: number): number
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

local function sampleWave(time: number, along: number, layer: number): (number, number, number)
	-- A gentle phase shift down the beach makes each crest break progressively.
	local phase = (time / PERIOD + layer / 2 - along / 350 - math.sin(along / 55) * 0.08) % 1
	local travel = 1 - (1 - phase) ^ 1.6
	local offset = -10 + 12.8 * travel
	local opacity = 0.46 * smoothstep(phase / 0.16) * (1 - smoothstep((phase - 0.55) / 0.40))
	local width = 0.28 + 0.8 * smoothstep((phase - 0.28) / 0.6)
	return offset, opacity, width
end

local function attachmentFrame(position: Vector3, tangent: Vector3): CFrame
	-- Attachment Y lies across the crest, keeping the foam flat on the water.
	return CFrame.fromMatrix(position, tangent, Vector3.yAxis:Cross(tangent).Unit)
end

function ShoreWaves.start()
	if started then
		return
	end
	started = true
	local sources = {}

	local function remove(source: Instance)
		local state = sources[source]
		if state then
			for _, wave in state.waves do
				wave.beam:Destroy()
				wave.a:Destroy()
				wave.b:Destroy()
			end
			sources[source] = nil
		end
	end

	local function add(source: Instance)
		if sources[source] or not source:IsA("BasePart") then
			return
		end
		local shore = { source:GetAttribute("Shore1"), source:GetAttribute("Shore2") }
		local inland = { source:GetAttribute("Inland1"), source:GetAttribute("Inland2") }
		local water = { source:GetAttribute("WaterHeight1"), source:GetAttribute("WaterHeight2") }
		local runup = { source:GetAttribute("RunupHeight1"), source:GetAttribute("RunupHeight2") }
		for i = 1, 2 do
			if
				typeof(shore[i]) ~= "Vector3"
				or typeof(inland[i]) ~= "Vector3"
				or typeof(water[i]) ~= "number"
				or typeof(runup[i]) ~= "number"
			then
				return
			end
		end
		local delta = shore[2] - shore[1]
		if delta.Magnitude < 0.1 then
			return
		end
		local tangent = delta.Unit
		local along = source:GetAttribute("Along") or 0
		local state = {
			shore = shore,
			inland = inland,
			water = water,
			runup = runup,
			along = along,
			fade = source:GetAttribute("EdgeFade") or 1,
			waves = {},
			visible = nil :: boolean?,
		}
		for layer = 0, 1 do
			local a, b = Instance.new("Attachment"), Instance.new("Attachment")
			a.Name, b.Name = "SurfStart", "SurfEnd"
			a.Parent, b.Parent = source, source
			local beam = Instance.new("Beam")
			beam.Name = "LappingWave"
			beam.Attachment0, beam.Attachment1 = a, b
			beam.FaceCamera = false
			beam.Segments = 12
			beam.CurveSize0, beam.CurveSize1 = delta.Magnitude / 3, delta.Magnitude / 3
			beam.Color = ColorSequence.new(Color3.fromRGB(218, 240, 241))
			-- Built-in soft texture avoids the hard edges and triangle seams of the old strips.
			beam.Texture = "rbxasset://textures/particles/smoke_main.dds"
			beam.TextureMode = Enum.TextureMode.Wrap
			beam.TextureLength = 3.4 + math.sin(along / 17) * 0.6
			beam.TextureSpeed = 0.04
			beam.LightEmission = 0
			beam.LightInfluence = 1
			-- Separate the foam from the nearly coplanar sand/water depth surface.
			beam.ZOffset = 0.15
			beam.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.18, 0.15),
				NumberSequenceKeypoint.new(0.45, 0),
				NumberSequenceKeypoint.new(0.72, 0.25),
				NumberSequenceKeypoint.new(1, 1),
			})
			beam.Enabled = false
			beam.Parent = source
			table.insert(state.waves, {
				a = a,
				b = b,
				beam = beam,
				layer = layer,
				tangentA = (tangent + inland[1] * 0.18).Unit,
				tangentB = (tangent - inland[2] * 0.18).Unit,
			})
		end
		sources[source] = state
	end

	CollectionService:GetInstanceAddedSignal(TAG):Connect(add)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(remove)
	for _, source in CollectionService:GetTagged(TAG) do
		add(source)
	end

	-- Shore foam is close to the camera: stepping it at 30 Hz visibly judders
	-- on higher-refresh displays. Server time still keeps every frame in phase.
	RunService.RenderStepped:Connect(profiled("ShoreWaves", function()
		local camera = workspace.CurrentCamera
		local cameraPosition = camera and camera.CFrame.Position
		local time = workspace:GetServerTimeNow()
		for source, state in sources do
			local visible = WaterQuality.layeredEnabled()
				and cameraPosition ~= nil
				and (source.Position - cameraPosition).Magnitude < DISTANCE
				and source:IsDescendantOf(workspace)
			-- Most of the map's shoreline is far away: leave its beams alone rather than
			-- writing every one of them each frame
			if not visible and state.visible == false then
				continue
			end
			state.visible = visible
			for _, wave in state.waves do
				local beam = wave.beam
				beam.Enabled = visible
				if not visible then
					continue
				end
				local offset, opacity, width = sampleWave(time, state.along, wave.layer)
				for i = 1, 2 do
					local attachment = if i == 1 then wave.a else wave.b
					-- Keep the shoreward wash steady instead of wobbling its endpoints.
					local ripple = math.sin(state.along / 35 + time * 0.25 + i * 0.2 + wave.layer) * 0.06
					local distance = offset + ripple
					local height = 0.16
						+ (state.water[i] - 0.16) * smoothstep((distance + 2) / 2)
						+ (state.runup[i] - state.water[i]) * smoothstep(distance / 2.8)
					local position = state.shore[i] + state.inland[i] * distance + Vector3.yAxis * height
					attachment.CFrame = attachmentFrame(position, if i == 1 then wave.tangentA else wave.tangentB)
				end
				beam.Width0 = width * (0.85 + math.sin(state.along / 13) * 0.15)
				beam.Width1 = width
				beam.LocalTransparencyModifier = 1 - opacity * state.fade
			end
		end
	end))
end

return ShoreWaves
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="358">
          <Properties>
            <string name="Name">SpearCombat</string>
            <string name="Source"><![CDATA[-- The server owns shark health and validates every strike. This module supplies
-- an aim point and immediate local feedback for the equipped spear.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local SpearSkins = require(ReplicatedStorage:WaitForChild("Shared").SpearSkins)

local SpearCombat = {}
local started = false
local COOLDOWN = 0.6

function SpearCombat.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local attack = ReplicatedStorage:WaitForChild("SpearAttack") :: RemoteEvent
	local lastTouch: Vector2? = nil
	local lastTouchAt = 0
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.UserInputType == Enum.UserInputType.Touch then
			lastTouch = Vector2.new(input.Position.X, input.Position.Y)
			lastTouchAt = os.clock()
		end
	end)

	local gui = Instance.new("ScreenGui")
	gui.Name = "SpearHint"
	gui.ResetOnSpawn = false
	gui.Parent = player:WaitForChild("PlayerGui")
	local hint = Instance.new("TextLabel")
	hint.AnchorPoint = Vector2.new(0.5, 1)
	hint.Position = UDim2.new(0.5, 0, 1, -96)
	hint.Size = UDim2.fromOffset(340, 34)
	hint.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
	hint.BackgroundTransparency = 0.25
	hint.BorderSizePixel = 0
	hint.Font = Enum.Font.GothamMedium
	hint.TextSize = 14
	hint.TextColor3 = Color3.fromRGB(240, 240, 236)
	hint.Text = if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
		then "Tap a nearby shark to strike"
		else "Aim at a nearby shark and click to strike"
	hint.Visible = false
	hint.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = hint

	local function aimPoint(): Vector3?
		local camera = workspace.CurrentCamera
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not camera or not root or not root:IsA("BasePart") then
			return nil
		end
		local screen = if lastTouch and os.clock() - lastTouchAt < 0.5
			then lastTouch
			else UserInputService:GetMouseLocation()
		local ray = camera:ScreenPointToRay(screen.X, screen.Y)
		local chosen, closest = nil, math.huge
		local sharks = workspace:FindFirstChild("Sharks")
		if sharks then
			for _, shark in sharks:GetChildren() do
				local part = if shark:IsA("Model") then shark.PrimaryPart else nil
				if part then
					local point = part.Position + Vector3.new(0, -1.3, 0)
					local offset = point - ray.Origin
					local along = offset:Dot(ray.Direction)
					local miss = (offset - ray.Direction * along).Magnitude
					if along > 0 and miss <= 5.5 and (point - root.Position).Magnitude <= 30 and miss < closest then
						chosen, closest = point, miss
					end
				end
			end
		end
		return chosen or ray.Origin + ray.Direction * 1000
	end

	-- Rewards can arrive after the spear has been put away.
	task.spawn(function()
		local loot = ReplicatedStorage:WaitForChild("SharkLoot") :: RemoteEvent
		local notice = Instance.new("TextLabel")
		notice.Name = "SharkLootNotice"
		notice.AnchorPoint = Vector2.new(0.5, 1)
		notice.Position = UDim2.new(0.5, 0, 1, -145)
		notice.Size = UDim2.new(0.85, 0, 0, 80)
		notice.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
		notice.BackgroundTransparency = 0.15
		notice.BorderSizePixel = 0
		notice.Font = Enum.Font.GothamMedium
		notice.TextSize = 15
		notice.TextWrapped = true
		notice.TextColor3 = Color3.fromRGB(240, 240, 236)
		notice.Visible = false
		notice.Parent = gui
		local limit = Instance.new("UISizeConstraint")
		limit.MaxSize = Vector2.new(560, 80)
		limit.Parent = notice
		local noticeCorner = Instance.new("UICorner")
		noticeCorner.CornerRadius = UDim.new(0, 6)
		noticeCorner.Parent = notice
		local noticeId = 0
		loot.OnClientEvent:Connect(function(drops, saved, overflow)
			local names = {}
			if type(drops) == "table" then
				for _, drop in drops do
					if type(drop) == "table" and type(drop.Name) == "string" then
						table.insert(names, drop.Name)
					end
				end
			end
			noticeId += 1
			local current = noticeId
			if saved == false then
				notice.Text = "Your shark rewards could not be granted. Please try again."
			else
				notice.Text = "Shark rewards: "
					.. table.concat(names, ", ")
					.. (
						if overflow
							then "\nOverflow was saved in storage. Place a storage rack to collect it if needed."
							else ""
					)
			end
			notice.Visible = true
			task.delay(7, function()
				if noticeId == current then
					notice.Visible = false
				end
			end)
		end)
	end)

	local active: Tool? = nil
	local connections = {}
	local lastAttack = 0
	-- Replicated health gives attackers feedback even when several people hit
	-- the same shark. The server remains authoritative over every hit.
	task.spawn(function()
		local bars = {}
		while gui.Parent do
			local seen = {}
			local sharks = workspace:FindFirstChild("Sharks")
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if active and sharks and root and root:IsA("BasePart") then
				for _, shark in sharks:GetChildren() do
					local part = if shark:IsA("Model") then shark.PrimaryPart else nil
					local health, maximum = shark:GetAttribute("Health"), shark:GetAttribute("MaxHealth")
					if
						part
						and type(health) == "number"
						and type(maximum) == "number"
						and maximum > 0
						and (part.Position - root.Position).Magnitude <= 35
					then
						local bar = bars[shark]
						if not bar then
							bar = Instance.new("BillboardGui")
							bar.Name = "SharkHealth"
							bar.Adornee = part
							bar.Size = UDim2.fromOffset(120, 26)
							bar.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
							bar.AlwaysOnTop = true
							local label = Instance.new("TextLabel")
							label.Name = "Label"
							label.Size = UDim2.fromScale(1, 1)
							label.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
							label.BackgroundTransparency = 0.25
							label.BorderSizePixel = 0
							label.Font = Enum.Font.GothamBold
							label.TextColor3 = Color3.fromRGB(240, 240, 236)
							label.TextSize = 13
							label.Parent = bar
							bar.Parent = gui
							bars[shark] = bar
						end
						bar.Label.Text = string.format("SHARK  %.1f / %d", math.max(0, health), maximum)
						seen[shark] = true
					end
				end
			end
			for shark, bar in bars do
				if not seen[shark] then
					bar:Destroy()
					bars[shark] = nil
				end
			end
			task.wait(0.15)
		end
	end)
	local function unbind()
		for _, connection in connections do
			connection:Disconnect()
		end
		table.clear(connections)
		active = nil
		hint.Visible = false
	end
	local function bind(tool: Tool)
		if active == tool then
			return
		end
		unbind()
		active = tool
		hint.Visible = true
		table.insert(
			connections,
			tool.Activated:Connect(function()
				if tool.Parent ~= player.Character or player:GetAttribute("PlayerMenuOpen") then
					return
				end
				local now = os.clock()
				local boosts = SpearSkins.boosts(player:GetAttribute("SpearSkin"), player:GetAttribute("SpearSkinWear"))
				if now - lastAttack < COOLDOWN / (1 + boosts.fireRate) then
					return
				end
				local point = aimPoint()
				if not point then
					return
				end
				lastAttack = now
				attack:FireServer(point)
				local grip = tool.Grip
				local thrust =
					TweenService:Create(tool, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
						Grip = grip * CFrame.new(0, 0, -1),
					})
				thrust:Play()
				task.delay(0.12, function()
					if tool.Parent then
						TweenService:Create(tool, TweenInfo.new(0.2), { Grip = grip }):Play()
					end
				end)
			end)
		)
		table.insert(connections, tool.Unequipped:Connect(unbind))
		table.insert(
			connections,
			tool.AncestryChanged:Connect(function()
				if tool.Parent ~= player.Character then
					unbind()
				end
			end)
		)
	end
	local function watchCharacter(character: Model)
		unbind()
		local function inspect(child: Instance)
			if child:IsA("Tool") and child:GetAttribute("SpearId") == "BasicSpear" then
				bind(child)
			end
		end
		character.ChildAdded:Connect(inspect)
		for _, child in character:GetChildren() do
			inspect(child)
		end
	end
	player.CharacterAdded:Connect(watchCharacter)
	if player.Character then
		watchCharacter(player.Character)
	end
end

return SpearCombat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="359">
          <Properties>
            <string name="Name">Sprint</string>
            <string name="Source"><![CDATA[-- Hold Shift to move faster while on foot.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Sprint = {}
local SPRINT_SPEED = 24
local started = false
local shiftHeld = false
local humanoid: Humanoid? = nil
local normalSpeed = 16

local function applySpeed()
	local currentHumanoid = humanoid
	if not currentHumanoid or currentHumanoid.Health <= 0 then
		return
	end
	currentHumanoid.WalkSpeed = if shiftHeld and not currentHumanoid.Sit then SPRINT_SPEED else normalSpeed
end

local function bindCharacter(character: Model)
	humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	normalSpeed = humanoid.WalkSpeed
	humanoid.Seated:Connect(applySpeed)
	humanoid.Died:Connect(function()
		shiftHeld = false
	end)
	applySpeed()
end

function Sprint.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	player.CharacterAdded:Connect(bindCharacter)
	player.CharacterRemoving:Connect(function()
		shiftHeld = false
		humanoid = nil
	end)
	if player.Character then
		task.spawn(bindCharacter, player.Character)
	end
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or UserInputService:GetFocusedTextBox() then
			return
		end
		if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
			shiftHeld = true
			applySpeed()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
			shiftHeld = false
			applySpeed()
		end
	end)
end

return Sprint
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="360">
          <Properties>
            <string name="Name">StaffPreview</string>
            <string name="Source"><![CDATA[-- Cached, local-only avatars. No preview model ever enters the live world.
local Players = game:GetService("Players")
local Staff = require(game:GetService("ReplicatedStorage").Shared.StaffCatalog)
local Preview = {}
local templates, pending = {}, {}

-- Accessories can contain oversized or displaced handles. Frame the rig itself
-- so a single Marketplace item cannot shrink the entire portrait to a dot.
local function bodyBounds(model: Model): (Vector3, Vector3)
	local low = Vector3.new(math.huge, math.huge, math.huge)
	local high = Vector3.new(-math.huge, -math.huge, -math.huge)
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
			local half = part.Size / 2
			for x = -1, 1, 2 do
				for y = -1, 1, 2 do
					for z = -1, 1, 2 do
						local point = part.CFrame:PointToWorldSpace(Vector3.new(half.X * x, half.Y * y, half.Z * z))
						low = Vector3.new(math.min(low.X, point.X), math.min(low.Y, point.Y), math.min(low.Z, point.Z))
						high = Vector3.new(math.max(high.X, point.X), math.max(high.Y, point.Y), math.max(high.Z, point.Z))
					end
				end
			end
		end
	end
	if low.X == math.huge then
		local box, size = model:GetBoundingBox()
		return box.Position, size
	end
	-- Leave room above the head for hats without trusting accessory bounds.
	high += Vector3.new(0, 0.8, 0)
	return (low + high) / 2, high - low
end

local function load(role, callback)
	if templates[role] then
		callback(templates[role])
		return
	end
	if pending[role] then
		table.insert(pending[role], callback)
		return
	end
	pending[role] = { callback }
	task.spawn(function()
		local description
		local ok, model = pcall(function()
			description = Staff.description(role)
			return Players:CreateHumanoidModelFromDescriptionAsync(description, Enum.HumanoidRigType.R15)
		end)
		if description then
			description:Destroy()
		end
		if ok then
			Staff.finishModel(model)
			for _, item in model:GetDescendants() do
				if item:IsA("BasePart") then
					-- Keep the rig stationary while allowing accessory welds to place
					-- their handles correctly relative to the head and body.
					item.Anchored = item.Name == "HumanoidRootPart"
					item.CanCollide, item.CanTouch, item.CanQuery = false, false, false
				elseif item:IsA("Script") or item:IsA("LocalScript") then
					item:Destroy()
				end
			end
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			end
			templates[role] = model
		end
		local callbacks = pending[role]
		pending[role] = nil
		for _, waiting in callbacks do
			waiting(if ok then model else nil)
		end
	end)
end

-- Status text lives beside the viewport: nested GUI objects do not render in it.
function Preview.show(view: ViewportFrame, role: string, status: TextLabel, portrait: boolean?)
	local camera = Instance.new("Camera")
	camera.FieldOfView = 32
	camera.Parent = view
	view.CurrentCamera = camera
	view.Ambient = Color3.fromRGB(185, 185, 185)
	view.LightColor = Color3.fromRGB(255, 244, 226)
	view.LightDirection = Vector3.new(-1, -1, -2)
	local angle, bounds, center = if portrait then 0 else math.rad(20), nil, nil
	local function frame()
		if not bounds or not view.Parent then
			return
		end
		local aspect = math.max(0.1, view.AbsoluteSize.X / math.max(1, view.AbsoluteSize.Y))
		-- Fit every angle, including the shoulders when the preview is narrow.
		local width = if portrait then bounds.X else math.sqrt(bounds.X * bounds.X + bounds.Z * bounds.Z)
		local distance = math.max(bounds.Y, width / aspect) / (2 * math.tan(math.rad(camera.FieldOfView / 2)))
		distance = if portrait then distance * 1.04 else distance * 1.12 + width / 2
		camera.CFrame = CFrame.lookAt(
			center + Vector3.new(math.sin(angle) * distance, bounds.Y * 0.035, -math.cos(angle) * distance),
			center
		)
	end
	view:GetPropertyChangedSignal("AbsoluteSize"):Connect(frame)
	load(role, function(template)
		-- The player may have changed tabs or closed Home while the avatar loaded.
		if not view.Parent then
			return
		end
		if not template then
			status.Text = "Preview unavailable. Reopen Workers to retry."
			return
		end
		local world = Instance.new("WorldModel")
		world.Parent = view
		local model = template:Clone()
		model.Name, model.Parent = role .. "Preview", world
		model:PivotTo(CFrame.new())
		center, bounds = bodyBounds(model)
		if portrait then
			-- Frame the head and torso, including headwear, instead of shrinking the
			-- entire rig into a card. The lower body is deliberately cropped.
			local height = bounds.Y * 0.58
			center += Vector3.new(0, (bounds.Y - height) / 2, 0)
			bounds = Vector3.new(bounds.X, height, bounds.Z)
		end
		status.Visible = false
		frame()
	end)
	return function(direction)
		angle += math.rad(45) * direction
		frame()
	end
end

return Preview
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="361">
          <Properties>
            <string name="Name">StockApp</string>
            <string name="Source"><![CDATA[-- Harbour Exchange: the investment app on the office PC (opened by OfficeComputer). Three pages:
-- MARKET (live list, chart, buy/sell), PORTFOLIO (holdings and profit) and DIVIDENDS (countdown
-- to the next weekly payout and recent payouts). Prices arrive as attributes on
-- ReplicatedStorage.StockMarket every tick; orders go to StockMarketService, which only accepts
-- them while you sit at your own computer.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RetroUI = require(script.Parent.RetroUI)
local DayNight = require(ReplicatedStorage.Shared.DayNight)
local Stocks = require(ReplicatedStorage.Shared.Stocks)

local StockApp = {}
StockApp.TITLE = "HARBOUR EXCHANGE"

local C = RetroUI.Colors
local px = UDim2.fromOffset
local LEFT, RIGHT, CENTER = Enum.TextXAlignment.Left, Enum.TextXAlignment.Right, Enum.TextXAlignment.Center

local UP, DOWN, FLAT = "▲", "▼", "="

local function arrow(delta: number): string
	return if delta > 1e-6 then UP elseif delta < -1e-6 then DOWN else FLAT
end

local function percent(delta: number, base: number): string
	local value = if base > 0 then delta / base * 100 else 0
	return string.format("%s%.2f%%", arrow(delta), math.abs(value))
end

local function signedMoney(amount: number): string
	return (if amount > 0.5 then "+" else "") .. Stocks.money(amount)
end

-- In-game duration ("2D 05H 12M") for `seconds` real seconds.
local function gameDuration(seconds: number): string
	local ingame = math.max(0, math.floor(seconds * Stocks.GAME_SPEED))
	local days = math.floor(ingame / 86400)
	local hours = math.floor(ingame % 86400 / 3600)
	local minutes = math.floor(ingame % 3600 / 60)
	return string.format("%dD %02dH %02dM", days, hours, minutes)
end

local function realDuration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local hours = math.floor(seconds / 3600)
	local minutes = math.floor(seconds % 3600 / 60)
	if hours > 0 then
		return string.format("%dh %02dm", hours, minutes)
	end
	return string.format("%dm %02ds", minutes, seconds % 60)
end

export type App = { destroy: () -> () }

function StockApp.mount(content: Frame, onStatus: (string) -> ()): App
	local player = Players.LocalPlayer
	local connections: { RBXScriptConnection } = {}
	local alive = true
	local function connect(signal: RBXScriptSignal, handler: (...any) -> ())
		table.insert(connections, signal:Connect(handler))
	end
	local app = {}
	function app.destroy()
		alive = false
		for _, connection in connections do
			connection:Disconnect()
		end
		table.clear(connections)
	end

	local market = ReplicatedStorage:WaitForChild("StockMarket", 10)
	local request = market and market:WaitForChild("Request", 10)
	if not alive then
		return app
	end
	if not market or not request or not request:IsA("RemoteFunction") then
		RetroUI.text(
			content,
			"Offline",
			"THE EXCHANGE IS OFFLINE.\nTRY AGAIN IN A MOMENT.",
			px(0, 0),
			UDim2.fromScale(1, 1),
			{
				AlignX = CENTER,
				Wrap = true,
				Size = 22,
			}
		)
		return app
	end
	local remote = request :: RemoteFunction

	local state = {
		Cash = player:GetAttribute("Cash") or 0,
		Portfolio = Stocks.decode(nil),
		NextPayout = nil :: number?,
		Loaded = false,
	}
	local selected = Stocks.Companies[1].Ticker
	local rangeId = "Live"
	local page = "Market"
	local quantity = 1
	local pending = false
	local message, messageGood, messageUntil = "", true, 0

	local function price(ticker: string): number
		return market:GetAttribute("P_" .. ticker) or Stocks.byTicker[ticker].Base
	end
	local function open(ticker: string): number
		return market:GetAttribute("O_" .. ticker) or price(ticker)
	end
	local function owned(ticker: string): number
		local holding = state.Portfolio.Holdings[ticker]
		return if holding then holding.Shares else 0
	end
	local function prices(): { [string]: number }
		local result = {}
		for _, company in Stocks.Companies do
			result[company.Ticker] = price(company.Ticker)
		end
		return result
	end

	----------------------------------------------------------------------------------------------
	-- Tabs

	local pages: { [string]: Frame } = {}
	local tabs: { [string]: RetroUI.Button } = {}
	local render: { [string]: () -> () } = {}
	local function show(id: string)
		page = id
		for name, frame in pages do
			frame.Visible = name == id
			tabs[name]:setSelected(name == id)
		end
		render[id]()
	end
	for index, spec in
		{ { "Market", "MARKET", 140 }, { "Portfolio", "PORTFOLIO", 160 }, { "Dividends", "DIVIDENDS", 160 } }
	do
		local x = ({ 12, 160, 328 })[index]
		tabs[spec[1]] = RetroUI.button(content, spec[1] .. "Tab", spec[2], px(x, 8), px(spec[3], 30), function()
			show(spec[1])
		end, { Font = RetroUI.Fonts.Title, Size = 16 })
		pages[spec[1]] = RetroUI.frame(content, spec[1], px(0, 46), UDim2.new(1, 0, 0, 432), { Visible = false })
	end
	local cashLabel = RetroUI.text(content, "Cash", "", px(500, 8), px(256, 30), { AlignX = RIGHT, Size = 20 })
	local function paintCash()
		cashLabel.Text = "CASH " .. Stocks.money(state.Cash)
	end

	----------------------------------------------------------------------------------------------
	-- MARKET

	local marketPage = pages.Market
	local list = RetroUI.frame(marketPage, "List", px(12, 0), px(292, 432))
	RetroUI.border(list, C.Dim, 2)
	RetroUI.text(list, "HeadTicker", "TICKER", px(10, 0), px(90, 28), { Size = 16, Color = C.Mid })
	RetroUI.text(list, "HeadPrice", "PRICE", px(96, 0), px(100, 28), { Size = 16, Color = C.Mid, AlignX = RIGHT })
	RetroUI.text(list, "HeadDay", "DAY", px(196, 0), px(84, 28), { Size = 16, Color = C.Mid, AlignX = RIGHT })
	RetroUI.rule(list, "HeadRule", px(0, 28), UDim.new(1, 0))
	local scroller = Instance.new("ScrollingFrame")
	scroller.Name = "Rows"
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel = 0
	scroller.Position = px(0, 30)
	scroller.Size = UDim2.new(1, 0, 1, -30)
	scroller.CanvasSize = px(0, #Stocks.Companies * 34)
	scroller.ScrollBarThickness = 8
	scroller.ScrollBarImageColor3 = C.Mid
	scroller.ScrollingDirection = Enum.ScrollingDirection.Y
	scroller.Parent = list

	type Row = { Button: TextButton, Ticker: TextLabel, Price: TextLabel, Day: TextLabel, Hover: boolean }
	local rows: { [string]: Row } = {}
	local paintRows: () -> ()
	local selectStock: (string) -> ()
	for index, company in Stocks.Companies do
		local button = Instance.new("TextButton")
		button.Name = company.Ticker
		button.AutoButtonColor = false
		button.Text = ""
		button.BackgroundColor3 = C.Bright
		button.BackgroundTransparency = 1
		button.BorderSizePixel = 0
		button.Position = px(0, (index - 1) * 34)
		button.Size = UDim2.new(1, -10, 0, 34)
		button.Parent = scroller
		local row: Row = {
			Button = button,
			Ticker = RetroUI.text(button, "Ticker", company.Ticker, px(10, 0), px(90, 34), { Size = 20 }),
			Price = RetroUI.text(button, "Price", "", px(96, 0), px(100, 34), { Size = 20, AlignX = RIGHT }),
			Day = RetroUI.text(button, "Day", "", px(196, 0), px(84, 34), { Size = 18, AlignX = RIGHT }),
			Hover = false,
		}
		rows[company.Ticker] = row
		RetroUI.hover(button, function(hot)
			row.Hover = hot
			paintRows()
		end)
		-- Like any list, a row selects the moment the mouse goes down; taps select on release so
		-- dragging the list on a touchscreen doesn't pick rows.
		button.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 and selected ~= company.Ticker then
				selectStock(company.Ticker)
			end
		end)
		button.Activated:Connect(function(input)
			if input and input.UserInputType == Enum.UserInputType.MouseButton1 then
				return
			end
			selectStock(company.Ticker)
		end)
	end
	function paintRows()
		for ticker, row in rows do
			local isSelected = ticker == selected
			row.Button.BackgroundTransparency = if isSelected then 0 elseif row.Hover then 0.8 else 1
			local now, base = price(ticker), open(ticker)
			row.Price.Text = Stocks.price(now)
			row.Day.Text = percent(now - base, base)
			for _, label in { row.Ticker, row.Price, row.Day } do
				RetroUI.setColor(label, if isSelected then C.Screen else C.Bright)
				label.TextStrokeTransparency = if isSelected then 1 else 0.88
			end
			if not isSelected and owned(ticker) > 0 then
				RetroUI.setColor(row.Ticker, C.Hot)
			end
		end
	end

	local detail = RetroUI.frame(marketPage, "Detail", px(316, 0), px(440, 432))
	local nameLabel = RetroUI.text(detail, "Name", "", px(0, 0), px(440, 24), { Font = RetroUI.Fonts.Title, Size = 18 })
	local metaLabel = RetroUI.text(detail, "Meta", "", px(0, 26), px(440, 18), { Size = 16, Color = C.Mid })
	local aboutLabel = RetroUI.text(detail, "About", "", px(0, 44), px(440, 18), { Size = 16, Color = C.Mid })
	local priceLabel = RetroUI.text(detail, "Price", "", px(0, 66), px(196, 40), { Size = 36, Color = C.Hot })
	local changeLabel = RetroUI.text(detail, "Change", "", px(196, 66), px(244, 40), { Size = 18, AlignX = RIGHT })
	local rangeButtons: { [string]: RetroUI.Button } = {}
	local drawChart: () -> ()
	for index, id in Stocks.RANGE_ORDER do
		rangeButtons[id] = RetroUI.button(
			detail,
			id,
			Stocks.RANGES[id].Label,
			px((index - 1) * 78, 112),
			px(70, 26),
			function()
				rangeId = id
				for other, button in rangeButtons do
					button:setSelected(other == id)
				end
				drawChart()
			end,
			{ Size = 16 }
		)
	end
	rangeButtons.Live:setSelected(true)
	local rangeLabel =
		RetroUI.text(detail, "RangeInfo", "", px(236, 112), px(204, 26), { Size = 16, AlignX = RIGHT, Color = C.Mid })
	local chart = RetroUI.chart(detail, "Chart", px(0, 144), Vector2.new(440, 140))
	local statsLabel = RetroUI.text(detail, "Stats", "", px(0, 292), px(440, 18), { Size = 16, Color = C.Mid })

	local function setQuantity(value: number)
		quantity = math.clamp(math.floor(value), 1, Stocks.MAX_ORDER)
	end
	local qtyBox: TextBox
	local refreshTrade: () -> ()
	local minus = RetroUI.button(detail, "Minus", "-", px(0, 316), px(36, 36), function()
		setQuantity(quantity - 1)
		refreshTrade()
	end, { Size = 24 })
	qtyBox = RetroUI.input(detail, "Quantity", px(42, 316), px(90, 36), "1")
	local plus = RetroUI.button(detail, "Plus", "+", px(138, 316), px(36, 36), function()
		setQuantity(quantity + 1)
		refreshTrade()
	end, { Size = 24 })
	local maxButton = RetroUI.button(detail, "Max", "MAX", px(180, 316), px(56, 36), function()
		setQuantity(math.max(1, Stocks.affordable(price(selected), state.Cash)))
		refreshTrade()
	end, { Size = 16 })
	local allButton = RetroUI.button(detail, "All", "ALL", px(242, 316), px(56, 36), function()
		setQuantity(math.max(1, owned(selected)))
		refreshTrade()
	end, { Size = 16 })
	local costLabel = RetroUI.text(detail, "Cost", "", px(306, 316), px(134, 36), {
		Size = 16,
		AlignX = RIGHT,
		Color = C.Mid,
		Wrap = true,
	})
	local place: (string) -> ()
	local buyButton = RetroUI.button(detail, "Buy", "BUY", px(0, 362), px(210, 40), function()
		place("Buy")
	end, { Font = RetroUI.Fonts.Title, Size = 18 })
	local sellButton = RetroUI.button(detail, "Sell", "SELL", px(230, 362), px(210, 40), function()
		place("Sell")
	end, { Font = RetroUI.Fonts.Title, Size = 18 })
	local messageLabel = RetroUI.text(detail, "Message", "", px(0, 410), px(440, 20), { Size = 16 })
	local _ = minus, plus, maxButton

	connect(qtyBox.FocusLost, function()
		local value = tonumber((qtyBox.Text:gsub("[^%d]", "")))
		setQuantity(value or quantity)
		refreshTrade()
	end)
	connect(qtyBox:GetPropertyChangedSignal("Text"), function()
		local digits = qtyBox.Text:gsub("[^%d]", ""):sub(1, 5)
		if digits ~= qtyBox.Text then
			qtyBox.Text = digits
		end
	end)

	function refreshTrade()
		if not qtyBox:IsFocused() then
			qtyBox.Text = tostring(quantity)
		end
		local now = price(selected)
		local cost, fee = Stocks.buyCost(now, quantity)
		local proceeds = Stocks.sellProceeds(now, quantity)
		costLabel.Text = string.format("BUY %s\nSELL %s", Stocks.money(cost), Stocks.money(proceeds))
		local have = owned(selected)
		buyButton:setEnabled(not pending and cost <= state.Cash and state.Loaded)
		sellButton:setEnabled(not pending and have >= quantity and state.Loaded)
		allButton:setEnabled(have > 0)
		buyButton:setText(if pending then "..." else "BUY")
		sellButton:setText(if pending then "..." else "SELL")
		-- Explain a disabled button unless a fresh order result is showing.
		if os.clock() < messageUntil then
			messageLabel.Text = message
			RetroUI.setColor(messageLabel, if messageGood then C.Hot else C.Bright)
		elseif not state.Loaded then
			messageLabel.Text = "CONNECTING TO THE EXCHANGE..."
			RetroUI.setColor(messageLabel, C.Mid)
		elseif cost > state.Cash then
			messageLabel.Text = string.format("YOU NEED %s MORE TO BUY %d.", Stocks.money(cost - state.Cash), quantity)
			RetroUI.setColor(messageLabel, C.Mid)
		else
			messageLabel.Text =
				string.format("INCLUDES A %s BROKER FEE (%.2f%%).", Stocks.money(fee), Stocks.FEE_RATE * 100)
			RetroUI.setColor(messageLabel, C.Mid)
		end
	end

	-- Chart history, per ticker and range: points oldest first and the tick of the last one.
	local history: { [string]: { Tick: number, Points: { number } } } = {}
	local loading: { [string]: boolean } = {}
	local function load(ticker: string, id: string)
		local key = ticker .. "/" .. id
		if loading[key] then
			return
		end
		loading[key] = true
		task.spawn(function()
			local ok, result = pcall(remote.InvokeServer, remote, "History", ticker, id)
			loading[key] = nil
			if not alive then
				return
			end
			if ok and type(result) == "table" and result.Ok and type(result.Points) == "table" then
				history[key] = { Tick = result.Tick, Points = result.Points }
				if ticker == selected and id == rangeId then
					drawChart()
				end
			else
				task.delay(1, function()
					if alive and ticker == selected and id == rangeId and not history[key] then
						load(ticker, id)
					end
				end)
			end
		end)
	end

	function drawChart()
		local entry = history[selected .. "/" .. rangeId]
		if not entry then
			chart:set({})
			rangeLabel.Text = ""
			load(selected, rangeId)
			return
		end
		local low, high = chart:set(entry.Points)
		local first, last = entry.Points[1], entry.Points[#entry.Points]
		if low and high then
			rangeLabel.Text =
				string.format("%s  H %s L %s", percent(last - first, first), Stocks.price(high), Stocks.price(low))
		end
	end

	local function paintDetail()
		local company = Stocks.byTicker[selected]
		local now, base = price(selected), open(selected)
		nameLabel.Text = string.upper(company.Name)
		metaLabel.Text = string.format("%s: %s  ·  %s", company.Exchange, company.Ticker, company.Sector)
		aboutLabel.Text = company.About
		priceLabel.Text = Stocks.price(now)
		changeLabel.Text = string.format("%+.2f (%s) TODAY", now - base, percent(now - base, base))
		local have = owned(selected)
		statsLabel.Text = string.format(
			"DIVIDEND %.2f%%/WK  ·  YOU OWN %d (%s)",
			company.Yield * 100,
			have,
			Stocks.money(have * now)
		)
	end

	function selectStock(ticker: string)
		selected = ticker
		paintRows()
		paintDetail()
		drawChart()
		refreshTrade()
	end

	render.Market = function()
		paintRows()
		paintDetail()
		drawChart()
		refreshTrade()
	end

	----------------------------------------------------------------------------------------------
	-- PORTFOLIO

	local portfolioPage = pages.Portfolio
	local summary: { [string]: TextLabel } = {}
	for index, spec in
		{
			{ "Value", "PORTFOLIO VALUE" },
			{ "Cash", "CASH" },
			{ "Profit", "PROFIT / LOSS" },
			{ "Weekly", "DIVIDEND / WEEK" },
		}
	do
		local box = RetroUI.frame(portfolioPage, spec[1], px(12 + (index - 1) * 189, 0), px(177, 70))
		RetroUI.border(box, C.Dim, 2)
		RetroUI.text(box, "Label", spec[2], px(10, 6), px(160, 18), { Size = 14, Color = C.Mid })
		summary[spec[1]] = RetroUI.text(box, "Value", "", px(10, 28), px(160, 34), { Size = 24, Color = C.Hot })
	end
	local heads = {
		{ "TICKER", 10, 90, LEFT },
		{ "SHARES", 100, 90, RIGHT },
		{ "PRICE", 200, 110, RIGHT },
		{ "VALUE", 320, 130, RIGHT },
		{ "PROFIT", 460, 150, RIGHT },
		{ "DIV/WK", 620, 112, RIGHT },
	}
	local tableFrame = RetroUI.frame(portfolioPage, "Holdings", px(12, 82), px(744, 350))
	RetroUI.border(tableFrame, C.Dim, 2)
	for _, head in heads do
		RetroUI.text(tableFrame, "Head", head[1], px(head[2], 0), px(head[3], 28), {
			Size = 16,
			Color = C.Mid,
			AlignX = head[4],
		})
	end
	RetroUI.rule(tableFrame, "HeadRule", px(0, 28), UDim.new(1, 0))
	local holdingsList = Instance.new("ScrollingFrame")
	holdingsList.Name = "Rows"
	holdingsList.BackgroundTransparency = 1
	holdingsList.BorderSizePixel = 0
	holdingsList.Position = px(0, 30)
	holdingsList.Size = UDim2.new(1, 0, 1, -30)
	holdingsList.ScrollBarThickness = 8
	holdingsList.ScrollBarImageColor3 = C.Mid
	holdingsList.Parent = tableFrame
	local emptyNote = RetroUI.text(
		tableFrame,
		"Empty",
		"YOU DON'T OWN ANY SHARES YET.\nPICK A COMPANY ON THE MARKET PAGE AND PRESS BUY.",
		px(20, 60),
		px(704, 80),
		{ AlignX = CENTER, Wrap = true, Size = 18, Color = C.Mid }
	)
	local openMarket = RetroUI.button(tableFrame, "OpenMarket", "OPEN MARKET", px(272, 160), px(200, 40), function()
		show("Market")
	end, { Font = RetroUI.Fonts.Title, Size = 16 })

	render.Portfolio = function()
		local now = prices()
		local value, cost, weekly = 0, 0, Stocks.estimate(state.Portfolio, now)
		local tickers = {}
		for ticker, holding in state.Portfolio.Holdings do
			table.insert(tickers, ticker)
			value += holding.Shares * now[ticker]
			cost += holding.Cost
		end
		table.sort(tickers, function(a, b)
			return Stocks.byTicker[a].Index < Stocks.byTicker[b].Index
		end)
		summary.Value.Text = Stocks.money(value)
		summary.Cash.Text = Stocks.money(state.Cash)
		local profit = value - cost
		summary.Profit.Text = (if profit < -0.5 then DOWN elseif profit > 0.5 then UP else "") .. signedMoney(profit)
		summary.Weekly.Text = Stocks.money(weekly)

		for _, child in holdingsList:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		emptyNote.Visible = #tickers == 0
		openMarket.Instance.Visible = #tickers == 0
		holdingsList.CanvasSize = px(0, #tickers * 34)
		for index, ticker in tickers do
			local holding = state.Portfolio.Holdings[ticker]
			local worth = holding.Shares * now[ticker]
			local gain = worth - holding.Cost
			local row = Instance.new("TextButton")
			row.Name = ticker
			row.AutoButtonColor = false
			row.Text = ""
			row.BackgroundColor3 = C.Bright
			row.BackgroundTransparency = 1
			row.BorderSizePixel = 0
			row.Position = px(0, (index - 1) * 34)
			row.Size = UDim2.new(1, -10, 0, 34)
			row.Parent = holdingsList
			local cells = {
				ticker,
				tostring(holding.Shares),
				Stocks.price(now[ticker]),
				Stocks.money(worth),
				string.format("%s %s", signedMoney(gain), percent(gain, holding.Cost)),
				Stocks.money(holding.Shares * now[ticker] * Stocks.byTicker[ticker].Yield),
			}
			for column, head in heads do
				RetroUI.text(row, head[1], cells[column], px(head[2], 0), px(head[3], 34), {
					Size = if column == 5 then 16 else 20,
					AlignX = head[4],
				})
			end
			RetroUI.hover(row, function(hot)
				row.BackgroundTransparency = if hot then 0.8 else 1
			end)
			row.Activated:Connect(function()
				show("Market")
				selectStock(ticker)
			end)
		end
	end

	----------------------------------------------------------------------------------------------
	-- DIVIDENDS

	local dividendsPage = pages.Dividends
	local nextBox = RetroUI.frame(dividendsPage, "Next", px(12, 0), px(744, 118))
	RetroUI.border(nextBox, C.Bright, 2)
	RetroUI.text(nextBox, "Label", "NEXT PAYOUT IN", px(16, 10), px(400, 20), { Size = 16, Color = C.Mid })
	local countdown = RetroUI.text(nextBox, "Countdown", "", px(16, 34), px(400, 44), {
		Font = RetroUI.Fonts.Title,
		Size = 30,
		Color = C.Hot,
	})
	local realLabel = RetroUI.text(nextBox, "Real", "", px(16, 84), px(440, 20), { Size = 16, Color = C.Mid })
	RetroUI.text(nextBox, "EstimateLabel", "ESTIMATED PAYOUT", px(428, 10), px(300, 20), {
		Size = 16,
		Color = C.Mid,
		AlignX = RIGHT,
	})
	local estimate = RetroUI.text(nextBox, "Estimate", "", px(428, 34), px(300, 44), {
		Font = RetroUI.Fonts.Title,
		Size = 26,
		Color = C.Hot,
		AlignX = RIGHT,
	})
	local lifetime = RetroUI.text(nextBox, "Lifetime", "", px(428, 84), px(300, 20), {
		Size = 16,
		Color = C.Mid,
		AlignX = RIGHT,
	})
	RetroUI.text(
		dividendsPage,
		"Rules",
		string.format(
			"EVERY %d IN-GAME DAYS EACH COMPANY PAYS ITS WEEKLY DIVIDEND ON THE SHARES YOU HOLD AT THAT MOMENT. AWAY FROM THE HARBOUR? UP TO %d MISSED PAYOUTS ARE PAID WHEN YOU RETURN.",
			Stocks.WEEK_DAYS,
			Stocks.MAX_BACKPAY
		),
		px(12, 130),
		px(744, 66),
		{ Size = 16, Wrap = true, Color = C.Mid, AlignY = Enum.TextYAlignment.Top }
	)
	local paidFrame = RetroUI.frame(dividendsPage, "Paid", px(12, 206), px(744, 226))
	RetroUI.border(paidFrame, C.Dim, 2)
	RetroUI.text(paidFrame, "Head", "RECENT PAYOUTS", px(10, 0), px(300, 28), { Size = 16, Color = C.Mid })
	RetroUI.rule(paidFrame, "HeadRule", px(0, 28), UDim.new(1, 0))
	local paidRows = RetroUI.frame(paidFrame, "Rows", px(0, 30), UDim2.new(1, 0, 1, -30))

	local function paintCountdown()
		if page ~= "Dividends" then
			return
		end
		local elapsed = DayNight.elapsed()
		local nextAt = Stocks.weekStart(Stocks.weekAt(elapsed) + 1)
		countdown.Text = gameDuration(nextAt - elapsed)
		realLabel.Text = "ABOUT " .. string.upper(realDuration(nextAt - elapsed)) .. " OF REAL TIME"
	end

	render.Dividends = function()
		paintCountdown()
		estimate.Text = Stocks.money(Stocks.estimate(state.Portfolio, prices()))
		lifetime.Text = "LIFETIME " .. Stocks.money(state.Portfolio.Paid)
		for _, child in paidRows:GetChildren() do
			child:Destroy()
		end
		if #state.Portfolio.History == 0 then
			RetroUI.text(paidRows, "Empty", "NO PAYOUTS YET. BUY SHARES AND WAIT FOR PAYDAY.", px(10, 8), px(720, 28), {
				Size = 18,
				Color = C.Mid,
			})
		end
		local currentWeek = Stocks.weekAt(DayNight.elapsed())
		for index, entry in state.Portfolio.History do
			local ago = currentWeek - entry.Week
			local when = if ago <= 0
				then "THIS WEEK"
				elseif ago == 1 then "LAST WEEK"
				else string.format("%d WEEKS AGO", ago)
			local y = (index - 1) * 24 + 4
			if y + 24 <= 196 then
				RetroUI.text(paidRows, "When", when, px(10, y), px(300, 24), { Size = 18 })
				RetroUI.text(paidRows, "Amount", "+" .. Stocks.money(entry.Amount), px(434, y), px(300, 24), {
					Size = 18,
					AlignX = RIGHT,
					Color = C.Hot,
				})
			end
		end
	end

	----------------------------------------------------------------------------------------------
	-- Orders and refreshes

	local function applyState(view: any)
		if type(view) ~= "table" then
			return
		end
		state.Portfolio = Stocks.decode(view.Portfolio)
		if type(view.Cash) == "number" then
			state.Cash = view.Cash
		end
		state.NextPayout = view.NextPayout
		state.Loaded = true
		paintCash()
		render[page]()
	end

	local function refresh()
		task.spawn(function()
			local ok, result = pcall(remote.InvokeServer, remote, "Snapshot")
			if alive and ok and type(result) == "table" and result.Ok then
				applyState(result.State)
			end
		end)
	end

	function place(side: string)
		if pending or not state.Loaded then
			return
		end
		pending = true
		refreshTrade()
		local ticker, amount = selected, quantity
		onStatus(string.format("SENDING %s ORDER: %d %s...", string.upper(side), amount, ticker))
		task.spawn(function()
			local ok, result = pcall(remote.InvokeServer, remote, side, ticker, amount)
			pending = false
			if not alive then
				return
			end
			if ok and type(result) == "table" then
				message = string.upper(tostring(result.Message or ""))
				messageGood = result.Ok == true
				if not messageGood then
					message = "! " .. message
				end
				applyState(result.State)
			else
				message, messageGood = "! THE EXCHANGE DIDN'T ANSWER. TRY AGAIN.", false
			end
			messageUntil = os.clock() + 6
			onStatus(message)
			refreshTrade()
			task.delay(6.1, function()
				if alive then
					refreshTrade()
				end
			end)
		end)
	end

	connect(player:GetAttributeChangedSignal("Cash"), function()
		state.Cash = player:GetAttribute("Cash") or state.Cash
		paintCash()
		if page == "Market" then
			refreshTrade()
		else
			render[page]()
		end
	end)

	connect(market:GetAttributeChangedSignal("Tick"), function()
		local tick = market:GetAttribute("Tick")
		if type(tick) ~= "number" then
			return
		end
		-- Extend cached charts with the new price, or drop them when they fell behind.
		for key, entry in history do
			local ticker, id = string.match(key, "^(.-)/(.+)$")
			local range = Stocks.RANGES[id]
			if ticker and range then
				if id == "Live" and tick == entry.Tick + 1 then
					table.remove(entry.Points, 1)
					table.insert(entry.Points, price(ticker))
					entry.Tick = tick
				elseif id ~= "Live" and tick - entry.Tick < range.Step then
					entry.Points[#entry.Points] = price(ticker)
				elseif tick ~= entry.Tick then
					history[key] = nil
				end
			end
		end
		if page == "Market" then
			paintRows()
			paintDetail()
			drawChart()
			refreshTrade()
		else
			render[page]()
		end
	end)

	connect(market:GetAttributeChangedSignal("Week"), refresh)

	task.spawn(function()
		local sinceRefresh = 0
		while alive do
			task.wait(1)
			sinceRefresh += 1
			paintCountdown()
			if sinceRefresh >= 15 then
				sinceRefresh = 0
				refresh()
			end
		end
	end)

	paintCash()
	show("Market")
	refresh()
	return app
end

return StockApp
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="362">
          <Properties>
            <string name="Name">StreamOutLog</string>
            <string name="Source"><![CDATA[-- Temporary diagnostic: names what the client streams out when a frame hitches.
--
-- The MicroProfiler shows the hitches as Replicator GC Job / Part/Model Removals, which is the
-- engine evicting streamed parts (StreamOutBehavior LowMemory drops everything past
-- StreamingMinRadius once memory runs short). It doesn't say which parts, so this counts parts
-- leaving the workspace per second, grouped by where they sat, and prints a report whenever a
-- burst goes past REPORT_AT. Parts under a pinned LodPiece are flagged, since those should never
-- leave. Server Destroy calls land here too; those are usually close to the player, which is
-- what the "beyond min radius" count is for.
--
-- Remove this module (and its entry in init.client.luau) once the culprit is known.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")

local StreamOutLog = {}

local WINDOW = 1 -- seconds per report window
local REPORT_AT = 100 -- parts removed in one window before it's worth printing
local TOP = 10 -- groups listed per report
local DEPTH = 3 -- path levels below workspace a group is named by
local MIN_RADIUS = 128 -- StreamingMinRadius in default.project.json; streaming never evicts closer
local PIECE_TAG = "LodPiece"

-- Parent -> group name, so a burst of thousands of parts costs one walk per container
local groups: { [Instance]: string } = setmetatable({}, { __mode = "k" }) :: any

local function groupOf(parent: Instance): string
	local cached = groups[parent]
	if cached then
		return cached
	end
	local chain = {}
	local pinned = false
	local node: Instance? = parent
	while node and node ~= workspace do
		if not pinned and node:HasTag(PIECE_TAG) then
			pinned = true
		end
		table.insert(chain, node.Name)
		node = node.Parent
	end
	local names = {}
	for i = #chain, math.max(1, #chain - DEPTH + 1), -1 do
		table.insert(names, chain[i])
	end
	local name = if #names > 0 then table.concat(names, "/") else "(workspace)"
	if pinned then
		name = "[PINNED] " .. name
	end
	groups[parent] = name
	return name
end

function StreamOutLog.start()
	local player = Players.LocalPlayer
	local removed: { [string]: number } = {}
	local total, far, arrived = 0, 0, 0
	local worst = 0
	local windowStart = os.clock()

	local function focus(): Vector3?
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			return root.Position
		end
		local camera = workspace.CurrentCamera
		return camera and camera.CFrame.Position
	end
	local centre = focus()

	workspace.DescendantRemoving:Connect(function(d)
		if not d:IsA("BasePart") then
			return
		end
		local parent = d.Parent
		if not parent or (player.Character and d:IsDescendantOf(player.Character)) then
			return
		end
		total += 1
		if centre and (d.Position - centre).Magnitude > MIN_RADIUS then
			far += 1
		end
		local name = groupOf(parent)
		removed[name] = (removed[name] or 0) + 1
	end)

	workspace.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			arrived += 1
		end
	end)

	RunService.Heartbeat:Connect(function(dt)
		if dt > worst then
			worst = dt
		end
		local now = os.clock()
		if now - windowStart < WINDOW then
			return
		end
		if total >= REPORT_AT then
			local sorted = {}
			for name, count in removed do
				table.insert(sorted, { name = name, count = count })
			end
			table.sort(sorted, function(a, b)
				return a.count > b.count
			end)
			local lines = {
				string.format(
					"[StreamOut] %d parts left in %.1fs (%d beyond %d studs), %d arrived, worst frame %d ms, memory %d MB",
					total,
					now - windowStart,
					far,
					MIN_RADIUS,
					arrived,
					math.round(worst * 1000),
					math.round(Stats:GetTotalMemoryUsageMb())
				),
			}
			for i = 1, math.min(TOP, #sorted) do
				table.insert(lines, string.format("  %6d  %s", sorted[i].count, sorted[i].name))
			end
			if #sorted > TOP then
				table.insert(lines, string.format("  ...and %d more groups", #sorted - TOP))
			end
			warn(table.concat(lines, "\n"))
		end
		table.clear(removed)
		total, far, arrived, worst = 0, 0, 0, 0
		windowStart = now
		centre = focus()
	end)
end

return StreamOutLog
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="363">
          <Properties>
            <string name="Name">StructureEditor</string>
            <string name="Source"><![CDATA[-- Structural tools share BuildMode's camera and pointer handling. The client only
-- draws previews; BuildingService prices, validates and saves every operation.
--
-- Layout (in the spirit of Restaurant Tycoon 3): one dock along the bottom with the
-- editing tools on its left and the category tabs + catalogue on its right, a slim
-- status bar top-left, and the actions for whatever is selected floating next to it.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Catalog = require(ReplicatedStorage.Shared.BuildingCatalog)
local Renderer = require(ReplicatedStorage.Shared.BuildingRenderer)
local PaintQueue = require(script.Parent.BuildPaintQueue)
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))

local StructureEditor = {}
local CATEGORIES = { "Wall", "Room", "Door", "Window", "Floor", "Roof" }
-- One tab row: what you place. Furniture's catalogue is filled in by BuildMode.
local TABS = { "Furniture", "Wall", "Room", "Floor", "Door", "Window", "Roof", "Paint" }
local TAB_NAMES = {
	Furniture = "Furniture", Wall = "Walls", Room = "Rooms", Door = "Doors", Window = "Windows",
	Floor = "Floors", Roof = "Roofs", Paint = "Paint",
}
local MENU = {
	Paper = Color3.fromRGB(18, 18, 20), Button = Color3.fromRGB(35, 36, 39), White = Color3.fromRGB(248, 248, 248),
	Blue = Color3.fromRGB(47, 153, 225), BlueBorder = Color3.fromRGB(30, 121, 187),
	Ink = Color3.fromRGB(233, 234, 237), Border = Color3.fromRGB(73, 75, 81),
	Muted = Color3.fromRGB(146, 149, 157), Red = Color3.fromRGB(229, 88, 88),
}
StructureEditor.Colors = MENU
StructureEditor.DOCK_HEIGHT = 156
StructureEditor.DOCK_MARGIN = 12

local function make(class: string, parent: Instance, properties): any
	local item = Instance.new(class)
	for key, value in properties do item[key] = value end
	item.Parent = parent
	return item
end

local function border(item)
	local stroke = item:FindFirstChild("MenuBorder")
	if not stroke then
		stroke = make("UIStroke", item, { Name = "MenuBorder", Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
	end
	return stroke
end

function StructureEditor.styleLabel(item, color)
	Theme.text(item, color or MENU.Ink)
	item.TextStrokeTransparency = 1
end

function StructureEditor.stylePanel(item)
	item.BackgroundColor3, item.BackgroundTransparency, item.BorderSizePixel = MENU.Paper, 0, 0
	Theme.corner(item, 6)
	border(item).Color = MENU.Border
end

function StructureEditor.styleButton(item, state)
	local chosen, disabled = state == "Selected", state == "Disabled"
	item.BackgroundColor3 = if chosen then MENU.Blue else MENU.Button
	item.BackgroundTransparency, item.BorderSizePixel = 0, 0
	item.TextColor3 = if chosen then MENU.White elseif disabled then MENU.Muted else MENU.Ink
	item.TextStrokeTransparency, item.Font = 1, Enum.Font.GothamBold
	Theme.corner(item, 4)
	border(item).Color = if chosen then MENU.BlueBorder else MENU.Border
	local caption = item:FindFirstChild("CategoryCaption")
	if caption then caption.TextColor3 = item.TextColor3 end
	for _, child in item:GetChildren() do
		if child:IsA("TextLabel") then child.TextColor3 = item.TextColor3 end
	end
	local icon = item:FindFirstChild("CategoryIcon")
	if icon then
		for _, piece in icon:GetDescendants() do
			if piece:IsA("Frame") then piece.BackgroundColor3 = item.TextColor3 end
		end
	end
end

-- Small 18x18 glyphs drawn from frames, recoloured by styleButton.
function StructureEditor.icon(parent, kind, position)
	local icon = make("Frame", parent, {
		Name = "CategoryIcon", BackgroundTransparency = 1, Position = position or UDim2.fromOffset(9, 6),
		Size = UDim2.fromOffset(18, 18),
	})
	local function block(x, y, width, height, rotation)
		make("Frame", icon, { BackgroundColor3 = MENU.Ink, BorderSizePixel = 0,
			Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(width, height), Rotation = rotation or 0 })
	end
	if kind == "Wall" then
		for row = 0, 2 do
			block(0, row * 6, if row == 1 then 5 else 8, 4)
			block(if row == 1 then 7 else 10, row * 6, if row == 1 then 11 else 8, 4)
		end
	elseif kind == "Door" then
		block(3, 0, 12, 2); block(3, 0, 2, 18); block(13, 0, 2, 18); block(7, 3, 4, 15)
	elseif kind == "Window" then
		block(0, 0, 18, 2); block(0, 16, 18, 2); block(0, 0, 2, 18); block(16, 0, 2, 18)
		block(8, 0, 2, 18); block(0, 8, 18, 2)
	elseif kind == "Roof" then
		block(0, 6, 11, 3, -35); block(8, 6, 11, 3, 35); block(4, 11, 10, 7)
	elseif kind == "Floor" then
		for row = 0, 2 do for column = 0, 2 do block(column * 6, row * 6, 5, 5) end end
	elseif kind == "Furniture" then -- a chair
		block(3, 0, 3, 18); block(3, 9, 12, 3); block(12, 9, 3, 9)
	elseif kind == "Paint" then -- a roller
		block(1, 1, 14, 5); block(15, 3, 2, 7); block(8, 8, 9, 2); block(8, 8, 2, 10)
	elseif kind == "Select" then -- a selection marquee
		block(0, 0, 6, 2); block(0, 0, 2, 6); block(12, 0, 6, 2); block(16, 0, 2, 6)
		block(0, 16, 6, 2); block(0, 12, 2, 6); block(12, 16, 6, 2); block(16, 12, 2, 6); block(7, 7, 4, 4)
	elseif kind == "Remove" then -- a bin
		block(2, 3, 14, 2); block(6, 0, 6, 2); block(4, 6, 2, 12); block(8, 6, 2, 12); block(12, 6, 2, 12); block(4, 16, 10, 2)
	elseif kind == "Undo" then
		block(3, 7, 14, 3); block(1.5, 4, 7, 3, -45); block(1.5, 10, 7, 3, 45)
	elseif kind == "Redo" then
		block(1, 7, 14, 3); block(9.5, 4, 7, 3, 45); block(9.5, 10, 7, 3, -45)
	else -- Room
		block(0, 0, 18, 3); block(0, 15, 18, 3); block(0, 0, 3, 18); block(15, 0, 3, 18)
	end
	return icon
end

local function copy(entry)
	local result = table.clone(entry)
	if type(entry.Color) == "table" then result.Color = table.clone(entry.Color) end
	return result
end
local function deep(value)
	if type(value) ~= "table" then return value end
	local result = {}
	for key, child in value do result[key] = deep(child) end
	return result
end

function StructureEditor.new(options)
	local self = {}
	local opened, enabled, pending = false, false, false
	local house, frame, site = nil, CFrame.identity, nil
	local state = nil
	local builtins = {}
	local entriesById = {}
	local tool, material = "Select", "Plaster"
	local section, lastBuildTool = "Furniture", "Wall"
	local color = { 178, 150, 117 }
	local styles = { Wall = "Solid", Floor = "Tile", Roof = "Gable", Window = "Classic", Door = "Open" }
	local rotation = 0
	local level, gridSize = 0, Catalog.GRID
	local selected, moving, reshaping = nil, nil, nil
	local selectedInstance = nil
	local anchor, candidate, invalidReason = nil, nil, nil
	local roomEntries = nil
	local preview, previewKey, highlight = nil, nil, nil
	local highlightedId = nil
	local hiddenHost = {}
	local previewFolder = make("Folder", workspace, { Name = "StructureEditorPreview" })
	local targets, targetRefresh = {}, 0
	local hovered, hoveredInstance, hoverPoint = nil, nil, nil
	local blocked = false
	local showRoofs = false
	local generation = 0
	local statusMessage = ""
	local furnitureHint = ""
	local remote, event
	local paintSession = nil
	local paintSessions = {}
	local accept

	local function label(parent, text, properties)
		local item = make("TextLabel", parent, {
			BackgroundTransparency = 1, Text = text, TextSize = 12, TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
		})
		StructureEditor.styleLabel(item)
		for key, value in properties do item[key] = value end
		return item
	end
	local function button(parent, text, properties)
		local item = make("TextButton", parent, {
			Text = text, TextSize = 12, BackgroundColor3 = MENU.Button, BorderSizePixel = 0,
			TextColor3 = MENU.Ink, TextStrokeTransparency = 1, Font = Enum.Font.GothamBold,
		})
		for key, value in properties do item[key] = value end
		StructureEditor.styleButton(item)
		return item
	end
	local function strip(parent, name, y, height)
		local row = make("ScrollingFrame", parent, {
			Name = name, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, height),
			BackgroundTransparency = 1, CanvasSize = UDim2.fromOffset(0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollingDirection = Enum.ScrollingDirection.X,
			Active = true, BorderSizePixel = 0,
		})
		Theme.scroll(row)
		row.ScrollBarThickness = 3
		row.ScrollBarImageColor3 = MENU.Muted
		make("UIListLayout", row, {
			FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Center,
		})
		return row
	end

	-- Bottom dock: tools | tabs + catalogue.
	local panel = make("Frame", options.Gui, {
		Name = "BuildDock", Active = true, AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -StructureEditor.DOCK_MARGIN),
		Size = UDim2.new(1, -24, 0, StructureEditor.DOCK_HEIGHT), Visible = false,
	})
	make("UISizeConstraint", panel, { MaxSize = Vector2.new(1040, StructureEditor.DOCK_HEIGHT) })
	StructureEditor.stylePanel(panel)
	local toolGrid = make("Frame", panel, {
		Name = "EditingTools", BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 8), Size = UDim2.fromOffset(94, 140),
	})
	make("UIGridLayout", toolGrid, {
		CellSize = UDim2.fromOffset(44, 44), CellPadding = UDim2.fromOffset(6, 4), SortOrder = Enum.SortOrder.LayoutOrder,
	})
	make("Frame", panel, {
		Name = "ToolDivider", BackgroundColor3 = MENU.Border, BorderSizePixel = 0,
		Position = UDim2.fromOffset(112, 10), Size = UDim2.new(0, 1, 1, -20),
	})
	local tabs = make("Frame", panel, {
		Name = "BuildSections", BackgroundTransparency = 1, Position = UDim2.fromOffset(122, 8), Size = UDim2.new(1, -132, 0, 34),
	})
	make("UIListLayout", tabs, {
		FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 5),
	})
	local body = make("Frame", panel, {
		Name = "DockBody", BackgroundTransparency = 1, Position = UDim2.fromOffset(122, 50),
		Size = UDim2.new(1, -132, 1, -58), ClipsDescendants = true,
	})
	self.dock, self.body = panel, body

	-- Top-left status bar: cash, floor and grid, and one line of guidance.
	local hud = make("Frame", options.Gui, {
		Name = "BuildHud", Active = true, Position = UDim2.fromOffset(12, 12), Size = UDim2.new(0.5, -24, 0, 62), Visible = false,
	})
	make("UISizeConstraint", hud, { MaxSize = Vector2.new(440, 62) })
	StructureEditor.stylePanel(hud)
	local cash = label(hud, "$—", {
		Name = "BuildCash", Position = UDim2.fromOffset(10, 6), Size = UDim2.fromOffset(104, 26), TextSize = 16,
		Font = Enum.Font.GothamBold, TextWrapped = false,
	})
	local levelBar = make("Frame", hud, {
		Name = "FloorControls", BackgroundTransparency = 1, Position = UDim2.fromOffset(116, 6), Size = UDim2.new(1, -124, 0, 26),
	})
	make("UIListLayout", levelBar, {
		FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4),
		VerticalAlignment = Enum.VerticalAlignment.Center,
	})
	local downButton = button(levelBar, "−", { Name = "FloorDown", LayoutOrder = 1, Size = UDim2.fromOffset(26, 26), TextSize = 16 })
	local levelLabel = label(levelBar, "Floor 1", {
		Name = "FloorLevel", LayoutOrder = 2, Size = UDim2.fromOffset(54, 26), TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false,
	})
	local upButton = button(levelBar, "+", { Name = "FloorUp", LayoutOrder = 3, Size = UDim2.fromOffset(26, 26), TextSize = 16 })
	local gridButton = button(levelBar, "Grid 4.5 [G]", { Name = "GridSize", LayoutOrder = 4, Size = UDim2.fromOffset(98, 26), TextSize = 11 })
	local status = label(hud, "", {
		Name = "BuildStatus", Position = UDim2.fromOffset(10, 36), Size = UDim2.new(1, -20, 0, 20),
		TextSize = 11, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, TextColor3 = MENU.Muted,
	})
	self.hud = hud

	-- Floating actions for the selected piece, or the piece being placed.
	local actionBar = make("Frame", options.Gui, {
		Name = "ConstructionActions", Active = true, AnchorPoint = Vector2.new(0.5, 1),
		AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 40), Visible = false,
	})
	StructureEditor.stylePanel(actionBar)
	make("UIPadding", actionBar, {
		PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 5), PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5),
	})
	make("UIListLayout", actionBar, {
		FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 5),
		VerticalAlignment = Enum.VerticalAlignment.Center,
	})
	local actionTitle = label(actionBar, "", {
		Name = "SelectionName", LayoutOrder = 0, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 30),
		TextSize = 12, TextWrapped = false,
	})

	local tooltip = label(options.Gui, "", {
		Name = "ConstructionPreviewCost", Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(280, 52),
		Visible = false, BackgroundTransparency = 0.06, BackgroundColor3 = MENU.Paper,
		TextXAlignment = Enum.TextXAlignment.Center, TextSize = 13, ZIndex = 12,
	})
	Theme.corner(tooltip, 6)
	border(tooltip).Color = MENU.Border

	local toolButtons, tabButtons, materialButtons, colorButtons = {}, {}, {}, {}
	local variantCards = {}
	local function toolButton(name, caption, order)
		local item = button(toolGrid, "", { Name = "Tool" .. name, LayoutOrder = order })
		StructureEditor.icon(item, name, UDim2.new(0.5, -9, 0, 6))
		label(item, caption, {
			Name = "CategoryCaption", Position = UDim2.new(0, 0, 1, -17), Size = UDim2.new(1, 0, 0, 14),
			TextSize = 10, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false,
		})
		return item
	end
	toolButtons.Select = toolButton("Select", "Select", 1)
	toolButtons.Paint = toolButton("Paint", "Paint", 2)
	toolButtons.Remove = toolButton("Remove", "Delete", 3)
	local undoButton = toolButton("Undo", "Undo", 4)
	undoButton.Name = "UndoBuilding"
	local redoButton = toolButton("Redo", "Redo", 5)
	redoButton.Name = "RedoBuilding"
	local roofsButton = toolButton("Roof", "Roof", 6)
	roofsButton.Name = "ToggleRoof"

	for index, name in TABS do
		local item = button(tabs, "", {
			Name = if name == "Furniture" then "FurnitureTab" elseif name == "Paint" then "DecorateTab" else "Tab" .. name,
			LayoutOrder = index, Size = UDim2.new(1 / #TABS, -5, 1, 0),
		})
		StructureEditor.icon(item, name, UDim2.new(0, 7, 0.5, -9))
		local caption = label(item, TAB_NAMES[name], {
			Name = "CategoryCaption", Position = UDim2.fromOffset(29, 0), Size = UDim2.new(1, -32, 1, 0),
			TextScaled = true, TextWrapped = false,
		})
		make("UITextSizeConstraint", caption, { MaxTextSize = 13, MinTextSize = 7 })
		tabButtons[name] = item
	end

	-- Construction catalogue: tiles with a live thumbnail, name and price.
	local variantStrip = strip(body, "StructureCatalogue", 0, 98)
	for _, kind in CATEGORIES do
		variantCards[kind] = {}
		for index, variant in Catalog.Variants[if kind == "Room" then "Wall" else kind] or {} do
			local card = button(variantStrip, "", {
				Name = "Variant" .. kind .. variant.Id, LayoutOrder = index, Size = UDim2.fromOffset(124, 90), Visible = false,
			})
			local view = make("ViewportFrame", card, {
				Name = "CatalogueThumbnail", BackgroundTransparency = 1, Position = UDim2.fromOffset(4, 3),
				Size = UDim2.fromOffset(116, 56), Active = false,
			})
			label(card, if kind == "Room" then "Room" else variant.Name, {
				Position = UDim2.fromOffset(7, 60), Size = UDim2.new(1, -14, 0, 14), TextSize = 11,
				TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd,
			})
			label(card, string.format("$%d%s", if kind == "Room" then 54 else variant.Price or 0,
				if kind == "Wall" then " / 4.5" elseif kind == "Floor" or kind == "Roof" then " / tile" else ""), {
				Position = UDim2.fromOffset(7, 74), Size = UDim2.new(1, -14, 0, 13), TextSize = 10,
			})
			table.insert(variantCards[kind], { Button = card, View = view, Variant = variant, Started = false })
		end
	end

	-- Paint palette: materials, colours and the whole-house shortcut.
	local palette = make("Frame", body, { Name = "PaintPalette", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
	local materialStrip = strip(palette, "SurfaceMaterials", 0, 30)
	local colorStrip = strip(palette, "SurfaceColors", 34, 28)
	for index, name in Catalog.Materials do
		materialButtons[name] = button(materialStrip, name:gsub("(%l)(%u)", "%1 %2"), {
			Name = "Material" .. name, LayoutOrder = index, Size = UDim2.fromOffset(98, 26), TextSize = 11,
		})
	end
	for index, swatch in Catalog.Colors do
		local values = swatch.Color
		local item = make("TextButton", colorStrip, {
			Name = "Color" .. swatch.Name, Text = "", LayoutOrder = index,
			Size = UDim2.fromOffset(28, 23), BackgroundColor3 = Color3.fromRGB(values[1], values[2], values[3]),
			BorderSizePixel = 0, AutoButtonColor = true,
		})
		Theme.corner(item, 4)
		make("UIStroke", item, { Name = "SelectedColor", Color = Color3.new(1, 1, 1), Thickness = 2, Transparency = 0.75 })
		colorButtons[item] = swatch
	end
	local hex = make("TextBox", colorStrip, {
		Name = "CustomHexColor", LayoutOrder = 100, Size = UDim2.fromOffset(86, 23),
		Text = "#B29675", PlaceholderText = "#RRGGBB", ClearTextOnFocus = false,
		TextSize = 12, BackgroundColor3 = MENU.Button, BorderSizePixel = 0,
	})
	Theme.text(hex, MENU.Ink)
	hex.TextStrokeTransparency = 1
	Theme.corner(hex, 4)
	make("UIStroke", hex, { Color = MENU.Border, Thickness = 1 })
	local hexApply = button(colorStrip, "Set color", { LayoutOrder = 101, Size = UDim2.fromOffset(76, 23), TextSize = 11 })
	local paintAllButton = button(palette, "Paint all walls", {
		Name = "PaintAllWalls", Position = UDim2.fromOffset(0, 68), Size = UDim2.fromOffset(122, 26), TextSize = 11,
	})
	label(palette, "Click any wall, floor or roof to paint it with this finish.", {
		Name = "PaintHint", Position = UDim2.fromOffset(132, 68), Size = UDim2.new(1, -132, 0, 26), TextSize = 11,
		TextColor3 = MENU.Muted, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd,
	})

	local styleButton = button(actionBar, "Rotate [R]", { Name = "RotateStructure", LayoutOrder = 1, Size = UDim2.fromOffset(100, 30) })
	local moveButton = button(actionBar, "Move", { Name = "MoveStructure", LayoutOrder = 2, Size = UDim2.fromOffset(64, 30) })
	local reshapeButton = button(actionBar, "Reshape", { Name = "ReshapeStructure", LayoutOrder = 3, Size = UDim2.fromOffset(78, 30) })
	local finishButton = button(actionBar, "Apply finish", { Name = "ApplyFinish", LayoutOrder = 4, Size = UDim2.fromOffset(96, 30) })
	local deleteButton = button(actionBar, "Delete", { Name = "DeleteStructure", LayoutOrder = 5, Size = UDim2.fromOffset(64, 30) })
	local cancelButton = button(actionBar, "Cancel [X]", { Name = "CancelStructure", LayoutOrder = 6, Size = UDim2.fromOffset(88, 30) })

	local function notify(message)
		statusMessage = message
		if options.Notice then options.Notice(message) end
	end
	local function clearPreview()
		for part, modifier in hiddenHost do if part.Parent then part.LocalTransparencyModifier = modifier end end
		hiddenHost = {}
		if preview then preview:Destroy(); preview = nil end
		previewKey, candidate, invalidReason, roomEntries = nil, nil, nil, nil
		tooltip.Visible = false
	end
	local function clearHighlight()
		if highlight then highlight:Destroy(); highlight = nil end
		highlightedId = nil
	end
	local function entryById(id)
		if not state or not id then return nil end
		return entriesById[id]
	end
	local function customSelection()
		if not selected or not state then return false end
		for _, entry in state.Pieces or {} do if entry.Id == selected then return true end end
		return false
	end
	-- Your own pieces move freely; original full-height walls convert on their first move.
	local function movableSelection()
		if customSelection() then return true end
		local entry = entryById(selected)
		return entry ~= nil and builtins[selected] ~= nil and Catalog.movableOriginal(entry)
	end
	local function setButton(item, active, chosen)
		item.Active, item.Selectable = active, active
		StructureEditor.styleButton(item, if chosen then "Selected" elseif active then "Normal" else "Disabled")
	end
	local function currentTab()
		return if section == "Furniture" then "Furniture" elseif section == "Decorate" then "Paint" else lastBuildTool
	end
	local function refresh()
		panel.Visible, hud.Visible = opened, opened
		local tab = currentTab()
		for name, item in tabButtons do setButton(item, not pending or name == tab, name == tab) end
		variantStrip.Visible = section == "Build"
		palette.Visible = section == "Decorate"
		for kind, cards in variantCards do
			for _, record in cards do
				record.Button.Visible = kind == lastBuildTool and section == "Build"
				setButton(record.Button, not pending, tool == kind and styles[if kind == "Room" then "Wall" else kind] == record.Variant.Style)
				if record.Button.Visible and not record.Started then
					record.Started = true
					Renderer.thumbnail(record.View, {
						Kind = if kind == "Room" then "Wall" else kind, Style = record.Variant.Style,
						Material = record.Variant.Material or (if kind == "Roof" then "RoofShingles" elseif kind == "Floor" then "WoodPlanks" elseif kind == "Window" or kind == "Door" then "Wood" else "Plaster"),
						Color = record.Variant.Color or { 212, 215, 219 }, Level = 0, R = 0,
						X1 = -4.5, Z1 = -4.5, X2 = 4.5, Z2 = 4.5,
					})
				end
			end
		end
		for name, item in toolButtons do setButton(item, not pending, tool == name and moving == nil and reshaping == nil) end
		for name, item in materialButtons do setButton(item, not pending, material == name) end
		for item, swatch in colorButtons do
			local values = swatch.Color
			local chosen = values[1] == color[1] and values[2] == color[2] and values[3] == color[3]
			item.SelectedColor.Transparency = if chosen then 0 else 0.75
		end
		local hasWalls = false
		for _, entry in entriesById do
			if entry.Kind == "Wall" then hasWalls = true; break end
		end
		setButton(paintAllButton, hasWalls and not pending)
		setButton(undoButton, state ~= nil and state.CanUndo == true and not pending)
		setButton(redoButton, state ~= nil and state.CanRedo == true and not pending)
		setButton(roofsButton, true, showRoofs)
		-- Floors and grid matter only while constructing.
		local building = section ~= "Furniture"
		downButton.Visible, levelLabel.Visible, upButton.Visible, gridButton.Visible = building, building, building, section == "Build"
		setButton(downButton, level > 0 and not pending)
		setButton(upButton, level < Catalog.MAX_LEVEL and not pending)
		levelLabel.Text = string.format("Floor %d", level + 1)
		gridButton.Text = string.format("Grid %g [G]", gridSize)
		cash.Text = if state and type(state.Cash) == "number" then "$" .. tostring(state.Cash) else "$—"

		-- Floating action bar.
		local selectedEntry = entryById(selected)
		local placing = tool ~= nil and table.find(CATEGORIES, tool) ~= nil
		local selecting = tool == "Select" and moving == nil and reshaping == nil and selectedEntry ~= nil
		actionBar.Visible = opened and enabled and (placing or selecting)
		local canMove = selecting and movableSelection()
		local kindName = selectedEntry and selectedEntry.Kind or ""
		actionTitle.Text = if moving then "Moving " .. string.lower(kindName ~= "" and kindName or tool)
			elseif reshaping then "Reshaping " .. string.lower(kindName ~= "" and kindName or tool)
			elseif selecting then (if builtins[selected] then "Original " .. string.lower(kindName) else kindName)
			elseif anchor then TAB_NAMES[tool] .. " · click to finish"
			elseif placing then TAB_NAMES[tool] else ""
		styleButton.Visible = placing
		styleButton.Text = string.format("Rotate %d° [R]", rotation * 90)
		moveButton.Visible = canMove
		reshapeButton.Visible = canMove and (kindName == "Wall" or (customSelection() and (kindName == "Floor" or kindName == "Roof")))
		finishButton.Visible = selecting
		deleteButton.Visible = selecting
		cancelButton.Visible = anchor ~= nil or moving ~= nil or reshaping ~= nil or selected ~= nil
		setButton(moveButton, canMove and not pending)
		setButton(reshapeButton, canMove and not pending)
		setButton(finishButton, selectedEntry ~= nil and not pending)
		setButton(deleteButton, selectedEntry ~= nil and not pending)
		deleteButton.TextColor3 = if deleteButton.Active then MENU.Red else MENU.Muted

		status.Text = if pending then "Saving…" elseif statusMessage ~= "" then statusMessage
			elseif section == "Furniture" then furnitureHint
			elseif tool == "Select" then "Click a wall, floor or roof to edit it. Original walls can be moved too."
			elseif tool == "Remove" then "Click anything to delete it. Undo brings it back."
			elseif tool == "Paint" then "Pick a material and colour, then click surfaces to paint them."
			elseif anchor then "Click again to finish. Right-drag pans the camera."
			elseif tool == "Door" or tool == "Window" then "Point at a wall and click to fit the opening."
			else "Click to start, click again to finish."
	end
	local function apply(reset)
		local value = opened and (section ~= "Furniture" or tool == "Select" or tool == "Remove")
		if reset or value ~= enabled then
			anchor, moving, reshaping, selected, selectedInstance = nil, nil, nil, nil, nil
			clearPreview(); clearHighlight()
		end
		enabled = value
		if options.OnModeChanged then options.OnModeChanged(enabled, section, tool) end
		refresh()
	end
	local function setSection(value)
		section = value
		if value == "Build" then tool = lastBuildTool
		elseif value == "Decorate" then tool = "Paint"
		else tool = "Select" end
		statusMessage, targetRefresh = "", 0
		apply(true)
	end
	local function targetIds(data, id)
		local entry = data and data.Builtins and data.Builtins[id]
		local group = entry and entry.Kind == "Roof" and id:match("^(b:.+)/[^/]+$")
		if not group then return { id } end
		local ids = {}
		for key, descriptor in data.Builtins do
			local removed = data.Overrides and data.Overrides[key] and data.Overrides[key].Removed
			if not removed and descriptor.Kind == "Roof" and key:match("^(b:.+)/[^/]+$") == group then table.insert(ids, key) end
		end
		table.sort(ids)
		return ids
	end
	local function sourceEntry(data, id)
		if not data then return nil end
		for _, entry in data.Pieces or {} do if entry.Id == id then return entry end end
		local original = data.Builtins and data.Builtins[id]
		if not original then return nil end
		local override = data.Overrides and data.Overrides[id]
		if override and override.Removed then return nil end
		return { Material = (override and override.Material) or original.Material, Color = (override and override.Color) or original.Color }
	end
	local replayPaint
	local function scheduleReplay(session)
		if session.ReplayQueued or session.Abandoned then return end
		session.ReplayQueued = true
		task.defer(function()
			session.ReplayQueued = false
			if not session.Abandoned then replayPaint(session, false) end
		end)
	end
	local function worldPatch(session, id, patch, optimistic)
		if session.Dirty then
			session.Parts = {}
			for _, part in session.House:GetDescendants() do
				if part:IsA("BasePart") then
					local key = part:GetAttribute("BuildingId")
					if key then session.Parts[key] = session.Parts[key] or {}; table.insert(session.Parts[key], part) end
				end
			end
			session.Dirty = false
		end
		for _, part in session.Parts[id] or {} do
			if not part.Parent or part:GetAttribute("BuildingFixedFinish") then continue end
			if not session.Watching[part] and part.GetPropertyChangedSignal then
				session.Watching[part] = true
				local function changed()
					if session.Queue:busy() then scheduleReplay(session) end
				end
				part:GetPropertyChangedSignal("Color"):Connect(changed)
				part:GetPropertyChangedSignal("Material"):Connect(changed)
			end
			if not session.Snapshots[part] then session.Snapshots[part] = { Material = part.Material, Color = part.Color } end
			local finish = patch or session.Snapshots[part]
			if finish.Material then
				local value = if type(finish.Material) == "string" then Enum.Material[finish.Material] else finish.Material
				if part.Material ~= value then part.Material = value end
			end
			if finish.Color then
				local value = if type(finish.Color) == "table" and finish.Color[1] then Color3.fromRGB(finish.Color[1], finish.Color[2], finish.Color[3]) else finish.Color
				if part.Color ~= value then part.Color = value end
			end
			if optimistic then session.Applied[part] = { Material = part.Material, Color = part.Color }
			elseif patch then session.Snapshots[part] = { Material = part.Material, Color = part.Color } end
		end
	end
	replayPaint = function(session, rebase)
		if session.Abandoned then return end
		local owner = session.House:GetAttribute("OwnerUserId") or (session.House.Parent and session.House.Parent:GetAttribute("OwnerUserId"))
		if Players.LocalPlayer and owner and owner ~= Players.LocalPlayer.UserId then
			-- Release local overrides once. Later replication belongs to the next owner.
			session.Abandoned = true
			for id in session.PendingIds do
				for _, part in session.Parts[id] or {} do
					local snapshot, applied = session.Snapshots[part], session.Applied[part]
					if part.Parent and snapshot and applied then
						if part.Material == applied.Material then part.Material = snapshot.Material end
						if part.Color == applied.Color then part.Color = snapshot.Color end
					end
				end
			end
			return
		end
		if rebase then
			for id in session.Touched do worldPatch(session, id, sourceEntry(session.State, id)) end
		end
		local records = {}
		for _, record in session.Queue.Outstanding do table.insert(records, record) end
		table.sort(records, function(a, b) return a.Serial < b.Serial end)
		for _, record in records do
			for _, id in targetIds(session.State, record.Patch.Id) do
				session.Touched[id] = true
				worldPatch(session, id, record.Patch, true)
				if paintSession == session then
					local entry = entriesById[id]
					if entry then entry.Material, entry.Color = record.Patch.Material, table.clone(record.Patch.Color) end
				end
			end
		end
	end
	accept = function(nextState)
		if type(nextState) ~= "table" then return end
		if paintSession then
			local previous = paintSession.State
			if previous and (nextState.Revision or 0) < (previous.Revision or 0) then return end
			paintSession.State, paintSession.Dirty = nextState, true
		end
		state = deep(nextState)
		builtins, entriesById = {}, {}
		for _, entry in state.Pieces or {} do entriesById[entry.Id] = entry end
		for id, entry in state.Builtins or {} do
			local override = state.Overrides and state.Overrides[id]
			if override and override.Removed then continue end
			local descriptor = copy(entry)
			if override then descriptor.Material, descriptor.Color = override.Material or descriptor.Material, override.Color or descriptor.Color end
			builtins[id], entriesById[id] = descriptor, descriptor
		end
		targetRefresh = 0
		if selected and not entryById(selected) then selected, selectedInstance = nil, nil; clearHighlight() end
		previewKey = nil
		if paintSession then replayPaint(paintSession, true) end
		refresh()
	end
	local function openPaintSession(model, where)
		local session = paintSessions[model]
		if session and session.Site == where and not session.Abandoned then return session end
		session = { House = model, Site = where, State = nil, Touched = {},
			Snapshots = setmetatable({}, { __mode = "k" }), Watching = setmetatable({}, { __mode = "k" }),
			Applied = setmetatable({}, { __mode = "k" }), PendingIds = {}, Parts = {}, Dirty = true }
		session.Queue = PaintQueue.new({
			Send = function(entries)
				if not remote then return { Ok = false, Message = "Building tools are still connecting." } end
				local ok, result = pcall(remote.InvokeServer, remote, "PaintBatch", { Entries = entries }, session.Site)
				if ok and type(result) == "table" then return result end
				local fetched, current = pcall(remote.InvokeServer, remote, "Get", {}, session.Site)
				return { Ok = false, Message = "Painting could not be saved. Please try again.", State = fetched and current and current.State }
			end,
			Changed = function(outstanding)
				session.PendingIds = {}
				for _, record in outstanding do
					for _, id in targetIds(session.State, record.Patch.Id) do session.PendingIds[id] = true end
				end
				replayPaint(session, false)
			end,
			Result = function(result)
				if result and result.State and (not session.State or (result.State.Revision or 0) >= (session.State.Revision or 0)) then session.State = result.State end
				session.Dirty = true
				if paintSession == session and opened and session.State then accept(session.State) else replayPaint(session, true) end
				if not result or result.Ok == false then
					local message = result and result.Message or "Painting could not be saved. Please try again."
					if paintSession == session and opened then notify(message); refresh() elseif options.Notice then options.Notice(message) end
				end
			end,
		})
		if model.DescendantAdded then
			model.DescendantAdded:Connect(function()
				session.Dirty = true
				if session.Queue:busy() then scheduleReplay(session) end
			end)
		end
		paintSessions[model] = session
		return session
	end
	local function paint(id)
		if not paintSession or not state then return end
		local ids = targetIds(paintSession.State, id)
		paintSession.Queue:paint({ Id = ids[1], Material = material, Color = table.clone(color) })
	end
	local function send(action, payload, onSuccess)
		if pending or not opened then return end
		if not remote then notify("Building tools are connecting. Try again shortly."); refresh(); return end
		pending, statusMessage = true, ""
		refresh()
		local token, requestSite = generation, site
		local requestSession = paintSession
		local function dispatch() task.spawn(function()
			local ok, result = pcall(remote.InvokeServer, remote, action, payload, requestSite)
			if token ~= generation then
				if ok and type(result) == "table" and type(result.State) == "table" and requestSession then
					if not requestSession.State or (result.State.Revision or 0) >= (requestSession.State.Revision or 0) then
						requestSession.State = result.State
						if paintSession == requestSession and opened then accept(result.State) end
					end
				end
				return
			end
			pending = false
			if ok and type(result) == "table" then
				if result.State then accept(result.State) end
				if result.Ok == false or result.Success == false then
					notify(result.Message or result.Reason or "This edit could not be saved.")
				elseif onSuccess then onSuccess(result) end
			else
				notify("Building could not be saved. Please try again.")
			end
			refresh()
		end) end
		if paintSession then paintSession.Queue:drain(dispatch) else dispatch() end
	end
	local function changeTool(name)
		if pending then return end
		if table.find(CATEGORIES, name) then section, lastBuildTool = "Build", name
		elseif name == "Paint" then section = "Decorate" end
		if name ~= tool and table.find(CATEGORIES, name) then
			material = if name == "Window" or name == "Door" then "Wood" elseif name == "Roof" then "RoofShingles" elseif name == "Floor" then "WoodPlanks" else "Plaster"
		end
		if name ~= "Select" then selected, selectedInstance = nil, nil; clearHighlight() end
		tool, anchor, moving, reshaping, statusMessage, targetRefresh = name, nil, nil, nil, "", 0
		clearPreview()
		apply(false)
	end
	local function idOf(item)
		local cursor = item
		while cursor and cursor ~= house do
			local id = cursor:GetAttribute("BuildingId")
			if type(id) == "string" then return id, cursor end
			cursor = cursor.Parent
		end
		return nil, nil
	end
	local function pointerPlane(position)
		local camera = workspace.CurrentCamera
		if not camera then return nil end
		local ray = camera:ScreenPointToRay(position.X, position.Y)
		local floorY = Catalog.planeHeight(site, level)
		local normal = frame.UpVector
		local denominator = ray.Direction:Dot(normal)
		if math.abs(denominator) < 1e-5 then return nil end
		local distance = ((frame * Vector3.new(0, floorY, 0)) - ray.Origin):Dot(normal) / denominator
		if distance < 0 then return nil end
		return frame:PointToObjectSpace(ray.Origin + ray.Direction * distance)
	end
	local function overInterface(position)
		local gui = options.Gui
		for _, item in { panel, hud, actionBar, gui:FindFirstChild("BuildNavigation"), gui:FindFirstChild("BuildHelp"),
			gui:FindFirstChild("FurnitureActions"), gui:FindFirstChild("RackEditor") } do
			if item and item.Visible then
				local origin, size = item.AbsolutePosition, item.AbsoluteSize
				if position.X >= origin.X and position.Y >= origin.Y
					and position.X <= origin.X + size.X and position.Y <= origin.Y + size.Y then return true end
			end
		end
		return false
	end
	local function snap(value)
		return Catalog.snap(value, gridSize, site)
	end
	local function nextGrid()
		gridSize = if gridSize == Catalog.GRID then Catalog.GRID / 2
			elseif gridSize == Catalog.GRID / 2 then Catalog.GRID / 4 else Catalog.GRID
		anchor, previewKey = nil, nil
		if options.OnModeChanged then options.OnModeChanged(enabled, section, tool) end
		refresh()
	end
	local function findTarget(position)
		hovered, hoveredInstance, hoverPoint = nil, nil, nil
		local camera = workspace.CurrentCamera
		if not house or not state or not camera then return end
		local now = os.clock()
		if now >= targetRefresh then
			targets = {}
			for _, item in house:GetDescendants() do
				if item:IsA("BasePart") then
					local id = idOf(item)
					local entry = entryById(id)
					if entry and (entry.Level or 0) == level and not item:GetAttribute("BuildingRemoved")
						and ((item.LocalTransparencyModifier or 0) < 0.99 or hiddenHost[item] ~= nil) and (item.Transparency or 0) < 1
						and (self:roofVisible() or entry.Kind ~= "Roof") then table.insert(targets, item) end
				end
			end
			targetRefresh = now + 0.5
		end
		if #targets == 0 then return end
		local ray = camera:ScreenPointToRay(position.X, position.Y)
		local parameters = RaycastParams.new()
		parameters.FilterType = Enum.RaycastFilterType.Include
		parameters.FilterDescendantsInstances = targets
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 1200, parameters)
		if not hit then return end
		local id, instance = idOf(hit.Instance)
		local entry = entryById(id)
		if entry then hovered, hoveredInstance, hoverPoint = entry, instance, frame:PointToObjectSpace(hit.Position) end
	end
	local function selectHovered()
		selected = hovered and hovered.Id or nil
		selectedInstance = hoveredInstance
		clearHighlight()
		if hoveredInstance then
			highlight = make("Highlight", previewFolder, {
				Adornee = hoveredInstance, FillColor = Color3.fromRGB(179, 141, 239), FillTransparency = 0.65,
				OutlineColor = Color3.fromRGB(226, 210, 255), DepthMode = Enum.HighlightDepthMode.Occluded,
			})
		end
		if hovered then
			material = hovered.Material or material
			color = if hovered.Color then table.clone(hovered.Color) else color
			hex.Text = string.format("#%02X%02X%02X", color[1], color[2], color[3])
			if options.OnSelect then options.OnSelect() end
		end
		statusMessage = ""
		refresh()
	end
	local function candidateAt(position)
		local source = moving and entryById(moving)
		local kind = if source then source.Kind else tool
		if kind == "Window" or kind == "Door" then
			if not hovered or hovered.Kind ~= "Wall" or not hoverPoint then return nil, "Point at a wall to fit the opening." end
			local host = Catalog.host(state.Pieces or {}, builtins, hovered.Id)
			if not host then return nil, "Choose a wall." end
			local dx, dz = host.X2 - host.X1, host.Z2 - host.Z1
			local length = math.sqrt(dx * dx + dz * dz)
			if length < 0.01 then return nil, "Choose a longer wall." end
			local along = ((hoverPoint.X - host.X1) * dx + (hoverPoint.Z - host.Z1) * dz) / length
			local entry = if source then copy(source) else {
				Kind = kind, Level = host.Level or level, Material = material, Color = table.clone(color), Style = styles[kind],
			}
			entry.R = rotation
			local width = Catalog.opening(entry)
			local minimum, maximum = width / 2 + 0.2, length - width / 2 - 0.2
			local openingStep = gridSize / 2
			local offset = math.round(along / openingStep) * openingStep
			entry.HostId = host.Id or hovered.Id
			entry.Offset = if maximum >= minimum then math.clamp(offset, minimum, maximum) else length / 2
			return entry
		end
		local point = pointerPlane(position)
		if not point then return nil, "Point inside your plot." end
		local x, z = snap(point.X), snap(point.Z)
		if source then
			local entry = copy(source)
			local cx, cz = (entry.X1 + entry.X2) / 2, (entry.Z1 + entry.Z2) / 2
			if (rotation - (source.R or 0)) % 2 == 1 then
				local dx1, dz1 = entry.X1 - cx, entry.Z1 - cz
				local dx2, dz2 = entry.X2 - cx, entry.Z2 - cz
				entry.X1, entry.Z1, entry.X2, entry.Z2 = cx - dz1, cz + dx1, cx - dz2, cz + dx2
			end
			local dx, dz = math.round((x - cx) / gridSize) * gridSize, math.round((z - cz) / gridSize) * gridSize
			entry.X1, entry.Z1 = entry.X1 + dx, entry.Z1 + dz
			entry.X2, entry.Z2, entry.Level = entry.X2 + dx, entry.Z2 + dz, level
			entry.R = rotation
			return entry
		end
		if kind ~= "Wall" and kind ~= "Room" and kind ~= "Floor" and kind ~= "Roof" then return nil end
		local first = anchor or Vector2.new(x, z)
		local dx, dz = x - first.X, z - first.Y
		if dx == 0 and dz == 0 then dx = gridSize; if kind ~= "Wall" then dz = gridSize end end
		for _ = 1, rotation do dx, dz = -dz, dx end
		x, z = first.X + dx, first.Y + dz
		if kind == "Wall" then
			if math.abs(x - first.X) >= math.abs(z - first.Y) then z = first.Y else x = first.X end
			if x == first.X and z == first.Y then x += gridSize end
		else
			if x == first.X then x += gridSize end
			if z == first.Y then z += gridSize end
		end
		return {
			Kind = if kind == "Room" then "Floor" else kind, X1 = first.X, Z1 = first.Y, X2 = x, Z2 = z, Level = level,
			Material = material, Color = table.clone(color), Style = styles[if kind == "Room" then "Floor" else kind], R = rotation,
		}
	end
	local function room(entry)
		local x1, z1, x2, z2 = entry.X1, entry.Z1, entry.X2, entry.Z2
		local edges = { { x1, z1, x2, z1 }, { x2, z1, x2, z2 }, { x1, z2, x2, z2 }, { x1, z1, x1, z2 } }
		local entries = {}
		for index, edge in edges do
			table.insert(entries, {
				Id = "room-preview-" .. index, Kind = "Wall", X1 = edge[1], Z1 = edge[2], X2 = edge[3], Z2 = edge[4],
				Level = entry.Level, Material = entry.Material, Color = table.clone(entry.Color), Style = styles.Wall, R = entry.R,
			})
		end
		local floor = copy(entry)
		floor.Id = "room-preview-floor"
		table.insert(entries, floor)
		return entries
	end
	-- Keep the floating actions beside the selection, or centred above the dock.
	local function placeActions()
		if not actionBar.Visible then return end
		local camera = workspace.CurrentCamera
		local floor = panel.AbsolutePosition.Y - 10
		local point = nil
		if selectedInstance and selectedInstance.Parent and camera and camera.WorldToScreenPoint
			and moving == nil and reshaping == nil and tool == "Select" then
			local top = selectedInstance.Position + frame.UpVector * (selectedInstance.Size.Y / 2 + 0.5)
			local screen, visible = camera:WorldToScreenPoint(top)
			if visible then point = Vector2.new(screen.X, screen.Y) end
		end
		if point then
			local size = actionBar.AbsoluteSize
			local width = options.Gui.AbsoluteSize.X
			local half = size.X / 2
			actionBar.Position = UDim2.fromOffset(
				math.clamp(point.X, half + 8, math.max(half + 8, width - half - 8)),
				math.clamp(point.Y - 8, size.Y + 80, math.max(size.Y + 80, floor))
			)
		else
			actionBar.Position = UDim2.new(0.5, 0, 0, floor)
		end
	end
	function self:roofVisible()
		return opened and enabled and (showRoofs or tool == "Roof" or level > 0)
	end
	function self:isActive()
		return opened and enabled
	end
	function self:tool()
		return tool
	end
	function self:section()
		return section
	end
	function self:elevation()
		return if opened and enabled then level * Catalog.LEVEL_HEIGHT else 0
	end
	function self:gridSize()
		return gridSize
	end
	-- BuildMode: the pointer is over furniture, so structures should not react to it.
	function self:block(value)
		blocked = value == true
	end
	function self:setHint(text)
		if furnitureHint ~= text then furnitureHint = text; refresh() end
	end
	function self:clearSelection()
		if selected or moving or reshaping then
			selected, selectedInstance, moving, reshaping = nil, nil, nil, nil
			clearPreview(); clearHighlight(); refresh()
		end
	end
	-- Holding furniture pauses the structure tools on the Furniture tab; dropping resumes them.
	function self:suspend()
		if opened and section == "Furniture" and tool ~= nil then tool = nil; apply(false) end
	end
	function self:resume()
		if opened and section == "Furniture" and tool == nil then tool = "Select"; apply(false) end
	end
	function self:step(position)
		if not opened or not enabled then return end
		placeActions()
		if overInterface(position) or blocked then
			clearPreview()
			hovered, hoveredInstance, hoverPoint = nil, nil, nil
			if blocked and not selected and highlightedId then clearHighlight() end
			return
		end
		findTarget(position)
		if tool == "Select" or tool == "Paint" or tool == "Remove" then
			clearPreview()
			if hovered then
				tooltip.Text = if tool == "Paint" then "Paint " .. hovered.Kind
					elseif tool == "Remove" then "Delete " .. hovered.Kind .. " · Undo available"
					elseif builtins[hovered.Id] then "Original " .. string.lower(hovered.Kind) else hovered.Kind
				tooltip.Visible = true
			end
			if not selected and highlightedId ~= (hovered and hovered.Id) then
				clearHighlight()
				if hovered then
					highlightedId = hovered.Id
					highlight = make("Folder", previewFolder, { Name = "SurfacePreviewOutline" })
					for _, part in house:GetDescendants() do
						if part:IsA("BasePart") and part:GetAttribute("BuildingId") == hovered.Id then
							make("Highlight", highlight, { Adornee = part, FillTransparency = 0.93,
								FillColor = if tool == "Remove" then MENU.Red else MENU.Blue,
								OutlineColor = if tool == "Remove" then MENU.Red else MENU.White,
								DepthMode = Enum.HighlightDepthMode.Occluded })
						end
					end
				end
			end
		elseif state then
			local raw, reason = candidateAt(position)
			local entry, normalizeReason
			if raw then entry, normalizeReason = Catalog.normalize(raw) end
			local isRoom = tool == "Room" and not moving and not reshaping
			roomEntries = if entry and isRoom then room(entry) else nil
			local cost = 0
			if entry then
				if roomEntries then
					local checked = table.clone(state.Pieces or {})
					for _, piece in roomEntries do
						reason = reason or Catalog.check(checked, piece, site, builtins)
						cost += Catalog.price(piece)
						table.insert(checked, piece)
					end
				else
					reason = Catalog.check(state.Pieces or {}, entry, site, builtins, moving or reshaping)
					cost = Catalog.price(entry)
				end
				if not moving and not reshaping and cost > (state.Cash or 0) then reason = reason or "You need more cash for this build." end
			else reason = normalizeReason or reason end
			candidate, invalidReason = entry, reason
			local key = if entry then string.format("%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s",
				entry.Kind, tostring(entry.X1), tostring(entry.Z1), tostring(entry.X2), tostring(entry.Z2), tostring(entry.Level),
				tostring(entry.HostId), tostring(entry.Offset), tostring(entry.Style), entry.Material or material,
				tostring(color[1]), tostring(color[2]), tostring(color[3]), tostring(reason), tostring(reshaping or moving)) .. tool .. tostring(entry.R) else "none"
			if key ~= previewKey then
				for part, modifier in hiddenHost do if part.Parent then part.LocalTransparencyModifier = modifier end end
				hiddenHost = {}
				if preview then preview:Destroy(); preview = nil end
				previewKey = key
				if roomEntries then
					preview = make("Model", previewFolder, { Name = "RoomPreview" })
					for _, piece in roomEntries do Renderer.preview(preview, frame, piece, state.Pieces or {}, builtins, reason == nil, site) end
				elseif entry then preview = Renderer.preview(previewFolder, frame, entry, state.Pieces or {}, builtins, reason == nil, site) end
				-- Hide the wall that hosts a new opening, and the original being moved.
				local hide = if entry and entry.HostId and reason == nil then entry.HostId
					elseif (moving or reshaping) and builtins[moving or reshaping] then moving or reshaping else nil
				if hide then
					for _, part in house:GetDescendants() do
						if part:IsA("BasePart") and part:GetAttribute("BuildingId") == hide then
							hiddenHost[part] = part.LocalTransparencyModifier or 0
							part.LocalTransparencyModifier = 1
						end
					end
				end
			end
			tooltip.Text = if reason then reason elseif entry then string.format("%s · $%d\n%s", if isRoom then "Room" else entry.Kind, cost,
				if moving then "Click to move" elseif anchor or tool == "Door" or tool == "Window" then "Click to build" else "Click to start") else ""
			tooltip.Visible = entry ~= nil or reason ~= nil
		end
		local camera = workspace.CurrentCamera
		if camera then
			local size = camera.ViewportSize
			tooltip.Position = UDim2.fromOffset(math.clamp(position.X + 18, 4, math.max(4, size.X - 284)),
				math.clamp(position.Y + 20, 4, math.max(4, panel.AbsolutePosition.Y - 60)))
		end
	end
	function self:click(position)
		if not self:isActive() or (pending and tool ~= "Paint") or overInterface(position) then return end
		statusMessage = ""
		self:step(position)
		if tool == "Select" and not moving and not reshaping then selectHovered(); return end
		if tool == "Paint" or tool == "Remove" then
			if not hovered then return end
			local id = hovered.Id
			if tool == "Paint" then paint(id)
			else send("Remove", { Id = id }) end
			return
		end
		if not moving and tool ~= "Window" and tool ~= "Door" and not anchor then
			local point = pointerPlane(position)
			if point then anchor = Vector2.new(snap(point.X), snap(point.Z)); clearPreview(); refresh(); self:step(position) end
			return
		end
		if invalidReason or not candidate then
			notify(invalidReason or "Choose a valid position."); refresh(); return
		end
		local entry, moveId = copy(candidate), moving or reshaping
		local action = if moveId then "Move" else "Place"
		local payload = if moveId then { Id = moveId, Entry = entry } else { Entries = roomEntries or { entry } }
		send(action, payload, function()
			anchor, moving, reshaping = nil, nil, nil
			clearPreview()
			if moveId then tool = "Select"; selected, selectedInstance = nil, nil; clearHighlight() end
		end)
	end
	local function cancel()
		local back = (moving or reshaping) and "Select"
		anchor, moving, reshaping, selected, selectedInstance, statusMessage = nil, nil, nil, nil, nil, ""
		if back then tool = back end
		clearPreview(); clearHighlight(); refresh()
	end
	local function rotate()
		if tool == nil or not table.find(CATEGORIES, tool) then return end
		rotation = (rotation + 1) % 4
		previewKey = nil
		refresh()
	end
	local function changeLevel(delta)
		if pending then return end
		level = math.clamp(level + delta, 0, Catalog.MAX_LEVEL)
		anchor, previewKey, targetRefresh = nil, nil, 0
		if options.OnModeChanged then options.OnModeChanged(enabled, section, tool) end
		refresh()
	end
	local function toggleRoofs()
		showRoofs, targetRefresh = not showRoofs, 0
		if options.OnModeChanged then options.OnModeChanged(enabled, section, tool) end
		refresh()
	end
	local function beginMove(reshape)
		if not movableSelection() or pending then return end
		local entry = entryById(selected)
		if not entry then return end
		if reshape then reshaping, moving = selected, nil else moving, reshaping = selected, nil end
		anchor, statusMessage = nil, ""
		level, rotation = entry.Level or level, entry.R or 0
		tool = entry.Kind
		if reshape then styles[tool] = entry.Style or styles[tool] end
		if section ~= "Build" then
			section = "Build"
			if table.find(CATEGORIES, entry.Kind) then lastBuildTool = entry.Kind end
		end
		if highlight then clearHighlight() end
		clearPreview()
		apply(false)
	end
	function self:key(input)
		if not self:isActive() or UserInputService:GetFocusedTextBox() then return false end
		local control = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
		if control and input.KeyCode == Enum.KeyCode.Z then send("Undo", {}); return true end
		if control and input.KeyCode == Enum.KeyCode.Y then send("Redo", {}); return true end
		if input.KeyCode == Enum.KeyCode.X or input.KeyCode == Enum.KeyCode.Escape then cancel(); return true end
		if input.KeyCode == Enum.KeyCode.R then rotate(); return true end
		if input.KeyCode == Enum.KeyCode.G then nextGrid(); return true end
		if input.KeyCode == Enum.KeyCode.M and selected and tool == "Select" then beginMove(false); return true end
		if input.KeyCode == Enum.KeyCode.PageUp then changeLevel(1); return true end
		if input.KeyCode == Enum.KeyCode.PageDown then changeLevel(-1); return true end
		if input.KeyCode == Enum.KeyCode.Delete and selected then send("Remove", { Id = selected }); return true end
		return false
	end
	function self:enter(model, houseFrame, where)
		generation += 1
		house, frame, site, opened, pending = model, houseFrame, where, true, false
		paintSession = openPaintSession(model, where)
		state, level, statusMessage, targetRefresh, rotation = nil, 0, "", 0, 0
		setSection("Furniture")
		send("Get", {})
	end
	function self:exit()
		generation += 1
		opened, pending = false, false
		enabled, section, tool = false, "Furniture", "Select"
		anchor, moving, reshaping, selected, selectedInstance, state = nil, nil, nil, nil, nil, nil
		clearPreview(); clearHighlight()
		house, targets = nil, {}
		refresh()
	end
	for name, item in toolButtons do item.Activated:Connect(function() changeTool(name) end) end
	for name, item in tabButtons do
		item.Activated:Connect(function()
			if pending then return end
			if name == "Furniture" then setSection("Furniture")
			elseif name == "Paint" then setSection("Decorate")
			else changeTool(name) end
		end)
	end
	for kind, cards in variantCards do
		for _, record in cards do
			record.Button.Activated:Connect(function()
				if pending then return end
				styles[if kind == "Room" then "Wall" else kind] = record.Variant.Style
				if tool ~= kind then changeTool(kind) end
				if record.Variant.Material then material = record.Variant.Material end
				if record.Variant.Color then color = table.clone(record.Variant.Color) end
				previewKey, statusMessage = nil, ""
				refresh()
			end)
		end
	end
	for name, item in materialButtons do item.Activated:Connect(function() material = name; statusMessage = ""; previewKey = nil; refresh() end) end
	for item, swatch in colorButtons do
		item.Activated:Connect(function()
			color, statusMessage, previewKey = table.clone(swatch.Color), "", nil
			hex.Text = string.format("#%02X%02X%02X", color[1], color[2], color[3])
			refresh()
		end)
	end
	local function applyHex()
		local value = hex.Text:gsub("%s", ""):gsub("^#", "")
		if #value ~= 6 or not value:match("^%x+$") then notify("Enter a color as #RRGGBB, for example #B29675."); refresh(); return end
		color = { tonumber(value:sub(1, 2), 16), tonumber(value:sub(3, 4), 16), tonumber(value:sub(5, 6), 16) }
		hex.Text, statusMessage, previewKey = "#" .. value:upper(), "", nil
		refresh()
	end
	hexApply.Activated:Connect(applyHex)
	hex.FocusLost:Connect(function(enterPressed) if enterPressed then applyHex() end end)
	styleButton.Activated:Connect(rotate)
	cancelButton.Activated:Connect(cancel)
	gridButton.Activated:Connect(nextGrid)
	downButton.Activated:Connect(function() changeLevel(-1) end)
	upButton.Activated:Connect(function() changeLevel(1) end)
	roofsButton.Activated:Connect(toggleRoofs)
	undoButton.Activated:Connect(function() send("Undo", {}) end)
	redoButton.Activated:Connect(function() send("Redo", {}) end)
	finishButton.Activated:Connect(function()
		if selected then paint(selected) end
	end)
	deleteButton.Activated:Connect(function()
		if selected and not pending then send("Remove", { Id = selected }) end
	end)
	paintAllButton.Activated:Connect(function()
		if section ~= "Decorate" or not state then return end
		send("PaintAllWalls", { Material = material, Color = table.clone(color) }, function()
			statusMessage = "All walls painted."
		end)
	end)
	moveButton.Activated:Connect(function() beginMove(false) end)
	reshapeButton.Activated:Connect(function() beginMove(true) end)
	-- Wait outside BuildMode.start so a delayed service does not hold up its UI.
	task.spawn(function()
		local network = ReplicatedStorage:WaitForChild("Building")
		remote, event = network:WaitForChild("Request"), network:WaitForChild("Update")
		event.OnClientEvent:Connect(function(kind, payload, where)
			if kind == "State" and opened and (where or "Home") == (site or "Home") then accept(payload)
			elseif kind == "Notice" and opened then notify(tostring(payload)); refresh() end
		end)
		if opened then send("Get", {}) end
	end)
	refresh()
	return self
end

return StructureEditor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="364">
          <Properties>
            <string name="Name">SupercellWeather</string>
            <string name="Source"><![CDATA[-- The supercell and its tornadoes, drawn from the shared deterministic forecast
-- (Weather.supercell / Weather.tornadoes), so every client sees a funnel exactly
-- where the server throws boats. Client-only parts; they never affect physics.
-- Every device gets the funnels and the storm's dark rotating base; computers
-- with volumetric clouds also get the full tower, anvil and overshooting top.
--
-- The storm is soft billows (VolumetricClouds.billows)
-- around a few opaque cores: nine parts on a computer and five on a phone,
-- where it used to move close to a hundred translucent spheres every frame.
-- Billows are locked to their part, so turning the shelf turns its puffs.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Biomes = require(ReplicatedStorage.Shared.Biomes)
local Weather = require(ReplicatedStorage.Shared.Weather)
local Clouds = require(script.Parent.VolumetricClouds)

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end

local Controller = {}
local started = false
local FUNNEL_SEGMENTS = 7
local FUNNEL_BILLOWS = 12
-- Funnel puffs live briefly, so touchdown and roping out show within a second or two.
local FUNNEL_LIFE = { 1.6, 2.6 }
local BASE_HEIGHT = 380
local WALL_HEIGHT = 270
local ROTATION_SPEED = 0.05
-- Opacity and funnel widths are rewritten in steps, not on every frame.
local OPACITY_STEP = 0.05
local WIDTH_STEP = 0.08

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

type Billow = { emitter: ParticleEmitter, opacity: number }
type Piece = { part: BasePart, offset: CFrame, transparency: number?, spins: boolean, billows: { Billow } }
type Storm = { model: Model, pieces: { Piece }, shaft: Beam, detailed: boolean, opacity: number, primed: boolean }
type Funnel = {
	model: Model,
	segments: { BasePart },
	billows: { ParticleEmitter },
	widths: { number },
	base: BasePart,
	spray: ParticleEmitter,
	debris: ParticleEmitter,
	radius: number,
	opacity: number,
}

-- Offsets are relative to the cell center on the water, with -Z pointing along
-- the storm's motion: rain falls on the forward flank, the wall cloud and its
-- tornadoes hang under the rear flank.
local function buildStorm(detailed: boolean): Storm
	local model = Instance.new("Model")
	model.Name = "Supercell"
	local pieces: { Piece } = {}
	local amount = if detailed then 1 else 0.5
	local function piece(part: BasePart, offset: Vector3, transparency: number?, spins: boolean): Piece
		part.Transparency = 1
		local entry =
			{ part = part, offset = CFrame.new(offset), transparency = transparency, spins = spins, billows = {} }
		table.insert(pieces, entry)
		return entry
	end
	local function solid(name: string, color: Color3, size: Vector3, offset: Vector3): Piece
		local part = Clouds.puff(model, color, size, false)
		part.Name = name
		return piece(part, offset, 0, false)
	end
	local function hollow(name: string, size: Vector3, offset: Vector3, spins: boolean): Piece
		return piece(Clouds.anchor(model, name, size), offset, nil, spins)
	end
	local function billows(target: Piece, low: Color3, high: Color3, size: number, count: number, surface: boolean)
		local emitter = Clouds.billows(
			target.part,
			low,
			high,
			size,
			math.max(4, math.round(count * amount)),
			{ surface = surface, locked = true }
		)
		table.insert(target.billows, { emitter = emitter, opacity = 1 })
	end
	local core = Weather.SupercellCoreRadius
	-- The flat-bottomed mesocyclone base, wrapped in a turning shell of billows:
	-- its fluffy shelf edge, and lumpy turbulence when you look up from under it.
	solid("MesocycloneBase", rgb(46, 54, 52), Vector3.new(core * 3.2, 90, core * 3.2), Vector3.new(0, BASE_HEIGHT, 0))
	local shelf = hollow("Shelf", Vector3.new(core * 3.5, 150, core * 3.5), Vector3.new(0, BASE_HEIGHT - 15, 0), true)
	billows(shelf, rgb(48, 58, 56), rgb(78, 88, 88), 100, 80, true)
	local underside =
		hollow("Underside", Vector3.new(core * 2.6, 60, core * 2.6), Vector3.new(0, BASE_HEIGHT - 55, 0), true)
	billows(underside, rgb(38, 46, 45), rgb(62, 72, 70), 100, 50, false)
	-- Matches Weather.tornadoes' mean touchdown point, so funnels hang from it.
	local wall = solid(
		"WallCloud",
		rgb(40, 48, 47),
		Vector3.new(core * 0.8, 90, core * 0.8),
		Vector3.new(core * 0.3, WALL_HEIGHT + 60, core * 0.35)
	)
	billows(wall, rgb(36, 44, 43), rgb(60, 68, 66), 90, 36, true)
	if detailed then
		-- Tower, sheared anvil and the overshooting top above the updraft.
		local lower = solid(
			"TowerLower",
			rgb(86, 94, 100),
			Vector3.new(core * 1.9, 760, core * 1.7),
			Vector3.new(0, BASE_HEIGHT + 460, 0)
		)
		billows(lower, rgb(80, 88, 96), rgb(156, 162, 170), 100, 40, true)
		local upper = solid(
			"TowerUpper",
			rgb(200, 204, 212),
			Vector3.new(core * 1.5, 760, core * 1.35),
			Vector3.new(30, BASE_HEIGHT + 1080, -40)
		)
		billows(upper, rgb(198, 202, 210), rgb(242, 244, 248), 100, 40, true)
		local anvil =
			solid("Anvil", rgb(226, 230, 236), Vector3.new(core * 7, 140, core * 5), Vector3.new(0, 1850, -core * 1.6))
		billows(anvil, rgb(214, 220, 228), rgb(246, 247, 250), 100, 50, true)
		local top = hollow("OvershootingTop", Vector3.new(core * 1.4, 320, core * 1.4), Vector3.new(0, 1960, 0), false)
		billows(top, rgb(232, 236, 240), rgb(250, 251, 253), 100, 18, false)
	end
	local anchor = hollow("ShaftAnchor", Vector3.one, Vector3.new(0, BASE_HEIGHT, -core * 0.9), false)
	local shaft = Clouds.shaft(anchor.part, BASE_HEIGHT, core * 1.6, rgb(70, 78, 82))
	model.Parent = workspace
	return { model = model, pieces = pieces, shaft = shaft, detailed = detailed, opacity = -1, primed = false }
end

local function buildFunnel(radius: number): Funnel
	local model = Instance.new("Model")
	model.Name = "Tornado"
	local segments, billows, widths = {}, {}, {}
	-- A spinning column of puffs: each segment turns, and its locked billows turn
	-- with it, so the rotation shows without any extra spiral bands.
	for index = 1, FUNNEL_SEGMENTS do
		local fraction = (index - 1) / (FUNNEL_SEGMENTS - 1)
		local part = Clouds.anchor(model, "FunnelSegment", Vector3.one)
		local color = rgb(118, 116, 108):Lerp(rgb(84, 92, 94), fraction)
		local emitter = Clouds.billows(
			part,
			color,
			color:Lerp(rgb(150, 150, 142), 0.35),
			1,
			FUNNEL_BILLOWS,
			{ locked = true, life = FUNNEL_LIFE }
		)
		table.insert(segments, part)
		table.insert(billows, emitter)
		table.insert(widths, 0)
	end
	local base = Clouds.anchor(model, "TornadoBase", Vector3.new(radius * 3, 1, radius * 3))
	-- Sea spray thrown out in a ring where the vortex meets the water.
	local spray = Instance.new("ParticleEmitter")
	spray.Name = "Spray"
	spray.Texture = "rbxasset://textures/particles/smoke_main.dds"
	spray.Shape = Enum.ParticleEmitterShape.Disc
	spray.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
	spray.EmissionDirection = Enum.NormalId.Top
	spray.Color = ColorSequence.new(rgb(214, 224, 228))
	spray.LightInfluence = 1
	spray.Lifetime = NumberRange.new(1.6, 2.6)
	spray.Speed = NumberRange.new(18, 34)
	spray.SpreadAngle = Vector2.new(35, 35)
	spray.Acceleration = Vector3.new(0, 6, 0)
	spray.Drag = 1.2
	spray.Rotation = NumberRange.new(0, 360)
	spray.RotSpeed = NumberRange.new(-260, 260)
	spray.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 10), NumberSequenceKeypoint.new(1, 34) })
	spray.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	spray.Parent = base
	local debris = Instance.new("ParticleEmitter")
	debris.Name = "Debris"
	debris.Shape = Enum.ParticleEmitterShape.Disc
	debris.EmissionDirection = Enum.NormalId.Top
	debris.Color = ColorSequence.new(rgb(58, 52, 44))
	debris.LightInfluence = 1
	debris.Lifetime = NumberRange.new(1.5, 3)
	debris.Speed = NumberRange.new(30, 60)
	debris.SpreadAngle = Vector2.new(50, 50)
	debris.Acceleration = Vector3.new(0, -30, 0)
	debris.Rotation = NumberRange.new(0, 360)
	debris.RotSpeed = NumberRange.new(-400, 400)
	debris.Size = NumberSequence.new(1.6)
	debris.Parent = base
	model.Parent = workspace
	return {
		model = model,
		segments = segments,
		billows = billows,
		widths = widths,
		base = base,
		spray = spray,
		debris = debris,
		radius = radius,
		opacity = -1,
	}
end

function Controller.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local storm: Storm? = nil
	local funnels: { [number]: Funnel } = {}
	local parts: { BasePart }, frames: { CFrame } = {}, {}
	local elapsed = 1 / 30
	local function clearStorm()
		if storm then
			storm.model:Destroy()
			storm = nil
		end
	end
	local function clearFunnels(keep: { [number]: boolean }?)
		for id, funnel in funnels do
			if not keep or not keep[id] then
				funnel.model:Destroy()
				funnels[id] = nil
			end
		end
	end
	RunService.RenderStepped:Connect(profiled("SupercellWeather", function(dt: number)
		elapsed += dt
		if elapsed < 1 / 30 then
			return
		end
		elapsed = 0
		local now = workspace:GetServerTimeNow()
		local cell = Weather.supercell(now)
		local camera = workspace.CurrentCamera
		if not cell or not camera or player:GetAttribute("WeatherEffectsEnabled") == false then
			clearStorm()
			clearFunnels()
			return
		end
		local water = Biomes.WaterLevel
		local detailed = player:GetAttribute("VolumetricCloudsEnabled") == true
		if storm and storm.detailed ~= detailed then
			clearStorm()
		end
		local active = storm or buildStorm(detailed)
		storm = active
		local speed = math.sqrt(cell.motion.X ^ 2 + cell.motion.Z ^ 2)
		local heading = if speed > 0.01
			then CFrame.lookAt(Vector3.zero, Vector3.new(cell.motion.X, 0, cell.motion.Z))
			else CFrame.identity
		local center = CFrame.new(cell.position.X, water, cell.position.Z) * heading
		local spin = CFrame.Angles(0, now * ROTATION_SPEED, 0)
		local opacity = math.round(math.clamp(cell.strength * 1.4, 0, 1) / OPACITY_STEP) * OPACITY_STEP
		local refade = opacity ~= active.opacity
		active.opacity = opacity
		table.clear(parts)
		table.clear(frames)
		for _, piece in active.pieces do
			table.insert(parts, piece.part)
			-- The shelf turns about the updraft, carrying its billows round.
			table.insert(frames, center * (if piece.spins then spin * piece.offset else piece.offset))
			if refade then
				if piece.transparency then
					piece.part.Transparency = 1 - (1 - piece.transparency) * opacity
				end
				for _, billow in piece.billows do
					billow.emitter.Transparency = Clouds.billowTransparency(billow.opacity * opacity)
				end
			end
		end
		workspace:BulkMoveTo(parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
		if not active.primed then
			active.primed = true
			for _, piece in active.pieces do
				for _, billow in piece.billows do
					Clouds.prime(billow.emitter)
				end
			end
		end
		local dx, dz = cell.position.X - camera.CFrame.Position.X, cell.position.Z - camera.CFrame.Position.Z
		active.shaft.Enabled = dx * dx + dz * dz > (Weather.SupercellCoreRadius * 1.3) ^ 2
		if refade then
			active.shaft.Transparency = Clouds.shaftTransparency(0.75 * opacity)
		end

		local seen = {}
		for _, tornado in Weather.tornadoes(now) do
			seen[tornado.id] = true
			local funnel = funnels[tornado.id] or buildFunnel(tornado.radius)
			funnels[tornado.id] = funnel
			local strength = tornado.strength
			local ground = Vector3.new(tornado.position.X, water, tornado.position.Z)
			-- Rope-like sway: the funnel bends between the ground and the wall cloud.
			local phase = tornado.age * 0.9 + tornado.id
			local function axis(fraction: number): Vector3
				local bend = math.sin(fraction * math.pi) * funnel.radius * 1.6
				return ground
					+ Vector3.new(
						math.cos(phase + fraction * 2) * bend,
						fraction * (WALL_HEIGHT + 20),
						math.sin(phase * 0.8 + fraction * 2.4) * bend
					)
			end
			table.clear(parts)
			table.clear(frames)
			table.insert(parts, funnel.base)
			table.insert(frames, CFrame.new(ground))
			local reach = strength ^ 0.6
			for index, part in funnel.segments do
				local fraction = (index - 1) / (FUNNEL_SEGMENTS - 1)
				-- A narrow column at the sea that widens into the cloud. Touchdown
				-- grows from the top down; roping out thins it again.
				local width = funnel.radius * (0.55 + fraction ^ 2.2 * 2.6) * (0.6 + strength * 0.4)
				local emitter = funnel.billows[index]
				if math.abs(width - funnel.widths[index]) > width * WIDTH_STEP then
					funnel.widths[index] = width
					part.Size = Vector3.new(width * 0.7, WALL_HEIGHT / FUNNEL_SEGMENTS * 1.4, width * 0.7)
					local sprite = math.min(width * 0.8, 100)
					emitter.Size = NumberSequence.new({
						NumberSequenceKeypoint.new(0, sprite * 0.8),
						NumberSequenceKeypoint.new(1, sprite),
					})
				end
				emitter.Enabled = fraction >= 1 - reach
				table.insert(parts, part)
				table.insert(frames, CFrame.new(axis(fraction)) * CFrame.Angles(0, now * 3 + index, 0))
			end
			workspace:BulkMoveTo(parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
			local level = math.round((0.4 + strength * 0.6) / OPACITY_STEP) * OPACITY_STEP
			if level ~= funnel.opacity then
				funnel.opacity = level
				local transparency = Clouds.billowTransparency(level)
				for _, emitter in funnel.billows do
					emitter.Transparency = transparency
				end
			end
			local touching = reach > 0.95
			funnel.spray.Rate = if touching then 40 * strength else 0
			funnel.debris.Rate = if touching then 24 * strength else 0
		end
		clearFunnels(seen)
	end))
end

return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="365">
          <Properties>
            <string name="Name">SwellSurface</string>
            <string name="Source"><![CDATA[-- A local water sheet shaped by the same swell field the boats ride. Terrain water
-- stays flat, so without it a hull on a crest hovered studs above the visible sea.
-- The sheet shows the crests; its troughs fade out beneath Terrain's surface.
local AssetService = game:GetService("AssetService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Biomes = require(ReplicatedStorage.Shared.Biomes)
local Weather = require(ReplicatedStorage.Shared.Weather)
local MeshFeatures = require(ReplicatedStorage.Shared.MeshFeatures)
local WaterQuality = require(script.Parent.WaterQuality)
local EditableMeshBudget = require(script.Parent.EditableMeshBudget)
local TerrainProbe = require(script.Parent.TerrainProbe)

local SwellSurface = {}
-- World-fixed vertex grid around the camera: COUNT cells of SPACING studs a side.
local SPACING = 12
local COUNT = 44
local HALF = COUNT * SPACING / 2
-- Heights ease to zero over this band at the sheet's edge, meeting flat Terrain.
local EDGE_FADE = 72
-- Wet probes are redone this often (streamed shoreline), a few per frame. Each is a
-- 600-stud ray: a 2 s sweep of the 49x49 cells cast ~1200 a second, and a slow frame
-- caught up in one burst of thousands.
local WATER_CHECK_INTERVAL = 5
local SWEEP_PROBES_PER_FRAME = 12
local FIRST_PROBES_PER_FRAME = 40
-- Wind changes over kilometres; vertex amplitudes refresh this often.
local AMPLITUDE_REFRESH = 0.5
local AMPLITUDE_REFRESHES_PER_FRAME = 200
-- Neighbour cells sampled for the shoreline taper (a 5x5 block).
local SHORE_REACH = 2
-- Crests fade in only above Terrain's largest ripple (WaterWaves' MAX_RIPPLE_SIZE, 0.18), so
-- no visible part of the sheet lies within the band Terrain's surface moves through.
local FADE_FROM, FADE_HEIGHT = 0.25, 0.35
-- Every hidden vertex (calm water, troughs, swell below FADE_FROM) drops this far under the
-- water level. The sheet then crosses Terrain's surface steeply (2 studs over a 12-stud cell)
-- in thin lines. Lying on or just under it, the gently sloped sheet z-fought Terrain water in
-- wide blotches at a distance; vertex alpha alone doesn't stop the depth fight.
local CALM_DEPTH = 2
-- Clearance kept beneath a hull's sole so open decks never flood.
local HULL_CLEARANCE = 0.3
local HULL_MARGIN = 1.5
local SUNKEN = -2
-- A vertex whose swell is weaker than this can't rise to FADE_FROM, so it is fully
-- transparent: it is written flat once and then left alone. Sheltered water (the
-- harbour, the lake) otherwise rewrote and re-uploaded the whole mesh every frame.
local FLAT_AMPLITUDE = 0.03
-- Hull boxes are rigid with the root; GetBoundingBox walks every part, so it is
-- redone this often rather than every frame for every boat in range.
local HULL_BOX_REFRESH = 2
-- Vertices within this many cells of the centre update every frame: everywhere the swell is
-- at full strength, so hulls always sit on the exact surface. Only the EDGE_FADE rim, where
-- heights already ease to zero, alternates frames.
local INNER_RING = (HALF - EDGE_FADE) // SPACING
local started = false

local function smoothstep(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

local function key(x: number, z: number): number
	return (x + 32768) * 65536 + z + 32768
end

function SwellSurface.start()
	if started then
		return
	end
	started = true
	if not MeshFeatures.EditableMeshesEnabled then
		return
	end
	task.spawn(function()
		local terrain = workspace.Terrain
		local size = COUNT + 1
		local mesh = EditableMeshBudget.create()
		if not mesh then
			warn(
				"[SwellSurface] Water surface unavailable: EditableMesh is disabled or the device mesh budget is exhausted."
			)
			return
		end
		local vertices, normals, colors =
			table.create(size * size), table.create(size * size), table.create(size * size)
		local color = terrain.WaterColor
		for row = 0, COUNT do
			for column = 0, COUNT do
				local index = row * size + column + 1
				-- Opposite corners span the vertical range so the part's bounds are
				-- centered and never flat; every frame rewrites the heights anyway.
				local y = if index == 1 then 1 elseif index == size * size then -1 else 0
				vertices[index] = mesh:AddVertex(Vector3.new(column * SPACING - HALF, y, row * SPACING - HALF))
				normals[index] = mesh:AddNormal(Vector3.yAxis)
				colors[index] = mesh:AddColor(color, 0)
			end
		end
		local function face(a: number, b: number, c: number)
			local id = mesh:AddTriangle(vertices[a], vertices[b], vertices[c])
			mesh:SetFaceNormals(id, { normals[a], normals[b], normals[c] })
			mesh:SetFaceColors(id, { colors[a], colors[b], colors[c] })
		end
		for row = 0, COUNT - 1 do
			for column = 0, COUNT - 1 do
				local a = row * size + column + 1
				local b, c, d = a + 1, a + size, a + size + 1
				-- Counter-clockwise seen from above.
				face(a, c, b)
				face(b, c, d)
			end
		end
		local partOk, part = pcall(function()
			return AssetService:CreateMeshPartAsync(
				Content.fromObject(mesh),
				{ CollisionFidelity = Enum.CollisionFidelity.Box }
			)
		end)
		if not partOk or not part then
			mesh:Destroy()
			warn("[SwellSurface] Water surface unavailable: could not create its mesh part: " .. tostring(part))
			return
		end
		part.Name = "WeatherSwellSurface"
		part.Anchored = true
		part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
		part.CastShadow = false
		part.Material = Enum.Material.SmoothPlastic
		part.Color = color
		part.Reflectance = 0.08
		-- Let submerged scenery remain visible through the extra crest layer.
		part.Transparency = 0.55
		part.LocalTransparencyModifier = 1
		part.Parent = workspace

		local parameters = RaycastParams.new()
		parameters.FilterType = Enum.RaycastFilterType.Exclude
		parameters.IgnoreWater = false
		local function refreshFilter()
			local excluded: { Instance } = { part, workspace.Terrain }
			for _, player in Players:GetPlayers() do
				if player.Character then
					table.insert(excluded, player.Character)
				end
			end
			local boats = workspace:FindFirstChild("PlayerBoats")
			if boats then
				table.insert(excluded, boats)
			end
			parameters.FilterDescendantsInstances = excluded
		end
		-- Terrain comes from voxels: a terrain ray builds collision for every chunk it
		-- crosses that this client never queried (RaycastTerrain > buildKDTree, ~100 ms
		-- frames). The ray, with Terrain excluded, only looks for piers and island meshes
		-- above the surface.
		local function isWater(x: number, z: number): boolean
			if not TerrainProbe.isWater(x, z) then
				return false
			end
			return workspace:Raycast(Vector3.new(x, Biomes.WaterLevel + 512, z), Vector3.new(0, -512, 0), parameters)
				== nil
		end

		-- World grid cells, kept while inside the sheet: wet probe and swell strength.
		local cells = {}
		local alphas = table.create(size * size, -1)
		-- Vertices already written flat since the sheet last moved.
		local flat = table.create(size * size, false)
		local hullBoxes: { [Model]: { root: BasePart, offset: CFrame, extents: Vector3, at: number } } =
			setmetatable({}, { __mode = "k" }) :: any
		local function hullBox(boat: Model): (CFrame, Vector3)
			local root = boat.PrimaryPart
			if not root then
				return boat:GetBoundingBox()
			end
			local clock = os.clock()
			local cached = hullBoxes[boat]
			if not cached or cached.root ~= root or clock - cached.at > HULL_BOX_REFRESH then
				local frame, extents = boat:GetBoundingBox()
				cached = { root = root, offset = root.CFrame:ToObjectSpace(frame), extents = extents, at = clock }
				hullBoxes[boat] = cached
			end
			return root.CFrame * cached.offset, cached.extents
		end
		-- Per-vertex data that never changes: local X/Z, the edge fade, and whether the vertex
		-- is in the inner ring that updates every frame. Vertices in the fading rim (over
		-- 190 studs out, already easing to flat) update on alternate frames in a checkerboard,
		-- which halves their mesh writes.
		local localX, localZ, edges, inner =
			table.create(size * size), table.create(size * size), table.create(size * size), table.create(size * size)
		for row = 0, COUNT do
			local edgeZ = HALF - math.abs(row * SPACING - HALF)
			for column = 0, COUNT do
				local index = row * size + column + 1
				localX[index], localZ[index] = column * SPACING - HALF, row * SPACING - HALF
				edges[index] = smoothstep(math.min(edgeZ, HALF - math.abs(column * SPACING - HALF)) / EDGE_FADE)
				inner[index] = math.max(math.abs(row - COUNT / 2), math.abs(column - COUNT / 2)) <= INNER_RING
			end
		end
		-- The grid cell under each vertex, rebuilt only when the sheet moves.
		local cellOf = table.create(size * size)
		local frameParity = 0
		local originX, originZ = math.huge, math.huge
		local probeCursor, probeDue = 0, 0
		local refreshCursor, refreshDue = 0, 0
		local coloredAt = -math.huge
		local unprobed = true
		local function cellAt(x: number, z: number)
			local k = key(x, z)
			local cell = cells[k]
			if not cell then
				cell = { x = x, z = z, wet = nil :: boolean?, amplitude = 0, shore = 0, shown = 0 }
				cells[k] = cell
			end
			return cell
		end
		local function refresh(cell, now: number, state)
			local wet, total = 0, 0
			for dz = -SHORE_REACH, SHORE_REACH do
				for dx = -SHORE_REACH, SHORE_REACH do
					local neighbour = cells[key(cell.x + dx, cell.z + dz)]
					total += 1
					if neighbour and neighbour.wet then
						wet += 1
					end
				end
			end
			-- Swells die out before the beach, so the sheet never covers sand.
			cell.shore = if cell.wet then smoothstep((wet / total - 0.6) / 0.4) else 0
			local _, amplitude =
				Weather.heightAt(Vector3.new(cell.x * SPACING, Biomes.WaterLevel, cell.z * SPACING), now, state)
			cell.amplitude = amplitude
		end

		RunService.RenderStepped:Connect(function(dt: number)
			local camera = workspace.CurrentCamera
			local cameraPosition = camera and camera.CFrame.Position
			if
				not WaterQuality.layeredEnabled()
				or not cameraPosition
				or cameraPosition.Y < Biomes.WaterLevel - 0.5
				or cameraPosition.Y > Biomes.WaterLevel + 180
				or not Biomes.inOceanBounds(cameraPosition)
			then
				part.LocalTransparencyModifier = 1
				return
			end
			if part.LocalTransparencyModifier ~= 0 then
				part.LocalTransparencyModifier = 0
			end
			local now = workspace:GetServerTimeNow()
			local state = Weather.getState(now)
			local centerX = math.round(cameraPosition.X / SPACING)
			local centerZ = math.round(cameraPosition.Z / SPACING)
			local firstX, firstZ = centerX - COUNT / 2, centerZ - COUNT / 2
			local moved = false
			if firstX ~= originX or firstZ ~= originZ then
				originX, originZ = firstX, firstZ
				-- The part just moved a cell: every vertex must be rewritten this frame.
				moved = true
				unprobed = true
				part.CFrame = CFrame.new(centerX * SPACING, Biomes.WaterLevel, centerZ * SPACING)
				table.clear(flat)
				-- Forget cells the sheet left; keep a shore-reach border for the taper.
				for k, cell in cells do
					if
						cell.x < firstX - SHORE_REACH
						or cell.x > firstX + COUNT + SHORE_REACH
						or cell.z < firstZ - SHORE_REACH
						or cell.z > firstZ + COUNT + SHORE_REACH
					then
						cells[k] = nil
					end
				end
			end
			if now - coloredAt >= 2 then
				coloredAt = now
				local water = terrain.WaterColor:Lerp(Color3.fromRGB(160, 205, 210), 0.18)
				if water ~= color then
					color = water
					part.Color = water
					for index = 1, size * size do
						mesh:SetColor(colors[index], water)
					end
				end
			end

			-- Wet probes: unknown cells first (teleport, new rows), then a slow sweep.
			local span = COUNT + 1 + SHORE_REACH * 2
			local filtered = false
			local fresh = 0
			for row = -SHORE_REACH, if unprobed then COUNT + SHORE_REACH else -SHORE_REACH - 1 do
				for column = -SHORE_REACH, COUNT + SHORE_REACH do
					local cell = cellAt(firstX + column, firstZ + row)
					if cell.wet == nil and fresh < FIRST_PROBES_PER_FRAME then
						if not filtered then
							filtered = true
							refreshFilter()
						end
						cell.wet = isWater(cell.x * SPACING, cell.z * SPACING)
						refresh(cell, now, state)
						fresh += 1
					end
				end
			end
			unprobed = fresh >= FIRST_PROBES_PER_FRAME
			probeDue = math.min(probeDue + span * span * dt / WATER_CHECK_INTERVAL, SWEEP_PROBES_PER_FRAME)
			while probeDue >= 1 do
				probeDue -= 1
				probeCursor = probeCursor % (span * span) + 1
				local row, column = (probeCursor - 1) // span - SHORE_REACH, (probeCursor - 1) % span - SHORE_REACH
				local cell = cellAt(firstX + column, firstZ + row)
				if not filtered then
					filtered = true
					refreshFilter()
				end
				cell.wet = isWater(cell.x * SPACING, cell.z * SPACING)
			end
			refreshDue = math.min(refreshDue + size * size * dt / AMPLITUDE_REFRESH, AMPLITUDE_REFRESHES_PER_FRAME)
			while refreshDue >= 1 do
				refreshDue -= 1
				refreshCursor = refreshCursor % (size * size) + 1
				local row, column = (refreshCursor - 1) // size, (refreshCursor - 1) % size
				refresh(cellAt(firstX + column, firstZ + row), now, state)
			end

			-- Each nearby hull caps the water inside its footprint below its sole.
			local caps = {}
			local boats = workspace:FindFirstChild("PlayerBoats")
			if boats then
				for _, boat in boats:GetChildren() do
					if not boat:IsA("Model") then
						continue
					end
					local frame, extents = hullBox(boat)
					local reach = extents.Magnitude / 2 + HULL_MARGIN
					if (frame.Position - cameraPosition).Magnitude > HALF * 1.5 + reach then
						continue
					end
					local sole = frame.Position.Y - extents.Y / 2 + 0.5
					local root = boat.PrimaryPart
					local floor, offset = boat:GetAttribute("DryFloorHeight"), boat:GetAttribute("WaterlineRootOffset")
					if root and type(floor) == "number" and typeof(offset) == "Vector3" then
						local pose = root.CFrame
						local center = pose:PointToWorldSpace(Vector3.new(0, floor, 0) - offset)
						sole = center.Y
							- math.abs(pose.RightVector.Y) * (boat:GetAttribute("DryFloorHalfBeam") or 0)
							- math.abs(pose.LookVector.Y) * (boat:GetAttribute("DryFloorHalfLength") or 0)
					end
					local cap = sole - HULL_CLEARANCE - Biomes.WaterLevel
					local halfX, halfZ = extents.X / 2 + HULL_MARGIN, extents.Z / 2 + HULL_MARGIN
					local fromX = math.max(0, math.floor((frame.Position.X - reach) / SPACING) - firstX)
					local toX = math.min(COUNT, math.ceil((frame.Position.X + reach) / SPACING) - firstX)
					local fromZ = math.max(0, math.floor((frame.Position.Z - reach) / SPACING) - firstZ)
					local toZ = math.min(COUNT, math.ceil((frame.Position.Z + reach) / SPACING) - firstZ)
					for row = fromZ, toZ do
						for column = fromX, toX do
							local point =
								Vector3.new((firstX + column) * SPACING, frame.Position.Y, (firstZ + row) * SPACING)
							local relative = frame:PointToObjectSpace(point)
							if math.abs(relative.X) <= halfX and math.abs(relative.Z) <= halfZ then
								local index = row * size + column + 1
								caps[index] = math.min(caps[index] or math.huge, cap)
							end
						end
					end
				end
			end

			local profiling = debug.profilebegin ~= nil -- absent in test runners
			if profiling then
				debug.profilebegin("SwellSurface/Vertices")
			end
			if cellOf[1] == nil or cellOf[1].x ~= firstX or cellOf[1].z ~= firstZ then
				for row = 0, COUNT do
					for column = 0, COUNT do
						cellOf[row * size + column + 1] = cellAt(firstX + column, firstZ + row)
					end
				end
			end
			frameParity = 1 - frameParity
			local direction = state.windDirection
			local ease = 1 - math.exp(-dt * 4)
			-- Outer vertices skip every other frame, so they ease by two frames' worth.
			local outerEase = 1 - math.exp(-dt * 8)
			for row = 0, COUNT do
				for column = 0, COUNT do
					local index = row * size + column + 1
					local cell = cellOf[index]
					if not inner[index] and not moved then
						if (row + column) % 2 ~= frameParity then
							continue
						end
						cell.shown += (cell.shore - cell.shown) * outerEase
					else
						cell.shown += (cell.shore - cell.shown) * ease
					end
					local amplitude = cell.amplitude * cell.shown * edges[index]
					if amplitude < FLAT_AMPLITUDE then
						if not flat[index] then
							flat[index] = true
							local y = if cell.shown < 0.01 then SUNKEN else -CALM_DEPTH
							mesh:SetPosition(vertices[index], Vector3.new(localX[index], y, localZ[index]))
							mesh:SetNormal(normals[index], Vector3.yAxis)
							if alphas[index] ~= 0 then
								alphas[index] = 0
								mesh:SetColorAlpha(colors[index], 0)
							end
						end
						continue
					end
					flat[index] = false
					local unit, sx, sz = Weather.swell(cell.x * SPACING, cell.z * SPACING, now, direction)
					local height = unit * amplitude
					local cap = caps[index]
					if cap and height > cap then
						height = cap
					end
					local alpha = smoothstep((height - FADE_FROM) / FADE_HEIGHT)
					-- Land cells drop out of sight beneath the shore. Hidden vertices (troughs and
					-- swell too low to fade in) sink so no stretch of the sheet lies on Terrain's
					-- surface; visible crests keep the exact height the hulls ride.
					local y = if cell.shown < 0.01
						then SUNKEN
						elseif alpha == 0 then math.min(height, 0) - CALM_DEPTH
						else height
					mesh:SetPosition(vertices[index], Vector3.new(localX[index], y, localZ[index]))
					mesh:SetNormal(normals[index], Vector3.new(-amplitude * sx, 1, -amplitude * sz).Unit)
					if math.abs(alpha - alphas[index]) > 0.02 or (alpha == 0) ~= (alphas[index] == 0) then
						alphas[index] = alpha
						mesh:SetColorAlpha(colors[index], alpha)
					end
				end
			end
			if profiling then
				debug.profileend()
			end
		end)
	end)
end

return SwellSurface
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="366">
          <Properties>
            <string name="Name">TerrainProbe</string>
            <string name="Source"><![CDATA[-- Terrain questions answered from voxels instead of raycasts.
--
-- A raycast that touches a terrain chunk this client has never queried makes the engine
-- build that chunk's collision shape first (RaycastTerrain > generateShape > buildKDTree in
-- the MicroProfiler): tens of milliseconds in one frame, and render loops probing new water
-- around a moving camera hit fresh chunks constantly. ReadVoxels reads the streamed voxel
-- grid directly and never builds collision, so per-frame probes go through here.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Biomes = require(ReplicatedStorage.Shared.Biomes)

local TerrainProbe = {}

local RESOLUTION = 4
local terrain = workspace.Terrain
local AIR, WATER = Enum.Material.Air, Enum.Material.Water

local function cell(value: number): number
	return math.floor(value / RESOLUTION) * RESOLUTION
end

-- One voxel column at (x, z) from y `low` up to `high`, top-down: (materials, occupancies,
-- top of the column) or nil when the read fails.
local function column(x: number, z: number, low: number, high: number)
	local x0, z0 = cell(x), cell(z)
	local y0, y1 = cell(low), cell(high) + RESOLUTION
	local ok, materials, occupancies = pcall(function()
		return terrain:ReadVoxels(
			Region3.new(Vector3.new(x0, y0, z0), Vector3.new(x0 + RESOLUTION, y1, z0 + RESOLUTION)),
			RESOLUTION
		)
	end)
	if not ok or not materials then
		return nil
	end
	return materials[1], occupancies[1], y1
end

-- Approximate the top terrain surface in a vertical range, to four-stud voxel
-- precision. Audio only needs water/land and roof presence; casting rays for
-- those estimates builds collision for fresh chunks as the listener travels.
-- Missing streamed terrain (air) and failed reads both return nil.
function TerrainProbe.surfaceAt(
	x: number, z: number, low: number, high: number, ignoreWater: boolean?
): (Enum.Material?, number?)
	local materials, occupancies, top = column(x, z, low, high)
	if not materials then
		return nil, nil
	end
	for index = #materials, 1, -1 do
		local material = materials[index][1]
		if material ~= AIR and not (ignoreWater and material == WATER) then
			local base = top - (#materials - index + 1) * RESOLUTION
			local height = base + RESOLUTION * occupancies[index][1]
			if height >= low then
				return material, math.min(height, high)
			end
		end
	end
	return nil, nil
end

-- True when the voxel just under the calm surface at (x, z) is water.
function TerrainProbe.isWater(x: number, z: number): boolean
	local y = Biomes.WaterLevel - RESOLUTION / 2
	local materials = column(x, z, y, y)
	return materials ~= nil and materials[1][1] == WATER
end

-- Height of the first solid voxel below the surface at (x, z), scanning down to `bottom`.
-- Returns nil when the surface itself isn't water (dry land, outside the streamed area).
function TerrainProbe.floorBelow(x: number, z: number, bottom: number): number?
	local surface = Biomes.WaterLevel - RESOLUTION / 2
	local materials, occupancies, top = column(x, z, bottom, surface)
	if not materials then
		return nil
	end
	local cells = materials[1] and #materials or 0
	if cells == 0 then
		return nil
	end
	-- Index 1 is the bottom cell; walk from the top down.
	if materials[cells][1] ~= WATER then
		return nil
	end
	for index = cells - 1, 1, -1 do
		local material = materials[index][1]
		if material ~= WATER and material ~= AIR then
			-- Occupancy approximates how far the smooth surface rises within the cell.
			local base = top - (cells - index + 1) * RESOLUTION
			return base + RESOLUTION * occupancies[index][1]
		end
	end
	return bottom
end

-- The seabed under (x, z) from one 3x3-column voxel read: (floor height, surface normal from
-- the neighbouring columns, surface) where surface is "water" (floor found or scanned down to
-- `bottom`), "land" (solid terrain at the waterline) or "unknown" (air there: not streamed in).
-- The floor is nil unless the surface is water and solid ground lies above `bottom`.
function TerrainProbe.seabed(x: number, z: number, bottom: number): (number?, Vector3?, string)
	local surface = Biomes.WaterLevel - RESOLUTION / 2
	local x0, z0 = cell(x) - RESOLUTION, cell(z) - RESOLUTION
	local y0, y1 = cell(bottom), cell(surface) + RESOLUTION
	local ok, materials, occupancies = pcall(function()
		return terrain:ReadVoxels(
			Region3.new(Vector3.new(x0, y0, z0), Vector3.new(x0 + 3 * RESOLUTION, y1, z0 + 3 * RESOLUTION)),
			RESOLUTION
		)
	end)
	if not ok or not materials or not materials[2] or not materials[2][1] then
		return nil, nil, "unknown"
	end
	local cells = #materials[2]
	local top = materials[2][cells][2]
	if top == AIR then
		return nil, nil, "unknown"
	elseif top ~= WATER then
		return nil, nil, "land"
	end
	local function floorAt(ix: number, iz: number): number?
		local column = materials[ix]
		if not column then
			return nil
		end
		for index = cells - 1, 1, -1 do
			local material = column[index][iz]
			if material ~= WATER and material ~= AIR then
				return y1 - (cells - index + 1) * RESOLUTION + RESOLUTION * occupancies[ix][index][iz]
			end
		end
		return nil
	end
	local floor = floorAt(2, 2)
	if not floor then
		return nil, nil, "water"
	end
	local left, right = floorAt(1, 2) or floor, floorAt(3, 2) or floor
	local back, front = floorAt(2, 1) or floor, floorAt(2, 3) or floor
	-- Heights 2 cells apart: normal ∝ (-dh/dx, 1, -dh/dz)
	local normal = Vector3.new(left - right, 2 * RESOLUTION, back - front).Unit
	return floor, normal, "water"
end

return TerrainProbe
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="367">
          <Properties>
            <string name="Name">Tutorial</string>
            <string name="Source"><![CDATA[-- The island tutorial on the client: the guide dialogue, the goal tracker, and the arrows that lead
-- to whoever is next (a marker above the guide plus a 3D arrow beside the player). Progress comes
-- from the TutorialStep/TutorialDone attributes; the server saves a step only after the player
-- finishes talking to the right guide.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Theme = require(game:GetService("ReplicatedFirst"):WaitForChild("UITheme"))
local Tutorial = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Tutorial"))

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end

local Client = {}
local started = false

local GOLD = Color3.fromRGB(255, 205, 64)
local PROMPT = "TutorialNpcPrompt"
local GUIDE_TAG = "TutorialGuide"
local TYPE_SPEED = 70 -- characters per second
local WALK_AWAY = 18 -- studs from the guide before an open dialogue closes
local TURN_RANGE = 14 -- guides turn to face the player inside this distance
local ARROW_HIDE = 14 -- the 3D arrow gives way to the marker this close to the guide

local function label(parent: Instance, props): TextLabel
	local item = Instance.new("TextLabel")
	item.BackgroundTransparency = 1
	item.TextWrapped = true
	for key, value in props do
		item[key] = value
	end
	Theme.text(item, props.TextColor3)
	item.Font = props.Font or Enum.Font.GothamBold
	item.Parent = parent
	return item
end

-- A flat chevron arrow of neon parts, pointing along its pivot's look vector.
local function arrowModel(): Model
	local model = Instance.new("Model")
	model.Name = "TutorialArrow"
	local function piece(size: Vector3, frame: CFrame): Part
		local part = Instance.new("Part")
		part.Size = size
		part.CFrame = frame
		part.Color = GOLD
		part.Material = Enum.Material.Neon
		part.Anchored = true
		part.CanCollide, part.CanQuery, part.CanTouch = false, false, false
		part.CastShadow = false
		part.Parent = model
		return part
	end
	-- Shaft behind the tip at -z, and two barbs sweeping back from the tip
	piece(Vector3.new(0.5, 0.25, 2.6), CFrame.new(0, 0, 0.2))
	for _, side in { -1, 1 } do
		piece(Vector3.new(0.5, 0.25, 1.7), CFrame.new(side * 0.5, 0, -1) * CFrame.Angles(0, side * math.rad(40), 0))
	end
	model.WorldPivot = CFrame.new()
	return model
end

function Client.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local state = ReplicatedStorage:WaitForChild("Tutorial")
	local remote = state:WaitForChild("Request") :: RemoteEvent

	local gui = Instance.new("ScreenGui")
	gui.Name = "Tutorial"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 24
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	------------------------------------------------------------------------------------------------
	-- Goal tracker

	local tracker = Instance.new("Frame")
	tracker.Name = "Tracker"
	tracker.AnchorPoint = Vector2.new(0.5, 0)
	tracker.Position = UDim2.new(0.5, 0, 0, 8)
	tracker.Size = UDim2.new(0.9, 0, 0, 58)
	tracker.Visible = false
	tracker.Parent = gui
	Theme.glassPanel(tracker)
	Theme.corner(tracker, 8)
	local trackerBounds = Instance.new("UISizeConstraint")
	trackerBounds.MaxSize = Vector2.new(460, 58)
	trackerBounds.Parent = tracker
	local heading = label(tracker, {
		Name = "Heading",
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -110, 0, 16),
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = GOLD,
		Text = "TUTORIAL",
	})
	local goal = label(tracker, {
		Name = "Goal",
		Position = UDim2.fromOffset(12, 23),
		Size = UDim2.new(1, -110, 0, 30),
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Font = Enum.Font.GothamMedium,
	})
	local skip = Instance.new("TextButton")
	skip.Name = "Skip"
	skip.AnchorPoint = Vector2.new(1, 0.5)
	skip.Position = UDim2.new(1, -8, 0.5, 0)
	skip.Size = UDim2.fromOffset(88, 30)
	skip.Text = "Skip"
	skip.TextSize = 13
	skip.TextWrapped = true
	skip.Parent = tracker
	Theme.button(skip)
	local confirmSkip = false
	skip.Activated:Connect(function()
		if not confirmSkip then
			confirmSkip = true
			skip.Text = "Sure? Skip"
			Theme.button(skip, "Danger")
			task.delay(4, function()
				if confirmSkip then
					confirmSkip = false
					skip.Text = "Skip"
					Theme.button(skip)
				end
			end)
			return
		end
		confirmSkip = false
		skip.Text = "Skip"
		Theme.button(skip)
		remote:FireServer("Skip")
	end)

	------------------------------------------------------------------------------------------------
	-- Toast

	local toast = label(gui, {
		Name = "TutorialNotice",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 74),
		Size = UDim2.new(0.86, 0, 0, 44),
		TextSize = 15,
		Font = Enum.Font.GothamMedium,
		Visible = false,
		ZIndex = 5,
	})
	toast.BackgroundTransparency = 0.06
	Theme.panel(toast, false, 6)
	toast.BackgroundColor3 = Theme.Colors.Window
	local toastBounds = Instance.new("UISizeConstraint")
	toastBounds.MaxSize = Vector2.new(520, 44)
	toastBounds.Parent = toast
	local toastId = 0
	local function notice(message: string)
		toastId += 1
		local current = toastId
		toast.Text, toast.Visible = message, true
		task.delay(6, function()
			if toastId == current then
				toast.Visible = false
			end
		end)
	end

	------------------------------------------------------------------------------------------------
	-- Dialogue

	local dialogue = Instance.new("Frame")
	dialogue.Name = "Dialogue"
	dialogue.AnchorPoint = Vector2.new(0.5, 1)
	dialogue.Position = UDim2.new(0.5, 0, 1, -24)
	dialogue.Size = UDim2.new(0.92, 0, 0, 168)
	dialogue.Visible = false
	dialogue.Active = true
	dialogue.ZIndex = 10
	dialogue.Parent = gui
	Theme.window(dialogue)
	local dialogueBounds = Instance.new("UISizeConstraint")
	dialogueBounds.MaxSize = Vector2.new(640, 168)
	dialogueBounds.Parent = dialogue
	local speaker = label(dialogue, {
		Name = "Speaker",
		Position = UDim2.fromOffset(20, 14),
		Size = UDim2.new(1, -40, 0, 22),
		TextSize = 19,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = GOLD,
		RichText = true,
		ZIndex = 11,
	})
	local line = label(dialogue, {
		Name = "Line",
		Position = UDim2.fromOffset(20, 42),
		Size = UDim2.new(1, -40, 1, -98),
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Font = Enum.Font.GothamMedium,
		ZIndex = 11,
	})
	local pageCount = label(dialogue, {
		Name = "Page",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 20, 1, -18),
		Size = UDim2.fromOffset(80, 20),
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Colors.Muted,
		ZIndex = 11,
	})
	local nextButton = Instance.new("TextButton")
	nextButton.Name = "Next"
	nextButton.AnchorPoint = Vector2.new(1, 1)
	nextButton.Position = UDim2.new(1, -16, 1, -14)
	nextButton.Size = UDim2.fromOffset(120, 36)
	nextButton.TextSize = 16
	nextButton.ZIndex = 11
	nextButton.Parent = dialogue
	Theme.button(nextButton, "Selected")
	local closeButton = Instance.new("TextButton")
	closeButton.Name = "Close"
	closeButton.AnchorPoint = Vector2.new(1, 1)
	closeButton.Position = UDim2.new(1, -144, 1, -14)
	closeButton.Size = UDim2.fromOffset(84, 36)
	closeButton.Text = "Bye"
	closeButton.TextSize = 15
	closeButton.ZIndex = 11
	closeButton.Parent = dialogue
	Theme.button(closeButton)

	local talking: { npc: string, lines: { string }, page: number, current: boolean, typed: number }? = nil
	local typing = 0

	local function closeDialogue()
		talking = nil
		dialogue.Visible = false
	end

	local function showPage()
		local chat = talking
		if not chat then
			return
		end
		local text = chat.lines[chat.page]
		line.Text = text
		line.MaxVisibleGraphemes = 0
		chat.typed = 0
		pageCount.Text = chat.page .. " / " .. #chat.lines
		nextButton.Text = if chat.page < #chat.lines then "Next" else (if chat.current then "Got it!" else "Bye")
		closeButton.Visible = chat.page < #chat.lines
		typing += 1
		local generation = typing
		task.spawn(function()
			local length = utf8.len(text) or #text
			local shown = 0
			while talking == chat and generation == typing and shown < length do
				shown = math.min(length, shown + math.max(1, math.floor(TYPE_SPEED * task.wait())))
				line.MaxVisibleGraphemes = shown
			end
			if generation == typing then
				line.MaxVisibleGraphemes = -1
			end
		end)
	end

	local function advance()
		local chat = talking
		if not chat then
			return
		end
		-- The first press finishes the line being typed.
		if line.MaxVisibleGraphemes ~= -1 then
			typing += 1
			line.MaxVisibleGraphemes = -1
			return
		end
		if chat.page < #chat.lines then
			chat.page += 1
			showPage()
			return
		end
		closeDialogue()
		if chat.current then
			remote:FireServer("Finish", chat.npc)
		end
	end

	local function openDialogue(npcId: string)
		local npc = Tutorial.Npcs[npcId]
		if not npc then
			return
		end
		local lines, current =
			Tutorial.dialogue(npcId, player:GetAttribute("TutorialStep"), player:GetAttribute("TutorialDone"))
		if #lines == 0 then
			return
		end
		talking = { npc = npcId, lines = lines, page = 1, current = current, typed = 0 }
		speaker.Text = npc.Name .. '  <font color="#D7D7D7" size="14">' .. npc.Title .. "</font>"
		dialogue.Visible = true
		showPage()
	end

	nextButton.Activated:Connect(advance)
	closeButton.Activated:Connect(closeDialogue)
	dialogue.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			if line.MaxVisibleGraphemes ~= -1 then
				advance()
			end
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not talking or UserInputService:GetFocusedTextBox() then
			return
		end
		if input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.ButtonA then
			advance()
		elseif not processed and input.KeyCode == Enum.KeyCode.Escape then
			closeDialogue()
		end
	end)

	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		if prompt.Name == PROMPT and not talking then
			local id = prompt:GetAttribute("NpcId")
			if type(id) == "string" then
				openDialogue(id)
			end
		end
	end)

	remote.OnClientEvent:Connect(function(kind, value)
		if kind == "Finished" then
			notice(
				if type(value) == "number" and value > 0
					then "Tutorial complete! +$" .. value .. " · Type /tutorial to replay it."
					else "Tutorial complete! Type /tutorial to replay it any time."
			)
		elseif kind == "Notice" and type(value) == "string" then
			closeDialogue()
			notice(value)
		end
	end)

	------------------------------------------------------------------------------------------------
	-- Arrows

	local marker = Instance.new("Part")
	marker.Name = "TutorialMarker"
	marker.Size = Vector3.new(0.2, 0.2, 0.2)
	marker.Transparency = 1
	marker.Anchored = true
	marker.CanCollide, marker.CanQuery, marker.CanTouch = false, false, false
	local markerGui = Instance.new("BillboardGui")
	markerGui.Name = "TutorialMarker"
	markerGui.Size = UDim2.fromOffset(150, 96)
	markerGui.AlwaysOnTop = true
	markerGui.LightInfluence = 0
	markerGui.MaxDistance = math.huge
	markerGui.Adornee = marker
	markerGui.Enabled = false
	markerGui.ResetOnSpawn = false
	-- Billboards only draw from PlayerGui itself, not from inside a ScreenGui.
	markerGui.Parent = gui.Parent
	local markerName = label(markerGui, {
		Name = "Name",
		Size = UDim2.new(1, 0, 0, 18),
		TextSize = 15,
		TextColor3 = GOLD,
	})
	local markerDistance = label(markerGui, {
		Name = "Distance",
		Position = UDim2.fromOffset(0, 18),
		Size = UDim2.new(1, 0, 0, 16),
		TextSize = 13,
		Font = Enum.Font.GothamMedium,
	})
	local markerArrow = label(markerGui, {
		Name = "Arrow",
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, 0, 0, 60),
		TextSize = 54,
		TextColor3 = GOLD,
		Text = "▼",
	})

	local arrow = arrowModel()

	local function targetId(): string?
		local step = player:GetAttribute("TutorialStep")
		if player:GetAttribute("TutorialDone") ~= false or type(step) ~= "number" then
			return nil
		end
		local current = Tutorial.Steps[step]
		return current and current.Npc
	end

	local function refreshTracker()
		local id = targetId()
		tracker.Visible = id ~= nil
		if not id then
			return
		end
		local step = player:GetAttribute("TutorialStep")
		heading.Text = string.format("TUTORIAL  %d / %d", step, #Tutorial.Steps)
		goal.Text = Tutorial.Steps[step].Goal
		markerName.Text = Tutorial.Npcs[id].Name
	end
	player:GetAttributeChangedSignal("TutorialStep"):Connect(refreshTracker)
	player:GetAttributeChangedSignal("TutorialDone"):Connect(refreshTracker)
	refreshTracker()

	-- Guides turn their heads (and bodies) to whoever walks up, locally for each player.
	local function turnGuides(root: BasePart, dt: number)
		for _, guide in CollectionService:GetTagged(GUIDE_TAG) do
			local home = guide:GetAttribute("HomeFrame")
			if not guide:IsA("Model") or typeof(home) ~= "CFrame" or not guide:IsDescendantOf(workspace) then
				continue
			end
			local pivot = guide:GetPivot()
			local offset = Vector3.new(root.Position.X - home.X, 0, root.Position.Z - home.Z)
			local wanted = home
			if offset.Magnitude < TURN_RANGE and offset.Magnitude > 0.5 then
				wanted = CFrame.lookAt(home.Position, home.Position + offset)
			end
			if
				pivot.LookVector:Dot(wanted.LookVector) < 0.9995
				or (pivot.Position - home.Position).Magnitude > 0.01
			then
				guide:PivotTo(pivot:Lerp(wanted, math.min(1, dt * 6)))
			end
		end
	end

	local clock = 0
	RunService.RenderStepped:Connect(profiled("Tutorial", function(dt)
		clock += dt
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root or not root:IsA("BasePart") then
			markerGui.Enabled = false
			arrow.Parent = nil
			return
		end
		turnGuides(root, dt)

		local chat = talking
		if chat then
			local position = state:GetAttribute("Npc_" .. chat.npc)
			if typeof(position) == "Vector3" and (root.Position - position).Magnitude > WALK_AWAY then
				closeDialogue()
			end
		end

		local id = targetId()
		local position = id and state:GetAttribute("Npc_" .. id)
		if typeof(position) ~= "Vector3" then
			markerGui.Enabled = false
			arrow.Parent = nil
			return
		end
		local bob = math.sin(clock * 4) * 0.6
		marker.CFrame = CFrame.new(position + Vector3.new(0, 8.5 + bob, 0))
		if not marker.Parent then
			marker.Parent = workspace
		end
		local distance = (root.Position - position).Magnitude
		markerDistance.Text = string.format("%d studs", math.floor(distance + 0.5))
		markerArrow.Position = UDim2.fromOffset(0, 32 + bob * 4)
		markerGui.Enabled = not talking

		local flat = Vector3.new(position.X - root.Position.X, 0, position.Z - root.Position.Z)
		if talking or distance < ARROW_HIDE or flat.Magnitude < 1 then
			arrow.Parent = nil
			return
		end
		local direction = flat.Unit
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local feet = root.Position.Y - (if humanoid then humanoid.HipHeight else 2) - root.Size.Y / 2
		local base = Vector3.new(root.Position.X, feet + 0.6 + math.sin(clock * 5) * 0.12, root.Position.Z)
		arrow:PivotTo(CFrame.lookAt(base + direction * 4.2, base + direction * 5.2))
		if not arrow.Parent then
			arrow.Parent = workspace
		end
	end))
end

return Client
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="368">
          <Properties>
            <string name="Name">VolumetricClouds</string>
            <string name="Source"><![CDATA[-- Every rainy player gets an overlapping volumetric cloud deck overhead.
-- Soft billowed cloud building blocks for the supercell (SupercellWeather) and
-- the rain deck that hangs under it. The rest of the sky is Terrain.Clouds and
-- the Atmosphere (BiomeAtmosphere): the old distant cloud field of particle
-- billows cost too much frame time and is gone.
--
-- Clouds are soft billows, not solid shapes: a few invisible anchor parts per
-- cloud each carry a particle emitter that keeps a set of camera-facing puffs
-- alive inside its volume. Only the big rain-bearing pieces keep an opaque core,
-- so rain never shows sky through gaps between puffs.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Biomes = require(ReplicatedStorage.Shared.Biomes)
local Weather = require(ReplicatedStorage.Shared.Weather)

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end

local Clouds = {}
local started = false
local TAU = math.pi * 2
local FADE_SECONDS = 4
local MAX_PART_SIZE = 2048
local CANOPY_CELL = 360
local CANOPY_WIDTH = 760
local CANOPY_HEIGHT = 300
local CANOPY_LIMIT = 36
-- The deck only hangs where the supercell covers the sky at least this much.
local CANOPY_SUPERCELL = 0.05
local BILLOW_TEXTURE = "rbxasset://textures/particles/smoke_main.dds"
-- Particle sprites stay at or under 100 studs; bigger clouds use more of them.
local BILLOW_MAX = 100
-- Each billow lives this long, so a cloud slowly churns as old puffs fade out
-- and new ones fade in, and a retired cloud dissolves instead of popping.
local BILLOW_LIFE = { 10, 16 }

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- Same integer mixing as Weather: tile layouts must not shimmer between frames.
local function hash(a: number, b: number, c: number): number
	local h = 2166136
	for _, value in { a, b, c } do
		h = (h * 31 + math.floor(value) % 1000003) % 2147483647
		h = (h * 48271) % 2147483647
	end
	return h / 2147483647
end
local function clampedSize(size: Vector3): Vector3
	return Vector3.new(
		math.min(size.X, MAX_PART_SIZE),
		math.min(size.Y, MAX_PART_SIZE),
		math.min(size.Z, MAX_PART_SIZE)
	)
end

-- An anchored, non-interactive ellipsoid: the opaque core of a big cloud. Parts
-- stop at 2048 studs, so larger cores (anvils) stretch their mesh instead.
function Clouds.puff(parent: Instance, color: Color3, size: Vector3, castShadow: boolean): Part
	local part = Instance.new("Part")
	part.Name = "CloudPuff"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = castShadow
	part.Material = Enum.Material.SmoothPlastic
	part.Reflectance = 0
	part.Color = color
	local clamped = clampedSize(size)
	part.Size = clamped
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = size / clamped
	mesh.Parent = part
	part.Parent = parent
	return part
end

-- An invisible volume that only holds billows. It is never drawn or queried.
function Clouds.anchor(parent: Instance, name: string, size: Vector3): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = clampedSize(size)
	part.Parent = parent
	return part
end

-- Billow transparency over a puff's life at a given opacity (0 hides them):
-- each puff fades in, holds and fades out, so births and deaths never pop.
function Clouds.billowTransparency(opacity: number): NumberSequence
	local function at(value: number): number
		return 1 - (1 - value) * opacity
	end
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, at(0.12)),
		NumberSequenceKeypoint.new(0.75, at(0.2)),
		NumberSequenceKeypoint.new(1, 1),
	})
end

-- A puff's colour drifts from `low` to `high` and back over its life; with
-- staggered lifetimes the puffs of one layer show both shades at once.
function Clouds.billowColor(low: Color3, high: Color3): ColorSequence
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, low),
		ColorSequenceKeypoint.new(0.5, high),
		ColorSequenceKeypoint.new(1, low),
	})
end

export type BillowOptions = { surface: boolean?, locked: boolean?, life: { number }? }

-- Keeps about `count` soft puffs of `size` studs alive inside `part`'s
-- ellipsoid (or on its surface). Starts disabled: call Clouds.prime once the
-- part is in place, or puffs born at the origin would linger there.
function Clouds.billows(
	part: BasePart,
	low: Color3,
	high: Color3,
	size: number,
	count: number,
	options: BillowOptions?
): ParticleEmitter
	local settings = options or {}
	local life = settings.life or BILLOW_LIFE
	local sprite = math.min(size, BILLOW_MAX)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Billows"
	emitter.Texture = BILLOW_TEXTURE
	emitter.Enabled = false
	emitter.Shape = Enum.ParticleEmitterShape.Sphere
	emitter.ShapeStyle = if settings.surface
		then Enum.ParticleEmitterShapeStyle.Surface
		else Enum.ParticleEmitterShapeStyle.Volume
	emitter.Speed = NumberRange.new(0)
	emitter.Lifetime = NumberRange.new(life[1], life[2])
	emitter.Rate = count / ((life[1] + life[2]) / 2)
	-- A puff swells a little as it lives, so the surface seems to boil slowly.
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, sprite * 0.75),
		NumberSequenceKeypoint.new(1, sprite),
	})
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-5, 5)
	emitter.Color = Clouds.billowColor(low, high)
	emitter.LightInfluence = 1
	emitter.LightEmission = 0
	emitter.LockedToPart = settings.locked == true
	emitter.Transparency = Clouds.billowTransparency(1)
	emitter:SetAttribute("Billows", count)
	emitter.Parent = part
	return emitter
end

-- Starts emitting and fills half the layer at once; the rest fades in over
-- the first few seconds, so a new cloud forms rather than appears.
function Clouds.prime(emitter: ParticleEmitter)
	emitter.Enabled = true
	emitter:Emit(math.ceil((emitter:GetAttribute("Billows") or 0) * 0.5))
end

-- A grey curtain from a cloud base to the sea, thinning towards the water.
function Clouds.shaft(anchor: BasePart, drop: number, width: number, color: Color3): Beam
	local top = Instance.new("Attachment")
	top.Name = "ShaftTop"
	top.Parent = anchor
	local bottom = Instance.new("Attachment")
	bottom.Name = "ShaftBottom"
	bottom.Position = Vector3.new(0, -drop, 0)
	bottom.Parent = anchor
	local beam = Instance.new("Beam")
	beam.Name = "RainShaft"
	beam.Attachment0, beam.Attachment1 = top, bottom
	beam.Width0, beam.Width1 = width * 0.75, width
	beam.FaceCamera = true
	beam.Segments = 1
	beam.Color = ColorSequence.new(color)
	beam.LightInfluence = 1
	beam.LightEmission = 0
	beam.Parent = anchor
	return beam
end

-- Beam transparency for a shaft at a given opacity (0 hides it).
function Clouds.shaftTransparency(opacity: number): NumberSequence
	local function at(value: number): number
		return 1 - (1 - value) * opacity
	end
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, at(0.35)),
		NumberSequenceKeypoint.new(0.7, at(0.55)),
		NumberSequenceKeypoint.new(1, 1),
	})
end

-- A solid core part (opacity > 0) or an invisible billow anchor (opacity 0).
type RainPiece = { part: Part, frame: CFrame, shade: number, opacity: number }
type RainBillows = { emitter: ParticleEmitter, shade: { number }, opacity: number }
type RainTile = {
	model: Model,
	pieces: { RainPiece },
	billows: { RainBillows },
	wisps: ParticleEmitter,
	detailed: boolean,
	fade: number,
	appliedFade: number,
	billowFade: number,
	primed: boolean,
	base: Color3?,
	top: Color3?,
	position: Vector3,
	placed: Vector3?,
}

-- Within one 8-bit step per channel.
local function similar(a: Color3, b: Color3): boolean
	return math.abs(a.R - b.R) < 1 / 255 and math.abs(a.G - b.G) < 1 / 255 and math.abs(a.B - b.B) < 1 / 255
end

-- The broad opaque core guarantees coverage on every graphics level. Billows
-- hang below it, so looking up shows a lumpy, turbulent underside, and thin
-- ragged scud lower still breaks the deck's silhouette.
local function rainTile(i: number, j: number, seed: number, detailed: boolean, parent: Instance): RainTile
	local model = Instance.new("Model")
	model.Name = "RainCloudTile"
	local rng = Random.new(math.floor(hash(i, j, seed + 61) * 2147483646))
	local pieces: { RainPiece } = {}
	local billows: { RainBillows } = {}
	local function core(name: string, size: Vector3, offset: Vector3, shade: number)
		-- A shadow caster this size made the engine redraw shadows across the whole
		-- 760-stud tile whenever it changed. Rain already dims the light.
		local part = Clouds.puff(model, rgb(130, 140, 154), size, false)
		part.Name = name
		part.Transparency = 1
		table.insert(pieces, {
			part = part,
			frame = CFrame.new(offset) * CFrame.Angles(0, rng:NextNumber(0, TAU), 0),
			shade = shade,
			opacity = 1,
		})
	end
	local function layer(
		name: string,
		size: Vector3,
		offset: Vector3,
		shade: { number },
		opacity: number,
		puff: number,
		count: number
	)
		local part = Clouds.anchor(model, name, size)
		table.insert(pieces, { part = part, frame = CFrame.new(offset), shade = 0, opacity = 0 })
		local grey = rgb(130, 140, 154)
		local emitter = Clouds.billows(part, grey, grey, puff, count, { locked = true })
		table.insert(billows, { emitter = emitter, shade = shade, opacity = opacity })
	end
	core("RainCloudBody", Vector3.new(CANOPY_WIDTH, 126, CANOPY_WIDTH), Vector3.zero, 0.16)
	core("RainCloudCrown", Vector3.new(620, 130, 570), Vector3.new(35, 65, -20), 0.8)
	layer(
		"RainCloudBillows",
		Vector3.new(680, 80, 680),
		Vector3.new(0, -48, 0),
		{ 0.08, 0.5 },
		0.95,
		BILLOW_MAX,
		if detailed then 24 else 10
	)
	layer(
		"RainCloudScud",
		Vector3.new(560, 30, 560),
		Vector3.new(0, -96, 0),
		{ 0.22, 0.58 },
		0.55,
		60,
		if detailed then 8 else 3
	)
	local anchor = Clouds.anchor(model, "CloudWispAnchor", Vector3.new(620, 1, 620))
	table.insert(pieces, { part = anchor, frame = CFrame.new(0, -88, 0), shade = 0.4, opacity = 0 })
	local wisps = Instance.new("ParticleEmitter")
	wisps.Name = "CloudWisps"
	wisps.Texture = BILLOW_TEXTURE
	wisps.Enabled = false
	wisps.Rate = if detailed then 2 else 0.5
	wisps.Lifetime = NumberRange.new(6, 10)
	wisps.Speed = NumberRange.new(2, 5)
	wisps.EmissionDirection = Enum.NormalId.Bottom
	wisps.SpreadAngle = Vector2.new(45, 45)
	wisps.LightInfluence, wisps.LightEmission = 0.3, 0.04
	wisps.Rotation, wisps.RotSpeed = NumberRange.new(0, 360), NumberRange.new(-8, 8)
	wisps.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 64), NumberSequenceKeypoint.new(1, BILLOW_MAX) })
	wisps.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, 0.65),
		NumberSequenceKeypoint.new(0.7, 0.74),
		NumberSequenceKeypoint.new(1, 1),
	})
	wisps.Parent = anchor
	model.Parent = parent
	return {
		model = model,
		pieces = pieces,
		billows = billows,
		wisps = wisps,
		detailed = detailed,
		fade = 0,
		appliedFade = -1,
		billowFade = -1,
		primed = false,
		position = Vector3.zero,
	}
end

local function startRainCanopy(player: Player)
	local folder: Folder? = nil
	local tiles: { [string]: RainTile } = {}
	local parts: { BasePart }, frames: { CFrame } = {}, {}
	local colorElapsed = 1
	local function clear()
		if folder then
			folder:Destroy()
			folder = nil
		end
		table.clear(tiles)
	end
	-- Entering the supercell rain or teleporting under it gets coverage in the
	-- same rendered frame. Low graphics reduce detail, never remove the deck.
	RunService.RenderStepped:Connect(profiled("VolumetricClouds", function(dt: number)
		local camera = workspace.CurrentCamera
		if not camera then
			clear()
			return
		end
		local now = workspace:GetServerTimeNow()
		local state = Weather.getState(now)
		local seed = workspace:GetAttribute("WeatherSeed") or 1847
		local eye = camera.CFrame.Position
		local focuses = { eye }
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			table.insert(focuses, root.Position)
		end
		local wanted = {}
		local severity, green = 0, 0
		for _, focus in focuses do
			-- Ordinary rain is Terrain.Clouds at full cover; only the supercell
			-- keeps a volumetric deck overhead.
			local cover = Weather.supercellCover(focus, state.supercell)
			if cover < CANOPY_SUPERCELL then
				continue
			end
			local rain, storm = Weather.localConditions(focus, state)
			if rain <= 0.01 then
				continue
			end
			severity = math.max(severity, storm, rain * 0.65)
			green = math.max(green, cover)
			local ci = math.floor(focus.X / CANOPY_CELL + 0.5)
			local cj = math.floor(focus.Z / CANOPY_CELL + 0.5)
			for i = ci - 1, ci + 1 do
				for j = cj - 1, cj + 1 do
					local key = i .. "," .. j
					local height = math.max(Biomes.WaterLevel + CANOPY_HEIGHT, focus.Y + 200)
					local primary = i == ci and j == cj
					local previous = wanted[key]
					wanted[key] = {
						i = i,
						j = j,
						primary = primary or (previous and previous.primary) or false,
						height = math.max(height, if previous then previous.height else height),
					}
				end
			end
		end
		if next(wanted) and not folder then
			local created = Instance.new("Folder")
			created.Name = "RainClouds"
			created.Parent = workspace
			folder = created
		end
		local detailed = player:GetAttribute("VolumetricCloudsEnabled") == true
		local built = 0
		-- Build the tile directly above each wet focus first, at full opacity.
		-- Its 760-stud diameter covers every corner of its 360-stud grid cell.
		for _, primary in { true, false } do
			for key, request in wanted do
				if request.primary ~= primary then
					continue
				end
				local tile = tiles[key]
				if not tile or tile.detailed ~= detailed then
					if not primary and built >= 2 then
						continue
					end
					local replacement = rainTile(request.i, request.j, seed, detailed, folder :: Folder)
					replacement.fade = if primary then 1 else 0
					if tile then
						tile.model:Destroy()
					end
					tile = replacement
					tiles[key] = tile
					built += 1
				end
				tile.position = Vector3.new(request.i * CANOPY_CELL, request.height, request.j * CANOPY_CELL)
				-- An already fading neighbor becomes opaque as soon as it is
				-- the overhead tile, so grid crossings can never reveal the sky.
				if primary then
					tile.fade = 1
				end
			end
		end
		colorElapsed += dt
		local recolor = colorElapsed >= 0.15 or built > 0
		if recolor then
			colorElapsed = 0
		end
		local base = rgb(124, 134, 148):Lerp(rgb(58, 68, 82), severity):Lerp(rgb(65, 83, 75), green * 0.55)
		local top = rgb(210, 216, 225):Lerp(rgb(137, 148, 166), severity)
		table.clear(parts)
		table.clear(frames)
		local count = 0
		for _ in tiles do
			count += 1
		end
		for key, tile in tiles do
			local request = wanted[key]
			local distance = math.huge
			for _, focus in focuses do
				local delta = tile.position - Vector3.new(focus.X, tile.position.Y, focus.Z)
				distance = math.min(distance, delta.Magnitude)
			end
			local target = if request then 1 else 0
			tile.fade += math.clamp(target - tile.fade, -dt / FADE_SECONDS, dt / FADE_SECONDS)
			if not request and (tile.fade <= 0 or distance > CANOPY_CELL * 2.5 or count > CANOPY_LIMIT) then
				tile.model:Destroy()
				tiles[key] = nil
				count -= 1
				continue
			end
			local frame = CFrame.new(tile.position)
			-- Rewrite transparency and colour only when the fade or the storm
			-- shading actually changed; billows follow the fade in tenths.
			local refade = tile.fade ~= tile.appliedFade
			tile.appliedFade = tile.fade
			local reshade = recolor and (not tile.base or not similar(tile.base, base) or not similar(tile.top, top))
			if reshade then
				tile.base, tile.top = base, top
			end
			-- A tile only moves when it is built or its deck height changes.
			local move = tile.placed ~= tile.position
			tile.placed = tile.position
			for _, piece in tile.pieces do
				if move then
					table.insert(parts, piece.part)
					table.insert(frames, frame * piece.frame)
				end
				if piece.opacity == 0 then
					continue
				end
				if refade then
					piece.part.Transparency = 1 - piece.opacity * tile.fade
				end
				if reshade then
					piece.part.Color = base:Lerp(top, piece.shade)
				end
			end
			local billowFade = math.round(tile.fade * 10) / 10
			local refadeBillows = billowFade ~= tile.billowFade
			tile.billowFade = billowFade
			for _, layer in tile.billows do
				if refadeBillows then
					layer.emitter.Transparency = Clouds.billowTransparency(layer.opacity * billowFade)
				end
				if reshade then
					layer.emitter.Color =
						Clouds.billowColor(base:Lerp(top, layer.shade[1]), base:Lerp(top, layer.shade[2]))
				end
				-- Billows are locked to their anchor, so they ride along when the deck rises.
				if not tile.primed then
					Clouds.prime(layer.emitter)
				end
				layer.emitter.Enabled = request ~= nil
			end
			tile.primed = true
			tile.wisps.Enabled = request ~= nil and detailed and tile.fade > 0.5
			tile.wisps.Acceleration = state.windDirection * 0.4
			if reshade then
				tile.wisps.Color = ColorSequence.new(base:Lerp(top, 0.5))
			end
		end
		if #parts > 0 then
			workspace:BulkMoveTo(parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
		end
		if folder and next(tiles) == nil then
			clear()
		end
	end))
end

function Clouds.start()
	if started then
		return
	end
	started = true
	startRainCanopy(Players.LocalPlayer)
end

return Clouds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="369">
          <Properties>
            <string name="Name">WaterQuality</string>
            <string name="Source"><![CDATA[-- Extra water surfaces overlap Terrain's simpler water renderer at lower quality.
-- Reserve them for the high graphics tier; Terrain still supplies water and swimming.
local WaterQuality = {}
local MIN_LAYERED_QUALITY = 7
local layered = false
-- FrameRateGuard can lower PlayerSettings' preset mid-session (GraphicsTier below 3);
-- the extra layers go with it. Guarded so test fixtures without Players still load.
local gotPlayer, localPlayer = pcall(function()
	return game:GetService("Players").LocalPlayer
end)

local ok, settings = pcall(function()
	return UserSettings():GetService("UserGameSettings")
end)

if ok and settings then
	local function refresh()
		local readable, quality = pcall(function()
			return settings.SavedQualityLevel.Value
		end)
		-- Automatic (0) does not expose the engine's current quality to game scripts.
		-- Use the single Terrain surface when the rendering tier is unknown.
		layered = readable and type(quality) == "number" and quality >= MIN_LAYERED_QUALITY
	end

	refresh()
	settings:GetPropertyChangedSignal("SavedQualityLevel"):Connect(refresh)
end

function WaterQuality.layeredEnabled(): boolean
	if layered and gotPlayer and localPlayer then
		local tier = localPlayer:GetAttribute("GraphicsTier")
		if type(tier) == "number" and tier < 3 then
			return false
		end
	end
	return layered
end

return WaterQuality
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="370">
          <Properties>
            <string name="Name">WaterWaves</string>
            <string name="Source"><![CDATA[-- Local, pooled swell ribbons follow the same water samples as the boats.
-- Terrain retains swimming and small ripples; raised, soft crests give the wind
-- waves their visible height without replicating moving geometry to the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Biomes = require(ReplicatedStorage.Shared.Biomes)
local Weather = require(ReplicatedStorage.Shared.Weather)
local WaterQuality = require(script.Parent.WaterQuality)
local TerrainProbe = require(script.Parent.TerrainProbe)

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end

local WaterWaves = {}
local GRID = 7
local CELL = 40
local HALF_CREST = 19
-- Every ribbon's water mask is redone this often, a few ribbons per frame rather than the
-- whole grid at once: seven raycasts a ribbon made each full pass a frame spike. At 0.4 s
-- the masks alone cast ~840 long rays a second, and a slow frame caught up in one burst.
local WATER_CHECK_INTERVAL = 1.5
-- No frame probes more ribbons than this; the rest wait for the next frame.
local MAX_RIBBON_PROBES = 3
-- Coastline exposure samples (eight rays each) are refreshed this often, one per frame.
local COAST_REFRESH = 3
-- A camera jump this far in one frame is a teleport: every cached sample is stale.
local TELEPORT_DISTANCE = 200
-- A ribbon that a recheck finds over land (or back over water) fades over this
-- long instead of popping; switching whole crests on and off flickered along coasts.
local WET_FADE_SECONDS = 0.3
local COAST_CELL = 40
-- Clearance kept around each hull, and the shortest ribbon worth drawing after
-- one is cut back to the side of a boat.
local HULL_MARGIN = 1.5
local MIN_SEGMENT = 6
local HULL_REFRESH_INTERVAL = 0.5
type HullBounds = { root: BasePart?, offset: CFrame, frame: CFrame, size: Vector3, refreshAt: number }
local hullBounds: { [Model]: HullBounds } = {}
-- Broad rolling motion rather than rapid oscillation against the land.
local WATER_WAVE_SPEED = 8
-- The shared swell field supplies the large waves. Keep Terrain's unrelated
-- short waves small enough that they do not repeatedly cut through the crests.
local MAX_RIPPLE_SIZE = 0.18
local SURFACE_CLEARANCE = 0.12
local SURFACE_FADE_HEIGHT = 0.35
local started = false

local function smoothstep(t: number): number
	return t * t * (3 - 2 * t)
end

local function makeBeam(parent: Instance, a: Attachment, b: Attachment, name: string): Beam
	local beam = Instance.new("Beam")
	beam.Name = name
	beam.Attachment0, beam.Attachment1 = a, b
	beam.FaceCamera = false
	beam.Segments = 8
	beam.CurveSize0, beam.CurveSize1 = HALF_CREST * 2 / 3, HALF_CREST * 2 / 3
	beam.Texture = "rbxasset://textures/particles/smoke_main.dds"
	beam.TextureMode = Enum.TextureMode.Stretch
	-- The geometry already travels with the swell; the default texture scroll
	-- slides the smoke sideways across its surface.
	beam.TextureSpeed = 0
	beam.LightEmission = 0
	beam.LightInfluence = 1
	-- The foam and body share attachments. Give each layer a distinct depth so
	-- the nearly flat lake-mouth crests cannot fight each other for the surface.
	beam.ZOffset = if name == "WindCrest" then 0.12 else 0.06
	beam.Color =
		ColorSequence.new(if name == "WindSwell" then workspace.Terrain.WaterColor else Color3.fromRGB(205, 229, 230))
	beam.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.18, 0.2),
		NumberSequenceKeypoint.new(0.5, 0),
		NumberSequenceKeypoint.new(0.82, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	beam.Enabled = false
	beam.Parent = parent
	return beam
end

-- Horizontal hull footprints near the camera, as ranges on the swell grid's
-- across and along axes. The ribbons lie on the open surface, so without this
-- they draw sea and foam over an open deck that sits below the crests.
local function hullFootprints(cameraPosition: Vector3, across: Vector3, direction: Vector3, now: number)
	local footprints = {}
	local boats = workspace:FindFirstChild("PlayerBoats")
	if not boats then
		table.clear(hullBounds)
		return footprints
	end
	for boat in hullBounds do
		if boat.Parent ~= boats then hullBounds[boat] = nil end
	end
	for _, boat in boats:GetChildren() do
		if not boat:IsA("Model") then
			continue
		end
		local root = boat.PrimaryPart
		local bounds = hullBounds[boat]
		-- The hull is rigid: carry its cached box with the root every frame. Only
		-- measuring geometry needs to wait for refits and streamed-in pieces.
		if
			bounds and bounds.root == root and root
			and (root.Position - cameraPosition).Magnitude > GRID * CELL + bounds.size.Magnitude + bounds.offset.Position.Magnitude
		then
			continue
		end
		if not bounds or bounds.root ~= root or now >= bounds.refreshAt then
			local frame, size = boat:GetBoundingBox()
			bounds = {
				root = root,
				offset = if root then root.CFrame:ToObjectSpace(frame) else CFrame.identity,
				frame = frame,
				size = size,
				refreshAt = now + HULL_REFRESH_INTERVAL,
			}
			hullBounds[boat] = bounds
		end
		local frame = if root then root.CFrame * bounds.offset else bounds.frame
		local size = bounds.size
		if (frame.Position - cameraPosition).Magnitude > GRID * CELL + size.Magnitude then
			continue
		end
		local footprint = { acrossMin = math.huge, acrossMax = -math.huge, alongMin = math.huge, alongMax = -math.huge }
		for _, x in { -0.5, 0.5 } do
			for _, z in { -0.5, 0.5 } do
				local corner = frame:PointToWorldSpace(Vector3.new(size.X * x, 0, size.Z * z))
				local u, v = corner:Dot(across), corner:Dot(direction)
				footprint.acrossMin = math.min(footprint.acrossMin, u - HULL_MARGIN)
				footprint.acrossMax = math.max(footprint.acrossMax, u + HULL_MARGIN)
				footprint.alongMin = math.min(footprint.alongMin, v - HULL_MARGIN)
				footprint.alongMax = math.max(footprint.alongMax, v + HULL_MARGIN)
			end
		end
		table.insert(footprints, footprint)
	end
	return footprints
end

-- The part of a ribbon (offsets along `across` from its center) that stays
-- clear of every hull, keeping the longer open side. Nil hides the ribbon.
local function clearSpan(center: Vector3, halfWidth: number, footprints, across: Vector3, direction: Vector3)
	local from, to = -HALF_CREST, HALF_CREST
	local u, v = center:Dot(across), center:Dot(direction)
	for _, footprint in footprints do
		if footprint.alongMin > v + halfWidth or footprint.alongMax < v - halfWidth then
			continue
		end
		local low, high = footprint.acrossMin - u, footprint.acrossMax - u
		if low >= to or high <= from then
			continue
		end
		if low - from >= to - high then
			to = low
		else
			from = high
		end
		if to - from < MIN_SEGMENT then
			return nil
		end
	end
	return from, to
end

local function surfaceFrame(position: Vector3, tangent: Vector3, normal: Vector3): CFrame
	local alongSurface = (tangent - normal * tangent:Dot(normal)).Unit
	return CFrame.fromMatrix(position, alongSurface, normal:Cross(alongSurface).Unit)
end

local function lowestSurface(a: CFrame, b: CFrame, curve: number, width: number): number
	-- A cubic stays inside its four control points' height range. Include the
	-- full tilted width too: testing just the center leaves ends and edges
	-- repeatedly crossing Terrain's independently animated water surface.
	return math.min(
		a.Position.Y,
		a.Position.Y + a.RightVector.Y * curve,
		b.Position.Y - b.RightVector.Y * curve,
		b.Position.Y
	) - math.max(math.abs(a.UpVector.Y), math.abs(b.UpVector.Y)) * width / 2
end

function WaterWaves.start()
	if started then
		return
	end
	started = true
	local terrain = workspace.Terrain
	local root = Instance.new("Part")
	root.Name = "WeatherWaterWaves"
	root.Size = Vector3.one
	root.Anchored = true
	root.Transparency = 1
	root.CanCollide, root.CanTouch, root.CanQuery = false, false, false
	root.CastShadow = false
	root.Parent = workspace
	local ribbons = {}
	for row = -(GRID - 1) / 2, (GRID - 1) / 2 do
		for column = -(GRID - 1) / 2, (GRID - 1) / 2 do
			local a, b = Instance.new("Attachment"), Instance.new("Attachment")
			a.Name, b.Name = "SwellStart", "SwellEnd"
			a.Parent, b.Parent = root, root
			table.insert(ribbons, {
				row = row,
				column = column,
				a = a,
				b = b,
				water = nil :: boolean?, -- nil until probed, and again once due for a recheck
				wet = nil :: number?, -- eased mask; nil for a cell nothing has probed yet
				body = makeBeam(root, a, b, "WindSwell"),
				edge = makeBeam(root, a, b, "WindCrest"),
			})
		end
	end
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.IgnoreWater = false
	-- Characters and boats move, so the filter is rebuilt in any frame that raycasts
	local filtered = false
	local function refreshFilter()
		local excluded: { Instance } = { root, workspace.Terrain }
		for _, player in Players:GetPlayers() do
			if player.Character then
				table.insert(excluded, player.Character)
			end
		end
		local boats = workspace:FindFirstChild("PlayerBoats")
		if boats then
			table.insert(excluded, boats)
		end
		parameters.FilterDescendantsInstances = excluded
	end
	local function isWater(position: Vector3): boolean
		if not filtered then
			filtered = true
			refreshFilter()
		end
		-- Terrain from voxels (a terrain ray builds collision for unqueried chunks:
		-- buildKDTree spikes), then a ray for the island's mesh parts so water under
		-- the low-poly shore can never receive floating crests over dry land.
		if not TerrainProbe.isWater(position.X, position.Z) then
			return false
		end
		return workspace:Raycast(
			Vector3.new(position.X, Biomes.WaterLevel + 512, position.Z),
			Vector3.new(0, -512, 0),
			parameters
		) == nil
	end
	local coloredAt = -math.huge
	local lastCamera: Vector3? = nil
	local lastAcross, lastAlong = 0, 0
	local lastDirection: Vector3? = nil
	local cursor, due = 0, 0
	local half = (GRID - 1) / 2
	local coastSamples: { [string]: { exposure: number, at: number, x: number, z: number } } = {}
	local lastExposure = 1
	local function coastalExposureAt(position: Vector3, now: number): number
		local cellX, cellZ = math.floor(position.X / COAST_CELL), math.floor(position.Z / COAST_CELL)
		-- One corner (eight rays) per frame: crossing cells used to probe two or four at once.
		local refreshes = 1
		local function exposureAt(x: number, z: number): number?
			local key = tostring(x) .. ":" .. tostring(z)
			local sample = coastSamples[key]
			if (sample == nil or now - sample.at >= COAST_REFRESH) and refreshes > 0 then
				refreshes -= 1
				local center = Vector3.new(x * COAST_CELL, Biomes.WaterLevel, z * COAST_CELL)
				local wet = 0
				for index = 0, 7 do
					local angle = index * math.pi / 4
					if isWater(center + Vector3.new(math.cos(angle) * 64, 0, math.sin(angle) * 64)) then
						wet += 1
					end
				end
				sample = { exposure = math.clamp((wet - 6) / 2, 0, 1) ^ 2, at = now, x = x, z = z }
				coastSamples[key] = sample
				-- Forget corners the camera has left well behind.
				for other, old in coastSamples do
					if math.abs(old.x - cellX) > 2 or math.abs(old.z - cellZ) > 2 then
						coastSamples[other] = nil
					end
				end
			end
			return if sample then sample.exposure else nil
		end
		-- World-fixed probes keep a swaying camera from toggling the wet count.
		-- Smooth interpolation is continuous in position and slope at cell edges.
		local x = smoothstep(position.X / COAST_CELL - cellX)
		local z = smoothstep(position.Z / COAST_CELL - cellZ)
		local a, b = exposureAt(cellX, cellZ), exposureAt(cellX + 1, cellZ)
		local c, d = exposureAt(cellX, cellZ + 1), exposureAt(cellX + 1, cellZ + 1)
		-- A corner not probed yet borrows from its neighbours until its turn comes.
		local known, sum = 0, 0
		for _, value in { a or false, b or false, c or false, d or false } do
			if value then
				known += 1
				sum += value
			end
		end
		local fill = if known > 0 then sum / known else lastExposure
		a, b, c, d = a or fill, b or fill, c or fill, d or fill
		local near, far = a + (b - a) * x, c + (d - c) * x
		lastExposure = near + (far - near) * z
		return lastExposure
	end
	-- Every frame: throttled updates stepped the crests visibly against the camera.
	RunService.RenderStepped:Connect(profiled("WaterWaves", function(dt: number)
		local step = dt
		local camera = workspace.CurrentCamera
		if not camera then
			table.clear(hullBounds)
			for _, ribbon in ribbons do
				ribbon.body.Enabled, ribbon.edge.Enabled = false, false
			end
			return
		end
		local now = workspace:GetServerTimeNow()
		local state = Weather.getState(now, camera.CFrame.Position)
		local cameraPosition = camera.CFrame.Position
		-- The engine derives wave phase from elapsed time * speed, so any change in
		-- speed (gusts, coastal exposure) jumps every ripple. Wind shows in the size.
		if terrain.WaterWaveSpeed ~= WATER_WAVE_SPEED then
			terrain.WaterWaveSpeed = WATER_WAVE_SPEED
		end
		local direction = Vector3.new(state.windDirection.X, 0, state.windDirection.Z)
		direction = if direction.Magnitude > 0.001 then direction.Unit else Vector3.xAxis
		local across = Vector3.new(-direction.Z, 0, direction.X)
		local projected = Vector3.new(cameraPosition.X, Biomes.WaterLevel, cameraPosition.Z)
		local acrossOrigin = math.floor(projected:Dot(across) / CELL + 0.5) * CELL
		-- World-space rows move continuously with the wind. Recenter by a whole
		-- cell, keeping neighboring pooled crests in the same repeating grid.
		local travel = (now * Weather.components[1].speed) % CELL
		local alongOrigin = math.floor((projected:Dot(direction) - travel) / CELL + 0.5) * CELL + travel
		filtered = false
		-- Recentering moves the grid by whole cells, so most ribbons land where a neighbour has
		-- already probed: carry those masks over and leave only the newly uncovered cells to
		-- probe. A teleport or a sharp turn of the wind uncovers every cell.
		local dAcross = math.round((acrossOrigin - lastAcross) / CELL)
		local dAlong = math.round((alongOrigin - lastAlong) / CELL)
		if not lastDirection or direction:Dot(lastDirection) < 0.999 then
			for _, ribbon in ribbons do
				ribbon.water, ribbon.wet = nil, nil
			end
		elseif dAcross ~= 0 or dAlong ~= 0 then
			local previous, previousWet = {}, {}
			for index, ribbon in ribbons do
				previous[index], previousWet[index] = ribbon.water, ribbon.wet
			end
			for _, ribbon in ribbons do
				local row, column = ribbon.row + dAlong, ribbon.column + dAcross
				local inside = math.abs(row) <= half and math.abs(column) <= half
				local index = (row + half) * GRID + column + half + 1
				ribbon.water = if inside then previous[index] else nil
				ribbon.wet = if inside then previousWet[index] else nil
			end
		end
		lastAcross, lastAlong, lastDirection = acrossOrigin, alongOrigin, direction
		-- Streamed shoreline changes what's water, so each mask is redone every interval
		due = math.min(due + #ribbons * step / WATER_CHECK_INTERVAL, MAX_RIBBON_PROBES)
		for _ = 1, math.floor(due) do
			cursor = cursor % #ribbons + 1
			ribbons[cursor].water = nil
			due -= 1
		end
		if lastCamera == nil or (cameraPosition - lastCamera).Magnitude > TELEPORT_DISTANCE then
			table.clear(coastSamples)
		end
		lastCamera = cameraPosition
		-- Fade native oscillations out near land without switching the whole
		-- surface between three strengths whenever one probe crosses the shore.
		local coastalExposure = coastalExposureAt(projected, now)
		-- Shelter damps the large swells much more than the short wind ripples.
		-- Using that tiny swell amplitude here made even a storm lake look calm.
		local windStrength = math.clamp((state.windSpeed - 6) / 46, 0, 1)
		local ripple = (0.025 + (MAX_RIPPLE_SIZE - 0.025) * windStrength ^ 1.3)
			* math.sqrt(Weather.lakeExposure(projected))
			* coastalExposure
		-- Terrain water settings are engine state: skip the write once the easing has
		-- settled instead of nudging it by a hair every frame.
		local waveSize = terrain.WaterWaveSize
		if math.abs(ripple - waveSize) > 0.0005 then
			terrain.WaterWaveSize = waveSize + (ripple - waveSize) * (1 - math.exp(-step * 3))
		end
		if not WaterQuality.layeredEnabled() then
			table.clear(hullBounds)
			for _, ribbon in ribbons do
				ribbon.body.Enabled, ribbon.edge.Enabled = false, false
			end
			return
		end
		local recolor = now - coloredAt >= 0.5
		if recolor then
			coloredAt = now
		end
		local visible = cameraPosition.Y > Biomes.WaterLevel - 0.5
			and cameraPosition.Y < Biomes.WaterLevel + 180
			and Biomes.inOceanBounds(cameraPosition)
		-- Underwater and high-altitude cameras cannot see these surface ribbons.
		-- Keep their masks and wave phase ready, but skip hull geometry and samples.
		if not visible then
			table.clear(hullBounds)
			for _, ribbon in ribbons do
				ribbon.body.Enabled, ribbon.edge.Enabled = false, false
			end
			return
		end
		local footprints = hullFootprints(cameraPosition, across, direction, now)
		local probes = MAX_RIBBON_PROBES
		for _, ribbon in ribbons do
			local center = across * (acrossOrigin + ribbon.column * CELL)
				+ direction * (alongOrigin + ribbon.row * CELL)
			local a, b = center - across * HALF_CREST, center + across * HALF_CREST
			local height, amplitude = Weather.heightAt(center, now, state)
			local width = math.clamp(8 + amplitude * 6, 8, 24)
			local from, to = clearSpan(center, width / 2, footprints, across, direction)
			if visible and ribbon.water == nil and probes > 0 then
				probes -= 1
				-- The ribbon travels downwind until its next recheck: probe its leading
				-- edge that far ahead, so it starts fading before it reaches the shore.
				local lead = width / 2 + Weather.components[1].speed * WATER_CHECK_INTERVAL
				ribbon.water = isWater(center)
					and isWater(a)
					and isWater(b)
					and isWater(a + direction * lead)
					and isWater(a - direction * width / 2)
					and isWater(b + direction * lead)
					and isWater(b - direction * width / 2)
			end
			if ribbon.water ~= nil then
				local target = if ribbon.water then 1 else 0
				-- A cell probed for the first time (teleport, new row) shows its answer at once.
				ribbon.wet = if ribbon.wet == nil
					then target
					else ribbon.wet + math.clamp(
						target - ribbon.wet,
						-step / WET_FADE_SECONDS,
						step / WET_FADE_SECONDS
					)
			end
			local wet = ribbon.wet or 0
			local crest = math.clamp(height / math.max(amplitude, 0.01), 0, 1)
			local fade = math.clamp((crest - 0.08) / 0.6, 0, 1)
			-- Sheltered ripples are already drawn by Terrain. Raised ribbons at
			-- that height intersect it repeatedly; ease them in as swells grow.
			fade *= smoothstep(math.clamp((amplitude - 0.08) / 0.32, 0, 1))
			fade *= smoothstep(wet)
			local enabled = visible and fade > 0.01 and from ~= nil
			ribbon.body.Enabled, ribbon.edge.Enabled = enabled, enabled
			if not enabled then
				continue
			end
			-- Draw only the stretch clear of hulls; the faded ends keep the cut soft.
			a, b = center + across * from, center + across * to
			local curve = (to - from) / 3
			ribbon.body.CurveSize0, ribbon.body.CurveSize1 = curve, curve
			ribbon.edge.CurveSize0, ribbon.edge.CurveSize1 = curve, curve
			local sampleA, sampleB = Weather.sample(a, now, state), Weather.sample(b, now, state)
			ribbon.a.CFrame =
				surfaceFrame(Vector3.new(a.X, Biomes.WaterLevel + sampleA.height + 0.06, a.Z), across, sampleA.normal)
			ribbon.b.CFrame =
				surfaceFrame(Vector3.new(b.X, Biomes.WaterLevel + sampleB.height + 0.06, b.Z), across, sampleB.normal)
			ribbon.body.Width0, ribbon.body.Width1 = width, width
			ribbon.edge.Width0, ribbon.edge.Width1 = 1.1 + amplitude * 0.9, 0.9 + amplitude * 0.7
			-- ZOffset separates the two beam layers relative to the camera; it
			-- cannot stop either layer intersecting the native water. Dissolve
			-- the entire ribbon before any of its geometry reaches that surface.
			local clearance = lowestSurface(ribbon.a.CFrame, ribbon.b.CFrame, curve, width)
				- (Biomes.WaterLevel + terrain.WaterWaveSize + SURFACE_CLEARANCE)
			fade *= smoothstep(math.clamp(clearance / SURFACE_FADE_HEIGHT, 0, 1))
			ribbon.body.Enabled, ribbon.edge.Enabled = fade > 0.01, fade > 0.01
			-- A boundary row is recycled at GRID * CELL / 2 from the camera.
			-- It must already be transparent there, including on small camera sway.
			local distanceFade =
				smoothstep(math.clamp((GRID * CELL * 0.5 - (center - projected).Magnitude) / CELL, 0, 1))
			ribbon.body.LocalTransparencyModifier = 1 - fade * distanceFade * 0.68
			ribbon.edge.LocalTransparencyModifier = 1 - fade * distanceFade * (0.32 + state.rain * 0.48)
			if recolor then
				ribbon.body.Color = ColorSequence.new(terrain.WaterColor:Lerp(Color3.fromRGB(160, 205, 210), 0.32))
				ribbon.edge.Color = ColorSequence.new(Color3.fromRGB(205, 229, 230))
			end
		end
	end))
end

return WaterWaves
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="371">
          <Properties>
            <string name="Name">Weather</string>
            <string name="Source"><![CDATA[-- Camera-local precipitation keeps the whole ocean affordable. The shared clock
-- drives intensity and lightning, so every player sees the same passing weather.
local ContentProvider = game:GetService("ContentProvider")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Biomes = require(ReplicatedStorage.Shared.Biomes)
local Weather = require(ReplicatedStorage.Shared.Weather)

-- Names this module's per-frame work in the MicroProfiler (otherwise it is all "Script_Client").
local function profiled<A...>(label: string, callback: (A...) -> ()): (A...) -> ()
	if not debug.profilebegin then
		return callback -- test runners without the MicroProfiler API
	end
	return function(...: A...)
		debug.profilebegin(label)
		callback(...)
		debug.profileend()
	end
end

local WeatherController = {}
local started = false
local CELL_SIZE = 22
local RAIN_HEIGHT = 28
local UPDATE_INTERVAL = 0.2
local LIGHTNING_INTERVAL = 9
-- Roblox Creator Store: Rain Effect by Roblox; thunder by Pro Sound Effects.
local RAIN_SOUND = "rbxassetid://1516791621"
-- Thunder Lightning 1 (SFX): https://create.roblox.com/store/asset/9120019553
local THUNDER_SOUND = "rbxassetid://9120019553"
local STREAK_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"

type RainCell = {
	part: Part,
	emitter: ParticleEmitter,
	offset: Vector3,
	open: boolean,
}

local function emitterPart(name: string, size: Vector3, parent: Instance): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Transparency = 1
	part.Parent = parent
	return part
end

local function streak(name: string, parent: Part): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = name
	emitter.Enabled = false
	emitter.Texture = STREAK_TEXTURE
	emitter.Orientation = Enum.ParticleOrientation.VelocityParallel
	-- VelocityParallel rotates the texture axes; negative squash stretches along
	-- movement. This uses a bundled engine texture, without an uploaded image.
	emitter.Squash = NumberSequence.new(-3)
	-- Retain enough contrast to read against a dark storm sky and dark water.
	emitter.LightInfluence = 0.2
	emitter.LightEmission = 0.12
	emitter.Color = ColorSequence.new(Color3.fromRGB(195, 215, 225))
	emitter.Rotation = NumberRange.new(0)
	emitter.RotSpeed = NumberRange.new(0)
	emitter.VelocityInheritance = 0
	emitter.LockedToPart = false
	emitter.Parent = parent
	return emitter
end

local function hash(value: number): number
	local result = math.sin(value * 127.1 + 311.7) * 43758.5453
	return result - math.floor(result)
end

local function soundId(attribute: string, defaultId: string): string
	local override = workspace:GetAttribute(attribute)
	if type(override) == "number" and override > 0 and override < math.huge then
		return "rbxassetid://" .. tostring(math.floor(override))
	elseif type(override) == "string" and string.match(override, "^rbxassetid://%d+$") then
		return override
	end
	return defaultId
end

function WeatherController.start()
	if started then
		return
	end
	started = true
	local effects = Instance.new("Folder")
	effects.Name = "WeatherEffects"
	effects.Parent = workspace
	local cells: { RainCell } = {}
	for x = -1, 1 do
		for z = -1, 1 do
			local part = emitterPart("RainCell", Vector3.new(CELL_SIZE, 0.1, CELL_SIZE), effects)
			local emitter = streak("Rain", part)
			emitter.EmissionDirection = Enum.NormalId.Bottom
			emitter.SpreadAngle = Vector2.new(2, 2)
			emitter.Size = NumberSequence.new(0.22)
			emitter.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.08, 0.22),
				NumberSequenceKeypoint.new(0.86, 0.35),
				NumberSequenceKeypoint.new(1, 1),
			})
			table.insert(
				cells,
				{ part = part, emitter = emitter, offset = Vector3.new(x * CELL_SIZE, 0, z * CELL_SIZE), open = false }
			)
		end
	end
	local windPart = emitterPart("WindField", Vector3.new(78, 24, 1), effects)
	local wind = streak("WindStreaks", windPart)
	wind.EmissionDirection = Enum.NormalId.Front
	wind.SpreadAngle = Vector2.new(3, 2)
	wind.Squash = NumberSequence.new(-5)
	wind.Size = NumberSequence.new(0.16)
	wind.Lifetime = NumberRange.new(1.6, 2.2)
	wind.Color = ColorSequence.new(Color3.fromRGB(220, 232, 232))

	-- Own effect rather than competing with biome/daylight lighting properties.
	local flash = Instance.new("ColorCorrectionEffect")
	flash.Name = "WeatherLightning"
	flash.Enabled = false
	flash.Parent = Lighting
	local thunder = Instance.new("Sound")
	thunder.Name = "WeatherThunder"
	thunder.SoundId = soundId("WeatherThunderSoundId", THUNDER_SOUND)
	thunder.Volume = 0.5
	thunder:SetAttribute("AudioCategory", "Effects")
	thunder.Parent = SoundService
	local rainSound = Instance.new("Sound")
	rainSound.Name = "WeatherRain"
	rainSound.SoundId = soundId("WeatherRainSoundId", RAIN_SOUND)
	rainSound.Looped = true
	rainSound.Volume = 0
	rainSound:SetAttribute("AudioCategory", "Effects")
	rainSound.Parent = SoundService
	-- Warm the loops without delaying the weather controller or loading screen.
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync({ rainSound, thunder })
		end)
	end)

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.IgnoreWater = true
	local groundParams = RaycastParams.new()
	groundParams.FilterType = Enum.RaycastFilterType.Exclude
	groundParams.IgnoreWater = false
	local player = Players.LocalPlayer
	local lastCharacter: Model? = nil
	local sheltered = true
	local hidden = true
	local elapsed = UPDATE_INTERVAL
	local lastBucket: number? = nil
	local strikeTime = math.huge
	local struck = true
	local flashTime = -math.huge
	local thunderToken = 0
	local previousStorm = 0
	local currentSkyFraction = 0
	local lastRainPosition: Vector3? = nil

	local function hide()
		for _, cell in cells do
			cell.emitter.Enabled = false
			cell.emitter:Clear()
		end
		wind.Enabled = false
		wind:Clear()
	end

	RunService:BindToRenderStep("WeatherEffects", Enum.RenderPriority.Camera.Value + 2, profiled("Weather", function(dt: number)
		local camera = workspace.CurrentCamera
		if not camera then
			rainSound.Volume = 0
			if rainSound.IsPlaying then
				rainSound:Stop()
			end
			if not hidden then
				hide()
				hidden = true
				thunderToken += 1
			end
			flash.Enabled = false
			return
		end
		local now = workspace:GetServerTimeNow()
		local state = Weather.getState(now, camera.CFrame.Position)
		local effectsEnabled = player:GetAttribute("WeatherEffectsEnabled") ~= false
		local position = camera.CFrame.Position
		local submerged = Biomes.inOceanBounds(position)
			and position.Y > Biomes.SeaFloor
			and position.Y < Biomes.WaterLevel - 0.15
		local character = player.Character
		if character ~= lastCharacter then
			lastCharacter = character
			local exclusions: { Instance } = { effects }
			if character then
				table.insert(exclusions, character)
			end
			rayParams.FilterDescendantsInstances = exclusions
			groundParams.FilterDescendantsInstances = exclusions
			elapsed = UPDATE_INTERVAL
		end
		if effectsEnabled and state.rain > 0.01 and not submerged and position ~= lastRainPosition then
			for _, cell in cells do
				cell.part.Position = position + cell.offset + Vector3.new(0, RAIN_HEIGHT, 0)
			end
			lastRainPosition = position
		end
		local windDirection = state.windDirection
		local windCenter = position + Vector3.new(0, 4, 0)
		windPart.CFrame = CFrame.lookAt(windCenter - windDirection * 23, windCenter)
		elapsed += dt
		if elapsed >= UPDATE_INTERVAL then
			elapsed = 0
			-- Hide the whole field under a roof to prevent adjacent emitters from
			-- drifting through it. Per-cell tests also clip its outdoor edges.
			sheltered = workspace:Raycast(position + Vector3.new(0, 0.15, 0), Vector3.new(0, 160, 0), rayParams) ~= nil
			local openCells = 0
			local rainSpeed = 70 + state.rain * 28
			local sampleCells = state.rain > 0.01 or state.storm > 0.1
			for _, cell in cells do
				local center = position + cell.offset
				cell.open = not sheltered
					and not submerged
					and sampleCells
					and workspace:Raycast(center + Vector3.new(0, 0.15, 0), Vector3.new(0, 160, 0), rayParams)
						== nil
				if cell.open then
					openCells += 1
				end
				local emitter = cell.emitter
				if not effectsEnabled or not cell.open or state.rain <= 0.01 then
					if emitter.Enabled then
						emitter.Enabled = false
						emitter:Clear()
					end
					continue
				end
				-- A small drizzle still needs enough drops across each 22-stud cell
				-- to be visible; the old rate left only a handful in the whole view.
				emitter.Rate = 60 + 180 * state.rain
				emitter.Speed = NumberRange.new(rainSpeed * 0.94, rainSpeed)
				emitter.Acceleration = windDirection * state.windSpeed * 1.5
				-- End rain at terrain, water, or the nearest solid surface, rather
				-- than letting droplets continue below the lake and house floors.
				local ground = if cell.open
					then workspace:Raycast(cell.part.Position, Vector3.new(0, -256, 0), groundParams)
					else nil
				local groundY = if ground then ground.Position.Y else Biomes.WaterLevel
				local lifetime = math.clamp((cell.part.Position.Y - groundY) / rainSpeed, 0.06, 1.25)
				emitter.Lifetime = NumberRange.new(lifetime * 0.86, lifetime)
				emitter.Enabled = true
			end
			currentSkyFraction = openCells / #cells
			local windStrength = math.clamp((state.windSpeed - 6) / 46, 0, 1)
			wind.Speed = NumberRange.new(math.max(12, state.windSpeed * 0.85), math.max(14, state.windSpeed * 1.1))
			wind.Rate = 4 + windStrength * 27
			wind.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.2, 0.88 - windStrength * 0.2),
				NumberSequenceKeypoint.new(0.75, 0.91 - windStrength * 0.13),
				NumberSequenceKeypoint.new(1, 1),
			})
			wind.Enabled = effectsEnabled and not sheltered and not submerged
		end
		local shouldHide = sheltered or submerged or not effectsEnabled
		if shouldHide and not hidden then
			hide()
		elseif hidden and not shouldHide then
			elapsed = UPDATE_INTERVAL
		end
		hidden = shouldHide

		-- Keep audio independent of the particle-performance toggle. Fade the same
		-- loop with the forecast instead of restarting it as rainfall changes.
		local rainId = soundId("WeatherRainSoundId", RAIN_SOUND)
		if rainSound.SoundId ~= rainId then
			rainSound:Stop()
			rainSound.SoundId = rainId
		end
		local exposure = if submerged then 0.08 elseif sheltered then 0.3 else 1
		local targetVolume = math.sqrt(state.rain) * 0.65 * exposure
		rainSound.Volume += (targetVolume - rainSound.Volume) * (1 - math.exp(-dt * 3))
		if targetVolume > 0.001 then
			if not rainSound.IsPlaying then
				rainSound:Play()
			end
		elseif rainSound.Volume < 0.001 then
			rainSound.Volume = 0
			if rainSound.IsPlaying then
				rainSound:Stop()
			end
		end

		if state.storm <= 0.1 and previousStorm > 0.1 then
			thunderToken += 1
			thunder:Stop()
		end
		previousStorm = state.storm
		local bucket = math.floor(now / LIGHTNING_INTERVAL)
		if bucket ~= lastBucket then
			lastBucket = bucket
			local seed = workspace:GetAttribute("WeatherSeed") or 1
			if type(seed) ~= "number" then
				seed = 1
			end
			strikeTime = bucket * LIGHTNING_INTERVAL + 1 + hash(bucket + seed) * 4
			struck = strikeTime < now or hash(bucket * 3 + seed) > 0.35 + state.storm * 0.6
		end
		if not struck and now >= strikeTime then
			struck = true
			if state.storm > 0.15 then
				flashTime = now
				thunderToken += 1
				local token = thunderToken
				local strength = state.storm
				task.delay(1.1 + hash(bucket * 7) * 2.6, function()
					local activeCamera = workspace.CurrentCamera
					if
						token == thunderToken
						and activeCamera
						and Weather.getState(workspace:GetServerTimeNow(), activeCamera.CFrame.Position).storm > 0.1
					then
						thunder.SoundId = soundId("WeatherThunderSoundId", THUNDER_SOUND)
						thunder.Volume = (0.22 + strength * 0.43) * (0.45 + currentSkyFraction * 0.55)
						thunder:Play()
					end
				end)
			end
		end
		local age = now - flashTime
		local pulse = if age < 0.08
			then 1 - age / 0.08
			elseif age > 0.15 and age < 0.27 then (1 - (age - 0.15) / 0.12) * 0.7
			else 0
		flash.Enabled = effectsEnabled and pulse > 0 and state.storm > 0.1 and not submerged
		flash.Brightness = pulse * (0.12 + state.storm * 0.2)
	end))
end

return WeatherController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="372">
          <Properties>
            <string name="Name">WeatherRadar</string>
            <string name="Source"><![CDATA[-- Paints the live picture on every weather radar table near the camera (placed
-- WeatherRadar furniture and the showroom sample). The map is the area around
-- the table, turned to match the world around it: land from the replicated
-- island chart, and rain sampled from the same deterministic forecast the sky
-- uses (Weather.localConditions), so the radar shows exactly the storm this
-- client sees, tornadoes included.
--
-- It stays cheap: a screen only gets its SurfaceGui while the camera is close,
-- the land is painted once, and the rain layer is resampled every couple of
-- seconds. Each row of same-coloured cells is one frame, so even a supercell
-- over the whole disc is a few hundred frames, and an unchanged picture
-- touches none of them.
local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Biomes = require(ReplicatedStorage.Shared.Biomes)
local Weather = require(ReplicatedStorage.Shared.Weather)

local Radar = {}
local started = false
local TAG = "WeatherRadarScreen"
-- Cells across the disc, and studs from the table to the disc's rim.
local CELLS = 40
local RANGE = 2400
local CANVAS = 240
local SHOW_DISTANCE = 70
local HIDE_DISTANCE = 90
local SCAN_INTERVAL = 0.5
local REFRESH_INTERVAL = 1.5
local MAX_TORNADOES = 2

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local SEA = rgb(44, 100, 178)
local SHALLOW = rgb(66, 134, 208)
local LAND = {
	normal = rgb(98, 164, 74),
	swamp = rgb(84, 112, 62),
	tropical = rgb(206, 192, 130),
	volcanic = rgb(98, 86, 80),
	ice = rgb(232, 238, 242),
	open = rgb(98, 164, 74),
}
-- Reflectivity bands, light rain to the hail core of a supercell.
local LEVELS = {
	{ at = 0.06, color = rgb(72, 172, 90), transparency = 0.35 },
	{ at = 0.22, color = rgb(26, 126, 46), transparency = 0 },
	{ at = 0.4, color = rgb(236, 214, 46), transparency = 0 },
	{ at = 0.58, color = rgb(242, 142, 34), transparency = 0 },
	{ at = 0.75, color = rgb(222, 44, 34), transparency = 0 },
	{ at = 0.92, color = rgb(248, 196, 220), transparency = 0 },
}

type Coast = { points: { Vector2 }, inner: { Vector2 }?, min: Vector2, max: Vector2 }
type Cell = { column: number, point: Vector3 }
type Screen = {
	part: BasePart,
	gui: SurfaceGui,
	land: Frame,
	rain: Frame,
	rows: { { Cell } },
	runs: { Frame },
	marks: { Frame },
	right: Vector3,
	back: Vector3,
	landVersion: number,
	-- What each pooled rain frame shows, so unchanged frames are never written.
	keys: { string? },
}

local coasts: { Coast } = {}
local coastVersion = 0

local function make(class: string, parent: Instance?, props: { [string]: any }): any
	local item = Instance.new(class)
	for key, value in props do
		item[key] = value
	end
	item.Parent = parent
	return item
end

-- Even-odd point in polygon.
local function inside(points: { Vector2 }, x: number, z: number): boolean
	local result = false
	local j = #points
	for i, a in points do
		local b = points[j]
		if (a.Y > z) ~= (b.Y > z) and x < (b.X - a.X) * (z - a.Y) / (b.Y - a.Y) + a.X then
			result = not result
		end
		j = i
	end
	return result
end

local function landAt(x: number, z: number): boolean
	for _, coast in coasts do
		if
			x >= coast.min.X
			and x <= coast.max.X
			and z >= coast.min.Y
			and z <= coast.max.Y
			and inside(coast.points, x, z)
			and not (coast.inner and inside(coast.inner, x, z))
		then
			return not Weather.inLake(Vector3.new(x, 0, z))
		end
	end
	return false
end

local function readCoast(record: Instance): Coast?
	if not record:IsA("StringValue") then
		return nil
	end
	local ok, raw = pcall(HttpService.JSONDecode, HttpService, record.Value)
	if not ok or type(raw) ~= "table" or #raw < 3 then
		return nil
	end
	local points, center = {}, Vector2.zero
	local x1, z1, x2, z2 = math.huge, math.huge, -math.huge, -math.huge
	for _, pair in raw do
		local point = Vector2.new(pair[1], pair[2])
		table.insert(points, point)
		center += point
		x1, z1 = math.min(x1, point.X), math.min(z1, point.Y)
		x2, z2 = math.max(x2, point.X), math.max(z2, point.Y)
	end
	local low, high = Vector2.new(x1, z1), Vector2.new(x2, z2)
	center /= #points
	local inner = nil
	-- An atoll is a ring of land round a lagoon, as the sea chart draws it.
	if record:GetAttribute("Atoll") then
		inner = {}
		for _, point in points do
			table.insert(inner, center:Lerp(point, 0.65))
		end
	end
	return { points = points, inner = inner, min = low, max = high }
end

-- Paints one row as runs of equal colour; `colorAt` returns a colour and a
-- transparency, or nil for an empty cell. Calls `emit(column, length, color,
-- transparency)` per run.
local function eachRun(cells: { Cell }, colorAt: (Cell) -> (Color3?, number), emit)
	local start, color, transparency, last = nil, nil, 0, nil
	local function flush()
		if start and color then
			emit(start, last - start + 1, color, transparency)
		end
	end
	for _, cell in cells do
		local nextColor, nextTransparency = colorAt(cell)
		if nextColor ~= color or nextTransparency ~= transparency or (last and cell.column ~= last + 1) then
			flush()
			start, color, transparency = cell.column, nextColor, nextTransparency
		end
		last = cell.column
	end
	flush()
end

local function runFrame(parent: Instance, row: number, column: number, length: number, z: number): Frame
	return make("Frame", parent, {
		BorderSizePixel = 0,
		Position = UDim2.fromScale(column / CELLS, row / CELLS),
		Size = UDim2.fromScale(length / CELLS, 1 / CELLS),
		ZIndex = z,
	})
end

local function paintLand(screen: Screen)
	screen.land:ClearAllChildren()
	screen.landVersion = coastVersion
	local grid = {}
	for row, cells in screen.rows do
		grid[row] = {}
		for _, cell in cells do
			grid[row][cell.column] = landAt(cell.point.X, cell.point.Z)
		end
	end
	local function nearLand(row: number, column: number): boolean
		for dr = -1, 1 do
			for dc = -1, 1 do
				local line = grid[row + dr]
				if line and line[column + dc] then
					return true
				end
			end
		end
		return false
	end
	for row, cells in screen.rows do
		eachRun(cells, function(cell: Cell): (Color3?, number)
			if grid[row][cell.column] then
				return LAND[Biomes.at(cell.point).id] or LAND.normal, 0
			end
			return if nearLand(row, cell.column) then SHALLOW else SEA, 0
		end, function(column, length, color)
			runFrame(screen.land, row, column, length, 1).BackgroundColor3 = color
		end)
	end
end

local function levelOf(rain: number, storm: number): number
	local value = math.max(rain * 0.8, storm)
	local level = 0
	for index, band in LEVELS do
		if value >= band.at then
			level = index
		end
	end
	return level
end

local function refresh(screen: Screen, state, tornadoes)
	if screen.landVersion ~= coastVersion then
		paintLand(screen)
	end
	-- Only frames whose run changed are written; a settled picture writes nothing.
	local count = 0
	for row, cells in screen.rows do
		eachRun(cells, function(cell: Cell): (Color3?, number)
			local level = levelOf(Weather.localConditions(cell.point, state))
			if level == 0 then
				return nil, 0
			end
			return LEVELS[level].color, LEVELS[level].transparency
		end, function(column, length, color, transparency)
			count += 1
			local key = string.format("%d:%d:%d:%s", row, column, length, tostring(color))
			if screen.keys[count] == key then
				return
			end
			screen.keys[count] = key
			local frame = screen.runs[count]
			if not frame then
				frame = runFrame(screen.rain, row, column, length, 2)
				screen.runs[count] = frame
			else
				frame.Position = UDim2.fromScale(column / CELLS, row / CELLS)
				frame.Size = UDim2.fromScale(length / CELLS, 1 / CELLS)
				frame.Visible = true
			end
			frame.BackgroundColor3 = color
			frame.BackgroundTransparency = transparency
		end)
	end
	for index = count + 1, #screen.runs do
		if screen.keys[index] then
			screen.keys[index] = nil
			screen.runs[index].Visible = false
		end
	end
	local center = screen.part.Position
	for index, mark in screen.marks do
		local tornado = tornadoes[index]
		local shown, u, v = false, 0, 0
		if tornado then
			local offset = tornado.position - Vector3.new(center.X, 0, center.Z)
			u = 0.5 + offset:Dot(screen.right) / (RANGE * 2)
			v = 0.5 + offset:Dot(screen.back) / (RANGE * 2)
			shown = (u - 0.5) ^ 2 + (v - 0.5) ^ 2 < 0.25
		end
		if mark.Visible ~= shown then
			mark.Visible = shown
		end
		if shown then
			mark.Position = UDim2.fromScale(u, v)
		end
	end
end

local function build(part: BasePart): Screen
	local gui = make("SurfaceGui", nil, {
		Name = "WeatherRadarGui",
		Face = Enum.NormalId.Top,
		SizingMode = Enum.SurfaceGuiSizingMode.FixedSize,
		CanvasSize = Vector2.new(CANVAS, CANVAS),
		LightInfluence = 0,
		Brightness = 1.2,
		MaxDistance = HIDE_DISTANCE,
		ClipsDescendants = true,
	})
	local land = make("Frame", gui, { Name = "Land", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
	local rain = make("Frame", gui, { Name = "Rain", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
	-- The table's own spot.
	for _, size in { UDim2.new(0, 14, 0, 2), UDim2.new(0, 2, 0, 14) } do
		make("Frame", gui, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = size,
			BorderSizePixel = 0,
			BackgroundColor3 = rgb(20, 20, 24),
			ZIndex = 4,
		})
	end
	local marks = {}
	for _ = 1, MAX_TORNADOES do
		local mark = make("Frame", gui, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(9, 9),
			BackgroundColor3 = rgb(255, 255, 255),
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = 3,
		})
		make("UICorner", mark, { CornerRadius = UDim.new(0.5, 0) })
		make("UIStroke", mark, { Color = rgb(150, 20, 120), Thickness = 2 })
		table.insert(marks, mark)
	end
	-- A SurfaceGui on the top face draws its x along the part's +X and its y
	-- along +Z, so the disc is the world around the table seen from above.
	local right = part.CFrame.RightVector
	right = Vector3.new(right.X, 0, right.Z).Unit
	local back = right:Cross(Vector3.yAxis)
	local center = part.Position
	local rows = {}
	local half = CELLS / 2
	for row = 0, CELLS - 1 do
		local cells = {}
		for column = 0, CELLS - 1 do
			local x, y = column + 0.5 - half, row + 0.5 - half
			if x * x + y * y <= half * half then
				local offset = right * (x / half * RANGE) + back * (y / half * RANGE)
				table.insert(
					cells,
					{ column = column, point = Vector3.new(center.X + offset.X, 0, center.Z + offset.Z) }
				)
			end
		end
		rows[row] = cells
	end
	gui.Parent = part
	return {
		part = part,
		gui = gui,
		land = land,
		rain = rain,
		rows = rows,
		runs = {},
		marks = marks,
		right = right,
		back = back,
		landVersion = -1,
		keys = {},
	}
end

function Radar.start()
	if started then
		return
	end
	started = true
	local tracked: { [BasePart]: boolean } = {}
	local screens: { [BasePart]: Screen } = {}
	local function drop(part: BasePart)
		local screen = screens[part]
		if screen then
			screen.gui:Destroy()
			screens[part] = nil
		end
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(function(part)
		if part:IsA("BasePart") then
			tracked[part] = true
		end
	end)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(function(part)
		tracked[part] = nil
		drop(part)
	end)
	for _, part in CollectionService:GetTagged(TAG) do
		if part:IsA("BasePart") then
			tracked[part] = true
		end
	end
	-- The chart arrives progressively while islands generate; repaint land once
	-- the records stop changing for a moment.
	task.spawn(function()
		local chart = ReplicatedStorage:WaitForChild("IslandChart")
		local pending = false
		local function reload()
			if pending then
				return
			end
			pending = true
			task.delay(1, function()
				pending = false
				local list = {}
				for _, record in chart:GetChildren() do
					local coast = readCoast(record)
					if coast then
						table.insert(list, coast)
					end
				end
				coasts = list
				coastVersion += 1
			end)
		end
		chart.ChildAdded:Connect(reload)
		chart.ChildRemoved:Connect(reload)
		reload()
	end)
	local scanElapsed, refreshElapsed = SCAN_INTERVAL, 0
	RunService.Heartbeat:Connect(function(dt: number)
		scanElapsed += dt
		refreshElapsed += dt
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		if scanElapsed >= SCAN_INTERVAL then
			scanElapsed = 0
			local eye = camera.CFrame.Position
			for part in tracked do
				-- Inventory thumbnails and replicated templates carry the tag too.
				local live = part.Parent ~= nil and part:IsDescendantOf(workspace)
				local distance = if live then (part.Position - eye).Magnitude else math.huge
				if screens[part] and distance > HIDE_DISTANCE then
					drop(part)
				elseif not screens[part] and distance < SHOW_DISTANCE then
					screens[part] = build(part)
					refreshElapsed = REFRESH_INTERVAL
				end
				if part.Parent == nil then
					tracked[part] = nil
				end
			end
		end
		if refreshElapsed >= REFRESH_INTERVAL and next(screens) then
			refreshElapsed = 0
			local now = workspace:GetServerTimeNow()
			local state = Weather.getState(now)
			local tornadoes = Weather.tornadoes(now)
			for _, screen in screens do
				refresh(screen, state, tornadoes)
			end
		end
	end)
end

return Radar
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="373">
          <Properties>
            <string name="Name">WorldMap</string>
            <string name="Source"><![CDATA[-- North-up sea chart. Only the player marker updates while the chart is open.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Biomes = require(ReplicatedStorage.Shared.Biomes)
local WorldMap = {}
local started = false
local ink = Color3.fromRGB(79, 54, 32)
local paper = Color3.fromRGB(224, 199, 144)
local seaInk = Color3.fromRGB(115, 127, 110)

local function make(class, parent, props)
	local item = Instance.new(class)
	for key, value in props do
		item[key] = value
	end
	item.Parent = parent
	return item
end

local function label(parent, value, position, size, textSize)
	return make("TextLabel", parent, {
		BackgroundTransparency = 1,
		Text = value,
		Position = position,
		Size = size,
		TextColor3 = ink,
		Font = Enum.Font.Antique,
		TextSize = textSize or 18,
		TextWrapped = true,
		ZIndex = 5,
	})
end

local function line(parent, a, b, color, thickness, zIndex)
	local delta = b - a
	return make("Frame", parent, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale((a.X + b.X) / 2, (a.Y + b.Y) / 2),
		Size = UDim2.new(delta.Magnitude, 0, 0, thickness or 1),
		Rotation = math.deg(math.atan2(delta.Y, delta.X)),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = zIndex or 2,
	})
end

function WorldMap.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local center = (Biomes.OceanMin + Biomes.OceanMax) / 2
	local half = (Biomes.OceanMax - Biomes.OceanMin) / 2 * 1.06
	local function project(x, z)
		return Vector2.new(0.5 + (x - center) / (half * 2), 0.5 + (z - center) / (half * 2))
	end
	local gui = make("ScreenGui", player:WaitForChild("PlayerGui"), {
		Name = "WorldMap",
		ResetOnSpawn = false,
		DisplayOrder = 45,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	local open = make("TextButton", gui, {
		Name = "OpenChart",
		Text = "Map [M]",
		Font = Enum.Font.Antique,
		TextSize = 19,
		TextColor3 = ink,
		BackgroundColor3 = paper,
		BorderColor3 = ink,
		Position = UDim2.new(1, -126, 1, -54),
		Size = UDim2.fromOffset(112, 38),
	})
	local overlay = make("TextButton", gui, {
		Name = "ChartOverlay",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.3,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
	})
	local chart = make("TextButton", overlay, {
		Name = "Parchment",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = paper,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.94, 0.94),
	})
	make("UIAspectRatioConstraint", chart, { AspectRatio = 1 })
	make("UISizeConstraint", chart, { MaxSize = Vector2.new(850, 850) })
	make("UIStroke", chart, { Color = ink, Thickness = 3 })
	make("UIGradient", chart, {
		Rotation = 28,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(166, 128, 77)),
			ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 245, 218)),
			ColorSequenceKeypoint.new(0.8, Color3.fromRGB(255, 245, 218)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(166, 128, 77)),
		}),
	})
	label(chart, "FISHING WATERS", UDim2.fromScale(0.12, 0.015), UDim2.fromScale(0.76, 0.055), 26)
	label(chart, "~ A mariner's chart of the five seas ~", UDim2.fromScale(0.12, 0.07), UDim2.fromScale(0.76, 0.04), 15)
	local close = make("TextButton", chart, {
		Name = "CloseChart",
		Text = "X",
		Font = Enum.Font.Antique,
		TextSize = 22,
		TextColor3 = ink,
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -48, 0, 8),
		Size = UDim2.fromOffset(40, 40),
		ZIndex = 10,
	})
	local canvas = make("Frame", chart, {
		Name = "SeaChart",
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.05, 0.12),
		Size = UDim2.fromScale(0.9, 0.78),
	})
	-- Keep world X/Z at identical scales at every viewport size.
	make("UIAspectRatioConstraint", canvas, { AspectRatio = 1, DominantAxis = Enum.DominantAxis.Height })
	canvas.AnchorPoint = Vector2.new(0.5, 0)
	canvas.Position = UDim2.fromScale(0.5, 0.12)
	make("UIStroke", canvas, { Color = ink, Thickness = 1, Transparency = 0.45 })
	for i = 1, 7 do
		line(canvas, Vector2.new(i / 8, 0), Vector2.new(i / 8, 1), seaInk).BackgroundTransparency = 0.78
		line(canvas, Vector2.new(0, i / 8), Vector2.new(1, i / 8), seaInk).BackgroundTransparency = 0.78
	end
	for _, biome in Biomes.list do
		local p = project(biome.center.X, biome.center.Y)
		label(canvas, biome.name, UDim2.fromScale(p.X - 0.16, p.Y - 0.105), UDim2.fromScale(0.32, 0.055), 17)
	end
	label(canvas, "N\n✦\nS", UDim2.fromScale(0.82, 0.02), UDim2.fromScale(0.15, 0.15), 20)
	label(canvas, "W         E", UDim2.fromScale(0.79, 0.065), UDim2.fromScale(0.21, 0.055), 14)
	label(canvas, "OPEN WATERS", UDim2.fromScale(0.02, 0.87), UDim2.fromScale(0.28, 0.05), 16)
	local status =
		label(chart, "Charting the islands...", UDim2.fromScale(0.06, 0.915), UDim2.fromScale(0.88, 0.035), 15)
	label(
		chart,
		"Red arrow: you  •  North is up  •  M / Esc to fold",
		UDim2.fromScale(0.06, 0.955),
		UDim2.fromScale(0.88, 0.03),
		14
	)
	local marker = label(canvas, "▲", UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(24, 24), 24)
	marker.Name = "PlayerPosition"
	marker.AnchorPoint = Vector2.new(0.5, 0.5)
	marker.TextColor3 = Color3.fromRGB(165, 43, 31)
	marker.TextStrokeColor3 = paper
	marker.TextStrokeTransparency = 0
	marker.ZIndex = 10
	marker.Visible = false
	local count = 0
	local function update()
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		marker.Visible = root ~= nil
		if root then
			local p = project(root.Position.X, root.Position.Z)
			marker.Position = UDim2.fromScale(math.clamp(p.X, 0.015, 0.985), math.clamp(p.Y, 0.015, 0.985))
			local look = root.CFrame.LookVector
			marker.Rotation = math.deg(math.atan2(look.X, -look.Z))
			status.Text = string.format(
				"%s  ·  X %d / Z %d  ·  %d islands%s",
				Biomes.at(root.Position).name,
				math.round(root.Position.X),
				math.round(root.Position.Z),
				count,
				if p.X < 0 or p.X > 1 or p.Y < 0 or p.Y > 1 then "  ·  Beyond chart edge" else ""
			)
		else
			status.Text = "Waiting for your character..."
		end
		if not ReplicatedStorage:GetAttribute("FishingWatersGenerationComplete") then
			status.Text ..= "  ·  Charting..."
		end
	end
	local connection
	local function setOpen(value)
		if value and (player:GetAttribute("PlayerMenuOpen") or player:GetAttribute("DrydockScreenOpen")) then
			return
		end
		overlay.Visible = value
		player:SetAttribute("WorldMapOpen", value)
		if connection then
			connection:Disconnect()
			connection = nil
		end
		if value then
			update()
			local elapsed = 0
			connection = RunService.Heartbeat:Connect(function(dt)
				elapsed += dt
				if elapsed >= 0.1 then
					elapsed = 0
					update()
				end
			end)
		end
	end
	open.Activated:Connect(function()
		setOpen(not overlay.Visible)
	end)
	close.Activated:Connect(function()
		setOpen(false)
	end)
	overlay.Activated:Connect(function()
		setOpen(false)
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if UserInputService:GetFocusedTextBox() then
			return
		end
		if input.KeyCode == Enum.KeyCode.M and not processed then
			setOpen(not overlay.Visible)
		elseif overlay.Visible and (input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB) then
			setOpen(false)
		end
	end)
	for _, attribute in { "PlayerMenuOpen", "DrydockScreenOpen" } do
		player:GetAttributeChangedSignal(attribute):Connect(function()
			if player:GetAttribute(attribute) then
				setOpen(false)
			end
			open.Visible = not player:GetAttribute("PlayerMenuOpen") and not player:GetAttribute("DrydockScreenOpen")
		end)
	end
	-- Records arrive progressively during generation and include every offshore rock.
	task.spawn(function()
		local catalog = ReplicatedStorage:WaitForChild("IslandChart")
		local rendered = {}
		local function draw(record)
			if not record:IsA("StringValue") or rendered[record] then
				return
			end
			local success, coast = pcall(HttpService.JSONDecode, HttpService, record.Value)
			if not success or #coast < 3 then
				return
			end
			local holder =
				make("Frame", canvas, { Name = record.Name, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
			rendered[record] = holder
			count += 1
			local center = Vector2.zero
			for _, point in coast do
				center += project(point[1], point[2])
			end
			center /= #coast
			if record.Name == "Pirate Cove" then
				-- Small island under the Coral Shallows biome label: mark it and label it beside the
				-- island (to the east, where the chart is empty) so the two names never overlap.
				local dot = make("Frame", holder, {
					Name = "Marker",
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(center.X, center.Y),
					Size = UDim2.fromOffset(7, 7),
					BackgroundColor3 = ink,
					BorderSizePixel = 0,
					ZIndex = 6,
				})
				make("UICorner", dot, { CornerRadius = UDim.new(1, 0) })
				make("UIStroke", dot, { Color = paper, Thickness = 1.5 })
				local name = label(
					holder,
					record.Name,
					UDim2.fromScale(center.X + 0.014, center.Y - 0.02),
					UDim2.fromScale(0.16, 0.04),
					14
				)
				name.TextXAlignment = Enum.TextXAlignment.Left
				name.TextWrapped = false
				name.ZIndex = 7
				name.TextStrokeColor3 = paper
				name.TextStrokeTransparency = 0.4
			elseif record.Name == "Modern City" or record:GetAttribute("ChartLabel") then
				label(holder, record:GetAttribute("ChartLabel") or record.Name, UDim2.fromScale(center.X - 0.09, center.Y - 0.06), UDim2.fromScale(0.18, 0.04), 14)
			end
			for i, point in coast do
				local nextPoint = coast[i % #coast + 1]
				local a, b = project(point[1], point[2]), project(nextPoint[1], nextPoint[2])
				line(holder, a, b, ink, 1.3, 3)
				if record:GetAttribute("Atoll") then
					line(holder, center:Lerp(a, 0.65), center:Lerp(b, 0.65), ink, 1, 3)
				end
			end
			record.Destroying:Connect(function()
				holder:Destroy()
				rendered[record] = nil
				count -= 1
			end)
		end
		catalog.ChildAdded:Connect(draw)
		for _, record in catalog:GetChildren() do
			draw(record)
		end
	end)
end

return WorldMap
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="374">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="FilteringEnabled">true</bool>
      <bool name="NeedsPivotMigration">false</bool>
      <token name="StreamOutBehavior">1</token>
      <bool name="StreamingEnabled">true</bool>
      <int name="StreamingMinRadius">128</int>
      <int name="StreamingTargetRadius">512</int>
    </Properties>
  </Item>
</roblox>