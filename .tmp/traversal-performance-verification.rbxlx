				rgb(84, 104, 134),
				M.Metal
			)
		end
		cylinder("MoonBase", 0.65, 0.16, F(0, -0.96, 0), rgb(84, 104, 134), M.Metal)
		part("TelescopeMount", V(0.18, 0.45, 0.18), F(0.45, 0.95, 0), brass, M.Metal)
		local tube = F(0.42, 1.25, 0) * CFrame.Angles(0.45, 0, 0.6)
		cylinder("Telescope", 0.22, 1.25, tube, brass, M.Metal)
		cylinder("TelescopeCollar", 0.255, 0.12, tube * F(0, 0.4, 0), steel, M.Metal)
		cylinder("Eyepiece", 0.13, 0.24, tube * F(0, -0.71, 0), steel, M.Metal)
		cylinder("Lens", 0.25, 0.1, tube * F(0, 0.65, 0), rgb(104, 199, 240), M.Glass)
		cylinder("LensGlass", 0.19, 0.025, tube * F(0, 0.715, 0), rgb(148, 225, 255), M.Glass)
		part(
			"StarBadge",
			V(0.28, 0.28, 0.1),
			F(-0.05, -0.15, 0.6) * CFrame.Angles(0, 0, math.pi / 4),
			rgb(255, 217, 123),
			M.Neon
		)
		for _, star in { { -0.5, -0.31 }, { 0.48, 0.15 }, { 0.27, -0.65 } } do
			ball("StarInlay", V(0.065, 0.065, 0.04), F(star[1], star[2], 0.51), rgb(233, 231, 255), M.Neon)
		end
	elseif id == "BlackHole" then
		-- A captive singularity: a pitch-black event horizon behind a lensing
		-- shell and photon ring, an accretion disk in two bands, and small fish
		-- spiralling in. Sub-models are rigged groups (see Models.wear) that the
		-- client spins (src/client/BlackHoleBackpack.luau) when the Backpack
		-- animation setting is on; with it off the pack is shown frozen.
		local void, gunmetal, frameDark = rgb(0, 0, 0), rgb(52, 54, 66), rgb(30, 29, 42)
		local violet, hot, ember = rgb(160, 104, 255), rgb(255, 238, 200), rgb(255, 146, 58)
		local core = F(0, 0.05, 0.36)
		local disk = core * CFrame.Angles(-0.9, 0, 0.22)
		panel("SingularityBackplate", V(1.45, 1.85, 0.2), F(0, 0, -0.38), rgb(24, 24, 32), M.Metal, 0.2)
		part("BackplateInlay", V(1.05, 1.4, 0.03), F(0, 0.02, -0.27), rgb(38, 30, 58), M.Metal)
		for _, side in { -1, 1 } do
			part("SpineRail", V(0.12, 1.9, 0.18), F(side * 0.64, 0, -0.2), gunmetal, M.Metal)
			rivet(side * 0.64, 0.82, -0.1)
			rivet(side * 0.64, -0.82, -0.1)
			-- Glowing piping along the harness, visible from the sides.
			part(
				"HarnessGlow",
				V(0.05, 0.92, 0.03),
				F(side * 0.5, 0.25, -0.48) * CFrame.Angles(0, 0, side * -0.12),
				violet,
				M.Neon
			)
		end
		-- Containment hoop on four struts, with a neon field trim inside it.
		ring("ContainmentRing", 0.86, core, frameDark, 0.15, M.Metal)
		ring("ContainmentLip", 0.86, core * F(0, 0, -0.09), gunmetal, 0.08, M.Metal)
		ring("FieldTrim", 0.77, core * F(0, 0, 0.05), violet, 0.035, M.Neon)
		for i = 0, 3 do
			local a = i * math.pi / 2 + math.pi / 4
			part("RingStrut", V(0.1, 0.1, 0.64), F(math.cos(a) * 0.8, 0.05 + math.sin(a) * 0.8, 0.04), gunmetal, M.Metal)
		end
		-- Three field projectors aimed at the singularity.
		for i = 0, 2 do
			local spoke = core * CFrame.Angles(0, 0, i * math.pi * 2 / 3)
			cylinder("FieldProjector", 0.085, 0.24, spoke * F(0, 0.78, 0.04), steel, M.Metal)
			cylinder("ProjectorCollar", 0.11, 0.06, spoke * F(0, 0.7, 0.04), brass, M.Metal)
			ball("ProjectorLens", V(0.11, 0.11, 0.11), spoke * F(0, 0.645, 0.04), violet, M.Neon)
		end
		-- The singularity itself.
		ball("EventHorizon", V(0.56, 0.56, 0.56), core, void, M.SmoothPlastic)
		local shell = ball("LensingShell", V(0.74, 0.74, 0.74), core, rgb(70, 40, 120), M.Glass, 0.6)
		ring("PhotonRing", 0.33, core * F(0, 0, 0.06), hot, 0.035, M.Neon)
		local glow = Instance.new("PointLight")
		glow.Name, glow.Color, glow.Brightness, glow.Range, glow.Shadows = "SingularityGlow", violet, 0.9, 7, false
		glow.Parent = shell
		-- Stardust falling inward from a sphere around the hole (client toggled).
		local infall = ball("InfallShell", V(1.5, 1.5, 1.5), core, void, M.SmoothPlastic, 1)
		local dust = Instance.new("ParticleEmitter")
		dust.Name = "Stardust"
		dust.Shape = Enum.ParticleEmitterShape.Sphere
		dust.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		dust.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
		dust.Speed = NumberRange.new(0.55, 0.8)
		dust.Lifetime = NumberRange.new(0.8, 1.1)
		dust.Rate = 16
		dust.LightEmission = 1
		dust.LockedToPart = true
		dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.07), NumberSequenceKeypoint.new(1, 0) })
		dust.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.2, 0.1),
			NumberSequenceKeypoint.new(1, 0.6),
		})
		dust.Color = ColorSequence.new(rgb(196, 160, 255), rgb(255, 190, 120))
		dust.Enabled = false
		dust.Parent = infall
		-- Accretion disk: a white-hot inner band that spins fast and two cooler
		-- outer bands that lag behind it. Alternating tones read as streaks.
		local function band(name, radius, width, count, colors, alpha)
			for i = 0, count - 1 do
				part(
					name,
					V(2 * math.pi * radius / count * 1.12, width, 0.025),
					disk * CFrame.Angles(0, 0, i * 2 * math.pi / count) * F(0, radius, 0),
					colors[i % #colors + 1],
					M.Neon,
					nil,
					alpha
				)
			end
		end
		rigGroup("DiskInner", disk, function()
			band("InnerDisk", 0.43, 0.1, 14, { hot, rgb(255, 214, 140) })
		end)
		rigGroup("DiskOuter", disk, function()
			band("MiddleDisk", 0.56, 0.12, 16, { ember, rgb(255, 118, 40), rgb(255, 170, 80) })
			band("OuterDisk", 0.7, 0.14, 18, { rgb(206, 64, 128), rgb(150, 52, 176) }, 0.2)
			for _, a in { 0.4, 2.5, 4.4 } do
				ball("HotSpot", V(0.1, 0.1, 0.05), disk * CFrame.Angles(0, 0, a) * F(0, 0.6, 0.02), hot, M.Neon)
			end
		end)
		-- Five little fish on decaying orbits, each its own rig so the client
		-- can pull it inward and fade it at the horizon.
		for i = 1, 5 do
			rigGroup("Infall" .. i, disk * CFrame.Angles(0, 0, i * math.pi * 2 / 5), function(frame)
				local spot = frame * F(0.74, 0, 0.05)
				ball("InfallFish", V(0.07, 0.17, 0.06), spot, rgb(150, 235, 255), M.Neon)
				part("InfallTail", V(0.09, 0.05, 0.02), spot * F(0, -0.11, 0), rgb(110, 200, 255), M.Neon)
			end)
		end
		-- Coolant canisters on top, intake vent below, a mass gauge on the side.
		for _, side in { -1, 1 } do
			cylinder("CoolantCanister", 0.13, 0.5, F(side * 0.42, 1.05, -0.17), rgb(70, 74, 92), M.Metal)
			cylinder("CanisterCap", 0.15, 0.07, F(side * 0.42, 1.32, -0.17), steel, M.Metal)
			cylinder("CoolantBand", 0.14, 0.05, F(side * 0.42, 1.0, -0.17), violet, M.Neon)
		end
		part("ColdPipe", V(0.7, 0.07, 0.07), F(0, 1.14, -0.17), steel, M.Metal)
		cylinder("IntakeVent", 0.22, 0.12, F(0, -0.98, -0.12), gunmetal, M.Metal)
		ball("IntakeGlow", V(0.26, 0.08, 0.26), F(0, -1.04, -0.12), violet, M.Neon)
		part("MassGauge", V(0.07, 0.46, 0.3), F(-0.74, -0.45, -0.18), frameDark, M.Metal)
		for i = 0, 3 do
			part("GaugeCell", V(0.08, 0.07, 0.2), F(-0.75, -0.62 + i * 0.11, -0.18), if i == 3 then hot else violet, M.Neon)
		end
		-- Hazard chevrons along the bottom edge of the backplate.
		part("HazardStrip", V(1.1, 0.16, 0.02), F(0, -0.8, -0.27), rgb(20, 20, 22), M.SmoothPlastic)
		for i = -2, 2 do
			part(
				"HazardChevron",
				V(0.07, 0.2, 0.025),
				F(i * 0.22, -0.8, -0.265) * CFrame.Angles(0, 0, 0.6),
				rgb(242, 196, 46),
				M.SmoothPlastic
			)
		end
		game:GetService("CollectionService"):AddTag(model, "BlackHoleBackpack")
	elseif id == "Abyss" then
		part("ReactorBackplate", V(1.1, 1.7, 0.22), F(0, 0, -0.4), rgb(36, 49, 62), M.Metal)
		cylinder("AbyssalEnergy", 0.42, 1.5, F(0, 0, 0.18), rgb(93, 245, 202), M.Neon)
		cylinder("PressureGlass", 0.55, 1.6, F(0, 0, 0.18), rgb(99, 181, 188), M.Glass, 0.7)
		for _, y in { -0.95, 0.95 } do
			cylinder("PressureCap", 0.78, 0.19, F(0, y, 0.12), rgb(42, 37, 68), M.Metal)
			cylinder("CapTrim", 0.67, 0.07, F(0, y * 1.14, 0.12), brass, M.Metal)
		end
		ring("PressureRing", 0.68, F(0, 0, 0.18) * CFrame.Angles(math.pi / 2, 0, 0), rgb(42, 37, 68), 0.13)
		for i = 0, 3 do
			local a = i * math.pi / 2 + math.pi / 4
			part(
				"ContainmentPillar",
				V(0.15, 1.9, 0.15),
				F(math.cos(a) * 0.68, 0, 0.18 + math.sin(a) * 0.68),
				brass,
				M.Metal
			)
		end
		cylinder("PressureGauge", 0.25, 0.11, F(0, 0.65, 0.8) * CFrame.Angles(math.pi / 2, 0, 0), brass, M.Metal)
		cylinder(
			"GaugeFace",
			0.19,
			0.03,
			F(0, 0.65, 0.88) * CFrame.Angles(math.pi / 2, 0, 0),
			rgb(43, 41, 70),
			M.SmoothPlastic
		)
		part(
			"GaugeNeedle",
			V(0.035, 0.27, 0.035),
			F(0, 0.65, 0.91) * CFrame.Angles(0, 0, -0.6),
			rgb(177, 155, 220),
			M.Neon
		)
		for _, side in { -1, 1 } do
			cylinder("PressureValve", 0.13, 0.25, F(side * 0.48, 1.18, 0.12), steel, M.Metal)
			part("ValveGrip", V(0.32, 0.07, 0.09), F(side * 0.48, 1.32, 0.12), brass, M.Metal)
		end
	end
	return model
end

function Models.wear(character: Model, id: string): Model?
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not torso or not torso:IsA("BasePart") then
		return nil
	end
	local old = character:FindFirstChild("FishingBackpack")
	if old then
		old:Destroy()
	end
	local model = Models.create(id)
	model.Name = "FishingBackpack"
	model:ScaleTo(math.clamp(torso.Size.X / 2, 0.65, 1.6))
	local box, size = model:GetBoundingBox()
	model:PivotTo(torso.CFrame * F(0, -0.08, torso.Size.Z / 2 - box.Position.Z + size.Z / 2 + 0.04))
	local handle = model.PrimaryPart
	model:SetAttribute("RigScale", model:GetScale())
	for _, piece in model:GetDescendants() do
		if piece:IsA("BasePart") and piece ~= handle then
			local group = piece.Parent
			if group ~= model and group:IsA("Model") and group.PrimaryPart then
				-- Rig groups (rigGroup): the pivot hangs off the handle on a
				-- Motor6D, everything else in the group is welded to the pivot.
				if piece == group.PrimaryPart then
					local motor = Instance.new("Motor6D")
					motor.Name, motor.Part0, motor.Part1 = group.Name, handle, piece
					motor.C0 = handle.CFrame:ToObjectSpace(piece.CFrame)
					motor.Parent = handle
				else
					local weld = Instance.new("WeldConstraint")
					weld.Part0, weld.Part1, weld.Parent = group.PrimaryPart, piece, piece
				end
			else
				local weld = Instance.new("WeldConstraint")
				weld.Part0, weld.Part1, weld.Parent = handle, piece, piece
			end
		end
	end
	local joint = Instance.new("WeldConstraint")
	joint.Name, joint.Part0, joint.Part1, joint.Parent = "BackWeld", handle, torso, handle
	for _, piece in model:GetDescendants() do
		if piece:IsA("BasePart") then
			piece.Anchored = false
		end
	end
	model.Parent = character
	return model
end

function Models.show(view: ViewportFrame, id: string)
	view:ClearAllChildren()
	local world = Instance.new("WorldModel")
	world.Parent = view
	local model = Models.create(id)
	model.Parent = world
	local box, size = model:GetBoundingBox()
	local camera = Instance.new("Camera")
	camera.FieldOfView = 35
	local direction = V(2.5, 1.1, 5).Unit
	camera.CFrame =
		CFrame.lookAt(box.Position + direction * (size.Magnitude / 2 / math.sin(math.rad(17.5)) * 1.12), box.Position)
	camera.Parent, view.CurrentCamera = view, camera
	view.Ambient, view.LightColor = rgb(189, 207, 218), rgb(255, 239, 209)
	view.LightDirection = V(-1, -1, -2)
	return model
end
return Models
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Bait</string>
          <string name="Source"><![CDATA[-- Bait: a consumable boost on the hook. The equipped bait applies from the next
-- cast and one is used up each time a catch is reeled in. Crates come from Finn
-- ($25 each) or, rarely, on the end of the line; each crate holds 7-15 of one
-- bait, rolled by rarity. Rolls take uniform [0, 1) picks so tests can drive them.
local Bait = {}

Bait.RarityOrder = { "Common", "Uncommon", "Rare", "Epic", "Legendary" }
Bait.Rarities = {
	Common = { Color = { 196, 201, 205 } },
	Uncommon = { Color = { 111, 202, 125 } },
	Rare = { Color = { 86, 156, 240 } },
	Epic = { Color = { 186, 104, 240 } },
	Legendary = { Color = { 255, 196, 64 } },
}

-- Luck uses the same rarity bias as rod luck; Size adds to the big/huge-fish
-- multiplier; Mutation adds to the mutation chance; Reel adds to reel speed.
Bait.Order = { "Worm", "Cricket", "Shrimp", "Squid", "Glowworm" }
Bait.Types = {
	Worm = { Name = "Worm", Rarity = "Common", Color = { 214, 132, 120 }, Luck = 0.03 },
	Cricket = { Name = "Cricket", Rarity = "Uncommon", Color = { 120, 96, 58 }, Luck = 0.05, Size = 0.15 },
	Shrimp = {
		Name = "Shrimp",
		Rarity = "Rare",
		Color = { 255, 150, 120 },
		Luck = 0.07,
		Size = 0.3,
		Mutation = 0.001,
	},
	Squid = {
		Name = "Squid",
		Rarity = "Epic",
		Color = { 236, 206, 230 },
		Luck = 0.1,
		Size = 0.5,
		Mutation = 0.002,
		Reel = 0.08,
	},
	Glowworm = {
		Name = "Glowworm",
		Rarity = "Legendary",
		Color = { 150, 255, 170 },
		Neon = true,
		Luck = 0.15,
		Size = 0.8,
		Mutation = 0.004,
		Reel = 0.15,
	},
}

Bait.Crate = {
	Name = "Bait Crate",
	Price = 25,
	MinBait = 7,
	MaxBait = 15,
	Odds = { Common = 0.6, Uncommon = 0.25, Rare = 0.1, Epic = 0.04, Legendary = 0.01 },
}
-- Finn sells crates in these batch sizes.
Bait.BuyCounts = { 1, 5 }
-- Chance that a landed catch also brings up a bait crate.
Bait.FISH_UP_CHANCE = 0.02

function Bait.valid(id: any): boolean
	return type(id) == "string" and Bait.Types[id] ~= nil
end

function Bait.validBuyCount(count: any): boolean
	return type(count) == "number" and table.find(Bait.BuyCounts, count) ~= nil
end

-- The bait and amount inside one crate.
function Bait.roll(rarityPick: number, amountPick: number): (string, number)
	local rarity = Bait.RarityOrder[1]
	for _, name in Bait.RarityOrder do
		rarity = name
		rarityPick -= Bait.Crate.Odds[name]
		if rarityPick < 0 then
			break
		end
	end
	local id = Bait.Order[1]
	for _, candidate in Bait.Order do
		if Bait.Types[candidate].Rarity == rarity then
			id = candidate
			break
		end
	end
	local span = Bait.Crate.MaxBait - Bait.Crate.MinBait + 1
	local amount = Bait.Crate.MinBait + math.clamp(math.floor(amountPick * span), 0, span - 1)
	return id, amount
end

function Bait.chance(id: string): number
	local rarity, count = Bait.Types[id].Rarity, 0
	for _, other in Bait.Order do
		if Bait.Types[other].Rarity == rarity then
			count += 1
		end
	end
	return Bait.Crate.Odds[rarity] / count
end

-- Rod boosts (RodUpgrades.boosts and friends) with `id`'s bait on the hook.
function Bait.apply(boosts, id: string?)
	local result = table.clone(boosts)
	local bait = id and Bait.Types[id]
	if bait then
		result.luck = (result.luck or 0) + (bait.Luck or 0)
		result.size = (result.size or 1) + (bait.Size or 0)
		result.mutation = (result.mutation or 0) + (bait.Mutation or 0)
		result.reel = (result.reel or 1) + (bait.Reel or 0)
	end
	return result
end

function Bait.perks(id: string): { string }
	local bait = Bait.Types[id]
	local perks = { string.format("+%d%% luck", math.floor(bait.Luck * 100 + 0.5)) }
	if bait.Size then
		table.insert(perks, string.format("+%d%% big fish", math.floor(bait.Size * 100 + 0.5)))
	end
	if bait.Mutation then
		table.insert(perks, string.format("+%.1f%% mutation", bait.Mutation * 100))
	end
	if bait.Reel then
		table.insert(perks, string.format("+%d%% reel", math.floor(bait.Reel * 100 + 0.5)))
	end
	return perks
end

return Bait
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">BaseGrid</string>
          <string name="Source"><![CDATA[-- House-local building and navigation grid. The origin is the house center.
local BaseGrid = {}

BaseGrid.CELL_SIZE = 4.5
BaseGrid.COLUMNS = 11
BaseGrid.ROWS = 7
BaseGrid.HALF_WIDTH = BaseGrid.COLUMNS * BaseGrid.CELL_SIZE / 2
BaseGrid.HALF_LENGTH = BaseGrid.ROWS * BaseGrid.CELL_SIZE / 2

-- The same lattice continues over the quay, both piers, the road out front and
-- the shop across it. These bounds are expressed in the house's 1-based cell
-- coordinates: column 6 and row 4 are centered on HouseFrame. The outermost
-- cells include the dock tips and the back of the shop; occupancy is
-- determined from the actual walking surface.
BaseGrid.BASE_MIN_COLUMN = -2
BaseGrid.BASE_MAX_COLUMN = 14
BaseGrid.BASE_MIN_ROW = -18
BaseGrid.BASE_MAX_ROW = 22

-- The customer shop is its own building across the ring road, in the same
-- house-local frame: its front wall faces the house at SHOP_FRONT and its back
-- wall is at SHOP_BACK. Its floor plan is the old in-house shop room turned half
-- a circle about (0, SHOP_TURN / 2), so (x, z) there is (-x, SHOP_TURN - z) here.
BaseGrid.SHOP_FRONT = 65.25
BaseGrid.SHOP_BACK = 83.25
BaseGrid.SHOP_TURN = 81

-- Snap any house-local coordinate to the same lattice, including extensions.
function BaseGrid.snap(value: number): number
	return math.round(value / BaseGrid.CELL_SIZE) * BaseGrid.CELL_SIZE
end

-- 1-based columns and rows run from negative to positive X and Z.
function BaseGrid.localToCell(x: number, z: number): (number?, number?)
	if x < -BaseGrid.HALF_WIDTH or x >= BaseGrid.HALF_WIDTH
		or z < -BaseGrid.HALF_LENGTH or z >= BaseGrid.HALF_LENGTH then
		return nil, nil
	end
	return math.floor((x + BaseGrid.HALF_WIDTH) / BaseGrid.CELL_SIZE) + 1,
		math.floor((z + BaseGrid.HALF_LENGTH) / BaseGrid.CELL_SIZE) + 1
end

function BaseGrid.cellToLocal(column: number, row: number): (number, number)
	return -BaseGrid.HALF_WIDTH + (column - 0.5) * BaseGrid.CELL_SIZE,
		-BaseGrid.HALF_LENGTH + (row - 0.5) * BaseGrid.CELL_SIZE
end

function BaseGrid.extendedCellToLocal(column: number, row: number): (number, number)
	return BaseGrid.cellToLocal(column, row)
end

function BaseGrid.localToExtendedCell(x: number, z: number): (number?, number?)
	local column = math.floor((x + BaseGrid.HALF_WIDTH) / BaseGrid.CELL_SIZE) + 1
	local row = math.floor((z + BaseGrid.HALF_LENGTH) / BaseGrid.CELL_SIZE) + 1
	if column < BaseGrid.BASE_MIN_COLUMN or column > BaseGrid.BASE_MAX_COLUMN
		or row < BaseGrid.BASE_MIN_ROW or row > BaseGrid.BASE_MAX_ROW then
		return nil, nil
	end
	return column, row
end

return BaseGrid
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Biomes</string>
          <string name="Source"><![CDATA[-- World layout and mood for each biome. Shared so the server can build the map
-- and the client can match the atmosphere to wherever the camera is.

export type Look = {
	waterColor: Color3,
	atmosphereColor: Color3,
	atmosphereDecay: Color3,
	density: number,
	haze: number,
	glare: number,
	tint: Color3,
	saturation: number,
	contrast: number,
	ambient: Color3,
	cloudCover: number,
	cloudColor: Color3,
}

export type Biome = {
	id: string,
	name: string,
	center: Vector2, -- X/Z in world space
	radius: number,
	seabed: Enum.Material,
	seabedColor: Color3,
	shelfDepth: number?, -- biome-wide seabed height; nil keeps the deep sea floor
	look: Look,
}

local rgb = Color3.fromRGB

local Biomes = {}

Biomes.Seed = 1847
Biomes.WaterLevel = 0
-- Shared by map setup and client biome transitions so clarity stays consistent.
Biomes.SurfaceWaterTransparency = 0.45
Biomes.WaterReflectance = 0.12
Biomes.SeaFloor = -64
Biomes.MapHalfSize = 5200
-- The original archipelago keeps its generation bounds; the ocean extends
-- farther southeast to encompass the distant city and its approaches.
Biomes.OceanMin = -Biomes.MapHalfSize
Biomes.OceanMax = 8200
Biomes.CityOceanStart = 4200
-- Dry rooms below sea level inside the ocean bounds: the two metro stations. The map
-- clears terrain water out of them, and nobody in them is underwater.
Biomes.DryPockets = {
	{ min = Vector3.new(6618, -46, 6882), max = Vector3.new(6884, 8, 7032) },
	-- Gullhaven's recessed east-row entrance and its 172-stud platform hall.
	{ min = Vector3.new(62, -34, -678), max = Vector3.new(172, 12, -500) },
}

function Biomes.inOceanBounds(position: Vector3): boolean
	for _, pocket in Biomes.DryPockets do
		local lo, hi = pocket.min, pocket.max
		if
			position.X > lo.X and position.X < hi.X
			and position.Y > lo.Y and position.Y < hi.Y
			and position.Z > lo.Z and position.Z < hi.Z
		then
			return false
		end
	end
	local original = math.abs(position.X) < Biomes.MapHalfSize and math.abs(position.Z) < Biomes.MapHalfSize
	local southeast = position.X > Biomes.CityOceanStart and position.X < Biomes.OceanMax
		and position.Z > Biomes.CityOceanStart and position.Z < Biomes.OceanMax
	return original or southeast
end
-- Blend distant islands into the horizon instead of keeping sharp silhouettes.
Biomes.DistanceFogOffset = 0.1

Biomes.Normal = {
	id = "normal",
	name = "Gullhaven Sound",
	center = Vector2.new(0, 0),
	radius = 1300,
	seabed = Enum.Material.Sand,
	seabedColor = rgb(206, 190, 148),
	look = {
		waterColor = rgb(82, 105, 132),
		atmosphereColor = rgb(199, 205, 200),
		atmosphereDecay = rgb(92, 106, 114),
		density = 0.32,
		haze = 1.8,
		glare = 0.2,
		tint = rgb(240, 245, 245),
		saturation = -0.05,
		contrast = 0.05,
		ambient = rgb(128, 132, 136),
		cloudCover = 0.55,
		cloudColor = rgb(230, 232, 235),
	},
} :: Biome

Biomes.Swamp = {
	id = "swamp",
	name = "The Sodden Mire",
	center = Vector2.new(-3750, -1000),
	radius = 1250,
	seabed = Enum.Material.Mud,
	seabedColor = rgb(64, 58, 36),
	shelfDepth = -14,
	look = {
		waterColor = rgb(92, 84, 46),
		atmosphereColor = rgb(214, 190, 128),
		atmosphereDecay = rgb(140, 110, 60),
		density = 0.42,
		haze = 2.8,
		glare = 0.1,
		tint = rgb(255, 236, 200),
		saturation = -0.1,
		contrast = 0.04,
		ambient = rgb(140, 126, 96),
		cloudCover = 0.7,
		cloudColor = rgb(220, 200, 160),
	},
} :: Biome

Biomes.Tropical = {
	id = "tropical",
	name = "Coral Shallows",
	center = Vector2.new(-1200, 3000),
	radius = 1300,
	seabed = Enum.Material.Limestone,
	seabedColor = rgb(226, 214, 170),
	shelfDepth = -22,
	look = {
		waterColor = rgb(82, 137, 151),
		atmosphereColor = rgb(210, 235, 240),
		atmosphereDecay = rgb(120, 170, 190),
		density = 0.28,
		haze = 1.2,
		glare = 0.6,
		tint = rgb(255, 252, 240),
		saturation = 0.15,
		contrast = 0.06,
		ambient = rgb(150, 156, 150),
		cloudCover = 0.45,
		cloudColor = rgb(255, 255, 255),
	},
} :: Biome

Biomes.Volcanic = {
	id = "volcanic",
	name = "Cinder Isles",
	center = Vector2.new(3300, 1300),
	radius = 1250,
	seabed = Enum.Material.Basalt,
	seabedColor = rgb(38, 36, 38),
	look = {
		waterColor = rgb(40, 46, 50),
		atmosphereColor = rgb(180, 110, 90),
		atmosphereDecay = rgb(90, 40, 30),
		density = 0.38,
		haze = 2.3,
		glare = 0.4,
		tint = rgb(255, 220, 205),
		saturation = -0.05,
		contrast = 0.12,
		ambient = rgb(120, 96, 90),
		cloudCover = 0.75,
		cloudColor = rgb(110, 96, 92),
	},
} :: Biome

Biomes.Ice = {
	id = "ice",
	name = "Frostmere Expanse",
	center = Vector2.new(1000, -3800),
	radius = 1300,
	seabed = Enum.Material.Glacier,
	seabedColor = rgb(150, 186, 204),
	look = {
		waterColor = rgb(70, 120, 150),
		atmosphereColor = rgb(215, 228, 240),
		atmosphereDecay = rgb(150, 175, 200),
		density = 0.36,
		haze = 2,
		glare = 0.3,
		tint = rgb(230, 240, 255),
		saturation = -0.2,
		contrast = 0.05,
		ambient = rgb(150, 160, 175),
		cloudCover = 0.65,
		cloudColor = rgb(240, 245, 250),
	},
} :: Biome

Biomes.OpenSea = {
	id = "open",
	name = "Open Waters",
	center = Vector2.new(0, 0),
	radius = 0,
	seabed = Enum.Material.Slate,
	seabedColor = rgb(56, 74, 80),
	look = {
		waterColor = rgb(66, 87, 114),
		atmosphereColor = rgb(180, 190, 195),
		atmosphereDecay = rgb(70, 85, 95),
		density = 0.35,
		haze = 2.1,
		glare = 0.2,
		tint = rgb(235, 240, 245),
		saturation = -0.1,
		contrast = 0.06,
		ambient = rgb(118, 124, 130),
		cloudCover = 0.6,
		cloudColor = rgb(215, 220, 225),
	},
} :: Biome

Biomes.list = { Biomes.Normal, Biomes.Swamp, Biomes.Tropical, Biomes.Volcanic, Biomes.Ice } :: { Biome }

-- How far a point is into a biome, as a fraction of its radius (0 = center, 1 = edge).
function Biomes.depthIn(biome: Biome, position: Vector3): number
	return (Vector2.new(position.X, position.Z) - biome.center).Magnitude / biome.radius
end

function Biomes.at(position: Vector3): Biome
	local best, bestDepth = Biomes.OpenSea, 1
	for _, biome in Biomes.list do
		local depth = Biomes.depthIn(biome, position)
		if depth < bestDepth then
			best, bestDepth = biome, depth
		end
	end
	return best
end

return Biomes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">BoatCatalog</string>
          <string name="Source"><![CDATA[-- Purchase preview and server driving use the same specifications.
-- Hold is the cargo grid mask (see Shared.Cargo): a top-down outline of the hull,
-- bow at the top, so bigger hulls carry more.
-- StarterParts is the boat kit already stowed when a hold is first opened.
