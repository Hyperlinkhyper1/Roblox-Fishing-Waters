local BoatData = require("../src/server/BoatData")
local SpearSkins = require("../src/shared/SpearSkins")
local profile = BoatData.decode({ Version = 1, Cash = 700, OwnedBoats = {} })
assert(#profile.SpearSkinCopies == 0, "Existing profiles start with no spear skins")
assert(BoatData.openSpearCrate(profile, "SpearCrate", "Driftwood", 42, 0.03) == "Opened")
assert(profile.Cash == 350 and profile.Angler.Stats.CoinsSpent == 350)
assert(BoatData.openSpearCrate(profile, "SpearCrate", "DeepBlue", 3, 0.9) == "Opened")
assert(BoatData.openSpearCrate(profile, "SpearCrate", "Driftwood", 43, 0.2) == "InsufficientFunds")
assert(BoatData.equipSpearSkin(profile, "DeepBlue", 99) == "NotOwned")
assert(BoatData.equipSpearSkin(profile, "DeepBlue", 3) == "Equipped")
local restored = BoatData.decode(profile)
assert(#restored.SpearSkinCopies == 2 and restored.EquippedSpearSkinSerial == 3)
assert(BoatData.equippedSpearWear(restored) == 0.9)
assert(SpearSkins.boosts("DeepBlue", 0.03).fireRate > SpearSkins.boosts("DeepBlue", 0.9).fireRate)
assert(BoatData.equipSpearSkin(restored, nil, nil) == "Equipped")
assert(restored.EquippedSpearSkin == nil)
profile.SpearSkinCopies[2].Wear = 2
assert(not pcall(BoatData.decode, profile), "Malformed saved wear must be rejected")
print("Spear skin persistence checks passed")
